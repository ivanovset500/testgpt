Функция АдоНовоеСоединение(БазаДанныхSQL)
	СоединениеSQL = Новый COMObject("ADODB.Connection");
	СоединениеSQL.ConnectionString =
	        "driver={SQL Server};" +
	        "server=192.168.0.244;"+
	        "uid=elix;"+
	        "pwd=123456;"+
	        "database="+БазаДанныхSQL+";";
    СоединениеSQL.ConnectionTimeout = 30;
	СоединениеSQL.commandTimeout=600;
	СоединениеSQL.Open();
	Возврат СоединениеSQL ;
КонецФункции

Функция АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса)
	ЗаписиSQL = Новый COMObject("ADODB.Recordset");
	ЗаписиSQL.CursorLocation = 3;
	ЗаписиSQL.Open (ТекстЗапроса, АдоСоединение) ;
	возврат  ЗаписиSQL; 
КонецФункции 
   
   
