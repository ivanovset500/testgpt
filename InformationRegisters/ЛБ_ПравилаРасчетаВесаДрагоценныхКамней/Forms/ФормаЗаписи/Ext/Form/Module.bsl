
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьВыборЕдиницИзмеренияВставки();
	Если НЕ Элементы.ЕдиницаИзмерения.СписокВыбора.Количество() = 0 тогда
		Если НЕ ЗначениеЗаполнено(Запись.ВидДрагоценногоКамня) Тогда
			Запись.ЕдиницаИзмерения = Константы.ЛБ_ОсновнаяЕдиницаКамни.Получить();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьВыборЕдиницИзмеренияВставки()
	Элементы.ЕдиницаИзмерения.СписокВыбора.Очистить();		
	Элементы.ЕдиницаИзмерения.СписокВыбора.Добавить(Константы.ЛБ_ОсновнаяЕдиницаКамни.Получить());
	Элементы.ЕдиницаИзмерения.СписокВыбора.Добавить(Константы.ЛБ_ОсновнаяЕдиницаМеталлы.Получить());
КонецПроцедуры
