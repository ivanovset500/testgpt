
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		Ломбард = ПараметрыСеанса.ТекущийЛомбард;
		ОтбиратьПо = 0;
		Элементы.ОтбиратьПо.ТолькоПросмотр = Истина;
	Иначе
		Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
	КонецЕсли;
	
	//+МАН 17.12.25
	ЗаполнитьСклады();
	//-МАН
	
	Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	
	ИзменитьОтбор();
	
	//Если РольДоступна("ЛБ_СотрудникЦО") Тогда
	Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
		Элементы.Ломбард.ТолькоПросмотр = Ложь;
		СотрудникЦО = Истина;
	Иначе
		Элементы.Ломбард.ТолькоПросмотр = Истина;
		СотрудникЦО = Ложь;
	КонецЕсли;	
	
	ОбновитьВес();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	ЗаполнитьСклады();
	ИзменитьОтбор();
	ТекущийЭлемент = Элементы.Список;
	ОбновитьВес();
	
	УстановитьДоступность();
КонецПроцедуры

