&НаСервере
Процедура УстановитьОтбиратьПо()
	
	Если ОтбиратьПо = 0 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_Ломбарды";
	    Элементы.Ломбард.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);
		//Элементы.СкладЛомбарда.ТолькоПросмотр = Ложь;
		Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли ОтбиратьПо = 1 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_ОтделенияЛомбардов";
	    Элементы.Ломбард.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);
		//Элементы.СкладЛомбарда.ТолькоПросмотр = Истина;
		Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			Ломбард = Справочники.ЛБ_ОтделенияЛомбардов.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Значение = Элементы.Ломбард;
    Элементы.Ломбард.ОграничениеТипа.ПривестиЗначение(Значение);
    Элементы.Ломбард.ВыбиратьТип = Ложь;
	Элементы.СкладЛомбарда.СписокВыбора.Очистить();
	ИзменитьОтбор();
	ОбновитьВес();
	УстановитьДоступность();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЛомбардыОтделения(Отделение)
	
	МассивВозвората = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Отделение = &Отделение) КАК ЛБ_ОтделенияЛомбардовСрезПоследних";
		//|ГДЕ
		//|	НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		//|	И НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Отделение", Отделение);
	
    РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		МассивВозвората.Добавить(РезультатЗапроса.Ломбард);
	КонецЦикла;
	
	Если МассивВозвората.Количество() > 0 Тогда
		Возврат МассивВозвората;
	Иначе
		Возврат Справочники.ЛБ_Ломбарды.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЛомбардОчистка(Элемент, СтандартнаяОбработка)
	СкладЛомбарда = ПредопределенноеЗначение("Справочник.ЛБ_Склады.ПустаяСсылка");
	Элементы.СкладЛомбарда.СписокВыбора.Очистить();
	ИзменитьОтбор();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.Список.Обновить();
	ОбновитьВес();
КонецПроцедуры

&НаКлиенте
Процедура ВПути(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Форма", "Журнал");
	
	Если ЗначениеЗаполнено(Ломбард) Тогда
		Если ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			Ломбарды = ПолучитьЛомбардыОтделения(Ломбард);

			ПараметрыФормы.Вставить("Ломбард", Ломбарды);
			
		ИначеЕсли ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			Ломбарды = ?(ЗначениеЗаполнено(СкладЛомбарда), Ломбард, ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка"));
			
			ПараметрыФормы.Вставить("Ломбард", Ломбарды);
		КонецЕсли;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ЛБ_ПриходОтходовДМ.Форма.ФормаВПути", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДоступныйВес(Ссылка, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвижениеОтходовОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвижениеОтходов.Остатки(
		|			&Дата,
		|			Ломбард = &Ломбард
		|				И Склад = &Склад) КАК ЛБ_ДвижениеОтходовОстатки";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ссылка.Ломбард);
	Запрос.УстановитьПараметр("Склад", Ссылка.Склад);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ВесНеттоОстаток >= Ссылка.ВесБезТары;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	ОповеститьОбИзменении(НовыйОбъект);
	ОбновитьВес();
КонецПроцедуры

&НаСервере
Функция ПроверитьПринятиеПеремещения(Док)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтходыДМВПутиОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
		|ИЗ
		|	РегистрНакопления.ЛБ_ОтходыДМВПути.Остатки(, ДокументПеремещения = &ДокументПеремещения) КАК ЛБ_ОтходыДМВПутиОстатки";
	
	Запрос.УстановитьПараметр("ДокументПеремещения", Док);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ВесНеттоОстаток = 0;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
