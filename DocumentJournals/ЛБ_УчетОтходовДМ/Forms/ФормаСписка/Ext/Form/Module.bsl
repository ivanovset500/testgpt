&НаКлиенте
Процедура Печать(Команда)
	Если ТипЗнч(ТекущийЭлемент.ТекущаяСтрока) = Тип("ДокументСсылка.ЛБ_РасходОтходовДМ") Тогда
		Проведен = СтатусДокумента(ТекущийЭлемент.ТекущаяСтрока);
		Если Проведен Тогда 
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "РасходнаяНакладная"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_РасходОтходовДМ");
			
			СтруктураВозврата = ПолучитьРеквизитыДокумента(ТекущийЭлемент.ТекущаяСтрока);
			
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("ЗаголовокФормы", "Расход отходов ДМ " + СтруктураВозврата.НомерДокумента + " от " + СтруктураВозврата.Дата);
			
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекущийЭлемент.ТекущаяСтрока);
			
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ПараметрыФормы.Вставить("ПараметрыПечати", ПараметрыПечати);
			
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,);   
		Иначе
			Предупреждение("Перед печатью необходимо провести документ!");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьРеквизитыДокумента(Ссылка)
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("НомерДокумента", Ссылка.НомерДокумента);
	СтруктураВозврата.Вставить("Дата", Ссылка.Дата);
	
	Возврат СтруктураВозврата;
КонецФункции

&НаСервере
Функция СтатусДокумента(Ссылка)
	Возврат Ссылка.Проведен;
КонецФункции

&НаСервере
Процедура ОбновитьВес()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвижениеОтходовОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвижениеОтходов.Остатки(
		|			&Дата,
		|			111 = 111
		|				И 222 = 222) КАК ЛБ_ДвижениеОтходовОстатки";
	
	Если ЗначениеЗаполнено(Ломбард) Тогда
		Если ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			Ломбарды = ПолучитьЛомбардыОтделения(Ломбард);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "Ломбард В(&Ломбард)");
			
			Запрос.УстановитьПараметр("Ломбард", Ломбарды);
		ИначеЕсли ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			Ломбарды = ?(ЗначениеЗаполнено(СкладЛомбарда), Ломбард, Справочники.ЛБ_Ломбарды.ПустаяСсылка());
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "Ломбард В(&Ломбард)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "222 = 222", "Склад В(&Склад)");
			
			Запрос.УстановитьПараметр("Ломбард", Ломбарды);
			Запрос.УстановитьПараметр("Склад", СкладЛомбарда);
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Вес = Формат(Результат.ВесНеттоОстаток, "ЧДЦ=2; ЧН=0,00");
	Иначе
		Вес = 0.00;
	КонецЕсли;

	Элементы.ДекорацияВес.Заголовок = "Текущее наличие нетто: " + Вес + " гр.";
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПриход(Команда)
	
	//+МАН 17.12.25
	Если НЕ ЗначениеЗаполнено(СкладЛомбарда) Тогда
		Предупреждение("Не выбран склад!
		|Создание документа невозможно!");
		Возврат;
	КонецЕсли;
	//-МАН
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ломбард", Ломбард);
	//+МАН 17.12.25
	ПараметрыФормы.Вставить("Склад", СкладЛомбарда);
	//-МАН
	
	//+МАН 15.12.25
	ОписаниеОповещенияПослеДобавлениДокумента = Новый ОписаниеОповещения("ПослеДобавлениДокумента", ЭтотОбъект);
	//-МАН
	
	ОткрытьФорму("Документ.ЛБ_ПриходОтходовДМ.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещенияПослеДобавлениДокумента, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРасход(Команда)
	
	//+МАН 17.12.25
	Если НЕ ЗначениеЗаполнено(СкладЛомбарда) Тогда
		Предупреждение("Не выбран склад!
		|Создание документа невозможно!");
		Возврат;
	КонецЕсли;
	//-МАН

	ОбновитьВес();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ломбард", Ломбард);
	ПараметрыФормы.Вставить("Вес", Вес);
	//+МАН 17.12.25 Исменил
	ПараметрыФормы.Вставить("Склад", СкладЛомбарда);
	//-МАН
	
	//+МАН 15.12.25
	ОписаниеОповещенияПослеДобавлениДокумента = Новый ОписаниеОповещения("ПослеДобавлениДокумента", ЭтотОбъект);
	//-МАН
	
	ОткрытьФорму("Документ.ЛБ_РасходОтходовДМ.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещенияПослеДобавлениДокумента, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавлениДокумента(Результат, ДополнительныеПараметры) Экспорт
	ПодключитьОбработчикОжидания("ВыполнитьОбновлениеВеса", 0.5, Истина);
	ОбновитьВес();
КонецПроцедуры

&НаКлиенте
Процедура Пауза(Секунды)
	ВремяОкончания = ТекущаяДата() + Секунды;
	Пока ТекущаяДата() <= ВремяОкончания Цикл
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	//Пауза(0.05);
	ОбновитьВес();
	ПодключитьОбработчикОжидания("ВыполнитьОбновлениеВеса", 0.5, Истина);
	ОбновитьВес();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПроведение(Команда)
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		СтруктураВозврата = ОтменитьПроведениеНаСервере(ТекСтрока);
		
		Если СтруктураВозврата.Результат Тогда
			ОповеститьОбИзменении(ТекСтрока);
			ОбновитьВес();
		Иначе
			Предупреждение(СтруктураВозврата.Сообщение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтменитьПроведениеНаСервере(Док, Удаление = Ложь)

	СтруктураВозврата = Новый Структура;
	
	Если НЕ Удаление Тогда

		Если Док.ПометкаУдаления Тогда
			СтруктураВозврата.Вставить("Результат", Ложь);
			СтруктураВозврата.Вставить("Сообщение", "Выбранная операция помечена на удаление!");
			Возврат СтруктураВозврата;
		КонецЕсли;
		
		Если СотрудникЦО Тогда
			Секунд = 86400; //Сутки
			Текст = "Отменить проведение операции возможно только в течение суток с момента создания!";
		Иначе
			Секунд = 3600; //Час
			Текст = "Отменить проведение операции возможно только в течение часа с момента создания!";
		КонецЕсли;
		
		Если Док.Проведен И (День(ТекущаяДата()) - День(Док.Дата)) <> 0 Тогда
			СтруктураВозврата.Вставить("Результат", Ложь);
			СтруктураВозврата.Вставить("Сообщение", "Нельзя снять с проведения операцию, созданную ранее текущего дня!");
			Возврат СтруктураВозврата;
		КонецЕсли;
		
		Если Док.Проведен И (ТекущаяДата() - Док.Дата) > Секунд Тогда
			СтруктураВозврата.Вставить("Результат", Ложь);
			СтруктураВозврата.Вставить("Сообщение", Текст);
			Возврат СтруктураВозврата;
		КонецЕсли;
		
		ЕстьДокументы = ПроверитьДокументы(Док);
		
		Если ЕстьДокументы Тогда
			СтруктураВозврата.Вставить("Результат", Ложь);
			
			Если ТипЗнч(Док) = Тип("ДокументСсылка.ЛБ_РасходОтходовДМ") Тогда
				СтруктураВозврата.Вставить("Сообщение", "Невозможно отменить проведение накладной, так как перемещение принято в ломбарде получателе.");
			Иначе
				СтруктураВозврата.Вставить("Сообщение", "Отменить проведение операции невозможно, так как есть последующие операции.");
			КонецЕсли;
			
			Возврат СтруктураВозврата;
		КонецЕсли;

		//Если ТипЗнч(Док) = Тип("ДокументСсылка.ЛБ_РасходОтходовДМ") Тогда
		//	ПеремещениеПринято = ПроверитьПринятиеПеремещения(Док);
		//	
		//	Если ПеремещениеПринято Тогда
		//		СтруктураВозврата.Вставить("Результат", Ложь);
		//		СтруктураВозврата.Вставить("Сообщение", "Невозможно отменить проведение накладной, так как перемещение принято в ломбарде получателе.");
		//		Возврат СтруктураВозврата;
		//	КонецЕсли;
		//КонецЕсли;
		
		ДокОбъект = Док.ПолучитьОбъект();
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			СтруктураВозврата.Вставить("Результат", Истина);
			Возврат СтруктураВозврата;
		Исключение
			СтруктураВозврата.Вставить("Результат", Ложь);
			СтруктураВозврата.Вставить("Сообщение", "Ошибка отмены проведения документа!");
			Возврат СтруктураВозврата;
		КонецПопытки
	Иначе
		СтруктураВозврата.Вставить("Результат", Истина);
		Возврат СтруктураВозврата;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура Провести(Команда)
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		СтруктураВозврата = ПровестиНаСервере(ТекСтрока);
		
		Если СтруктураВозврата.Результат Тогда
			ОповеститьОбИзменении(ТекСтрока);
			ОбновитьВес();
		Иначе
			Предупреждение(СтруктураВозврата.Сообщение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПровестиНаСервере(Док)
	ДокОбъект = Док.ПолучитьОбъект();

	Дата = ТекущаяДата();
	
	СтруктураВозврата = Новый Структура;

	Если ДокОбъект.ПометкаУдаления Тогда
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Сообщение", "Выбранный документ помечен на удаление!");
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ЛБ_РасходОтходовДМ") Тогда
		ЕстьВесДляРасхода = ПроверитьДоступныйВес(Док, Дата);
		
		Если НЕ ЕстьВесДляРасхода Тогда
			СтруктураВозврата.Вставить("Результат", Ложь);
			СтруктураВозврата.Вставить("Сообщение", "Недостаточно веса чтобы провести документ!");
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ЛБ_ПриходОтходовДМ") И Док.ВидОперации = Перечисления.ЛБ_ВидыОперацийОтходыДМ.ПринятьПеремещение Тогда
		Если НЕ Док.ДокументПеремещения.Проведен Тогда
			СтруктураВозврата.Вставить("Результат", Ложь);
			СтруктураВозврата.Вставить("Сообщение", "Документ перемещения не проведен.");
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;
	
	ДокОбъект.Дата = Дата;
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		СтруктураВозврата.Вставить("Результат", Истина);
		Возврат СтруктураВозврата;
	Исключение
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Сообщение", "Ошибка проведения, документ не проведен!");
		Возврат СтруктураВозврата;
	КонецПопытки
	
КонецФункции

&НаКлиенте
Процедура ПометитьНаУдаление(Команда)
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		СтруктураВозврата = ПометитьНаУдалениеНаСервере(ТекСтрока);
		
		Если СтруктураВозврата.Результат Тогда
			ОповеститьОбИзменении(ТекСтрока);
			ОбновитьВес();
		Иначе
			Предупреждение(СтруктураВозврата.Сообщение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПометитьНаУдалениеНаСервере(Док)

	СтруктураВозврата = Новый Структура;
	
	Если Док.ПометкаУдаления Тогда
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Сообщение", "Операция уже помечена на удаление!");
		Возврат СтруктураВозврата;
	КонецЕсли;

	Если СотрудникЦО Тогда
		Секунд = 86400; //Сутки
		Текст = "Удаление операции возможно только в течение суток с момента создания!";
	Иначе
		Секунд = 3600; //Час
		Текст = "Удаление операции возможно только в течение часа с момента создания!";
	КонецЕсли;
	
	Если Док.Проведен И (День(ТекущаяДата()) - День(Док.Дата)) <> 0 Тогда
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Сообщение", "Нельзя удалить операцию, созданную ранее текущего дня!");
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Если Док.Проведен И (ТекущаяДата() - Док.Дата) > Секунд Тогда
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Сообщение", Текст);
		Возврат СтруктураВозврата;
	КонецЕсли;

	ЕстьДокументы = ПроверитьДокументы(Док);
	
	Если ЕстьДокументы Тогда
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Сообщение", "Удалить операцию невозможно, так как есть последующие операции.");
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	СтруктураВозвратаОтмены = ОтменитьПроведениеНаСервере(Док, Истина);
	
	Если НЕ СтруктураВозвратаОтмены.Результат Тогда
		Возврат СтруктураВозвратаОтмены;
	Иначе
		ДокОбъект = Док.ПолучитьОбъект();
		
		Пометка = ?(ДокОбъект.ПометкаУдаления, Ложь, Истина);
		
		ДокОбъект.УстановитьПометкуУдаления(Пометка);
		СтруктураВозврата.Вставить("Результат", Истина);
		
		Возврат СтруктураВозврата;
	КонецЕсли;
		
КонецФункции

&НаСервере
Функция ПроверитьДокументы(Док)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ДвижениеОтходовОбороты.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвижениеОтходов.Обороты(
		|			&ДатаНач,
		|			&ДатаКон,
		|			Регистратор,
		|			111 = 111
		|				И 222 = 222) КАК ЛБ_ДвижениеОтходовОбороты
		|ГДЕ
		|	ЛБ_ДвижениеОтходовОбороты.Регистратор ССЫЛКА 333 = 333";
	//-МАН
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ЛБ_ПриходОтходовДМ") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "Ломбард = &Ломбард");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "222 = 222", "Склад = &Склад");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "333 = 333", "Документ.ЛБ_РасходОтходовДМ");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "ЛомбардПолучатель = &Ломбард");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "222 = 222", "СкладПолучатель = &Склад");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "333 = 333", "Документ.ЛБ_ПриходОтходовДМ");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());
	Запрос.УстановитьПараметр("ДатаНач", Док.Дата + 1);
	Запрос.УстановитьПараметр("Ломбард", Док.Ломбард);
	//+МАН 17.12.25
	Запрос.УстановитьПараметр("Склад", Док.Склад);
	//-МАН
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьДоступность()
	
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	
	Если ТекСтрока <> Неопределено Тогда
		Если ТипЗнч(ТекСтрока) = Тип("ДокументСсылка.ЛБ_РасходОтходовДМ") Тогда
			Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПечать.Доступность = Истина;
		Иначе
			Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПечать.Доступность = Ложь;
		КонецЕсли;
		
		Если ТекСтрока.Проведен Тогда
			Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокОтменитьПроведение.Доступность = Истина;
			Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПровести.Доступность = Ложь;
		Иначе
			Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокОтменитьПроведение.Доступность = Ложь;
			Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПровести.Доступность = Истина;
		КонецЕсли;
		
		Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПометитьНаУдаление.Доступность = Истина;
	Иначе
		Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПечать.Доступность = Ложь;
		Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокОтменитьПроведение.Доступность = Ложь;
		Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПометитьНаУдаление.Доступность = Ложь;
		Элементы.СписокКоманднаяПанель.ПодчиненныеЭлементы.СписокПровести.Доступность = Ложь;
	КонецЕсли;
	
	//+МАН 29.12.25
	Если ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
		Элементы.СкладЛомбарда.ТолькоПросмотр = Истина;
	Иначе
		Если Элементы.СкладЛомбарда.СписокВыбора.Количество() > 1 Тогда
			Элементы.СкладЛомбарда.ТолькоПросмотр = Ложь;
		Иначе
			Элементы.СкладЛомбарда.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	//-МАН
	
КонецПроцедуры

//+МАН 17.12.25
&НаСервере
Процедура ЗаполнитьСклады()
	Если ЗначениеЗаполнено(Ломбард) Тогда
		Склады = ЗаполнитьСписокВыбораСкладов(Ломбард);
		
		Если Склады.Количество() > 1 Тогда
			Элементы.СкладЛомбарда.СписокВыбора.Очистить();
			Элементы.СкладЛомбарда.СписокВыбора.ЗагрузитьЗначения(Склады);
			СкладЛомбарда = Справочники.ЛБ_Склады.ПустаяСсылка();
		ИначеЕсли Склады.Количество() = 1 Тогда
			Элементы.СкладЛомбарда.СписокВыбора.Очистить();
			Элементы.СкладЛомбарда.СписокВыбора.Добавить(Склады[0]);
			СкладЛомбарда = Склады[0];
		Иначе
			Элементы.СкладЛомбарда.СписокВыбора.Очистить();
			СкладЛомбарда = Справочники.ЛБ_Склады.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораСкладов(Ломбард)

	МассивСкладов = Новый Массив;
	
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_Склады.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
		               |ГДЕ
		               |	ЛБ_Склады.Владелец = &Владелец
		               |	И (ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМ)
		               |			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМЦО)
		               |			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМОбщий))";
		Запрос.УстановитьПараметр("Владелец", Ломбард);

		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивСкладов.Добавить(Выборка.Ссылка);
		Конеццикла;
	КонецЕсли;
	
	Возврат МассивСкладов;
КонецФункции

