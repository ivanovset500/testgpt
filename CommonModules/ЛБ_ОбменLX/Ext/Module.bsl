	тзСтран = Парамс.тзСтран;
	АдоСоединение = Парамс.АдоСоединение;
	СтатусКлиента = Парамс.СтатусКлиента;
	НеГрузитьАдреса = Парамс.НеГрузитьАдреса;
	тзЧерныеСтатусыКлиентов = Парамс.тзЧерныеСтатусыКлиентов;
	тзПервыхДатЗБ = Парамс.тзПервыхДатЗБ;
	
	
	ПерезаписыватьКлиентов = Ложь;
	Если Парамс.Свойство("ПерезаписыватьКлиентов") Тогда
		ПерезаписыватьКлиентов = Парамс.ПерезаписыватьКлиентов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_СоответствиеЗалогодателейLX.Залогодатель КАК Залогодатель,
	              |	ЛБ_СоответствиеЗалогодателейLX.id_LX КАК id_LX,
	              |	ЛБ_СоответствиеЗалогодателейLX.ДатаИзменения КАК ДатаИзменения
	              |ИЗ
	              |	РегистрСведений.ЛБ_СоответствиеЗалогодателейLX КАК ЛБ_СоответствиеЗалогодателейLX
	              |ГДЕ
	              |	ЛБ_СоответствиеЗалогодателейLX.id_LX = &id_LX";
	Запрос.УстановитьПараметр("id_LX", Данные.id_LX);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ПерезаписыватьКлиентов Тогда 
			Если Выборка.ДатаИзменения <> Данные.ДатаИзменения Тогда
				СоздатьКарточкуЗалогодателяПокупателя(Выборка.Залогодатель, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАдреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ);
				
				СоздатьСоответствиеЗалогодателя(Выборка.Залогодатель, Данные.id_LX, Данные.ДатаИзменения);
			КонецЕсли;
		КонецЕсли;
		Возврат Выборка.Залогодатель;	
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛБ_Залогодатели.Ссылка КАК Ссылка,
	|	ЛБ_Залогодатели.Фамилия КАК Фамилия,
	|	ЛБ_Залогодатели.Имя КАК Имя,
	|	ЛБ_Залогодатели.Отчество КАК Отчество,
	|	ЛБ_Залогодатели.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	|ГДЕ
	|	ЛБ_Залогодатели.Фамилия = &Фамилия
	|	И ЛБ_Залогодатели.Имя = &Имя
	|	И ЛБ_Залогодатели.Отчество = &Отчество
	|	И ЛБ_Залогодатели.ДатаРождения = &ДатаРождения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Фамилия",	СокрЛП(Данные.Фамилия));	
	Запрос.УстановитьПараметр("Имя",		СокрЛП(Данные.Имя));	
	Запрос.УстановитьПараметр("Отчество",   СокрЛП(Данные.Отчество));
	Запрос.УстановитьПараметр("ДатаРождения",Данные.ДатаРождения);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Если ВыборкаДетальныеЗаписи.Количество() < 1 Тогда	
		Об = Справочники.ЛБ_Залогодатели.СоздатьЭлемент();
		Об.Фамилия 		= СокрЛП(Данные.Фамилия);
		Об.Имя 			= СокрЛП(Данные.Имя);
		Об.Отчество 	= СокрЛП(Данные.Отчество);
		Об.ДатаРождения = СокрЛП(Данные.ДатаРождения);
		Если Не ЗначениеЗаполнено(Данные.Фамилия) Тогда
			Об.Наименование = СокрЛП(Данные.Имя) + " " + СокрЛП(Данные.Отчество);
		Иначе		
			Об.Наименование = СокрЛП(Данные.Фамилия) + " " + СокрЛП(Данные.Имя) + " " + СокрЛП(Данные.Отчество);
		КонецЕсли;
		Об.Записать();
		
		СоздатьСоответствиеЗалогодателя(Об.Ссылка, Данные.id_LX, Данные.ДатаИзменения);
		
		СоздатьКарточкуЗалогодателяПокупателя(Об.Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАдреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ);
		
		Возврат Об.Ссылка;		
	Иначе
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			//Карточка = ВернутьКарточкуЗалогодателя(ВыборкаДетальныеЗаписи.Ссылка);
			СоздатьСоответствиеЗалогодателя(ВыборкаДетальныеЗаписи.Ссылка, Данные.id_LX, Данные.ДатаИзменения);
			
			СоздатьКарточкуЗалогодателяПокупателя(ВыборкаДетальныеЗаписи.Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАДреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ);
			//Если Карточка = Неопределено Тогда
			//	СоздатьКарточкуЗалогодателя(ВыборкаДетальныеЗаписи.Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента);			
			//КонецЕсли;
			
			Возврат ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
	КонецЕсли;
	Возврат Справочники.ЛБ_Залогодатели.ПустаяСсылка();	
КонецФункции




