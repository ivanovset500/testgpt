				СпрОбъект.ВидДокумента 	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ВидДокумента_СвидетельствоОСмерти"); 		
				СпрОбъект.Наименование  = ЛБ_ОбщийМодуль.СформироватьНаименованиеДокументаЗалогодателя(стрДокументы);
