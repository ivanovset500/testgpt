Функция ВернутьСтруктуруБанковскойКартуПоНомеру(НомерКарты, Физлицо = Неопределено)
	Рез = Новый Структура;
	Рез.Вставить("Карта", Неопределено);
	Рез.Вставить("Физлицо", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КорпоративныеКарты.Ссылка КАК Ссылка,
	               |	ЛБ_КорпоративныеКарты.ФизическоеЛицо КАК ФизическоеЛицо
	               |ИЗ
	               |	Справочник.ЛБ_КорпоративныеКарты КАК ЛБ_КорпоративныеКарты
	               |ГДЕ
	               |	ЛБ_КорпоративныеКарты.НомерКарты = &НомерКарты";
	Запрос.УстановитьПараметр("НомерКарты", НомерКарты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда

		Рез.Вставить("Карта", Выборка.Ссылка);
		Рез.Вставить("Физлицо", Выборка.ФизическоеЛицо); 
		
	Иначе
		НовКарта = Справочники.ЛБ_КорпоративныеКарты.СоздатьЭлемент();
		НовКарта.НомерКарты = НомерКарты;
		НовКарта.ФизическоеЛицо = Физлицо;
		НовКарта.ДатаНачалаДействия = Дата(2020,01,01);
		НовКарта.ВидКарты = "visa";
		НовКарта.Записать();
		
		Рез.Вставить("Карта",   НовКарта.Ссылка);
		Рез.Вставить("Физлицо", Физлицо); 
		
		
		
		
	КонецЕсли;
		
	Возврат Рез;
КонецФункции 

Функция НайтиФизЛицоПоIDLX(id_lx, ФИО = "") 
	КодЮз = id_lx; 
	
	КодЮз = СтрЗаменить(КодЮз,Символы.НПП,"");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеФизлица_idLX.ФизическоеЛицо КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеФизлица_idLX КАК ЛБ_СоответствиеФизлица_idLX
	               |ГДЕ
	               |	ЛБ_СоответствиеФизлица_idLX.idLX = &id_LX";
	Запрос.УстановитьПараметр("id_LX", КодЮз);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли; 
	
	
	Если ФИО <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст ="ВЫБРАТЬ
		              |	ЛБ_ФИОФизическихЛиц.ФизическоеЛицо КАК Ссылка,
		              |	ЛБ_ФИОФизическихЛиц.ФИОСлужебные КАК ФИОСлужебные
		              |ИЗ
		              |	РегистрСведений.ЛБ_ФИОФизическихЛиц КАК ЛБ_ФИОФизическихЛиц
		              |ГДЕ
		              |	ЛБ_ФИОФизическихЛиц.ФИОСлужебные = &ФИОСлужебные";
		Запрос.УстановитьПараметр("ФИОСлужебные", ФИО); 
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;  
	КонецЕсли;
		
	Возврат Неопределено; 	
КонецФункции

Процедура ОткрытьКассовуюСмену(Дата, Ломбард) 
	Дата = НачалоДня(Дата);
	Запрос =  Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ОперацииКассовойСмены.Ссылка КАК Ссылка
	              |ИЗ
	              |	Документ.ЛБ_ОперацииКассовойСмены КАК ЛБ_ОперацииКассовойСмены
	              |ГДЕ
	              |	НАЧАЛОПЕРИОДА(ЛБ_ОперацииКассовойСмены.Дата, ДЕНЬ) = &Дата
	              |	И ЛБ_ОперацииКассовойСмены.Ломбард = &Ломбард
	              |	И ЛБ_ОперацииКассовойСмены.ВидОперации = &ВидОперации
	              |	И ЛБ_ОперацииКассовойСмены.Проведен = ИСТИНА";
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ЛБ_ВидыОперацийКассовойСмены.Открыть);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
	Иначе
		Док = Документы.ЛБ_ОперацииКассовойСмены.СоздатьДокумент();
		Док.Дата = НачалоДня(Дата);
		Док.Организация = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
		Док.Ломбард = Ломбард;
		Док.ВидОперации = Перечисления.ЛБ_ВидыОперацийКассовойСмены.Открыть;
		Док.Записать(РежимЗаписиДокумента.Запись);
		Док.Записать(РежимЗаписиДокумента.Проведение); 			
	КонецЕсли;
КонецПроцедуры

