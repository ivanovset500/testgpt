	тзСтавок.Колонки.Добавить("Почетный");
	тзСтавок.Колонки.Добавить("Статус");
	тзСтавок.Колонки.Добавить("Промокод");
	тзСтавок.Колонки.Добавить("ДатаНачала");
	тзСтавок.Колонки.Добавить("ДатаКонца");
	тзСтавок.Колонки.Добавить("Ставка0");
	тзСтавок.Колонки.Добавить("Ставка1");
	тзСтавок.Колонки.Добавить("Ставка2");
	тзСтавок.Колонки.Добавить("Ставка3");
	тзСтавок.Колонки.Добавить("Ставка4");
	тзСтавок.Колонки.Добавить("Ставка5"); 
	
	
	тзКамни = Новый ТаблицаЗначений; 
	тзКамни.Колонки.Добавить("ДатаДок");  
	тзКамни.Колонки.Добавить("НомерПриказа");
	тзКамни.Колонки.Добавить("id_Приказа"); 
	тзКамни.Колонки.Добавить("id_СтрокиПриказа");	
	тзКамни.Колонки.Добавить("СтрокаЛомбардов"); 
	тзКамни.Колонки.Добавить("КодВставки");  
	тзКамни.Колонки.Добавить("КодВставкиФорм");
	тзКамни.Колонки.Добавить("ВесОт"); 
	тзКамни.Колонки.Добавить("ВесДо");	
	тзКамни.Колонки.Добавить("Оценка"); 
	
	Если тз.Количество() > 0 Тогда 
		Для каждого стр из тз Цикл			
			Док = ВернутьПриказПоIDМеталлы(стр.id_LX);
			Если Док = Неопределено Тогда
				Об       = Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.СоздатьДокумент();
				Об.Дата  = стр.ДатаДок; 
				Об.ЭтоПриказМеталлы = Истина;
				Об.id_LX = стр.id_LX;
			Иначе
				Если Не Перезаписывать Тогда
					Продолжить;
				КонецЕсли;
				Об = Док.ПолучитьОбъект();
				Об.Ломбарды.Очистить();
				Об.ЦеныМеталлы.Очистить();  
				Об.СтавкиПроцентов.Очистить(); 
				Об.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
			КонецЕсли; 
			Об.ДатаНачалаДействияПриказа    = Об.Дата;
			Об.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый;
			//Об.Комментарий = стр.id_LX; 
			Об.Комментарий = стр.Osn; 
			Об.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Проект;  
			Об.НомерПриказа = стр.НомерПриказа;
			//Об.НомерПриказа = Лев(стр.Osn, 4); 
			Об.Ответственный  = Справочники.Пользователи.НайтиПоНаименованию(стр.Ответственный, Истина);
			Об.СхемыКредитования.Очистить();
			
			НовСтрСхКр = Об.СхемыКредитования.Добавить();
			//Если Об.Дата >= Дата(2023, 10, 01) Тогда
			//	НовСтрСхКр.ШаблонПроцентныеСтавки = ШаблонПриказа_Классика_33;	
			//Иначе    
			НовСтрСхКр.ШаблонПроцентныеСтавки = ШаблонПриказа_Классика;
			//КонецЕсли;				
			Если Об.Дата >= Дата(2023, 02, 01) Тогда
				НовСтрСхКр.СхемаКредитования = СхемаКлассикаГибкий; 
			Иначе 			
				НовСтрСхКр.СхемаКредитования = СхемаКлассика;
			КонецЕсли;
			
			НовСтрСхКр = Об.СхемыКредитования.Добавить();
			Если Об.Дата >= Дата(2023, 02, 01) Тогда
				Если Об.Дата >= Дата16102023 Тогда
					НовСтрСхКр.СхемаКредитования = СхемаКлассикаГибкий_5;
				Иначе 			
					НовСтрСхКр.СхемаКредитования = СхемаКлассика1ДеньГибкий; 
				КонецЕсли;
			Иначе 			
				НовСтрСхКр.СхемаКредитования = СхемаКлассика1День;
			КонецЕсли;
			НовСтрСхКр.ШаблонПроцентныеСтавки = ШаблонПриказа_1День_Классика;
			
			НовСтрСхКр = Об.СхемыКредитования.Добавить();
			Если Об.Дата >= Дата(2023, 02, 01) Тогда 
				Если Об.Дата >= Дата16102023 Тогда
					НовСтрСхКр.СхемаКредитования = СхемаЭкспрессГибкий_5;	
				Иначе  
					НовСтрСхКр.СхемаКредитования = СхемаЭкспрессГибкий;
				КонецЕсли;
			Иначе 			
				НовСтрСхКр.СхемаКредитования = СхемаЭкспресс;
			КонецЕсли;
			НовСтрСхКр.ШаблонПроцентныеСтавки = ШаблонПриказа_Экспресс;
			
			массив_id_Ломбардов = Новый Массив;
			Для инд = 0 по 400 Цикл     
				НольОдин = Сред(стр.СтрокаЛомбардов, инд, 1);
				Если СокрЛП(НольОдин) = "1" Тогда
					//id_ломбарда = инд + 1; 
					id_ломбарда = инд; 
					массив_id_Ломбардов.Добавить(СтрЗаменить(id_ломбарда, символы.НПП, "")); 
				КонецЕсли;
			КонецЦикла;
			
			КоличествоЛомбардов = 0;
			Для каждого элем из массив_id_Ломбардов Цикл
				СсылкаНаЛомбард   = ВернутьЛомбардПоID(элем);
				Если СсылкаНаЛомбард = Неопределено Тогда
					РеквизитыЛомбардаИзLX = ВернутьРеквизитыЛомбардаИзLX(элем);
					Ломб = Справочники.ЛБ_Ломбарды.СоздатьЭлемент();
					Ломб.Наименование = РеквизитыЛомбардаИзLX.Наименование;
					Ломб.НаименованиеПолное = Ломб.Наименование;   
					Ломб.НомерЛомбарда 		= РеквизитыЛомбардаИзLX.Номер;  
					Ломб.id_LX = элем; 
					Ломб.Подразделение = ВременноеПодразделение;
					Ломб.Записать();
					СсылкаНаЛомбард = Ломб.Ссылка;
				КонецЕсли;
				НовСтрЛом = Об.Ломбарды.Добавить();
				НовСтрЛом.Ломбард = СсылкаНаЛомбард;
				КоличествоЛомбардов = КоличествоЛомбардов + 1;
			КонецЦикла;		
			
			Об.СтрокаЛомбарды = ВернутьСтрокуСписокЛомбардов(Об);
			Об.КоличествоЛомбардов = КоличествоЛомбардов;
			
			
			// получаем прейскурант на металлы
			АдоСоединение2 = АдоНовоеСоединение("dCBDL");
			
			ТекстЗапроса = "exec [zPrsProcPoz] '" + стр.id_LX +"', 0"; 	
			
			тзМеталлы = Новый ТаблицаЗначений;
			тзМеталлы.Колонки.Добавить("Металл", Новый ОписаниеТипов("Строка"));
			тзМеталлы.Колонки.Добавить("Проба", Новый ОписаниеТипов("Строка")); 
			тзМеталлы.Колонки.Добавить("Категория", Новый ОписаниеТипов("Строка"));
			тзМеталлы.Колонки.Добавить("Оценка0", Новый ОписаниеТипов("Строка"));
			тзМеталлы.Колонки.Добавить("Оценка1", Новый ОписаниеТипов("Строка"));
			
			Выборка = АдоВыполнитьЗапрос(АдоСоединение2, ТекстЗапроса);
			Пока не Выборка.eof() Цикл
				nrecprs = СтрЗаменить(Выборка.fields("nrecprs").value, символы.НПП, "");
				Если стр.id_LX = nrecprs Тогда
					
					НовСтрТЗМеталл = тзМеталлы.Добавить();
					
					НовСтрТЗМеталл.Металл 		= Выборка.fields("NmMat").value; 
					НовСтрТЗМеталл.Проба  		= Выборка.fields("Proba").value;
					НовСтрТЗМеталл.Категория 	= Выборка.fields("NmKatG").value; 
					
					НовСтрТЗМеталл.Оценка0     = Выборка.fields("Ocen0").value; 
					НовСтрТЗМеталл.Оценка1     = Выборка.fields("Ocen1").value;  
				КонецЕсли;
				Выборка.movenext();
			КонецЦикла;
			
			АдоСоединение2.Close();	
			
			тзМеталлы.Свернуть("Металл,Проба,Категория,Оценка0,Оценка1");
			
			Для каждого строч из тзМеталлы Цикл	
				ТекМеталл = Справочники.ЛБ_ДрагоценныеМеталлы.НайтиПоНаименованию(строч.Металл);
				
				Проба1С     = ВернутьПробу1С(ТекМеталл, строч.Проба, тзПроб);
				
				НовСтр = Об.ЦеныМеталлы.Добавить();	 	
				НовСтр.Металл 			= ТекМеталл;
				НовСтр.Проба 			= Проба1С; 
				КатегорияОбъектаЗалога = ЛБ_ОбменLX.ВернутьКатегориюИзСоответствия(строч.Категория);
				//КатегорияОбъектаЗалога = Справочники.ЛБ_КатегорииОбъектовЗалога.НайтиПоНаименованию(строч.Категория); 	
				НовСтр.КатегорияОбъектаЗалога = КатегорияОбъектаЗалога;
				НовСтр.ЕдиницаИзмерения = ЕдИзмГрамм;
				НовСтр.Цена 			= строч.Оценка0; 
				
				Если строч.Оценка1 <> "" Тогда
					Отклонение = строч.Оценка1 - строч.Оценка0; 
					
					Если Отклонение <> 0 Тогда
						НовСтр = Об.НастройкаОтклоненийОтБазовыхЦенМеталлы.Добавить();	 	
						НовСтр.Металл 			= ТекМеталл;
						НовСтр.Проба 			= Проба1С;
						НовСтр.КатегорияОбъектаЗалога = КатегорияОбъектаЗалога;
						//					НовСтр.ЕдиницаИзмерения = ЕдИзмГрамм;
						//					НовСтр.Цена 			= Оценка1;
						Если Об.Дата >= Дата(2023, 02, 01) Тогда  
							Если Об.Дата >= Дата16102023 Тогда
								НовСтр.СхемаКредитования= СхемаЭкспрессГибкий_5;	
							Иначе
								НовСтр.СхемаКредитования= СхемаЭкспрессГибкий;
							КонецЕсли;
						Иначе
							НовСтр.СхемаКредитования= СхемаЭкспресс;
						КонецЕсли;
						НовСтр.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное;
						НовСтр.Значениеотклонения = Отклонение; 
					КонецЕсли;
				КонецЕсли;				
			КонецЦикла;
			
			
			// получаем прейскурант по сумммам
			
			АдоСоединение3 = АдоНовоеСоединение("dCBDL");
			
			ТекстЗапроса = "SELECT [NRecPrsStav]
			|,[NRecPrs]
			|,[Srt]
			|,[Stav]
			|,[xPn]
			|,[St]
			|,[Ak]
			|,[DB]
			|,[DE]
			|,[xPr]
			|,[Stav2]
			|,[Stav3]
			|,[Stav4]
			|,[Stav5]
			|,[Stav1]
			|,[PromoKod]
			|FROM [dCBDL].[dbo].[ssPrsStav]  where NRecPRS = '" + СокрЛП(стр.id_LX) + "'"; 
			
			
			Выборка = АдоВыполнитьЗапрос(АдоСоединение3, ТекстЗапроса);
			Пока не Выборка.eof() Цикл  
				НовСтроч = тзСтавок.Добавить();
				НовСтроч.ДатаДок 	    = стр.ДатаДок; 
				НовСтроч.НомерПриказа 	= стр.НомерПриказа;
				НовСтроч.СтрокаЛомбардов = стр.СтрокаЛомбардов; 
				НовСтроч.Ответственный   = стр.Ответственный;
				НовСтроч.id_Приказа 	= СтрЗаменить(Выборка.fields("NRecPrs").value, Символы.НПП, "");
				НовСтроч.id_СтрокиПриказа = СтрЗаменить(Выборка.fields("NRecPrsStav").value, Символы.НПП, "");
				НовСтроч.ВидЗайма 	  	= Выборка.fields("Ak").value;
				НовСтроч.Акция   	  	= СокрЛП(Выборка.fields("xPr").value);
				НовСтроч.Почетный 	  	= Выборка.fields("xPn").value; 
				Статус			        = СокрЛП(Выборка.fields("St").value); 
				Если СокрЛП(Статус) = "-2" Тогда
					НовСтроч.Акция   	= "-2";
					Статус              = "";
				КонецЕсли;
				НовСтроч.Статус 	    = Статус;
				
				НовСтроч.ДатаНачала    	= Выборка.fields("DB").value; 
				НовСтроч.ДатаКонца     	= Выборка.fields("DE").value;
				НовСтроч.Ставка0  		= Выборка.fields("Stav").value; 
				НовСтроч.Ставка1  		= Выборка.fields("Stav1").value;
				НовСтроч.Ставка2  		= Выборка.fields("Stav2").value; 
				НовСтроч.Ставка3  		= Выборка.fields("Stav3").value;
				НовСтроч.Ставка4  		= Выборка.fields("Stav4").value;
				НовСтроч.Ставка5  		= Выборка.fields("Stav5").value;
				НовСтроч.Промокод 		= Выборка.fields("promoKod").value;				 
				
				Выборка.movenext();
			КонецЦикла;
			АдоСоединение3.Close(); 
			ЛБ_УправлениеЛомбардом.ЗаполнитьДополнительныеРеквизитыПриказа(Об);
			Об.Записать();
			
			
			
			АдоСоединение4 = АдоНовоеСоединение("dCBDL"); 		
			
			ТекстЗапроса = "SELECT [NRecPrsVst]
			|,[NRecPrs]
			|,[KodVst]
			|,[KodVstForm]
			|,[VesOt]
			|,[VesDo]
			|,[OcenPrs]
			|,[KredPrs]
			|,[nObj] 
			|FROM [dCBDL].[dbo].[ssPRSVst]  where NRecPrs = '" + СокрЛП(стр.id_LX) + "'";			
			
			Выборка = АдоВыполнитьЗапрос(АдоСоединение4, ТекстЗапроса);
			Пока не Выборка.eof() Цикл
				НовСтроч = тзКамни.Добавить();
				НовСтроч.ДатаДок 	    = стр.ДатаДок; 
				НовСтроч.НомерПриказа 	= стр.НомерПриказа;
				НовСтроч.СтрокаЛомбардов = стр.СтрокаЛомбардов;
				НовСтроч.id_Приказа 	= СтрЗаменить(Выборка.fields("NRecPrs").value, Символы.НПП, ""); 
				
				НовСтроч.КодВставки     = Выборка.fields("KodVst").value;
				НовСтроч.КодВставкиФорм = Выборка.fields("KodVstForm").value;
				НовСтроч.ВесОт     		= Выборка.fields("VesOt").value;
				НовСтроч.ВесДо     		= Выборка.fields("VesDo").value;
				НовСтроч.Оценка     	= Выборка.fields("OcenPrs").value; 					 
				
				Выборка.movenext();
			КонецЦикла;
			АдоСоединение4.Close(); 	
			
			
		КонецЦикла; 	
	КонецЕсли; 
	
	тзПриказов = тзСтавок.Скопировать();
	тзПриказов.Свернуть("id_Приказа, НомерПриказа, СтрокаЛомбардов, Ответственный, ДатаДок, ДатаНачала, ДатаКонца, Почетный, Промокод, Акция");
	
	Для каждого СтрокаПриказа из тзПриказов Цикл
		отб = Новый Структура("id_Приказа, НомерПриказа, СтрокаЛомбардов, Ответственный, ДатаНачала, ДатаКонца, Почетный, Промокод, Акция");
		ЗаполнитьЗначенияСвойств(отб, СтрокаПриказа);
		
		LX_СтрокиПриказа = "";
		НайденныеСтроки = тзСтавок.НайтиСтроки(Отб);
		Для каждого стр из НайденныеСТроки Цикл
			LX_СтрокиПриказа = LX_СтрокиПриказа + стрЗаменить(стр.id_СтрокиПриказа, Символы.НПП, "") + ",";			
		КонецЦикла; 
		Если  (Не ЗначениеЗаполнено(СтрокаПриказа.ДатаНачала)) 
			И (Не ЗначениеЗаполнено(СтрокаПриказа.ДатаКонца)) 
			И СокрЛП(СтрокаПриказа.Акция) = ""
			И (НЕ СтрокаПриказа.Почетный)
			И (НЕ ЗначениеЗаполнено(СтрокаПриказа.Промокод)) ТОГДА
			ЭтоБудетАкция = Ложь; 
			
			
			Док = ВернутьПриказПоIDМеталлы(стр.id_Приказа);
			Если Док = Неопределено Тогда
				Об       = Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.СоздатьДокумент();
				Об.Дата  = стр.ДатаДок; 
				Об.ЭтоПриказМеталлы = Истина;
				Об.id_LX = стр.id_Приказа;   
				Об.LX_СтрокиПриказа = LX_СтрокиПриказа;
			Иначе
				Если Не Перезаписывать Тогда
					Продолжить;
				КонецЕсли;
				Об = Док.ПолучитьОбъект(); 
				Об.СтавкиПроцентов.Очистить(); 
			КонецЕсли;		
		Иначе		
			
			Док = ВернутьПриказПоIDСтавки(СтрокаПриказа.id_Приказа, LX_СтрокиПриказа);
			Если Док = Неопределено Тогда
				Об       			= Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.СоздатьДокумент();
				Об.Дата  			= СтрокаПриказа.ДатаДок;
				Об.ВидОперации 		= Перечисления.ЛБ_ВидыОперацийПриказы.Базовый; 
				Об.ЭтоПриказСтавки 	= Истина;
				Об.id_LX 			= СтрокаПриказа.id_Приказа;
				Об.LX_СтрокиПриказа = LX_СтрокиПриказа;    
			Иначе 
				Если Не Перезаписывать Тогда
					Продолжить;
				КонецЕсли;
				Об = Док.ПолучитьОбъект(); 
				Об.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый;  
				Об.Ломбарды.Очистить();
				Об.ЦеныМеталлы.Очистить();  
				Об.СтавкиПроцентов.Очистить(); 
				Об.УсловияАкцииСтавки.Очистить();
			КонецЕсли;  
