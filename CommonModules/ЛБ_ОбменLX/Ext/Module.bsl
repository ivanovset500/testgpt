		|	КОНЕЦ КАК xV
		|ИЗ
		|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
		|			,
		|			ДокументЗалогодателя.Владелец = &Залогодатель
		//|				И ПричинаИзменения = ЗНАЧЕНИЕ(Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.НовыйДокумент)
		//|				И ВЫБОР
		//|					КОГДА СТРНАЙТИ(Изменения, ""Создан новый документ"") > 0
		//|						ТОГДА ИСТИНА
		//|					ИНАЧЕ ЛОЖЬ
		//|				КОНЕЦ
		|				) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
		|		ПО ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка
		|ГДЕ
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.Период 111 = 111 &Дата";
		
	Если ДокументыДо Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "<=");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", ">=");
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		Возврат РезультатЗапроса;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ВернутьКодLXПоВидДокументаФизлица(ВидДокумента)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеВидовДокументовФизлиц.КодLX КАК КодLX
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеВидовДокументовФизлиц КАК ЛБ_СоответствиеВидовДокументовФизлиц
	               |ГДЕ
	               |	ЛБ_СоответствиеВидовДокументовФизлиц.ВидДокумента = &ВидДокумента";
	
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КодLX;
	КонецЕсли;
	
	Возврат Null;
КонецФункции

Функция ПолучитьСформироватьКодДокументаКлиента(Залогодатель, Ломбард, СсылкаДок)
	
	//Формируем новый код
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоответствиеКодаЗалогодателяВЛомбардеLX.КодВLX КАК КодВLX,
		|	ЛБ_СоответствиеКодаЗалогодателяВЛомбардеLX.КодДокВLX КАК КодДокВLX
		|ИЗ
		|	РегистрСведений.ЛБ_СоответствиеКодаЗалогодателяВЛомбардеLX КАК ЛБ_СоответствиеКодаЗалогодателяВЛомбардеLX
		|ГДЕ
		|	ЛБ_СоответствиеКодаЗалогодателяВЛомбардеLX.Ломбард = &Ломбард";
	
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Если РезультатЗапроса.КодДокВLX = 0 Тогда
			Возврат 0;
		КонецЕсли;
		
		КодДокументаКлиента = РезультатЗапроса.КодДокВLX * -1000 - Ломбард.id_LX;
		
		НаборЗаписей = РегистрыСведений.ЛБ_СоответствиеКодаЗалогодателяВЛомбардеLX.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Ломбард.Установить(Ломбард);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Ломбард = Ломбард;
		НоваяЗапись.КодВLX = РезультатЗапроса.КодВLX;;
		НоваяЗапись.КодДокВLX = РезультатЗапроса.КодДокВLX + 1;
		НаборЗаписей.Записать();
		
		ДокОбъект = СсылкаДок.ПолучитьОбъект();
		ДокОбъект.id_LX = КодДокументаКлиента;
		ДокОбъект.Записать();
		
		Возврат КодДокументаКлиента;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Функция ЗаполнитьСтрокуТЗ(Залогодатель, Ломбард, КодКлиента, КодДокументаКлиента, СтрТЗ)
	
	Если ЗначениеЗаполнено(СтрТЗ.NRecClientDoc) Тогда
		
		РасчитанныйКодЛомбарда = Прав(СтрТЗ.NRecClientDoc, 3);
		
		Если Лев(РасчитанныйКодЛомбарда, 1) = "0" Тогда
			РасчитанныйКодЛомбарда = Прав(РасчитанныйКодЛомбарда, 2);
			
			Если Лев(РасчитанныйКодЛомбарда, 1) = "0" Тогда
				РасчитанныйКодЛомбарда = Прав(РасчитанныйКодЛомбарда, 1);
			КонецЕсли;
		КонецЕсли;
		
		ЛомбардПоРасчитанномуКоду = ПолучитьЛомбардПоКодуLX(РасчитанныйКодЛомбарда);
		
		Если ЛомбардПоРасчитанномуКоду <> Неопределено Тогда
			СтрТЗ.nObj = РасчитанныйКодЛомбарда;
		КонецЕсли;
		
		//Если НЕ ЗначениеЗаполнено(СтрТЗ.Kod1C) Тогда
			Если СтрТЗ.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилет Тогда
				СтрТЗ.Kod1C = "07";
			ИначеЕсли СтрТЗ.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.НайтиПоНаименованию("миграционная карта") Тогда
				СтрТЗ.Kod1C = "3";
			Иначе
				СтрТЗ.Kod1C = ВернутьКодLXПоВидДокументаФизлица(СтрТЗ.ВидДокумента);
			КонецЕсли;
			//СтрТЗ.Kod1C = ВернутьКодLXПоВидДокументаФизлица(СтрТЗ.ВидДокумента);
		//КонецЕсли;
		
		СтрТЗ.KodClient = КодКлиента;

	Иначе
		//КодДокументаКлиента = ПолучитьСформироватьКодДокументаКлиента(Залогодатель, Ломбард, СтрТЗ.СсылкаДок);
		СтрТЗ.NRecClientDoc = КодДокументаКлиента;
		СтрТЗ.nObj = Ломбард.id_LX;
		
		//Если НЕ ЗначениеЗаполнено(СтрТЗ.Kod1C) Тогда
			Если СтрТЗ.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилет Тогда
				СтрТЗ.Kod1C = "07";
			ИначеЕсли СтрТЗ.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.НайтиПоНаименованию("миграционная карта") Тогда
				СтрТЗ.Kod1C = "3";
			Иначе
				СтрТЗ.Kod1C = ВернутьКодLXПоВидДокументаФизлица(СтрТЗ.ВидДокумента);
			КонецЕсли;
			//СтрТЗ.Kod1C = ВернутьКодLXПоВидДокументаФизлица(СтрТЗ.ВидДокумента);
		//КонецЕсли;
		
		СтрТЗ.KodClient = КодКлиента;
	КонецЕсли;
	
	Возврат СтрТЗ;
КонецФункции

Функция ПолучитьДанныеСмерти(Залогодатель)
	
	СтруктураВозврата = Новый Структура("ДатаВыдачи, Номер");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер
		|ИЗ
		|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
		|			,
		|			ДокументЗалогодателя.Владелец = &Залогодатель
		|				И ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти)) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, РезультатЗапроса);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

