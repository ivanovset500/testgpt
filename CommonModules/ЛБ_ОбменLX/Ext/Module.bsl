Функция ЗагрузитьСценарийПрейскуранта(ПараметрыЗагр) Экспорт
	
	Перезаписывать = Истина;
	Если ПараметрыЗагр.Свойство("Перезаписывать") Тогда
		Перезаписывать = ПараметрыЗагр.Перезаписывать;
	КонецЕсли;
	Если ПараметрыЗагр.Свойство("НачДата") Тогда
		НачДата = ПараметрыЗагр.НачДата;
	Иначе
		Сообщить("Заполните начальную дату загрузки");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыЗагр.Свойство("КонДата") Тогда
		КонДата = ПараметрыЗагр.КонДата;
	Иначе
		КонДата = ТекущаяДата();
	КонецЕсли;
	
	
	АдоСоединение = АдоНовоеСоединение("dCBDL");
	
	//ssPRS  
	
	ТекстЗапроса = "SELECT [NRecPRS]
	|,[NPrs]
	|,[DPrs]
	|,[Stat]
	|,[Proc]
	|,[DLast]
	|,[WLast]
	|,[xDel]
	|,[pdSync0]
	|,[NDoc]
	|,[Osn]
	|,[ProcPens]
	|,[ProcGold]     
	|FROM [dCBDL].[dbo].[ssPRS] WHERE stat = 0 and [DPrs] >= '" + НачДата + "' and [DPrs] <= '" + КонДата + "' order by DPrs desc";		
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_LX", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("СтрокаЛомбардов", 	Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ДатаДок", 			Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("НомерПриказа", 	Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Комментарий", 		Новый ОписаниеТипов("Строка"));
	
	Пока не Выборка.eof() Цикл
		НовСтр = тз.Добавить();
		НовСтр.СтрокаЛомбардов = Выборка.fields("pdSync0").value;
		НовСтр.ДатаДок         = Выборка.fields("DPrs").value; 
		НовСтр.id_LX           = СтрЗаменить(Выборка.fields("NRecPRS").value, Символы.НПП, "");
		НовСтр.НомерПриказа    = СтрЗаменить(Выборка.fields("NPrs").value, Символы.НПП, "");
		НовСтр.Комментарий     = Выборка.fields("Osn").value;
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	ЕдИзмГрамм             		= Константы.ЛБ_ОсновнаяЕдиницаМеталлы.Получить();
	ВременноеПодразделение 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновноеПодразделение");
	СхемаКлассика          		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Классика");
	СхемаЭкспресс          		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Экспресс");
	СтатусПочетный         		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Почетный");
	ПричинаПрименения      		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ПричинаПрименения_Выдача"); 
	Акция_Промокод_Мыценим 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Акция_Промокод_Мыценим");
	Акция_ЭтоАкция 				= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Акция_ЭтоАкция"); 
	Акция_Сверхновый            = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Акция_Сверхновый");
	Акция_ПочетныйВозвраст      = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Акция_ПочетныйВозвраст");
	ДиапазонСумм_До3000    		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ДиапазонСумм_До3000");
	ДиапазонСумм_До10000    	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ДиапазонСумм_До10000");
	ДиапазонСумм_До25000    	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ДиапазонСумм_До25000");
	ДиапазонСумм_До50000    	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ДиапазонСумм_До50000");
	ДиапазонСумм_До100000    	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ДиапазонСумм_До100000");
	ДиапазонСумм_Больше100000   = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ДиапазонСумм_Больше100000");
	
	Категория3                  = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Категория3");
	ГруппаПроб_585              = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ГруппаПроб_585");
	ГруппаПроб_Платина          = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ГруппаПроб_Платина");
	ГруппаПроб_Серебро          = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ГруппаПроб_Серебро");
	
	тзСтавок = Новый ТаблицаЗначений;  
	тзСтавок.Колонки.Добавить("ДатаДок");  
	тзСтавок.Колонки.Добавить("НомерПриказа");
	тзСтавок.Колонки.Добавить("id_Приказа"); 
	тзСтавок.Колонки.Добавить("id_СтрокиПриказа");	
	тзСтавок.Колонки.Добавить("СтрокаЛомбардов"); 
	тзСтавок.Колонки.Добавить("Акция");
	тзСтавок.Колонки.Добавить("ВидЗайма");
	тзСтавок.Колонки.Добавить("Почетный");
	тзСтавок.Колонки.Добавить("Статус");
	тзСтавок.Колонки.Добавить("Промокод");
	тзСтавок.Колонки.Добавить("ДатаНачала");
	тзСтавок.Колонки.Добавить("ДатаКонца");
	тзСтавок.Колонки.Добавить("Ставка0");
	тзСтавок.Колонки.Добавить("Ставка1");
	тзСтавок.Колонки.Добавить("Ставка2");
	тзСтавок.Колонки.Добавить("Ставка3");
	тзСтавок.Колонки.Добавить("Ставка4");
	тзСтавок.Колонки.Добавить("Ставка5"); 
	
	тзПроб = ВернутьТЗПроб();
	
	
	Если тз.Количество() > 0 Тогда 
		Для каждого стр из тз Цикл			
			Док = ВернутьСценарий(стр.id_LX);
			Если Док = Неопределено Тогда
				Об       = Справочники.ЛБ_СценарииОценки.Создатьэлемент();
				Об.Дата  = стр.ДатаДок; 
				Об.id_LX = стр.id_LX;
			Иначе
				Если Не Перезаписывать Тогда
					Продолжить;
				КонецЕсли;
				Об = Док.ПолучитьОбъект();
				Об.БазовыеНастройки.Очистить();
				Об.ОценкаПоБазовойКатегории.Очистить();  
			КонецЕсли; 
			Об.Наименование = стр.Комментарий;  
			
			массив_id_Ломбардов = Новый Массив;
