	               |ГДЕ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен = ИСТИНА";  
	
	тзНастроек = Запрос.Выполнить().Выгрузить();

	
	Пока не Выборка.eof() Цикл
