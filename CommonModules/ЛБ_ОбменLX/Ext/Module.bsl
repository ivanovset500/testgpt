Процедура ЗаполнитьОценкаПоБазовойКатегории(Об, тзМеталлы, Строки3Категории, КлючСтр) 
	
	Для каждого БигСтроч из Строки3Категории Цикл
		КлючСтр = КлючСтр + 1;
		НовСтр = Об.БазовыеНастройки.Добавить();	 	
		НовСтр.Металл 			= БигСтроч.Металл;
		НовСтр.БазоваяПроба 	= БигСтроч.ГруппаПроб;   				
		НовСтр.БазоваяКатегория = БигСТроч.Категория;
		НовСтр.БазоваяЦена 		= БигСтроч.Оценка0;
		НовСтр.ОтклонениеОтБазовойПоУмолчанию = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное;
		НовСтр.ПорядокОкругления = Перечисления.ПорядкиОкругления.Окр50; 
		НовСтр.ОкруглятьВБольшуюСторону = Истина;
		НовСтр.КлючСтроки        = КлючСтр;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Металл",    БигСтроч.Металл); 
		//Отбор.Вставить("ГруппаПроб",БигСтроч.ГруппаПроб); 
		НайдСтрокиОстальные = тзМеталлы.НайтиСтроки(Отбор); 
		
		Для каждого МалСтр из НайдСтрокиОстальные Цикл
			НовОценка = Об.ОценкаПоБазовойКатегории.Добавить();	
			НовОценка.КатегорияОбъектаЗалога 	= МалСтр.Категория;  
			НовОценка.Металл 					= БигСтроч.Металл; 
			НовОценка.Проба 					= МалСтр.ГруппаПроб; 
			НовОценка.ОклонениеОтБазовой 		= Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное;
			НовОценка.ЗначениеОтклонения        = МалСтр.Оценка0 - БигСтроч.Оценка0; 	
			НовОценка.ПорядокОкругления 		= Перечисления.ПорядкиОкругления.Окр50; 
			НовОценка.ОкруглятьВБольшуюСторону 	= Истина;
			НовОценка.КлючСтроки        			= КлючСтр;
		КонецЦикла;							
	КонецЦикла;
	
	
	
КонецПроцедуры


Функция ВернутьТЗПроб() 
	ЗапросПроб = Новый Запрос;
	ЗапросПроб.Текст ="ВЫБРАТЬ
	|	ЛБ_Пробы.Ссылка КАК Ссылка,
	|	ЛБ_Пробы.Владелец КАК Владелец,
	|	ЛБ_Пробы.Проба КАК Проба
	|ИЗ
	|	Справочник.ЛБ_Пробы КАК ЛБ_Пробы"; 
	Возврат ЗапросПроб.Выполнить().Выгрузить();
КонецФункции




