Функция ДокументВалидныйНов(тзНастроек, РеквизитыДока)
	Рез = Истина;   		
	
	Отб = Новый Структура;
	Отб.Вставить("ВидДокумента", РеквизитыДока.ВидДокумента); 
	Отб.Вставить("ВидДокументаЗалогодателя", РеквизитыДока.ВидДокументаЗалогодателя); 
	Отб.Вставить("Обязателен", Истина);
	
	БылаВыборка = Ложь;
	НайдСтроки = тзНастроек.НайтиСтроки(отб);
	Для каждого строч из НайдСтроки Цикл
		БылаВыборка = Истина;
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументСерия И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументСерия) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументНомер И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументНомер) Тогда
			Возврат Ложь; 
		КонецЕсли;
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументДатаВыдачи И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументДатаВыдачи) Тогда
			Возврат Ложь;
		КонецЕсли; 
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументКемВыдан И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументКемВыдан) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументКодПодразделения И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументКодПодразделения) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументГражданство И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументГражданство) Тогда
			Возврат Ложь; 
		КонецЕсли; 
		Если строч.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументСрокДействия И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументСрокДействия) Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла; 
	Если Не БылаВыборка Тогда
		Рез = Ложь;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции



Функция ДокументВалидный(РеквизитыДока)
	Рез = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДокумента", РеквизитыДока.ВидДокумента);
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", РеквизитыДока.ВидДокументаЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Реквизит КАК Реквизит,
	|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен КАК Обязателен,
	|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Видимость КАК Видимость,
	|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.КоличествоСимволов КАК КоличествоСимволов,
	|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ТолькоЦифры КАК ТолькоЦифры
	|ИЗ
	|	РегистрСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя КАК ЛБ_НастройкаРеквизитовДокументовЗалогодателя
	|ГДЕ
	|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокумента = &ВидДокумента
	|	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
	|	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен = ИСТИНА"; 
	
	БылаВыборка = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		БылаВыборка = Истина;
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументСерия И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументСерия) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументНомер И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументНомер) Тогда
			Возврат Ложь; 
		КонецЕсли;
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументДатаВыдачи И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументДатаВыдачи) Тогда
			Возврат Ложь;
		КонецЕсли; 
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументКемВыдан И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументКемВыдан) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументКодПодразделения И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументКодПодразделения) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументГражданство И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументГражданство) Тогда
			Возврат Ложь; 
		КонецЕсли; 
		Если Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументСрокДействия И
			НЕ ЗначениеЗаполнено(РеквизитыДока.ДокументСрокДействия) Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла; 
	Если Не БылаВыборка Тогда
		Рез = Ложь;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции


