				Движение1 = НаборЗаписей.Добавить();
				Движение1.Регистратор = Док.Ссылка;
				Движение1.Залогодатель = Док.Залогодатель;
				Движение1.Период = Док.Дата;
				Движение1.Комментарий = "Загружен из Эликс";
				Движение1.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
				Движение1.Используется = Ложь;
				
				Движение2 = НаборЗаписей.Добавить();
				Движение2.Регистратор = Док.Ссылка;
				Движение2.Залогодатель = Док.Залогодатель;
				Движение2.Период = Док.Дата;
				Движение2.Комментарий = "Загружен из Эликс";
				Движение2.Статус = Справочники.ЛБ_СтатусыЗалогодателей.VIP;
				Движение2.Используется = Ложь;
				
				Движение3 = НаборЗаписей.Добавить();
				Движение3.Регистратор = Док.Ссылка;
				Движение3.Залогодатель = Док.Залогодатель;
				Движение3.Период = Док.Дата;
				Движение3.Комментарий = "Загружен из Эликс";
				Движение3.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник;
				Движение3.Используется = Ложь;
				
			КонецЕсли;
			
			НаборЗаписей.Отбор.Регистратор.Установить(Док.Ссылка);
			НаборЗаписей.Записать(Ложь);
			
		КонецЕсли;
		//-Мельников
	КонецЕсли;
КонецПроцедуры


