				СпрОбъект.НаименованиеПолное = ЛБ_ОбщийМодуль.СформироватьПолноеНаименованиеДокументаЗалогодателя(стрДокументы);
				СпрОбъект.Записать();
				СсылкаСпр = СпрОбъект.Ссылка; 
			Иначе
				ОбДокум = СсылкаСпр.ПолучитьОбъект(); 
				ОбДокум.Гражданство = Данные.Гражданство;
				ОбДокум.Записать();			
			КонецЕсли; 
			
			НоваяСтр = Док.ДокументыЗалогодателя.Добавить();
			НоваяСтр.ДокументЗалогодателя 		= СсылкаСпр;
			НоваяСтр.ВидДокумента 				= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ВидДокумента_СвидетельствоОСмерти");
			НоваяСтр.ВидДокументаЗалогодателя 	= Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент;;
			НоваяСтр.Гражданство 				= Данные.Гражданство;
			НоваяСтр.ДокументДатаВыдачи 		= Данные.ДатаВыдачиСвидСм;
			НоваяСтр.ДокументНачалоДействия 	= Данные.ДатаВыдачиСвидСм;
			НоваяСтр.ДатаСмерти 				= Данные.ДатаСмерти;
			//НоваяСтр.ДокументСерия 				= Данные.СерияСвидСм;
			НоваяСтр.ДокументНомер 				= Данные.НомерСвидСм;
			
			Док.Записать(РежимЗаписиДокумента.Проведение); 	
		КонецЕсли;
	КонецЕсли;
	
	//+Мельников 16.07.24 Добавление записи о статусе в регистр сведений
	Если Док <> Неопределено Тогда
		НаборЗаписей = РегистрыСведений.ЛБ_СтатусыЗалогодателейДополнительные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Док.Ссылка);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			
			НаборЗаписей.Записывать = Истина;
			
			Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(Док.ДатаРождения, Док.Пол) Тогда
				
				Движение1 = НаборЗаписей.Добавить();
				Движение1.Регистратор = Док.Ссылка;
				Движение1.Залогодатель = Док.Залогодатель;
				Движение1.Период = Док.Дата;
				Движение1.Комментарий = "Загружен из Эликс";
				Движение1.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
				Движение1.Используется = Истина;
				
				Движение2 = НаборЗаписей.Добавить();
				Движение2.Регистратор = Док.Ссылка;
				Движение2.Залогодатель = Док.Залогодатель;
				Движение2.Период = Док.Дата;
				Движение2.Комментарий = "Загружен из Эликс";
				Движение2.Статус = Справочники.ЛБ_СтатусыЗалогодателей.VIP;
				Движение2.Используется = Ложь;
				
				Движение3 = НаборЗаписей.Добавить();
				Движение3.Регистратор = Док.Ссылка;
				Движение3.Залогодатель = Док.Залогодатель;
				Движение3.Период = Док.Дата;
				Движение3.Комментарий = "Загружен из Эликс";
				Движение3.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник;
				Движение3.Используется = Ложь;
				
			Иначе
				
				Движение1 = НаборЗаписей.Добавить();
				Движение1.Регистратор = Док.Ссылка;
				Движение1.Залогодатель = Док.Залогодатель;
				Движение1.Период = Док.Дата;
				Движение1.Комментарий = "Загружен из Эликс";
				Движение1.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
				Движение1.Используется = Ложь;
				
				Движение2 = НаборЗаписей.Добавить();
				Движение2.Регистратор = Док.Ссылка;
				Движение2.Залогодатель = Док.Залогодатель;
				Движение2.Период = Док.Дата;
				Движение2.Комментарий = "Загружен из Эликс";
				Движение2.Статус = Справочники.ЛБ_СтатусыЗалогодателей.VIP;
				Движение2.Используется = Ложь;
				
				Движение3 = НаборЗаписей.Добавить();
				Движение3.Регистратор = Док.Ссылка;
				Движение3.Залогодатель = Док.Залогодатель;
				Движение3.Период = Док.Дата;
				Движение3.Комментарий = "Загружен из Эликс";
				Движение3.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник;
				Движение3.Используется = Ложь;
				
			КонецЕсли;
			
			НаборЗаписей.Отбор.Регистратор.Установить(Док.Ссылка);
			НаборЗаписей.Записать(Ложь);
			
		КонецЕсли;
		//-Мельников
	КонецЕсли;
КонецПроцедуры

Процедура СоздатьКарточкуЗалогодателяПокупателя(Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАдреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ) 
	АдоСоединениеdCBDL = АдоНовоеСоединение("dCBDL_dan");
	
	Парамс = Новый Структура;
	Парамс.Вставить("АдоСоединение", 		АдоСоединениеdCBDL);
	Парамс.Вставить("ФИО", 			 		СокрЛП(Ссылка.Наименование));
	Парамс.Вставить("ДатаРожденияСтрокой", 	Формат(Ссылка.ДатаРождения, "ДФ=yyyyMMdd"));
	Парамс.Вставить("тзСтран", 				тзСтран);  	  
	Парамс.Вставить("id", 					Данные.id_LX);  	
	
	
	мДокументы = ВернутьДокументыКлиентаПокупателя(Парамс);
	
	промДокументы = мДокументы.Скопировать();
	промДокументы.Свернуть("ВидДокумента, ДокументСерия, ДокументНомер, ДокументДатаВыдачи"); 
	
	
	РеквизитыАнкеты = ВернутьДанныеАнкетыКлиентаПокупателя(АдоСоединениеdCBDL, Данные.id_LX);
	
	ПоследнийДок = Неопределено;
	ЭтоПервыйДок = Истина;
	Для каждого стрПромДокументы из промДокументы Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("ВидДокумента", стрПромДокументы.ВидДокумента); 
		Отбор.Вставить("ДокументСерия", стрПромДокументы.ДокументСерия);
		Отбор.Вставить("ДокументНомер", стрПромДокументы.ДокументНомер);
		Отбор.Вставить("ДокументДатаВыдачи", стрПромДокументы.ДокументДатаВыдачи); 	
		
		НайденныеДоки = мДокументы.НайтиСтроки(Отбор);
		//	НайденныеДоки.Сортировать("ДатаСортировки");
		
		стрДокументы = НайденныеДоки[0];
		
		Карточка_КЛ = ВернутьКарточкуПоIDДокумента(стрДокументы.КодЭликсДокумента);
		Если Карточка_КЛ = Неопределено Тогда	
			Док = Документы.ЛБ_КарточкаЗалогодателя.СоздатьДокумент();
		Иначе
			Док = Карточка_КЛ.ПолучитьОбъект();
		КонецЕсли;
		Док.id_LX               = стрДокументы.КодЭликсДокумента; 
		Док.Залогодатель 		= Ссылка;   
		
		Если НеГрузитьАдреса Тогда    
			ИсключаяСвойства = "id_LX, АдресПоПрописке, АдресПоПропискеLX, АдресПоПропискеСтруктура,ФактическийАдрес,ФактическийАдресLX,ФактическийАдресСтруктура,ПочтовыйАдрес,ПочтовыйАдресLX,ПочтовыйАдресСтруктура";
		Иначе    
			ИсключаяСвойства = "id_LX";
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Док, Данные,,ИсключаяСвойства); 
		
		Если ЗначениеЗаполнено(стрДокументы.ДокументДатаРегистрацииLX) Тогда 
			Если НачалоДня(стрДокументы.ДокументДатаРегистрацииLX) = стрДокументы.ДокументДатаРегистрацииLX Тогда  
				Док.Дата = НачалоДня(стрДокументы.ДокументДатаРегистрацииLX)-1;
			Иначе
				Док.Дата     		= стрДокументы.ДокументДатаРегистрацииLX;
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеЗаполнено(стрДокументы.ДокументДатаВыдачи) Тогда
				Продолжить;
			КонецЕсли;
			Док.Дата 			= стрДокументы.ДокументДатаВыдачи;
		КонецЕсли;
		Если Док.Дата >= Дата(2050,01,01) Тогда
			Док.Дата = Дата(2020,01,01);		
		КонецЕсли;
		Док.ДатаРождения 		= Данные.ДатаРождения;
		Док.Фамилия  			= Данные.Фамилия;
		Док.Имя      			= Данные.Имя;
		Док.Отчество 			= Данные.Отчество;    	
		Док.ПричинаИзменения 	= Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ЗагрузкаИзДругойБазы; 
		Док.Ответственный 		= Пользователи.ТекущийПользователь();
		Док.ИзмененияКИ 		= "Загружен из Эликс";  
		//Док.ПричинаИзмененияФИО = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ЗагрузкаИзДругойБазы; 
		Док.ИзмененияАнкета     =  Истина; 
		Док.ИсточникПроисхожденияИмуществаИной       = ""; 
		Док.ИсточникПроисхожденияДенежныхСредствИной = "";
		Если РеквизитыАнкеты.ДеловаяРепутация = "Положительная" Тогда
			Док.ДеловаяРепутацияПоложительная = Истина;
		ИначеЕсли РеквизитыАнкеты.ДеловаяРепутация = "Негативная" Тогда
			Док.ДеловаяРепутацияПоложительная = Ложь;
		КонецЕсли; 
		
		Если СокрЛП(РеквизитыАнкеты.ФинансовоеПоложение) = "1" Тогда
			Док.ФинансовоеПоложениеСтабильное = Истина;
		Иначе
			Док.ФинансовоеПоложениеСтабильное = Ложь;
		КонецЕсли;
		Док.Комментарий = РеквизитыАнкеты.Примечание;	
		
		Если ЗначениеЗаполнено(РеквизитыАнкеты.ИсточникПроисхожденияИмущества) Тогда
			Источн = Справочники.ЛБ_ИсточникиПроисхожденияИмущества.НайтиПоНаименованию(РеквизитыАнкеты.ИсточникПроисхожденияИмущества, Истина);
			Если Источн = Справочники.ЛБ_ИсточникиПроисхожденияИмущества.ПустаяСсылка() Тогда
				Док.ИсточникПроисхожденияИмуществаИной = РеквизитыАнкеты.ИсточникПроисхожденияИмущества;
			Иначе
				Док.ИсточникПроисхожденияИмущества     = Источн;
			КонецЕсли;
		КонецЕсли; 
		Если ЗначениеЗаполнено(РеквизитыАнкеты.ИсточникПроисхожденияДенежныхСредств) Тогда
			Источн = Справочники.ЛБ_ИсточникиПроисхожденияДенежныхСредств.НайтиПоНаименованию(РеквизитыАнкеты.ИсточникПроисхожденияДенежныхСредств, Истина);
			Если Источн = Справочники.ЛБ_ИсточникиПроисхожденияДенежныхСредств.ПустаяСсылка() Тогда
				Док.ИсточникПроисхожденияДенежныхСредствИной = РеквизитыАнкеты.ИсточникПроисхожденияДенежныхСредств;
			Иначе
				Док.ИсточникПроисхожденияДенежныхСредств     = Источн;
			КонецЕсли;
		КонецЕсли;
		
		Если СокрЛП(РеквизитыАнкеты.КатегорияФизЛица) = "1" Тогда 
			Док.КатегорииФизЛица = "Клиент";
		ИначеЕсли СокрЛП(РеквизитыАнкеты.КатегорияФизЛица) = "2" Тогда 
			Док.КатегорииФизЛица = "Представитель клиента"; 
		ИначеЕсли СокрЛП(РеквизитыАнкеты.КатегорияФизЛица) = "3" Тогда 
			Док.КатегорииФизЛица = "Выгодоприобретатель";
		ИначеЕсли СокрЛП(РеквизитыАнкеты.КатегорияФизЛица) = "4" Тогда 
			Док.КатегорииФизЛица = "Бенефициарный владелец";
		КонецЕсли;
		
		УровеньРиска = "Низкий, отсутствуют критерии повышенного риска";
		Если ЗначениеЗаполнено(СокрЛП(РеквизитыАнкеты.УровеньРиска)) Тогда 
			УровеньРиска = СокрЛП(РеквизитыАнкеты.УровеньРиска);
		КонецЕсли;			
		Док.УровеньРиска = УровеньРиска;
		
		
		Док.ДатаОформленияАнкеты = РеквизитыАнкеты.ДатаОформленияАнкеты; 
		
		отбр = Новый Структура("id_Клиента", Данные.id_LX); 
		нстрочки = тзПервыхДатЗБ.НайтиСтроки(Новый Структура("id_Клиента", Данные.id_LX));
		Для каждого стр_Нстрочки из нстрочки Цикл
			Если ЗначениеЗаполнено(РеквизитыАнкеты.ДатаОформленияАнкеты) Тогда
				Если стр_Нстрочки.Дата < РеквизитыАнкеты.ДатаОформленияАнкеты тогда
					Док.ДатаОформленияАнкеты = стр_Нстрочки.Дата; 
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Док.ДатаОформленияАнкеты) Тогда
			Док.СогласиеНаСМСРассылку = РеквизитыАнкеты.РассылкаСМС;
			//ЛБ_УправлениеЛомбардом.СохранитьСогласиеНаСМСРассылки(Док.ДатаОформленияАнкеты-1, Ссылка, РеквизитыАнкеты.РассылкаСМС);
		КонецЕсли;
		
		Док.ЗалогодательБенефициарныйВладелец = Истина;
		
		Док.ТипФизЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		//Док.ИсточникИнформации = Справочники.ЛБ_ИсточникиИнформации.НайтиПоРеквизиту("id_LX", СокрЛП(РеквизитыАнкеты.КодИсточникаИнформации));
		
		Информирование = СокрЛП(РеквизитыАнкеты.Информирование); 
		СтрокаИнфо = "";
		массив_Инфо = Новый Массив;
		Для инд = 1 по 11 Цикл     
			НольОдин = Сред(Информирование, инд, 1);
			Если СокрЛП(НольОдин) = "1" Тогда 
				знач_Инфо = Справочники.ЛБ_ИсточникиИнформации.НайтиПоРеквизиту("id_LX", СокрЛП(инд));
				СтрокаИнфо = СтрокаИнфо + знач_Инфо+ ";";				
			КонецЕсли;
		КонецЦикла;
		СтрокаИнфо = Лев(СтрокаИнфо, СтрДлина(СтрокаИнфо) - 1);
		Док.ИсточникИнформации = СтрокаИнфо;
		
		//1 - вывеска
		//2 -наружная реклама
		//3 реклама трансп
		//4 реклама лифты
		//5 листовка
		//6 интернет сай
		//7 соц сети
		//8 смс
		//9 колл центр
		//10 посоветовали знакомые
		//11 другое
		
		Док.ИсточникИнформацииДругое = СокрЛП(РеквизитыАнкеты.ДопИнформирование);
		Док.ХарактерОтношений = "Получение краткосрочного займа под залог ювелирных изделий на потребительские нужды";
		
		
		Док.ДокументыЗалогодателя.Очистить();
		
		
		//СсылкаСпр = НайтиДокументЗалогодателя(стрДокументы.КодЭликсДокумента,"0",ТекущаяДата(),Ссылка); 
		
		СсылкаСпр = НайтиДокументЗалогодателяПоРеквизитам(Ссылка,стрДокументы.ДокументНомер,стрДокументы.ВидДокументаЗалогодателя,стрДокументы.ВидДокумента);

		Если СсылкаСпр = Неопределено Тогда
			СпрОбъект = Справочники.ЛБ_ДокументыЗалогодателя.СоздатьЭлемент();
			СпрОбъект.Владелец 		= Ссылка;
			СпрОбъект.Гражданство 	= стрДокументы.Гражданство;
			СпрОбъект.ВидДокументаЗалогодателя = стрДокументы.ВидДокументаЗалогодателя;
			СпрОбъект.ВидДокумента 	= стрДокументы.ВидДокумента;  
			СпрОбъект.id_LX 		= стрДокументы.КодЭликсДокумента;
			СпрОбъект.Номер 		= стрДокументы.ДокументНомер;
			
			СпрОбъект.Наименование = ЛБ_ОбщийМодуль.СформироватьНаименованиеДокументаЗалогодателя(стрДокументы);
			СпрОбъект.НаименованиеПолное = ЛБ_ОбщийМодуль.СформироватьПолноеНаименованиеДокументаЗалогодателя(стрДокументы);
			СпрОбъект.Записать();
			СсылкаСпр = СпрОбъект.Ссылка; 
		Иначе
			ОбДокум = СсылкаСпр.ПолучитьОбъект(); 
			ОбДокум.Гражданство = стрДокументы.Гражданство;
			Если ОбДокум.Владелец <> Ссылка Тогда
				ОбДокум.Владелец = Ссылка;
			КонецЕсли;
			ОбДокум.Наименование = ЛБ_ОбщийМодуль.СформироватьНаименованиеДокументаЗалогодателя(стрДокументы);
			ОбДокум.НаименованиеПолное = ЛБ_ОбщийМодуль.СформироватьПолноеНаименованиеДокументаЗалогодателя(стрДокументы);
			ОбДокум.Записать();			
		КонецЕсли; 
		
		НоваяСтр = Док.ДокументыЗалогодателя.Добавить();
		НоваяСтр.ДокументЗалогодателя 		= СсылкаСпр;
