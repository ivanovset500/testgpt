	КонецЦикла;
КонецПроцедуры


Процедура ЗагрузитьВозвратИзъятого(НачДата, КонДата, Ломбард) Экспорт 
	
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	pndoc = "";
	Если Не ЗначениеЗаполнено(Ломбард) Тогда
		plat = "";
	Иначе
		plat = Ломбард;
	КонецЕсли; 
	
	db="'" + НачДата + "'";
	de="'" + КонДата + "'";
	
	
	ТекстЗапроса = "exec Z1CAxi_VozIz "+db+","+de+",'"+plat+"'";
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_LX", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Дата", 			Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("НомерЗБ", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Ломбард", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("СуммаТело", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаПроценты", 	Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Ответственный", 	Новый ОписаниеТипов("Строка"));  
	тз.Колонки.Добавить("Позиции", 			Новый ОписаниеТипов("Строка"));
	
	Пока не Выборка.eof() Цикл
		НовСтр = тз.Добавить();  
		НовСтр.Дата         	= Выборка.fields("ddoc").value;
		НовСтр.id_LX           	= СтрЗаменить(Выборка.fields("nrec").value, Символы.НПП, "");  
		НовСтр.НомерЗБ         	= Выборка.fields("nom").value; 
		НовСтр.СуммаТело		= ?(Выборка.fields("sm").value=NULL,0,Выборка.fields("sm").value);
		НовСтр.СуммаПроценты    = ?(Выборка.fields("smp").value=NULL,0,Выборка.fields("smp").value);		
		НовСтр.Ответственный  	= Выборка.fields("Ответственный сотрудник").value;
		НовСтр.Позиции        	= Выборка.fields("Позиции").value;    
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	
	Перечисление_Залог 			= Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог;
	Перечисление_Возврат        = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога;
	Организация 				= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
	
	тзДок = тз.Скопировать();
	
	ВидОперации = Перечисление_Возврат;
	Для каждого строкаДок из тзДок Цикл	
		НайдДок = ВернутьОперациюПоЗалогуПо_id(строкаДок.id_LX, ВидОперации);
		Если НайдДок = Неопределено Тогда
			ОПЗ = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент();
		Иначе
			ОПЗ = НайдДок.ПолучитьОбъект(); 
			ОПЗ.Товары.Очистить();  
			ОПЗ.Вставки.Очистить(); 
			ОПЗ.ТоварыИзъятыеВозвращенные.Очистить();
		КонецЕсли; 
		
		
		ОперацияВыдачи = ВернутьОперациюПоЗалогуПо_ЗБ(строкаДок.НомерЗБ);
		Если ОперацияВыдачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОПЗ, ОперацияВыдачи,,"Номер,Дата");
		ЗаполнитьЗначенияСвойств(ОПЗ, строкаДок);
		
		ОПЗ.id_LX 		= строкаДок.id_LX; 
		ОПЗ.Дата		= строкаДок.Дата;
		
		ОПЗ.ВыдачаЗалога = Ложь;
		ОПЗ.Выкуп        = Ложь;	
		ОПЗ.ДатаВыкупа	       = ОперацияВыдачи.ДатаВыкупа;
		ОПЗ.ДатаВыкупаЛьготная = ОперацияВыдачи.ДатаВыкупаЛьготная;  
		ОПЗ.Ломбард = ОперацияВыдачи.Ломбард;
		
		//Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
		//	НовСтрТовары = ОПЗ.ТоварыИзъятыеВозвращенные.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
		//КонецЦикла;  
		
		Если СтрНайти(строкаДок.Позиции, ",") > 0 Тогда
			МассивИзд = СтрРазделить(строкаДок.Позиции, ",");
			Для каждого элМасс из МассивИзд Цикл
