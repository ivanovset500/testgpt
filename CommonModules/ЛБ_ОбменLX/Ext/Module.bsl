Функция ВернутьДанныеАнкетыВсехКлиентов() Экспорт

	АдоСоединение = АдоНовоеСоединение("dCBDL");
	                           	
	ТекстЗапроса = "
	|SELECT KodClient 
	|,kodRekl КодИсточникаИнформации
	|,AnkFin ФинансовоеПоложение
	|,KodVid КатегорияФизЛица
	|,StRisk УровеньРиска
	|,Anksnils Снилс   
	|,Prim Примечание
	|,DopRekl ДопИнформирование 
	|,INN Информирование
	|,DAnket ДатаОформленияАнкеты
	|,AnkRep ДеловаяРепутация
	|,AnkIstD ИсточникПроисхожденияДенежныхСредств
	|,AnkIstM ИсточникПроисхожденияИмущества
	|,xSMS РассылкаСМС
	|FROM [dCBDL].[dbo].[aClient]";
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса) ; 
	
	тз = новый ТаблицаЗначений;
	тз.Колонки.Добавить("КодКлиента");  
	тз.Колонки.Добавить("ИсточникПроисхожденияДенежныхСредств");
	тз.Колонки.Добавить("ИсточникПроисхожденияИмущества");
	тз.Колонки.Добавить("ДеловаяРепутация");
	тз.Колонки.Добавить("Снилс"); 
	тз.Колонки.Добавить("КатегорияФизЛица");  
	тз.Колонки.Добавить("УровеньРиска");
	тз.Колонки.Добавить("ДатаОформленияАнкеты");
	тз.Колонки.Добавить("КодИсточникаИнформации");
	тз.Колонки.Добавить("ФинансовоеПоложение");
	тз.Колонки.Добавить("Примечание");  
	тз.Колонки.Добавить("Информирование");
	тз.Колонки.Добавить("ДопИнформирование");
	тз.Колонки.Добавить("РассылкаСМС");   
	тз.Индексы.Добавить("КодКлиента"); 
	
	Пока не Выборка.eof() Цикл   
