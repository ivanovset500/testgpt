Функция СделатьАпдейт(Идентификатор)
	
	текДата = ТекущаяДата();
	
	ТекстSQL  = "UPDATE ReportTransfer1c SET DateTransfer = '" + текДата + "' WHERE NRecDoc = '" + Идентификатор + "'";	
	
	АдоСоединение = АдоНовоеСоединение("dCBDL");	
	
	rs = АдоВыполнитьЗапрос(АдоСоединение, ТекстSQL);
	
	
	Возврат Истина;
КонецФункции



Функция ВернутьВставкуМеталла(КодВставки)
	
	
