				ПозСлэш = СтрНайти(промАрт,"/");  		
				Артикул = Сред(промАрт, ПозСлэш+1);
				
				НовСтрТовары = ОПЗ.ТоварыИзъятыеВозвращенные.Добавить();
				ОбъектЗалога = Справочники.ЛБ_ОбъектыЗалога.НайтиПоРеквизиту("id_LX", Артикул);
				
				НовСтрТовары.ОбъектЗалога = ОбъектЗалога;
				НовСтрТовары.СуммаОценки = ВернутьСуммуОценкиОбъектаЗалога(ОбъектЗалога, ОПЗ.Дата);
				
			КонецЦикла;		
		Иначе  
			промАрт = СокрЛП(строкаДок.Позиции);
			ПозСлэш = СтрНайти(промАрт,"/");  		
			Артикул = Сред(промАрт, ПозСлэш+1); 
			
			НовСтрТовары = ОПЗ.ТоварыИзъятыеВозвращенные.Добавить();
			ОбъектЗалога = Справочники.ЛБ_ОбъектыЗалога.НайтиПоРеквизиту("id_LX", Артикул); 
			НовСтрТовары.ОбъектЗалога = ОбъектЗалога;
			НовСтрТовары.СуммаОценки = ВернутьСуммуОценкиОбъектаЗалога(ОбъектЗалога, ОПЗ.Дата);
			
		КонецЕсли;		
		
		
		ОПЗ.ВидОперации = Перечисление_Возврат;
		ОПЗ.НомерЗалоговогоБилета = строкаДок.НомерЗБ; 
		//Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
		//	НовСтрТовары = ОПЗ.Товары.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
		//КонецЦикла;
		//Для каждого строчВставки из ОперацияВыдачи.Вставки Цикл
		//	НовСтрВставки = ОПЗ.Вставки.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрВставки, строчВставки);
		//КонецЦикла;  
		
		//ОПЗ.ДатаИзъятия = ОПЗ.Дата;
		//ОПЗ.ДатаПротоколИзъятия = ОПЗ.Дата; 
		
		
		//ОПЗ.Ответственный = ВернутьСоздатьПользователя(СтрокаДок.Ответственный);
		
		ОПЗ.СуммаОплатыПроценты = СтрокаДок.СуммаПроценты;
		ОПЗ.СуммаОплатыСсуда    = СтрокаДок.СуммаТело;
		ОПЗ.СуммаОплаты         = СтрокаДок.СуммаТело + СтрокаДок.СуммаПроценты;
		ОПЗ.ПредыдущаяОперация  = НайтиПредыдущуюОперацию(ОПЗ.НомерЗалоговогоБилета);	
		ОПЗ.Записать(РежимЗаписиДокумента.Запись);
		ОПЗ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры


Функция ВернутьСуммуОценкиОбъектаЗалога(ОбъектЗалога, НаДату) 
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки
	|ИЗ
	|	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&НаДату, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних";
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	Запрос.УстановитьПараметр("НаДату", НаДату);        
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОценки;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

Функция РазобратьАртикулНаЧасти(Артикул) 
	Артикул = СокрЛП(Артикул);
	Рез = Новый Структура("Ломбард, ЗБ, НомерВБилете", "", "", "");
	
	
	ПозСлэша 	= СтрНайти(Артикул,"/");
	ПозТире 	= СтрНайти(Артикул,"-");
	
	Рез.Вставить("Ломбард", Лев(Артикул, ПозСлэша));  	
	Рез.Вставить("ЗБ",      Сред(Артикул, ПозСлэша+1, ПозТире-ПозСлэша));  	
	Рез.Вставить("НомерВБилете", Сред(Артикул, ПозТире+1));
	
	Возврат рез;
КонецФункции


Функция ВернутьТЗРасчетыПоОбъектамЗалога(ЗалоговыйБилет)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.Остатки(&НаДату, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстатки";
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	
	тз = Запрос.Выполнить().Выгрузить();
	
	Возврат тз;	
	
КонецФункции




Процедура ЗаполнитьТовары(ЗалоговыйБилет, ДатаДок, Товары, СуммаТела) 
	Запрос = новый Запрос;   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет.Ссылка); 
	//Если ЗначениеЗаполнено(ДокументОплаты) И ДокументОплаты.Проведен Тогда 
	ДатаПроверки = ДатаДок-1; 
	//Иначе	
	//    ДатаПроверки = ДатаДок;
	//КонецЕсли;	   
	Запрос.УстановитьПараметр("Дата", ДатаПроверки);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
	|	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаРасход) КАК СуммаОплаты
	|ИЗ
	|	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.Обороты(, &Дата, , ) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты
	|ГДЕ
	|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ЗалоговыйБилет = &ЗалоговыйБилет
	|
	|СГРУППИРОВАТЬ ПО
	|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	|	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	|	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
	|	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить(); 
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("ОбъектЗалога");
	ТаблицаТоваров.Колонки.Добавить("НомерСТроки");
	ТаблицаТоваров.Колонки.Добавить("СуммаОценки", Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("СуммаОплатыНач", Новый ОписаниеТипов("Число"));  
	ТаблицаТоваров.Колонки.Добавить("СуммаОплаты", Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("ЗадолженностьНач", Новый ОписаниеТипов("Число")); 
	ТаблицаТоваров.Колонки.Добавить("ЗадолженностьКон", Новый ОписаниеТипов("Число"));
	
	Для каждого стр Из ЗалоговыйБилет.Товары цикл 
		НоваяСтр = ТаблицаТоваров.Добавить(); 
		НоваяСтр.Номерстроки = Стр.Номерстроки;
		НоваяСтр.ОбъектЗалога = стр.ОбъектЗалога;
		НоваяСтр.СуммаОценки = стр.СуммаСсуды;  
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", НоваяСтр.ОбъектЗалога);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ строки.Количество() = 0 тогда			
			НоваяСтр.СуммаОплатыНач = Строки.Получить(0).СуммаОплаты;                                 
		КонецЕсли;	 
		//Если ЗначениеЗаполнено(ДокументОплаты) Тогда
		//	Строки = ДокументОплаты.Товары.НайтиСтроки(Отбор);
		//	Если НЕ строки.Количество() = 0 тогда			
		//		НоваяСтр.СуммаОплаты = Строки.Получить(0).СуммаОплаты;
		//	КонецЕсли;	 
		//КонецЕсли;	   
		//Если Выкуп Тогда
		//	ЗаполнитьТоварыПослеВыкупа(Ложь); 
		//КонецЕсли;
		НоваяСтр.ЗадолженностьНач = НоваяСтр.СуммаОценки - НоваяСтр.СуммаОплатыНач; 
		НоваяСтр.ЗадолженностьКон = НоваяСтр.ЗадолженностьНач - НоваяСтр.СуммаОплаты;
	Конеццикла;	
	
	ТоварыИтогОценка = ТаблицаТоваров.Итог("СуммаОценки");
	ТоварыИтогОплатаНач = ТаблицаТоваров.Итог("СуммаОплатыНач");
	ТоварыИтогДолгНач = ТаблицаТоваров.Итог("ЗадолженностьНач");
	ТоварыИтогОплатаКон = ТаблицаТоваров.Итог("СуммаОплаты");
	ТоварыИтогДолгКон = ТаблицаТоваров.Итог("Задолженностькон");
	
	
	//Если Выкуп Тогда 
	//	Для каждого Стр Из ТаблицаТоваров Цикл 
	//		Стр.СуммаОплаты = Стр.ЗадолженностьНач;  
	//		Стр.ЗадолженностьКон = 0;
	//	КонецЦикла;	
	//Иначе	
	СуммаДляРаспределения = СуммаТела;
	Если СуммаДляРаспределения = 0 Тогда
		Для каждого Стр Из ТаблицаТоваров Цикл
			Стр.СуммаОплаты = 0;   
			Стр.ЗадолженностьКон = Стр.ЗадолженностьНач - Стр.СуммаОплаты;
		Конеццикла;	
	Иначе	
		НомСтрМакс = 0; 
		МаксЗадолженность = 0;
		ЗадолженностьНачИтог = ТаблицаТоваров.Итог("ЗадолженностьНач");
		Для каждого Стр Из ТаблицаТоваров Цикл 
			Коэфф = Стр.ЗадолженностьНач/ЗадолженностьНачИтог;
			Стр.СуммаОплаты = СуммаТела*Коэфф;
			Стр.ЗадолженностьКон = Стр.ЗадолженностьНач - Стр.СуммаОплаты;
			СуммаДляРаспределения = СуммаДляРаспределения - Стр.СуммаОплаты;
			Если Стр.ЗадолженностьНач > МаксЗадолженность Тогда
				МаксЗадолженность = Стр.ЗадолженностьНач;  
				НомСтрМакс = стр.НомерСтроки-1;
			КонецЕсли;	
		КонецЦикла;
		Если НЕ СуммаДляРаспределения = 0 Тогда
			Стр = ТаблицаТоваров.Получить(НомСтрМакс);
			Стр.СуммаОплаты = Стр.СуммаОплаты + СуммаДляРаспределения;
			Стр.ЗадолженностьКон = Стр.ЗадолженностьНач - Стр.СуммаОплаты;
		КонецЕсли;  
	КонецЕсли;	
	//КонецЕсли;	
	
	ТоварыИтогОплатаКон = ТаблицаТоваров.Итог("СуммаОплаты");
	ТоварыИтогДолгКон = ТаблицаТоваров.Итог("ЗадолженностьКон");
	
	Для каждого строч из ТаблицаТоваров Цикл
		НайдСТр = ЗалоговыйБилет.Товары.Найти(строч.ОбъектЗалога,"ОбъектЗалога");
		НайдСТр.СуммаОплаты = строч.СуммаОплаты;
		
	КонецЦикла;	
КонецПроцедуры	


