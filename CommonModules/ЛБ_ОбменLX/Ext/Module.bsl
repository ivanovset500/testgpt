Процедура РассчитатьПредельныСрокЗайма(Док)
	док.ПредельныйСрокЗаймаДни = ЛБ_УправлениеЛомбардом.ПолучитьПредельныйСрокЗайма(Док.Дата, Док.СхемаКредитования);
	Если НЕ Док.ПредельныйСрокЗаймаДни = 0 Тогда  
		док.ПредельныйСрокЗайма = НачалоДня(Док.Дата) + Док.ПредельныйСрокЗаймаДни*24*60*60;
	Иначе  
		Док.ПредельныйСрокЗайма = Дата(1,1,1);
	КонецЕсли;	
КонецПроцедуры

