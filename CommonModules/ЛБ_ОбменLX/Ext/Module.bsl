		НайдДок = ВернутьОперациюПоЗалогуПо_id(строкаДок.id_LX, ВидОперации);
		Если НайдДок = Неопределено Тогда
			ОПЗ = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент();
		Иначе
			ОПЗ = НайдДок.ПолучитьОбъект(); 
			ОПЗ.Товары.Очистить();  
			ОПЗ.Вставки.Очистить();
			ОПЗ.ТоварыИзъятыеВозвращенные.Очистить();
		КонецЕсли; 
		
		
		ОперацияВыдачи = ВернутьОперациюПоЗалогуПо_ЗБ(строкаДок.НомерЗБ);
		Если ОперацияВыдачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОПЗ, ОперацияВыдачи,,"Номер,Дата");
		ЗаполнитьЗначенияСвойств(ОПЗ, строкаДок);
		
		ОПЗ.id_LX 		= строкаДок.id_LX; 
		ОПЗ.Дата		= строкаДок.Дата;
		
		ОПЗ.ВыдачаЗалога = Ложь;
		ОПЗ.Выкуп        = Ложь;	
		ОПЗ.ДатаВыкупа	       = ОперацияВыдачи.ДатаВыкупа;
		ОПЗ.ДатаВыкупаЛьготная = ОперацияВыдачи.ДатаВыкупаЛьготная;  
		ОПЗ.Ломбард = ОперацияВыдачи.Ломбард;
		
		//Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
		//	НовСтрТовары = ОПЗ.ТоварыИзъятыеВозвращенные.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
		//КонецЦикла;  
		
		Если СтрНайти(строкаДок.ИзъятыеПозиции, ",") > 0 Тогда
			МассивИзд = СтрРазделить(строкаДок.ИзъятыеПозиции, ",");
			Для каждого элМасс из МассивИзд Цикл
				промАрт = СокрЛП(элМасс);
				ПозСлэш = СтрНайти(промАрт,"/");  		
				Артикул = Сред(промАрт, ПозСлэш+1);
				
				НовСтрТовары = ОПЗ.ТоварыИзъятыеВозвращенные.Добавить();
				ОбъектЗалога = Справочники.ЛБ_ОбъектыЗалога.НайтиПоРеквизиту("id_LX", Артикул);
				
				НовСтрТовары.ОбъектЗалога = ОбъектЗалога;
				НовСтрТовары.СуммаОценки = ВернутьСуммуОценкиОбъектаЗалога(ОбъектЗалога, ОПЗ.Дата);
				
			КонецЦикла;		
		Иначе  
			промАрт = СокрЛП(строкаДок.ИзъятыеПозиции);
			ПозСлэш = СтрНайти(промАрт,"/");  		
			Артикул = Сред(промАрт, ПозСлэш+1); 
			
			НовСтрТовары = ОПЗ.ТоварыИзъятыеВозвращенные.Добавить();
			ОбъектЗалога = Справочники.ЛБ_ОбъектыЗалога.НайтиПоРеквизиту("id_LX", Артикул); 
			НовСтрТовары.ОбъектЗалога = ОбъектЗалога;
			НовСтрТовары.СуммаОценки = ВернутьСуммуОценкиОбъектаЗалога(ОбъектЗалога, ОПЗ.Дата);
			
		КонецЕсли;		
		
		
		ОПЗ.ВидОперации = Перечисление_Изъятие;
		ОПЗ.НомерЗалоговогоБилета = строкаДок.НомерЗБ; 
		//Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
		//	НовСтрТовары = ОПЗ.Товары.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
		//КонецЦикла;
		//Для каждого строчВставки из ОперацияВыдачи.Вставки Цикл
		//	НовСтрВставки = ОПЗ.Вставки.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрВставки, строчВставки);
		//КонецЦикла;  
		
		ОПЗ.ДатаИзъятия = ОПЗ.Дата;
		//ОПЗ.ДатаПротоколИзъятия = ОПЗ.Дата; 
		
		
		//ОПЗ.Ответственный = ВернутьСоздатьПользователя(СтрокаДок.Ответственный);
		
		ОПЗ.СуммаОплатыПроценты = СтрокаДок.СуммаПроценты;
		ОПЗ.СуммаОплатыСсуда    = СтрокаДок.СуммаТело;
		ОПЗ.СуммаОплаты         = СтрокаДок.СуммаТело + СтрокаДок.СуммаПроценты;
