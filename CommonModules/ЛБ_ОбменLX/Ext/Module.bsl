Функция ВернутьСтатусКлиентаПоКодуLX(КодLX)
	//-2	Сверхновый
	//-1	Нов/Пост
	//0		Новый
	//1		Чёрный
	//2		Недобросовестный
	//3		Не выкупающий
	//4		Добросовестный
	//5		Постоянный
	//6		Исключен
	//7		Неопределенный
	//8		Специальный
	//9		ВИП
	//10	Сотрудник
	//11	Льготный
	//12	Тёмный
	//13	Замороженный
	//14	Отказ в обслуживании
	//15	Размороженный
	//16	Перечень ФРОМУ
	//17	Запретный
	//18	Мобилизованный
	//19	Перечень СБ ООН
	//22	Нелояльный
	//200	умер
	Если КодLX = 0 Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Новый"); 
	ИначеЕсли КодLX = 3 Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_НеВыкупающий");
	ИначеЕсли КодLX = 4 Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Добросовестный");	
	ИначеЕсли КодLX = 5 Тогда	
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Постоянный");
	ИначеЕсли КодLX = 7 Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Неопределенный");
	ИначеЕсли КодLX = 9 Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_VIP");
	ИначеЕсли КодLX = 10 Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Сотрудник");
	КонецЕсли;
	
	Возврат ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтатусКлиента_Сверхновый");
	
КонецФункции

