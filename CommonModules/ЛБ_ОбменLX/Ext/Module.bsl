Процедура ИнициализироватьСправочникВидыИзделий() Экспорт
	
	АдоСоединение = АдоНовоеСоединение("ddmt_dan") ;
	
	ТекстЗапроса = "
	|	SELECT
	|		NameTov	    
	|   FROM [ddmt_dan].[dbo].[spKlassE]
	|   where [TpGr] = 'T' and xKod = 1 ";
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса) ;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	
	ном = 0;
	Пока не Выборка.eof() Цикл 
		ном = ном + 1;
		
		СтрокаТЗ = ТЗ.Добавить();			
		СтрокаТЗ.Наименование = Выборка.fields("NameTov").value;  	
		
		Выборка.movenext();
	КонецЦикла; 
	
	АдоСоединение.Close() ;
	
	тз.Свернуть("Наименование"); 
	
	спрВидыИзделий = Справочники.ЛБ_ВидыИзделий;
	Для каждого стр из тз Цикл
		Если спрВидыИзделий.НайтиПоНаименованию(стр.Наименование,Истина) = спрВидыИзделий.ПустаяСсылка() Тогда
			НовЭлемент = спрВидыИзделий.СоздатьЭлемент();
			НовЭлемент.Наименование = стр.Наименование;
			НовЭлемент.Записать();
		КонецЕсли;		
	КонецЦикла; 	
КонецПроцедуры


Процедура СоздатьВидДокументаФизЛица(наименование, КодМВД)
	СпрВид = Справочники.ВидыДокументовФизическихЛиц;
	
	Если СпрВид.НайтиПоНаименованию(наименование) = СпрВид.ПустаяСсылка() Тогда
		Об = Справочники.ВидыДокументовФизическихЛиц.СоздатьЭлемент();
		Об.Наименование = наименование;
		Об.КодМВД       = КодМВД;
		Об.Записать();
	КонецЕсли;
КонецПроцедуры

Функция ВернутьВидДокументаФизлицаПоКодуLX(КодLX)
	КодLX = СокрЛП(КодLX);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СоответствиеВидовДокументовФизлиц.ВидДокумента КАК ВидДокумента
	|ИЗ
	|	РегистрСведений.ЛБ_СоответствиеВидовДокументовФизлиц КАК ЛБ_СоответствиеВидовДокументовФизлиц
	|ГДЕ
	|	ЛБ_СоответствиеВидовДокументовФизлиц.КодLX = &КодLX";
	Запрос.УстановитьПараметр("КодLX", КодLX);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВидДокумента;
	КонецЕсли;
	
	Возврат Неопределено;	
КонецФункции

Функция СоздатьЗаписьСоответствияВидовДокументовФизЛиц(КодLX, ВидДокумента)
	
	НовыйНаборЗаписей = РегистрыСведений.ЛБ_СоответствиеВидовДокументовФизлиц.СоздатьНаборЗаписей();
	НовыйНаборЗаписей.Отбор.КодLX.Установить(КодLX);
	НоваяЗаписьНабора = НовыйНаборЗаписей.Добавить();
	НоваяЗаписьНабора.КодLX = КодLX;
	НоваяЗаписьНабора.ВидДокумента = ВидДокумента; 
	НовыйНаборЗаписей.Записать();
	
КонецФункции

