		НовСтр.id_LX = стр.id_LX;
		НовСтр.ДатаИзменения1С = стр.ДатаИзменения - Дата(1970,1,1);
	КонецЦикла;
	
	тз.Свернуть("id_LX", "ДатаИзменения,ДатаИзменения1С");

	Для Индекс = -ТЗ.Количество()+1 По 0 Цикл
		стр = ТЗ[-Индекс]; 
    	Если стр.ДатаИзменения = стр.ДатаИзменения1С Тогда
        	ТЗ.Удалить(-Индекс);
    	КонецЕсли;
	КонецЦикла;

	
	Ном = 0;
	Для каждого стр из тз Цикл 		
		ном = ном + 1;  
		
		Грузим = Истина;  
		
		//отб = Новый Структура();
		//отб.Вставить("id_LX", стр.id_LX); 
