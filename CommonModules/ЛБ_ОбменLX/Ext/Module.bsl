	Возврат ном;
	
КонецФункции


Процедура ЗагрузитьЗалогодателя(тз, тзСтран, тзПервыхДатЗБ, тзЧерныеСтатусыКлиентов) Экспорт
	Залогодатель = Неопределено;
	Если тз.Количество() > 0 Тогда
		
		id_lx = тз[0].nrecblacklist;
		id_lx = СтрЗаменить(id_lx, Символы.НПП, "");
 
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_Залогодатели.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
		|ГДЕ
		|	ЛБ_Залогодатели.id_lx = &id_lx";
		Запрос.УстановитьПараметр("id_lx", id_lx);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Залогодатель = Выборка.Ссылка;			
		Иначе
			Об = Справочники.ЛБ_Залогодатели.СоздатьЭлемент();
			Об.Наименование = тз[0].fiof;
			Об.ДатаРождения = тз[0].datar;
			Об.id_lx        = id_lx;
			Об.Фамилия      = тз[0].fam;
			Об.Имя      	= тз[0].name;
			Об.Отчество     = тз[0].patr;
			Об.Записать();
			
			Залогодатель = Об.Ссылка; 		
		КонецЕсли;
	КонецЕсли;
	
	НеГрузитьАдреса = Ложь;
	ПерезаписыватьКлиентов = Истина;
	
	АдоСоединение = АдоНовоеСоединение("dcbdl_uni");

	
	Если Залогодатель <> Неопределено Тогда
		Для каждого стр из тз Цикл 
			
		kodclient = СтрЗаменить(стр.kodclient, Символы.НПП, "");
	
			
		РеквизитыКлиента = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, "Kodclient = '" + kodclient + "'", НеГрузитьАдреса);
			
			Если РеквизитыКлиента <> Неопределено Тогда
				Если ЗначениеЗаполнено(РеквизитыКлиента[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыКлиента[0].Фамилия) или ЗначениеЗаполнено(РеквизитыКлиента[0].Имя) или ЗначениеЗаполнено(РеквизитыКлиента[0].Отчество)) Тогда 
					Парамс = Новый Структура;
					Парамс.Вставить("Данные", 			РеквизитыКлиента[0]); 
					Парамс.Вставить("тзСтран", 			тзСтран);
					Парамс.Вставить("АдоСоединение", 	АдоСоединение);
					Парамс.Вставить("СтатусКлиента", 	"");
					Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
					Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
					Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ); 
					Парамс.Вставить("ПерезаписыватьКлиентов", 	ПерезаписыватьКлиентов); 
					Парамс.Вставить("Залогодатель", Залогодатель); 
					
					Клиент 	= НайтиСоздатьЗалогодателя(Парамс);
					
				КонецЕсли; 
			КонецЕсли;
			
		КонецЦикла;
		
		
		
		
	КонецЕсли;		
КонецПроцедуры



Процедура ЗагрузитьКодыФизлиц() Экспорт
	
	ТекстЗапроса = "select * from dCBDL_dan.dbo.bUser"; 
	              
	
	АдоСоединение = АдоНовоеСоединение("dCBDL_dan");

	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса); 
	Пока не Выборка.eof() Цикл 
		фам = Выборка.fields("Fam").value;
		имя = Выборка.fields("Name").value;
		отч = Выборка.fields("Patr").value;

		фио = СокрЛП(Фам)+" "+СокрЛП(имя) + " "+СокрЛП(отч); 
		
		id_LX = СтрЗаменить(Выборка.fields("kodUser").value,Символы.НПП, "");

		
		Спр = Справочники.ФизическиеЛица.НайтиПоНаименованию(ФИО,Истина);
		Если спр <> Справочники.ФизическиеЛица.ПустаяСсылка() Тогда 
			
			НаборЗаписей = РегистрыСведений.ЛБ_СоответствиеФизлица_idLX.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.ФизическоеЛицо.Установить(спр); 
			НаборЗаписей.Отбор.idLX.Установить(id_LX); 
			
			НоваяЗапись = НаборЗаписей.Добавить(); 
			НоваяЗапись.ФизическоеЛицо = спр; 
			НоваяЗапись.idLX = id_LX; 

			НаборЗаписей.Записать();   
			
			
			
		КонецЕсли;
		
		
		Выборка.movenext(); 	
	КонецЦикла; 
	
	
КонецПроцедуры

//+МАН 06.11.25 Выгрузка клиентов в Эликс
#Область ОбластьВыгрузки

Процедура ВыгрузитьКлиентов(Залогодатель, ПроверятьДокументы) Экспорт
	Если Залогодатель <> Неопределено Тогда
		СобратьДанныеИВыгрузить(Залогодатель, ПроверятьДокументы);
	КонецЕсли;
КонецПроцедуры

Процедура СобратьДанныеИВыгрузить(Залогодатель, ПроверятьДокументы)

	ТЗКлиента = ИнформацияОклиенте(Залогодатель);

	//Нужно определиться как будет работать выгрузка
	//Если создание карточки, то такой вариант может прокатить, а если операция по займу, то нет.
	//Какой ломбард указывать если карточка или ДУЛ созданы в ЦО???
	Если ТЗКлиента[0].DIzm >= НачалоДня(ТекущаяДата()) Тогда
		Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
	Иначе
		Ломбард = ТЗКлиента[0].ОтветственныйЛомбард;
	КонецЕсли;
	//
	
	Если Ломбард.id_LX = "" Тогда
		Сообщить("В карточке ломбарда " + """" + ТЗКлиента[0].ОтветственныйЛомбард.Наименование + """" + " не указан его код в Эликсе");
		Возврат;
	КонецЕсли;
	
	KodBlack = ОпределитьKodBlack(Залогодатель);
	КодКлиента = ПолучитьСформироватьКодКлиента(Залогодатель, Ломбард);
	
	Если КодКлиента = 0 Тогда
		Сообщить("В таблице соответствий не введен код клиента в ломбарде.");
		Возврат;
	КонецЕсли;
	
	Информирование = СформироватьПолеИнформирования(ТЗКлиента[0].ИсточникИнформации, ТЗКлиента[0].ИсточникИнформацииДругое);
	
	СсылкаНаЗапись = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClient.НайтиПоПолю("KodClient", КодКлиента);
	
	Если ЗначениеЗаполнено(СсылкаНаЗапись) Тогда
		//Убрал на время тестирования
		//И ТЗКлиента[0].DIzm >= НачалоДня(ТекущаяДата()) Тогда
		//
		
		ОбъектЗаписи = СсылкаНаЗапись.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(ОбъектЗаписи, ТЗКлиента[0]);
		ОбъектЗаписи.KodBlack = KodBlack;
		ОбъектЗаписи.KodClient = КодКлиента;
		ОбъектЗаписи.Data1C = NULL;
		ОбъектЗаписи.INN = Информирование;
		
		Если ОбъектЗаписи.DMort <> NULL Тогда
			СтруктураДанныхСмерти = ПолучитьДанныеСмерти(Залогодатель);
			
			ОбъектЗаписи.IPRegDoc = СтруктураДанныхСмерти.ДатаВыдачи;
			ОбъектЗаписи.IPRegOrgan = СтруктураДанныхСмерти.Номер;
		КонецЕсли;
		
		ОбъектЗаписи.Записать();
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СсылкаНаЗапись) Тогда
		
		НоваяСтр = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClient.СоздатьОбъект();
		ЗаполнитьЗначенияСвойств(НоваяСтр, ТЗКлиента[0]);
		НоваяСтр.KodBlack = KodBlack;
		НоваяСтр.KodClient = КодКлиента;
		НоваяСтр.Data1C = NULL;
		НоваяСтр.INN = Информирование;
		
		Если НоваяСтр.DMort <> NULL Тогда
			СтруктураДанныхСмерти = ПолучитьДанныеСмерти(Залогодатель);
			
			НоваяСтр.IPRegDoc = СтруктураДанныхСмерти.ДатаВыдачи;
			НоваяСтр.IPRegOrgan = СтруктураДанныхСмерти.Номер;
		КонецЕсли;
		
		НоваяСтр.Записать();
		
	КонецЕсли;
	
	ВыгрузитьДокументыЗалогодателя(Залогодатель, Ломбард, КодКлиента, ПроверятьДокументы);
	
	ТекстЗапроса = "exec [Transit1C].[dbo].[Transit1C_aClient]";
	ЗагрузитьИзТранзитнойБазыВЭликс("Transit1C", ТекстЗапроса);

	ТекстЗапроса = "exec [Transit1C].[dbo].[Transit1C_aClientDoc]";
	ЗагрузитьИзТранзитнойБазыВЭликс("Transit1C", ТекстЗапроса);
	
	Сообщить("Выгрузка завершена");
КонецПроцедуры

Процедура ВыгрузитьДокументыЗалогодателя(Залогодатель, Ломбард, КодКлиента, ПроверятьДокументы)
	ТЗДокКлиентаДоСегодня = ПолучитьДокументыКлиента(Залогодатель, НачалоДня(ТекущаяДата()) - 1, Истина);
	ТЗДокКлиентаОтСегодня = ПолучитьДокументыКлиента(Залогодатель, НачалоДня(ТекущаяДата()), Ложь);
	
	Если ТЗДокКлиентаДоСегодня <> Неопределено И ТЗДокКлиентаДоСегодня.Количество() > 0 Тогда
		Для каждого СтрТЗДокДо Из ТЗДокКлиентаДоСегодня Цикл
			//Как быть с выгрузкой ДУЛ которые были созданы в ломбарде на Эликсе и изменены в другом ломбарде на 1С.
			
			КодДокументаКлиента = 0;
			СсылкаНаЗаписьДокумента = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClientDoc.ПустаяСсылка();
			
			Если ЗначениеЗаполнено(СтрТЗДокДо.NRecClientDoc) Тогда
				
				КодДокументаКлиента = СтрТЗДокДо.NRecClientDoc;
				
				СсылкаНаЗаписьДокумента = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClientDoc.НайтиПоПолю("NRecClientDoc", СтрТЗДокДо.NRecClientDoc);
				
				Если ЗначениеЗаполнено(СсылкаНаЗаписьДокумента) И ПроверятьДокументы Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				КодДокументаКлиента = ПолучитьСформироватьКодДокументаКлиента(Залогодатель, Ломбард, СтрТЗДокДо.СсылкаДок);
			КонецЕсли;

			Если КодДокументаКлиента = 0 Тогда
				Сообщить("В таблице соответствий не введен код документа клиента в ломбарде.");
				Возврат;
			КонецЕсли;

			ЗаполненаяСтрока = ЗаполнитьСтрокуТЗ(Залогодатель, Ломбард, КодКлиента, КодДокументаКлиента, СтрТЗДокДо);
			
			Если ЗаполненаяСтрока.Kod1C = Null Тогда
				Сообщить("В таблице соответствий видов документов не указан код LX у вида документа " + """" + ЗаполненаяСтрока.ВидДокумента.Наименование + """");
				Возврат;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СсылкаНаЗаписьДокумента) И НЕ ПроверятьДокументы Тогда
				ОбъектЗаписиДок = СсылкаНаЗаписьДокумента.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(ОбъектЗаписиДок, ЗаполненаяСтрока);
				ОбъектЗаписиДок.Data1C = NULL;
				ОбъектЗаписиДок.Записать();
			Иначе
				НоваяСтр = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClientDoc.СоздатьОбъект();
				ЗаполнитьЗначенияСвойств(НоваяСтр, ЗаполненаяСтрока);
				
				Если ПроверятьДокументы Тогда
					НоваяСтр.Data1C = ТекущаяДата();
				Иначе
					НоваяСтр.Data1C = NULL;
				КонецЕсли;
				
				НоваяСтр.Записать();
			КонецЕсли;
		КонецЦикла;
	//Иначе    
	//	Сообщить("Не найдены первые ДУЛ клиента. Они не будут проверены и выгружены.");
	КонецЕсли;
	
	Если ТЗДокКлиентаОтСегодня <> Неопределено И ТЗДокКлиентаОтСегодня.Количество() > 0 Тогда
		Для каждого СтрТЗДокОт Из ТЗДокКлиентаОтСегодня Цикл
			
			КодДокументаКлиента = 0;
			СсылкаНаЗаписьДокумента = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClientDoc.ПустаяСсылка();
	
			Если ЗначениеЗаполнено(СтрТЗДокОт.NRecClientDoc) Тогда
				КодДокументаКлиента = СтрТЗДокОт.NRecClientDoc;
				СсылкаНаЗаписьДокумента = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClientDoc.НайтиПоПолю("NRecClientDoc", СтрТЗДокОт.NRecClientDoc);
			Иначе
				КодДокументаКлиента = ПолучитьСформироватьКодДокументаКлиента(Залогодатель, Ломбард, СтрТЗДокОт.СсылкаДок);
			КонецЕсли;
			
			Если КодДокументаКлиента = 0 Тогда
				Сообщить("В таблице соответствий не введен код документа клиента в ломбарде.");
				Возврат;
			КонецЕсли;
			
			ЗаполненаяСтрока = ЗаполнитьСтрокуТЗ(Залогодатель, Ломбард, КодКлиента, КодДокументаКлиента, СтрТЗДокОт);
			
			Если ЗаполненаяСтрока.Kod1C = Null Тогда
				Сообщить("В таблице соответствий видов документов не указан код LX у вида документа " + """" + ЗаполненаяСтрока.ВидДокумента.Наименование + """");
				Возврат;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СсылкаНаЗаписьДокумента) Тогда
				ОбъектЗаписиДок = СсылкаНаЗаписьДокумента.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(ОбъектЗаписиДок, ЗаполненаяСтрока);
				ОбъектЗаписиДок.Data1C = NULL;
				ОбъектЗаписиДок.Записать();
			Иначе
				НоваяСтр = ВнешниеИсточникиДанных.Transit1C.Таблицы.dbo_aClientDoc.СоздатьОбъект();
				ЗаполнитьЗначенияСвойств(НоваяСтр, ЗаполненаяСтрока);
				НоваяСтр.Data1C = NULL;
				НоваяСтр.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ИнформацияОклиенте(Залогодатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК Adres,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК AdresFact,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдрес КАК AdresPost,
		|	ВЫБОР
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ФинансовоеПоложениеСтабильное
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК AnkFin,
		|	ВЫБОР
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредствИной = """"
		|			ТОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредств.Наименование
		|		ИНАЧЕ ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредствИной
		|	КОНЕЦ КАК AnkIstD,
		|	ВЫБОР
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмуществаИной = """"
		|			ТОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмущества.Наименование
		|		ИНАЧЕ ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмуществаИной
		|	КОНЕЦ КАК AnkIstM,
		|	ЛБ_АнкетаЗалогодателяСрезПоследних.ДеловаяРепутацияПоложительная КАК AnkRep,
		|	СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(ЛБ_АнкетаЗалогодателяСрезПоследних.СНИЛС, ""-"", """"), "" "", """") КАК AnkSNILS,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК BirthPlace,
		|	ЛБ_АнкетаЗалогодателяСрезПоследних.Период КАК DAnket,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК DataR,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Период КАК DEDOCL,
		|	ВЫБОР
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Период > ЛБ_АнкетаЗалогодателяСрезПоследних.Период
		|			ТОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Период
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Период < ЛБ_АнкетаЗалогодателяСрезПоследних.Период
		|			ТОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.Период
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Период = ЛБ_АнкетаЗалогодателяСрезПоследних.Период
		|			ТОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.Период
		|	КОНЕЦ КАК DIzm,
		|	ВЫБОР
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА NULL
		|		ИНАЧЕ ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти
		|	КОНЕЦ КАК dMort,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ИсточникИнформацииДругое КАК DopRekl,
		|	NULL КАК DSOGL,
		|	ВЫБОР
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email = """"
		|			ТОГДА NULL
		|		ИНАЧЕ ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email
		|	КОНЕЦ КАК EMail,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ИсточникИнформации КАК ИсточникИнформации,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ИсточникИнформацииДругое КАК ИсточникИнформацииДругое,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Fam,
		|	"""" КАК Gorod,
		|	"""" КАК Hist,
		|	ЛБ_АнкетаЗалогодателяСрезПоследних.ИНН КАК INNalog,
		|	"""" КАК IPContact,
		|	ВЫБОР
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ЯвляетсяИПДЛ
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК IPDL,
		|	"""" КАК IPOGRN,
		|	"""" КАК IPRegDoc,
		|	"""" КАК IPRegOrgan,
		|	"""" КАК KLADR1,
		|	"""" КАК KLADR2,
		|	"""" КАК KLADR3,
		|	"""" КАК KodBlack,
		|	"""" КАК KodClient,
		|	NULL КАК KodRekl,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство.Код КАК KodStrana,
		|	ВЫБОР
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ТипФизЛица = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
		|			ТОГДА 1
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.ТипФизЛица = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
		|			ТОГДА 2
		|	КОНЕЦ КАК KodTip,
		|	1 КАК KodVid,
		|	ВЫБОР
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.КатегорияДЛПМО_РДПЛ = ЗНАЧЕНИЕ(Перечисление.ЛБ_КатегорииДЛПМО_РДПЛ.ДЛПМО)
		|			ТОГДА 1
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.КатегорияДЛПМО_РДПЛ = ЗНАЧЕНИЕ(Перечисление.ЛБ_КатегорииДЛПМО_РДПЛ.ГосДолжность)
		|			ТОГДА 2
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.КатегорияДЛПМО_РДПЛ = ЗНАЧЕНИЕ(Перечисление.ЛБ_КатегорииДЛПМО_РДПЛ.СоветДиректоровЦБ)
		|			ТОГДА 3
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.КатегорияДЛПМО_РДПЛ = ЗНАЧЕНИЕ(Перечисление.ЛБ_КатегорииДЛПМО_РДПЛ.ФедеральнаяГосСлужба)
		|			ТОГДА 4
		|		КОГДА ЛБ_АнкетаЗалогодателяСрезПоследних.КатегорияДЛПМО_РДПЛ = ЗНАЧЕНИЕ(Перечисление.ЛБ_КатегорииДЛПМО_РДПЛ.ИныеГосСлужбы)
		|			ТОГДА 5
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК KodZdec,
		|	NULL КАК KorProc,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Name,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ОтветственныйЛомбард.id_LX КАК nObj,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Patr,
		|	0 КАК pdSync,
		|	"""" КАК Plat_Uni,
		|	"""" КАК Predst,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Комментарий КАК Prim,
		|	ВЫБОР
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Stat,
		|	ЛБ_АнкетаЗалогодателяСрезПоследних.УровеньРиска КАК StRisk,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК TelMob,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонДополнительный КАК Tel,
		|	"""" КАК WLast,
		|	0 КАК xAr,
		|	0 КАК xDel,
		|	ВЫБОР
		|		КОГДА ЛБ_СоглашенияЭДОСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыСоглашенийЭДО.Заключено)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК xEDOCL,
		|	NULL КАК xFATF,
		|	NULL КАК xM,
		|	ВЫБОР
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА 1
		|		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
		|			ТОГДА 0
		|	КОНЕЦ КАК xSex,
		|	ВЫБОР
		|		КОГДА ЛБ_СогласиеНаСМСРассылкуСрезПоследних.Согласен
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК xSMS,
		|	0 КАК xSOGL,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ОтветственныйЛомбард КАК ОтветственныйЛомбард
		|ИЗ
		|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_АнкетаЗалогодателяСрезПоследних
		|		ПО ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_АнкетаЗалогодателяСрезПоследних.Залогодатель
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СогласиеНаСМСРассылку.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_СогласиеНаСМСРассылкуСрезПоследних
		|		ПО ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_СогласиеНаСМСРассылкуСрезПоследних.Залогодатель
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(, Клиент = &Залогодатель) КАК ЛБ_СоглашенияЭДОСрезПоследних
		|		ПО ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_СоглашенияЭДОСрезПоследних.Клиент";
	
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		Возврат РезультатЗапроса;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

//Статусы KodBlack:
//1. Статусы перечней и специальные статусы (Искать по всем перечням)
//	- Террорист
//		- 1 - Черный (Включен)
//		- 6 - Исключен
//	- МВК
//		- 13 - Включен
//		- 15 - исключен
//	- 16 - ФРОМУ
//	- 19 - СБ ООН
//	
//	- 2 - Недобросовестный
//	- 9 - ВИП
//	- 10 - Сотрудник
//	- 12 - Тёмный (Стоп-лист)
//	- 20 - Банкрот
//	
//2. Расчетный статус по системе лояльности
//	- 0 - Новый
//	- 3 - Не выкупающий
//	- 4 - Добросовестный
//	- 5 - Постоянный
//	- 7 - Неопределенный
//	- -2 - Сверхновый
Функция ОпределитьKodBlack(Залогодатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Статус КАК Статус,
		|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ВидПеречня КАК ВидПеречня,
		|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ИД КАК ИД
		|ИЗ
		|	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц.СрезПоследних(
		|			,
		|			Наименование = &Наименование
		|					И ВЫБОР
		|						КОГДА ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|							ТОГДА ДатаРождения = НАЧАЛОПЕРИОДА(&ДатаРождения, ДЕНЬ)
		|						КОГДА ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|								И ГодРождения <> """"
		|							ТОГДА ГодРождения = ГОД(&ДатаРождения)
		|					КОНЕЦ
		|				ИЛИ НаименованиеЛат = &Наименование
		|					И ВЫБОР
		|						КОГДА ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|							ТОГДА ДатаРождения = НАЧАЛОПЕРИОДА(&ДатаРождения, ДЕНЬ)
		|						КОГДА ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|								И ГодРождения <> """"
		|							ТОГДА ГодРождения = ГОД(&ДатаРождения)
		|					КОНЕЦ
		|				ИЛИ ТехническоеНаименование = &Наименование
		|					И ВЫБОР
		|						КОГДА ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|							ТОГДА ДатаРождения = НАЧАЛОПЕРИОДА(&ДатаРождения, ДЕНЬ)
		|						КОГДА ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|								И ГодРождения <> """"
		|							ТОГДА ГодРождения = ГОД(&ДатаРождения)
		|					КОНЕЦ
		|				ИЛИ ИД В
		|						(ВЫБРАТЬ
		|							ЛБ_ПереченьНежелательныхЛицДрНаименованияСрезПоследних.ИД КАК ИД
		|						ИЗ
		|							РегистрСведений.ЛБ_ПереченьНежелательныхЛицДрНаименования.СрезПоследних(, Наименование = &Наименование
		|									И ВЫБОР
		|										КОГДА ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|											ТОГДА ДатаРождения = НАЧАЛОПЕРИОДА(&ДатаРождения, ДЕНЬ)
		|										КОГДА ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|												И ГодРождения <> """"
		|											ТОГДА ГодРождения = ГОД(&ДатаРождения)
		|									КОНЕЦ
		|								ИЛИ ТехническоеНаименование = &Наименование
		|									И ВЫБОР
		|										КОГДА ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|											ТОГДА ДатаРождения = НАЧАЛОПЕРИОДА(&ДатаРождения, ДЕНЬ)
		|										КОГДА ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|												И ГодРождения <> """"
		|											ТОГДА ГодРождения = ГОД(&ДатаРождения)
		|									КОНЕЦ) КАК ЛБ_ПереченьНежелательныхЛицДрНаименованияСрезПоследних
		|						СГРУППИРОВАТЬ ПО
		|							ЛБ_ПереченьНежелательныхЛицДрНаименованияСрезПоследних.ИД)
		|					И ВЫБОР
		|						КОГДА ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|							ТОГДА ДатаРождения = НАЧАЛОПЕРИОДА(&ДатаРождения, ДЕНЬ)
		|						КОГДА ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
		|								И ГодРождения <> """"
		|							ТОГДА ГодРождения = ГОД(&ДатаРождения)
		|					КОНЕЦ) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ВидПеречня,
		|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Статус,
		|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ИД";
	
	Запрос.УстановитьПараметр("ДатаРождения", Залогодатель.ДатаРождения);
	Запрос.УстановитьПараметр("Наименование", Залогодатель.Наименование);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Если РезультатЗапроса.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы
			И РезультатЗапроса.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
			Возврат 1;
		ИначеЕсли РезультатЗапроса.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы
			И РезультатЗапроса.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
			Возврат 6;
		ИначеЕсли РезультатЗапроса.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК
			И РезультатЗапроса.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
			Возврат 13;
		ИначеЕсли РезультатЗапроса.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК
			И РезультатЗапроса.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
			Возврат 15;
		ИначеЕсли РезультатЗапроса.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
			Возврат 16;
		ИначеЕсли РезультатЗапроса.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
			Возврат 19;
		КонецЕсли;
	КонецЕсли;
	
	СтатусЛояльности = ПолучитьСтатусЛояльности(Залогодатель);
	
	Если ПолучитьСлужебныйСтатус(Залогодатель, "Недобросовестный") Тогда
		Возврат 2;
	КонецЕсли;
	
	Если ПолучитьДополнительныйСтатус(Залогодатель, Справочники.ЛБ_СтатусыЗалогодателей.VIP) Тогда
		Возврат 9;
	КонецЕсли;
	
	Если ПолучитьДополнительныйСтатус(Залогодатель, Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник) Тогда
		Возврат 10;
	КонецЕсли;
	
	Если ПолучитьСлужебныйСтатус(Залогодатель, "Стоп-лист") Тогда //Темный
		Возврат 12;
	КонецЕсли;
	
	Если ПолучитьСлужебныйСтатус(Залогодатель, "Банкрот") Тогда
		Возврат 20;
	КонецЕсли;
	
	Если СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Новый Тогда
		Возврат 0;
	КонецЕсли;
	
	Если СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Невыкупающий Тогда
		Возврат 3;
	КонецЕсли;
	
	Если СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Добросовестный Тогда
		Возврат 4;
	КонецЕсли;
	
	Если СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Постоянный Тогда
		Возврат 5;
	КонецЕсли;
	
	Если СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Неопределенный Тогда
		Возврат 7;
	КонецЕсли;
	
	Если СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Сверхновый Тогда
		Возврат -2;
	КонецЕсли;
КонецФункции

Функция ПолучитьСлужебныйСтатус(Залогодатель, Статус)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Статус КАК Статус,
		|	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется
		|ИЗ
		|	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(
		|			,
		|			Залогодатель = &Залогодатель
		|				И Статус.Наименование = &Статус) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
	
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Статус", Статус);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.Используется;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

