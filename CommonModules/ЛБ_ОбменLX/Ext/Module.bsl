Функция ЗагрузитьКлиентов() Экспорт
	
	ТекстЗапроса = "SELECT KodClient id_LX, Dizm	
	|	FROM
	|		[dcbdl_uni].[dbo].[aclient]"; 
	
	
		
	НеГрузитьАдреса = Истина;
	ПерезаписыватьКлиентов = Истина;
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_LX"); 
	тз.Колонки.Добавить("ДатаИзменения");
	тз.Колонки.Добавить("ДатаИзменения1С");

	

	
	тзСтран = ВернутьТЗСтран();
	тзПервыхДатЗБ = ВернутьТаблицуПервыхДатЗБ();
	тзЧерныеСтатусыКлиентов = ВернутьКлиентовСЧернойМеткой();

	
	АдоСоединение = АдоНовоеСоединение("dcbdl_uni");

	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса); 
