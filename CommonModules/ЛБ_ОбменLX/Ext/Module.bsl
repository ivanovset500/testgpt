Процедура РассчитатьСуммуПроцентов(Параметры) 
	Док 						= Параметры.Док; 
	ОкруглятьЦены 				= Параметры.ОкруглятьЦены;
	ВидОкругленияСуммыПроцентов = Параметры.ВидОкругленияСуммыПроцентов;
	ПорядокОкругления 			= Параметры.ПорядокОкругления; 
	ОкруглятьВБольшуюСторону 	= Параметры.ОкруглятьВБольшуюСторону; 
	СхемаКредитования 			= Параметры.СхемаКредитования;
	ДатаДок 					= Параметры.ДатаДок; 
	ТаблицаСтавок               = Параметры.ТаблицаСтавок;
	СуммаЗайма                  = Параметры.СуммаЗайма; 
	Организация                 = Параметры.Организация;
	
	
	ДатаВыкупа = НачалоДня(ДатаДок) + 86401*Док.СрокЗалога;  
	ДатаВыкупа = ЛБ_УправлениеЛомбардом.ИсключитьДатаВыкупаПразничныйДень(ДатаВыкупа);
	
	
	Док.ГрафикПлатежей.Очистить();
	Если НЕ Док.ПроцентнаяСхема = 0 Тогда                                                                                                                
		СтруктураОкругления = новый Структура;
		СтруктураОкругления.Вставить("ОкруглятьЦены", ОкруглятьЦены);  
		СтруктураОкругления.Вставить("ВидОкругленияСуммыПроцентов", ВидОкругленияСуммыПроцентов);
		СтруктураОкругления.Вставить("ПорядокОкругления", ПорядокОкругления);  
		СтруктураОкругления.Вставить("ОкруглятьВБольшуюСторону", ОкруглятьВБольшуюСторону);  
		ДатаНачала = ЛБ_УправлениеЛомбардом.ПолучитьДатуНачалаРасчетаПроцентов(ДатаДок, Организация);
		
		СуммаПроцентов = 0;
		Для сч = 0 По ТаблицаСтавок.Количество()-1 Цикл 
			СтрС = ТаблицаСтавок.Получить(сч); 
			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачала;
			Иначе 
				ДатаНач = НачалоДня(ДатаНачала + СтрС.ДеньНачалаПрименения*(60 * 60 * 24));
			КонецЕсли;	
			Если ДатаНач > ДатаВыкупа Тогда 
				Прервать;
			КонецЕсли;	
			
			сч1 = сч + 1;
			Если сч1 >= ТаблицаСтавок.Количество() Тогда
				ДатаКон = ДатаВыкупа; 
				ДеньКон = Док.СрокЗалога;
			Иначе   
				СтрС1 = ТаблицаСтавок.Получить(сч1);
				ДатаКонца = НачалоДня(ДатаНачала + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24)); 
				Если ДатаКонца > ДатаВыкупа Тогда
					ДатаКон = ДатаВыкупа;
					ДеньКон = Док.СрокЗалога;
				Иначе
					ДатаКон = ДатаКонца; 
					ДеньКон = СтрС1.ДеньНачалаПрименения-1;
				КонецЕсли;	
			КонецЕсли;	
			
			Если НЕ (НачалоДня(ДатаКон) < НачалоДня(ДатаНач)) тогда
				//СтавкаП = СтрС.ПроцентнаяСтавка;
				СтавкаП = Док.ПроцентнаяСхема;  //подменяем ставку из LX, а не рассчитанную
				Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
					Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
					КонецЕсли; 
				КонецЕсли;	              
				Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗайма, СтруктураОкругления);
				СуммаПроцентов = СуммаПроцентов + Результат.СуммаПроцентов; 
				Если СтрС.ДеньНачалаПрименения = 1 Тогда
					СуммаПроцентовДень = Результат.СуммаПроцентовДень;				
				КонецЕсли;	
				СтрП = Док.ГрафикПлатежей.Добавить();   
				СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
				СтрП.ДатаНач = ДатаНач;
				СтрП.ДатаКон = ДатаКон;
				СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
				СтрП.ДеньКон = ДеньКон; 
				СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
				СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
				СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
				СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
				СтрП.СуммаПроцентов = Результат.СуммаПроцентов;
				СтрП.СуммаПроцентовДень = СуммаПроцентовДень;
			КонецЕсли;	
		Конеццикла;	
	Иначе
		СуммаПроцентов = 0;
		СуммаПроцентовДень = 0;
	КонецЕсли;	
КонецПроцедуры

