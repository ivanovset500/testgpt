			Док.ДокументыЗалогодателя.Очистить();
			
			
			СсылкаСпр = НайтиДокументСвидСмерти(Ссылка);
			Если СсылкаСпр = Неопределено Тогда
				СпрОбъект = Справочники.ЛБ_ДокументыЗалогодателя.СоздатьЭлемент();
