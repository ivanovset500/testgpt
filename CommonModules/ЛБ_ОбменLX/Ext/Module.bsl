Процедура ПроставитьЛомбардыВОтделения() Экспорт	
	
	ЗагрузитьОтделенияЛомбардовИзLX();
	
	АдоСоединение = АдоНовоеСоединение("dCBDL");
	
	ТекстЗапроса = "SELECT NObj,KodOtd, NMOt FROM [dCBDL].[dbo].[spADR] Group By NObj,KodOtd,NMOt";		
	
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("Отделение");
	тз.КОлонки.Добавить("Ломбард");
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	Пока не Выборка.eof() Цикл                 
		id_ломбарда  = СтрЗаменить(Выборка.fields("NObj").value, Символы.НПП, "");
		кодотделения = Выборка.fields("NMOt").value; 
		
		
		Если id_ломбарда = "" или кодотделения = "" Тогда
			
		Иначе
			
			
			Отделение = Справочники.ЛБ_ОтделенияЛомбардов.НайтиПоНаименованию(кодотделения); 
			Ломбард   = Справочники.ЛБ_Ломбарды.НайтиПоРеквизиту("id_LX",id_ломбарда); 
			
			
			Если ЗначениеЗаполнено(Ломбард) и ЗначениеЗаполнено(Отделение) Тогда 
				НовСТр = тз.Добавить();
				НовСтр.Отделение = Отделение;
				НовСтр.Ломбард = Ломбард;			
			КонецЕсли; 
		КонецЕсли;
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	тзОтделения = тз.Скопировать();
	
	тзОтделения.Свернуть("Отделение"); 
	
	Для каждого стр из тзОтделения Цикл
		НовДок = Документы.ЛБ_УстановитьЛомбардыВОтделение.СоздатьДокумент();
		НовДок.Дата = Дата(2023,01,01); 
		НовДок.Отделение = стр.Отделение;
		
		НайдСтроки = тз.НайтиСтроки(Новый структура("Отделение", стр.Отделение));
		Для каждого малСтр из НайдСтроки Цикл
			НоваяСтр = НовДок.Ломбарды.Добавить(); 
			НоваяСТр.Ломбард = малСтр.Ломбард;
		КонецЦикла;
		
		Если НовДок.Ломбарды.Количество() > 0 Тогда
			НовДок.Записать();
			НовДок.Записать(РежимЗаписиДокумента.Проведение);			
		КонецЕсли; 
	КонецЦикла;
	
	
КонецПроцедуры  


Процедура ПроставитьЛомбардыВГруппы() Экспорт	
	
	ЗагрузитьГруппыЛомбардовИзLX();
	
	АдоСоединение1 = АдоНовоеСоединение("dCBDL");
	
	ТекстЗапроса1 = "SELECT NObj,Gorod_ FROM [dCBDL].[dbo].[spADR] Group By NObj,Gorod_";		
	
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("группа");
	тз.КОлонки.Добавить("Ломбард");
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение1, ТекстЗапроса1);
	
	Пока не Выборка.eof() Цикл                 
		id_ломбарда  = СтрЗаменить(Выборка.fields("NObj").value, Символы.НПП, "");
		наимГруппы = Выборка.fields("Gorod_").value; 
		
		Если id_ломбарда = "" или наимГруппы = "" Тогда
			
		Иначе
			
			группа = Справочники.ЛБ_ГруппыЛомбардов.НайтиПоНаименованию(наимГруппы); 
			Ломбард   = Справочники.ЛБ_Ломбарды.НайтиПоРеквизиту("id_LX",id_ломбарда); 
			
			
			Если ЗначениеЗаполнено(Ломбард) и ЗначениеЗаполнено(группа) Тогда 
				НовСТр = тз.Добавить();
				НовСтр.группа = группа;
				НовСтр.Ломбард = Ломбард;			
			КонецЕсли; 
		КонецЕсли;
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение1.Close();
	
	тзГруппы = тз.Скопировать();
	
	тзГруппы.Свернуть("Группа"); 
	
	Для каждого стр из тзГруппы Цикл
		НовДок = Документы.ЛБ_УстановитьЛомбардыВГруппу.СоздатьДокумент();
		НовДок.Дата = Дата(2023,01,01); 
		НовДок.Группа = стр.Группа;
		
		НайдСтроки = тз.НайтиСтроки(Новый структура("Группа", стр.Группа));
		Для каждого малСтр из НайдСтроки Цикл
			НоваяСтр = НовДок.Ломбарды.Добавить(); 
			НоваяСТр.Ломбард = малСтр.Ломбард;
		КонецЦикла;
		
		Если НовДок.Ломбарды.Количество() > 0 Тогда
			НовДок.Записать();
			НовДок.Записать(РежимЗаписиДокумента.Проведение);			
		КонецЕсли; 
	КонецЦикла;
	
	
КонецПроцедуры



