					Парамс.Вставить("Данные", 			РеквизитыКлиента[0]); 
					Парамс.Вставить("тзСтран", 			тзСтран);
					Парамс.Вставить("АдоСоединение", 	АдоСоединение);
					Парамс.Вставить("СтатусКлиента", 	"");
					Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
					Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
					Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ); 
