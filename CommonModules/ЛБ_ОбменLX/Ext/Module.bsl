Функция НайтиДокументПоПредставлениюНомера(Номер, Дата, ТипДокумента)
	Запрос = Новый Запрос;	
	Если ТипДокумента = "ЛБ_ПриходныйКассовыйОрдер" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЛБ_ПриходныйКассовыйОрдер КАК ЛБ_ПриходныйКассовыйОрдер
		|ГДЕ
		|	ЛБ_ПриходныйКассовыйОрдер.ПредставлениеНомераПКО = &Номер
		|	И ЛБ_ПриходныйКассовыйОрдер.Дата МЕЖДУ &НачДата И &КонДата";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_РасходныйКассовыйОрдер.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЛБ_РасходныйКассовыйОрдер КАК ЛБ_РасходныйКассовыйОрдер
		|ГДЕ
		|	ЛБ_РасходныйКассовыйОрдер.ПредставлениеНомераРКО = &Номер
		|	И ЛБ_РасходныйКассовыйОрдер.Дата МЕЖДУ &НачДата И &КонДата";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("НачДата", НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонДата", КонецДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции



функция Kassa(НачДата, КонДата, Ломбард) Экспорт
	
	pOrg="02";  
	
	db="'" + НачДата + "'";
	de="'" + КонДата + "'"; 
	
	Если Не ЗначениеЗаполнено(Ломбард) Тогда
		plat = "";
	Иначе
		plat = Ломбард;
	КонецЕсли; 
	
	
	//ТекстЗапроса = "exec [Z1CKorp_Kassa_auto_CF] "+db+","+de+",'"+plat+"',0,'02','',''"; 
	ТекстЗапроса = "exec [Z1CKorp_Kassa_auto_CF_dev] "+db+","+de+",'"+plat+"',0,'02','',''";
	
	
	АдоСоединение = АдоНовоеСоединение("dlink");	
	
	Организация 	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
	ЦентральныйОфис = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ЦентральныйОфис"); 
	ВременноеПодразделение 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновноеПодразделение");
	Боровский = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ФизическоеЛицо_Боровский");


	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	тз = Новый ТаблицаЗначений;
	
	тзДней = Новый ТаблицаЗначений;
	тзДней.Колонки.Добавить("День");
	тзДней.Колонки.Добавить("Ломбард");

	Пока не Выборка.eof() Цикл 
		
		КодОперации = Выборка.fields("KodOperKass").value;
		Если КодОперации = 0 или КодОперации = -1 Тогда
			Выборка.movenext();
			продолжить;
		КонецЕсли; 
		
		Удаленный = Выборка.fields("xdel").value;
		Если Удаленный = 1 Тогда
			Выборка.movenext();
			продолжить;
		КонецЕсли;
		
		ТипДока = Выборка.fields("tp").value;
		Если ТипДока = -1 Тогда
			ТипДокумента = "ЛБ_РасходныйКассовыйОрдер";
		Иначе    
			ТипДокумента = "ЛБ_ПриходныйКассовыйОрдер";
		КонецЕсли;
		
		//Идентификатор= ЗаписиSQL.fields("iden").value ;
		
		Дата  = Выборка.fields("data").value;
		Номер = Выборка.fields("nomer").value;
		
		

		id_Ломбарда   = СтрЗаменить(Выборка.fields("nobj").value, Символы.НПП, "");
		Если Не ЗначениеЗаполнено(id_Ломбарда) Тогда
			Сообщить("Не заполнен id ломбарда в документе № "+СокрЛП(Выборка.fields("ndoc").value));
			Выборка.movenext();
			продолжить;
		КонецЕсли;
			
		
		СсылкаНаЛомбард     = ВернутьЛомбардПоID(id_Ломбарда); 
		
		Если СсылкаНаЛомбард = Неопределено Тогда
			РеквизитыЛомбардаИзLX = ВернутьРеквизитыЛомбардаИзLX(id_Ломбарда);
			Ломб = Справочники.ЛБ_Ломбарды.СоздатьЭлемент();
			Ломб.Наименование 		= РеквизитыЛомбардаИзLX.Наименование;
			Ломб.НомерЛомбарда 		= РеквизитыЛомбардаИзLX.Номер;
			Ломб.НаименованиеПолное = Ломб.Наименование;
			Ломб.id_LX 				= id_Ломбарда; 
			Ломб.Подразделение 		= ВременноеПодразделение;
			Ломб.Записать();
			СсылкаНаЛомбард = Ломб.Ссылка;
		КонецЕсли;
		
		Ломбард       = СсылкаНаЛомбард;
		промЛомб2     = СтрЗаменить(Выборка.fields("nobj2").value, Символы.НПП, "");  
		ДругойЛомбард = ""; 
		Если ЗначениеЗаполнено(промЛомб2) Тогда
			
			СсылкаНаДрЛомбард     = ВернутьЛомбардПоID(промЛомб2); 
			
			Если СсылкаНаДрЛомбард = Неопределено Тогда
				РеквизитыЛомбардаИзLX = ВернутьРеквизитыЛомбардаИзLX(промЛомб2);
				Ломб = Справочники.ЛБ_Ломбарды.СоздатьЭлемент();
				Ломб.Наименование 		= РеквизитыЛомбардаИзLX.Наименование;
				Ломб.НомерЛомбарда 		= РеквизитыЛомбардаИзLX.Номер;
				Ломб.НаименованиеПолное = Ломб.Наименование;
				Ломб.id_LX 				= промЛомб2; 
				Ломб.Подразделение 		= ВременноеПодразделение;
				Ломб.Записать();
				СсылкаНаДрЛомбард = Ломб.Ссылка;
			КонецЕсли;
			
			
			
			ДругойЛомбард       = СсылкаНаДрЛомбард; 
		КонецЕсли;			
		
		Основание = Выборка.fields("osnova").value; 
		Сумма     = Выборка.fields("Summa").value;  
		
		ОткрытьКассовуюСмену(Дата, Ломбард);
		НовСтрДней = тзДней.Добавить();
		НовСтрДней.День = НачалоДня(Дата); 
		НовСтрДней.Ломбард = Ломбард;
	
		НайдДок = НайтиДокументПоПредставлениюНомера(Номер, Дата, ТипДокумента);
		
		Если НайдДок = Неопределено Тогда
			Док = Документы[ТипДокумента].СоздатьДокумент();
			Если ТипДокумента = "ЛБ_РасходныйКассовыйОрдер" Тогда		
				Док.ПредставлениеНомераРКО =  Номер;
			Иначе
				Док.ПредставлениеНомераПКО =  Номер;
			КонецЕсли;
		Иначе
			Док = НайдДок.ПолучитьОбъект();
		КонецЕсли;  
		Док.Комментарий		= "Код операции LX: " + КодОперации; 
		Док.Дата 			= Дата;
		Док.Организация 	= Организация; 
		Док.Ломбард 		= Ломбард;
		Док.Сумма   		= Сумма;
		Док.Основание   	= Основание;
		
		
