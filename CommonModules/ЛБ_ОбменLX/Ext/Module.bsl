Функция ВернутьФормуОгранки(Код, Огранка_17, Огранка_57, Огранка_Фантаз, Огранка_Граненый, КачествоОгранки_А, КачествоОгранки_Б) 
	Рез = Новый Структура;
	Рез.Вставить("ФормаОгранки", "");
	Рез.Вставить("КачествоОгранки","");
	
	Если Код = 1 Тогда
		Рез = Новый Структура;
		Рез.Вставить("ФормаОгранки",    Огранка_57);
		Рез.Вставить("КачествоОгранки", КачествоОгранки_А);
	ИначеЕсли Код = 2 Тогда
		Рез = Новый Структура;
		Рез.Вставить("ФормаОгранки", 	Огранка_17);
		Рез.Вставить("КачествоОгранки",	КачествоОгранки_А); 
	ИначеЕсли Код = 4 Тогда
		Рез = Новый Структура;
		Рез.Вставить("ФормаОгранки", 	Огранка_57);
		Рез.Вставить("КачествоОгранки",	КачествоОгранки_Б); 
	ИначеЕсли Код = 5 Тогда
		Рез = Новый Структура;
		Рез.Вставить("ФормаОгранки", 	Огранка_17);
		Рез.Вставить("КачествоОгранки",	КачествоОгранки_Б); 		
	ИначеЕсли Код = 6 Тогда
		Рез = Новый Структура;
		Рез.Вставить("ФормаОгранки",	Огранка_Фантаз);
		Рез.Вставить("КачествоОгранки",	КачествоОгранки_А);		
	ИначеЕсли Код = 7 Тогда
		Рез = Новый Структура;
		Рез.Вставить("ФормаОгранки", 	Огранка_Граненый);
		Рез.Вставить("КачествоОгранки",	КачествоОгранки_А);
		
	КонецЕсли;
	
	Возврат Рез;
КонецФункции 

Функция ВернутьВесовуюГруппу(ВесОт, ВесДо);
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	ЛБ_ВесовыеГруппыДрагоценныхКамней.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЛБ_ВесовыеГруппыДрагоценныхКамней КАК ЛБ_ВесовыеГруппыДрагоценныхКамней
	|ГДЕ
	|	ЛБ_ВесовыеГруппыДрагоценныхКамней.ВесОт = &ВесОт
	|	И ЛБ_ВесовыеГруппыДрагоценныхКамней.ВесДо = &ВесДо";
	Запрос.УстановитьПараметр("ВесОТ", ВесОт);   
	Запрос.УстановитьПараметр("ВесДо", ВесДо); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат неопределено;
	КонецЕсли;
КонецФункции



Процедура ЗаполнитьСтрокуСтавокПроцентов(НоваяСтр, Парамс)
	Попытка
		НоваяСтр.ПричинаПрименения 		= Парамс.ПричинаПрименения; 
	Исключение
	КонецПопытки;
	НоваяСтр.СхемаКредитования 		= Парамс.СхемаКредитования;  
	//НоваяСтр.СхемаРасчетаПроцентов 	= Перечисления.ЛБ_СхемыРасчетаПроцентов.Фиксированная;			
	НоваяСтр.СтатусЗалогодателя 	= Парамс.СтатусКлиента;
	НоваяСтр.ДиапазонСумм           = Парамс.ДиапазонСумм;
	НоваяСтр.Ставка			        = Парамс.Ставка;
	Если Парамс.ЭтоБудетАкция Тогда
		НоваяСтр.УстановитьЗначениеИлиОтклонение = Перечисления.ЛБ_УстановкаЗначенияИлиОтклонения.Значение;
	Иначе
		НоваяСтр.ДеньНачалаПрименения	= Парамс.ДеньНачалаПрименения;	
	КонецЕсли;	
КонецПроцедуры


Функция ВернутьСтатусЗалогодателя(Статус, СтатусЛьготный, СтатусСверхновый) 
	Если СокрЛП(Статус) = "11" Тогда
		Возврат СтатусЛьготный; 
	ИначеЕсли СокрЛП(Статус) = "-2" Тогда
		Возврат СтатусСверхновый; 
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции

Функция ВернутьСхему(ВидЗайма, Статус, СхемаКредитования_Экспресс, СхемаКредитования_Классика, СхемаКредитования_Классика1День)  	
	Если СокрЛП(ВидЗайма) = "1" Тогда
		Возврат СхемаКредитования_Экспресс;
	Иначе
		Если Статус = "11" Тогда
			Возврат СхемаКредитования_Классика;
		Иначе
			Возврат СхемаКредитования_Классика1День;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ВернутьГибкуюСхему(ВидЗайма, Статус, СхемаКредитования_ЭкспрессГибкий, СхемаКредитования_КлассикаГибкий, СхемаКредитования_Классика1ДеньГибкий, СхемаЭкспрессГибкий_5, СхемаКлассикаГибкий_5, Дата)  	
	Если СокрЛП(ВидЗайма) = "1" Тогда
		Если Дата >= Дата(2023, 10, 16) Тогда
			Возврат СхемаЭкспрессГибкий_5;	
		Иначе
			Возврат СхемаКредитования_ЭкспрессГибкий;
		КонецЕсли;
	Иначе
		Если Статус = "11" Тогда
			Возврат СхемаКредитования_КлассикаГибкий;
		Иначе
			Если Дата >= Дата(2023, 10, 16) Тогда
				Возврат СхемаКлассикаГибкий_5;
			Иначе
				Возврат СхемаКредитования_Классика1ДеньГибкий;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецФункции


Функция ВернутьРеквизитыЛомбардаИзLX(id_LX) Экспорт
	
	АдоСоединение = АдоНовоеСоединение("dCBDL");
	
	ТекстЗапроса = "SELECT [NRecAdr]
	|,[PLAT]
	|,[NObj]
	|,[NameS]
	|,[NamePL] 
	|,[FIAS]
	|,[NMGOROD] 
	|,[ADRES] 
	|,[KodOtd]
	| FROM [dCBDL].[dbo].[spADR] where nObj = " + СокрЛП(id_LX);		
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	Рез = Новый Структура("Наименование, Номер", "", "");
	Пока не Выборка.eof() Цикл
		Рез.Вставить("Наименование", Выборка.fields("NamePL").value); 
		Рез.Вставить("Номер",        Выборка.fields("PLAT").value); 
		Рез.Вставить("FIAS",         Выборка.fields("FIAS").value);
		Рез.Вставить("NMGOROD",        Выборка.fields("NMGOROD").value);
		Рез.Вставить("ADRES",        Выборка.fields("ADRES").value);
		Рез.Вставить("КодОтделения", СтрЗаменить(Выборка.fields("KodOtd").value, Символы.НПП, ""));
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	Возврат Рез;
КонецФункции

