Функция ПривестиТелефонКМаске(НомерТелефона) 
	НовТел = НомерТелефона;
	Если стрДлина(НомерТелефона) = 10 И Лев(НомерТелефона,1) = "9" Тогда
		НовТел = "+7 (" + Лев(НомерТелефона,3) + ") "+Прав(НомерТелефона, 7);
	КОнецЕсли;
	Возврат НовТел;
КонецФункции


Процедура ЗаполнитьРеквизитыЛомбардов() Экспорт
	Выборка = Справочники.ЛБ_Ломбарды.Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если ЗначениеЗаполнено(Выборка.id_LX) Тогда
			
			РеквизитыЛомбардаИзLX = ВернутьРеквизитыЛомбардаИзLX(Выборка.id_LX);  
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.НомерЛомбарда 		= РеквизитыЛомбардаИзLX.Номер; 
			Об.Записать();  
			
			Данные = Выборка.Ссылка.ПолучитьОбъект();		
			БылоСтрок = Данные.КонтактнаяИнформация.Количество(); 
			
			Для Счетчик =1 по Данные.КонтактнаяИнформация.Количество() Цикл 			
				НомерСтроки= БылоСтрок-Счетчик;  	
				
				лСтр = Данные.КонтактнаяИнформация[НомерСтроки]; 
				Если лСтр.ТИп = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда				
					Данные.КонтактнаяИнформация.Удалить(НомерСтроки);  			
				КонецЕсли; 		
			КонецЦикла;	
			Данные.Записать();
			
			стрАдр = СокрЛП(РеквизитыЛомбардаИзLX.NMGOROD) + ","+ СокрЛП(РеквизитыЛомбардаИзLX.Adres);
			ФактическийАдресСтруктура = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияПоПредставлению(стрАдр, Перечисления.ТипыКонтактнойИнформации.Адрес,Истина);
			ФактическийАдресСтруктура2 = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(ФактическийАдресСтруктура);  
			
			Если ЗначениеЗаполнено(ФактическийАдресСтруктура.comment) Тогда
				Сообщить(СокрЛП(Выборка.Ссылка)+". Ошибка: "+СокрЛП(ФактическийАдресСтруктура.comment));  
				//УправлениеКонтактнойИнформацией.УстановитьКонтактнуюИнформациюОбъекта(Выборка.Ссылка);		
				
				
			Иначе 			
				УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Выборка.Ссылка, ФактическийАдресСтруктура2, Справочники.ВидыКонтактнойИнформации.ФактАдресЛомбарда, ТекущаяДата(), Ложь);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры


Функция ВернутьОбъектЗалога(id_LX)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОбъектыЗалога.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЛБ_ОбъектыЗалога КАК ЛБ_ОбъектыЗалога
	|ГДЕ
	|	ЛБ_ОбъектыЗалога.id_LX = &id_LX"; 
	Запрос.УстановитьПараметр("id_LX", id_LX);
	Рез = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Рез; 
КонецФункции

Функция ВернутьОперациюПоЗалогуПо_id(id_LX, ВидОперации)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	|ГДЕ
	|	ЛБ_ОперацияПоЗалогу.id_LX = &id_LX
	|	И ЛБ_ОперацияПоЗалогу.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("id_LX", id_LX);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	
	Рез = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Рез;	
	
КонецФункции 

Функция ПрочитатьCSV(Папка, ИмяФайла, КолПолей) Экспорт
	// Параметры:
	
	// "Папка" - путь к файлу без имени файла с завершающим слешем,
	
	// "ИмяФайла" - имя файла,
	
	// "КолПолей" - количество колонок (число).
	
	Текст = "[" + ИмяФайла + "]
	|ColNameHeader=False
	|Format=TabDelimited
	|TextDelimiter ="+Символы.Таб +"
	|CharacterSet=ANSI
	|";
	
	Для ы = 1 По КолПолей Цикл
		Текст = Текст + "Col" + ы + "=Field" + ы + " Text" + Символы.ПС;
	КонецЦикла;
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.УстановитьТекст(Текст);
	ТекстДок.Записать(Папка + "Schema.ini");
	objRec = Новый COMОбъект("ADODB.Recordset");
	strQuery = "SELECT * FROM [" + ИмяФайла + "]"; // плюс прописать фильтр на поля, используя where
	strConn = "Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + Папка + ";Extended Properties=""text;""";
	adOpenStatic = 3;
	adLockOptimistic = 3;
	adCmdText = 1;
	ТаблЗнач = Новый ТаблицаЗначений;
	Для ы = 1 По КолПолей Цикл
		ТаблЗнач.Колонки.Добавить();
	КонецЦикла;
	objRec.Open(strQuery, strConn, adOpenStatic, adLockOptimistic, adCmdText);
	КолСтрок = objRec.RecordCount;
	Ном = 1;
	Пока Не objRec.EOF Цикл
		Если Ном % 500 = 0 Тогда
			//Состояние(ИмяФайла + " " + Ном + " из " + КолСтрок);
		КонецЕсли;
		НовСтр = ТаблЗнач.Добавить();
		Для i=0 По objRec.Fields.Count-1 Цикл
			НовСтр[i] = Строка(objRec.Fields(i).Value);
		КонецЦикла;
		objRec.MoveNext();
		Ном = Ном + 1;
	КонецЦикла;
	objRec.Close();
	Возврат ТаблЗнач;
	
КонецФункции

