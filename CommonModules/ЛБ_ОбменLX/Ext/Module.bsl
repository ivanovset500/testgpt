				ОбДокум = СсылкаСпр.ПолучитьОбъект(); 
				ОбДокум.Гражданство = Данные.Гражданство;
				ОбДокум.Записать();			
			КонецЕсли; 
			
			НоваяСтр = Док.ДокументыЗалогодателя.Добавить();
			НоваяСтр.ДокументЗалогодателя 		= СсылкаСпр;
			НоваяСтр.ВидДокумента 				= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ВидДокумента_СвидетельствоОСмерти");
			НоваяСтр.ВидДокументаЗалогодателя 	= Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент;;
			НоваяСтр.Гражданство 				= Данные.Гражданство;
			НоваяСтр.ДокументДатаВыдачи 		= Данные.ДатаВыдачиСвидСм;
			НоваяСтр.ДокументНачалоДействия 	= Данные.ДатаВыдачиСвидСм;
			НоваяСтр.ДатаСмерти 				= Данные.ДатаСмерти;
			//НоваяСтр.ДокументСерия 				= Данные.СерияСвидСм;
			НоваяСтр.ДокументНомер 				= Данные.НомерСвидСм;
			
			Док.Записать(РежимЗаписиДокумента.Проведение); 	
		КонецЕсли;
	КонецЕсли;
	
	//+Мельников 16.07.24 Добавление записи о статусе в регистр сведений
	Если Док <> Неопределено Тогда
		НаборЗаписей = РегистрыСведений.ЛБ_СтатусыЗалогодателейДополнительные.СоздатьНаборЗаписей();
