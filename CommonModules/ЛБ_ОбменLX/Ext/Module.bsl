Функция ПреобразоватьДатуРожденияИзБудущего(ДатаРождения)
	промДата = СокрЛП(ДатаРождения);
	День = День(ДатаРождения);
	Месяц = Месяц(ДатаРождения);
	Год = Год(ДатаРождения);
	
	Если Сред(промДата, 7, 1) = "2" Тогда 
		ГодСтр = Год - 1000;
	ИначеЕсли Сред(промДата, 7, 1) = "3" Тогда 
		ГодСтр = Год - 2000;
	ИначеЕсли Сред(промДата, 7, 1) = "4" Тогда 
		ГодСтр = Год - 3000;
	ИначеЕсли Сред(промДата, 7, 1) = "5" Тогда 
		ГодСтр = Год - 4000;
	ИначеЕсли Сред(промДата, 7, 1) = "6" Тогда 
		ГодСтр = Год - 5000;
	ИначеЕсли Сред(промДата, 7, 1) = "7" Тогда 
		ГодСтр = Год - 6000;
	ИначеЕсли Сред(промДата, 7, 1) = "8" Тогда 
		ГодСтр = Год - 6000;
	ИначеЕсли Сред(промДата, 7, 1) = "9" Тогда 
		ГодСтр = Год - 6000;
	КонецЕсли; 
	
	Возврат Дата(ГодСтр, Месяц, День);	
КонецФункции

