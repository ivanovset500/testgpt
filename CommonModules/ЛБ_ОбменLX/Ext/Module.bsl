КонецФункции

Процедура ЗагрузитьВыдачуЗаймов(ПараметрыЗагрузки) Экспорт 
	НачДата = ПараметрыЗагрузки.НачДата;
	КонДата = ПараметрыЗагрузки.КонДата;	
	Ломбард = ПараметрыЗагрузки.Ломбард; 
	
	ТолькоКлиенты = Ложь;
	Если ПараметрыЗагрузки.Свойство("ТолькоКлиенты") Тогда
		ТолькоКлиенты = ПараметрыЗагрузки.ТолькоКлиенты;
	КонецЕсли; 
	
	ПерезаписыватьКлиентов = Истина;
	Если ПараметрыЗагрузки.Свойство("ПерезаписыватьКлиентов") Тогда
		ПерезаписыватьКлиентов = ПараметрыЗагрузки.ПерезаписыватьКлиентов;
	КонецЕсли;
	
	НеГрузитьАдреса = Ложь;
	Если ПараметрыЗагрузки.Свойство("НеГрузитьАдреса") Тогда
		НеГрузитьАдреса = ПараметрыЗагрузки.НеГрузитьАдреса;
	КонецЕсли;  
	
	ИдентификаторЗаписи = "''";
	Если ПараметрыЗагрузки.Свойство("ИдентификаторЗаписи") Тогда
		ИдентификаторЗаписи = ПараметрыЗагрузки.ИдентификаторЗаписи;
	КонецЕсли;  
	
	тзПервыхДатЗБ = Новый ТаблицаЗначений;
	Если ПараметрыЗагрузки.Свойство("тзПервыхДатЗБ") Тогда
		тзПервыхДатЗБ = ПараметрыЗагрузки.тзПервыхДатЗБ;
	КонецЕсли; 
	
	СделатьАпдейт = Ложь;
	Если ПараметрыЗагрузки.Свойство("СделатьАпдейт") Тогда
		СделатьАпдейт = ПараметрыЗагрузки.СделатьАпдейт;
	КонецЕсли; 
	
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	pndoc = "";
	Если Не ЗначениеЗаполнено(Ломбард) Тогда
		plat = "";
	Иначе
		plat = Ломбард;
	КонецЕсли; 
	
	db="'" + НачДата + "'";
	de="'" + КонДата + "'"; 
	
	ТекстЗапроса = "exec [z1CAxi_azb] 2,'"+pndoc +"',"+db+","+de+",'"+plat+"',0,"+ИдентификаторЗаписи;
	
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_LX", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Дата", 			Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("ДатаВыкупа", 		Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("ДатаРеализации", 	Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("НомерЗБ", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Вес", 				Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("ВесЧистый", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаОценки", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаСсуды", 		Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Цена", 			Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("ТипИзделия", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Металл", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Проба", 			Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("Ставка", 			Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Ломбард", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Категория", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("id_Клиента", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Артикул", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("id_Ломбарда", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("КодСхемыКредитования", Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("КодСтатуса", 		Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("ВесБриллиантов", 	Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("КоличествоБриллиантов", 	Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаБриллиантов", Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("id_Документа",     Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("ndoc",     		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ddoc",     		Новый ОписаниеТипов("Дата")); 
	тз.Колонки.Добавить("ТипКлассики",     	Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Ответственный",    Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ОтказОтВыкупа",    Новый ОписаниеТипов("Булево"));
	тз.Колонки.Добавить("ОценкаМеталла", 	Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("ОценкаВставок", 	Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("Предъявитель", 	Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("ПСК", 				Новый ОписаниеТипов("Число"));
	
	
	
	
	
	тзСтран = ВернутьТЗСтран();
	
	тзЧерныеСтатусыКлиентов = ВернутьКлиентовСЧернойМеткой(); 
	
	Если тзПервыхДатЗБ.КОличество() = 0 Тогда
		тзПервыхДатЗБ = ВернутьТаблицуПервыхДатЗБ(); 
	КонецЕсли;
	
	
	Пока не Выборка.eof() Цикл
		НовСтр = тз.Добавить();
		НовСтр.Дата         	= Выборка.fields("Dpri").value; 
		НовСтр.ДатаВыкупа       = Выборка.fields("ДатаВыкупа").value;
		НовСтр.ДатаРеализации   = Выборка.fields("ДатаРеализации").value; 
		НовСтр.id_LX           	= СтрЗаменить(Выборка.fields("nrec").value, Символы.НПП, ""); 
		НовСтр.id_Документа    	= Выборка.fields("nrecClientDoc").value;
		НовСтр.ndoc         	= Выборка.fields("ndoc").value; 
		НовСтр.ddoc         	= Выборка.fields("ddoc").value; 
		НовСтр.НомерЗБ         	= Выборка.fields("nomer").value; 
		НовСтр.Ответственный    = Выборка.fields("FIO").value; 
		НовСтр.Вес         		= Выборка.fields("Вес").value; 
		НовСтр.ВесЧистый        = Выборка.fields("ВесЧистый").value;  
		НовСтр.СуммаОценки      = Выборка.fields("СуммаОценки").value; 
		НовСтр.СуммаСсуды       = Выборка.fields("СуммаСсуды").value;
		НовСтр.Цена       		= Выборка.fields("Цена").value;
		НовСтр.ТипИзделия      	= Выборка.fields("##ТипИзделия").value; 
		НовСтр.Металл       	= Выборка.fields("nmmat").value;  
		НовСтр.Проба      		= Выборка.fields("proba").value; 
		НовСтр.Ставка       	= Выборка.fields("ставка").value; 
		НовСтр.Категория       	= Выборка.fields("Kat").value;  
		НовСтр.КодСхемыКредитования = Выборка.fields("Iden").value; 
		НовСтр.ТипКлассики      = Выборка.fields("IdenGP").value; 
		НовСтр.КодСтатуса       = Выборка.fields("KodBlack").value;
		НовСтр.ВесБриллиантов   = Выборка.fields("ВесБриллиантов").value;
		НовСтр.КоличествоБриллиантов = Выборка.fields("КоличествоБриллиантов").value;
		НовСтр.СуммаБриллиантов = Выборка.fields("СуммаБриллиантов").value;    
		НовСтр.ОценкаМеталла 	= Выборка.fields("Оценка металла").value;
		НовСтр.ОценкаВставок 	= Выборка.fields("Оценка вставок").value; 
		НовСтр.Предъявитель 	= Выборка.fields("Предъявитель").value; 
		НовСтр.ПСК 				= Выборка.fields("ПСК").value; 
		
		НовСтр.id_Ломбарда      = СтрЗаменить(Выборка.fields("nobj").value, Символы.НПП, "");
		
		НовСтр.id_Клиента       = СтрЗаменить(Выборка.fields("KodClient").value, Символы.НПП, "");
		АртикулПром      		= Выборка.fields("#Серия").value;  	
		
		ПозСлэша 				= СтрНайти(АртикулПром,"/");
		НаимНоменклатуры 		= Сред(АртикулПром, ПозСлэша+1);  	
		НовСтр.Артикул      	= НаимНоменклатуры;  
		
		ОтказОтВыкупа    = Выборка.fields("Xfnakl").value; 
		Если ОтказОтВыкупа = 1 или ОтказОтВыкупа = Истина Тогда
			НовСтр.ОтказОтВыкупа = Истина;
		Иначе
			НовСтр.ОтказОтВыкупа = Ложь;
		КонецЕсли;		
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	Дата1Февраля                = Дата(2023,02,01);
	Дата16102023                = Дата(2023,10,16);
	Перечисление_Залог 			= Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог;
	Организация 				= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
	ЕдиницаИзмерения_гр 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ЕдиницаИзмерения_гр");
	ЕдиницаИзмерения_кар 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ЕдиницаИзмерения_кар");
	ВременноеПодразделение 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновноеПодразделение");
	СхемаКлассика          		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Классика");
	СхемаКлассика1День    		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_1День_Классика");
	СхемаКлассикаГибкий         = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Классика_Гибкий");
	СхемаКлассика1ДеньГибкий    = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_1День_Классика_Гибкий"); 
	СхемаКлассикаГибкий_5       = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Классика_Гибкий_5");
	
	СхемаЭкспресс          		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Экспресс");
	СхемаЭкспрессГибкий         = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Экспресс_Гибкий");
	СхемаЭкспрессГибкий_5         = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Экспресс_Гибкий_5");
	
	Приказ_ЭталонДляСтавок      = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Приказ_ЭталонДляСтавок");  
	
	
	ФормаОгранки_Круглая        = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Огранка_Круглая");
	ФормаОгранки_Граненый       = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Огранка_Граненый"); 
	ФормаОгранки_Фантазийная    = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Огранка_Фантаз"); 
	
	ВидОгранки_57               = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Огранка_57"); 
	ВидОгранки_17               = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Огранка_17"); 
	
	КачествоОгранки_А           = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("КачествоОгранки_А"); 
	КачествоОгранки_Б           = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("КачествоОгранки_Б");
	
	
	
	тзПроб = ВернутьТЗПроб();
	
	тзДок = тз.Скопировать();
	тзДок.Свернуть("id_LX, id_Документа, НомерЗБ, Дата, ndoc, ddoc, ДатаВыкупа, ДатаРеализации, id_Ломбарда, id_Клиента, Ставка, КодСтатуса, КодСхемыКредитования, ТипКлассики, Ответственный, ОтказОтВыкупа, Предъявитель, ПСК");   
	ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог;
	Для каждого строкаДок из тзДок Цикл	
		НайдДок = ВернутьОперациюПоЗалогуПо_id(строкаДок.id_LX, ВидОперации);
		Если НайдДок = Неопределено Тогда
			ОПЗ = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент();
		Иначе
			ОПЗ = НайдДок.ПолучитьОбъект();
		КонецЕсли; 	
		
		ОПЗ.id_LX 		= строкаДок.id_LX; 
		ОПЗ.Дата		= строкаДок.Дата;
		ОПЗ.ДатаВыкупа	= строкаДок.ДатаВыкупа;
		ОПЗ.ДатаВыкупаЛьготная = строкаДок.ДатаРеализации;
		ОПЗ.СрокЗалога  = (ОПЗ.ДатаВыкупа - ОПЗ.Дата)/86400; 
		ОПЗ.ВидОперации = Перечисление_Залог;
		ОПЗ.НомерЗалоговогоБилета = строкаДок.НомерЗБ;
		ОПЗ.Организация = Организация; 
		ОПЗ.ПроцентнаяСхема    = строкаДок.Ставка;
		//СтатусЗалогодателя = ВернутьСтатусКлиентаПоКодуLX(строкаДок.КодСтатуса);
		//ОПЗ.СтатусЗалогодателя = СтатусЗалогодателя;   
		
		
		Если строкаДок.Предъявитель = 1 Тогда 
			ОПЗ.Предъявитель = Истина;
		Иначе
			ОПЗ.Предъявитель = Ложь;
		КонецЕсли;			
		
		ОПЗ.ПСК_LX = строкаДок.ПСК;
		ОПЗ.ОтказОтВыкупа = строкаДок.ОтказОтВыкупа; 
		
		Если строкаДок.КодСхемыКредитования = 0 Тогда
			Если ОПЗ.Дата >= Дата1Февраля Тогда 
				Если строкаДок.ТипКлассики = 1 Тогда
					Если ОПЗ.Дата >= Дата16102023 Тогда
						ОПЗ.СхемаКредитования = СхемаКлассикаГибкий_5;	
					Иначе						
						ОПЗ.СхемаКредитования = СхемаКлассика1ДеньГибкий;
					КонецЕсли;
				Иначе
					ОПЗ.СхемаКредитования = СхемаКлассикаГибкий;
				КонецЕсли;
			Иначе
				КолДнейЗалога = (ОПЗ.ДатаВыкупа - ОПЗ.Дата) / 86400;
				Если КолДнейЗалога < 15 Тогда 
					ОПЗ.СхемаКредитования = СхемаКлассика1День;
				Иначе   
					ОПЗ.СхемаКредитования = СхемаКлассика;
				КонецЕсли;
				
				//Если строкаДок.ТипКлассики = 1 Тогда
				//	ОПЗ.СхемаКредитования = СхемаКлассика1День;
				//Иначе				
				//	ОПЗ.СхемаКредитования = СхемаКлассика;
				//КонецЕсли;
			КонецЕсли;
		ИначеЕсли строкаДок.КодСхемыКредитования = 1 Тогда
			Если ОПЗ.Дата >= Дата1Февраля  Тогда
				Если ОПЗ.Дата >= Дата16102023 Тогда
					ОПЗ.СхемаКредитования = СхемаЭкспрессГибкий_5; 
				Иначе
					ОПЗ.СхемаКредитования = СхемаЭкспрессГибкий;
				КонецЕсли;
			Иначе
				ОПЗ.СхемаКредитования = СхемаЭкспресс;
			КонецЕсли;
		ИначеЕсли строкаДок.КодСхемыКредитования = 9 Тогда
			ОПЗ.СхемаКредитования = СхемаКлассика;
		КонецЕсли;	
		
		СсылкаНаЛомбард     = ВернутьЛомбардПоID(строкаДок.id_Ломбарда); 
		
		Если СсылкаНаЛомбард = Неопределено Тогда
			РеквизитыЛомбардаИзLX = ВернутьРеквизитыЛомбардаИзLX(строкаДок.id_Ломбарда);
			Ломб = Справочники.ЛБ_Ломбарды.СоздатьЭлемент();
			Ломб.Наименование 		= РеквизитыЛомбардаИзLX.Наименование;
			Ломб.НомерЛомбарда 		= РеквизитыЛомбардаИзLX.Номер;
			Ломб.НаименованиеПолное = Ломб.Наименование;
			Ломб.id_LX 				= строкаДок.id_Ломбарда; 
			Ломб.Подразделение 		= ВременноеПодразделение;
			Ломб.Записать();
			СсылкаНаЛомбард = Ломб.Ссылка;
		КонецЕсли;			
		
		РеквизитыКлиента = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, "Kodclient = '" + строкаДок.id_Клиента + "'", НеГрузитьАдреса);
		
		Если ЗначениеЗаполнено(РеквизитыКлиента[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыКлиента[0].Фамилия) или ЗначениеЗаполнено(РеквизитыКлиента[0].Имя) или ЗначениеЗаполнено(РеквизитыКлиента[0].Отчество)) Тогда 
			Парамс = Новый Структура;
			Парамс.Вставить("Данные", 			РеквизитыКлиента[0]); 
			Парамс.Вставить("тзСтран", 			тзСтран);
			Парамс.Вставить("АдоСоединение", 	АдоСоединение);
			Парамс.Вставить("СтатусКлиента", 	"");
			Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
			Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
			Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ); 
			Парамс.Вставить("ПерезаписыватьКлиентов", 	ПерезаписыватьКлиентов);
			
			
			
