Процедура ЗагрузитьИзъятиеЗаймов(НачДата, КонДата, Ломбард) Экспорт 
	
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	pndoc = "";
	Если Не ЗначениеЗаполнено(Ломбард) Тогда
		plat = "";
	Иначе
		plat = Ломбард;
	КонецЕсли; 
	
	db="'" + НачДата + "'";
	de="'" + КонДата + "'";
	
	
	ТекстЗапроса = "exec Z1CAxi_iz "+db+","+de+",'"+plat+"'";
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_LX", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Дата", 			Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("НомерЗБ", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Ломбард", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("СуммаТело", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаПроценты", 	Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("ДокументИзъятияНаименование", 	Новый ОписаниеТипов("Строка"));  
	тз.Колонки.Добавить("ДокументИзъятияКемВыдан", 	Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ДокументИзъятияДатаВыдачи", 	Новый ОписаниеТипов("Дата")); 
	тз.Колонки.Добавить("ГосОрганИзъятие", 	Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("ФИОДолжностьСудьи", 	Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("ФИОДолжностьИзъятие", 	Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ИзъятыеПозиции", 	Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Ответственный", 	Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("ДатаПротоколИзъятия", 	Новый ОписаниеТипов("Дата"));
	
	
	
	
	Пока не Выборка.eof() Цикл
		НовСтр = тз.Добавить();  
		НовСтр.Дата         	= Выборка.fields("ddoc").value;
		НовСтр.id_LX           	= СтрЗаменить(Выборка.fields("nrec").value, Символы.НПП, "");  
		НовСтр.НомерЗБ         	= Выборка.fields("nom").value; 
		НовСтр.СуммаТело		= ?(Выборка.fields("sm").value=NULL,0,Выборка.fields("sm").value);
		НовСтр.СуммаПроценты    = ?(Выборка.fields("smp").value=NULL,0,Выборка.fields("smp").value); 
		
		НовСтр.ДокументИзъятияНаименование  = Выборка.fields("Документ").value;
		НовСтр.ДокументИзъятияКемВыдан      = Выборка.fields("Кем выдан").value; 
		ДатаВыдачиДок                       = СтроковыеФункцииКлиентСервер.СтрокаВДату(Выборка.fields("Дата выдачи").value);
		НовСтр.ДокументИзъятияДатаВыдачи    = ДатаВыдачиДок;
		НовСтр.ГосОрганИзъятие         		= Выборка.fields("Наим ГосОргана").value;
		НовСтр.ФИОДолжностьСудьи         	= Выборка.fields("ФИО судьи").value;
		НовСтр.ФИОДолжностьИзъятие         	= Выборка.fields("Фио долж лица").value;
		НовСтр.ИзъятыеПозиции         		= Выборка.fields("Изъятые позиции").value; 
		НовСтр.Ответственный         		= Выборка.fields("Ответственный сотрудник").value;
