	//	Возврат Неопределено;
	//Иначе
	//	Возврат Найд;
	//КонецЕсли;
	
	Возврат Неопределено;	
КонецФункции

Процедура СоздатьКарточкуЗалогодателя(Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАдреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ) 
	АдоСоединениеdCBDL = АдоНовоеСоединение("dCBDL");
	
	Парамс = Новый Структура;
	Парамс.Вставить("АдоСоединение", 		АдоСоединениеdCBDL);
	Парамс.Вставить("ФИО", 			 		СокрЛП(Ссылка.Наименование));
	Парамс.Вставить("ДатаРожденияСтрокой", 	Формат(Ссылка.ДатаРождения, "ДФ=yyyyMMdd"));
	Парамс.Вставить("тзСтран", 				тзСтран);  	  
	Парамс.Вставить("id", 					Данные.id_LX);  	
	
	
	мДокументы = ВернутьДокументыКлиента(Парамс);
	
	промДокументы = мДокументы.Скопировать();
	промДокументы.Свернуть("ВидДокумента, ДокументСерия, ДокументНомер, ДокументДатаВыдачи"); 
	
	
	РеквизитыАнкеты = ВернутьДанныеАнкетыКлиента(АдоСоединениеdCBDL, Данные.id_LX);
	
	ПоследнийДок = Неопределено;
	ЭтоПервыйДок = Истина;
	Для каждого стрПромДокументы из промДокументы Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("ВидДокумента", стрПромДокументы.ВидДокумента); 
		Отбор.Вставить("ДокументСерия", стрПромДокументы.ДокументСерия);
		Отбор.Вставить("ДокументНомер", стрПромДокументы.ДокументНомер);
		Отбор.Вставить("ДокументДатаВыдачи", стрПромДокументы.ДокументДатаВыдачи); 	
		
		НайденныеДоки = мДокументы.НайтиСтроки(Отбор);
		//	НайденныеДоки.Сортировать("ДатаСортировки");
		
		стрДокументы = НайденныеДоки[0];
		
		Карточка_КЛ = ВернутьКарточкуПоIDДокумента(стрДокументы.КодЭликсДокумента);
		Если Карточка_КЛ = Неопределено Тогда	
			Док = Документы.ЛБ_КарточкаЗалогодателя.СоздатьДокумент();
		Иначе
			Док = Карточка_КЛ.ПолучитьОбъект();
		КонецЕсли;
		Док.id_LX               = стрДокументы.КодЭликсДокумента; 
		Док.Залогодатель 		= Ссылка;   
		
		Если НеГрузитьАдреса Тогда    
			ИсключаяСвойства = "id_LX, АдресПоПрописке, АдресПоПропискеLX, АдресПоПропискеСтруктура,ФактическийАдрес,ФактическийАдресLX,ФактическийАдресСтруктура,ПочтовыйАдрес,ПочтовыйАдресLX,ПочтовыйАдресСтруктура";
		Иначе    
			ИсключаяСвойства = "id_LX";
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Док, Данные,,ИсключаяСвойства); 
		
		Если ЗначениеЗаполнено(стрДокументы.ДокументДатаРегистрацииLX) Тогда 
			Если НачалоДня(стрДокументы.ДокументДатаРегистрацииLX) = стрДокументы.ДокументДатаРегистрацииLX Тогда  
				Док.Дата = НачалоДня(стрДокументы.ДокументДатаРегистрацииLX)-1;
			Иначе
				Док.Дата     		= стрДокументы.ДокументДатаРегистрацииLX;
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеЗаполнено(стрДокументы.ДокументДатаВыдачи) Тогда
				Продолжить;
			КонецЕсли;
			Док.Дата 			= стрДокументы.ДокументДатаВыдачи;
		КонецЕсли;
		Если Док.Дата >= Дата(2050,01,01) Тогда
			Док.Дата = Дата(2020,01,01);		
		КонецЕсли;
		Док.ДатаРождения 		= Данные.ДатаРождения;
		Док.Фамилия  			= Данные.Фамилия;
		Док.Имя      			= Данные.Имя;
		Док.Отчество 			= Данные.Отчество;    	
		Док.ПричинаИзменения 	= Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ЗагрузкаИзДругойБазы; 
		Док.Ответственный 		= Пользователи.ТекущийПользователь();
		Док.ИзмененияКИ 		= "Загружен из Эликс";  
		//Док.ПричинаИзмененияФИО = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ЗагрузкаИзДругойБазы; 
		Док.ИзмененияАнкета     =  Истина; 
		Док.ИсточникПроисхожденияИмуществаИной       = ""; 
		Док.ИсточникПроисхожденияДенежныхСредствИной = "";
		Если РеквизитыАнкеты.ДеловаяРепутация = "Положительная" Тогда
			Док.ДеловаяРепутацияПоложительная = Истина;
		ИначеЕсли РеквизитыАнкеты.ДеловаяРепутация = "Негативная" Тогда
			Док.ДеловаяРепутацияПоложительная = Ложь;
		КонецЕсли; 
		
		Если СокрЛП(РеквизитыАнкеты.ФинансовоеПоложение) = "1" Тогда
			Док.ФинансовоеПоложениеСтабильное = Истина;
		Иначе
			Док.ФинансовоеПоложениеСтабильное = Ложь;
		КонецЕсли;
		Док.Комментарий = РеквизитыАнкеты.Примечание;	
		
		Если ЗначениеЗаполнено(РеквизитыАнкеты.ИсточникПроисхожденияИмущества) Тогда
			Источн = Справочники.ЛБ_ИсточникиПроисхожденияИмущества.НайтиПоНаименованию(РеквизитыАнкеты.ИсточникПроисхожденияИмущества, Истина);
			Если Источн = Справочники.ЛБ_ИсточникиПроисхожденияИмущества.ПустаяСсылка() Тогда
