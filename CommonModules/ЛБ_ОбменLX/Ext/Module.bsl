Процедура ЗагрузитьВыдачуОтветхранения(НачДата, КонДата, nObj, ПерезаписыватьКлиентов) Экспорт
	АдоСоединение = АдоНовоеСоединение("dCBDL");
	
	ТекстЗапроса = "select o.nreczb, o.NRecZB_Oper, o.doper, z.nomer, c0.KodClient, dzb.NRecClientDoc,1, dzb.NRecDovZB, buser.fio
	|from azb_oper o
	|inner join azb z on o.NRecZB =z.NRecZB 
	|inner join aclient c on z.KodClient =c.KodClient 
	|left join (aDovZB dzb inner join aclient c0  on dzb.KodClient =c0.KodClient)  on dzb.NRecZB =z.NRecZB 
	|left join buser on o.KodUser =buser.KodUser  
	|where StatTo =50 and StatFrom =65 and xOtmena =0 and c.fiof<>o.FioDS and o.fiods=c0.fiof and doper >= '" + НачДата +"' and doper <= '" +КонДата+"'
	|union
	|select o.nreczb, o.NRecZB_Oper, o.doper, z.nomer, c.KodClient, cd.NRecClientDoc,0, null, buser.fio
	|from azb_oper o
	|inner join azb z on o.NRecZB =z.NRecZB 
	|left join buser on o.KodUser =buser.KodUser  
	|inner join (aclient c inner join aClientDoc cd on c.KodClient =cd.KodClient and cd.xv=1 inner join ssdocvid on ssdocvid.KodDocVid= cd.KodDocVid and ssdocvid.vz=1 ) 
	|on o.FioDS =c.fiof and z.nObj =c.nObj and z.KodClient =c.KodClient 
	|where statfrom=65 and statto = 50 and xOtmena =0 and doper >= '" + НачДата +"' and doper <= '" +КонДата+"'";
	//Если nObj <> Неопределено Тогда
	//	ТекстЗапроса = ТекстЗапроса + " and o.nobj = '"+СокрЛП(nObj)+"'";
	//КонецЕсли;
	
	
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);   
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("NRecZB", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("NRecZB_Oper", 		Новый ОписаниеТипов("Строка"));  
	тз.Колонки.Добавить("Дата", 			Новый ОписаниеТипов("Дата")); 
	тз.Колонки.Добавить("НомерБилета", 		Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("КомуВыдано", 		Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("id_Документа", 	); 
	тз.Колонки.Добавить("id_Доверенности", 	Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("Ответственный", 	Новый ОписаниеТипов("Строка"));
	
	
	
	
	Пока не Выборка.eof() Цикл
		НовСтр = тз.Добавить();      
		НовСтр.Дата      		= Выборка.fields("DOper").value;
		НовСтр.NRecZB         	= СтрЗаменить(Выборка.fields("NRecZB").value, Символы.НПП, ""); 
		НовСтр.NRecZB_Oper      = СтрЗаменить(Выборка.fields("NRecZB_Oper").value, Символы.НПП, ""); 
		НовСтр.НомерБилета      = Выборка.fields("Nomer").value; 
		НовСтр.КомуВыдано       = СтрЗаменить(Выборка.fields("kodClient").value, Символы.НПП, ""); 
		НовСтр.id_Документа     = Выборка.fields("NRecClientDoc").value; 
		НовСтр.id_Доверенности  = СтрЗаменить(Выборка.fields("NRecDovZB").value, Символы.НПП, "");
		НовСтр.Ответственный    = Выборка.fields("fio").value;
		
		
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	тзСтран = ВернутьТЗСтран();
	тзЧерныеСтатусыКлиентов = ВернутьКлиентовСЧернойМеткой(); 
	
	тзПервыхДатЗБ = ВернутьТаблицуПервыхДатЗБ();
	
	
	
	ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога;
	Для каждого стр из тз Цикл		
		
		НомерБилета =  стр.НомерБилета; 
		

		
		ОперацияВыдачи = ВернутьОперациюПоЗалогуПо_ЗБ(НомерБилета);
		Если ОперацияВыдачи = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		НайдДок = ВернутьОперациюПоЗалогуПо_id(стр.NRecZB_Oper, ВидОперации);
		Если НайдДок = Неопределено Тогда
			ОПЗ = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент();
		Иначе
			ОПЗ = НайдДок.ПолучитьОбъект(); 
			ОПЗ.Товары.Очистить();  
			ОПЗ.Вставки.Очистить();
			ОПЗ.ТоварыВыкупленные.Очистить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОПЗ, ОперацияВыдачи,,"Номер,Дата"); 
		
		ОПЗ.id_LX 		= стр.NRecZB_Oper; 
		ОПЗ.Дата		= стр.Дата;
		
		ОПЗ.ВыдачаЗалога = Истина;

		
		ОПЗ.ВидОперации = ВидОперации;
		ОПЗ.НомерЗалоговогоБилета = НомерБилета; 
		Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
			НовСтрТовары = ОПЗ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
		КонецЦикла;
		Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
			НовСтрТовары = ОПЗ.ТоварыВыкупленные.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
		КонецЦикла; 
		Для каждого строчВставки из ОперацияВыдачи.Вставки Цикл
			НовСтрВставки = ОПЗ.Вставки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрВставки, строчВставки);
		КонецЦикла; 
		
		НеГрузитьАдреса = Истина;
		
		РеквизитыКлиента = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, "Kodclient = '" + стр.КомуВыдано + "'", НеГрузитьАдреса);
		
		Если ЗначениеЗаполнено(РеквизитыКлиента[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыКлиента[0].Фамилия) или ЗначениеЗаполнено(РеквизитыКлиента[0].Имя) или ЗначениеЗаполнено(РеквизитыКлиента[0].Отчество)) Тогда 
			Парамс = Новый Структура;
			Парамс.Вставить("Данные", 			РеквизитыКлиента[0]); 
			Парамс.Вставить("тзСтран", 			тзСтран);
			Парамс.Вставить("АдоСоединение", 	АдоСоединение);
			Парамс.Вставить("СтатусКлиента", 	"");
			Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
			Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
			Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ); 
			Парамс.Вставить("ПерезаписыватьКлиентов", 	ПерезаписыватьКлиентов);
			
			
			
			ОПЗ.Залогодатель 	= НайтиСоздатьЗалогодателя(Парамс);
			ОПЗ.Фамилия 		= ОПЗ.Залогодатель.Фамилия;
			ОПЗ.Имя 			= ОПЗ.Залогодатель.Имя; 
			ОПЗ.Отчество 		= ОПЗ.Залогодатель.Отчество; 
			
			тзКонтИнфо = ВернутьКонтактнуюИнформациюЗалогодателя(стр.Дата+1, ОПЗ.Залогодатель);
			Если тзКонтИнфо.Количество() > 0 Тогда   
				ЗаполнитьЗначенияСвойств(ОПЗ, тзКонтИнфо[0]);
			КонецЕсли;			
		КонецЕсли;
		
		СсылкаДокументаКлиента = НайтиДокументЗалогодателя(стр.id_Документа, "0",ТекущаяДата(), ОПЗ.Залогодатель);
		
		ОПЗ.ДокументЗалогодателя = СсылкаДокументаКлиента;
		
		
		
		//ОПЗ.Ответственный = ВернутьСоздатьПользователя(стр.Ответственный);
		
		
		
		тзДовер = ВернутьДоверенностиИзLX(стр.NRecZB);
		Для каждого стрДовер из тзДовер Цикл 

			
			НайдДовер = ВернутьДоверенностьПо_id(СокрЛП(стрДовер.id_LX));
			Если НайдДовер = Неопределено Тогда
				ДокДоверенность = Документы.ЛБ_Доверенности.СоздатьДокумент();
			Иначе
				ДокДоверенность = НайдДовер.ПолучитьОбъект();
			КонецЕсли; 
			
			Если стрДовер.Тип = 4 Тогда
				ДокДоверенность.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.Письменная;
			Иначе  
				ДокДоверенность.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.Нотариальная; 
			КонецЕсли;		
			
			ДокДоверенность.ЗалоговыйБилет = ОПЗ.Ссылка;
			ДокДоверенность.Клиент         = ОПЗ.Залогодатель;
			ДокДоверенность.ДокументКлиента= ОПЗ.ДокументЗалогодателя;
			ДокДоверенность.id_LX          = стрДовер.id_LX;
			ДокДоверенность.Ломбард        = ВернутьЛомбардПоID(стрДовер.id_ломбарда); 
			ДокДоверенность.НомерДоверенности = стрДовер.Номер;
			ДокДоверенность.Дата 		   = стрДовер.Дата;   
			ДокДоверенность.ДатаДоверенности 		 = стрДовер.ДатаНачала;
			ДокДоверенность.СрокДействияДоверенности = стрДовер.ДатаОкончания; 
			//Если стрДовер.Статус = 1 Тогда
			ДокДоверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление;
			//КонецЕсли; 
			
			РеквизитыПредставителя = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, "KodClient = '" + стрДовер.id_представителя + "'", НеГрузитьАдреса);
			
			Если ЗначениеЗаполнено(РеквизитыПредставителя[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыПредставителя[0].Фамилия) или ЗначениеЗаполнено(РеквизитыПредставителя[0].Имя) или ЗначениеЗаполнено(РеквизитыПредставителя[0].Отчество)) Тогда
				
				Парамс = Новый Структура;
				Парамс.Вставить("Данные", 			РеквизитыПредставителя[0]); 
				Парамс.Вставить("тзСтран", 			тзСтран);
				Парамс.Вставить("АдоСоединение", 	АдоСоединение);
				Парамс.Вставить("СтатусКлиента", 	"");
				Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
				Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
				Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ);
				
				ДокДоверенность.ПредставительКлиента 	= НайтиСоздатьЗалогодателя(Парамс);
			КонецЕсли;
			
			ДокДоверенность.ДокументПредставителяКлиента = НайтиДокументЗалогодателя(стрДовер.id_ДокПредставителя, "", "", ДокДоверенность.ПредставительКлиента);
			
			
			ДокДоверенность.Записать(РежимЗаписиДокумента.Запись);
			ДокДоверенность.Записать(РежимЗаписиДокумента.Проведение); 
		КонецЦикла;
		
		
		Если ЗначениеЗаполнено(стр.id_Доверенности) Тогда
			ОПЗ.ДоверенностьПредставителя = ВернутьДоверенностьПо_id(СокрЛП(стр.id_Доверенности));
		КонецЕсли;			
		
		
		ОПЗ.ПредыдущаяОперация  = НайтиПредыдущуюОперацию(ОПЗ.НомерЗалоговогоБилета);	
		ОПЗ.Записать(РежимЗаписиДокумента.Запись);
		ОПЗ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	
	АдоСоединение.Close();	
КонецПроцедуры

Функция ВернутьКлиентовСЧернойМеткой() Экспорт
	
	АдоСоединение = АдоНовоеСоединение("dCBDL"); 
	
	ТекстЗапроса = "select x.KodClient, DPri, a.IDCd, y.NmKodB
	|from(
	|select kodclient, MIN(DPri) DPri from [dCBDL_dan].[dbo].[azb] a
	|group by kodclient
	|)x
	|join [dCBDL_dan].[dbo].[aClient] a on x.KodClient = a.KodClient 
	|join 
	|   (
	|	select rtrim(FIO) + ' ' + isnull(CONVERT([varchar], [DataR], 103), '') IDCd, ss.NmKodB
	|		from dCBDL_dan.dbo.ssBlackList (nolock) s
	|			 join [dCBDL_dan].[dbo].[ssKodBlack] ss on s.KodBlack = ss.KodBlack
	|	where s.xDel = 0 and 
	|	   s.KodBlack in(2, 14)
	|)y on a.IDCd = y.IDCd"; 
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса) ; 
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_Клиента");
	тз.Колонки.Добавить("Метка");
	
	
	Пока не Выборка.eof() Цикл    
		НовСтр = тз.Добавить();
		НовСтр.id_Клиента = СтрЗаменить(Выборка.fields("kodclient").value, Символы.НПП, "");
		НовСтр.Метка = Выборка.fields("NmKodB").value;
		
		Выборка.movenext();
	КонецЦикла;
	
	Возврат тз;	
	
КонецФункции



