				НовСтрочка.Статус = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СлужебныйСтатус_Недобросовестный");
			ИначеЕсли НайденнаяСтрокаЧМ.Метка = "Отказ в обслуживании" Тогда
