		Док.id_LX               = стрДокументы.КодЭликсДокумента; 
		Док.Залогодатель 		= Ссылка;   
		
		Если НеГрузитьАдреса Тогда    
			ИсключаяСвойства = "id_LX, АдресПоПрописке, АдресПоПропискеLX, АдресПоПропискеСтруктура,ФактическийАдрес,ФактическийАдресLX,ФактическийАдресСтруктура,ПочтовыйАдрес,ПочтовыйАдресLX,ПочтовыйАдресСтруктура";
		Иначе    
