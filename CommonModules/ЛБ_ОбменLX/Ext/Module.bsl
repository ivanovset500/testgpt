Функция ВКакомЛомбарде(Номенклатура, датаДок)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаОстатки.Склад КАК Склад,
	               |	ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               //|	ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиНачальнаяОстаток КАК СуммаОценкиНачальнаяОстаток,
				   |	ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток КАК СуммаОценкиНачальнаяОстаток,
	               |	ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток КАК СуммаОценкиОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&НаДату, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_ОбъектыЗалогаОстатки";
	Запрос.УстановитьПараметр("НаДату", ДатаДок - 1);
	Запрос.УстановитьПараметр("ОбъектЗалога", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Ломбард, Склад, СуммаОценкиНачальная, СуммаОценки", Выборка.Ломбард, Выборка.Склад, Выборка.СуммаОценкиНачальнаяОстаток, Выборка.СуммаОценкиОстаток);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура СоздатьПеремещениеОбъектаЗалога(стр)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПеремещениеОбъектовЗалога.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЛБ_ПеремещениеОбъектовЗалога КАК ЛБ_ПеремещениеОбъектовЗалога
	               |ГДЕ
	               |	ЛБ_ПеремещениеОбъектовЗалога.Комментарий ПОДОБНО &Комментарий";
	Запрос.УстановитьПараметр("Комментарий", СокрЛП(стр.ЗБ_Артикул));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		//
		
	Иначе
		НовДок = Документы.ЛБ_ПеремещениеОбъектовЗалога.СоздатьДокумент();   
		
		
		НовДок.ЗагруженИЗLX = Истина;
		НовДок.Дата = стр.ДатаДок + 3600;
        		
		НовДок.Организация = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация"); 
		НовДок.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;

		
		НовДок.Комментарий = СокрЛП(стр.ЗБ_Артикул);
		СтруктОстаток = ВКакомЛомбарде(Стр.Номенклатура, стр.ДатаДок);
		Если СтруктОстаток <> Неопределено Тогда
			НовДок.ЛомбардОткуда    = СтруктОстаток.Ломбард; 
			НовДок.СкладОтправитель = СтруктОстаток.Склад;
		КонецЕсли; 
		
		ЛомбардКуда  = ВернутьЛомбардПоID(стр.id_Ломбарда); 
		Если ЛомбардКуда = Неопределено Тогда
			Сообщить("НЕ найден ломбард с id "+СокрЛП(стр.id_Ломбарда));
			Возврат;
		КонецЕсли;
		
		НовДок.ЛомбардКуда   = ЛомбардКуда; 
		Если НовДок.ЛомбардКуда <> Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
			НовДок.СкладПолучатель =  НайтиСкладВитринуЛомбарда(НовДок.ЛомбардКуда);
		КонецЕсли;
		
		//Если НовДок.ЛомбардОткуда = НовДок.ЛомбардКуда Тогда
			НовДок.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВнутриПодразделения;
		//Иначе
		//	НовДок.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение;
		//КонецЕсли;	
		
		НовСтрока = НовДок.Товары.Добавить();
		НовСтрока.ЗалоговыйБилет = ВернутьОперациюПоЗалогуПо_ЗБ(стр.НомерЗБ);
		НовСтрока.ОбъектЗалога = стр.Номенклатура;
		НовСтрока.Количество = 1;   
		Если СтруктОстаток <> Неопределено Тогда
		НовСТрока.СуммаОценки = СтруктОстаток.СуммаОценки;
		КонецЕсли;
		
		Попытка
			НовДок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение 
			НовДок.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;	
	КонецЕсли;	
КонецПроцедуры

Функция ВернутьПокупателяЗалогодателя(КодКлиента)  
	АдоСоединение = АдоНовоеСоединение("dCBDL_dan");
	ТекстЗапроса = "SELECT *  FROM [dCBDL_dan].[dbo].[aClientP] where kodclient = '"+КодКлиента+"'";  
	
	Фамилия  = "";
	Имя      = "";
	Отчество = ""; 
	ДатаРождения    = Дата(01,01,01);
	
	
	rt = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);  
	Пока не rt.eof() цикл  			
		Если НЕ rt.eof() Тогда
			
			Фамилия      = rt.fields("Fam").value;
			Имя			 = rt.fields("Name").value;
			Отчество     = rt.fields("Patr").value; 
			ДатаРождения = rt.fields("DataR").value;   

			
			rt.movenext();
			
		Если rt.eof() тогда
			Прервать;
		КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	АдоСоединение.Close(); 
	
	Если ЗначениеЗаполнено(Фамилия) Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_Залогодатели.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
		               |ГДЕ
		               |	ЛБ_Залогодатели.Фамилия = &Фамилия
		               |	И ЛБ_Залогодатели.Имя = &Имя
		               |	И ЛБ_Залогодатели.Отчество = &Отчество
		               |	И ЛБ_Залогодатели.ДатаРождения = &ДатаРождения";
		Запрос.УстановитьПараметр("Фамилия", Фамилия);   
		Запрос.УстановитьПараметр("Имя", Имя);
		Запрос.УстановитьПараметр("Отчество", Отчество); 
		Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
		
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
		СтрокаОтбора = " fam = '"+Фамилия+"' and name = '"+Имя+"' and Patr = '"+Отчество+"' and DataR = '"+Формат(ДатаРождения, "ДФ=dd.MM.yyyy")+"'";	
		НеГрузитьАдреса = Истина;   
		
		тзСтран = ВернутьТЗСтран(); 
		
		АдоСоединение = АдоНовоеСоединение("dcbdl_uni");

		РеквизитыПлательщика = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, СтрокаОтбора, НеГрузитьАдреса); 
		Если РеквизитыПлательщика = неопределено Тогда  
			
			АдоСоединение2 = АдоНовоеСоединение("dCBDL_dan");

			РеквизитыПлательщика = ВернутьРеквизитыПокупателяРеализацииИзLX(АдоСоединение2, тзСтран, СтрокаОтбора, НеГрузитьАдреса); 
			
			Если ЗначениеЗаполнено(РеквизитыПлательщика[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыПлательщика[0].Фамилия) или ЗначениеЗаполнено(РеквизитыПлательщика[0].Имя) или ЗначениеЗаполнено(РеквизитыПлательщика[0].Отчество)) Тогда
				
				тзЧерныеСтатусыКлиентов = ВернутьКлиентовСЧернойМеткой(); 
				тзПервыхДатЗБ = ВернутьТаблицуПервыхДатЗБ();
				
				Парамс = Новый Структура;
				Парамс.Вставить("Данные", 			РеквизитыПлательщика[0]); 
				Парамс.Вставить("тзСтран", 			тзСтран);
				Парамс.Вставить("АдоСоединение", 	АдоСоединение);
				Парамс.Вставить("СтатусКлиента", 	"");
				Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
				Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
				Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ);
				
				
				
				Залогодатель 	= НайтиСоздатьЗалогодателяПокупателя(Парамс);

				Возврат Залогодатель;
			КонецЕсли; 
	
			
			
		Иначе
			
			Если ЗначениеЗаполнено(РеквизитыПлательщика[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыПлательщика[0].Фамилия) или ЗначениеЗаполнено(РеквизитыПлательщика[0].Имя) или ЗначениеЗаполнено(РеквизитыПлательщика[0].Отчество)) Тогда
				
				тзЧерныеСтатусыКлиентов = ВернутьКлиентовСЧернойМеткой(); 
				тзПервыхДатЗБ = ВернутьТаблицуПервыхДатЗБ();
				
				Парамс = Новый Структура;
				Парамс.Вставить("Данные", 			РеквизитыПлательщика[0]); 
				Парамс.Вставить("тзСтран", 			тзСтран);
				Парамс.Вставить("АдоСоединение", 	АдоСоединение);
				Парамс.Вставить("СтатусКлиента", 	"");
				Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
				Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
				Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ);
				
				
				Залогодатель 	= НайтиСоздатьЗалогодателя(Парамс);
				Возврат Залогодатель;
			КонецЕсли; 
		КонецЕсли;	
		
		
		
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Процедура ЗагрузитьРеализации(НачДата, КонДата) Экспорт
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	db="'" + НачДата + "'";
	de="'" + КонДата + "'";
	
	ТекстЗапроса = "exec Z1CAxi_Real_auto "+ db + "," + de ;
	
	rt = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);

	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("Идентификатор");
	тз.Колонки.Добавить("ДатаДок");
	тз.Колонки.Добавить("НомерФактуры");
	тз.Колонки.Добавить("ЗБ_Артикул");
	тз.Колонки.Добавить("НомерЛомбарда");
	тз.Колонки.Добавить("id_Ломбарда");
	тз.Колонки.Добавить("НомерБСО"); 
	тз.Колонки.Добавить("НомерЗБ");
	тз.Колонки.Добавить("Договор");
	тз.Колонки.Добавить("Инн");
	тз.Колонки.Добавить("Номенклатура");   
	тз.Колонки.Добавить("НаименованиеДоговора"); 
	тз.Колонки.Добавить("ПризнакНалБезнал");
	тз.Колонки.Добавить("НаименованиеПокупателяИмущества"); 
	тз.Колонки.Добавить("СтоимостьРеализации", Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Ответственный");
	тз.Колонки.Добавить("КодРозничногоКлиента");

	
		        	
	НомПП = 0;
	Пока не rt.eof() цикл  			
		Если НЕ rt.eof() Тогда 
			
			ЗБ_Артикул      = rt.fields("Art").value;
			ПозСлэша 		= СтрНайти(ЗБ_Артикул,"/");
			ПозТире 		= СтрНайти(ЗБ_Артикул,"-");
			НомерЛомбарда 	= Лев(ЗБ_Артикул,ПозСлэша-1);				
			НомерБСО 		= Сред(ЗБ_Артикул, ПозСлэша+1,ПозТире-ПозСлэша-1);
			ОбъектЗалога    = Сред(ЗБ_Артикул, ПозСлэша+1);
			
			
			Попытка  
				NFAk = rt.fields("NFak").value;
				НомерФактуры       		= Число(Лев(rt.fields("NFak").value,СтрДлина(NFAk)));
				ОшибкаСФ                = Ложь;                 
			Исключение
				НомерФактуры       		= rt.fields("NFak").value;
				ОшибкаСФ                = Истина;
			КонецПопытки;	
			
			НовСтр = тз.Добавить();
			НовСтр.Идентификатор 			= rt.fields("nRec").value;
			НовСтр.ДатаДок       			= rt.fields("DOtg").value;  
			НовСтр.НомерФактуры       		= НомерФактуры;
			НовСтр.ЗБ_Артикул    			= ЗБ_Артикул;   
			НовСтр.НомерЛомбарда  			= НомерЛомбарда;
			НовСтр.id_Ломбарда  			= rt.fields("nobjv").value; 
			НовСтр.НомерБСО       			= НомерБСО;
			НовСтр.НомерЗБ       			= НомерБСО;
			НовСтр.СтоимостьРеализации  	= rt.fields("SuPoz").value;   			
			НовСтр.Инн  					= rt.fields("inncontr").value;
			НовСтр.НаименованиеДоговора  	= rt.fields("Dog").value; 
			НовСтр.ПризнакНалБезнал  		= rt.fields("NDog").value;         
			НовСтр.Номенклатура             = НайтиНоменклатуруПоАртикулу(ОбъектЗалога); 
			НовСтр.Ответственный            = rt.fields("wpri").value;
			НовСтр.КодРозничногоКлиента     = rt.fields("KodClient").value;
				
			rt.movenext();
			
			Если rt.eof() тогда
				Прервать;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
		
	АдоСоединение.Close(); 
	
	Для каждого стр из тз Цикл
		СоздатьПеремещениеОбъектаЗалога(стр);		
	КонецЦикла;
	
	тзДокументы = тз.Скопировать();
	тзДокументы.Свернуть("Идентификатор, Инн, НомерФактуры, ДатаДок, Ответственный, КодРозничногоКлиента");
	
	тзЛомбарды = тз.Скопировать();
	//тзЛомбарды.Свернуть("Идентификатор, НомерФактуры, ДатаДок, НомерЛомбарда, id_ломбарда"); 
	тзЛомбарды.Свернуть("Идентификатор, НомерФактуры, ДатаДок, id_ломбарда, Ответственный, КодРозничногоКлиента"); 
	
	Организация 	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");	
	
	НомВрем = 0;     
	Для каждого СтрокаДокументов из тзДокументы Цикл 		
		ДатаДок = СтрокаДокументов.ДатаДок;
		
		Отбор1 = Новый Структура;
		Отбор1.Вставить("Идентификатор", СтрокаДокументов.Идентификатор);
		
		СтрокиЛомбардов = тзЛомбарды.НайтиСтроки(Отбор1);
		
		//НомВрем = 0;
		НаименованиеПокупателяИмущества = "";
		Для каждого СтрокаЛомбарда из СтрокиЛомбардов Цикл  			
			Ломбард = ВернутьЛомбардПоID(СтрокаЛомбарда.id_ломбарда); 
			
			Если Ломбард = Неопределено Тогда
			Сообщить("НЕ найден ломбард с id "+СокрЛП(стр.id_Ломбарда));
			Возврат;
			КонецЕсли;
		    	
			
			ДокПоиск = ВернутьДокументРеализацииИмущества(Ломбард, ДатаДок, СтрокаЛомбарда.НомерФактуры);
			Если ДокПоиск = неопределено Тогда
				ОбДок = Документы.ЛБ_Реализация.СоздатьДокумент();
			Иначе
				ОбДок = ДокПоиск.ПолучитьОбъект();
			КонецЕсли; 	
			
			Отбор = Новый Структура;
			//Отбор.Вставить("НомерЛомбарда", СтрокаЛомбарда.НомерЛомбарда); 
			Отбор.Вставить("Идентификатор", СтрокаДокументов.Идентификатор);
			
			НайдСтроки 				= тз.НайтиСтроки(Отбор); 	
			ИНН 					= НайдСтроки[0].ИНН;
			НаименованиеДоговора 	= НайдСтроки[0].НаименованиеДоговора;
			ПризнакНалБезнал 		= НайдСтроки[0].ПризнакНалБезнал;
			
			
			НомВрем = НомВрем + 3;
			ОбДок.Дата = ДатаДок + 3600 + НомВрем;
			ОбДок.ПометкаУдаления = Ложь;
			
			ПокупательЗалога                = НайтиПокупателяЗалога(ИНН);
	
			ОбДок.Организация				= Организация; 
			ОбДок.ВидОперации 				= Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт;
			ОбДок.Ломбард				    = Ломбард;   
			
			ОбДок.СпособОплаты              = Перечисления.ЛБ_СпособыОплаты.НаличныйРасчет;  
			
			ОбДок.ОтветственныйСотрудник    = ВернутьСотрудника(СтрокаДокументов.Ответственный);
			
			Если СтрокаЛомбарда.id_Ломбарда = 1001 Тогда
				ОбДок.Склад 				= Справочники.ЛБ_Склады.НайтиПоНаименованию("Витрина ЦО"); 
				Если ПокупательЗалога = Справочники._ДемоКонтрагенты.РозничныйПокупатель Тогда
					ОбДок.ВидОперации 				= Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница;	
				КонецЕсли; 
			ИначеЕсли СтрокаЛомбарда.id_Ломбарда = 1000 Тогда
				ОбДок.Склад 				= Справочники.ЛБ_Склады.НайтиПоНаименованию("Общий склад ЦО");  
				ОбДок.ВидОперации 		    = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт;   
				ОбДок.СпособОплаты          = Перечисления.ЛБ_СпособыОплаты.РасчетныйСчет;
			Иначе
				ОбДок.Склад 				= НайтиСкладВитринуЛомбарда(Ломбард); 
				ОбДок.ВидОперации           = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард;
			КонецЕсли; 
						
			//ОбДок.Комментарий    			= СтрокаЛомбарда.НомерФактуры; 
			ОбДок.ПредставлениеНомера       = СтрЗаменить(СтрокаЛомбарда.НомерФактуры, Символы.НПП, ""); 
			
			ОбДок.Контрагент 				= ПокупательЗалога; 
			ОбДок.id_LX                     = СтрокаЛомбарда.Идентификатор;  
			
			
			Если ЗначениеЗаполнено(СтрокаЛомбарда.КодРозничногоКлиента) Тогда
				ОбДок.Контрагент = ВернутьПокупателяЗалогодателя(СтрокаЛомбарда.КодРозничногоКлиента);				
			КонецЕсли;
			
	
			ОбДок.Товары.Очистить();
			
			Для каждого Строч из НайдСтроки Цикл
				НовСтроч = ОбДок.Товары.Добавить(); 
				ОперацияПоЗалогу = ВернутьОперациюПоЗалогуПо_ЗБ(Строч.НомерЗБ);
				НовСтроч.ЗалоговыйБилет = ОперацияПоЗалогу; 
				Если ОперацияПоЗалогу <> Неопределено Тогда
					ОбОперацияПоЗалогу = ОперацияПоЗалогу.ПОлучитьОбъект();  
					ОбОперацияПоЗалогу.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				
				НовСтроч.ОбъектЗалога   = Строч.Номенклатура;
				НовСтроч.Количество     = 1;  
				НовСтроч.ФактическаяЦена = строч.СтоимостьРеализации;  
				
				тзОст = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбардаПоНомеруЗБ(ОбДок.Дата-1, ОбДок.Организация, ОбДок.Ломбард, ОбДок.Склад, Строч.НомерЗБ);  
				Если тзОст.Количество() > 0 Тогда
					НовСТроч.СуммаОценки = тзОст[0].СуммаОценки;
				КонецЕсли;
			КонецЦикла;
			
			ОбДок.СуммаПродажи = ОбДок.Товары.Итог("ФактическаяЦена");
			
			Если ОбДок.Товары.Количество() > 0 Тогда
			Попытка 
				ОбДок.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ОбДок.Записать();
			КонецПопытки; 
			КонецЕсли;
					
		КонецЦикла;
	КонецЦикла;	

КонецПроцедуры  

Функция НайтиСкладВитринуЛомбарда(Ломбард)
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Склады.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
	               |ГДЕ
	               |	ЛБ_Склады.Владелец = &Владелец
	               |	И ЛБ_Склады.ВидСклада = &ВидСклада";
	Запрос.УстановитьПараметр("Владелец", Ломбард); 
	Запрос.УстановитьПараметр("ВидСклада", Перечисления.ЛБ_ВидыСкладов.Витрина);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Функция НайтиПокупателяЗалога(ИНН)
	Рез  = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	_ДемоКонтрагенты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник._ДемоКонтрагенты КАК _ДемоКонтрагенты
	               |ГДЕ
	               |	_ДемоКонтрагенты.ИНН = &ИНН";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции


Функция ВернутьДокументРеализацииИмущества(Ломбард, Дата, id_LX)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Реализация.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЛБ_Реализация КАК ЛБ_Реализация
	               |ГДЕ
	               |	ЛБ_Реализация.Дата МЕЖДУ &НачДата И &КонДата
	               |	И ЛБ_Реализация.id_LX = &id_LX
	               |	И ЛБ_Реализация.Ломбард = &Ломбард";
	
	Запрос.УстановитьПараметр("НачДата", НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонДата", КонецДня(Дата));
	Запрос.УстановитьПараметр("Ломбард", Ломбард);   
	
	
	Запрос.УстановитьПараметр("id_LX", СТРЗАМЕНИТЬ(id_LX, символы.НПП, ""));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Выборка.Ссылка;
	Иначе
		Рез = Неопределено;
	КонецЕсли;
	
	Возврат Рез;	
	
КонецФункции


Функция НайтиНоменклатуруПоАртикулу(АртЗалога)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалога.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_ОбъектыЗалога КАК ЛБ_ОбъектыЗалога
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалога.Артикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", АртЗалога);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


Процедура ЗагрузитьВозвратЗаймов(НачДата, КонДата, Ломбард) Экспорт
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	pndoc = "";
	Если Не ЗначениеЗаполнено(Ломбард) Тогда
		plat = "";
	Иначе
		plat = Ломбард;
	КонецЕсли; 
	
	db="'" + НачДата + "'";
	de="'" + КонДата + "'";
	
	ТекстЗапроса = "exec Z1CAxi_opl_Full "+db+","+de+",'"+plat+"'";
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("id_LX", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Дата", 			Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("ДатаВыкупа", 		Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("ДатаРеализации", 	Новый ОписаниеТипов("Дата"));
	тз.Колонки.Добавить("НомерЗБ", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Вес", 				Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("ВесЧистый", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаОценки", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаСсуды", 		Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Цена", 			Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("ТипИзделия", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Металл", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Проба", 			Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("Ставка", 			Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Ломбард", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Категория", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("id_Клиента", 		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Артикул", 			Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("id_Ломбарда", 		Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("id_Ломбарда2", 	Новый ОписаниеТипов("Строка"));  
	тз.Колонки.Добавить("КодСхемыКредитования", Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("КодСтатуса", 		Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("id_Документа",     Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ndoc",     		Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ddoc",     		Новый ОписаниеТипов("Дата")); 
	тз.Колонки.Добавить("СуммаТело", 		Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("СуммаПроценты", 	Новый ОписаниеТипов("Число"));  
	тз.Колонки.Добавить("id_Плательщика", 	Новый ОписаниеТипов("Строка")); 
	тз.Колонки.Добавить("ПСК", 				Новый ОписаниеТипов("Число")); 
	тз.Колонки.Добавить("Статус", 			Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("StatTo", 			Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("Ответственный",    Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ТипОплаты",    	Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ДатаВыдачиЗайма",  Новый ОписаниеТипов("Дата"));

	Пока не Выборка.eof() Цикл
		НовСтр = тз.Добавить();  
		НовСтр.StatTo         	= Выборка.fields("StatTo").value;
		НовСтр.Дата         	= Выборка.fields("Dtpl").value;
		НовСтр.ДатаВыкупа       = Выборка.fields("DVozN").value;
		НовСтр.ДатаРеализации   = Выборка.fields("DlgotN").value; 
		НовСтр.id_LX           	= СтрЗаменить(Выборка.fields("nrec").value, Символы.НПП, ""); 
		//НовСтр.id_Документа    	= СтрЗаменить(Выборка.fields("nrecClientDoc").value, Символы.НПП, "");
		//НовСтр.ndoc         	= Выборка.fields("ndoc").value; 
		//НовСтр.ddoc         	= Выборка.fields("ddoc").value; 
		НовСтр.НомерЗБ         	= Выборка.fields("nomer").value; 
		НовСтр.ПСК         		= Выборка.fields("ProcDay").value; 
		НовСтр.id_Ломбарда      = СтрЗаменить(Выборка.fields("nobj").value, Символы.НПП, "");
		
		НовСтр.id_Клиента       = СтрЗаменить(Выборка.fields("KodClient").value, Символы.НПП, ""); 
		НовСтр.id_Плательщика   = СтрЗаменить(Выборка.fields("cKodClient").value, Символы.НПП, "");
		НовСтр.СуммаТело		= ?(Выборка.fields("sm").value=NULL,0,Выборка.fields("sm").value);
		НовСтр.СуммаПроценты    = ?(Выборка.fields("smp").value=NULL,0,Выборка.fields("smp").value); 
		НовСтр.id_Ломбарда2     = Выборка.fields("nobj_plat2").value;
		НовСтр.Ответственный    = Выборка.fields("FioPr").value;    
		НовСтр.ТипОплаты        = Выборка.fields("tdoc").value;  
		НовСтр.ДатаВыдачиЗайма  = Выборка.fields("dpri").value;
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	АдоСоединение = АдоНовоеСоединение("dlink");
	
	
	Перечисление_Залог 			= Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог;
	Перечисление_ОплатаПроцентов= Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	Организация 				= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
	ЕдиницаИзмерения_гр 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ЕдиницаИзмерения_гр");
	ЕдиницаИзмерения_кар 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ЕдиницаИзмерения_кар");
	ВременноеПодразделение 		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновноеПодразделение");
	СхемаКлассика          		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Классика");
	СхемаЭкспресс          		= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СхемаКредитования_Экспресс");
	
	тзСтран = ВернутьТЗСтран();
	
	тзЧерныеСтатусыКлиентов = ВернутьКлиентовСЧернойМеткой(); 
	
	тзПервыхДатЗБ = ВернутьТаблицуПервыхДатЗБ();
	
	тзДок = тз.Скопировать();
	
	ВидОперации = Перечисление_ОплатаПроцентов;
	Для каждого строкаДок из тзДок Цикл
		Если строкаДок.ДатаВыдачиЗайма < Дата(2020,04,01) Тогда			
			Если ВРЕГ(сокрЛП(строкаДок.ТипОплаты)) = "НАЛ" Тогда
				ЗагрузитьОплатуПоКассеРанееАпреля2020(строкаДок, тзСтран, тзЧерныеСтатусыКлиентов,тзПервыхДатЗБ); 
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		
		НайдДок = ВернутьОперациюПоЗалогуПо_id(строкаДок.id_LX, ВидОперации);
		Если НайдДок = Неопределено Тогда
			ОПЗ = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент();
		Иначе
			ОПЗ = НайдДок.ПолучитьОбъект(); 
			// отменить проведение
			
			ОПЗ.Товары.Очистить();  
			ОПЗ.Вставки.Очистить();
			ОПЗ.ГрафикПлатежей.Очистить(); 
			ОПЗ.ПроцентныеСтавкиПоПериодам.Очистить();
			ОПЗ.НачислениеПроцентовДетально.Очистить(); 
			ОПЗ.ТоварыИзъятыеВозвращенные.Очистить();
			ОПЗ.ТоварыВыкупленные.Очистить(); 
			ОПЗ.ТоварыОтмена.Очистить(); 
			ОПЗ.ТаблицаСостоянийОтмененного.Очистить();			
		КонецЕсли; 
		
		
		
		ОперацияВыдачи = ВернутьОперациюПоЗалогуПо_ЗБ(строкаДок.НомерЗБ);
		Если ОперацияВыдачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОПЗ, ОперацияВыдачи,,"Номер,Дата"); 
		
		ОПЗ.id_LX 		= строкаДок.id_LX; 
		ОПЗ.Дата		= строкаДок.Дата;
		
		Если ВРЕГ(сокрЛП(строкаДок.ТипОплаты)) <> "НАЛ" Тогда
			ОПЗ.БезналичнаяОплата = Истина;
		КонецЕсли;		
		
		
		Если СокрЛП(СтрокаДок.StatTo) = "50" Тогда
			ОПЗ.ВыдачаЗалога = Истина;
			ОПЗ.Выкуп  = Истина; 
			СостЗБ = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(ОПЗ, ОперацияВыдачи); 
			ОПЗ.ДатаВыкупа	       = СостЗБ.ДатаВыкупа;
			ОПЗ.ДатаВыкупаЛьготная = СостЗБ.ДатаВыкупаЛьготныйСрок;
			Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
				НовСтрТовары = ОПЗ.ТоварыВыкупленные.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
			КонецЦикла;     
		ИначеЕсли СокрЛП(СтрокаДок.StatTo) = "65" Тогда
			ОПЗ.ВыдачаЗалога = Ложь;
			ОПЗ.Выкуп  = Истина; 
			СостЗБ = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(ОПЗ, ОперацияВыдачи); 
			ОПЗ.ДатаВыкупа	       = СостЗБ.ДатаВыкупа;
			ОПЗ.ДатаВыкупаЛьготная = СостЗБ.ДатаВыкупаЛьготныйСрок;
			//Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
			//	НовСтрТовары = ОПЗ.ТоварыВыкупленные.Добавить();
			//	ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
			//КонецЦикла; 
		Иначе	
			
			ОПЗ.ВыдачаЗалога = Ложь;
			ОПЗ.Выкуп  = Ложь; 
			СостЗБ = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(ОПЗ, ОперацияВыдачи); 
			
			ОПЗ.ДатаВыкупа	       = СостЗБ.ДатаВыкупа;
			ОПЗ.ДатаВыкупаЛьготная = СостЗБ.ДатаВыкупаЛьготныйСрок;   
		КонецЕсли;
		//Попытка
		//	ОПЗ.СрокЗалога  = (ОПЗ.ДатаВыкупа - ОПЗ.Дата)/86400;
		//	ОПЗ.ДатаВыкупа	       = строкаДок.ДатаВыкупа;
		//	ОПЗ.ДатаВыкупаЛьготная = строкаДок.ДатаРеализации; 
		//Исключение
		//КонецПопытки;
		
		ОПЗ.ВидОперации = Перечисление_ОплатаПроцентов;
		ОПЗ.НомерЗалоговогоБилета = строкаДок.НомерЗБ;
		Если ЗначениеЗаполнено(строкаДок.id_Ломбарда2) Тогда
			ОПЗ.Ломбард = ВернутьЛомбардПоID(строкаДок.id_Ломбарда2); 
		КонецЕсли; 
		//ОПЗ.Ответственный = ВернутьСоздатьПользователя(строкаДок.Ответственный);
		
		
		Для каждого строчТовары из ОперацияВыдачи.Товары Цикл
			НовСтрТовары = ОПЗ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрТовары, строчТовары);
			
			// здесь надо получать данные из LX по распределению оплаты тела по объектам залога			
			
		КонецЦикла; 
		
		ЗаполнитьТовары(ОПЗ, Опз.Дата, ОПЗ.Товары,  СтрокаДок.СуммаТело);
		
		
		ОПЗ.Вставки.Загрузить(ОперацияВыдачи.Вставки.Выгрузить());
		ОПЗ.ДополнительныеМеталлы.Загрузить(ОперацияВыдачи.ДополнительныеМеталлы.Выгрузить());
		ОПЗ.Дефекты.Загрузить(ОперацияВыдачи.Дефекты.Выгрузить());
		
		НеГрузитьАдреса = Истина;
		
		Если строкаДок.id_клиента <> строкаДок.id_Плательщика Тогда 	
			
			РеквизитыПлательщика = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, "Kodclient = '" + строкаДок.id_Плательщика + "'", НеГрузитьАдреса);
			
			Если ЗначениеЗаполнено(РеквизитыПлательщика[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыПлательщика[0].Фамилия) или ЗначениеЗаполнено(РеквизитыПлательщика[0].Имя) или ЗначениеЗаполнено(РеквизитыПлательщика[0].Отчество)) Тогда
				
				Парамс = Новый Структура;
				Парамс.Вставить("Данные", 			РеквизитыПлательщика[0]); 
				Парамс.Вставить("тзСтран", 			тзСтран);
				Парамс.Вставить("АдоСоединение", 	АдоСоединение);
				Парамс.Вставить("СтатусКлиента", 	"");
				Парамс.Вставить("НеГрузитьАдреса", 	НеГрузитьАдреса); 
				Парамс.Вставить("тзЧерныеСтатусыКлиентов", 	тзЧерныеСтатусыКлиентов);
				Парамс.Вставить("тзПервыхДатЗБ", 	тзПервыхДатЗБ);
				
				
				ОПЗ.Залогодатель 	= НайтиСоздатьЗалогодателя(Парамс);
				ОПЗ.Фамилия 		= ОПЗ.Представитель.Фамилия;
				ОПЗ.Имя 			= ОПЗ.Представитель.Имя; 
				ОПЗ.Отчество 		= ОПЗ.Представитель.Отчество;
				
				ОПЗ.Представитель 				= "";
				ОПЗ.ФамилияПредставителя 		= "";
				ОПЗ.ИмяПредставителя 			= ""; 
				ОПЗ.ОтчествоПредставителя 		= "";
				
				//тзКонтИнфо = ВернутьКонтактнуюИнформациюЗалогодателя(строкаДок.Дата+1, ОПЗ.Представитель);
				//Если тзКонтИнфо.Количество() > 0 Тогда   
				//	ЗаполнитьЗначенияСвойств(ОПЗ, тзКонтИнфо[0]);
				//КонецЕсли;			
			КонецЕсли; 
			
			
			
			// документ оплаты получим если распарсим колонку doc
			//select doc from azb_oper where nreczb_oper = -123163226 
			
			РеквДокПлат = ВернутьidДокументаПлательщика(строкаДок.id_LX, строкаДок.id_Плательщика);		
			
			СсылкаДокументаПлательщика = НайтиДокументЗалогодателя(РеквДокПлат, "", "", ОПЗ.Представитель);
			
			ОПЗ.ДокументЗалогодателя = СсылкаДокументаПлательщика; 
			ОПЗ.ДокументВидДокументаЗалогодателя = ОПЗ.ДокументЗалогодателя.ВидДокументаЗалогодателя;
			ОПЗ.ДокументВид = ОПЗ.ДокументЗалогодателя.ВидДокумента;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ЛБ_ДокументыЗалогодателя.Владелец КАК Клиент,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
			|	ЛБ_ДокументыЗалогодателя.Наименование КАК Наименование,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
			|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия
			|ИЗ
			|	Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
			|		ПО (ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка)
			|ГДЕ
			|	ЛБ_ДокументыЗалогодателя.Ссылка = &Док
			|	И ЛБ_ДокументыЗалогодателя.Владелец = &Клиент"; 
			
			Запрос.УстановитьПараметр("Док",    СсылкаДокументаПлательщика);
			Запрос.УстановитьПараметр("Клиент", ОПЗ.Залогодатель);
			
			ВыбДок = Запрос.Выполнить().Выбрать();
			Если ВыбДок.Следующий() Тогда    
				ОПЗ.ДокументДатаВыдачи = ВыбДок.ДокументДатаВыдачи; 
				ОПЗ.ДокументСерия = ВыбДок.ДокументСерия;
				ОПЗ.ДокументНомер = ВыбДок.ДокументНомер;
				ОПЗ.ДокументКемВыдан = ВыбДок.ДокументКемВыдан;
				ОПЗ.ДокументКодПодразделения = ВыбДок.ДокументКодПодразделения;
				ОПЗ.ДокументНачалоДействия = ВыбДок.ДокументНачалоДействия;
				ОПЗ.ДокументСрокДействия = ВыбДок.ДокументСрокДействия;			
			КонецЕсли;			
		КонецЕсли;
		
		
		ОПЗ.СуммаОплатыПроценты = СтрокаДок.СуммаПроценты;
		ОПЗ.СуммаОплатыСсуда    = СтрокаДок.СуммаТело;
		ОПЗ.СуммаОплаты         = СтрокаДок.СуммаТело + СтрокаДок.СуммаПроценты;
		ОПЗ.ПредыдущаяОперация  = НайтиПредыдущуюОперацию(ОПЗ.НомерЗалоговогоБилета);  	
		
		РасчетПроцентовДляОбмена(ОПЗ);
		
		СуммаПроцЗаДень = ВернутьНачисленияПроцентовДетальноЗаПериод(ОПЗ, ОперацияВыдачи);
		Если СуммаПроцЗаДень > 0 Тогда
			Для каждого строч из ОПЗ.НачислениеПроцентовДетально Цикл
				строч.СуммаПроцентов = 0;
			КонецЦикла;
		КонецЕсли;		
		
		ОПЗ.ПСК_LX = СтрокаДок.ПСК;
		
		ОПЗ.Записать(РежимЗаписиДокумента.Запись);
		ОПЗ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла; 
	
КонецПроцедуры


Функция ВернутьНачисленияПроцентовДетальноЗаПериод(ДокументОбъект, ЗалоговыйБилет) Экспорт 
	
	МоментДоДокумента = Новый Граница(Новый МоментВремени(ДокументОбъект.Дата, ДокументОбъект.Ссылка), ВидГраницы.Исключая);
	ДатаДок = МоментДоДокумента; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаКон", ДатаДок);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДокументОбъект.Дата));
	
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.Текст ="ВЫБРАТЬ
	|	ЛБ_НачислениеПроцентовДетальноОбороты.СуммаПроцентовОборот КАК СуммаПроцентов
	|ИЗ
	|	РегистрНакопления.ЛБ_НачислениеПроцентовДетально.Обороты(&НачалоДня, &ДатаКон, , ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_НачислениеПроцентовДетальноОбороты";	
	СуммаПроц = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммаПроц = Выборка.СуммаПроцентов;
	КонецЦикла;
	
	Возврат СуммаПроц;
КонецФункции	 




Процедура РасчетПроцентовДляОбмена(ДокументОбъект) Экспорт     
	ЗалоговыйБилет = ДокументОбъект.ПредыдущаяОперация;
	СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(ДокументОбъект, ЗалоговыйБилет);
	Если СтруктураРез <> Неопределено Тогда
		ДатаНачалаРасчета = СтруктураРез.ДатаНачалаРасчета; 
		СуммаЗайма = СтруктураРез.СуммаЗайма;  
		СтатусЗБ = СтруктураРез.СтатусЗалоговогоБилета; 
		ПричинаПримененияПроцентнойСхемы = СтруктураРез.ПричинаПрименения;   
		ДокументОбъект.НачислениеПроцентовДетально.Очистить();
		Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
			СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
			СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда
			СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(ДокументОбъект, ДокументОбъект.ПредыдущаяОперация);
			
			Если НЕ СуммаПроцентов = 0 Тогда
				СтрП = ДокументОбъект.НачислениеПроцентовДетально.Добавить();   
				СтрП.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая; 
				СтрП.ДатаНач = ДатаНачалаРасчета;
				СтрП.ДатаКон = ДокументОбъект.Дата;
				СтрП.ДеньНач = 1;  
				СтрП.ДеньКон = (НачалоДня(СтрП.ДатаКон) - НачалоДня(СтрП.ДатаНач)) / (60 * 60 * 24) + 1; 
				СтрП.СуммаПроцентов = СуммаПроцентов;
			КонецЕсли;
		КонецЕсли;		
		СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
		Если НЕ СтруктураП = неопределено Тогда
			ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
			ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
		Иначе
			ПредельноеЗначениеПроцентов = 0;
		КонецЕсли;   
		СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
		Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
		ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр);
	КонецЕсли;
КонецПроцедуры


Функция ВернутьidДокументаПлательщика(id_LX, кодКлиент)
	
	АдоСоединение = АдоНовоеСоединение("dCBDL");
	
	ТекстЗапроса = "select doc from azb_oper where nreczb_oper = '"+ id_LX +"'";		
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса); 
	стрДокум = "";
	Пока не Выборка.eof() Цикл                 
		стрДокум  = Выборка.fields("doc").value;
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	Серия = "";
	Номер = "";
	Если СтрДокум <> "" Тогда
		ПозНайд = СтрНайти(стрДокум, "pPlat=");
		Если ПозНайд > 0 тогда
			стрПлат = Сред(стрДокум,ПозНайд);
			ПозПасп = СтрНайти(стрПлат, "паспорт РФ");
			Если ПозПасп > 0 Тогда 
				Серия = Сред(стрПлат,ПозПасп+12,4);
				Номер = Сред(стрПлат,ПозПасп+17,6);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	idДокаПлательщика = "";
	
	Если номер <> "" Тогда
		
		АдоСоединение = АдоНовоеСоединение("dCBDL"); 
		ТекстЗапроса = "select * from aclientdoc where kodclient = '"+ кодКлиент +"' and Ndoc = '"+Номер+"'"; 
		Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса); 
		стрДокум = "";
		Пока не Выборка.eof() Цикл                 
			idДокаПлательщика  = Выборка.fields("nrecClientDoc").value;
			
			Выборка.movenext();
		КонецЦикла;
		АдоСоединение.Close(); 
	КонецЕсли;	
	
	Возврат idДокаПлательщика;
	
КонецФункции

Функция НайтиПредыдущуюОперацию(НомерЗБ)
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	|ГДЕ
	|	ЛБ_ОперацияПоЗалогу.НомерЗалоговогоБилета = &НомерЗБ 
	| И ЛБ_ОперацияПоЗалогу.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("НомерЗБ", 	 НомерЗБ); 
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат неопределено;
КонецФункции

Функция ВернутьДанныеОбъектаЗалогаИзLX(Артикул, id_LX)
	
	АдоСоединение = АдоНовоеСоединение("dlink"); 
	
	
	ПозТире 	= СтрНайти(Артикул,"-");
	Номер 		= Сред(Артикул, ПозТире+1);  	
	
	ТекстЗапроса = "select * from aZBPoz where nreczb = '"+id_LX+"' and NPoz = '"+СокрЛП(Номер)+"'";
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);   
	
	Структ = Новый Структура; 
	Структ.Вставить("Клеймо",  Неопределено);
	Структ.Вставить("Именник", Неопределено);
	Структ.Вставить("Описание",Неопределено);
	Структ.Вставить("id_LX_Вставки",Неопределено); 
	
	
	Пока не Выборка.eof() Цикл
		клеймо = Выборка.fields("Kleimo").value;
		Если клеймо = 1 Тогда
			Структ.Вставить("Клеймо", Перечисления.ЛБ_ВидыКлейм.Есть);
		ИначеЕсли клеймо = 2 Тогда
			Структ.Вставить("Клеймо", Перечисления.ЛБ_ВидыКлейм.ЕстьФальшь);  
		ИначеЕсли клеймо = 3 Тогда
			Структ.Вставить("Клеймо", Перечисления.ЛБ_ВидыКлейм.Нет);
		ИначеЕсли клеймо = 4 Тогда
			Структ.Вставить("Клеймо", Перечисления.ЛБ_ВидыКлейм.НеЧитается); 
		ИначеЕсли клеймо = 5 Тогда
			Структ.Вставить("Клеймо", Перечисления.ЛБ_ВидыКлейм.ЧитаетсяЧастично);
		КонецЕсли;		
		
		Именник = Выборка.fields("Imennik").value;
		Если Именник = 1 Тогда  
			Структ.Вставить("Именник", Перечисления.ЛБ_Именник.Да);
		ИначеЕсли Именник = 2 Тогда
			Структ.Вставить("Именник", Перечисления.ЛБ_Именник.Нет);
		КонецЕсли;
		
		Структ.Вставить("Описание", Выборка.fields("Dop").value);  
		Структ.Вставить("id_LX_Вставки", СтрЗаменить(Выборка.fields("NRecZBPoz").value,Символы.НПП, ""));
		
		
		Выборка.movenext();
	КонецЦикла;
	АдоСоединение.Close();
	
	Возврат Структ;	
КонецФункции

