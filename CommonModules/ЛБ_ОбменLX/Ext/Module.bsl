			//Док.ИсточникИнформации = Справочники.ЛБ_ИсточникиИнформации.НайтиПоРеквизиту("id_LX", СокрЛП(РеквизитыАнкеты.КодИсточникаИнформации));
			
			Информирование = СокрЛП(РеквизитыАнкеты.Информирование); 
