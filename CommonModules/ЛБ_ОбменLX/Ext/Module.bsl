Функция ЗагрузитьОдногоКлиентаПоID(тзСтран, тзПервыхДатЗБ, тзЧерныеСтатусыКлиентов, id)
	
	АдоСоединение = ЛБ_ОбменLX.АдоНовоеСоединение("dlink") ;  
	
	id = СтрЗаменить(id, Символы.НПП, "");
	
	ТекстЗапроса = "SELECT * FROM [dLink].[dbo].[SootClientBlack] where nrecblacklist = '"+ id +"'";
	
	Выборка = ЛБ_ОбменLX.АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса) ;
	
	ТЗ = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("nrecblacklist"); 
	тз.Колонки.Добавить("fiof"); 
	тз.Колонки.Добавить("datar");
	тз.Колонки.Добавить("kodclient");
	тз.Колонки.Добавить("nobj");
	тз.Колонки.Добавить("fam");
	тз.Колонки.Добавить("name");
	тз.Колонки.Добавить("patr");  
	
	
	ном = 0;
	Пока не Выборка.eof() Цикл 
		ном = ном + 1;
		
		СтрокаТЗ = ТЗ.Добавить();			
		СтрокаТЗ.nrecblacklist = Выборка.fields("nrecblacklist").value; 
		СтрокаТЗ.fiof = Выборка.fields("fiof").value; 
		СтрокаТЗ.datar = Выборка.fields("datar").value; 
		СтрокаТЗ.kodclient = Выборка.fields("kodclient").value; 
		СтрокаТЗ.nobj = Выборка.fields("nobj").value;
		СтрокаТЗ.fam = Выборка.fields("fam").value;
		СтрокаТЗ.name = Выборка.fields("name").value;
		СтрокаТЗ.patr = Выборка.fields("patr").value;
		
		Выборка.movenext();
	КонецЦикла; 
	
	АдоСоединение.Close() ; 
		
	ЛБ_ОбменLX.ЗагрузитьЗалогодателя(ТЗ, тзСтран, тзПервыхДатЗБ, тзЧерныеСтатусыКлиентов); 
	
	Возврат Истина;
	
КонецФункции



