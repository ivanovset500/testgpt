		НоваяСтр.ДокументСрокДействия 		= стрДокументы.ДокументСрокДействия; 
		НоваяСтр.ПричинаИзменения 			= Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.НовыйДокумент;
		
		//НоваяСтр.ДокументНеДействителен 	= стрДокументы.ДокументНеДействителен;
		//Если стрДокументы.ДокументДУЛ = 1 Тогда
		//	НоваяСтр.ОсновнойДУЛ 	= Истина; 
		//Иначе
		//	НоваяСтр.ОсновнойДУЛ 	= Ложь;
		//КонецЕсли;  
		//Если стрДокументы.ВидДокументаЗалогодателя <> Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность Тогда
		//	НоваяСтр.ОсновнойДУЛ 	= Ложь;
		//КонецЕсли;
		
		Если стрДокументы.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность или
			стрДокументы.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ Тогда
			НоваяСтр.ОсновнойДУЛ 	= Истина;
		КонецЕсли;
		
		Док.Записать(РежимЗаписиДокумента.Проведение); 
