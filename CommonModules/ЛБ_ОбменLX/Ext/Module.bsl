		КонецЕсли;
		//-Мельников
	КонецЕсли;
КонецПроцедуры



Процедура СоздатьКарточкуЗалогодателя_02_05_25(Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАдреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ) 
	АдоСоединениеdCBDL = АдоНовоеСоединение("dCBDL");
	
	Парамс = Новый Структура;
	Парамс.Вставить("АдоСоединение", 		АдоСоединениеdCBDL);
	Парамс.Вставить("ФИО", 			 		СокрЛП(Ссылка.Наименование));
	Парамс.Вставить("ДатаРожденияСтрокой", 	Формат(Ссылка.ДатаРождения, "ДФ=yyyyMMdd"));
	Парамс.Вставить("тзСтран", 				тзСтран);  	  
	Парамс.Вставить("id", 					Данные.id_LX);  	
	
	
	мДокументы = ВернутьДокументыКлиента(Парамс);
	
	промДокументы = мДокументы.Скопировать();
	промДокументы.Свернуть("ВидДокумента, ДокументСерия, ДокументНомер, ДокументДатаВыдачи"); 
	
	
	РеквизитыАнкеты = ВернутьДанныеАнкетыКлиента(АдоСоединениеdCBDL, Данные.id_LX);
	
	ПоследнийДок = Неопределено;
	ЭтоПервыйДок = Истина;
	Для каждого стрПромДокументы из промДокументы Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("ВидДокумента", стрПромДокументы.ВидДокумента); 
		Отбор.Вставить("ДокументСерия", стрПромДокументы.ДокументСерия);
		Отбор.Вставить("ДокументНомер", стрПромДокументы.ДокументНомер);
		Отбор.Вставить("ДокументДатаВыдачи", стрПромДокументы.ДокументДатаВыдачи); 	
		
		НайденныеДоки = мДокументы.НайтиСтроки(Отбор);
		//	НайденныеДоки.Сортировать("ДатаСортировки");
		
		стрДокументы = НайденныеДоки[0];
		
		Карточка_КЛ = ВернутьКарточкуПоIDДокумента(стрДокументы.КодЭликсДокумента);
		Если Карточка_КЛ = Неопределено Тогда	
			Док = Документы.ЛБ_КарточкаЗалогодателя.СоздатьДокумент();
		Иначе
			Док = Карточка_КЛ.ПолучитьОбъект();
