Функция ВернутьКоличествоДнейПоСхеме(Схема, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ТехническиеСтавкиСрезПоследних.ДеньНачалаПрименения КАК ДеньНачалаПрименения
	|ИЗ
	|	РегистрСведений.ЛБ_ТехническиеСтавки.СрезПоследних(&Дата, СхемаКредитования = &Схема) КАК ЛБ_ТехническиеСтавкиСрезПоследних";
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("Схема",Схема); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДеньНачалаПрименения;
	КонецЕсли;
	
	Возврат 121;
