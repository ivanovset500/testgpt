				Движение3.Используется = Ложь;
				
			КонецЕсли;
			
			НаборЗаписей.Отбор.Регистратор.Установить(Док.Ссылка);
			НаборЗаписей.Записать(Ложь);
			
		КонецЕсли;
		//-Мельников
	КонецЕсли;
КонецПроцедуры



Процедура СоздатьКарточкуЗалогодателяНов(Ссылка, Данные, АдоСоединение, тзСтран, СтатусКлиента, НеГрузитьАдреса, тзЧерныеСтатусыКлиентов, тзПервыхДатЗБ, тзВсехДокументов, тзВсехАнкет) 
	//АдоСоединениеdCBDL = АдоНовоеСоединение("dCBDL");
	
