		Если Грузим Тогда
			
			РеквизитыКлиента = ВернутьРеквизитыКлиентаИзLX(АдоСоединение, тзСтран, "Kodclient = '" + стр.id_LX + "'", НеГрузитьАдреса);
			
			Если РеквизитыКлиента <> Неопределено Тогда
				Если ЗначениеЗаполнено(РеквизитыКлиента[0].ДатаРождения) и (ЗначениеЗаполнено(РеквизитыКлиента[0].Фамилия) или ЗначениеЗаполнено(РеквизитыКлиента[0].Имя) или ЗначениеЗаполнено(РеквизитыКлиента[0].Отчество)) Тогда 
