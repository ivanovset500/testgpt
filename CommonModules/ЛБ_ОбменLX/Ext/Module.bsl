		РеквизитыАнкеты = РеквизитыАнкетыКЛ[0];
	КонецЕсли; 
			
	
	ПоследнийДок = Неопределено;
	ЭтоПервыйДок = Истина;
	Для каждого стрДокументы из мДокументы Цикл
		//Отбор = Новый Структура();    
		//Отбор.Вставить("КодКлиента", стрПромДокументы.ВидДокумента);
		//Отбор.Вставить("ВидДокумента", стрПромДокументы.ВидДокумента); 
