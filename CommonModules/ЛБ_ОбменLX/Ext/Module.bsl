Функция ВернутьДокументыКлиента(параметры)
	Перем Результат ;
	
	АдоСоединение   = Параметры.АдоСоединение;
	ФИО             = Параметры.ФИО;
	ДатаРожденияСтрокой = Параметры.ДатаРожденияСтрокой; 
	тзСтран 		= Параметры.тзСтран; 
	id 		= Параметры.id;
	
	
	
	ТекстЗапроса = "exec z_FizAxioma '','" +СтрЗаменить(id,Символы.НПП,"")+"'"; 
	
	//ТекстЗапроса = "exec z_FizAxioma '"+СокрЛП(ФИО)+"',0,'"+ДатаРожденияСтрокой+"'";
	
	// 'Тягус Марина Владимировна',0, '19770903'
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса) ;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("КодЭликс");
	ТЗ.Колонки.Добавить("КодЭликсДокумента");
	ТЗ.Колонки.Добавить("ВидДокумента");	
	ТЗ.Колонки.Добавить("ВидДокументаЗалогодателя");	
	ТЗ.Колонки.Добавить("Гражданство"); 
	ТЗ.Колонки.Добавить("ДокументСтранаЭмитент");
	ТЗ.Колонки.Добавить("ДокументНачалоДействия", Новый ОписаниеТипов("Дата"));		
	ТЗ.Колонки.Добавить("ДокументСерия");
	ТЗ.Колонки.Добавить("ДокументНомер");
	ТЗ.Колонки.Добавить("ДокументДатаВыдачи", Новый ОписаниеТипов("Дата"));	
	ТЗ.Колонки.Добавить("ДокументКемВыдан");
	ТЗ.Колонки.Добавить("ДокументКодПодразделения");
	ТЗ.Колонки.Добавить("ДокументСрокДействия", Новый ОписаниеТипов("Дата"));	
	ТЗ.Колонки.Добавить("ДокументДатаРегистрацииLX");
	ТЗ.Колонки.Добавить("ДокументНеДействителен");
	ТЗ.Колонки.Добавить("ДокументДУЛ"); 
	ТЗ.Колонки.Добавить("ДатаСортировки");
	
	Пока не Выборка.eof() Цикл
		КодДока1С = Выборка.fields("Kod1C").value;
		Если КодДока1С = "36" Тогда
			
		Иначе
			ВидДок = НайтиСоздатьВидДокументаФизическогоЛица(КодДока1С); 
			Если ВидДок = Неопределено Тогда
				Сообщить(СокрЛП(ФИО)+ " "+СокрЛП(id)+". Не нашел вид документа с кодом: "+СокрЛП(КодДока1С)); 
			КонецЕсли;
			
			
			ВидДокумента	 	= НайтиСоздатьВидДокументаФизическогоЛица(Выборка.fields("Kod1C").value);
			ДокументСерия 		= Выборка.fields("SDoc").value;
			ДокументНомер 		= Выборка.fields("NDoc").value;
			ДокументДатаВыдачи 	= Выборка.fields("DDoc").value;
			Если значениеЗаполнено(ДокументДатаВыдачи) Тогда
				Если ДокументДатаВыдачи >= Дата(2050,01,01) Тогда
					ДокументДатаВыдачи = Дата(2020,01,01);		
				КонецЕсли;
			КонецЕсли;
			
			ДокументКемВыдан 	= Выборка.fields("WDoc").value;
			ДокументКодПодразделения = Выборка.fields("KodPodr").value;
			ДокументСрокДействия = Выборка.fields("EndPreb").value;
			Если ДокументСрокДействия >= Дата(2199,01,01) Тогда 
				ДокументСрокДействия = Неопределено;
			КонецЕсли;
			Гражданство 		= НайтиСтрануМиравТЗ(тзСтран, Выборка.fields("KodStrana").value,"");
			
			ВидДокЗалогодателя 	= Выборка.fields("Vz").value;
			
			ВидДокументаЗалогодателя = Неопределено;
			
			Если ВидДокЗалогодателя = 1 Тогда	//	ДУЛ
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность;
			ИначеЕсли ВидДокЗалогодателя = 2 Тогда	//	льготы
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент;
			ИначеЕсли ВидДокЗалогодателя = 7 Тогда	//	Территория РФ
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ ;
			ИначеЕсли ВидДокЗалогодателя = 12 Тогда	//	иностранный паспорт
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ ;				
			Иначе
				//Сообщить("Неправильный вид документа залогодателя "+СтрокаТЗ.КодЭликс) ;
			КонецЕсли;
			
			РеквизитыДока = Новый Структура; 
			РеквизитыДока.Вставить("ВидДокумента",  			ВидДокумента); 
			РеквизитыДока.Вставить("ВидДокументаЗалогодателя",  ВидДокументаЗалогодателя); 
			РеквизитыДока.Вставить("ДокументСерия",  			ДокументСерия); 
			РеквизитыДока.Вставить("ДокументНомер",  			ДокументНомер);
			РеквизитыДока.Вставить("ДокументДатаВыдачи",  		ДокументДатаВыдачи); 
			РеквизитыДока.Вставить("ДокументКемВыдан",  		ДокументКемВыдан);
			РеквизитыДока.Вставить("ДокументКодПодразделения",  ДокументКодПодразделения);  
			РеквизитыДока.Вставить("ДокументГражданство",  		Гражданство);
			РеквизитыДока.Вставить("ДокументСрокДействия",  	ДокументСрокДействия); 			
			
			Если ДокументВалидный(РеквизитыДока) Тогда			
				
				СтрокаТЗ = ТЗ.Добавить();
				СтрокаТЗ.КодЭликс 			= Формат(Выборка.fields("KodClient").value,"ЧГ=0") ;
				СтрокаТЗ.КодЭликсДокумента 	= Выборка.fields("NRecClientDoc").value; 
				
				СтрокаТЗ.ВидДокумента	 	= ВидДокумента;
				Если СтрокаТЗ.ВидДокумента = Неопределено Тогда
					Сообщить("Не нашел вид документа с кодом" + СокрЛП(Выборка.fields("Kod1C").value)); 
				КонецЕсли;
				//  KodStranaD - страна выдачи документа, KodStrana - страна гражданства
				СтрокаТЗ.ДокументСтранаЭмитент = НайтиСтрануМиравТЗ(тзСтран, Выборка.fields("KodStranaD").value,"");
				СтрокаТЗ.Гражданство 		= Гражданство;
				СтрокаТЗ.ДокументСерия 		= ДокументСерия;
				СтрокаТЗ.ДокументНомер 		= ДокументНомер;
				СтрокаТЗ.ДокументДатаВыдачи = ДокументДатаВыдачи;
				СтрокаТЗ.ДокументКемВыдан 	= ДокументКемВыдан;
				СтрокаТЗ.ДокументКодПодразделения = ДокументКодПодразделения;
				СтрокаТЗ.ДокументДатаРегистрацииLX = Выборка.fields("DReg").value;
				СтрокаТЗ.ДокументДУЛ        = Выборка.fields("xv").value; 
				СтрокаТЗ.ДокументСрокДействия = ДокументСрокДействия;
				Попытка
					СтрокаТЗ.ДокументНеДействителен = НЕ СтрокаТЗ.ДокументДУЛ;		
				ИСключение
				КонецПопытки;
				СтрокаТЗ.ВидДокументаЗалогодателя = ВидДокументаЗалогодателя;
				
				Если ЗначениеЗаполнено(СтрокаТЗ.ДокументДатаРегистрацииLX) Тогда
					СтрокаТЗ.ДатаСортировки     		= СтрокаТЗ.ДокументДатаРегистрацииLX;
				Иначе 
					СтрокаТЗ.ДатаСортировки 			= СтрокаТЗ.ДокументДатаВыдачи;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;		
		
		Выборка.movenext();
	КонецЦикла;
	
	тз.Сортировать("ДатаСортировки");
	Возврат ТЗ;  
КонецФункции

Функция ВернутьДокументыКлиентаПокупателя(параметры)
	Перем Результат ;
	
	АдоСоединение   = Параметры.АдоСоединение;
	ФИО             = Параметры.ФИО;
	ДатаРожденияСтрокой = Параметры.ДатаРожденияСтрокой; 
	тзСтран 		= Параметры.тзСтран; 
	id 		= Параметры.id;
	
	
	
	//ТекстЗапроса = "SELECT * FROM [dCBDL_dan].[dbo].[aClientDocP] where kodclient = '"+id+"'"; 
	
	ТекстЗапроса = "SELECT p.*, d.Kod1C FROM [dCBDL_dan].[dbo].[aClientDocP] p   join [dCBDL].[dbo].[ssDocVid] d on p.KodDocVid = d.KodDocVid where p.kodclient = '"+id+"'"; 
	
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса) ;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("КодЭликс");
	ТЗ.Колонки.Добавить("КодЭликсДокумента");
	ТЗ.Колонки.Добавить("ВидДокумента");	
	ТЗ.Колонки.Добавить("ВидДокументаЗалогодателя");	
	ТЗ.Колонки.Добавить("Гражданство"); 
	ТЗ.Колонки.Добавить("ДокументСтранаЭмитент");
	ТЗ.Колонки.Добавить("ДокументНачалоДействия", Новый ОписаниеТипов("Дата"));		
	ТЗ.Колонки.Добавить("ДокументСерия");
	ТЗ.Колонки.Добавить("ДокументНомер");
	ТЗ.Колонки.Добавить("ДокументДатаВыдачи", Новый ОписаниеТипов("Дата"));	
	ТЗ.Колонки.Добавить("ДокументКемВыдан");
	ТЗ.Колонки.Добавить("ДокументКодПодразделения");
	ТЗ.Колонки.Добавить("ДокументСрокДействия", Новый ОписаниеТипов("Дата"));	
	ТЗ.Колонки.Добавить("ДокументДатаРегистрацииLX");
	ТЗ.Колонки.Добавить("ДокументНеДействителен");
	ТЗ.Колонки.Добавить("ДокументДУЛ"); 
	ТЗ.Колонки.Добавить("ДатаСортировки");
	
	Пока не Выборка.eof() Цикл
		КодДока1С = Выборка.fields("Kod1c").value;
		Если КодДока1С = "36" Тогда
			
		Иначе
			ВидДок = НайтиСоздатьВидДокументаФизическогоЛица(КодДока1С); 
			Если ВидДок = Неопределено Тогда
				Сообщить(СокрЛП(ФИО)+ " "+СокрЛП(id)+". Не нашел вид документа с кодом: "+СокрЛП(КодДока1С)); 
			КонецЕсли;
			
			
			ВидДокумента	 	= НайтиСоздатьВидДокументаФизическогоЛица(Выборка.fields("Kod1c").value);
			ДокументСерия 		= Выборка.fields("SDoc").value;
			ДокументНомер 		= Выборка.fields("NDoc").value;
			ДокументДатаВыдачи 	= Выборка.fields("DDoc").value;
			Если значениеЗаполнено(ДокументДатаВыдачи) Тогда
				Если ДокументДатаВыдачи >= Дата(2050,01,01) Тогда
					ДокументДатаВыдачи = Дата(2020,01,01);		
				КонецЕсли;
			КонецЕсли;
			
			ДокументКемВыдан 	= Выборка.fields("WDoc").value;
			ДокументКодПодразделения = Выборка.fields("KodPodr").value;
			ДокументСрокДействия = Выборка.fields("EndPreb").value; 
			Если НЕ ЗначениеЗаполнено(ДокументСрокДействия) Тогда
				   ДокументСрокДействия = Неопределено; 
			Иначе
				
			Если ДокументСрокДействия >= Дата(2199,01,01) Тогда 
				ДокументСрокДействия = Неопределено;
			КонецЕсли;
			КонецЕсли;
			Гражданство 		= НайтиСтрануМиравТЗ(тзСтран, Выборка.fields("KodStrana").value,"");
			
			//ВидДокЗалогодателя 	= Выборка.fields("Vz").value; 
			ВидДокЗалогодателя = 1;
			
			ВидДокументаЗалогодателя = Неопределено;
			
			Если ВидДокЗалогодателя = 1 Тогда	//	ДУЛ
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность;
			ИначеЕсли ВидДокЗалогодателя = 2 Тогда	//	льготы
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент;
			ИначеЕсли ВидДокЗалогодателя = 7 Тогда	//	Территория РФ
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ ;
			ИначеЕсли ВидДокЗалогодателя = 12 Тогда	//	иностранный паспорт
				ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ ;				
			Иначе
				//Сообщить("Неправильный вид документа залогодателя "+СтрокаТЗ.КодЭликс) ;
			КонецЕсли;
			
			РеквизитыДока = Новый Структура; 
			РеквизитыДока.Вставить("ВидДокумента",  			ВидДокумента); 
			РеквизитыДока.Вставить("ВидДокументаЗалогодателя",  ВидДокументаЗалогодателя); 
			РеквизитыДока.Вставить("ДокументСерия",  			ДокументСерия); 
			РеквизитыДока.Вставить("ДокументНомер",  			ДокументНомер);
			РеквизитыДока.Вставить("ДокументДатаВыдачи",  		ДокументДатаВыдачи); 
			РеквизитыДока.Вставить("ДокументКемВыдан",  		ДокументКемВыдан);
			РеквизитыДока.Вставить("ДокументКодПодразделения",  ДокументКодПодразделения);  
			РеквизитыДока.Вставить("ДокументГражданство",  		Гражданство);
			РеквизитыДока.Вставить("ДокументСрокДействия",  	ДокументСрокДействия); 			
			
			Если ДокументВалидный(РеквизитыДока) Тогда			
				
				СтрокаТЗ = ТЗ.Добавить();
				СтрокаТЗ.КодЭликс 			= Формат(Выборка.fields("KodClient").value,"ЧГ=0") ;
				СтрокаТЗ.КодЭликсДокумента 	= Выборка.fields("NRecClientDoc").value; 
				
				СтрокаТЗ.ВидДокумента	 	= ВидДокумента;
				Если СтрокаТЗ.ВидДокумента = Неопределено Тогда
					Сообщить("Не нашел вид документа с кодом" + СокрЛП(Выборка.fields("Kod1C").value)); 
				КонецЕсли;
				//  KodStranaD - страна выдачи документа, KodStrana - страна гражданства
				СтрокаТЗ.ДокументСтранаЭмитент = НайтиСтрануМиравТЗ(тзСтран, Выборка.fields("KodStrana").value,"");
				СтрокаТЗ.Гражданство 		= Гражданство;
				СтрокаТЗ.ДокументСерия 		= ДокументСерия;
				СтрокаТЗ.ДокументНомер 		= ДокументНомер;
				СтрокаТЗ.ДокументДатаВыдачи = ДокументДатаВыдачи;
				СтрокаТЗ.ДокументКемВыдан 	= ДокументКемВыдан;
				СтрокаТЗ.ДокументКодПодразделения = ДокументКодПодразделения;
				СтрокаТЗ.ДокументДатаРегистрацииLX = Выборка.fields("DReg").value;
				СтрокаТЗ.ДокументДУЛ        = Выборка.fields("xv").value; 
				СтрокаТЗ.ДокументСрокДействия = ДокументСрокДействия;
				Попытка
					СтрокаТЗ.ДокументНеДействителен = НЕ СтрокаТЗ.ДокументДУЛ;		
				ИСключение
				КонецПопытки;
				СтрокаТЗ.ВидДокументаЗалогодателя = ВидДокументаЗалогодателя;
				
				Если ЗначениеЗаполнено(СтрокаТЗ.ДокументДатаРегистрацииLX) Тогда
					СтрокаТЗ.ДатаСортировки     		= СтрокаТЗ.ДокументДатаРегистрацииLX;
				Иначе 
					СтрокаТЗ.ДатаСортировки 			= СтрокаТЗ.ДокументДатаВыдачи;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;		
		
		Выборка.movenext();
	КонецЦикла;
	
	тз.Сортировать("ДатаСортировки");
	Возврат ТЗ;  
КонецФункции



Функция ВернутьВсеДокументыВсехКлиентов(тзСтран) Экспорт;
	
	АдоСоединение = АдоНовоеСоединение("dCBDL");
	
	ТекстЗапроса = "exec z_FizAxioma"; 
	
	Выборка = АдоВыполнитьЗапрос(АдоСоединение, ТекстЗапроса);
	
