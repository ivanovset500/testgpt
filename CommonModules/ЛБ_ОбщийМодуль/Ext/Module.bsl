		//|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ОтменяемыйПриказ КАК ОтменяемыйПриказ
		//|ИЗ
		//|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		//|ГДЕ
		//|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель = &Залогодатель
		//|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.СхемаКредитования = &СхемаКредитования
		//|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
		//|	И &СуммаЗайма МЕЖДУ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДиапазонСуммЗайма.СуммаОт И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДиапазонСуммЗайма.СуммаДо
		//|	И ВЫБОР
		//|			КОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		//|				ТОГДА ИСТИНА
		//|			КОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия >= &Дата
		//|				ТОГДА ИСТИНА
		//|			ИНАЧЕ ЛОЖЬ
		//|		КОНЕЦ
		////|	И НЕ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор В
		////|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		////|					ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ОтменяемыйПриказ КАК ОтменяемыйПриказ
		////|				ИЗ
		////|					РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		////|				ГДЕ
		////|					ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель = &Залогодатель
		////|					И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
		////|					И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ОтменяемыйПриказ <> ЗНАЧЕНИЕ(Документ.ЛБ_ПриказИндивидуальныеУсловия.ПустаяСсылка))
		////|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ВИП)
		//|
		//|УПОРЯДОЧИТЬ ПО
		//|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период УБЫВ";
	//-МАН
	
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор.ВидОперации КАК РегистраторВидОперации,
		//+МАН 10.12.25
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК ПриказВИП
		//-МАН
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель = &Залогодатель
		|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.СхемаКредитования = &СхемаКредитования
		|	И ВЫБОР
		|			КОГДА РАЗНОСТЬДАТ(ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период, ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия, ДЕНЬ) = 0
		|				ТОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период <= &Дата
		|			ИНАЧЕ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
		|		КОНЕЦ
		|	И &СуммаЗайма МЕЖДУ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДиапазонСуммЗайма.СуммаОт И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДиапазонСуммЗайма.СуммаДо
		|	И ВЫБОР
		|			КОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ИСТИНА
		|			КОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия >= &Дата
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК Регистратор
		|			ИЗ
		|				РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		|			ГДЕ
		|				ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель = &Залогодатель
		|				И ВЫБОР
		|					КОГДА РАЗНОСТЬДАТ(ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период, ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия, ДЕНЬ) = 0
		|						ТОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период <= &Дата
		|					ИНАЧЕ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|						ТОГДА ИСТИНА
		|					КОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия >= &Дата
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|			УПОРЯДОЧИТЬ ПО
		|				ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период УБЫВ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период УБЫВ";
	//-МАН

	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("СуммаЗайма", СуммаСсуды);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		//+МАН 14.11.24 Измен возврат результата. Заявка 2792
		//Если Результат.ДатаОкончанияДействия >= ДатаДок ИЛИ Результат.ДатаОкончанияДействия = Дата(1,1,1) Тогда
		//	Возврат Результат.ПроцентнаяСтавка;
		//+МАН 25.08.25 Изменил
		//Если НЕ ЗначениеЗаполнено(Результат.ОтменяемыйПриказ) Тогда
		Если Результат.РегистраторВидОперации <> Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП //Тогда
			//+МАН 10.12.25
			И (Результат.ДатаОкончанияДействия >= ДатаДок ИЛИ Результат.ДатаОкончанияДействия = Дата(1,1,1))Тогда
			//-МАН
		//-МАН
			//+МАН 10.12.25
			//Было: Возврат Результат.ПроцентнаяСтавка;
			СтруктураВозврата = Новый Структура("СтавкаВИП, ПриказВИП");
			
			СтруктураВозврата.СтавкаВИП = Результат.ПроцентнаяСтавка;
			СтруктураВозврата.ПриказВИП = Результат.ПриказВИП;
			
			Возврат СтруктураВозврата;
		//-МАН
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
