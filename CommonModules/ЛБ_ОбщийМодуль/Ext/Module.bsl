Функция ПолучитьСписокЗБКлиента(Клиент, ЗалоговыйБилет = неопределено) Экспорт  
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Клиент);
	СписокВидовОпераций = Новый СписокЗначений;
	СписокВидовОпераций.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
	СписокВидовОпераций.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление);
	Запрос.УстановитьПараметр("СписокВидовОпераций", СписокВидовОпераций);  
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления);
    СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Реализован); 
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт);	
	Запрос.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
	Если ЗалоговыйБилет = неопределено Тогда 
		УсловиеОтбора = "   Залогодатель = &Залогодатель И ЗалоговыйБилет.ВидОперации В (&СписокВидовОпераций)"
	Иначе	
	    Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
		УсловиеОтбора = "   ЗалоговыйБилет = &ЗалоговыйБилет";
	КонецЕсли;	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет.Ломбард КАК Ломбард,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ВЫБОР
	               |		КОГДА ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета В (&СписокСтатусов)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Действующий
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(
	               |			,
	               |";  
	Запрос.Текст = Запрос.Текст + УсловиеОтбора + ") КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период УБЫВ";
	
	Возврат Запрос.Выполнить().Выгрузить();                       
КонецФункции	

Функция ПолучитьДействующиеПриказы(Ломбард) Экспорт 
	СписокПриказов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПроверки", ТекущаяДатаСеанса()); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Регистратор КАК Регистратор,
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.СхемаКредитования КАК СхемаКредитования
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок.СрезПоследних(
	               |			,
	               |			Ломбард = &Ломбард
	               |				И ДатаНачалаДействия <= &ДатаПроверки) КАК ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСК = ТаблицаЗапроса.Скопировать(); 
	ТаблицаСК.Свернуть("СхемаКредитования");
	Для каждого Стр Из ТаблицаСК Цикл  
		Отбор = Новый Структура;
		Отбор.Вставить("СхемаКредитования", Стр.СхемаКредитования);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);  
		Если НЕ Строки.Количество() = 0 Тогда 
			Регистратор = Строки.Получить(0).Регистратор;
			Если СписокПриказов.НайтиПоЗначению(Регистратор) = неопределено Тогда  
				СписокПриказов.Добавить(Регистратор);
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Регистратор КАК Регистратор,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(
	               |			,
	               |			Ломбард = &Ломбард
	               |				И ДатаНачалаДействия <= &ДатаПроверки) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();    
	Если Выборка.Следующий() Тогда  
		СписокПриказов.Добавить(Выборка.Регистратор);
	КонецЕсли;	     
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Регистратор КАК Регистратор,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СрезПоследних(
	               |			,
	               |			Ломбард = &Ломбард
	               |				И ДатаНачалаДействия <= &ДатаПроверки) КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();    
	Если Выборка.Следующий() Тогда  
		СписокПриказов.Добавить(Выборка.Регистратор);
	КонецЕсли;	     

	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.Регистратор КАК Регистратор,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.Акция КАК Акция
	               |ИЗ
	               |	РегистрСведений.ЛБ_АкцииПроцентныеСтавки.СрезПоследних(
	               |			,
	               |			Ломбард = &Ломбард
	               |				И ДатаНачалаДействия <= &ДатаПроверки
	               |				И ДатаОкончанияДействия >= &ДатаПроверки) КАК ЛБ_АкцииПроцентныеСтавкиСрезПоследних";  
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСК = ТаблицаЗапроса.Скопировать(); 
	ТаблицаСК.Свернуть("Акция, СхемаКредитования");
	Для каждого Стр Из ТаблицаСК Цикл  
		Отбор = Новый Структура;
		Отбор.Вставить("СхемаКредитования", Стр.СхемаКредитования);
		Отбор.Вставить("Акция", Стр.Акция);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);  
		Если НЕ Строки.Количество() = 0 Тогда 
			Регистратор = Строки.Получить(0).Регистратор;
			Если СписокПриказов.НайтиПоЗначению(Регистратор) = неопределено Тогда  
				СписокПриказов.Добавить(Регистратор);
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;
	
	Возврат  СписокПриказов;
КонецФункции

Функция ТекущийПользователь_ЭтоЛомбард() Экспорт
	Возврат ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард;	
