Функция ПроверитьПриказыВЗБ(Приказ) Экспорт
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Приказ", Приказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК Количество
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПриказыВОперацияхЗайма КАК ЛБ_ПриказыВОперацияхЗайма
	               |ГДЕ
	               |	ЛБ_ПриказыВОперацияхЗайма.Приказ = &Приказ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции	

Функция ПолучитьПриказыПоПроценымСтавкамВЗБ(ЗалоговыйБилет, ВИП = Ложь) Экспорт 
	СписокПриказов = Новый СписокЗначений;  
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Регистратор", ЗалоговыйБилет); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказыВОперацияхЗайма.ВидПриказа КАК ВидПриказа,
	               |	ЛБ_ПриказыВОперацияхЗайма.Приказ КАК Приказ,
	               |	ЛБ_ПриказыВОперацияхЗайма.ОтклонениеПоАкции КАК ОтклонениеПоАкции
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПриказыВОперацияхЗайма КАК ЛБ_ПриказыВОперацияхЗайма
	               |ГДЕ
	               |	ЛБ_ПриказыВОперацияхЗайма.Регистратор = &Регистратор
	               |	И ЛБ_ПриказыВОперацияхЗайма.Установить = ЗНАЧЕНИЕ(Перечисление.ЛБ_УстановитьВПриказе.Ставки)";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();    
	
	Если ВИП Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("ВидПриказа", Перечисления.ЛБ_ВидыОперацийПриказы.ВИП);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Стр = Строки.Получить(0);
			СписокПриказов.Добавить(Стр.Приказ);
			ДобавитьБазовыйПриказ = Истина;
		КонецЕсли;	                       
	Иначе	
		ДобавитьБазовыйПриказ = Ложь;
		Отбор = Новый Структура;
		Отбор.Вставить("ВидПриказа", Перечисления.ЛБ_ВидыОперацийПриказы.Акция);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Стр = Строки.Получить(0);
			СписокПриказов.Добавить(Стр.Приказ);
			Если Стр.ОтклонениеПоАкции Тогда 
				ДобавитьБазовыйПриказ = Истина;
			КонецЕсли; 
		Иначе
			ДобавитьБазовыйПриказ = Истина;
		КонецЕсли;	                       
		Если ДобавитьБазовыйПриказ Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("ВидПриказа", Перечисления.ЛБ_ВидыОперацийПриказы.Базовый);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		    Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 Тогда
				Стр = Строки.Получить(0);
				СписокПриказов.Добавить(Стр.Приказ);
	        КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	Возврат СписокПриказов;
КонецФункции	
	