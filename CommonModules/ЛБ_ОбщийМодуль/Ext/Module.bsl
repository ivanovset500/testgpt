Функция ПолучитьОтклонениеОтБазовойЦеныМеталлаВИП(Дата, СхемаКредитования, Категория, Проба, БазоваяЦена, Залогодатель) Экспорт
	
	МассивСхем = Новый Массив;
	МассивСхем.Добавить(Справочники.ЛБ_СхемыКредитования.ПустаяСсылка());
	Если ЗначениеЗаполнено(СхемаКредитования) Тогда
		МассивСхем.Добавить(СхемаКредитования);
	КонецЕсли;	
	
	МассивКатегорий = Новый Массив;
	МассивКатегорий.Добавить(Справочники.ЛБ_КатегорииОбъектовЗалога.ПустаяСсылка());
	Если ЗначениеЗаполнено(Категория) Тогда
		МассивКатегорий.Добавить(Категория);
	КонецЕсли;	
	
	МассивМеталлов = Новый Массив;
	МассивМеталлов.Добавить(Справочники.ЛБ_ДрагоценныеМеталлы.ПустаяСсылка());
	
	МассивПроб = Новый Массив;
	МассивПроб.Добавить(Справочники.ЛБ_Пробы.ПустаяСсылка());

	Если ЗначениеЗаполнено(Проба) Тогда
		МассивМеталлов.Добавить(Проба.Владелец);
		МассивПроб.Добавить(Проба);
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = 
	//+МАН 14.11.24 Изменен запрос получения условий по металлам. Заявка 2792
				   // "ВЫБРАТЬ ПЕРВЫЕ 1
				   //|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
				   //|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ЗначениеОтклонения КАК ЗначениеОтклонения,
				   //|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаОкончанияДействия КАК ДатаОкончанияДействия
				   //|ИЗ
				   //|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
				   //|ГДЕ
				   //|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Залогодатель = &Залогодатель
				   //|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.СхемаКредитования В(&СхемаКредитования)
				   //|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.КатегорияОбъектаЗалога В(&КатегорияОбъектаЗалога)
				   //|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Металл В(&Металл)
				   //|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Проба В(&Проба)
				   //|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия <= &Дата
				   //|
				   //|УПОРЯДОЧИТЬ ПО
				   //|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период УБЫВ";

	//+МАН 25.08.25 Изменил запрос
				//"ВЫБРАТЬ ПЕРВЫЕ 1
				//|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
				//|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ЗначениеОтклонения КАК ЗначениеОтклонения,
				//|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
				//|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ОтменяемыйПриказ КАК ОтменяемыйПриказ
				//|ИЗ
				//|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
				//|ГДЕ
				//|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Залогодатель = &Залогодатель
				//|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.СхемаКредитования В(&СхемаКредитования)
				//|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.КатегорияОбъектаЗалога В(&КатегорияОбъектаЗалога)
				//|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Металл В(&Металл)
				//|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Проба В(&Проба)
				//|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия <= &Дата
				//|	И ВЫБОР
				//|			КОГДА ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
				//|				ТОГДА ИСТИНА
				//|			КОГДА ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаОкончанияДействия >= &Дата
				//|				ТОГДА ИСТИНА
				//|			ИНАЧЕ ЛОЖЬ
				//|		КОНЕЦ
				////|	И НЕ ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор В
				////|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
				////|					ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ОтменяемыйПриказ КАК ОтменяемыйПриказ
				////|				ИЗ
				////|					РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
				////|				ГДЕ
