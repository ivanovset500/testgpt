Функция ПолучитьПричинуПримененияПроцентнойСхемы(ДокументОбъект, ЗалоговыйБилет) Экспорт 
	Если НЕ ДокументОбъект.СхемаКредитования.ПризнакПримененияГибкогоПроцента Тогда
		Возврат Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда	  
		МоментДоДокумента = Новый Граница(Новый МоментВремени(ДокументОбъект.Дата, ДокументОбъект.Ссылка), ВидГраницы.Исключая);
		ДатаДок = МоментДоДокумента; 
	Иначе	
	    ДатаДок = ДокументОбъект.Дата;		
	КонецЕсли;	
  			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если  Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен Тогда
		    Возврат Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
		ИначеЕсли  Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен Тогда
			Возврат Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ОплатаПроцентов;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ПустаяСсылка();
КонецФункции	

Функция РасчетПроцентов(ДатаНач, ДатаКон, ПроцентнаяСтавка, СуммаЗайма, ОкруглятьЦены, ВидОкругленияСуммыПроцентов = неопределено, ПорядокОкругления = неопределено , ОкруглятьВБольшуюСторону = неопределено) Экспорт
	Если НачалоДня(ДатаКон) = НачалоДня(ДатаНач)  Тогда
		КолДней = 1;
	Иначе	
		КолДней = (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24) + 1;
	КонецЕсли;	
	
	СуммаПроцентов = СуммаЗайма*ПроцентнаяСтавка/100;  	
	Если ОкруглятьЦены Тогда  
		Если ВидОкругленияСуммыПроцентов = Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеДоУмноженияНаКоличествоДней Тогда
			СуммаПроцентов = ОкруглитьЦену(СуммаПроцентов, ПорядокОкругления, ОкруглятьВБольшуюСторону)*КолДней;    
		ИначеЕсли ВидОкругленияСуммыПроцентов = Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеПослеУмноженияНаКоличествоДней Тогда	
			СуммаПроцентов = ОкруглитьЦену(СуммаПроцентов*КолДней, ПорядокОкругления, ОкруглятьВБольшуюСторону);
		КонецЕсли;
	Иначе
		СуммаПроцентов = СуммаПроцентов*КолДней;
	КонецЕсли;	
	Возврат СуммаПроцентов;
КонецФункции	

Функция ПолучитьСостояниеЗалоговогоБилета(ДокументОбъект, ЗалоговыйБилет, НаНачалоДня = ложь) Экспорт 
	Если НаНачалоДня Тогда
		ДатаДок = НачалоДня(ДокументОбъект.Дата);
		Если ДатаДок = ДокументОбъект.Дата Тогда
			ДатаДок = ДатаДок - 1; //ситуация когда документ сделан на начало дня
		КонецЕсли;	
		Если ДатаДок < ЗалоговыйБилет.Дата Тогда 
			ДатаДок = ЗалоговыйБилет.Дата;
		КонецЕсли;	
    Иначе
		Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда	 
			МоментДоДокумента = Новый Граница(Новый МоментВремени(ДокументОбъект.Дата, ДокументОбъект.Ссылка), ВидГраницы.Включая);  
			ДатаДок = МоментДоДокумента;  	
		Иначе	
		    ДатаДок = ДокументОбъект.Дата;	
		КонецЕсли;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерДопСоглашения КАК НомерДопСоглашения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ДатаНачалаРасчета", Выборка.ДатаНачалаРасчета); 
		СтруктураВозврата.Вставить("ДатаВыкупа", Выборка.ДатаВыкупа);
		СтруктураВозврата.Вставить("ДатаВыкупаЛьготныйСрок", Выборка.ДатаВыкупаЛьготныйСрок);
		СтруктураВозврата.Вставить("СуммаЗайма", Выборка.СуммаЗайма);
		СтруктураВозврата.Вставить("СтатусЗалоговогоБилета", Выборка.СтатусЗалоговогоБилета); 
		СтруктураВозврата.Вставить("ПричинаПрименения", Выборка.ПричинаПрименения); 
		СтруктураВозврата.Вставить("НомерДопСоглашения", Выборка.НомерДопСоглашения);
		
		Возврат СтруктураВозврата;
	КонецЕсли;
	Возврат неопределено;
КонецФункции

