			ДатаДок = МоментДоДокумента; 
		Иначе	
		    ДатаДок = ДокументОбъект.Дата;		
		КонецЕсли;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачалаРасчета);  
	Запрос.УстановитьПараметр("ДатаКон", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.УстановитьПараметр("ВидРасчета", Перечисления.ЛБ_ВидыРасчетов.ПоПроцентам);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	СУММА(ЛБ_РасчетыСКлиентамиОстатки.СуммаПриход) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.Обороты(
	               |			&ДатаНач,
	               |			&ДатаКон,
	               |			,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И ВидРасчета = &ВидРасчета) КАК ЛБ_РасчетыСКлиентамиОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиОстатки.ЗалоговыйБилет";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

