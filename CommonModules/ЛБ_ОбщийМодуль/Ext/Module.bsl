Функция ЗаполнитьДтКт(ВидОперации) Экспорт  	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Дт", "");
	СтруктураВозврата.Вставить("Кт", "");
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);   
	Если ТипЗнч(ВидОперации) = Тип("ПеречислениеСсылка.ЛБ_ВидыОперацийПКО") Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ЗначенияПоУмолчаниюДляПодстановкиПКО.Дт КАК Дт,
		               |	ЛБ_ЗначенияПоУмолчаниюДляПодстановкиПКО.Кт КАК Кт
		               |ИЗ
		               |	РегистрСведений.ЛБ_ЗначенияПоУмолчаниюДляПодстановкиПКО КАК ЛБ_ЗначенияПоУмолчаниюДляПодстановкиПКО
		               |ГДЕ
		               |	ЛБ_ЗначенияПоУмолчаниюДляПодстановкиПКО.ВидОперации = &ВидОперации";  		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			СтруктураВозврата.Дт = Выборка.Дт;
			СтруктураВозврата.Кт = Выборка.Кт;
		КонецЕсли;     
	ИначеЕсли ТипЗнч(ВидОперации) = Тип("ПеречислениеСсылка.ЛБ_ВидыОперацийРКО") Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ЗначенияПоУмолчаниюДляПодстановкиРКО.Дт КАК Дт,
		               |	ЛБ_ЗначенияПоУмолчаниюДляПодстановкиРКО.Кт КАК Кт
		               |ИЗ
		               |	РегистрСведений.ЛБ_ЗначенияПоУмолчаниюДляПодстановкиРКО КАК ЛБ_ЗначенияПоУмолчаниюДляПодстановкиРКО
		               |ГДЕ
		               |	ЛБ_ЗначенияПоУмолчаниюДляПодстановкиРКО.ВидОперации = &ВидОперации";  		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			СтруктураВозврата.Дт = Выборка.Дт;
			СтруктураВозврата.Кт = Выборка.Кт;
		КонецЕсли;     
	КонецЕсли;
	Возврат СтруктураВозврата;
КонецФункции    

Функция ПолучитьОткрытуюКассовуюСмену(Дата, Организация, Ломбард) Экспорт 
	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КассоваяСменаСрезПоследних.Период КАК Период,
	               |	ЛБ_КассоваяСменаСрезПоследних.КассоваяСмена КАК КассоваяСмена,
	               |	ЛБ_КассоваяСменаСрезПоследних.Статус КАК Статус,
	               |	ЛБ_КассоваяСменаСрезПоследних.ПКОСводный КАК ПКОСводный,
	               |	ЛБ_КассоваяСменаСрезПоследних.РКОСводный КАК РКОСводный,
	               |	ЛБ_КассоваяСменаСрезПоследних.Ответственный КАК Ответственный
	               |ИЗ
	               |	РегистрСведений.ЛБ_КассоваяСмена.СрезПоследних(
	               |			&Дата,
	               |			Организация = &Организация
	               |				И Ломбард = &Ломбард) КАК ЛБ_КассоваяСменаСрезПоследних"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда   
		Если Выборка.Статус = Перечисления.ЛБ_КассоваяСменаСтатус.Открыта Тогда
			СтруктураВ = Новый Структура;
		    СтруктураВ.Вставить("Дата", Выборка.Период); 
			СтруктураВ.Вставить("КассоваяСмена", Выборка.КассоваяСмена);
			СтруктураВ.Вставить("ПКОСводный", Выборка.ПКОСводный); 
			СтруктураВ.Вставить("РКОСводный", Выборка.РКОСводный);
			СтруктураВ.Вставить("Ответственный", Выборка.Ответственный);
			
			Возврат СтруктураВ; 
		Иначе   
			Возврат неопределено;
		КонецЕсли;	
	КонецЕсли;	
	Возврат неопределено;
КонецФункции

Функция СоздатьСводныйПКО(Дата, Организация, Ломбард) Экспорт  
	НовыйОбъект = Документы.ЛБ_ПриходныйКассовыйОрдер.СоздатьДокумент();
	НовыйОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.СводныйПКО;
	НовыйОбъект.Дата = Дата;
	НовыйОбъект.Организация = Организация; 
	НовыйОбъект.Ломбард = Ломбард;  
	НовыйОбъект.НомерПКО = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерПКО(НовыйОбъект.Дата, НовыйОбъект.Организация, НовыйОбъект.Ломбард);
	НовыйОбъект.ПредставлениеНомераПКО = СокрЛП(НовыйОбъект.Ломбард.НомерЛомбарда) + "/" + СокрЛП(НовыйОбъект.НомерПКО); 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;
	НовыйОбъект.Ответственный = Ответственный;
	
	Попытка
	    НовыйОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение    
		НовыйОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;	
	Возврат НовыйОбъект.Ссылка;
КонецФункции  

