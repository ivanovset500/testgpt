			|			ГДЕ
			|				ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Залогодатель = &Залогодатель
			|				И ВЫБОР
			|					КОГДА РАЗНОСТЬДАТ(ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период, ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия, ДЕНЬ) = 0
			|						ТОГДА ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период <= &Дата
			|					ИНАЧЕ ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия <= &Дата
			|				КОНЕЦ
			|				И ВЫБОР
			|					КОГДА ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
			|						ТОГДА ИСТИНА
			|					КОГДА ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаОкончанияДействия >= &Дата
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ЛОЖЬ
			|				КОНЕЦ
			|			УПОРЯДОЧИТЬ ПО
			|				ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период УБЫВ)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период УБЫВ";
	//-МАН
	
	Запрос.УстановитьПараметр("Дата", ПараметрыПоиска.Дата);
	Запрос.УстановитьПараметр("Залогодатель", ПараметрыПоиска.Залогодатель);
	Запрос.УстановитьПараметр("СхемаКредитования", МассивСхем);
	Запрос.УстановитьПараметр("ВидВставки", ПараметрыПоиска.ВидВставки);
	Запрос.УстановитьПараметр("ВидОгранки", МассивВидОгранки);
	Запрос.УстановитьПараметр("КачествоОгранки", МассивКачествоОгранки);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗапроса.Количество() <> 0 Тогда
		СтрокаЗапроса = ТаблицаЗапроса.Получить(0);
		//+МАН 14.11.24 Измен возврат результата. Заявка 2792
		//Если СтрокаЗапроса.ДатаОкончанияДействия >= ПараметрыПоиска.Дата ИЛИ СтрокаЗапроса.ДатаОкончанияДействия = Дата(1,1,1) Тогда
		//+МАН 25.08.25 Изменил
		//Если НЕ ЗначениеЗаполнено(СтрокаЗапроса.ОтменяемыйПриказ) Тогда
		Если СтрокаЗапроса.РегистраторВидОперации <> Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
		//-МАН
			Если СтрокаЗапроса.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
				Цена = БазоваяЦена * (1+СтрокаЗапроса.ЗначениеОтклонения/100);
			ИначеЕсли СтрокаЗапроса.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное Тогда
				Цена = БазоваяЦена + СтрокаЗапроса.ЗначениеОтклонения;
			КонецЕсли;
			
			//+МАН 10.12.25
			//Было: Возврат Цена;
			СтруктураВозврата = Новый Структура("Цена, ПриказВИПВставки");
			СтруктураВозврата.Цена = Цена;
			СтруктураВозврата.ПриказВИПВставки = СтрокаЗапроса.ПриказВИПВставки;
			
			Возврат СтруктураВозврата;
			//-МАН
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции	
