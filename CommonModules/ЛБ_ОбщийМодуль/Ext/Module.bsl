Функция ПроверитьСменаВидНаЖительствоВозраст(ДатаРождения, ДатаВыдачиДокумента) Экспорт 
	ТекстСообщения = "";
	Возраст = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);  
	Если Возраст >= 20 и Возраст < 45 Тогда 
	    ДатаРождения20 = ДобавитьМесяц(ДатаРождения, 12 * 20);
		Если ДатаВыдачиДокумента < ДатаРождения20 Тогда 
			ТекстСообщения = "Клиенту больше 20 лет, а бессрочный вид на жительство оформлен до достижения им этого возраста. Необходима смена вида на жительство.";
		КонецЕсли;	
	ИначеЕсли Возраст >= 45 Тогда 
		ДатаРождения45 = ДобавитьМесяц(ДатаРождения, 12 * 45);
		Если ДатаВыдачиДокумента < ДатаРождения45 Тогда 
			ТекстСообщения = "Клиенту больше 45 лет, а бессрочный вид на жительство оформлен до достижения им этого возраста. Необходима смена вида на жительство.";
		КонецЕсли;
	КонецЕсли;	  
	Возврат ТекстСообщения;
КонецФункции

Функция ПроверитьСменаВидНаЖительствоКонтактнаяИнформация(Клиент, ДатаВыдачиДокумента, ДатаОперации) Экспорт 
	ТекстСообщения = "";
	
	Запрос = новый Запрос; 
	Запрос.УстановитьПараметр("Клиент" , Клиент); 
	Запрос.УстановитьПараметр("Дата" , ДатаОперации);  	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Клиент
	               |				И ПричинаИзмененияФИО = Значение(Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИзменениеФИО)) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Если НачалоДня(Выборка.Период) > ДатаВыдачиДокумента тогда
			ТекстСообщения = "Клиент сменил ФИО " + Формат(Выборка.Период, "ДФ=dd.MM.yyyy") + ", а бессрочный вид на жительство оформлен " + Формат(ДатаВыдачиДокумента, "ДФ=dd.MM.yyyy") + ". Необходима смена вида на жительство.";
		КонецЕсли;	
	КонецЕсли;  
	Возврат ТекстСообщения;
КонецФункции	
	
Функция ПроверитьЕстьТолькоСпецСимволы(Строка) Экспорт
	СтрокаСпецСимволов = "№#;:()~""<>?,./!@%^&*-_+='[]{}|\";  
	
	СтрокаДляПроверки = СокрЛП(Строка);
	СтрокаДляПроверки = СтрЗаменить(СтрокаДляПроверки, " ", "");

	ТолькоСпецСимволы = Истина;   
	Для сч = 1 по СтрДлина(СокрЛП(СтрокаДляПроверки)) Цикл 
		Симв = Сред(СокрЛП(СтрокаДляПроверки), сч, 1);
		Поз = Найти(СтрокаСпецСимволов, Симв);
		Если Не Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		ТолькоСпецСимволы = Ложь;
		Прервать;
	Конеццикла;	 
	Возврат ТолькоСпецСимволы;
КонецФункции	

Функция ПолучитьМинимальнуюСуммуЗайма(Дата) Экспорт    
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_МинимальнаяСуммаЗаймаСрезПоследних.Сумма КАК Сумма
	               |ИЗ
	               |	РегистрСведений.ЛБ_МинимальнаяСуммаЗайма.СрезПоследних(&Дата, ) КАК ЛБ_МинимальнаяСуммаЗаймаСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Возврат Выборка.Сумма;
	КонецЕсли;	              
	Возврат 0;
КонецФункции	

Функция ПолучитьСлужебныеСтатусыКлиента(Дата, Клиент) Экспорт
	СписокСлужебныхСтатусов = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Клиент", Клиент); 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Используется Тогда 
			СписокСлужебныхСтатусов.Добавить(Выборка.Статус);
		КонецЕсли;	
	КонецЦикла;	
	Возврат СписокСлужебныхСтатусов;
КонецФункции	


Функция ПроверитьСлужебныйСтатус(Статус, ВидОперации) Экспорт  
	СтруктураРез = Новый Структура;
	СтруктураРез.Вставить("Запрет", ложь); 
	СтруктураРез.Вставить("Предупредить", "");
	ОтборС = Новый Структура("ВидОперации", ВидОперации);
	СтрокиС = Статус.ЗапретНаОперации.НайтиСтроки(ОтборС);
	Если НЕ СтрокиС.Количество() = 0 Тогда 
	    СтруктураРез.Запрет = Истина; 
	КонецЕсли;	  
	Если НЕ СтруктураРез.Запрет И Статус.Предупредить Тогда
		Информация = Статус.ДопИнформация.Получить(); 
		СтруктураРез.Предупредить = Информация.ПолучитьТекст();
	КонецЕсли;
		
	Возврат СтруктураРез;
КонецФункции

Функция ПроверитьЕстьРегламентноеНачислениеПроцентов(ДокументОбъект) Экспорт 
	СписокЛ = Новый СписокЗначений;  
	Для каждого Стр Из ДокументОбъект.Ломбарды Цикл
		СписокЛ.Добавить(Стр.Ломбард);
	Конеццикла;	

	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);   
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация); 
	Запрос.УстановитьПараметр("Ломбарды", СписокЛ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиБУ.Период КАК Период,
	               |	ЛБ_РасчетыСКлиентамиБУ.Регистратор КАК Регистратор,
	               |	ЛБ_РасчетыСКлиентамиБУ.Ломбард КАК Ломбард,
	               |	ЛБ_РасчетыСКлиентамиБУ.ЗалоговыйБилет.НомерЗалоговогоБилета КАК НомерЗБ
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентамиБУ КАК ЛБ_РасчетыСКлиентамиБУ
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентамиБУ.Период >= &Дата
	               |	И ЛБ_РасчетыСКлиентамиБУ.ВидРасчета = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыРасчетов.ПоПроцентам)
	               |	И ЛБ_РасчетыСКлиентамиБУ.Организация = &Организация";
	Если НЕ СписокЛ.Количество() = 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		  |	И ЛБ_РасчетыСКлиентамиБУ.Ломбард В(&Ломбарды)";  
	КонецЕсли;	
	Запрос.Текст = Запрос.Текст + "
	              |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиБУ.Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) И (Выборка.Регистратор = ДокументОбъект.Ссылка) Тогда 
			Продолжить;
		КонецЕсли;	
		Возврат "Найден документ " + Строка(Выборка.Регистратор) + ": (" + СокрЛП(Выборка.Ломбард) + ",  ЗБ № " + СокрЛП(Выборка.НомерЗБ) + ") с движениями по регламентному начислению процентов и с датой больше даты текущего документа.";
	КонецЦикла;
	Возврат "";     
	
КонецФункции	

//+Мельников 25.04.24 Отмена операции
Функция ПолучитьСостояниеЗБ(НомерЗалоговогоБилета, Дата, Поиск = Ложь, ОтменаОперации = Ложь) Экспорт

	Если Поиск ИЛИ ОтменаОперации Тогда
		СписокСтатусовЗБ = Новый СписокЗначений;
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен);
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен);   
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение);
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят);
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен);
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен);
		СписокСтатусовЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт);
		
		СписокВидовОперации = Новый СписокЗначений;
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты);
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВыдачиСОХ);
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия);
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВозвратаИзъятого);
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОстановкиНачисленияПроцентов);
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления);
		СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_СостояниеЗалоговогоБилета.Период КАК Период,
		|	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
		|	ЛБ_СостояниеЗалоговогоБилета.Залогодатель КАК Залогодатель,
		|	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет КАК ЗалоговыйБилет,
		|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилета.СхемаКредитования КАК СхемаКредитования,
		|	ЛБ_СостояниеЗалоговогоБилета.ПричинаПрименения КАК ПричинаПрименения,
		|	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
		|	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
		|	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения КАК НомерДопСоглашения,
		|	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
		|	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
		|	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
		|	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
		|	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
		|	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни,
		|	ЛБ_СостояниеЗалоговогоБилета.ДатаОстановкиНачислений КАК ДатаОстановкиНачислений
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
		|ГДЕ
		|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета ПОДОБНО &НомерЗалоговогоБилета
		|	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период"
		+ ?(Поиск, Символы.ПС    
		//+МАН 17.06.25 Изменил на поиск в регистре
		//+ "	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ДокументОтмены = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
		+ "	И НЕ ЛБ_СостояниеЗалоговогоБилета.Регистратор В (ВЫБРАТЬ
		|			ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
		|		ИЗ
		|			РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|		ГДЕ
		|			ЛБ_ОтменыОперацийЗБСрезПоследних.НомерЗалоговогоБилета ПОДОБНО &НомерЗалоговогоБилета)
		//-МАН
		|	И НЕ ЛБ_СостояниеЗалоговогоБилета.Регистратор.ВидОперации В (&СписокВидовОперации)
		|	И ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета В(&СписокСтатусовЗБ)"
		+ Символы.ПС, "")
		+ ?(ОтменаОперации, Символы.ПС  
		//+МАН 17.06.25 Изменил на поиск в регистре
		//+ "	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ДокументОтмены = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
		+ "	И НЕ ЛБ_СостояниеЗалоговогоБилета.Регистратор В (ВЫБРАТЬ
		|			ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
		|		ИЗ
		|			РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|		ГДЕ
		|			ЛБ_ОтменыОперацийЗБСрезПоследних.НомерЗалоговогоБилета ПОДОБНО &НомерЗалоговогоБилета)
		//-МАН
		|	И НЕ ЛБ_СостояниеЗалоговогоБилета.Регистратор.ВидОперации В (&СписокВидовОперации)"
		+ Символы.ПС, "")
		+ "
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ"; 
		
	Запрос.УстановитьПараметр("НомерЗалоговогоБилета", "%" + НомерЗалоговогоБилета + "%");
	Запрос.УстановитьПараметр("Период", Дата);
	Если Поиск ИЛИ ОтменаОперации Тогда
		Запрос.УстановитьПараметр("СписокВидовОперации", СписокВидовОперации);
		Запрос.УстановитьПараметр("СписокСтатусовЗБ", СписокСтатусовЗБ);
	КонецЕсли;

	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

КонецФункции

Функция ПолучитьЛомбардПользователя(Пользователь) Экспорт 
	Если Пользователь.ЭтоЛомбард Тогда   
		Возврат ПараметрыСеанса.ТекущийЛомбард;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ТекущийЛомбардПользователя.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ТекущийЛомбардПользователя КАК ЛБ_ТекущийЛомбардПользователя
		|ГДЕ
		|	ЛБ_ТекущийЛомбардПользователя.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат <> Неопределено Тогда
		Возврат Результат[0].Ломбард;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

//+Мельников 07.05.24 Взято с https://forum.infostart.ru/forum9/topic10769/ и адаптировано
Функция ПолучитьИмяТекущегоПользователяОСИИмяКомпьютера() Экспорт
	
	ТекущийПользовательОС = Неопределено;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Пользователь", ИмяПользователя());
	Отбор.Вставить("Событие", "_$Session$_.Authentication");
	Отбор.Вставить("Сеанс", НомерСеансаИнформационнойБазы());
	
	ТЗ = Новый ТаблицаЗначений();
	ВыгрузитьЖурналРегистрации(ТЗ, Отбор); //Было: , "Данные", , 1);
	
	Если ТЗ.Количество() > 0 Тогда
		Данные = ТЗ[ТЗ.Количество()-1];
		
		Если Данные <> Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("ТекущийПользовательОС", Данные.Данные.ТекущийПользовательОС);
			Результат.Вставить("Компьютер", Данные.Компьютер);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

