	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Если НачалоДня(Выборка.Период) = НачалоДня(Дата) Тогда
			СтруктураВ = Новый Структура;
			СтруктураВ.Вставить("ПКОСводный", Выборка.ПКОСводный); 
			СтруктураВ.Вставить("РКОСводный", Выборка.РКОСводный);
			
			Возврат СтруктураВ;
		КонецЕсли;	
	КонецЕсли;	                    
	Возврат неопределено;
КонецФункции

Функция ПолучитьОтделениеЛомбарда(Дата, Ломбард) Экспорт 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Ломбард", Ломбард); 
	Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
                   |ИЗ
                   |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Отделение;
	КонецЕсли;
	Возврат Справочники.ЛБ_ОтделенияЛомбардов.ПустаяСсылка();
КонецФункции	

Функция ПолучитьЛомбардыВОтделении(Дата, Отделение, ЛомбардИсключить = неопределено) Экспорт	
	СписокЛ = Новый СписокЗначений;   
	ДопСтрока = "                    ";
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Отделение", Отделение); 
	Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард,
                   |	ЛБ_ОтделенияЛомбардовСрезПоследних.Центральный КАК Центральный
                   |ИЗ
                   |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Отделение = &Отделение) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
                   |ГДЕ
                   |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт = ЛОЖЬ
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |	Ломбард
                   |АВТОУПОРЯДОЧИВАНИЕ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл   
		Если НЕ ЛомбардИсключить = неопределено Тогда
			Если Выборка.Ломбард = ЛомбардИсключить Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		СписокЛ.Добавить(Выборка.Ломбард, СокрЛП(Выборка.Ломбард)+ ?(Выборка.Центральный , " (ЦОЛ)", "") + ДопСтрока);
	КонецЦикла;
	Возврат СписокЛ;
КонецФункции

Функция ПроверитьЦОЛ(Дата, Ломбард) Экспорт
	Отделение = ПолучитьОтделениеЛомбарда(Дата, Ломбард);
	Если Не ЗначениеЗаполнено(Отделение) Тогда
		Возврат Ложь;
	Иначе
		Запрос = Новый Запрос;      
		Запрос.УстановитьПараметр("Ломбард", Ломбард);
		Запрос.УстановитьПараметр("Отделение", Отделение); 
		Запрос.УстановитьПараметр("Дата", Дата);
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	ЛБ_ОтделенияЛомбардовСрезПоследних.Центральный КАК Центральный
	                   |ИЗ
	                   |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	                   |			&Дата,
	                   |			Отделение = &Отделение
	                   |				И Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда  
			Если Выборка.Центральный тогда
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;	
		КонецЕсли;	 
		Возврат Ложь;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьНомерКассовогоЛиста(ДатаНач, ДатаКон, Организация, Ломбард) Экспорт  
	СтруктураВозврата = Новый Структура;
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ДатаНач", НачалоГода(ДатаКон));  
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаКон));
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	НАЧАЛОПЕРИОДА(ЛБ_ДвиженияДенежныхСредствОбороты.Период, ДЕНЬ) КАК День,
	               |	СУММА(ЛБ_ДвиженияДенежныхСредствОбороты.СуммаОборот) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств.Обороты(
	               |			&ДатаНач,
	               |			&ДатаКон,
	               |			День,
	               |			Организация = &Организация
	               |				И Ломбард = &Ломбард
	               |				И ВидДенежныхСредств = Значение(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)) КАК ЛБ_ДвиженияДенежныхСредствОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НАЧАЛОПЕРИОДА(ЛБ_ДвиженияДенежныхСредствОбороты.Период, ДЕНЬ)";
	КоличествоЛистовГод = 0;
	ПоследнийДеньКассовогоЛиста = Дата(1,1,1);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		КоличествоЛистовГод = КоличествоЛистовГод + 1; 
		ПоследнийДеньКассовогоЛиста = Выборка.День;
	Конеццикла;	       
	Если (НачалоДня(ДатаКон) = ПоследнийДеньКассовогоЛиста) ИЛИ НЕ (НачалоДня(ДатаНач) = НачалоДня(ДатаКон)) Тогда 
		СтруктураВозврата.Вставить("Номер", КоличествоЛистовГод); 
		СтруктураВозврата.Вставить("Дата", ПоследнийДеньКассовогоЛиста);
	    Возврат СтруктураВозврата;  
	КонецЕсли; 
    СтруктураВозврата.Вставить("Номер", 0); 
	СтруктураВозврата.Вставить("Дата", ДатаКон);
    Возврат СтруктураВозврата;     
КонецФункции	
	
Функция ПолучитьИмяФормыКорректировкиНакладных(Документ) Экспорт   
	Если Документ.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ИсключениеЗБИзНакладной Тогда  
		Возврат "ЛБ_ФормаИсключенияИзНакладнойНаОтгрузку"; 
	ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.БлокировкаВключенияЗБВНакладные Тогда 
		Возврат "ЛБ_ФормаБлокировкиЗалоговыхБилетов"; 
	ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтгрузкаНакладных Тогда 
		Возврат "ЛБ_ФормаОтгрузкиНакладных"; 
	ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтменаОтгрузкиНакладных Тогда 
		Возврат "ЛБ_ФормаОтменыОтгрузкиНакладных";  
	ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОплатаОтгруженногоЗБ Тогда 
		Возврат "ЛБ_ФормаОплатыОтгруженныхЗБ"; 	
	КонецЕсли;
	Возврат неопределено;
КонецФункции	

Функция ПолучитьЗБПоНомеру(НомерЗБ, БезОтмененных = Истина) Экспорт 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", НомерЗБ);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(, НомерЗалоговогоБилета = &Номер) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	
	Если  БезОтмененных Тогда
		Запрос.Текст = Запрос.Текст + "
	               |ГДЕ
	               |	 НЕ ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления)";
	КонецЕсли;  	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.ЗалоговыйБилет;
	КонецЕсли;                         
	Возврат Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка();
КонецФункции	

Функция ПроверитьРасчетыПоЗалоговомуБилету(Дата, ЗалоговыйБилет, Выкуп = Ложь) Экспорт 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗБ,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";	
	Выборка = Запрос.Выполнить().Выбрать();
	СуммаПроценты = 0;
	СуммаЗайм = 0;
	Если Выборка.Следующий() Тогда  
		СуммаЗайм = Выборка.СуммаЗайма;
		Результат = РасчитатьДолгПроценты(Дата, ЗалоговыйБилет, Выборка.СтатусЗБ, Выборка.ДатаНачалаРасчетаПроцентов, Выборка.ПричинаПрименения, Выкуп); 
		СуммаПроценты = Результат.СуммаПроценты;
	КонецЕсли; 
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ОстатокПроценты", СуммаПроценты); 
	СтруктураВ.Вставить("ОстатокЗайм", СуммаЗайм);
	Возврат СтруктураВ;
КонецФункции


Функция РасчитатьДолгПроценты(Дата, ЗалоговыйБилет, СтатусЗБ, ДатаНачалаРасчета, ПричинаПримененияПроцентнойСхемы, Выкуп = Ложь) Экспорт
	СуммаПроцентов = 0;
	
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет; 
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	ДокументОбъект.Дата = Дата; 
	ДокументОбъект.Организация = ЗалоговыйБилет.Организация;
	ДокументОбъект.ПроцентнаяСхема = ЗалоговыйБилет.ПроцентнаяСхема; 
	ДокументОбъект.Выкуп = Выкуп;    
	
	НачисленияОстановлены = Ложь;
	ДатаСмертиКлиента = ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(ЗалоговыйБилет.Залогодатель, Дата);   
	Если НЕ ДатаСмертиКлиента = неопределено Тогда   
		ПредыдущийСтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ДатаСмертиКлиента-1, ЗалоговыйБилет); 
		Если ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда 
			НачисленияОстановлены = Истина; 
		КонецЕсли; 
	КонецЕсли;
	
	Если НачисленияОстановлены ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда
		 СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(ДокументОбъект, ДокументОбъект.ПредыдущаяОперация);
			
		СтруктураВ = Новый Структура;
		СтруктураВ.Вставить("СуммаПроценты", СуммаПроцентов);  
		СтруктураВ.Вставить("ДокументОбъект", ДокументОбъект); 
	Иначе		
	
		СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
		Если НЕ СтруктураП = неопределено Тогда
		    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
			ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
		Иначе
			ПредельноеЗначениеПроцентов = 0;
		КонецЕсли;   
		СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
		Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
			
		Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр); 
		
		СтруктураВ = Новый Структура;
		СтруктураВ.Вставить("СуммаПроценты", Результат.СуммаПроцентов);  
		СтруктураВ.Вставить("ДокументОбъект", ДокументОбъект);  
	КонецЕсли;	
  
	Возврат СтруктураВ;
КонецФункции

Функция ПолучитьИтоговыйСтатусБезналичногоПлатежа(Дата, РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ) Экспорт 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ); 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа КАК СтатусПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
	               |			&Дата,
	               |			РеестрПлатежей = &РеестрПлатежей
	               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда 
		Если Выборка.Регистратор = РеестрПлатежей Тогда 
			Возврат Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка();
		Иначе	
		    Возврат Выборка.СтатусПлатежа;
		КонецЕсли;   
	КонецЕсли;                         
	Возврат Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка();
КонецФункции	

Функция ПолучитьИтоговыйСтатусПереплаты(РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ) Экспорт 
