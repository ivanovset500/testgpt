Функция ПолучитьСсылкуЛомбарда() Экспорт

	//Например по ломбарду №142:
	//Имя компьютера - "L-142-645445"
	//Имя пользователя - "lk-142l"
	//IP - 10.0.142.10

	ПользовательИКомпьютер = ЛБ_ОбщийМодуль.ПолучитьИмяТекущегоПользователяОСИИмяКомпьютера();
	IPКомпьютера = ЛБ_ОбщийМодуль.ПолучитьIPКомпьютера();

	Если ТипЗнч(ПользовательИКомпьютер) = Тип("Структура") Тогда
		НомерЛомбардаОтКомпьютера = Сред(ПользовательИКомпьютер.Компьютер, СтрНайти(ПользовательИКомпьютер.Компьютер, "-")+1, 3);
		НомерЛомбардаОтПользователя = Сред(ПользовательИКомпьютер.ТекущийПользовательОС, СтрНайти(ПользовательИКомпьютер.ТекущийПользовательОС, "-")+1, 3);
	КонецЕсли;
	
	Если IPКомпьютера <> "" Тогда 
		НомерЛомбардаОтIP = Сред(IPКомпьютера, СтрНайти(IPКомпьютера, ".",,,2)+1, 3);
	КонецЕсли;
	
	Если НомерЛомбардаОтПользователя = НомерЛомбардаОтКомпьютера Тогда
		НомерЛомбарда = НомерЛомбардаОтПользователя;
	Иначе
		НомерЛомбарда = Неопределено;
	КонецЕсли;

	//Можно добавить проверку номеров для последующей выдачи сообщения.
	
	ЛомбардСсылка = Справочники.ЛБ_Ломбарды.НайтиПоРеквизиту("НомерЛомбарда", НомерЛомбарда);

	Возврат ЛомбардСсылка;
	
КонецФункции
