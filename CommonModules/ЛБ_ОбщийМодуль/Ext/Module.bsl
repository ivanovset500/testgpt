	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейПереплатаСрезПоследних.СтатусПлатежа КАК СтатусПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплатаСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежейПереплаты.СрезПоследних(
	               |			,
	               |			РеестрПлатежей = &РеестрПлатежей
	               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РеестрБезначныхПлатежейПереплатаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейПереплатаСрезПоследних.Период УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда 
		Если Выборка.Регистратор = РеестрПлатежей Тогда 
			Возврат Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка();
		Иначе	
		    Возврат Выборка.СтатусПлатежа;
		КонецЕсли;   
	КонецЕсли;                         
	Возврат Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка();
КонецФункции	

Функция ПолучитьСостояниеБезналичногоПлатежа(Дата, РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ) Экспорт  
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ЗалоговыйБилет"); 
	СтруктураВ.Вставить("СтатусПлатежа");
	СтруктураВ.Вставить("ОплатаПроценты");
	СтруктураВ.Вставить("ОплатаЗайм");
	СтруктураВ.Вставить("Переплата");
	СтруктураВ.Вставить("Возврат");
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ); 
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("ПустойСтатус", Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ВЫБОР
	               |		КОГДА ЛБ_РеестрБезначныхПлатежейСрезПоследних.Регистратор ССЫЛКА Документ.ЛБ_РеестрПлатежей
	               |			ТОГДА &ПустойСтатус
	               |		ИНАЧЕ ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа
	               |	КОНЕЦ КАК СтатусПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ОплатаПроценты КАК ОплатаПроценты,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ОплатаЗайм КАК ОплатаЗайм,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата КАК Переплата,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Возврат КАК Возврат
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
	               |			&Дата,
	               |			РеестрПлатежей = &РеестрПлатежей
	               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних";		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда  
		СтруктураВ.Вставить("ЗалоговыйБилет", Выборка.ЗалоговыйБилет); 
		СтруктураВ.Вставить("СтатусПлатежа", Выборка.СтатусПлатежа);
		СтруктураВ.Вставить("ОплатаПроценты", Выборка.ОплатаПроценты);
		СтруктураВ.Вставить("ОплатаЗайм", Выборка.ОплатаЗайм);
		СтруктураВ.Вставить("Переплата", Выборка.Переплата);
		СтруктураВ.Вставить("Возврат", Выборка.Возврат);
	КонецЕсли;                         
	Возврат СтруктураВ;
КонецФункции

Функция ПолучитьСтатусыБезналичныхПлатежей(Дата = неопределено, РеестрПлатежей) Экспорт   
	Если Дата = неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа КАК СтатусПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.НомерЗБ КАК НомерЗБ,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа КАК ДатаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СуммаПлатежа КАК СуммаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(&Дата, РеестрПлатежей = &РеестрПлатежей) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних";
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция ПолучитьСтатусыБезналичныхПлатежейПереплата(Дата = неопределено, РеестрПлатежей) Экспорт   
	Если Дата = неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ПереплатаНачальная КАК ПереплатаНачальная,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.СтатусПлатежа КАК СтатусПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.НомерЗБ КАК НомерЗБ,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ДатаПлатежа КАК ДатаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.СуммаПлатежа КАК СуммаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ЗалоговыйБилет КАК ЗалоговыйБилет
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежейПереплаты КАК ЛБ_РеестрБезначныхПлатежейПереплаты
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.РеестрПлатежей = &РеестрПлатежей
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.Период < &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.Период УБЫВ";
    ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаНачальныхПереплат = ТаблицаЗапроса.Скопировать(); 
	ТаблицаНачальныхПереплат.Свернуть("ПереплатаНачальная");
	ТаблицаСтатусов = ТаблицаЗапроса.Скопировать(); 
	ТаблицаСтатусов.Очистить();
	Для Каждого Стр Из ТаблицаНачальныхПереплат Цикл	
		Отбор = новый Структура;
		Отбор.Вставить("ПереплатаНачальная", Стр.ПереплатаНачальная);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если Строки.Количество() > 1 Тогда
			СтрЗ = Строки.Получить(0);
			Если СтрЗ.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Выборка = Строки.Получить(0);
		Стр = ТаблицаСтатусов.Добавить();
		Стр.ДатаПлатежа = Выборка.ДатаПлатежа;
		Стр.ИдентификаторПлатежа = Выборка.ИдентификаторПлатежа;
		Стр.НомерЗБ = Выборка.НомерЗБ;  
		Стр.СуммаПлатежа = Выборка.СуммаПлатежа; 
		Стр.СтатусПлатежа = Выборка.СтатусПлатежа; 
		Стр.ПереплатаНачальная = Выборка.ПереплатаНачальная;
		Стр.ЗалоговыйБилет = Выборка.ЗалоговыйБилет; 
	Конеццикла;  
    Возврат ТаблицаСтатусов;
КонецФункции	

Функция ПроверитьЕстьОплатыКасса(ВидОперацииРеестра, ДатаРеестра, ДатаПлатежа, ЗалоговыйБилет) Экспорт
	Запрос = Новый Запрос; 
	Если ВидОперацииРеестра = Перечисления.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет Тогда
		Запрос.УстановитьПараметр("Дата", КонецДня(ДатаПлатежа)-9);
		Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
		Запрос.УстановитьПараметр("Пусто", Документы.ЛБ_РеестрПлатежей.ПустаяСсылка());
		Запрос.Текст = "ВЫБРАТЬ
		                |	ЛБ_ОборотыПоОперациямЗайма.Регистратор КАК Регистратор
		                |ИЗ
		                |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
		                |ГДЕ
		                |	ЛБ_ОборотыПоОперациямЗайма.Период > &Дата
		                |	И ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = &ЗалоговыйБилет
		                |	И ЛБ_ОборотыПоОперациямЗайма.РеестрПлатежей = &Пусто
		                |	И ЛБ_ОборотыПоОперациямЗайма.ВидОперации = Значение(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)";
		Выборка  = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Истина;
		КонецЕсли;					
	ИначеЕсли ВидОперацииРеестра = Перечисления.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет Тогда
        Запрос.УстановитьПараметр("Дата1", ДатаПлатежа); 
		Запрос.УстановитьПараметр("Дата2", ДатаРеестра);
		Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
		Запрос.УстановитьПараметр("Пусто", Документы.ЛБ_РеестрПлатежей.ПустаяСсылка());
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор КАК Регистратор
		               |ИЗ
		               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
		               |ГДЕ
		               |	ЛБ_ОборотыПоОперациямЗайма.Период МЕЖДУ &Дата1 И &Дата2
		               |	И ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = &ЗалоговыйБилет
		               |	И ЛБ_ОборотыПоОперациямЗайма.РеестрПлатежей = &Пусто
		               |	И ЛБ_ОборотыПоОперациямЗайма.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)";
		Выборка  = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Истина;
		КонецЕсли;				
	КонецЕсли;
	Возврат Ложь;
КонецФункции  

Функция ПроверитьЕстьОплатыБН(ДатаПлатежа, ЗалоговыйБилет) Экспорт
	ЗапросC = Новый Запрос;
	ЗапросC.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	ЗапросC.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа КАК СтатусПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
	               |			,
	               |			РеестрПлатежей = &РеестрПлатежей
	               |				И ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних";
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаПлатежа);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗайма.РеестрПлатежей КАК РеестрПлатежей
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	               |ГДЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период > &Дата
	               |	И ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_ОборотыПоОперациямЗайма.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)
	               |	И ЛБ_ОборотыПоОперациямЗайма.РеестрПлатежей.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет)";
	Выборка  = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапросC.УстановитьПараметр("РеестрПлатежей", Выборка.РеестрПлатежей);     
		ВыборкаС = ЗапросC.Выполнить().Выбрать();
		Если ВыборкаС.Следующий() Тогда  
			Если ВыборкаС.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью ИЛИ
				 ВыборкаС.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично Тогда  
				Возврат Истина; 
			КонецЕсли;	 
		КонецЕсли;	
	КонецЦикла;					
	Возврат Ложь;
КонецФункции


Функция ПроверитьЕстьОплатыРегламентныеНачисленияОтменаБН(ДатаПлатежа, ЗалоговыйБилет) Экспорт  
	СтруктураВозврата = Новый Структура;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаПлатежа);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентами.Период КАК Период,
	               |	ЛБ_РасчетыСКлиентами.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	СУММА(ЛБ_РасчетыСКлиентами.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами КАК ЛБ_РасчетыСКлиентами
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентами.Период > &Дата
	               |	И ЛБ_РасчетыСКлиентами.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_РасчетыСКлиентами.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |	И ЛБ_РасчетыСКлиентами.Сумма > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентами.ЗалоговыйБилет,
	               |	ЛБ_РасчетыСКлиентами.Период";
	Выборка  = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		СтруктураВозврата.Вставить("Период", Выборка.Период);
		СтруктураВозврата.Вставить("Вид", 0); 
		
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиБУ.Период КАК Период,
	               |	ЛБ_РасчетыСКлиентамиБУ.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	СУММА(ЛБ_РасчетыСКлиентамиБУ.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентамиБУ КАК ЛБ_РасчетыСКлиентамиБУ
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентамиБУ.Период > &Дата
	               |	И ЛБ_РасчетыСКлиентамиБУ.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_РасчетыСКлиентамиБУ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |	И ЛБ_РасчетыСКлиентамиБУ.Сумма > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиБУ.ЗалоговыйБилет,
	               |	ЛБ_РасчетыСКлиентамиБУ.Период";
	Выборка  = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		СтруктураВозврата.Вставить("Период", Выборка.Период);
		СтруктураВозврата.Вставить("Вид", 1); 
		Возврат СтруктураВозврата;
	КонецЕсли;	
	
	Возврат неопределено;
КонецФункции


Функция ПроверитьЕстьПлатежиЛКДляОтмены(ДатаПлатежа, ЗалоговыйБилет) Экспорт  	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа); 
	Запрос.УстановитьПараметр("ПустойСтатус", Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.РеестрПлатежей КАК РеестрПлатежей,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.НомерЗБ КАК НомерЗБ,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа КАК ДатаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СуммаПлатежа КАК СуммаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа КАК СтатусПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДокументОплаты КАК ДокументОплаты,
	               |	&ПустойСтатус КАК СтатусПереплаты
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.РеестрПлатежей.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет)
	               |	И ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа >= &ДатаПлатежа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Период УБЫВ"; 
    ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();   
	УдСтроки = Новый СписокЗначений;
	Для каждого Выборка из ТаблицаЗапроса Цикл  
		Если НЕ Выборка.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью И
			 НЕ Выборка.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично И
			 НЕ Выборка.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено И
			 НЕ Выборка.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы Тогда 
			УдСтроки.Добавить(Выборка);  
			Продолжить;
		КонецЕсли;	 
		Выборка.СтатусПереплаты = ПолучитьИтоговыйСтатусПереплаты(Выборка.РеестрПлатежей, Выборка.ИдентификаторПлатежа, Выборка.ДатаПлатежа, Выборка.НомерЗБ);
		//	СтруктураВозврата = Новый Структура; 
		//	СтруктураВозврата.Вставить("РеестрПлатежей", Выборка.РеестрПлатежей); 
		//	СтруктураВозврата.Вставить("НомерЗБ", Выборка.НомерЗБ);
		//	СтруктураВозврата.Вставить("ДатаПлатежа", Выборка.ДатаПлатежа);
		//	СтруктураВозврата.Вставить("ИдентификаторПлатежа", Выборка.ИдентификаторПлатежа);
		//	СтруктураВозврата.Вставить("СуммаПлатежа", Выборка.СуммаПлатежа);
		//	СтруктураВозврата.Вставить("СтатусПлатежа", Выборка.СтатусПлатежа); 
		//	СтруктураВозврата.Вставить("ДокументОплаты", Выборка.ДокументОплаты); 
		//	СтруктураВозврата.Вставить("СтатусПереплаты", ПолучитьИтоговыйСтатусПереплаты(Выборка.РеестрПлатежей, Выборка.ИдентификаторПлатежа, Выборка.ДатаПлатежа, Выборка.НомерЗБ));
		//	Возврат СтруктураВозврата;
		//КонецЕсли;	
	КонецЦикла; 
	
	Для каждого Эл Из Удстроки Цикл 
		ТаблицаЗапроса.Удалить(Эл.Значение);
	Конеццикла;	
	Возврат ТаблицаЗапроса;
КонецФункции
	
Функция РассчитатьОстатокПереплатыБезналичногоПлатежа(Дата, РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ) Экспорт 
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ); 
	Запрос.УстановитьПараметр("Дата", Дата);   
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата КАК Переплата
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
	               |			&Дата,
	               |			РеестрПлатежей = &РеестрПлатежей
	               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Период УБЫВ";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
        ПереплатаОстаток = Выборка.Переплата;   
		Если НЕ ПереплатаОстаток = 0 Тогда
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_РаспределениеПереплаты.ОплатаПроценты КАК ОплатаПроценты,
			               |	ЛБ_РаспределениеПереплаты.ОплатаЗайм КАК ОплатаЗайм,
			               |	ЛБ_РаспределениеПереплаты.Возвращено КАК Возвращено,
			               |	ЛБ_РаспределениеПереплаты.ВДоходы КАК ВДоходы
			               |ИЗ
			               |	РегистрНакопления.ЛБ_РаспределениеПереплаты КАК ЛБ_РаспределениеПереплаты
			               |ГДЕ
			               |	ЛБ_РаспределениеПереплаты.Период <= &Дата
			               |	И ЛБ_РаспределениеПереплаты.РеестрПлатежей = &РеестрПлатежей
			               |	И ЛБ_РаспределениеПереплаты.НомерЗБ = &НомерЗБ
			               |	И ЛБ_РаспределениеПереплаты.ДатаПлатежа = &ДатаПлатежа
			               |	И ЛБ_РаспределениеПереплаты.ИдентификаторПлатежа = &ИдентификаторПлатежа"; 
			ВыборкаП = Запрос.Выполнить().Выбрать();  
			ПереплатаРаспределенная = 0;
			Пока ВыборкаП.Следующий() Цикл 
				Если ЗначениеЗаполнено(ВыборкаП.ОплатаПроценты) Тогда 
					ПереплатаРаспределенная = ПереплатаРаспределенная + ВыборкаП.ОплатаПроценты;
				КонецЕсли;	  
				Если ЗначениеЗаполнено(ВыборкаП.ОплатаЗайм) Тогда 
					ПереплатаРаспределенная = ПереплатаРаспределенная + ВыборкаП.ОплатаЗайм;
				КонецЕсли;	
                Если ЗначениеЗаполнено(ВыборкаП.Возвращено) Тогда 
					ПереплатаРаспределенная = ПереплатаРаспределенная + ВыборкаП.Возвращено;
				КонецЕсли;	
                Если ЗначениеЗаполнено(ВыборкаП.ВДоходы) Тогда 
					ПереплатаРаспределенная = ПереплатаРаспределенная + ВыборкаП.ВДоходы;
				КонецЕсли;	 
			КонецЦикла;	     
			Возврат ПереплатаОстаток - ПереплатаРаспределенная;
		КонецЕсли;	
	КонецЕсли;
	Возврат 0;
КонецФункции	

Функция ПолучитьПредельныйСрокЗаймаДата(ЗалоговыйБилет) Экспорт 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Регистратор", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор = &Регистратор"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПредельныйСрокЗайма;
	КонецЕсли;
	Возврат неопределено;
	
КонецФункции	

Функция ПолучитьСостояниеЗБПриОтменеБезналичнойОплаты(ЗалоговыйБилет,  ОтмененныйДокумент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Залогодатель КАК Залогодатель,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СхемаКредитования КАК СхемаКредитования,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерДопСоглашения КАК НомерДопСоглашения,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовДень КАК СуммаПроцентовДень,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаОстановкиНачислений КАК ДатаОстановкиНачислений,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Период, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
		 		
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.УстановитьПараметр("Период", Новый Граница(Новый МоментВремени(ОтмененныйДокумент.Дата, ОтмененныйДокумент.Ссылка), ВидГраницы.Исключая)); 

	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

КонецФункции

Функция ПолучитьПроцентнуюСхемуЗБ(ЗалоговыйБилет, ПричинаПрименения) Экспорт
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.УстановитьПараметр("ПричинаПрименения", ПричинаПрименения);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГрафикПлатежей.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
	               |	ЛБ_ГрафикПлатежей.ВидПроцентнойСтавки КАК ВидПроцентнойСтавки,
	               |	ЛБ_ГрафикПлатежей.ПроцентнаяСтавкаБазовая КАК ПроцентнаяСтавкаБазовая,
	               |	ЛБ_ГрафикПлатежей.ПроцентнаяСтавкаАкция КАК ПроцентнаяСтавкаАкция,
	               |	ЛБ_ГрафикПлатежей.ОтклонениеАкцияОтностельное КАК ОтклонениеАкцияОтностельное,
	               |	ЛБ_ГрафикПлатежей.ОтклонениеАкцияАбсолютное КАК ОтклонениеАкцияАбсолютное
	               |ИЗ
	               |	РегистрСведений.ЛБ_ГрафикПлатежей КАК ЛБ_ГрафикПлатежей
	               |ГДЕ
	               |	ЛБ_ГрафикПлатежей.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_ГрафикПлатежей.ПричинаПрименения = &ПричинаПрименения
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДеньНачалаПрименения";
	Выборка = Запрос.Выполнить().Выбрать(); 
	Если Выборка.Следующий() Тогда  
		ПроцентнаяСхема = Выборка.ПроцентнаяСтавкаБазовая; 
		Если Выборка.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
			Если НЕ Выборка.ПроцентнаяСтавкаАкция = 0 Тогда
				ПроцентнаяСхема = Выборка.ПроцентнаяСтавкаАкция;
			ИначеЕсли НЕ Выборка.ОтклонениеАкцияОтносительное = 0 Тогда	 
				ПроцентнаяСхема = Выборка.ПроцентнаяСтавкаБазовая + Выборка.ПроцентнаяСтавкаБазовая*Выборка.ОтклонениеАкцияОтносительное/100;
			ИначеЕсли НЕ Выборка.ОтклонениеАкцияАбсолютное = 0 Тогда
				ПроцентнаяСхема = Выборка.ПроцентнаяСтавкаБазовая + Выборка.ОтклонениеАкцияАбсолютное;
		    КонецЕсли; 
		КонецЕсли;
        Возврат ПроцентнаяСхема;
	КонецЕсли;
	Возврат 0;
КонецФункции	

Процедура ПеревестиПриказыРежимРаботыВАрхив() Экспорт 
	Если НЕ ЛБ_ОбщийМодуль.ЭтоРабочаяБаза() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказРежимРаботы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЛБ_ПриказРежимРаботы КАК ЛБ_ПриказРежимРаботы
	               |ГДЕ
	               |	НАЧАЛОПЕРИОДА(ЛБ_ПриказРежимРаботы.ДатаОкончания, ДЕНЬ) < &ДатаОкончания
	               |	И ЛБ_ПриказРежимРаботы.Архив = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ТекущаяДата()));
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка.ДатаОкончания) Тогда
			Об = Выборка.Ссылка.ПолучитьОбъект(); 
			Об.Архив = Истина;
			Об.Статус = Перечисления.ЛБ_СтатусыПриказовРежимРаботы.Архив;
			Об.Записать();	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Функция ПолучитьФИО(Клиент, Дата = неопределено) Экспорт 
	ФИО = "";	
	Запрос = новый Запрос; 
	Запрос.УстановитьПараметр("Клиент" , Клиент); 
	Запрос.УстановитьПараметр("Дата" , ?(Дата = неопределено, ТекущаяДатаСеанса(), Дата));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда   
		ФИО = СокрЛП(Выборка.Фамилия) + " " + СокрЛП(Выборка.Имя) +  ?(НЕ ПустаяСтрока(Выборка.Отчество), " " + СокрЛП(Выборка.Отчество), "");
	КонецЕсли;  
	Возврат ФИО;
КонецФункции	  

Функция ПолучитьСотрудника(Ответственный) Экспорт 
	Если ТипЗнч(Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда
		Возврат Ответственный.Сотрудник;
	ИначеЕсли ТипЗнч(Ответственный) = Тип("СправочникСсылка.ЛБ_Сотрудники") Тогда
		Возврат Ответственный;
	Иначе	
	    Возврат неопределено;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьСписокВыбораСкладовДляПеремещения(ВидПеремещения, Откуда, Куда, Направление, ВидСкладаНаправление) Экспорт
	Если Откуда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
	    ДвижениеОткуда = Перечисления.ЛБ_ДвиженияОбъектовЗалога.ЦО;
	Иначе   
		ДвижениеОткуда = Перечисления.ЛБ_ДвиженияОбъектовЗалога.Ломбард;
	КонецЕсли;	
	Если Куда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
	    ДвижениеКуда = Перечисления.ЛБ_ДвиженияОбъектовЗалога.ЦО;
	ИначеЕсли ТипЗнч(Куда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
	    ДвижениеКуда = Перечисления.ЛБ_ДвиженияОбъектовЗалога.Контрагент; 
	Иначе	
		ДвижениеКуда = Перечисления.ЛБ_ДвиженияОбъектовЗалога.Ломбард;
	КонецЕсли;	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ВидПеремещения", ВидПеремещения);
	Запрос.УстановитьПараметр("Откуда", ДвижениеОткуда);
    Запрос.УстановитьПараметр("Куда", ДвижениеКуда);
	Запрос.Текст = "ВЫБРАТЬ
	                |	ЛБ_ПравилаПеремещенияОбъектовЗалога.ВидСкладаОткуда КАК ВидСкладаОткуда,
	                |	ЛБ_ПравилаПеремещенияОбъектовЗалога.ВидСкладаКуда КАК ВидСкладаКуда
	                |ИЗ
	                |	РегистрСведений.ЛБ_ПравилаПеремещенияОбъектовЗалога КАК ЛБ_ПравилаПеремещенияОбъектовЗалога
	                |ГДЕ
	                |	ЛБ_ПравилаПеремещенияОбъектовЗалога.ВидПеремещения = &ВидПеремещения
	                |	И ЛБ_ПравилаПеремещенияОбъектовЗалога.Откуда = &Откуда
	                |	И ЛБ_ПравилаПеремещенияОбъектовЗалога.Куда = &Куда";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	ВидыСклада = Новый СписокЗначений; 
	СписокСкладов = Новый Массив;
	Если Направление = "Откуда" Тогда
	    Запрос.УстановитьПараметр("Владелец", Откуда);
		Для каждого Стр Из ТаблицаЗапроса Цикл     
			Если ЗначениеЗаполнено(Стр.ВидСкладаОткуда) Тогда 
				Если ЗначениеЗаполнено(ВидСкладаНаправление) Тогда
					Если НЕ ВидСкладаНаправление = Стр.ВидСкладаКуда  Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				Если ВидыСклада.НайтиПоЗначению(Стр.ВидСкладаОткуда) = неопределено Тогда
			        ВидыСклада.Добавить(Стр.ВидСкладаОткуда);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	Иначе   
		Запрос.УстановитьПараметр("Владелец", Куда);
		Для каждого Стр Из ТаблицаЗапроса Цикл     
			Если ЗначениеЗаполнено(Стр.ВидСкладаКуда) Тогда 
				Если ЗначениеЗаполнено(ВидСкладаНаправление) Тогда
					Если НЕ ВидСкладаНаправление = Стр.ВидСкладаОткуда  Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;	    
				Если ВидыСклада.НайтиПоЗначению(Стр.ВидСкладаКуда) = неопределено Тогда
			        ВидыСклада.Добавить(Стр.ВидСкладаКуда); 
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Склады.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
	               |ГДЕ
	               |	ЛБ_Склады.Владелец = &Владелец
	               |	И ЛБ_Склады.ПометкаУдаления = ЛОЖЬ";
	Если НЕ ВидыСклада.Количество() = 0 Тогда 
		Запрос.Текст = Запрос.Текст + "
	               |	И ЛБ_Склады.ВидСклада В(&ВидыСклада)";  
		Запрос.УстановитьПараметр("ВидыСклада", ВидыСклада);
	КонецЕсли;	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если СписокСкладов.Найти(Выборка.Ссылка) = неопределено Тогда
		    СписокСкладов.Добавить(Выборка.Ссылка); 
		КонецЕсли;	
	КонецЦикла;	                             
	Возврат СписокСкладов;
КонецФункции	

Функция ПолучитьСклад(Владелец, ВидСклада) Экспорт 
	Запрос = новый Запрос; 
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("ВидСклада", ВидСклада);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Склады.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
	               |ГДЕ
	               |	ЛБ_Склады.Владелец = &Владелец
	               |	И ЛБ_Склады.ВидСклада = &ВидСклада";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда 
		Возврат Выборка.Ссылка;
	КонецЕсли;	               
	Возврат неопределено;
КонецФункции	

Функция ПолучитьСписокВыбораСкладов(Ломбард) Экспорт  
	СписокСкладов = Новый Массив;
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Склады.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
	               |ГДЕ
	               |	ЛБ_Склады.Владелец = &Владелец
	               |	И ЛБ_Склады.ПометкаУдаления = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если СписокСкладов.Найти(Выборка.Ссылка) = неопределено Тогда
		    СписокСкладов.Добавить(Выборка.Ссылка); 
		КонецЕсли;	
	КонецЦикла;	                             
	Возврат СписокСкладов;
КонецФункции	


Процедура РегЗадание_ПересчетРежимовРаботыЛомбардов() Экспорт 
	Если НЕ ЛБ_ОбщийМодуль.ЭтоРабочаяБаза() Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_Ломбарды.Ссылка КАК Ссылка
	              |ИЗ
	              |	Справочник.ЛБ_Ломбарды КАК ЛБ_Ломбарды
	              |ГДЕ
	              |	ЛБ_Ломбарды.Закрыт = Ложь";
	тзЛомбарды = Запрос.Выполнить().Выгрузить();
	тзЛомбарды.Свернуть("Ссылка");
	МассивЛомб = тзЛомбарды.ВыгрузитьКолонку("Ссылка"); 
	
	ПересчетРежимовРаботыЛомбардов(МассивЛомб, 1000, Истина);
	
КонецПроцедуры

&НаСервере                                                        
Процедура ПересчетРежимовРаботыЛомбардов(СписокЛомбардов, КоличествоДнейРасчета, ОчищатьВсе) Экспорт 
	Если ОчищатьВсе Тогда
		Набор = РегистрыСведений.ЛБ_РабочиеДниЛомбарда.СоздатьНаборЗаписей();
		Набор.Записать();  
	КонецЕсли;
	
	Для каждого Ломбард из СписокЛомбардов Цикл 
		
		Набор = РегистрыСведений.ЛБ_РабочиеДниЛомбарда.СоздатьНаборЗаписей();
		Набор.Отбор.Ломбард.Установить(Ломбард);
		Набор.Записать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка КАК Ссылка,
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.Статус КАК Статус,
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.ВидПриказа КАК ВидПриказа,
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.ДатаНачала КАК ДатаНачала,
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Документ.ЛБ_ПриказРежимРаботы.РежимРаботы КАК ЛБ_ПриказРежимРаботыРежимРаботы
		|ГДЕ
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ломбард = &Ломбард
		|	И ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.Проведен = Истина
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.ДатаНачала";
		
		Запрос.УстановитьПараметр("Ломбард", Ломбард); 
		//Запрос.УстановитьПараметр("СтатусПроект", Перечисления.ЛБ_СтатусыПриказовРежимРаботы.Проект);
		
		тзПриказов = запрос.Выполнить().Выгрузить();
		
		Для каждого СтрокаПриказа из тзПриказов Цикл
			Приказ = СтрокаПриказа.Ссылка;

			Если СтрокаПриказа.Ссылка.Проведен Тогда 
				 Если ЗначениеЗаполнено(Приказ.ДатаОкончания) Тогда
					 КоличествоДнейВперед = (НачалоДня(СтрокаПриказа.ДатаОкончания) - НачалоДня(СтрокаПриказа.ДатаНачала))/86400;
				 Иначе
					 КоличествоДнейВперед = КоличествоДнейРасчета; 
				 КонецЕсли;
				
				
				тзЛомбарды = Приказ.РежимРаботы.Выгрузить(,"Ломбард");
				тзЛомбарды.Свернуть("Ломбард");
				
				Для каждого строч из тзЛомбарды Цикл
					Если строч.Ломбард <> Ломбард Тогда
						ПРодолжить;
					КонецЕсли;
					
					отб = Новый Структура;
					отб.Вставить("ломбард", строч.Ломбард);
					НайденныеСтроки = Приказ.РежимРаботы.НайтиСтроки(отб); 
					Для каждого стр из НайденныеСтроки Цикл
						Для инд = 0 по КоличествоДнейВперед Цикл
							ДатаВРегистр = НачалоДня(СтрокаПриказа.ДатаНачала) + 86400*инд; 
							Если ДеньНедели(ДатаВРегистр) = стр.НомерДня Тогда
								
								Движ = РегистрыСведений.ЛБ_РабочиеДниЛомбарда.СоздатьМенеджерЗаписи();
								Движ.Период = ДатаВРегистр;
								Движ.Приказ = Приказ;
								Движ.Выходной = стр.Выходной;
								Движ.Ломбард = стр.Ломбард;
								Движ.ДеньНедели = стр.День;
								Движ.НомерДня = стр.НомерДня;
								Движ.Начало = стр.Начало;
								Движ.Окончание = стр.Окончание;
								Движ.ПерерывНачало = стр.ПерерывНачало;
								Движ.ПерерывОкончание = стр.ПерерывОкончание;
								Движ.РабочиеМинуты = (стр.Окончание - стр.Начало - (стр.ПерерывОкончание - стр.ПерерывНачало))/60; 
								Движ.Записать();
								
							КонецЕсли;
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла;
КонецПроцедуры


Функция ЭтоРабочаяБаза() Экспорт
	
	СтрокаСоединенияРабочейБазы = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("СтрокаСоединенияРабочейБазы");
	Если ТипЗнч(СтрокаСоединенияРабочейБазы) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаЭтаБаза		= СокрЛП(НРег(СтрокаСоединенияИнформационнойБазы()));
	СтрокаРабочаяБаза	= СокрЛП(НРег(СтрокаСоединенияРабочейБазы));
	
	Возврат (СтрокаЭтаБаза = СтрокаРабочаяБаза);
	
КонецФункции

Функция СформироватьТехническоеНаименование(Наименование) Экспорт
	
	НаимЗалогодателя = СокрЛП(НРег(Строка(Наименование)));
	
	Если НЕ ПустаяСтрока(НаимЗалогодателя) Тогда
		Если СтрНайти(НаимЗалогодателя, "ё") > 0 Тогда
			НаимЗалогодателя = СтрЗаменить(НаимЗалогодателя, "ё", "е");
		КонецЕсли;

		Если СтрНайти(НаимЗалогодателя, "й") > 0 Тогда
			НаимЗалогодателя = СтрЗаменить(НаимЗалогодателя, "й", "и");
		КонецЕсли;

		Если СтрНайти(НаимЗалогодателя, "ъ") > 0 Тогда
			НаимЗалогодателя = СтрЗаменить(НаимЗалогодателя, "ъ", "ь");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВРег(НаимЗалогодателя);
КонецФункции

Процедура СнятьСтатусСУволенныхСотрудников() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КадроваяИсторияСотрудников.Период КАК Период,
	               |	ЛБ_КадроваяИсторияСотрудников.Сотрудник КАК Сотрудник,
	               |	ВложенныйЗапрос.Клиент КАК Клиент
	               |ИЗ
	               |	РегистрСведений.ЛБ_КадроваяИсторияСотрудников КАК ЛБ_КадроваяИсторияСотрудников
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.Клиент КАК Клиент,
	               |			ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.Сотрудник КАК Сотрудник
	               |		ИЗ
	               |			РегистрСведений.ЛБ_СоответствиеКлиентовИСотрудниковОрганизации КАК ЛБ_СоответствиеКлиентовИСотрудниковОрганизации) КАК ВложенныйЗапрос
	               |		ПО ЛБ_КадроваяИсторияСотрудников.Сотрудник = ВложенныйЗапрос.Сотрудник
	               |ГДЕ
	               |	ЛБ_КадроваяИсторияСотрудников.ВидСобытия = &ВидСобытия";
	Запрос.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если ЗначениеЗаполнено(Выборка.Клиент) Тогда	
			
			Запрос2 = Новый Запрос;
			Запрос2.Текст = "ВЫБРАТЬ
			                |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Период КАК Период,
			                |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Залогодатель КАК Залогодатель,
			                |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус
			                |ИЗ
			                |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(&НаДату, Залогодатель = &Клиент) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних
			                |ГДЕ
			                |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус = &Статус
			                |	И ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется = Истина";
			Запрос2.УстановитьПараметр("НаДату", Выборка.Период + 10);
			Запрос2.УстановитьПараметр("Клиент", Выборка.Клиент);
			Запрос2.УстановитьПараметр("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник);
			
			Выборка2 = Запрос2.Выполнить().Выбрать();
			Если Выборка2.Следующий() Тогда  
				
				ЗапросКарт = Новый Запрос;
				ЗапросКарт.Текст ="ВЫБРАТЬ ПЕРВЫЕ 1
				                  |	ЛБ_КарточкаЗалогодателя.Ссылка КАК Ссылка
				                  |ИЗ
				                  |	Документ.ЛБ_КарточкаЗалогодателя КАК ЛБ_КарточкаЗалогодателя
				                  |ГДЕ
				                  |	ЛБ_КарточкаЗалогодателя.Залогодатель = &Залогодатель
				                  |
				                  |УПОРЯДОЧИТЬ ПО
				                  |	ЛБ_КарточкаЗалогодателя.Дата УБЫВ";
				ЗапросКарт.УстановитьПараметр("Залогодатель", Выборка.Клиент);
				ВыборкаКарт = ЗапросКарт.Выполнить().Выбрать();
				Если ВыборкаКарт.Следующий() Тогда 
					НовДок = Документы.ЛБ_КарточкаЗалогодателя.СоздатьДокумент();
					ЗаполнитьЗначенияСвойств(НовДок, ВыборкаКарт.Ссылка,,"Номер");
					НовДок.Дата = Выборка.Период + 1;
					
					Для каждого стр из ВыборкаКарт.Ссылка.ДокументыЗалогодателя Цикл
						НовСтр = НовДок.ДокументыЗалогодателя.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, стр);
					КонецЦикла;
					Для каждого стр из ВыборкаКарт.Ссылка.Бенефициары Цикл
						НовСтр = НовДок.Бенефициары.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, стр);
					КонецЦикла;
					Для каждого стр из ВыборкаКарт.Ссылка.ОтказыКлиентам Цикл
						НовСтр = НовДок.ОтказыКлиентам.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, стр);
					КонецЦикла;
					Для каждого стр из ВыборкаКарт.Ссылка.СлужебныеСтатусы Цикл
						НовСтр = НовДок.СлужебныеСтатусы.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, стр);
					КонецЦикла; 
					
					Для каждого стр из ВыборкаКарт.Ссылка.ДополнительныеСтатусы Цикл
						НовСтр = НовДок.ДополнительныеСтатусы.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, стр);
						Если НовСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник Тогда
							НовСтр.Используется = Ложь;
							НовСтр.Комментарий = "увольнение";
						КонецЕсли;
					КонецЦикла; 	
					НовДок.ПричинаИзменения = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.СнятиеСтатусаСотрудник;
					
