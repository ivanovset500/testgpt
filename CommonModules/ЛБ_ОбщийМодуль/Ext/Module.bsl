Функция ПеревестиВЧистоту(Количество, ПробаМеталла) Экспорт
	Если НЕ ЗначениеЗаполнено(ПробаМеталла) Тогда
		Возврат 0;
	КонецЕсли;
	
	Проба = ПробаМеталла.Проба;
	Если Цел(Проба) = 999 Тогда
        КоличествоЧистое = Количество;
	Иначе	
	    КоличествоЧистое = Количество*Цел(Проба)/999.9;
    КонецЕсли;
		
	Возврат окр(КоличествоЧистое, 3);
КонецФункции	

// Округляет число по заданному порядку. Если задано (=Истина) "ОкруглятьВБольшуюСторону",
// то число 123.37 при порядке округление 0.5 превратиться в 123.50, а число 0.1 
// при порядке округления 5 станет равным 5.
//
// Параметры:
//  Число                    - исходное число
//  ПорядокОкругления        - элемент перечисления Порядки окгугления: 
//                             "шаг" округления (0.01 (арифметическое), 0.01, 0.05, 0.1, 0.5, 1, 5, 10, 50, 100)
//  ОкруглятьВБольшуюСторону - булево, определяет способ округления: если Истина, 
//                             то при порядке округления "5" 0.01 будет округлена до 5, 
//                             Ложь - округление по арифметическим правилам
//
// Возвращаемое значение:
//  Округленное по заданному порядку значение
//
Функция ОкруглитьЦену(Число, ПараметрПорядокОкругления, ОкруглятьВБольшуюСторону) Экспорт

	Перем Результат;

	// Преобразуем порядок округления числа.
	// Если передали пустое значение порядка, то округлим до копеек. 
	Если НЕ ЗначениеЗаполнено(ПараметрПорядокОкругления) Тогда
		ПорядокОкругления = Перечисления.ПорядкиОкругления.Окр0_01; 
	Иначе
		ПорядокОкругления = ПараметрПорядокОкругления;
	КонецЕсли;

	Порядок = Число(Строка(ПорядокОкругления));
		
	// вычислим количество интервалов, входящих в число
	КоличествоИнтервал	= Число / Порядок;
		
	// вычислим целое количество интервалов.
	КоличествоЦелыхИнтервалов = Цел(КоличествоИнтервал);
		
	Если КоличествоИнтервал = КоличествоЦелыхИнтервалов Тогда
		
		// Числа поделились нацело. Округлять не нужно.
		Результат	= Число;
	Иначе
		Если ОкруглятьВБольшуюСторону Тогда
			
			// При порядке округления "0.05" 0.371 должно округлитья до 0.4
			Результат = Порядок * (КоличествоЦелыхИнтервалов + 1);
		Иначе

			// При порядке округления "0.05" 0.371 должно округлитья до 0.35,
			// а 0.376 до 0.4
			Результат = Порядок * Окр(КоличествоИнтервал,0,РежимОкругления.Окр15как20);
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ОкруглитьЦену()

Функция ПроверитьФИОЗалогодателя(Знач Фамилия, Знач Имя, Знач Отчество, ТолькоКириллица = Истина) Экспорт
	СтруктураВозврата = Новый Структура("Результат, Сообщение");
	
	// ++ Сербаев 15.06.2023 Убрал с проверки разрешенные символы (тире и пробел по середине)
	РазрешенныеСимволы = Новый Массив;
	РазрешенныеСимволы.Добавить(" ");
	РазрешенныеСимволы.Добавить("-");
	
	Для каждого РазрешенныйСимвол Из РазрешенныеСимволы Цикл
	   Фамилия  = СтрЗаменить(Фамилия, РазрешенныйСимвол, "");
	   Имя      = СтрЗаменить(Имя, РазрешенныйСимвол, "");
	   Отчество = СтрЗаменить(Отчество, РазрешенныйСимвол, "");
	КонецЦикла;
    // -- Сербаев 15.06.2023
	
	СтрокаСообщений = "";
    //Проверим правильность заполнения ФИО
	Если ТолькоКириллица Тогда
		ТолькоКириллицаФамилия = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Фамилия);
		Если НЕ ТолькоКириллицаФамилия Тогда
		  	СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения фамилии. Фамилия должна содержать только символы кириллицы!";
		КонецЕсли;
		ТолькоКириллицаИмя = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Имя);
		Если НЕ ТолькоКириллицаИмя Тогда
		 	СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения имени. Имя должно содержать только символы кириллицы!";
		КонецЕсли;	
		Если НЕ ПустаяСтрока(Отчество) Тогда
		    ТолькоКириллицаОтчество = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Отчество);
			Если НЕ ТолькоКириллицаОтчество Тогда
				СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения отчества. Отчество должно содержать только символы кириллицы!";
			КонецЕсли;
		КонецЕсли;	
	Иначе
  	    ТолькоЛатиницаФамилия = СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Фамилия);
		Если НЕ ТолькоЛатиницаФамилия Тогда
			СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения фамилии для иностранных граждан. Фамилия должна содержать только латинские символы!";
		КонецЕсли;
	    ТолькоЛатиницаИмя = СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Имя);
		Если НЕ ТолькоЛатиницаИмя Тогда
			СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения имени для иностранных граждан. Имя должно содержать только латинские символы!";
		КонецЕсли;	
		Если НЕ ПустаяСтрока(Отчество) Тогда
	   	    ТолькоЛатиницаОтчество = СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Отчество);
			Если НЕ ТолькоЛатиницаОтчество Тогда
				СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения отчества для иностранных граждан. Отчество должно содержать только латинские символы!";
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;	
	
	Если НЕ ПустаяСтрока(СтрокаСообщений) Тогда
		СтруктураВозврата.Результат = Ложь;
        СтруктураВозврата.Сообщение = СтрокаСообщений;
		Возврат СтруктураВозврата;
	КонецЕсли;	
		
	СтруктураВозврата.Результат = Истина;
    СтруктураВозврата.Сообщение = СтрокаСообщений;
	Возврат СтруктураВозврата;
КонецФункции

Функция ВычислитьВозраст(ДатаРождения) Экспорт

	Возраст = Год(Текущаядата()) - Год(ДатаРождения);	
	
	ДеньТекущий = День(Текущаядата());
	МесяцТекущий = Месяц(ТекущаяДата());
	
	ДеньРождения = День(ДатаРождения);
	МесяцРождения = Месяц(ДатаРождения);
	
	Если МесяцРождения > МесяцТекущий ИЛИ (МесяцРождения = МесяцТекущий И ДеньРождения > ДеньТекущий) Тогда
		
		Возраст = Возраст - 1;

	КонецЕсли;
	
	Возврат Возраст;	

КонецФункции 

Функция ПроверитьпоследниеИзмененияДокументаДокумент(Гражданство, ВидДокумента, Серия, Номер, ДокументЗалогодателя)
	ЗапросДок = Новый Запрос;
	ЗапросДок.УстановитьПараметр("ДокументЗалогодателя", ДокументЗалогодателя);
	ЗапросДок.Текст = "ВЫБРАТЬ
	                  |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	                  |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	                  |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
	                  |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер
	                  |ИЗ
	                  |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
	Если ВыборкаДок.Следующий() Тогда 
		Если ВыборкаДок.ВидДокумента  = ВидДокумента И
			 ВыборкаДок.Гражданство  = Гражданство И
			 СокрЛП(ВыборкаДок.Серия) = Серия И
			 СокрЛП(ВыборкаДок.Номер) = Номер Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПроверитьЕстьДокумент(Гражданство, ВидДокумента, Серия, Номер, ДокументСсылка = неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Гражданство", Гражданство);
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.УстановитьПараметр("Серия", Серия);
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя КАК ДокументЗалогодателя
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей КАК ЛБ_ДокументыЗалогодателей
	               |ГДЕ
	               |	ЛБ_ДокументыЗалогодателей.ВидДокумента = &ВидДокумента
	               |	И ЛБ_ДокументыЗалогодателей.Гражданство = &Гражданство
	               |	И ЛБ_ДокументыЗалогодателей.ДокументСерия = &Серия
	               |	И ЛБ_ДокументыЗалогодателей.ДокументНомер = &Номер";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ДокументСсылка = неопределено Тогда
			Если НЕ Выборка.ДокументЗалогодателя = ДокументСсылка Тогда 
				Если НЕ ПроверитьпоследниеИзмененияДокументаДокумент(Гражданство, ВидДокумента, Серия, Номер, Выборка.ДокументЗалогодателя) Тогда
		           Возврат Выборка.ДокументЗалогодателя; 
				КонецЕсли;   
			КонецЕсли
		Иначе       
			Если НЕ ПроверитьпоследниеИзмененияДокументаДокумент(Гражданство, ВидДокумента, Серия, Номер, Выборка.ДокументЗалогодателя) Тогда
			    Возврат Выборка.ДокументЗалогодателя; 
			КонецЕсли;   
		КонецЕсли;	
	КонецЦикла;
	Возврат неопределено;
	
КонецФункции	

// Проверяет, содержит ли строка только символы кириллического алфавита.
//
// Параметры:
//  СтрокаПроверки - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка содержит только кириллические (или допустимые) символы или пустая;
//           Ложь, если строка содержит иные символы.
//
Функция ТолькоКириллицаИлиЛатиницаВСтроке(Знач СтрокаПроверки, Знач ЕстьСимволы = Истина, Знач ТолкоБуквы = Истина) Экспорт
	
	Если ТипЗнч(СтрокаПроверки) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаПроверки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	КодыДопустимыхСимволов = Новый Массив;
	КодыДопустимыхСимволов.Добавить(1105); // "ё"
	КодыДопустимыхСимволов.Добавить(1025); // "Ё"
	КодыДопустимыхСимволов.Добавить(32); // пробел
	Если ЕстьСимволы Тогда
		КодыДопустимыхСимволов.Добавить(46); // точка
		КодыДопустимыхСимволов.Добавить(45); // тире
    КонецЕсли;
	Если НЕ ТолкоБуквы Тогда
		КодыДопустимыхСимволов.Добавить(49); // 1
		КодыДопустимыхСимволов.Добавить(50); // 2
		КодыДопустимыхСимволов.Добавить(51); // 3
		КодыДопустимыхСимволов.Добавить(52); // 4
		КодыДопустимыхСимволов.Добавить(53); // 5
		КодыДопустимыхСимволов.Добавить(54); // 6
		КодыДопустимыхСимволов.Добавить(55); // 7
		КодыДопустимыхСимволов.Добавить(56); // 8
		КодыДопустимыхСимволов.Добавить(57); // 9
	КонецЕсли;	

	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		КодСимвола = КодСимвола(Сред(СтрокаПроверки, Индекс, 1));
		СимволК = Истина;
		СимволЛ = Истина;
		
		Если ((КодСимвола < 1040) Или (КодСимвола > 1103)) И (КодыДопустимыхСимволов.Найти(КодСимвола) = Неопределено) Тогда
				СимволК = Ложь;
		КонецЕсли;	
		Если ((КодСимвола < 65) Или (КодСимвола > 90 И КодСимвола < 97) Или (КодСимвола > 122)) И (КодыДопустимыхСимволов.Найти(КодСимвола) = Неопределено) Тогда
			СимволЛ = Ложь;
		КонецЕсли;
		Если НЕ (СимволК ИЛИ СимволЛ) Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьМесторождениеЗалогодателя(Страна, Область, Район, НаселенныйПункт) Экспорт
	СтруктураВозврата = Новый Структура("Результат, Сообщение");
	
	СтрокаСообщений = "";
    //Проверим правильность заполнения 
	ОКСтрана = Истина;
	Если НЕ ПустаяСтрока(Страна) Тогда
        // ++ Сербаев 20.06.2023 
        //ОКСтрана = ТолькоКириллицаИлиЛатиницаВСтроке(Страна, ложь);
	    ОКСтрана = ТолькоКириллицаИлиЛатиницаВСтроке(Страна);
		// -- Сербаев 20.06.2023
		Если НЕ ОКСтрана Тогда
			СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения страны. Страна должна содержать или только русские или только латинские символы!";
		КонецЕсли;
	КонецЕсли;
	ОКОбласть = Истина;
	Если НЕ ПустаяСтрока(Область) Тогда
	    ОКОбласть = ТолькоКириллицаИлиЛатиницаВСтроке(Область);
		Если НЕ ОКОбласть Тогда
			СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения области. Область должна содержать или только русские или только латинские символы!";
		КонецЕсли;
	Иначе
		Если НЕ Найти(Врег(Страна), "РОССИЯ") = 0 Тогда
			СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения области. Для места рождения РОССИЯ заполнение области обязательно!";
		КонецЕсли;	
	КонецЕсли;
	ОКРайон = Истина;
	Если НЕ ПустаяСтрока(Район) Тогда
		ОКРайон = ТолькоКириллицаИлиЛатиницаВСтроке(Район);
		Если НЕ ОКРайон Тогда
		  	СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения района. Район должен содержать или только русские или только латинские символы!";
		КонецЕсли;	
	КонецЕсли;	
	ОКНаселенныйПункт = Истина;
	Если НЕ ПустаяСтрока(НаселенныйПункт) Тогда
	    ОКНаселенныйПункт = ТолькоКириллицаИлиЛатиницаВСтроке(НаселенныйПункт,,ложь);
		Если НЕ ОКНаселенныйПункт Тогда
			СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения города. Город (населенный пункт) должно содержать или только русские или только латинские символы!";
		Иначе
			 ОКНаселенныйПункт = НЕ ПроверкаТолькоЦифры(НаселенныйПункт, "");
			 Если НЕ ОКНаселенныйПункт Тогда
			     СтрокаСообщений = СтрокаСообщений + ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС) + "Ошибка заполнения города. Город (населенный пункт) не может содержать только цифры!";
			 КонецЕсли;	 
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ПустаяСтрока(СтрокаСообщений) Тогда
		СтруктураВозврата.Результат = Ложь;
        СтруктураВозврата.Сообщение = СтрокаСообщений;
		Возврат СтруктураВозврата;
	КонецЕсли;	
	
	СтруктураВозврата.Результат = Истина;
    СтруктураВозврата.Сообщение = СтрокаСообщений;
	Возврат СтруктураВозврата;
КонецФункции

Функция ПроверитьПаспортРФДействует(ДатаРождения, ДатаВыдачи, ВыводитьСообщения = Истина) Экспорт
	Возраст = ВычислитьВозраст(ДатаРождения);
	ТекДата = НачалоДня(ТекущаяДата());
	ДатаРождения20 = ДобавитьМесяц(ДатаРождения, 12 * 20);
    Если Возраст <= 20 Тогда	    
		Если ДатаВыдачи > ДатаРождения20 Тогда
		    Возврат Истина;
		ИначеЕсли ДатаРождения20 > ТекДата Тогда
			РазницаВДнях = (ДатаРождения20 - ТекДата) / (60 * 60 * 24); 
			Если РазницаВДнях <= 30 И ВыводитьСообщения Тогда
			     Сообщить("Необходимо напомнить клиенту о скорой смене паспорта!", СтатусСообщения.Информация);
			КонецЕсли;	
	        Возврат Истина;
		Иначе		  
	        РазницаВДнях = (ТекДата - ДатаРождения20) / (60 * 60 * 24);
			Если РазницаВДнях <= 90 Тогда
				Возврат Истина;	  
			Иначе
				Возврат Ложь;
			КонецЕсли;	   
        КонецЕсли;
	Иначе
		Если ДатаВыдачи < ДатаРождения20 Тогда
			Возврат Ложь;
		КонецЕсли;	
	    ДатаРождения45 = ДобавитьМесяц(ДатаРождения, 12 * 45);
		Если ДатаВыдачи > ДатаРождения45 Тогда
		    Возврат Истина;
		ИначеЕсли ДатаРождения45 > ТекДата Тогда
			РазницаВДнях = (НачалоДня(ДатаРождения45) - ТекДата) / (60 * 60 * 24); 
			Если РазницаВДнях <= 30 И ВыводитьСообщения Тогда
			     Сообщить("Необходимо напомнить клиенту о скорой смене паспорта!", СтатусСообщения.Информация);
			КонецЕсли;	
	        Возврат Истина;
		Иначе		  
	        РазницаВДнях = (ТекДата - ДатаРождения45) / (60 * 60 * 24);
			Если РазницаВДнях <= 90 Тогда
				Возврат Истина;	  
			Иначе
				Возврат Ложь;
			КонецЕсли;	   
        КонецЕсли;
	КонецЕсли;			
КонецФункции

Функция ПроверитьСвидетельствоОРожденииДействует(ДатаРождения, ДатаПроверки = неопределено) Экспорт 
	Если ДатаПроверки = неопределено Тогда
		ДатаПроверки = ТекущаяДата(); 
	КонецЕсли;	
	Возраст = ВычислитьВозраст(ДатаРождения);
	Если Возраст >= 14 Тогда
		ТекДата = НачалоДня(ДатаПроверки);
		ДатаРождения14 = ДобавитьМесяц(ДатаРождения, 12 * 14);
	    РазницаВДнях = (ТекДата - ДатаРождения14) / (60 * 60 * 24);
		Если РазницаВДнях <= 90 Тогда
			Возврат Истина;	  
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	Иначе
		Возврат Истина;
    КонецЕсли;			
КонецФункции	


Функция ДокументСоСрокомДействия(Гражданство, ВидДокументаЗалогодателя, ВидДокумента) Экспорт
	Если Гражданство = Справочники.СтраныМира.Россия Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ГражданинРФ;
	ИначеЕсли Гражданство = Справочники.СтраныМира.БезГражданства Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ЛицоБезГражданства;
	Иначе
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ИностранныйГражданин;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен КАК Обязателен
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя КАК ЛБ_НастройкаРеквизитовДокументовЗалогодателя
	               |ГДЕ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокумента = &ВидДокумента
	               |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
				   |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидГражданства = &ВидГражданства
	               |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Реквизит = &Реквизит";
	               
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", ВидДокументаЗалогодателя);
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);  
	Запрос.УстановитьПараметр("ВидГражданства", ВидГражданства);
	Запрос.УстановитьПараметр("Реквизит", Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументСрокДействия);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Обязателен;
	КонецЕсли;
	Возврат Ложь;
КонецФункции	
		

Функция СформироватьНаименованиеДокументаЗалогодателя(СтрокаТЧ) Экспорт
	Наименование = "";
	Наименование = Наименование + ?(ПустаяСтрока(Наименование), "", " ") + СокрЛП(СтрокаТЧ.ВидДокумента);
	Наименование = Наименование + ?(ЗначениеЗаполнено(СтрокаТЧ.ДокументСерия), ?(ПустаяСтрока(Наименование), "", " ") + "серия " + СокрЛП(СтрокаТЧ.ДокументСерия), "");
	Наименование = Наименование + ?(ЗначениеЗаполнено(СтрокаТЧ.ДокументНомер), ?(ПустаяСтрока(Наименование), "", " ") + "№ " + СокрЛП(СтрокаТЧ.ДокументНомер), "");
	Наименование = Наименование + ?(НЕ СтрокаТЧ.ДокументДатаВыдачи = Дата(1,1,1), ?(ПустаяСтрока(Наименование), "", " ") + "выдан " + СокрЛП(Формат(СтрокаТЧ.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")), "");
	Наименование = Наименование + ?(НЕ СтрокаТЧ.ДокументСрокДействия = Дата(1,1,1), ?(ПустаяСтрока(Наименование), "", " ") + "срок действия " + СокрЛП(Формат(СтрокаТЧ.ДокументСрокДействия, "ДФ=dd.MM.yyyy")), "");
	Возврат  Наименование;
КонецФункции	

Функция СформироватьПолноеНаименованиеДокументаЗалогодателя(СтрокаТЧ) Экспорт
	Наименование = "";
	Наименование = Наименование + ?(ЗначениеЗаполнено(СтрокаТЧ.Гражданство), ?(ПустаяСтрока(Наименование), "", " ") + СокрЛП(СтрокаТЧ.Гражданство), "");
	Наименование = Наименование + ?(ПустаяСтрока(Наименование), "", " ") + ?(СтрокаТЧ.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность, "ДУЛ", "Доп. документ");
	Наименование = Наименование + ?(ПустаяСтрока(Наименование), "", " ") + СокрЛП(СтрокаТЧ.ВидДокумента);
	Наименование = Наименование + ?(ЗначениеЗаполнено(СтрокаТЧ.ДокументСерия), ?(ПустаяСтрока(Наименование), "", " ") + "серия " + СокрЛП(СтрокаТЧ.ДокументСерия), "");
	Наименование = Наименование + ?(ЗначениеЗаполнено(СтрокаТЧ.ДокументНомер), ?(ПустаяСтрока(Наименование), "", " ") + "№ " + СокрЛП(СтрокаТЧ.ДокументНомер), "");
	Наименование = Наименование + ?(НЕ ПустаяСтрока(СтрокаТЧ.ДокументКемВыдан), ?(ПустаяСтрока(Наименование), "", " ") + "выдан " + СокрЛП(СтрокаТЧ.ДокументКемВыдан), "");
	Наименование = Наименование + ?(НЕ СтрокаТЧ.ДокументДатаВыдачи = Дата(1,1,1), ?(ПустаяСтрока(Наименование), "", " ") + СокрЛП(Формат(СтрокаТЧ.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")), "");
	Наименование = Наименование + ?(ЗначениеЗаполнено(СтрокаТЧ.ДокументКодПодразделения), ?(ПустаяСтрока(Наименование), "", " ") + "код подр. " + СокрЛП(СтрокаТЧ.ДокументКодПодразделения), "");
	Наименование = Наименование + ?(НЕ СтрокаТЧ.ДокументСрокДействия = Дата(1,1,1), ?(ПустаяСтрока(Наименование), "", " ") + "срок действия " + СокрЛП(Формат(СтрокаТЧ.ДокументСрокДействия, "ДФ=dd.MM.yyyy")), "");
	Возврат  Наименование;
КонецФункции	

Функция ПолучитьДоступныеВидыДокументов(Гражданство, ВидДокументаЗалогодателя) Экспорт
	СписокВД = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", ВидДокументаЗалогодателя);
	Если Гражданство = Справочники.СтраныМира.Россия Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ГражданинРФ;
	ИначеЕсли Гражданство = Справочники.СтраныМира.БезГражданства Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ЛицоБезГражданства;
	Иначе
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ИностранныйГражданин;
	КонецЕсли;	
	Запрос.УстановитьПараметр("ВидГражданства", ВидГражданства);
	МассивГ = Новый Массив;
	МассивГ.Добавить(Гражданство);
	МассивГ.Добавить(Справочники.СтраныМира.ПустаяСсылка());
	Запрос.УстановитьПараметр("Гражданство", МассивГ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПереченьДокументовЗалогодателя.Гражданство КАК Гражданство,
	               |	ЛБ_ПереченьДокументовЗалогодателя.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ПереченьДокументовЗалогодателя.ПорядокСортировки КАК ПорядокСортировки
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьДокументовЗалогодателя КАК ЛБ_ПереченьДокументовЗалогодателя
	               |ГДЕ
	               |	ЛБ_ПереченьДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
	               |	И ЛБ_ПереченьДокументовЗалогодателя.Гражданство В(&Гражданство)
	               |	И ЛБ_ПереченьДокументовЗалогодателя.ВидГражданства = &ВидГражданства
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Гражданство УБЫВ,
	               |	ПорядокСортировки,
	               |	ВидДокумента";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаВидов = ТаблицаЗапроса.Скопировать();
	ТаблицаВидов.Свернуть("ВидДокумента");
	
	УдСтроки = Новый СписокЗначений;
	Для каждого СтрВ из ТаблицаВидов Цикл
		ОтборВ = новый Структура;
		ОтборВ.Вставить("ВидДокумента", СтрВ.ВидДокумента);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(ОтборВ);
		Если Строки.Количество() > 1 Тогда
			Для сч = 1 По Строки.Количество() - 1 Цикл
				УдСтроки.Добавить(Строки.Получить(сч));
			Конеццикла;	
		КонецЕсли;	
	Конеццикла;	
	
	Для каждого Эл Из УдСтроки Цикл
		ТаблицаЗапроса.Удалить(Эл.Значение);
	Конеццикла;	
	
	Для каждого Выборка Из ТаблицаЗапроса Цикл
		СписокВД.Добавить(Выборка.ВидДокумента);
	КонецЦикла;	
	Возврат СписокВД; 
КонецФункции	

Функция ПолучитьДоступныеВидыДокументовЗалогодателя(Гражданство) Экспорт
	СписокВД = Новый СписокЗначений;
	Запрос = Новый Запрос;
	
	Если Гражданство = Справочники.СтраныМира.Россия Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ГражданинРФ;
	ИначеЕсли Гражданство = Справочники.СтраныМира.БезГражданства Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ЛицоБезГражданства;
	Иначе
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ИностранныйГражданин;
	КонецЕсли;	
	Запрос.УстановитьПараметр("ВидГражданства", ВидГражданства);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ПереченьДокументовЗалогодателя.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьДокументовЗалогодателя КАК ЛБ_ПереченьДокументовЗалогодателя
	               |ГДЕ
	               |	ЛБ_ПереченьДокументовЗалогодателя.ВидГражданства = &ВидГражданства";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаЗапроса.Колонки.Добавить("Порядок");
	Для каждого Стр Из ТаблицаЗапроса Цикл
		Если Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность Тогда
			Стр.Порядок = 1;
		ИначеЕсли Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ Тогда			
			Стр.Порядок = 2;	
		Иначе
			Стр.Порядок = 3;
		КонецЕсли;	
	Конеццикла;
	ТаблицаЗапроса.Сортировать("Порядок");
		
