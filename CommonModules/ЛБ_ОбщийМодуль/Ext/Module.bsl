Функция РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, ПроцентнаяСтавка, СуммаЗайма, СтруктураОкругления) Экспорт   
	Если ЗначениеЗаполнено(ПроцентнаяСтавка) Тогда 
		ПроцентнаяСхемаРезультат = ПроцентнаяСтавка; 		
		Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда 
			СуммаПроцентов = 0; 
			СуммаПроцентовДень = 0;
		Иначе	   
			Если СтруктураОкругления.ОкруглятьЦены Тогда
		        СуммаПроцентов = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, ПроцентнаяСхемаРезультат, СуммаЗайма, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону); 
			Иначе
				СуммаПроцентов = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, ПроцентнаяСхемаРезультат, СуммаЗайма, СтруктураОкругления.ОкруглятьЦены);
			КонецЕсли;	
			КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 1, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24) + 1);
			СуммаПроцентовДень = ?(КолДней <= 0, 0, СуммаПроцентов/КолДней);   
		КонецЕсли;	
	Иначе
		СуммаПроцентов = 0;
		СуммаПроцентовДень = 0;
	КонецЕсли;	 
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов);
	СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень); 
	
	Возврат СтруктураВозврата;
КонецФункции

Функция РассчитатьСуммуПроцентовОплата(Объект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкругления, ДатаРасчетаОстаткаЗайма = неопределено) Экспорт 
	ПроцентнаяСхемаРезультат = Объект.ПроцентнаяСхема;
	ТаблицаСтавок = Объект.ПредыдущаяОперация.ПроцентныеСтавкиПоПериодам.Выгрузить();
	УдСтроки = новый СписокЗначений;
	Для каждого стр Из ТаблицаСтавок Цикл 
		Если Стр.ПричинаПрименения =  ПричинаПримененияПроцентнойСхемы Тогда
			Продолжить;
		КонецЕсли;
		УдСтроки.Добавить(Стр);
	Конеццикла;	               
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаСтавок.Удалить(Эл.Значение);
	Конеццикла;	 
	Объект.НачислениеПроцентовДетально.Очистить();   
	
	ПредельноеЗначениеПоДоговору = ложь;                                                                                
	Если Установки = неопределено Тогда 
		НеНачислятьПроцентыЗаПоследнийДень = ложь;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = ложь;
	Иначе 
		НеНачислятьПроцентыЗаПоследнийДень = Установки.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Установки.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
	КонецЕсли;	
	
	НачисленоПроценты = ЛБ_УправлениеЛомбардом.ПолучитьНачисленныеПроцентыПоДоговору(Объект, Объект.ПредыдущаяОперация);
	
	Если ДатаРасчетаОстаткаЗайма = неопределено Тогда
		СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Объект, Объект.ПредыдущаяОперация, Истина);
		СуммаЗаймаНач = СтруктураРез.СуммаЗайма;  
	Иначе    
		ДатаДокумента = Объект.Дата; 
		Объект.Дата = ДатаРасчетаОстаткаЗайма;
		СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Объект, Объект.ПредыдущаяОперация);
		СуммаЗаймаНач = СтруктураРез.СуммаЗайма; 
		Объект.Дата = ДатаДокумента;
	КонецЕсли;	
	Если СуммаЗаймаНач = 0 Тогда 
		СтруктураВозврата = Новый Структура;
	    СтруктураВозврата.Вставить("СуммаПроцентов", 0); 
		СтруктураВозврата.Вставить("СуммаПроцентовНачислено", 0);
	    СтруктураВозврата.Вставить("СуммаПроцентовДень", 0);
        СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);

		Возврат СтруктураВозврата;
	КонецЕсли;	
	
	ДатаДок = Объект.Дата;
	ДатаНач = НачалоДня(ДатаНачалаРасчета);
	ДатаКон = НачалоДня(Объект.Дата); 
	//Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда
	СуммаНачисленоЗаПериод = 0;
	//Иначе	
	//    СуммаНачисленоЗаПериод = ЛБ_ОбщийМодуль.ПолучитьНачисленияПроцентов(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
	//КонецЕсли;	
	Если Объект.Выкуп Тогда
		Если НеНачислятьПроцентыЗаПоследнийДень Тогда
		    ДатаКон = НачалоДня(ДатаКон - 1);			
		КонецЕсли;                              
		Если НачалоДня(Объект.Дата) = НачалоДня(Объект.ПредыдущаяОперация.Дата) Тогда
			Если СчитатьПроцентыДеньВыдачиРавенДеньВыкупа Тогда 
				СтрС = ТаблицаСтавок.Получить(0); 
				СтавкаП = СтрС.ПроцентнаяСтавка; 
				Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
					Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
				    КонецЕсли; 
				КонецЕсли;	

				Если СтруктураОкругления.ОкруглятьЦены Тогда
			        СуммаПроцентов = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаКон, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону); 
				Иначе
					СуммаПроцентов = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаКон, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены);
				КонецЕсли;     
				Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда 
					МожноНачислитьПроценты = ПредельноеЗначениеПроцентов - НачисленоПроценты;
					Если СуммаПроцентов > МожноНачислитьПроценты Тогда
						СуммаПроцентов = МожноНачислитьПроценты;
						ПредельноеЗначениеПоДоговору = Истина;
					КонецЕсли;	
				КонецЕсли;	
				СуммаПроцентовДень = СуммаПроцентов; 
												
				СтрП = Объект.НачислениеПроцентовДетально.Добавить();   
				СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
				СтрП.ДатаНач = ДатаКон;
				СтрП.ДатаКон = ДатаКон;
				СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
				СтрП.ДеньКон = СтрС.ДеньНачалаПрименения; 
				СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
				СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
				СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
				СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
                СтрП.СуммаПроцентов = СуммаПроцентов;
				СтрП.СуммаПроцентовДень = СуммаПроцентовДень;
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов); 
				СтруктураВозврата.Вставить("СуммаПроцентовНачислено", Объект.НачислениеПроцентовДетально.Итог("СуммаПроцентов"));
				СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
				СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору); 
				Возврат СтруктураВозврата;  
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	  
	Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда 
		СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(Объект, Объект.ПредыдущаяОперация);;   
		Если СтруктураОкругления.ОкруглятьЦены Тогда
		    СуммаПроцентовДень = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаНач, ПроцентнаяСхемаРезультат, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
		Иначе
			СуммаПроцентовДень = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаНач, ПроцентнаяСхемаРезультат, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
		КонецЕсли;	
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов);  
		СтруктураВозврата.Вставить("СуммаПроцентовНачислено", 0);
		СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
		СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);
	Иначе	         
		ДатаКонРезультат = ДатаКон;
		СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(Объект, Объект.ПредыдущаяОперация);
		Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда 
			МожноНачислитьПроценты = ПредельноеЗначениеПроцентов - НачисленоПроценты; 
		КонецЕсли;	 
		ТаблицаНачисленоЗаПериод = ПолучитьНачисленияПроцентовДетально(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
		Для сч = 0 По ТаблицаСтавок.Количество() - 1 Цикл 
			СтрС = ТаблицаСтавок.Получить(сч);
			ДеньНач = СтрС.ДеньНачалаПрименения;
			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачалаРасчета;   
			Иначе 
				ДатаНач = НачалоДня(ДатаНачалаРасчета-1) + СтрС.ДеньНачалаПрименения*(60 * 60 * 24);
			КонецЕсли;	  
			//Если ДатаНач > НачалоДня(Объект.Дата) Тогда  
			Если ДатаНач > ДатаКонРезультат Тогда
				Прервать;
			КонецЕсли;	
			
			сч1 = сч + 1;
			Если сч1 >= ТаблицаСтавок.Количество() Тогда
				ДатаКон = ДатаКонРезультат; 
				ДеньКон = (НачалоДня(ДатаКон) - НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24) + 1;
			Иначе   
				СтрС1 = ТаблицаСтавок.Получить(сч1);
				ДатаКонца = НачалоДня(ДатаНачалаРасчета-1) + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24); 
				//Если ДатаКонца > НачалоДня(Объект.Дата) Тогда 
				Если ДатаКонца > ДатаКонРезультат Тогда
					ДатаКон = ДатаКонРезультат; 
				    ДеньКон = (НачалоДня(ДатаКон) - НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24) + 1;
				Иначе
					ДатаКон = ДатаКонца; 
					ДеньКон = СтрС1.ДеньНачалаПрименения-1;
				КонецЕсли;	
			КонецЕсли;	    
			
			//Проверим начисления
			ДатаКонНачислено = ДатаНач;
			Для каждого СтрН из ТаблицаНачисленоЗаПериод Цикл 
				Если СтрН.ДатаКон < ДатаНач Тогда
					Продолжить;
				КонецЕсли;	
				Если СтрН.ДатаКон > ДатаКон Тогда
					Прервать;
				КонецЕсли;	
				Если СтрН.ДатаКон <= ДатаКон Тогда 
					ДатаКонНачислено = СтрН.ДатаКон;
				КонецЕсли;	
			КонецЦикла; 		
			
			Если НЕ ДатаКонНачислено = ДатаНач Тогда
				Если ДатаКонНачислено = ДатаКон Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаНач = КонецДня(ДатаКонНачислено) + 1;
			КонецЕсли;	

			
			СтрС = ТаблицаСтавок.Получить(сч); 
			СтавкаП = СтрС.ПроцентнаяСтавка; 
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
			    КонецЕсли; 
			КонецЕсли;	
						
			КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 0, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24)) + 1;
			Если СтруктураОкругления.ОкруглятьЦены Тогда
		        СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
          	Иначе
				СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
			КонецЕсли;	
			
			СуммаПроцентовНачислено = СуммаПроцентовНач; 
			//ДеньНачК = ДеньНач;  
			//ДатаНачК = ДатаНач;  
			//Для каждого СтрН из ТаблицаНачисленоЗаПериод Цикл 
			//	Если СтрН.ДатаКон = ДатаКон Тогда	
			//		СтрН.СуммаПроцентов = 0; 
			//		СуммаПроцентовНачислено = 0;
			//		Прервать;
			//	ИначеЕсли СтрН.ДатаКон > ДатаКон Тогда
			//		Прервать;
			//	КонецЕсли;	
			//	Если НЕ СтрН.СуммаПроцентов = 0 Тогда  
			//		Если СуммаПроцентовНачислено >= СтрН.СуммаПроцентов Тогда 
			//			СуммаПроцентовНачислено = СуммаПроцентовНачислено - СтрН.СуммаПроцентов;
			//			СтрН.СуммаПроцентов = 0;
			//		Иначе         						
			//			СтрН.СуммаПроцентов = СтрН.СуммаПроцентов - СуммаПроцентовНачислено;
			//			СуммаПроцентовНачислено = 0;
			//		КонецЕсли;	
			//		ДеньНачК = СтрН.ДеньКон+1;  
			//	    ДатаНачК = КонецДня(СтрН.ДатаКон) + 1; 
			//	КонецЕсли; 
			//КонецЦикла; 			
			//			
			//Если (СуммаПроцентовНачислено = 0) И НЕ (ДатаКон = ДатаКонРезультат) Тогда //(ДатаКон = Объект.Дата) Тогда  
			//    Продолжить;
			//КонецЕсли;
			//
			//Если НЕ ДеньНач = ДеньНачК И НЕ (СуммаПроцентовНачислено = 0) Тогда
			//	ДеньНач = ДеньНачК;  
			//	ДатаНач = ДатаНачК;    
			//	КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 0, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24)) + 1;
			//	Если СтруктураОкругления.ОкруглятьЦены Тогда
			//        СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
			//  	Иначе
			//		СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
			//	КонецЕсли;              
			//	СуммаПроцентовНачислено = СуммаПроцентовНач;
			//КонецЕсли;	
			////СуммаПроцентовДень = окр(СуммаПроцентовНач/КолДней, 2);   
			
			СуммаПроцентовДень = СуммаПроцентовНач/КолДней;
			Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда
				Если СуммаПроцентовНачислено > МожноНачислитьПроценты Тогда 
					РазницаНачислено = СуммаПроцентовНачислено - МожноНачислитьПроценты;
					РазницаДни = окр(РазницаНачислено/СуммаПроцентовДень, 0, РежимОкругления.Окр15как20);  
					СуммаПроцентовНачислено = МожноНачислитьПроценты;
					СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
					ПредельноеЗначениеПоДоговору = Истина;  					
					ДеньКон = окр(ДеньКон - РазницаДни, 0);
					ДатаКон = НачалоДня(ДатаКон - РазницаДни*(24*60*60));
				Иначе         
					СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
					МожноНачислитьПроценты = МожноНачислитьПроценты - СуммаПроцентовНачислено;  					
				КонецЕсли;	                                                                    
			Иначе
				СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
			КонецЕсли;	
			
			СтрП = Объект.НачислениеПроцентовДетально.Добавить();   
			СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
			СтрП.ДатаНач = ДатаНач;
			СтрП.ДатаКон = ДатаКон;
			СтрП.ДеньНач = ДеньНач;  
			СтрП.ДеньКон = ДеньКон; 
			СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
			СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
			СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
			СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
            СтрП.СуммаПроцентов = СуммаПроцентовНачислено;
			СтрП.СуммаПроцентовДень = СуммаПроцентовДень; 
			
			Если ПредельноеЗначениеПоДоговору Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;   
				
        // ++ Сербаев 20.06.2023 добавил проверку
		Если Не Объект.НачислениеПроцентовДетально.Количество() = 0 Тогда
		    СуммаПроцентовДень = Объект.НачислениеПроцентовДетально.Получить(0).СуммаПроцентовДень;
		КонецЕсли;
		// -- Сербаев 20.06.2023
		
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов); 
		СтруктураВозврата.Вставить("СуммаПроцентовНачислено", Объект.НачислениеПроцентовДетально.Итог("СуммаПроцентов"));
		СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
		СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);
	КонецЕсли;	
		
	Возврат СтруктураВозврата;
КонецФункции    

Функция ПолучитьОплатуПередИзъятием(ДатаОкончанияРасчета, ЗалоговыйБилет) 
	СуммаПроцентовОплачено = 0;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("Дата", ДатаОкончанияРасчета);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОбороты.Период КАК Период,
	               |	ЛБ_РасчетыСКлиентамиОбороты.СуммаРасход КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.Обороты(
	               |			,
	               |			,
	               |			Регистратор,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И ВидРасчета = Значение(Перечисление.ЛБ_ВидыРасчетов.ПоПроцентам)) КАК ЛБ_РасчетыСКлиентамиОбороты
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентамиОбороты.Период > &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	    СуммаПроцентовОплачено = СуммаПроцентовОплачено + Выборка.Сумма;
    КонецЦикла;
	
	Возврат СуммаПроцентовОплачено;
КонецФункции   

Функция ПолучитьСуммуЗаймаПередИзъятием(ДатаОкончанияРасчета, ЗалоговыйБилет) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("Дата", ДатаОкончанияРасчета);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.Остатки(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И ВидРасчета = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыРасчетов.ПоОсновномуДолгу)) КАК ЛБ_РасчетыСКлиентамиОстатки";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
	    Возврат Выборка.СуммаОстаток;
    КонецЕсли;
	
	Возврат 0;
КонецФункции


Функция РассчитатьСуммуПроцентовИзъятие(Объект, ДатаНачалаРасчета, ДатаОкончанияРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкругления) Экспорт 
	ПроцентнаяСхемаРезультат = Объект.ПроцентнаяСхема;   
	ТаблицаСтавок = Объект.ПредыдущаяОперация.ПроцентныеСтавкиПоПериодам.Выгрузить();
	УдСтроки = новый СписокЗначений;
	Для каждого стр Из ТаблицаСтавок Цикл 
		Если Стр.ПричинаПрименения =  ПричинаПримененияПроцентнойСхемы Тогда
			Продолжить;
		КонецЕсли;
		УдСтроки.Добавить(Стр);
	Конеццикла;	               
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаСтавок.Удалить(Эл.Значение);
	Конеццикла;	 
	Объект.НачислениеПроцентовДетально.Очистить();
	
	ПредельноеЗначениеПоДоговору = ложь;                                                                                
	Если Установки = неопределено Тогда 
		НеНачислятьПроцентыЗаПоследнийДень = ложь;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = ложь;
	Иначе 
		НеНачислятьПроцентыЗаПоследнийДень = Установки.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Установки.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
	КонецЕсли;	
	
	НачисленоПроценты = ЛБ_УправлениеЛомбардом.ПолучитьНачисленныеПроцентыПоДоговору(Объект, Объект.ПредыдущаяОперация);
	
	СуммаЗаймаНач = ПолучитьСуммуЗаймаПередИзъятием(ДатаОкончанияРасчета, Объект.ПредыдущаяОперация);
	//СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Объект, Объект.ПредыдущаяОперация, Истина);
	//СуммаЗаймаНач = СтруктураРез.СуммаЗайма;    
	Если СуммаЗаймаНач = 0 Тогда 
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("СуммаЗайма", 0);
	    СтруктураВозврата.Вставить("СуммаПроцентов", 0);
	    СтруктураВозврата.Вставить("СуммаПроцентовДень", 0);
        СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);

		Возврат СтруктураВозврата;
	КонецЕсли;	
	
	ПроцентыОплаченыПослеДатыОкончанияРасчетов = ПолучитьОплатуПередИзъятием(ДатаОкончанияРасчета, Объект.ПредыдущаяОперация);
	ДатаНач = НачалоДня(ДатаНачалаРасчета);
	ДатаКон = КонецДня(ДатаОкончанияРасчета);                           
	Если НачалоДня(Объект.ПредыдущаяОперация.Дата) = НачалоДня(ДатаОкончанияРасчета) Тогда
		Если СчитатьПроцентыДеньВыдачиРавенДеньВыкупа Тогда 
			ДатаОкончанияРасчета = НачалоДня(ДатаКон + 1);
			ДатаКон = ДатаОкончанияРасчета; 
		КонецЕсли;
	КонецЕсли;	

	//Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда
		СуммаНачисленоЗаПериод = 0;
	//Иначе	
	//    СуммаНачисленоЗаПериод = ЛБ_ОбщийМодуль.ПолучитьНачисленияПроцентов(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
	//КонецЕсли;	
	Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда 
		СуммаПроцентов = 0;   
		Если СтруктураОкругления.ОкруглятьЦены Тогда
	        СуммаПроцентовДень = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаНач, ПроцентнаяСхемаРезультат, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
		Иначе
			СуммаПроцентовДень = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаНач, ПроцентнаяСхемаРезультат, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
		КонецЕсли;	
		СтруктураВозврата = Новый Структура;  
		СтруктураВозврата.Вставить("СуммаЗайма", 0);
		СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов);
		СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
		СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);
	Иначе	           
		СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(Объект, Объект.ПредыдущаяОперация);
		Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда 
			МожноНачислитьПроценты = ПредельноеЗначениеПроцентов - НачисленоПроценты; 
		КонецЕсли;	 
		ТаблицаНачисленоЗаПериод = ПолучитьНачисленияПроцентовДетально(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
		Для сч = 0 По ТаблицаСтавок.Количество() - 1 Цикл 
			СтрС = ТаблицаСтавок.Получить(сч); 
			ДеньНач = СтрС.ДеньНачалаПрименения;
			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачалаРасчета;
			Иначе 
				ДатаНач = НачалоДня(ДатаНачалаРасчета-1) + СтрС.ДеньНачалаПрименения*(60 * 60 * 24);
			КонецЕсли;
			Если ДатаНач > НачалоДня(ДатаОкончанияРасчета) Тогда
				Прервать;
			КонецЕсли;	
			
			//СуммаНачисленоЗаПериод = ЛБ_ОбщийМодуль.ПолучитьНачисленияПроцентов(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
			
			сч1 = сч + 1;
			Если сч1 >= ТаблицаСтавок.Количество() Тогда
				ДатаКон = ДатаОкончанияРасчета; 
				ДеньКон = (НачалоДня(ДатаКон) - НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24) + 1;
			Иначе   
				СтрС1 = ТаблицаСтавок.Получить(сч1);
				ДатаКонца = НачалоДня(ДатаНачалаРасчета-1) + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24); 
				Если ДатаКонца > НачалоДня(ДатаОкончанияРасчета) Тогда
					ДатаКон = ДатаОкончанияРасчета; 
				    ДеньКон = (НачалоДня(ДатаКон) - НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24) + 1;
				Иначе
					ДатаКон = ДатаКонца; 
					ДеньКон = СтрС1.ДеньНачалаПрименения-1;
				КонецЕсли;	
			КонецЕсли;	 
			СтрС = ТаблицаСтавок.Получить(сч); 
			СтавкаП = СтрС.ПроцентнаяСтавка; 
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
			    КонецЕсли; 
			КонецЕсли;	  
			
			//Проверим начисления
			ДатаКонНачислено = ДатаНач;
			Для каждого СтрН из ТаблицаНачисленоЗаПериод Цикл 
				Если СтрН.ДатаКон < ДатаНач Тогда
					Продолжить;
				КонецЕсли;	
				Если СтрН.ДатаКон > ДатаКон Тогда
					Прервать;
				КонецЕсли;	
				Если СтрН.ДатаКон <= ДатаКон Тогда 
					ДатаКонНачислено = СтрН.ДатаКон;
				КонецЕсли;	
			КонецЦикла; 		
			
			Если НЕ ДатаКонНачислено = ДатаНач Тогда
				Если ДатаКонНачислено = ДатаКон Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаНач = КонецДня(ДатаКонНачислено) + 1;
			КонецЕсли;	
						
			КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 0, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24)) + 1;
			Если СтруктураОкругления.ОкруглятьЦены Тогда
		        СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
          	Иначе
				СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
			КонецЕсли;	
			
			СуммаПроцентовНачислено = СуммаПроцентовНач; 
			//ДеньНачК = ДеньНач;  
			//ДатаНачК = ДатаНач;  
			//Для каждого СтрН из ТаблицаНачисленоЗаПериод Цикл 
			//	Если СтрН.ДатаКон = ДатаКон Тогда
			//		СуммаПроцентовНачислено = 0; 
			//		СтрН.СуммаПроцентов = 0;
			//		Прервать;
			//	ИначеЕсли СтрН.ДатаКон > ДатаКон Тогда
			//		Прервать;
			//	КонецЕсли;	
			//	Если НЕ СтрН.СуммаПроцентов = 0 Тогда  
			//		Если СуммаПроцентовНачислено >= СтрН.СуммаПроцентов Тогда  
			//			СуммаПроцентовНачислено = СуммаПроцентовНачислено - СтрН.СуммаПроцентов;
			//			СтрН.СуммаПроцентов = 0;
			//		Иначе      
			//			СтрН.СуммаПроцентов = СтрН.СуммаПроцентов - СуммаПроцентовНачислено;
			//			СуммаПроцентовНачислено = 0;
			//		КонецЕсли;	
			//		ДеньНачК = СтрН.ДеньКон+1;  
			//		ДатаНачК = КонецДня(СтрН.ДатаКон) + 1;  
			//	КонецЕсли;
			//КонецЦикла; 			
			//			
			//Если (СуммаПроцентовНачислено = 0) И НЕ (ДатаКон = ДатаОкончанияРасчета) Тогда
			//	Продолжить;
			//КонецЕсли;
			//
			//Если НЕ ДеньНач = ДеньНачК Тогда
			//	ДеньНач = ДеньНачК;  
			//	ДатаНач = ДатаНачК;    
			//	КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 0, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24)) + 1;
			//	Если СтруктураОкругления.ОкруглятьЦены Тогда
			//        СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
			//  	Иначе
			//		СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
			//	КонецЕсли;
			//	СуммаПроцентовНачислено = СуммаПроцентовНач;
			//КонецЕсли;	
			СуммаПроцентовДень = окр(СуммаПроцентовНач/КолДней, 2);			
			Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда 
				Если СуммаПроцентовНачислено > МожноНачислитьПроценты Тогда 
					РазницаНачислено = СуммаПроцентовНачислено - МожноНачислитьПроценты;
					РазницаДни = РазницаНачислено/СуммаПроцентовДень;  
					СуммаПроцентовНачислено = МожноНачислитьПроценты;
					СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
					ПредельноеЗначениеПоДоговору = Истина;  					
					ДеньКон = окр(ДеньКон - РазницаДни, 0);
					ДатаКон = НачалоДня(ДатаКон - РазницаДни*(24*60*60));
				Иначе         
					СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
					МожноНачислитьПроценты = МожноНачислитьПроценты - СуммаПроцентовНачислено;
				КонецЕсли;	
			Иначе
				СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;	
			КонецЕсли;	
			
			СтрП = Объект.НачислениеПроцентовДетально.Добавить();   
			СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
			СтрП.ДатаНач = ДатаНач;
			СтрП.ДатаКон = ДатаКон;
			СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
			СтрП.ДеньКон = ДеньКон; 
			СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
			СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
			СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
			СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
            СтрП.СуммаПроцентов = СуммаПроцентовНачислено;
			СтрП.СуммаПроцентовДень = СуммаПроцентовДень; 
			
			Если ПредельноеЗначениеПоДоговору Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		// ++ Сербаев 20.06.2023 добавил проверку
		Если Не Объект.НачислениеПроцентовДетально.Количество() = 0 Тогда
		    СуммаПроцентовДень = Объект.НачислениеПроцентовДетально.Получить(0).СуммаПроцентовДень;
		КонецЕсли;
        // -- Сербаев 20.06.2023
		
		СтруктураВозврата = Новый Структура; 
		Если СуммаПроцентов < 0 Тогда  
			СтруктураВозврата.Вставить("СуммаЗайма", -СуммаПроцентов);
		    СтруктураВозврата.Вставить("СуммаПроцентов", 0); 
			СтруктураВозврата.Вставить("СуммаПроцентовДень", 0);
		Иначе	       
			Если ПроцентыОплаченыПослеДатыОкончанияРасчетов > СуммаПроцентов Тогда  
				СтруктураВозврата.Вставить("СуммаЗайма", ПроцентыОплаченыПослеДатыОкончанияРасчетов - СуммаПроцентов);
				СтруктураВозврата.Вставить("СуммаПроцентов", 0);
				СтруктураВозврата.Вставить("СуммаПроцентовДень", 0);
			Иначе	
			    СтруктураВозврата.Вставить("СуммаЗайма", 0); 
				СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов); 
				СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
			КонецЕсли;	
			 СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);
		КонецЕсли;	
	КонецЕсли;	
		
	Возврат СтруктураВозврата;
КонецФункции    

Функция РассчитатьСуммуПроцентовОстановкаНачислений(Объект, ДатаНачалаРасчета, ДатаОкончанияРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкругления) Экспорт 
	ПроцентнаяСхемаРезультат = Объект.ПроцентнаяСхема;
	ТаблицаСтавок = Объект.ПредыдущаяОперация.ПроцентныеСтавкиПоПериодам.Выгрузить();
	УдСтроки = новый СписокЗначений;
	Для каждого стр Из ТаблицаСтавок Цикл 
		Если Стр.ПричинаПрименения =  ПричинаПримененияПроцентнойСхемы Тогда
			Продолжить;
		КонецЕсли;
		УдСтроки.Добавить(Стр);
	Конеццикла;	               
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаСтавок.Удалить(Эл.Значение);
	Конеццикла;	 
	Объект.НачислениеПроцентовДетально.Очистить();
	
	ПредельноеЗначениеПоДоговору = ложь;                                                                                
	Если Установки = неопределено Тогда 
		НеНачислятьПроцентыЗаПоследнийДень = ложь;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = ложь;
	Иначе 
		НеНачислятьПроцентыЗаПоследнийДень = Установки.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Установки.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
	КонецЕсли;	
	
	НачисленоПроценты = ЛБ_УправлениеЛомбардом.ПолучитьНачисленныеПроцентыПоДоговору(Объект, Объект.ПредыдущаяОперация);
	
	СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Объект, Объект.ПредыдущаяОперация, Истина);
	СуммаЗаймаНач = СтруктураРез.СуммаЗайма;    
	Если СуммаЗаймаНач = 0 Тогда 
		СтруктураВозврата = Новый Структура;
	    СтруктураВозврата.Вставить("СуммаПроцентов", 0);
	    СтруктураВозврата.Вставить("СуммаПроцентовДень", 0);
        СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);

		Возврат СтруктураВозврата;
	КонецЕсли;	
	
	ДатаНач = НачалоДня(ДатаНачалаРасчета);
	ДатаКон = КонецДня(ДатаОкончанияРасчета);    
	//Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда
		СуммаНачисленоЗаПериод = 0;
	//Иначе	
	//    СуммаНачисленоЗаПериод = ЛБ_ОбщийМодуль.ПолучитьНачисленияПроцентов(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
	//КонецЕсли;	
	Если НачалоДня(ДатаКон) < НачалоДня(ДатаНач) тогда 
		СуммаПроцентов = 0;   
		Если СтруктураОкругления.ОкруглятьЦены Тогда
	        СуммаПроцентовДень = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаНач, ПроцентнаяСхемаРезультат, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
		Иначе
			СуммаПроцентовДень = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаНач, ПроцентнаяСхемаРезультат, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
		КонецЕсли;	
		СтруктураВозврата = Новый Структура;  
		СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов);
		СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
		СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);
	Иначе	           
		СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(Объект, Объект.ПредыдущаяОперация);
		Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда 
			МожноНачислитьПроценты = ПредельноеЗначениеПроцентов - НачисленоПроценты; 
		КонецЕсли;	 
		ТаблицаНачисленоЗаПериод = ПолучитьНачисленияПроцентовДетально(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
		Для сч = 0 По ТаблицаСтавок.Количество() - 1 Цикл 
			СтрС = ТаблицаСтавок.Получить(сч); 
			ДеньНач = СтрС.ДеньНачалаПрименения;
			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачалаРасчета;
			Иначе 
				ДатаНач = НачалоДня(ДатаНачалаРасчета-1) + СтрС.ДеньНачалаПрименения*(60 * 60 * 24);
			КонецЕсли;	
			Если ДатаНач > НачалоДня(ДатаОкончанияРасчета) Тогда
				Прервать;
			КонецЕсли;	
			
			//СуммаНачисленоЗаПериод = ЛБ_ОбщийМодуль.ПолучитьНачисленияПроцентов(Объект, Объект.ПредыдущаяОперация, ДатаНачалаРасчета);
			
			сч1 = сч + 1;
			Если сч1 >= ТаблицаСтавок.Количество() Тогда
				ДатаКон = ДатаОкончанияРасчета; 
				ДеньКон = (НачалоДня(ДатаКон) - НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24) + 1;
			Иначе   
				СтрС1 = ТаблицаСтавок.Получить(сч1);
				ДатаКонца = НачалоДня(ДатаНачалаРасчета-1) + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24); 
				Если ДатаКонца > НачалоДня(ДатаОкончанияРасчета) Тогда
					ДатаКон = ДатаОкончанияРасчета; 
				    ДеньКон = (НачалоДня(ДатаКон) - НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24) + 1;
				Иначе
					ДатаКон = ДатаКонца; 
					ДеньКон = СтрС1.ДеньНачалаПрименения-1;
				КонецЕсли;	
			КонецЕсли;	 
			СтрС = ТаблицаСтавок.Получить(сч); 
			СтавкаП = СтрС.ПроцентнаяСтавка; 
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
			    КонецЕсли; 
			КонецЕсли;	
			
			//Проверим начисления
			ДатаКонНачислено = ДатаНач;
			Для каждого СтрН из ТаблицаНачисленоЗаПериод Цикл 
				Если СтрН.ДатаКон < ДатаНач Тогда
					Продолжить;
				КонецЕсли;	
				Если СтрН.ДатаКон > ДатаКон Тогда
					Прервать;
				КонецЕсли;	
				Если СтрН.ДатаКон <= ДатаКон Тогда 
					ДатаКонНачислено = СтрН.ДатаКон;
				КонецЕсли;	
			КонецЦикла; 		
			
			Если НЕ ДатаКонНачислено = ДатаНач Тогда
				Если ДатаКонНачислено = ДатаКон Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаНач = КонецДня(ДатаКонНачислено) + 1;
			КонецЕсли;	
						
			КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 0, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24)) + 1;
			Если СтруктураОкругления.ОкруглятьЦены Тогда
		        СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
          	Иначе
				СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
			КонецЕсли;	
			
			СуммаПроцентовНачислено = СуммаПроцентовНач; 
			//ДеньНачК = ДеньНач;  
			//ДатаНачК = ДатаНач;  
			//Для каждого СтрН из ТаблицаНачисленоЗаПериод Цикл 
			//	Если СтрН.ДатаКон = ДатаКон Тогда
			//		СуммаПроцентовНачислено = 0; 
			//		СтрН.СуммаПроцентов = 0;
			//		Прервать;
			//	ИначеЕсли СтрН.ДатаКон > ДатаКон Тогда
			//		Прервать;
			//	КонецЕсли;	
			//	Если НЕ СтрН.СуммаПроцентов = 0 Тогда  
			//		Если СуммаПроцентовНачислено >= СтрН.СуммаПроцентов Тогда  
			//			СуммаПроцентовНачислено = СуммаПроцентовНачислено - СтрН.СуммаПроцентов;
			//			СтрН.СуммаПроцентов = 0;
			//		Иначе      
			//			СтрН.СуммаПроцентов = СтрН.СуммаПроцентов - СуммаПроцентовНачислено;
			//			СуммаПроцентовНачислено = 0;
			//		КонецЕсли;
			//		ДеньНачК = СтрН.ДеньКон+1;  
			//		ДатаНачК = КонецДня(СтрН.ДатаКон) + 1;  
			//	КонецЕсли;
			//КонецЦикла; 			
			//			
			//Если (СуммаПроцентовНачислено = 0) И НЕ (ДатаКон = ДатаОкончанияРасчета) Тогда
			//	Продолжить;
			//КонецЕсли;
			//
			//Если НЕ ДеньНач = ДеньНачК Тогда
			//	ДеньНач = ДеньНачК;  
			//	ДатаНач = ДатаНачК;    
			//	КолДней = ?(НачалоДня(ДатаКон) = НачалоДня(ДатаНач), 0, (НачалоДня(ДатаКон) - НачалоДня(ДатаНач)) / (60 * 60 * 24)) + 1;
			//	Если СтруктураОкругления.ОкруглятьЦены Тогда
			//        СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены, СтруктураОкругления.ВидОкругленияСуммыПроцентов, СтруктураОкругления.ПорядокОкругления, СтруктураОкругления.ОкруглятьВБольшуюСторону);
			//  	Иначе
			//		СуммаПроцентовНач = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗаймаНач, СтруктураОкругления.ОкруглятьЦены); 
			//	КонецЕсли;
			//	СуммаПроцентовНачислено = СуммаПроцентовНач;
			//КонецЕсли;	
			СуммаПроцентовДень = окр(СуммаПроцентовНач/КолДней, 2);			
			Если НЕ ПредельноеЗначениеПроцентов = 0 Тогда 
				Если СуммаПроцентовНачислено > МожноНачислитьПроценты Тогда 
					РазницаНачислено = СуммаПроцентовНачислено - МожноНачислитьПроценты;
					РазницаДни = РазницаНачислено/СуммаПроцентовДень;  
					СуммаПроцентовНачислено = МожноНачислитьПроценты;
					СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
					ПредельноеЗначениеПоДоговору = Истина;  					
					ДеньКон = окр(ДеньКон - РазницаДни, 0);
					ДатаКон = НачалоДня(ДатаКон - РазницаДни*(24*60*60));
				Иначе         
					СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;
					МожноНачислитьПроценты = МожноНачислитьПроценты - СуммаПроцентовНачислено;
				КонецЕсли;	
			Иначе
				СуммаПроцентов = СуммаПроцентов + СуммаПроцентовНачислено;		
			КонецЕсли;	
			
			СтрП = Объект.НачислениеПроцентовДетально.Добавить();   
			СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
			СтрП.ДатаНач = ДатаНач;
			СтрП.ДатаКон = ДатаКон;
			СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
			СтрП.ДеньКон = ДеньКон; 
			СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
			СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
			СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
			СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
            СтрП.СуммаПроцентов = СуммаПроцентовНачислено;
			СтрП.СуммаПроцентовДень = СуммаПроцентовДень; 
			
			Если ПредельноеЗначениеПоДоговору Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		// ++ Сербаев 20.06.2023 добавил проверку
		Если Не Объект.НачислениеПроцентовДетально.Количество() = 0 Тогда
		    СуммаПроцентовДень = Объект.НачислениеПроцентовДетально.Получить(0).СуммаПроцентовДень;
		КонецЕсли;
        // -- Сербаев 20.06.2023
		
		СтруктураВозврата = Новый Структура; 
		СтруктураВозврата.Вставить("СуммаПроцентов", СуммаПроцентов); 
		СтруктураВозврата.Вставить("СуммаПроцентовДень", СуммаПроцентовДень);
		СтруктураВозврата.Вставить("ПредельноеЗначениеПоДоговору", ПредельноеЗначениеПоДоговору);
	КонецЕсли;	
		
	Возврат СтруктураВозврата;
КонецФункции    

#Область ДополнительныеНастройки

// Возвращает значение доп. настройки по ИД
Функция ПолучитьЗначениеДопНастройки(ИДДопНастройки, ОжидаемыйТип = "") Экспорт
	
	ПолноеИмяДопНастройки = "ДопНастройки_" + ВРег(ИДДопНастройки);
	
	#Если ВнешнееСоединение Тогда
		ЗначениеНастройки = Неопределено;
	#Иначе
		ЗначениеНастройки = Неопределено;

		//ЗначениеНастройки = глЗначениеПеременной(ПолноеИмяДопНастройки);
	#КонецЕсли
	
	Если ЗначениеНастройки = Неопределено Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ИспользоватьХранилище,
		|	ХранилищеЗначения,
		|	ЗначениеНастройки,
		|	Кэшировать
		|ИЗ
		|	Справочник.ЛБ_ДополнительныеНастройки КАК ДополнительныеНастройки
		|ГДЕ
		|	ИД = &ИД
		|	И НЕ ПометкаУдаления
		|	И НЕ ЭтоГруппа");
		
		Запрос.УстановитьПараметр("ИД", ИДДопНастройки);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если Выборка.ИспользоватьХранилище Тогда
				
				СтруктураХранилища = Выборка.ХранилищеЗначения.Получить();
				
				Если ТипЗнч(СтруктураХранилища) = Тип("Структура") Тогда
					ЗначениеНастройки = СтруктураХранилища.Значение;	// Без попытки, считаем, что если в хранилище значения структура,
																		// то поле Значение всегда существует.
				КонецЕсли;
																	
			Иначе
				ЗначениеНастройки = Выборка.ЗначениеНастройки;
			КонецЕсли;
			
			//#Если НЕ ВнешнееСоединение Тогда
			//	Если Выборка.Кэшировать Тогда
			//		глЗначениеПеременнойУстановить(ПолноеИмяДопНастройки, ЗначениеНастройки);
			//	КонецЕсли;
			//#КонецЕсли
		
		КонецЕсли;	
		
	КонецЕсли;
	
	// Если тип значения не соответствует ожидаемому, то возвращается пустое значение ожидаемого типа.
	Если НЕ ПустаяСтрока(ОжидаемыйТип) Тогда
		ДоступныеТипы = Справочники.ЛБ_ДополнительныеНастройки.ПолучитьСоответствиеДоступныхТиповХранилища();
		Если (ДоступныеТипы[ОжидаемыйТип] <> Неопределено) 
				И (ТипЗнч(ЗначениеНастройки) <> Тип(ОжидаемыйТип)) Тогда
			ЗначениеНастройки = Новый(ОжидаемыйТип);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеНастройки; 
	
КонецФункции 


Функция СоздатьДопНастройку(ИД, Наименование, Значение) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ДополнительныеНастройки.Ссылка
	                |ИЗ
	                |	Справочник.ЛБ_ДополнительныеНастройки КАК ДополнительныеНастройки
	                |ГДЕ
	                |	ДополнительныеНастройки.ИД = &ИД";
	
	Запрос.УстановитьПараметр("ИД", ИД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НовЭл = Выборка.ссылка.ПолучитьОбъект();
	Иначе
		НовЭл = Справочники.ЛБ_ДополнительныеНастройки.СоздатьЭлемент();
	КонецЕсли;
	
	ИспользоватьХранилище = Ложь;
	ТипОбъекта = ТипЗнч(Значение);

	Если ТипОбъекта = Тип("Массив") или ТипОбъекта = Тип("Соответствие") или ТипОбъекта = Тип("ТаблицаЗначений") Тогда
		ИспользоватьХранилище = Истина;
	КонецЕсли;
		
	
	НовЭл.ИД                = ИД;
	НовЭл.Наименование      = Наименование;
	НовЭл.ЗначениеНастройки = Значение; 	             
	НовЭл.ИспользоватьХранилище = ИспользоватьХранилище;
	
	Если ИспользоватьХранилище Тогда
		
		Если ТипОбъекта = Тип("Массив") Тогда
			
			СтруктураХранилища = Новый Структура("Тип, Значение", "Массив", Значение);
			
		ИначеЕсли ТипОбъекта = Тип("Соответствие") Тогда
			
			ТекСоответствие = Новый Соответствие;
			Для Каждого ТекСтрока Из Значение Цикл
				ТекСоответствие.Вставить(ТекСтрока.Ключ, ТекСтрока.Значение);
			КонецЦикла;
			СтруктураХранилища = Новый Структура("Тип, Значение",
			"Соответствие",
			ТекСоответствие);
			
		ИначеЕсли ТипОбъекта = Тип("ТаблицаЗначений") Тогда
			
			СтруктураХранилища = Новый Структура("Тип, Значение",
			"ТаблицаЗначений",
			Значение.Скопировать());
			
		Иначе		
			СтруктураХранилища = Неопределено;
			
		КонецЕсли;
		
		НовЭл.ХранилищеЗначения = Новый ХранилищеЗначения(СтруктураХранилища);
		
	Иначе		
		НовЭл.ХранилищеЗначения = Новый ХранилищеЗначения(Неопределено);		
	КонецЕсли;
		
	НовЭл.Записать();
	
	Возврат НовЭл.Ссылка;		
КонецФункции


