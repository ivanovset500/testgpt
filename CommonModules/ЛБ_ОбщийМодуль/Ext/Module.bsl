// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ РАБОТЫ С ПОСЛЕДОВАТЕЛЬНОСТЯМИ

Процедура УдалитьРегистрациюДокументаВПоследовательностях(ДокументОбъект, ПроверятьДвижения = Ложь)Экспорт
	// получение списка последовательностей в которых зарегистрирован документ
	Если ПроверятьДвижения Тогда
		ТаблицаРегистраций = ОпределитьНаличиеРегистрацииДокументаВПоследовательности(ДокументОбъект);
	КонецЕсли;      
	КоллекцияПоследовательностей = ДокументОбъект.ПринадлежностьПоследовательностям;
	Для Каждого НаборЗаписейРегистрацииВПоследовательности ИЗ КоллекцияПоследовательностей Цикл
		Если (НаборЗаписейРегистрацииВПоследовательности.Количество() > 0)
		  ИЛИ (ПроверятьДвижения И (НЕ ТаблицаРегистраций.Найти(НаборЗаписейРегистрацииВПоследовательности.Метаданные().Имя,"Имя") = Неопределено)) Тогда
		   НаборЗаписейРегистрацииВПоследовательности.Очистить();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры//УдалитьРегистрациюДокументаВПоследовательностях

Функция ОпределитьНаличиеРегистрацииДокументаВПоследовательности(ДокументОбъект) Экспорт
	ТекстЗапроса = "";	
	
	Для Каждого Последовательность ИЗ ДокументОбъект.ПринадлежностьПоследовательностям Цикл
		// в запросе получаем имена последовательностей, в которых документ зарегистрирован
		ТекстЗапроса = ТекстЗапроса + "
		|" + ?(ТекстЗапроса = "", "", "ОБЪЕДИНИТЬ ВСЕ ") + "
		|ВЫБРАТЬ """ + Последовательность.Метаданные().Имя 
		+  """ КАК Имя ИЗ " + Последовательность.Метаданные().ПолноеИмя()  
		+ " ГДЕ Регистратор = &Регистратор";
		
	КонецЦикла;
	
	Если ТекстЗапроса = "" Тогда
		Возврат Новый ТаблицаЗначений();
	Иначе
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();	
		Возврат ТаблицаЗапроса;
	КонецЕсли;
	
КонецФункции

Функция ВыборЕдиницИзмеренияРасчетаЦенМеталлов() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ЕдиницыРасчетаДрагоценныхМеталлов.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ЕдиницыРасчетаДрагоценныхМеталлов КАК ЛБ_ЕдиницыРасчетаДрагоценныхМеталлов";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция ВыборЕдиницИзмеренияРасчетаЦенКамней() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ЕдиницыРасчетаДрагоценныхКамней.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ЕдиницыРасчетаДрагоценныхКамней КАК ЛБ_ЕдиницыРасчетаДрагоценныхКамней";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция РассчитатьВесДрагоценногоКамня(ВидКамня, ФормаОгранки, ВидОгранки, КачествоОгранки, Длина = 0, Ширина = 0, Высота = 0) Экспорт 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидКамня", ВидКамня);   
	СписокФО = Новый СписокЗначений;
	СписокФО.Добавить(Справочники.ЛБ_ФормыОгранки.ПустаяСсылка());  
	Если ЗначениеЗаполнено(ФормаОгранки) Тогда 
		СписокФО.Добавить(ФормаОгранки);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ФормаОгранки", СписокФО);
	Запрос.УстановитьПараметр("ВидОгранки", ВидОгранки);
	Запрос.УстановитьПараметр("КачествоОгранки", КачествоОгранки);
	Запрос.УстановитьПараметр("Длина", Длина);
	Запрос.УстановитьПараметр("Ширина", Ширина);
	Запрос.УстановитьПараметр("Высота", Высота);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.Вес КАК Вес,
	               |	ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПравилаРасчетаВесаДрагоценныхКамней КАК ЛБ_ПравилаРасчетаВесаДрагоценныхКамней
	               |ГДЕ
	               |	ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.ВидДрагоценногоКамня = &ВидКамня
	               |	И ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.ФормаОгранки В(&ФормаОгранки)
	               |	И ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.ВидОгранки = &ВидОгранки
	               |	И ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.КачествоОгранки = &КачествоОгранки
	               |	И ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.Длина = &Длина
	               |	И ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.Ширина = &Ширина
	               |	И ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.Высота = &Высота
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПравилаРасчетаВесаДрагоценныхКамней.ФормаОгранки УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если  Выборка.Следующий() Тогда 
		СтруктураВозврата = Новый структура("Вес, ЕдиницаИзмерения"); 
		СтруктураВозврата.Вес = Выборка.Вес;
		СтруктураВозврата.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
		Возврат СтруктураВозврата;
	КонецЕсли;
	Возврат неопределено;
КонецФункции

Функция ПолучитьВесовуюГруппу(ВидКамня, Вес) Экспорт
	Если Вес = 0  ИЛИ НЕ ЗначениеЗаполнено(ВидКамня) Тогда
		Возврат Справочники.ЛБ_ВесовыеГруппыДрагоценныхКамней.ПустаяСсылка();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Вес", Вес);
	Запрос.УстановитьПараметр("ВидКамня", ВидКамня);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ВесовыеГруппыДрагоценныхКамней.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_ВесовыеГруппыДрагоценныхКамней КАК ЛБ_ВесовыеГруппыДрагоценныхКамней
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ЛБ_ВесовыеГруппыДрагоценныхКамней.ВесОт = 0
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛБ_ВесовыеГруппыДрагоценныхКамней.ВесОт <= &Вес
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА ЛБ_ВесовыеГруппыДрагоценныхКамней.ВесДо = 0
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛБ_ВесовыеГруппыДрагоценныхКамней.ВесДо >= &Вес
	               |		КОНЕЦ
	               |	И ЛБ_ВесовыеГруппыДрагоценныхКамней.ВидДрагоценногоКамня = &ВидКамня";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат  Выборка.Ссылка;
	КонецЕсли;
		
	Возврат Справочники.ЛБ_ВесовыеГруппыДрагоценныхКамней.ПустаяСсылка();
КонецФункции	

Функция ПолучитьОтклонениеОтБазовойЦеныКамни(Дата, Ломбард, Категория, ВидВставки, БазоваяЦена) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	МассивК = Новый Массив;
	МассивК.Добавить(Справочники.ЛБ_ДрагоценныеКамни.ПустаяСсылка());
	Если ЗначениеЗаполнено(Категория) Тогда
		МассивК.Добавить(Категория);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Категории", МассивК);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	МассивВ = Новый Массив;
	МассивВ.Добавить(Справочники.ЛБ_ДрагоценныеКамни.ПустаяСсылка());
	Если ЗначениеЗаполнено(ВидВставки) Тогда
		МассивВ.Добавить(ВидВставки);
	КонецЕсли;	
    Запрос.УстановитьПараметр("ВидыВставок", МассивВ); 
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаОценкиДрагоценныхВставокСрезПоследних.КатегорияОбъектаЗалога КАК Категория,
	               |	ЛБ_НастройкаОценкиДрагоценныхВставокСрезПоследних.ВидВставки КАК ВидВставки,
	               |	ЛБ_НастройкаОценкиДрагоценныхВставокСрезПоследних.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
	               |	ЛБ_НастройкаОценкиДрагоценныхВставокСрезПоследних.ЗначениеОтклонения КАК ЗначениеОтклонения
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаОценкиДрагоценныхВставок.СрезПоследних(
	               |			&Дата,
	               |			Ломбард = &Ломбард
	               |				И ВидВставки В (&ВидыВставок)
	               |				И КатегорияОбъектаЗалога В (&Категории)
	               |				И ДатаНачалаДействия <= &Дата) КАК ЛБ_НастройкаОценкиДрагоценныхВставокСрезПоследних";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаЗапроса.Сортировать("Категория Убыв, ВидВставки Убыв");
	
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		СтрокаЗапроса = ТаблицаЗапроса.Получить(0);
		Если СтрокаЗапроса.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
			БазоваяЦена = БазоваяЦена * (1+СтрокаЗапроса.ЗначениеОтклонения/100);
		ИначеЕсли СтрокаЗапроса.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное Тогда
			БазоваяЦена = БазоваяЦена + СтрокаЗапроса.ЗначениеОтклонения;
	    КонецЕсли;
	КонецЕсли;	
	
	Возврат БазоваяЦена;

КонецФункции		
	
Функция ПолучитьЦенуДрагоценногоКамняИзПрейскуранта(ПараметрыПоиска) Экспорт 
	Цена = 0; 
	Приказ = Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.ПустаяСсылка();
	
	МассивГруппВес = Новый Массив;
	МассивГруппВес.Добавить(Справочники.ЛБ_ВесовыеГруппыДрагоценныхКамней.ПустаяСсылка());
	ВесоваяГруппа = ПолучитьВесовуюГруппу(ПараметрыПоиска.ВидВставки, ПараметрыПоиска.Вес);
	Если ЗначениеЗаполнено(ВесоваяГруппа) Тогда
		МассивГруппВес.Добавить(ВесоваяГруппа);
	КонецЕсли;	
	
	МассивФормаОгранки = Новый Массив;
	МассивФормаОгранки.Добавить(Справочники.ЛБ_ФормыОгранки.ПустаяСсылка());
	Если ЗначениеЗаполнено(ПараметрыПоиска.ФормаОгранки) Тогда
		МассивФормаОгранки.Добавить(ПараметрыПоиска.ФормаОгранки);
	КонецЕсли;	
	
	МассивВидОгранки = Новый Массив;
	МассивВидОгранки.Добавить(Справочники.ЛБ_ВидыОгранки.ПустаяСсылка());
	Если ЗначениеЗаполнено(ПараметрыПоиска.ВидОгранки) Тогда
		МассивВидОгранки.Добавить(ПараметрыПоиска.ВидОгранки);
	КонецЕсли;	

	МассивКачествоОгранки = Новый Массив;
	МассивКачествоОгранки.Добавить(Справочники.ЛБ_КачествоОгранки.ПустаяСсылка());
	Если ЗначениеЗаполнено(ПараметрыПоиска.КачествоОгранки) Тогда
		МассивКачествоОгранки.Добавить(ПараметрыПоиска.КачествоОгранки);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ПараметрыПоиска.Дата); 
	Запрос.УстановитьПараметр("Ломбард", ПараметрыПоиска.Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамни
	               |ГДЕ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Ломбард = &Ломбард
	               |	И ЛБ_ПрейскурантЦенНаДрагоценныеКамни.ДатаНачалаДействия <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Запрос.УстановитьПараметр("ВидВставки", ПараметрыПоиска.ВидВставки);
		Запрос.УстановитьПараметр("ВесовыеГруппы", МассивГруппВес);
		Запрос.УстановитьПараметр("ФормыОгранки", МассивФормаОгранки);
	    Запрос.УстановитьПараметр("ВидыОгранки", МассивВидОгранки);
	    Запрос.УстановитьПараметр("КачествоОгранки", МассивКачествоОгранки);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", ПараметрыПоиска.ЕдиницаИзмерения);
		Запрос.УстановитьПараметр("Регистратор", Выборка.Регистратор);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Ломбард КАК Ломбард,
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВесоваяГруппа КАК ВесоваяГруппа,
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ФормаОгранки КАК ФормаОгранки,
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВидОгранки КАК ВидОгранки,
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.КачествоОгранки КАК КачествоОгранки,
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Цена КАК ЦенаБазовая
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СрезПоследних(
		               |			&Дата,
		               |			Ломбард = &Ломбард
		               |				И ВидВставки = &ВидВставки
		               |				И ВесоваяГруппа В (&ВесовыеГруппы)
		               |				И ФормаОгранки В (&ФормыОгранки)
		               |				И ВидОгранки В (&ВидыОгранки)
		               |				И КачествоОгранки В (&КачествоОгранки)
		               |				И ЕдиницаИзмерения = &ЕдиницаИзмерения
		               |				И ДатаНачалаДействия <= &Дата) КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних
		               |ГДЕ
		               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Регистратор = &Регистратор
		               |АВТОУПОРЯДОЧИВАНИЕ";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		ТаблицаЗапроса.Сортировать("ВесоваяГруппа Убыв, ФормаОгранки Убыв, ВидОгранки Убыв, КачествоОгранки Убыв");
		
		Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
			Цена = ТаблицаЗапроса.Получить(0).ЦенаБазовая;
			Приказ = Выборка.Регистратор;

			//+Мельников 23.09.24 ВИП. Заявка 2792
			//Было: Возврат Цена;
			ЦенаВИП = ПолучитьОтклонениеОтБазовойЦеныКамняВИП(ПараметрыПоиска, Цена);
			
			//+МАН 10.12.25
			ПриказВИПВставки = Документы.ЛБ_ПриказИндивидуальныеУсловия.ПустаяСсылка();
			//-МАН
			Если ЦенаВИП <> Ложь Тогда
				//+МАН 10.12.25
				//БЫло: Цена = ЦенаВИП;
				Цена = ЦенаВИП.Цена;
				ПриказВИПВставки = ЦенаВИП.ПриказВИПВставки;
			КонецЕсли;
			//-Мельников

			//КатегорияОбъектаЗалога = СтрокаТЧТовары.Категория;  
			//ВидВставки = СтрокаТЧВставки.ВидВставки; 
			//
			//Возврат ПолучитьОтклонениеОтБазовойЦеныКамни(ДатаДок, ДокументОбъект.Ломбард, КатегорияОбъектаЗалога, ВидВставки, Цена);
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("Цена", Цена); 
	СтруктураВ.Вставить("Приказ", Приказ);
	//+МАН 10.12.25
	СтруктураВ.Вставить("ПриказВИПВставки", ПриказВИПВставки);
	//-МАН
	Возврат СтруктураВ;
КонецФункции

//+Мельников 23.09.24 Изменения для проверки ВИПов. Добавлен параметр Залогодатель. ВИП. Заявка 2792
Функция ПолучитьОтклонениеОтБазовойЦеныМеталлы(Дата, Ломбард, СхемаКредитования, Категория, Проба, БазоваяЦена, Залогодатель = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	
	МассивСхем = Новый Массив;
	МассивСхем.Добавить(Справочники.ЛБ_СхемыКредитования.ПустаяСсылка());
	Если ЗначениеЗаполнено(СхемаКредитования) Тогда
		МассивСхем.Добавить(СхемаКредитования);
	КонецЕсли;	
	Запрос.УстановитьПараметр("СхемыКредитования", МассивСхем);
	
	МассивКатегорий = Новый Массив;
	МассивКатегорий.Добавить(Справочники.ЛБ_КатегорииОбъектовЗалога.ПустаяСсылка());
	Если ЗначениеЗаполнено(Категория) Тогда
		МассивКатегорий.Добавить(Категория);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Категории", МассивКатегорий);
	
	МассивМеталлов = Новый Массив;
	МассивМеталлов.Добавить(Справочники.ЛБ_ДрагоценныеМеталлы.ПустаяСсылка());
	
	МассивПроб = Новый Массив;
	МассивПроб.Добавить(Справочники.ЛБ_Пробы.ПустаяСсылка());

	Если ЗначениеЗаполнено(Проба) Тогда
		МассивМеталлов.Добавить(Проба.Владелец);
		МассивПроб.Добавить(Проба);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Металлы", МассивМеталлов);
	Запрос.УстановитьПараметр("Пробы", МассивПроб);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);

	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.КатегорияОбъектаЗалога КАК Категория,
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.Металл КАК Металл,
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.ЗначениеОтклонения КАК ЗначениеОтклонения
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаРасчетаОценкиЗалога.СрезПоследних(
	               |			&Дата,
	               |			Ломбард = &Ломбард
	               |				И СхемаКредитования В (&СхемыКредитования)
	               |				И КатегорияОбъектаЗалога В (&Категории)
	               |				И Металл В (&Металлы)
	               |				И Проба В (&Пробы)
	               |				И ДатаНачалаДействия <= &Дата) КАК ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
    ТаблицаЗапроса.Сортировать("СхемаКредитования Убыв, Категория Убыв, Металл Убыв, Проба Убыв");
	
	Цена = БазоваяЦена;
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		СтрокаЗапроса = ТаблицаЗапроса.Получить(0);
		Если СтрокаЗапроса.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
			Цена = БазоваяЦена * (1+СтрокаЗапроса.ЗначениеОтклонения/100);
		ИначеЕсли СтрокаЗапроса.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное Тогда
			Цена = БазоваяЦена + СтрокаЗапроса.ЗначениеОтклонения;
	    КонецЕсли;
	КонецЕсли;	
	
	//+Мельников 23.09.24 ВИП. Заявка 2792
	Если Залогодатель <> Неопределено Тогда
		ЦенаВИП = ПолучитьОтклонениеОтБазовойЦеныМеталлаВИП(Дата, СхемаКредитования, Категория, Проба, Цена, Залогодатель);
	Иначе
		ЦенаВИП = Ложь;
	КонецЕсли;
	
	//+МАН 10.12.25
	ПриказВИПМеталлы = Документы.ЛБ_ПриказИндивидуальныеУсловия.ПустаяСсылка();
	//-МАН
	
	Если ЦенаВИП <> Ложь Тогда
		//+МАН 10.12.25
		//Было: Цена = ЦенаВИП;
		Цена = ЦенаВИП.Цена;
		ПриказВИПМеталлы = ЦенаВИП.ПриказВИПМеталлы;
		//-МАН
	КонецЕсли;
	//-Мельников

	//+МАН 10.12.25
	//Было: Возврат Цена;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Цена", Цена);
	СтруктураВозврата.Вставить("ПриказВИПМеталлы", ПриказВИПМеталлы);
	
	Возврат СтруктураВозврата;
    //-МАН

КонецФункции	
	
Функция ПолучитьЦенуМеталлаИзПрейскуранта(ПараметрыПоиска) Экспорт	
	Цена = 0;
	Приказ = Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ПараметрыПоиска.Дата);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыПоиска.Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаМеталлы.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы КАК ЛБ_ПрейскурантЦенНаМеталлы
	               |ГДЕ
	               |	ЛБ_ПрейскурантЦенНаМеталлы.Ломбард = &Ломбард
	               |	И ЛБ_ПрейскурантЦенНаМеталлы.ДатаНачалаДействия <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаМеталлы.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Запрос.УстановитьПараметр("Проба", ПараметрыПоиска.Проба);
		Запрос.УстановитьПараметр("Категория", ПараметрыПоиска.Категория);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", ПараметрыПоиска.ЕдиницаИзмерения);
		Запрос.УстановитьПараметр("Регистратор", Выборка.Регистратор);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Ломбард КАК Ломбард,
		               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Цена КАК ЦенаБазовая
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(
		               |			&Дата,
		               |			Ломбард = &Ломбард
		               |				И Проба = &Проба
		               |				И Категория = &Категория
		               |				И ЕдиницаИзмерения = &ЕдиницаИзмерения) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
		               |ГДЕ
		               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Регистратор = &Регистратор
		               |АВТОУПОРЯДОЧИВАНИЕ";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
			Цена = ТаблицаЗапроса.Получить(0).ЦенаБазовая; 
			Приказ = Выборка.Регистратор;
			
			//+Мельников 23.09.24 Добавлен параметр Залогодатель. ВИП. Заявка 2792
			Если ПараметрыПоиска.Свойство("Залогодатель") Тогда
				//+МАН 10.12.25 Изменил
				//Было: Цена = ПолучитьОтклонениеОтБазовойЦеныМеталлы(ПараметрыПоиска.Дата, ПараметрыПоиска.Ломбард, ПараметрыПоиска.СхемаКредитования, ПараметрыПоиска.Категория, ПараметрыПоиска.Проба, Цена, ПараметрыПоиска.Залогодатель);
				СтруктураЦена = ПолучитьОтклонениеОтБазовойЦеныМеталлы(ПараметрыПоиска.Дата, ПараметрыПоиска.Ломбард, ПараметрыПоиска.СхемаКредитования, ПараметрыПоиска.Категория, ПараметрыПоиска.Проба, Цена, ПараметрыПоиска.Залогодатель);
			Иначе 
				//+МАН 10.12.25 Изменил
				//Было: Цена = ПолучитьОтклонениеОтБазовойЦеныМеталлы(ПараметрыПоиска.Дата, ПараметрыПоиска.Ломбард, ПараметрыПоиска.СхемаКредитования, ПараметрыПоиска.Категория, ПараметрыПоиска.Проба, Цена);
				СтруктураЦена = ПолучитьОтклонениеОтБазовойЦеныМеталлы(ПараметрыПоиска.Дата, ПараметрыПоиска.Ломбард, ПараметрыПоиска.СхемаКредитования, ПараметрыПоиска.Категория, ПараметрыПоиска.Проба, Цена);
			КонецЕсли;
			//-Мельников
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("Приказ", Приказ);
	//+МАН 10.12.25 Изменил
	//Было СтруктураВ.Вставить("Цена", Цена); 
	СтруктураВ.Вставить("Цена", ?(СтруктураЦена = Неопределено, Цена, СтруктураЦена.Цена));
	СтруктураВ.Вставить("ПриказВИПМеталлы", ?(СтруктураЦена = Неопределено, Документы.ЛБ_ПриказИндивидуальныеУсловия.ПустаяСсылка(), СтруктураЦена.ПриказВИПМеталлы));
	//-МАН
	Возврат СтруктураВ;
КонецФункции	

//+Мельников 19.09.24 Изменения для проверки ВИПов. Добавлен параметр "Залогодатель". Заявка 2792
Функция ПолучитьПроцентнуюСхемуИзПрейскуранта(Дата, Ломбард, СхемаКредитования, СтатусЗалогодателя, СписокДопСтатусов, СуммаСсуды, Залогодатель = Неопределено) Экспорт
	Если НЕ ЗначениеЗаполнено(Ломбард) ИЛИ НЕ ЗначениеЗаполнено(СхемаКредитования) Тогда
		Возврат неопределено;
	КонецЕсли;  
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СхемыКредитованияПричиныПримененияПроцентнойСхемы.ПричинаПрименения КАК ПричинаПрименения
	               |ИЗ
	               |	Справочник.ЛБ_СхемыКредитования.ПричиныПримененияПроцентнойСхемы КАК ЛБ_СхемыКредитованияПричиныПримененияПроцентнойСхемы
	               |ГДЕ
	               |	ЛБ_СхемыКредитованияПричиныПримененияПроцентнойСхемы.Ссылка = &СхемаКредитования";
	ПричиныПрименения = Запрос.Выполнить().Выгрузить();
	
	СрокЗалога = 0;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УсловияПредоставленияКредитаСрезПоследних.СрокЗалога КАК СрокЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
	    СрокЗалога = Выборка.СрокЗалога;
	КонецЕсли;
 
	МассивСтатусовКлиента = Новый Массив;
	МассивСтатусовКлиента.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
	Если ЗначениеЗаполнено(СтатусЗалогодателя) Тогда
		МассивСтатусовКлиента.Добавить(СтатусЗалогодателя);
		Если ЗначениеЗаполнено(СтатусЗалогодателя.Родитель) Тогда 
			МассивСтатусовКлиента.Добавить(СтатусЗалогодателя.Родитель);
		КонецЕсли;	
	КонецЕсли;	
	
	Для каждого Эл Из СписокДопСтатусов Цикл 
		МассивСтатусовКлиента.Добавить(Эл.Значение);
		Если ЗначениеЗаполнено(Эл.Значение.Родитель) Тогда 
			МассивСтатусовКлиента.Добавить(Эл.Значение.Родитель);
		КонецЕсли;	
		СоставнойСтатус = ЛБ_УправлениеЛомбардом.ПолучитьСоставнойСтатусКлиента(Дата, СтатусЗалогодателя, Эл.Значение);
		Если НЕ СоставнойСтатус = неопределено Тогда
			МассивСтатусовКлиента.Добавить(СоставнойСтатус);
		КонецЕсли;	
	Конеццикла;	
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок КАК ЛБ_ПрейскурантПроцентныхСтавок
	               |ГДЕ
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Ломбард = &Ломбард
	               |	И ЛБ_ПрейскурантПроцентныхСтавок.ДатаНачалаДействия <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Запрос.УстановитьПараметр("СтатусыЗалогодателя", МассивСтатусовКлиента);
		Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
		Запрос.УстановитьПараметр("СуммаЗайма", СуммаСсуды);
		Запрос.УстановитьПараметр("ПричиныПрименения", ПричиныПрименения); 
		Запрос.УстановитьПараметр("Регистратор", Выборка.Регистратор);
		Запрос.УстановитьПараметр("ВидПроцентнойСтавки", Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая);
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.СтатусЗалогодателя КАК СтатусЗалогодателя,
		               |	&ВидПроцентнойСтавки КАК ВидПроцентнойСтавки,
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ПроцентнаяСтавка КАК ПроцентнаяСтавка
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок.СрезПоследних(
		               |			&Дата,
		               |			ПричинаПрименения В (&ПричиныПрименения)
		               |				И Ломбард = &Ломбард
		               |				И СтатусЗалогодателя В (&СтатусыЗалогодателя)
		               |				И СхемаКредитования = &СхемаКредитования
		               |				И ДиапазонСуммЗайма.СуммаОт <= &СуммаЗайма
		               |				И ВЫБОР
		               |					КОГДА ДиапазонСуммЗайма.СуммаДо = 0
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ ДиапазонСуммЗайма.СуммаДо >= &СуммаЗайма
		               |				КОНЕЦ) КАК ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних
		               |ГДЕ
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Регистратор = &Регистратор
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ДеньНачалаПрименения";       
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();  
		
		ТаблицаСтатусов = ТаблицаЗапроса.Скопировать();  
		ТаблицаСтатусов.Свернуть("СтатусЗалогодателя");	
		ТаблицаСтатусов.Колонки.Добавить("ПСК");
		Если ТаблицаСтатусов.Количество() > 1 И НЕ СрокЗалога = 0 Тогда   
			Для каждого стр Из ТаблицаСтатусов цикл 
				ОтборС = Новый Структура;
				ОтборС.Вставить("СтатусЗалогодателя", стр.СтатусЗалогодателя);
				ОтборС.Вставить("ПричинаПрименения", Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма);
				СтрокиС = ТаблицаЗапроса.НайтиСтроки(ОтборС); 
				СуммарнаяПроцентнаяСтавка = 0;
				Для сч = 0 По СтрокиС.Количество() - 1 Цикл 
					СтрС = строкиС.Получить(сч);
					ДеньНач = СтрС.ДеньНачалаПрименения;
					
					сч1 = сч + 1;
					Если сч1 >= СтрокиС.Количество() Тогда
						ДеньКон = СрокЗалога; 
					Иначе      
						СтрС1 = СтрокиС.Получить(сч1);
						ДеньКон = СтрС1.ДеньНачалаПрименения;  
						Если ДеньКон > СрокЗалога Тогда
							ДеньКон = СрокЗалога;
						КонецЕсли;	
					КонецЕсли;	

					КолДней = ДеньКон-ДеньНач+1;
					Ставка = СтрС.ПроцентнаяСтавка;
					СуммарнаяПроцентнаяСтавка = СуммарнаяПроцентнаяСтавка + Ставка*КолДней;
					Если ДеньКон = СрокЗалога Тогда  
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				Стр.ПСК = ЛБ_УправлениеЛомбардом.РасчетПСКГодПрейскурант(Дата, СрокЗалога, СуммарнаяПроцентнаяСтавка);
			КонецЦикла;  
			
			ТаблицаСтатусов.Сортировать("ПСК"); 
			ВыбранныйСтатус = ТаблицаСтатусов.Получить(0).СтатусЗалогодателя;
			
			УдСтроки = Новый СписокЗначений;
			Для каждого стр Из ТаблицаЗапроса цикл 
				Если НЕ Стр.СтатусЗалогодателя = ВыбранныйСтатус Тогда
					УдСтроки.Добавить(Стр);
				КонецЕсли;	
			КонецЦикла;
			Для каждого Эл из удСтроки Цикл
				ТаблицаЗапроса.Удалить(Эл.Значение);
			КонецЦикла;	
		КонецЕсли;	    
		ТаблицаЗапроса.Свернуть("ПричинаПрименения, ДеньНачалаПрименения, ВидПроцентнойСтавки, ПроцентнаяСтавка");
		
		//+Мельников 20.09.24 ВИП. Заявка 2792
		Если Залогодатель <> Неопределено Тогда
			СтавкаВИП = ПроверитьСтавкуВИП(Дата, СхемаКредитования, Залогодатель, СуммаСсуды);
		Иначе
			СтавкаВИП = Ложь;
		КонецЕсли;
	
		//+МАН 10.12.25
		ТаблицаЗапроса.Колонки.Добавить("ПриказВИП", Новый ОписаниеТипов("ДокументСсылка.ЛБ_ПриказИндивидуальныеУсловия"));
		//-МАН
		
		Если СтавкаВИП <> Ложь Тогда
			Для каждого СтрТЗ Из ТаблицаЗапроса Цикл
				Если (СтрТЗ.ПричинаПрименения = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма
					ИЛИ СтрТЗ.ПричинаПрименения = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ОплатаПроцентов)
					И СтрТЗ.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая Тогда
					//+МАН 10.12.25
					//Было: СтрТЗ.ПроцентнаяСтавка = СтавкаВИП;
					
					СтрТЗ.ПроцентнаяСтавка = СтавкаВИП.СтавкаВИП;
					СтрТЗ.ПриказВИП = СтавкаВИП.ПриказВИП;
					//-МАН
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		//-Мельников
		
		Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ТехническиеСтавкиСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ТехническиеСтавки.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_ТехническиеСтавкиСрезПоследних";
		ВыборкаДок = Запрос.Выполнить().Выбрать();
		Если ВыборкаДок.Следующий() Тогда   
			Запрос.УстановитьПараметр("Регистратор", ВыборкаДок.Регистратор);
			Запрос.УстановитьПараметр("ВидПроцентнойСтавки", Перечисления.ЛБ_ВидыПроцентныхСтавок.Техническая);		
			Запрос.Текст = "ВЫБРАТЬ
			               |	&ВидПроцентнойСтавки КАК ВидПроцентнойСтавки,
			               |	ЛБ_ТехническиеСтавкиСрезПоследних.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
			               |	ЛБ_ТехническиеСтавкиСрезПоследних.ДеньНачалаПрименения КАК ДеньНачалаПрименения
			               |ИЗ
			               |	РегистрСведений.ЛБ_ТехническиеСтавки.СрезПоследних(, ) КАК ЛБ_ТехническиеСтавкиСрезПоследних
			               |ГДЕ
			               |	ЛБ_ТехническиеСтавкиСрезПоследних.Регистратор = &Регистратор";
			ВыборкаТ = Запрос.Выполнить().Выбрать();
			Если ВыборкаТ.Следующий() Тогда	
				Если НЕ ВыборкаТ.ДеньНачалаПрименения = 0 Тогда
					Для каждого СтрП Из ПричиныПрименения Цикл
					    НоваяСтр = ТаблицаЗапроса.Добавить(); 
						НоваяСтр.ДеньНачалаПрименения = ВыборкаТ.ДеньНачалаПрименения; 
						НоваяСтр.ПроцентнаяСтавка = ВыборкаТ.ПроцентнаяСтавка; 
						НоваяСтр.ВидПроцентнойСтавки = ВыборкаТ.ВидПроцентнойСтавки; 
						НоваяСтр.ПричинаПрименения = СтрП.ПричинаПрименения;
					КонецЦикла;	
				КонецЕсли;	
		    КонецЕсли;
		КонецЕсли;
		
		СтруктураВ = Новый Структура;
		СтруктураВ.Вставить("ТаблицаСтавок", ТаблицаЗапроса); 
		СтруктураВ.Вставить("Приказ", Выборка.Регистратор);  
		
		Возврат СтруктураВ;
		//Возврат ТаблицаЗапроса;			
	КонецЕсли;	
	
	Возврат неопределено; 
КонецФункции		
	
Функция ВыбратьДействующиеАкции(Дата, Ломбард, ПричинаПрименения, МассивСтатусовКлиента, СуммаЗайма, СписокЛьготныхСтатусов, МассивСК, Промокод, Предъявитель) Экспорт 
	МассивАкций = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Ломбард) Тогда
		Возврат МассивАкций;
	КонецЕсли;  
	
	ДатаДок = Дата;
	ДатаПроверка = Дата; 
	
	//МассивСтатусовКлиента = Новый Массив;
	//МассивСтатусовКлиента.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
	//Если ЗначениеЗаполнено(СтатусЗалогодателя) Тогда
	//	МассивСтатусовКлиента.Добавить(СтатусЗалогодателя);
	//КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ДатаПроверка", ДатаПроверка);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.УстановитьПараметр("СтатусыЗалогодателя", МассивСтатусовКлиента);
	Запрос.УстановитьПараметр("СхемыКредитования", МассивСК);
	Запрос.УстановитьПараметр("СуммаЗайма", СуммаЗайма);
	Запрос.УстановитьПараметр("ПричинаПрименения", ПричинаПрименения);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.Акция КАК Акция,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.СхемаКредитования КАК СхемаКредитования
	               |ИЗ
	               |	РегистрСведений.ЛБ_АкцииПроцентныеСтавки.СрезПоследних(
	               |			&Дата,
	               |			ПричинаПрименения = &ПричинаПрименения
	               |				И Ломбард = &Ломбард
	               |				И ДатаНачалаДействия <= &ДатаПроверка
	               |				И ДатаОкончанияДействия >= &ДатаПроверка
	               |				И СтатусЗалогодателя В (&СтатусыЗалогодателя)
	               |				И СхемаКредитования В (&СхемыКредитования)
	               |				И ДиапазонСуммЗайма.СуммаОт <= &СуммаЗайма
	               |				И ВЫБОР
	               |					КОГДА ДиапазонСуммЗайма.СуммаДо = 0
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ДиапазонСуммЗайма.СуммаДо >= &СуммаЗайма
	               |				КОНЕЦ) КАК ЛБ_АкцииПроцентныеСтавкиСрезПоследних";  
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Удстроки = Новый СписокЗначений;
	Для каждого Выборка Из ТаблицаЗапроса Цикл
		Если Выборка.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.ПоДням Тогда 
			ДеньНедели = ДеньНедели(ДатаПроверка);
			Отбор = Новый Структура;
			Отбор.Вставить("ДеньНедели", ДеньНедели); 
			Строки = Выборка.Акция.ДниНедели.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда  
				Удстроки.Добавить(Выборка);
			КонецЕсли;	 
		ИначеЕсли Выборка.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.ПоСтатусамЗаемщика Тогда 
			ЕстьСтатус = Ложь;
			Для каждого Эл Из СписокЛьготныхСтатусов Цикл 				 
				Отбор = Новый Структура;
				Отбор.Вставить("Статус", Эл.Значение); 
				Строки = Выборка.Акция.СтатусыЗаемщика.НайтиСтроки(Отбор);
				Если НЕ Строки.Количество() = 0 Тогда 
					ЕстьСтатус = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	 
			Если НЕ ЕстьСтатус Тогда  
				Удстроки.Добавить(Выборка);
			КонецЕсли;	 
		ИначеЕсли Выборка.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.ПоПромокоду Тогда
			Если НЕ ПустаяСтрока(Промокод) Тогда 
				Если НЕ (нрег(СокрЛП(Промокод)) = нрег(СокрЛП(Выборка.Акция.Промокод))) Тогда 
					Удстроки.Добавить(Выборка);
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли Выборка.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.НаПредъявителя Тогда
			Если НЕ Предъявитель Тогда 
				Удстроки.Добавить(Выборка);
			КонецЕсли;		
		КонецЕсли;	
	КонецЦикла;
	
	Для каждого Эл Из Удстроки Цикл 
		ТаблицаЗапроса.Удалить(Эл.Значение);
	Конеццикла;
	ТаблицаЗапроса.Свернуть("СхемаКредитования, Акция");
	
	Возврат ТаблицаЗапроса;
КонецФункции

Функция ПолучитьПроцентнуюСтавкуОтклонениеПоАкции(Дата, Акция, Ломбард, СхемаКредитования, СтатусЗалогодателя, СписокДопСтатусов, ПричинаПрименения, СуммаСсуды) Экспорт 
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Ставка", 0); 
	СтруктураВозврата.Вставить("Отклонение", Перечисления.ЛБ_ОтклонениеОтБазовойЦены.ПустаяСсылка()); 
	СтруктураВозврата.Вставить("ЗначениеОтклонения", 0);
	
	Если НЕ ЗначениеЗаполнено(Ломбард) ИЛИ НЕ ЗначениеЗаполнено(Акция) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	ДатаДок = Дата;
	ДатаПроверка = Дата; 	
	
	МассивСтатусовКлиента = Новый Массив;
	МассивСтатусовКлиента.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
	Если ЗначениеЗаполнено(СтатусЗалогодателя) Тогда
		МассивСтатусовКлиента.Добавить(СтатусЗалогодателя);
		Если ЗначениеЗаполнено(СтатусЗалогодателя.Родитель) Тогда 
			МассивСтатусовКлиента.Добавить(СтатусЗалогодателя.Родитель);
		КонецЕсли;	
	КонецЕсли;	  
	
	Для каждого Эл Из СписокДопСтатусов Цикл 
		МассивСтатусовКлиента.Добавить(Эл.Значение);
		Если ЗначениеЗаполнено(Эл.Значение.Родитель) Тогда 
			МассивСтатусовКлиента.Добавить(Эл.Значение.Родитель);
		КонецЕсли;	 
	Конеццикла;	

	МассивСК = Новый Массив;
	МассивСК.Добавить(Справочники.ЛБ_СхемыКредитования.ПустаяСсылка());
	Если ЗначениеЗаполнено(СхемаКредитования) Тогда
		МассивСК.Добавить(СхемаКредитования);
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ДатаПроверка", ДатаПроверка);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.УстановитьПараметр("СтатусыЗалогодателя", МассивСтатусовКлиента);
	Запрос.УстановитьПараметр("СхемыКредитования", МассивСК);
	Запрос.УстановитьПараметр("СуммаЗайма", СуммаСсуды);
	Запрос.УстановитьПараметр("ПричинаПрименения", ПричинаПрименения);
	Запрос.УстановитьПараметр("Акция", Акция); 
	Запрос.УстановитьПараметр("ПустойСтатус", Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.Регистратор КАК Приказ,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.Отклонение КАК Отклонение,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.ЗначениеОтклонения КАК ЗначениеОтклонения,
	               |	ВЫБОР
	               |		КОГДА ЛБ_АкцииПроцентныеСтавкиСрезПоследних.СтатусЗалогодателя = &ПустойСтатус
	               |			ТОГДА 0
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ЛБ_АкцииПроцентныеСтавкиСрезПоследних.СтатусЗалогодателя.ЭтоГруппа
	               |					ТОГДА 1
	               |				ИНАЧЕ 2
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Вид
	               |ИЗ
	               |	РегистрСведений.ЛБ_АкцииПроцентныеСтавки.СрезПоследних(
	               |			&Дата,
	               |			ПричинаПрименения = &ПричинаПрименения
	               |				И Акция = &Акция
	               |				И Ломбард = &Ломбард
	               |				И ДатаНачалаДействия <= &ДатаПроверка
	               |				И ДатаОкончанияДействия >= &ДатаПроверка
	               |				И СтатусЗалогодателя В (&СтатусыЗалогодателя)
	               |				И СхемаКредитования В (&СхемыКредитования)
	               |				И ДиапазонСуммЗайма.СуммаОт <= &СуммаЗайма
	               |				И ВЫБОР
	               |					КОГДА ДиапазонСуммЗайма.СуммаДо = 0
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ДиапазонСуммЗайма.СуммаДо >= &СуммаЗайма
	               |				КОНЕЦ) КАК ЛБ_АкцииПроцентныеСтавкиСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Вид УБЫВ,
	               |	ЛБ_АкцииПроцентныеСтавкиСрезПоследних.Период УБЫВ";  
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Если НЕ ТаблицаЗапроса.Количество() = 0  Тогда 
		Выборка = ТаблицаЗапроса.Получить(0); 
		СтруктураВозврата.Вставить("Приказ", Выборка.Приказ);
		СтруктураВозврата.Вставить("Ставка", Выборка.ПроцентнаяСтавка); 
	    СтруктураВозврата.Вставить("Отклонение", Выборка.Отклонение); 
	    СтруктураВозврата.Вставить("ЗначениеОтклонения", Выборка.ЗначениеОтклонения);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
КонецФункции	

//+Мельников 19.09.24 Изменения для проверки ВИПов. Добавлен параметр "Залогодатель". Заявка 2792
Функция ЗаполнитьТаблицуПроцентныхСтавок(Дата, Ломбард, СхемаКредитования, Акция, СтатусЗалогодателя, СписокДопСтатусов, СуммаСсуды, Залогодатель = Неопределено) Экспорт	
	ТаблицаСтавок = Новый ТаблицаЗначений;    
	ТаблицаСтавок.Колонки.Добавить("ПричинаПрименения", Новый ОписаниеТипов("ПеречислениеСсылка.ЛБ_ПричиныПримененияПроцентнойСхемы")); 
	ТаблицаСтавок.Колонки.Добавить("ВидПроцентнойСтавки", Новый ОписаниеТипов("ПеречислениеСсылка.ЛБ_ВидыПроцентныхСтавок"));  
	ТаблицаСтавок.Колонки.Добавить("ДеньНачалаПрименения", Новый ОписаниеТипов("Число")); 
	ТаблицаСтавок.Колонки.Добавить("ПроцентнаяСтавка", Новый ОписаниеТипов("Число"));	
	ТаблицаСтавок.Колонки.Добавить("ПроцентнаяСтавкаАкция", Новый ОписаниеТипов("Число"));
	ТаблицаСтавок.Колонки.Добавить("ОтклонениеАкцияАбсолютное", Новый ОписаниеТипов("Число"));
	ТаблицаСтавок.Колонки.Добавить("ОтклонениеАкцияОтносительное", Новый ОписаниеТипов("Число"));
	ТаблицаСтавок.Колонки.Добавить("Приказ"); 
	ТаблицаСтавок.Колонки.Добавить("ПриказАкция");
	//+МАН 10.12.25
	ТаблицаСтавок.Колонки.Добавить("ПриказВИП", Новый ОписаниеТипов("ДокументСсылка.ЛБ_ПриказИндивидуальныеУсловия")); 
	//-МАН
		
	Приказ = неопределено;
	//+Мельников 19.09.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
	Если Залогодатель <> Неопределено Тогда
		Результат = ПолучитьПроцентнуюСхемуИзПрейскуранта(Дата, Ломбард, СхемаКредитования, СтатусЗалогодателя, СписокДопСтатусов, СуммаСсуды, Залогодатель); 
		Если НЕ Результат = неопределено Тогда
		   ТаблицаС = Результат.ТаблицаСтавок;
		   Приказ = Результат.Приказ;
		КонецЕсли;   
	Иначе
		Результат = ПолучитьПроцентнуюСхемуИзПрейскуранта(Дата, Ломбард, СхемаКредитования, СтатусЗалогодателя, СписокДопСтатусов, СуммаСсуды);  
		Если НЕ Результат = неопределено Тогда
		   ТаблицаС = Результат.ТаблицаСтавок;
		   Приказ = Результат.Приказ;
		КонецЕсли; 
	КонецЕсли;
	//-Мельников
	Если НЕ Приказ = неопределено Тогда 
		Для каждого Стр из ТаблицаС Цикл
		     НоваяСтрока = ТаблицаСтавок.Добавить(); 
			 НоваяСтрока.Приказ = Приказ;
		     ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		КонецЦикла;
		ПричиныПрименения = ТаблицаСтавок.Скопировать();
		ПричиныПрименения.Свернуть("ПричинаПрименения");  
		Для каждого стрП из ПричиныПрименения Цикл 
			СтруктураАкция = ПолучитьПроцентнуюСтавкуОтклонениеПоАкции(Дата, Акция, Ломбард, СхемаКредитования, СтатусЗалогодателя, СписокДопСтатусов, СтрП.ПричинаПрименения, СуммаСсуды);		
			Если НЕ (СтруктураАкция.Ставка = 0) ИЛИ НЕ (СтруктураАкция.ЗначениеОтклонения = 0) Тогда
				Отбор = Новый структура;
				Отбор.Вставить("ПричинаПрименения", СтрП.ПричинаПрименения);
				Строки = ТаблицаСтавок.НайтиСтроки(Отбор); 
				Для каждого стрС Из Строки цикл
					СтрС.ПриказАкция = СтруктураАкция.Приказ; 
					//+МАН 10.12.25
					СтрС.ПриказВИП = Документы.ЛБ_ПриказИндивидуальныеУсловия.ПустаяСсылка();
					//-МАН
					Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Техническая Тогда
						Продолжить;
					КонецЕсли;	
					СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная;
					СтрС.ПроцентнаяСтавкаАкция = СтруктураАкция.Ставка;
					Если НЕ СтруктураАкция.ЗначениеОтклонения = 0 Тогда
						Если СтруктураАкция.Отклонение = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное Тогда
						    СтрС.ОтклонениеАкцияАбсолютное = СтруктураАкция.ЗначениеОтклонения;
						ИначеЕсли СтруктураАкция.Отклонение = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
						    СтрС.ОтклонениеАкцияОтносительное = СтруктураАкция.ЗначениеОтклонения;
	                    КонецЕсли;
					КонецЕсли;	
