Функция ПроверитьНаРезиденство(Залогодатель, Период) Экспорт

	Резиденство = Ложь; 
	Гражданство = неопределено;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство
		|ИЗ
		|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Период, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Гражданство = Выборка.Гражданство;  
	КонецЕсли;
	
	Если Гражданство = Справочники.СтраныМира.Россия Тогда
		 Резиденство = Истина;
	Иначе	 
		Если НЕ Гражданство = неопределено Тогда
			Запрос.УстановитьПараметр("Гражданство", Гражданство);
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИСТИНА КАК Резиденство
				|ИЗ
				|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Период, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
				|ГДЕ
				|	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство = &Гражданство
				|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВидНаЖительство)
				|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия > НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
				|	И НЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ИСТИНА
				|ИЗ
				|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Период, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
				|ГДЕ
				|	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство = &Гражданство
				|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВидНаЖительство)
				|	И ЕСТЬNULL(ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
				|	И НЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен";			
			
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл
					Резиденство = Истина;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	Возврат Резиденство;
	
КонецФункции 

Функция ПроверитьДействительностьВидаНаЖительство(Стр, ДатаРождения, ДатаПроверки = неопределено) Экспорт
	Если ДатаПроверки = неопределено Тогда
		ДатаПроверки = ТекущаяДата();
	КонецЕсли;	
		
	//Залогодатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ДокументСсылка, "Владелец");
	//Если ИзмененыПерсональныеДанныеКлиента(Залогодатель, Стр.ДокументНачалоДействия) Тогда
	//    ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В связи с изменениями персональных данных клиента, документ ""Вид на жительство"" является недействительным!'"));
	//	Возврат Ложь;
	//КонецЕсли;
	
	СрокОкончания = Стр.ДокументСрокДействия;
	ДатаВыдачи    = Стр.ДокументДатаВыдачи;
	ТекДата       = НачалоДня(ДатаПроверки);
	
	Если СрокОкончания = Дата(1, 1, 1) Тогда 
		
		Возраст = ВычислитьВозраст(ДатаРождения);
		
		ДатаРождения14 = ДобавитьМесяц(ДатаРождения, 12 * 14); 
		Если Возраст <= 14 Тогда	    
			Если ДатаВыдачи > ДатаРождения14 Тогда
				Возврат Истина;
			ИначеЕсли ДатаРождения14 > ТекДата Тогда
				Возврат Истина;
			Иначе		  
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В связи с достижением клиента 14 лет, документ ""Вид на жительство"" является недействительным! Дальнейшие операции с клиентом в системе блокированы!'"));
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Если ДатаВыдачи < ДатаРождения14 Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В связи с достижением клиента 14 лет, документ ""Вид на жительство"" является недействительным! Дальнейшие операции с клиентом в системе блокированы!'"));
				Возврат Ложь;
			КонецЕсли; 
			
			ДатаРождения20 = ДобавитьМесяц(ДатаРождения, 12 * 20);
			Если Возраст <= 20 Тогда	    
				Если ДатаВыдачи > ДатаРождения20 Тогда
					Возврат Истина;
				ИначеЕсли ДатаРождения20 > ТекДата Тогда
					Возврат Истина;
				Иначе		  
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В связи с достижением клиента 20 лет, документ ""Вид на жительство"" является недействительным! Дальнейшие операции с клиентом в системе блокированы!'"));
					Возврат Ложь;
				КонецЕсли;
			Иначе
				Если ДатаВыдачи < ДатаРождения20 Тогда
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В связи с достижением клиента 20 лет, документ ""Вид на жительство"" является недействительным! Дальнейшие операции с клиентом в системе блокированы!'"));
					Возврат Ложь;
				КонецЕсли;
				
				ДатаРождения45 = ДобавитьМесяц(ДатаРождения, 12 * 45);
				Если ДатаВыдачи > ДатаРождения45 Тогда
					Возврат Истина;
				ИначеЕсли ДатаРождения45 > ТекДата Тогда
					Возврат Истина;
				Иначе		  
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В связи с достижением клиента 45 лет, документ ""Вид на жительство"" является недействительным! Дальнейшие операции с клиентом в системе блокированы!'"));
					Возврат Ложь;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Если СрокОкончания >= ТекДата Тогда
			РазницаВДнях = (СрокОкончания - ТекДата) / (60 * 60 * 24); 
			Если РазницаВДнях <= 30  Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо напомнить клиенту о скором окончании срока действия вида на жительство!'"));
			КонецЕсли;	
			Возврат Истина;
		Иначе	
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Срок действия вида на жительство истек! Дальнейшие операции с клиентом в системе не возможны!'"));
			Возврат Ложь;
		КонецЕсли;	
		
	КонецЕсли;
	
КонецФункции

