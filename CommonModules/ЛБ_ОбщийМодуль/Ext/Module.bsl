Процедура ПроверитьДействительностьДокумента(Стр, Знач ДатаРождения, ВыводитьСообщения = Истина, ДатаПроверки = неопределено) Экспорт
	Если  ДатаПроверки = неопределено Тогда  
		ДатаПроверки = ТекущаяДата(); 
	КонецЕсли;	
	ЕстьСвидетельствоОРождении = ложь;	
	Если Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность Тогда
		Если (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ (Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность) Тогда
			Если НЕ (ДатаРождения = Дата(1,1,1)) И (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) Тогда
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, Стр.ДокументДатаВыдачи, ВыводитьСообщения) Тогда
				    Стр.ПроверкаНеДействителен = Истина;
				КонецЕсли; 
			ИначеЕсли НЕ Стр.ДокументСрокДействия = Дата(1,1,1) Тогда
				Если Стр.ДокументСрокДействия < НачалоДня(ДатаПроверки) Тогда
			        Стр.ПроверкаНеДействителен = Истина;
			    КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) Тогда
		ЕстьСвидетельствоОРождении = Истина;
		Если НЕ (ДатаРождения = Дата(1,1,1))  Тогда
			Если НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(ДатаРождения, ДатаПроверки) Тогда
				Стр.ПроверкаНеДействителен = Истина;
			КонецЕсли;
		КонецЕсли;
	//ИначеЕсли ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Стр.ВидДокументаЗалогодателя, Стр.ВидДокумента) Тогда
	ИначеЕсли НЕ Стр.ДокументСрокДействия = Дата(1,1,1) Тогда
		Если Стр.ДокументСрокДействия < НачалоДня(ДатаПроверки) Тогда
			Стр.ПроверкаНеДействителен = Истина;
		КонецЕсли;
	// ++ Сербаев 07.06.2023  (Проверка документа Вид на жительство на действительность)
    ИначеЕсли Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда
	     Если ПроверитьДействительностьВидаНаЖительство(Стр, ДатаРождения, ДатаПроверки) Тогда
		     Стр.ПроверкаНеДействителен = Истина;
		 КонецЕсли;
	// -- Сербаев 07.06.2023
	КонецЕсли;		
КонецПроцедуры    

Процедура ПроверитьДействительностьСвидетельствоОРождении(ТаблицаДокументов) Экспорт 
	//	проверим недействительность свидетельства о рождении если есть паспорт
	ЕстьПаспорт = ложь;
	Для каждого Стр Из ТаблицаДокументов Цикл
		Если (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) И НЕ (Стр.ДокументНЕДействителен ИЛИ Стр.ПроверкаНеДействителен) Тогда
		    ЕстьПаспорт = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	Если ЕстьПаспорт Тогда
		ОтборД = Новый структура;
		ОтборД.Вставить("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении);
		СтрокиД = ТаблицаДокументов.НайтиСтроки(ОтборД);
		Для каждого СтрД Из СтрокиД цикл
			СтрД.ПроверкаНеДействителен = Истина;
		Конеццикла;	
	КонецЕсли;	 
КонецПроцедуры

Функция ПолучитьКлючСтроки(ДокументОбъект, ИмяТабличнойЧасти = "Товары") Экспорт
	
	ТаблицаКлючей = ДокументОбъект[ИмяТабличнойЧасти].Выгрузить(, "КлючСтроки");
	Если  ТаблицаКлючей.Количество() = 1 Тогда
		Возврат 1;
	Иначе	
		ТаблицаКлючей.Сортировать("КлючСтроки Убыв");
		
		Возврат ТаблицаКлючей[0].КлючСтроки + 1;
	КонецЕсли;	
	
КонецФункции

