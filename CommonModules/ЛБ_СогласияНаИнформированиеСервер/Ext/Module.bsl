Процедура ОтозватьСогласиеНаИнформированиеПослеОтзываПД(Клиент, Комментарий = Неопределено) Экспорт
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_СогласияНаИнформирование.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период        = ТекущаяДата();
		МенеджерЗаписи.Клиент        = Клиент;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус        = Перечисления.ЛБ_СтатусыСогласийНаИнформирование.Расторгнуто;
		Если Комментарий <> Неопределено Тогда
			МенеджерЗаписи.Основание = "Согласие на информирование прекращено (отзыв согласия на обработку ПДн (ЦО))";
			МенеджерЗаписи.Ломбард   = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
		Иначе
			МенеджерЗаписи.Основание = "Согласие на информирование прекращено (отзыв согласия на обработку ПДн)";
			МенеджерЗаписи.Ломбард   = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		КонецЕсли;
		МенеджерЗаписи.Записать();
		РезультатОтзыва = Истина;
	Исключение	
	КонецПопытки;
КонецПроцедуры

Процедура УдалитьЗаключениеСогласияСервер(Клиент, СтруктураСогласия) Экспорт
	
	НаборЗаписей = РегистрыСведений.ЛБ_СогласияНаИнформирование.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(СтруктураСогласия.Период);
	НаборЗаписей.Отбор.Клиент.Установить(Клиент);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() Тогда
		Запись = НаборЗаписей[0];
		Запись.Ошибочное = Истина;
		НаборЗаписей.Записать();
	КонецЕсли;
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_СогласияНаИнформирование.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период        = ТекущаяДата();
		МенеджерЗаписи.Клиент        = Клиент;
		МенеджерЗаписи.Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус        = Перечисления.ЛБ_СтатусыСогласийНаИнформирование.НеЗаключено;
		МенеджерЗаписи.Основание     = "Удалено Согласие на информирование";
		МенеджерЗаписи.Записать();
		РезультатЗаключения = Истина;
	Исключение
		РезультатЗаключения = Ложь;
	КонецПопытки;
	//Возврат РезультатЗаключения;
КонецПроцедуры

