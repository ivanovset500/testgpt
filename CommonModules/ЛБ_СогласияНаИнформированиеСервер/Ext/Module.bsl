		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.Email КАК Email,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.КонтактноеЛицо КАК КонтактноеЛицо,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес
		|ИЗ
		|	РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента.СрезПоследних(&ТекущаяДата, Клиент = &Клиент) КАК ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		ДатаСреза = Выборка.Период;
		СтруктураРеквизитовКонтактныеДанныеДляПечати = Новый Структура;
		Если ЗначениеЗаполнено(Выборка.Телефон) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Телефон", Выборка.Телефон);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ТелефонДополнительный) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ТелефонДополнительный", Выборка.ТелефонДополнительный);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Email) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Email", Выборка.Email);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.КонтактноеЛицо) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("КонтактноеЛицо", Выборка.КонтактноеЛицо);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ТелефонКонтактногоЛица) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ТелефонКонтактногоЛица", Выборка.ТелефонКонтактногоЛица);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ФактическийАдрес) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ФактическийАдрес", Выборка.ФактическийАдрес);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ПочтовыйАдрес) Тогда
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ПочтовыйАдрес", Выборка.ПочтовыйАдрес);
		КонецЕсли;
	КонецЕсли;	

    Иначе
	ДатаСреза     = ТекущаяДата();
	КонецЕсли;
	
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Поля = "НаименованиеПолное, АдресОрганизацииФакт, ТелефонОрганизации, АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = ОрганизацииСервер.СведенияОбОрганизации(Организация, Поля, ДатаСреза);	
	
	Структура.Вставить("Дата",                          ?(ЗначениеЗаполнено(ДатаСреза), Формат(ДатаСреза, "ДЛФ=D"), ""));
	
	Структура.Вставить("НаименованиеОрганизации",       ?(ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеДляПечати),
	                                                    СведенияОбОрганизации.НаименованиеДляПечати, ""));
	ДанныеКлиента                                       = ДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("Клиент",                        ДанныеКлиента.Фамилия + " " +  ДанныеКлиента.Имя + " " + ДанныеКлиента.Отчество);													
	//Структура.Вставить("Клиент",                        ?(ЗначениеЗаполнено(Клиент), Строка(Клиент), ""));
	ПаспортныеДанныеКлиента                             = ПаспортныеДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("ДатаРожденияКлиента",           Формат(ДанныеКлиента.ДатаРождения, "ДФ=dd.MM.yyyy"));
	Структура.Вставить("ПаспортныеДанныеКлиента",       ?(ЗначениеЗаполнено(ПаспортныеДанныеКлиента.ПаспортныеДанные), ПаспортныеДанныеКлиента.ПаспортныеДанные, ""));
	КонтактнаяИнформацияКлиента                         = КонтактнаяИнформацияКлиента(Клиент, ДатаСреза);
	Структура.Вставить("МестоЖительстваКлиента",        ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.АдресПоПрописке), 
	                                                    КонтактнаяИнформацияКлиента.АдресПоПрописке, ""));
	Структура.Вставить("Телефон",				        ?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("Телефон"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.Телефон, Символы.НПП));
	Структура.Вставить("ТелефонДополнительный",			?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ТелефонДополнительный"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.ТелефонДополнительный, Символы.НПП));
	Структура.Вставить("Email",				            ?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("Email"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.Email, Символы.НПП));
	Структура.Вставить("КонтактноеЛицо",				?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("КонтактноеЛицо"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.КонтактноеЛицо, Символы.НПП));
	Структура.Вставить("ТелефонКонтактногоЛица",		?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ТелефонКонтактногоЛица"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.ТелефонКонтактногоЛица, Символы.НПП));
	Структура.Вставить("ФактическийАдрес",				?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ФактическийАдрес"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.ФактическийАдрес, Символы.НПП));
	Структура.Вставить("ПочтовыйАдрес",				    ?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ПочтовыйАдрес"), 
	                                                    СтруктураРеквизитовКонтактныеДанныеДляПечати.ПочтовыйАдрес, Символы.НПП));
	Возврат Структура;
КонецФункции 

Функция ПаспортныеДанныеКлиента(Залогодатель, Дата, ДокументСПрописнойБуквы = Ложь)
	
	Результат = Новый Структура("ПаспортныеДанные, ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения", "", "", "", "", "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента.Представление КАК ВидДокумента,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК КемВыдан,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА """"
		|		ИНАЧЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи
		|	КОНЕЦ КАК ДатаВыдачи,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК КодПодразделения
		|ИЗ
		|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		|ГДЕ
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя = &ДУЛ
		|	И НЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен
		|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ";
	
	Запрос.УстановитьПараметр("ДУЛ", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		
		ВидДокументаВыборка = ?(ДокументСПрописнойБуквы, СтрШаблон("%1%2", НРег(Лев(Выборка.ВидДокумента, 1)), Сред(Выборка.ВидДокумента, 2)), Выборка.ВидДокумента);
		
		ВидДокумента     = ?(ПустаяСтрока(ВидДокументаВыборка),      "", СтрШаблон(" %1:",                    ВидДокументаВыборка));
		Серия            = ?(ПустаяСтрока(Выборка.Серия),            "", СтрШаблон(" серия %1",              Выборка.Серия));
		Номер            = ?(ПустаяСтрока(Выборка.Номер),            "", СтрШаблон(" номер %1,",              Выборка.Номер));
		КемВыдан         = ?(ПустаяСтрока(Выборка.КемВыдан),         "", СтрШаблон(" выдан: %1,",             Выборка.КемВыдан));
		ДатаВыдачи       = ?(ПустаяСтрока(Выборка.ДатаВыдачи),       "", СтрШаблон(" дата выдачи: %1,",       Формат(Выборка.ДатаВыдачи,"ДФ=dd.MM.yyyy")));
		КодПодразделения = ?(ПустаяСтрока(Выборка.КодПодразделения), "", СтрШаблон(" код подразделения: %1,", Выборка.КодПодразделения)); 
		
		Результат.Вставить("ПаспортныеДанные", СтрШаблон("%1%2%3%4%5%6", ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения));
		Результат.Вставить("ВидДокумента",     Выборка.ВидДокумента);
		Результат.Вставить("Серия",            Выборка.Серия);
		Результат.Вставить("Номер",            Выборка.Номер);
		Результат.Вставить("КемВыдан",         Выборка.КемВыдан);
		Результат.Вставить("ДатаВыдачи",       Выборка.ДатаВыдачи);
		Результат.Вставить("КодПодразделения", Выборка.КодПодразделения);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ДолжностьОтветственного(Сотрудник, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&Дата, Сотрудник = &Сотрудник) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Должность;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция КонтактнаяИнформацияКлиента(Залогодатель, Дата)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Структура = Новый Структура;
        Структура.Вставить("Телефон",          Выборка.Телефон);
        Структура.Вставить("Email",            Выборка.Email);
        Структура.Вставить("АдресПоПрописке",  Выборка.АдресПоПрописке);
        Структура.Вставить("ФактическийАдрес", Выборка.ФактическийАдрес);
		Возврат Структура;
	Иначе
		Структура = Новый Структура;
        Структура.Вставить("Телефон",          "");
        Структура.Вставить("Email",            "");
        Структура.Вставить("АдресПоПрописке",  "");
        Структура.Вставить("ФактическийАдрес", "");
		Возврат Структура;
    КонецЕсли;		
КонецФункции

