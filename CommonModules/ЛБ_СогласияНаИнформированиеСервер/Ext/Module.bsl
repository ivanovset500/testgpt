
Функция ЗаключитьСогласиеНаИнформированиеСервер(Клиент) Экспорт
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_СогласияНаИнформирование.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период        = ТекущаяДата();
		МенеджерЗаписи.Клиент        = Клиент;
		МенеджерЗаписи.Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		МенеджерЗаписи.ДатаОкончания = ДобавитьМесяц(МенеджерЗаписи.Период, 60);
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус        = Перечисления.ЛБ_СтатусыСогласийНаИнформирование.Заключено;
		МенеджерЗаписи.Основание     = "Заключено Согласие на информирование";
		МенеджерЗаписи.Записать();
		РезультатЗаключения = Истина;
	Исключение
		РезультатЗаключения = Ложь;
	КонецПопытки;
	Возврат РезультатЗаключения;
КонецФункции // ЗаключитьЭДОСервер()

Функция НаличиеДействующегоСогласия(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СогласияНаИнформированиеСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ЛБ_СогласияНаИнформирование.СрезПоследних(&ТекущаяДата, Клиент = &Клиент) КАК ЛБ_СогласияНаИнформированиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Статус = Выборка.Статус;
		Если Статус = Перечисления.ЛБ_СтатусыСогласийНаИнформирование.Заключено Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;	

КонецФункции 

