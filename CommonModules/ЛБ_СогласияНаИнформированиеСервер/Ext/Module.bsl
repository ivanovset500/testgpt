Функция ПоследнийСтатусСогласия(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СогласияНаИнформированиеСрезПоследних.Статус КАК Статус,
		|	ЛБ_СогласияНаИнформированиеСрезПоследних.Период КАК Период,
		|	ЛБ_СогласияНаИнформированиеСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СогласияНаИнформирование.СрезПоследних(
		|			&ТекущаяДата,
		|			Клиент = &Клиент
		|				И НЕ Ошибочное
		|				И Основание <> ""Удалено Согласие на информирование""
		|				И Основание <> ""Удален отзыв Согласия на информирование"") КАК ЛБ_СогласияНаИнформированиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураВыборки = Новый Структура;
	Если Выборка.Следующий() Тогда
		СтруктураВыборки.Вставить("Статус",        Выборка.Статус);
		СтруктураВыборки.Вставить("Период",        Выборка.Период);
		СтруктураВыборки.Вставить("Ответственный", Выборка.Ответственный);
	КонецЕсли;
	Возврат СтруктураВыборки;

КонецФункции

