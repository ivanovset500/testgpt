Функция ПоследниеКонтактныеДанные(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ТелефонПредыдущий КАК ТелефонПредыдущий,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ТелефонДополнительныйПредыдущий КАК ТелефонДополнительныйПредыдущий,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.EmailПредыдущий КАК EmailПредыдущий,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.КонтактноеЛицоПредыдущий КАК КонтактноеЛицоПредыдущий,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ТелефонКонтактногоЛицаПредыдущий КАК ТелефонКонтактногоЛицаПредыдущий,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ФактическийАдресПредыдущий КАК ФактическийАдресПредыдущий,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ПочтовыйАдресПредыдущий КАК ПочтовыйАдресПредыдущий
		|ИЗ
		|	РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента.СрезПоследних(&ТекущаяДата, Клиент = &Клиент) КАК ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураВыборки = Новый Структура;
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ТелефонПредыдущий) Тогда
			СтруктураВыборки.Вставить("Телефон",              Выборка.ТелефонПредыдущий);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ТелефонДополнительныйПредыдущий) Тогда
			СтруктураВыборки.Вставить("ТелефонДополнительный", Выборка.ТелефонДополнительныйПредыдущий);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.EmailПредыдущий) Тогда
			СтруктураВыборки.Вставить("Email",                 Выборка.EmailПредыдущий);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.КонтактноеЛицоПредыдущий) Тогда
			СтруктураВыборки.Вставить("КонтактноеЛицо",        Выборка.КонтактноеЛицоПредыдущий);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ТелефонКонтактногоЛицаПредыдущий) Тогда
			СтруктураВыборки.Вставить("ТелефонКонтактногоЛица",Выборка.ТелефонКонтактногоЛицаПредыдущий);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ФактическийАдресПредыдущий) Тогда
			СтруктураВыборки.Вставить("ФактическийАдрес",      Выборка.ФактическийАдресПредыдущий);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ПочтовыйАдресПредыдущий) Тогда
			СтруктураВыборки.Вставить("ПочтовыйАдрес",         Выборка.ПочтовыйАдресПредыдущий);
		КонецЕсли;	
	КонецЕсли;
	Возврат СтруктураВыборки;


КонецФункции

Процедура ЗаписатьИзмененияКонтактныхДанных(Клиент, КонтактныеДанные) Экспорт
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период                 = КонтактныеДанные.Период;
		МенеджерЗаписи.Клиент                 = Клиент;
		МенеджерЗаписи.Ломбард                = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		Если КонтактныеДанные.Свойство("Телефон") Тогда
		МенеджерЗаписи.Телефон                = КонтактныеДанные.Телефон;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ТелефонДополнительный") Тогда
		МенеджерЗаписи.ТелефонДополнительный  = КонтактныеДанные.ТелефонДополнительный;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("Email") Тогда
		МенеджерЗаписи.Email                  = КонтактныеДанные.Email;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("КонтактноеЛицо") Тогда
		МенеджерЗаписи.КонтактноеЛицо         = КонтактныеДанные.КонтактноеЛицо;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ТелефонКонтактногоЛица") Тогда
		МенеджерЗаписи.ТелефонКонтактногоЛица = КонтактныеДанные.ТелефонКонтактногоЛица;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ФактическийАдрес") Тогда
		МенеджерЗаписи.ФактическийАдрес       = КонтактныеДанные.ФактическийАдрес;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ПочтовыйАдрес") Тогда
		МенеджерЗаписи.ПочтовыйАдрес          = КонтактныеДанные.ПочтовыйАдрес;
		КонецЕсли;
		МенеджерЗаписи.Ответственный          = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры

