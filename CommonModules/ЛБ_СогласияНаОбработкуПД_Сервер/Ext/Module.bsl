Функция ПолучитьДанныеДляПечатиСогласияНаОбработкуПД(Клиент) Экспорт
	
	Структура = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СогласияНаОбработкуПДСрезПоследних.Период КАК Период,
		|	ЛБ_СогласияНаОбработкуПДСрезПоследних.Ломбард КАК Ломбард,
		|	ЛБ_СогласияНаОбработкуПДСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СогласияНаОбработкуПД.СрезПоследних(
		|			&Период,
		|			Статус = &Статус
		|				И НЕ Ошибочное) КАК ЛБ_СогласияНаОбработкуПДСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыСоглашенийПД.Получено);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаСреза     = Выборка.Период;
		Ломбард       = Выборка.Ломбард;
		Ответственный = Выборка.Ответственный;
	КонецЕсли;
		
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Поля = "НаименованиеПолное, АдресОрганизацииФакт, ТелефонОрганизации, АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = ОрганизацииСервер.СведенияОбОрганизации(Организация, Поля, ДатаСреза);	
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ломбард.ПолучитьОбъект(),,ДатаСреза);
	СтруктураАдреса = фПрочитатьJSON(Ломбард.КонтактнаяИнформация[0].Значение);
	Структура.Вставить("Город",                         "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, ""));
	Структура.Вставить("Дата",                ?(ЗначениеЗаполнено(ДатаСреза), Формат(ДатаСреза, "ДЛФ=D"), ""));
	
	Структура.Вставить("НаименованиеОрганизации",       ?(ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеДляПечати),
	                                                    СведенияОбОрганизации.НаименованиеДляПечати, ""));
	Структура.Вставить("АдресОрганизации",              ?(ЗначениеЗаполнено(СведенияОбОрганизации.АдресОрганизации),
	                                                    СведенияОбОрганизации.АдресОрганизации, ""));
	Структура.Вставить("ИНН",                           ?(ЗначениеЗаполнено(Организация.ИНН), Организация.ИНН, ""));
	Структура.Вставить("ОГРН",                          ?(ЗначениеЗаполнено(Организация.ОГРН), Организация.ОГРН, ""));
	//Структура.Вставить("ПочтаОрганизации",              СведенияОбОрганизации.АдресЭлектроннойПочтыОрганизации);
	//Структура.Вставить("ТелефонОрганизации",            СведенияОбОрганизации.ТелефонОрганизации);
	
	Структура.Вставить("Ломбард",                       ?(ЗначениеЗаполнено(Ломбард), Строка(Ломбард), ""));
	Структура.Вставить("АдресЛомбарда",                 СтруктураАдреса.value);
	Структура.Вставить("ТелефонЛомбарда",               "");
	Структура.Вставить("ДатаЭДО",                       Формат(ДатаСреза, "ДФ=dd.MM.yyyy"));
	ДолжностьОтветственного                             = ДолжностьОтветственного(Ответственный, ДатаСреза);
	СклонениеДолжностиОтветственного                    = ПолучитьСклоненияСтроки(Строка(ДолжностьОтветственного), , "ПД=Родительный");
	//Структура.Вставить("ДолжностьОтветственногоВПадеже",     ?(ЗначениеЗаполнено(СклонениеДолжностиОтветственного[0]), 
	//                                                    НРег(?(СклонениеДолжностиОтветственного.Количество() > 0, СклонениеДолжностиОтветственного[0], "")), ""));
	Структура.Вставить("ДолжностьОтветственного",       ?(ЗначениеЗаполнено(ДолжностьОтветственного), Строка(ДолжностьОтветственного), ""));
	ФИООтветственного                                   = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли;
	
	СклонениеФамилииОтветственного                      = ПолучитьСклоненияСтроки(ФамилияОтветственного, , "ПД=Родительный");
	ФамилияОтветственногоВПадеже                        = ?(СклонениеФамилииОтветственного.Количество() > 0, СклонениеФамилииОтветственного[0], "");
	
	//Структура.Вставить("ФамилияИнициалыОтветственногоВПадеже",ФамилияОтветственногоВПадеже + " " + ИнициалыОтветственного);
	Структура.Вставить("ФИООтветственного", ФамилияОтветственного + " " + ИнициалыОтветственного);
	ДанныеКлиента                                       = ДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("Клиент",                        ДанныеКлиента.Фамилия + " " +  ДанныеКлиента.Имя + " " + ДанныеКлиента.Отчество);
	ПаспортныеДанныеКлиента                             = ПаспортныеДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("ДатаРожденияКлиента",           Формат(ДанныеКлиента.ДатаРождения, "ДФ=dd.MM.yyyy"));
	Структура.Вставить("ПаспортныеДанныеКлиента",       ?(ЗначениеЗаполнено(ПаспортныеДанныеКлиента.ПаспортныеДанные), ПаспортныеДанныеКлиента.ПаспортныеДанные, ""));
	
	ДанныеПравоПребывания                               = ДанныеПравоПребывания(Клиент, ДатаСреза);
	
    Структура.Вставить("ДанныеПравоПребывания",         ?(ЗначениеЗаполнено(ДанныеПравоПребывания.ДанныеПравоПребывания),
		ДанныеПравоПребывания.ДанныеПравоПребывания + ". ", ""));
		
	КонтактнаяИнформацияКлиента                         = КонтактнаяИнформацияКлиента(Клиент, ДатаСреза);
	Структура.Вставить("МестоЖительстваКлиента",        ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.АдресПоПрописке), 
	                                                    КонтактнаяИнформацияКлиента.АдресПоПрописке, ""));
	Структура.Вставить("ТелефонКлиента",                ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.Телефон), 
	                                                    КонтактнаяИнформацияКлиента.Телефон, ""));
	Структура.Вставить("ПочтаКлиента",                  ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.Email),
	                                                                КонтактнаяИнформацияКлиента.Email, "нет"));
	Структура.Вставить("ФамилияИнициалыКлиента",        ДанныеКлиента.Фамилия + " " + Лев(ДанныеКлиента.Имя, 1) + "." + Лев(ДанныеКлиента.Отчество, 1) + ".");
	
	Возврат Структура;
КонецФункции

Функция ПолучитьДанныеДляПечатиОтзываСогласияНаОбработкуПД(Клиент) Экспорт
	
	Структура = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СогласияНаОбработкуПДСрезПоследних.Период КАК Период,
		|	ЛБ_СогласияНаОбработкуПДСрезПоследних.Ломбард КАК Ломбард,
		|	ЛБ_СогласияНаОбработкуПДСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СогласияНаОбработкуПД.СрезПоследних(
		|			&Период,
		|			Клиент = &Клиент
		|				И Статус = &Статус
		|				И НЕ Ошибочное) КАК ЛБ_СогласияНаОбработкуПДСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыСоглашенийПД.Отозвано);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаСреза     = Выборка.Период;
		Ломбард       = Выборка.Ломбард;
		Ответственный = Выборка.Ответственный;
	Иначе
		ДатаСреза     = ТекущаяДатаСеанса();
		Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;
		
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Поля = "НаименованиеПолное, АдресОрганизацииФакт, ТелефонОрганизации, АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = ОрганизацииСервер.СведенияОбОрганизации(Организация, Поля, ДатаСреза);	
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ломбард.ПолучитьОбъект(),,ДатаСреза);
	СтруктураАдреса = фПрочитатьJSON(Ломбард.КонтактнаяИнформация[0].Значение);
	Структура.Вставить("Город",                         "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, ""));
	Структура.Вставить("Дата",                ?(ЗначениеЗаполнено(ДатаСреза), Формат(ДатаСреза, "ДЛФ=D"), ""));
	
	Структура.Вставить("НаименованиеОрганизации",       ?(ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеДляПечати),
	                                                    СведенияОбОрганизации.НаименованиеДляПечати, ""));
	Структура.Вставить("АдресОрганизации",              ?(ЗначениеЗаполнено(СведенияОбОрганизации.АдресОрганизации),
	                                                    СведенияОбОрганизации.АдресОрганизации, ""));
	Структура.Вставить("ИНН",                           ?(ЗначениеЗаполнено(Организация.ИНН), Организация.ИНН, ""));
	Структура.Вставить("ОГРН",                          ?(ЗначениеЗаполнено(Организация.ОГРН), Организация.ОГРН, ""));
	//Структура.Вставить("ПочтаОрганизации",              СведенияОбОрганизации.АдресЭлектроннойПочтыОрганизации);
	//Структура.Вставить("ТелефонОрганизации",            СведенияОбОрганизации.ТелефонОрганизации);
	
	Структура.Вставить("Ломбард",                       ?(ЗначениеЗаполнено(Ломбард), Строка(Ломбард), ""));
	Структура.Вставить("АдресЛомбарда",                 СтруктураАдреса.value);
	Структура.Вставить("ТелефонЛомбарда",               "");
	//Структура.Вставить("Дата",                          Формат(ДатаСреза, "ДФ=dd.MM.yyyy"));
	ДолжностьОтветственного                             = ДолжностьОтветственного(Ответственный, ДатаСреза);
	СклонениеДолжностиОтветственного                    = ПолучитьСклоненияСтроки(Строка(ДолжностьОтветственного), , "ПД=Родительный");
	//Структура.Вставить("ДолжностьОтветственногоВПадеже",     ?(ЗначениеЗаполнено(СклонениеДолжностиОтветственного[0]), 
	//                                                    НРег(?(СклонениеДолжностиОтветственного.Количество() > 0, СклонениеДолжностиОтветственного[0], "")), ""));
	Структура.Вставить("ДолжностьОтветственного",       ?(ЗначениеЗаполнено(ДолжностьОтветственного), Строка(ДолжностьОтветственного), ""));
	ФИООтветственного                                   = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
