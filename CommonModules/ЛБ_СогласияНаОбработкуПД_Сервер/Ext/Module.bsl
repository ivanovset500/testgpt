Функция ОтозватьСогласиеПД(Клиент, Комментарий = Неопределено) Экспорт
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_СогласияНаОбработкуПД.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период        = ТекущаяДата();
		МенеджерЗаписи.Клиент        = Клиент;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус        = Перечисления.ЛБ_СтатусыСоглашенийПД.Отозвано;
		Если Комментарий <> Неопределено Тогда
			МенеджерЗаписи.Ломбард       = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
			МенеджерЗаписи.Основание     = "Отозвано согласие на обработку персональных данных (ЦО)";
			МенеджерЗаписи.Комментарий   = Комментарий;
		Иначе
			МенеджерЗаписи.Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
			МенеджерЗаписи.Основание     = "Отозвано согласие на обработку персональных данных";
		КонецЕсли;
		МенеджерЗаписи.Записать();
		РезультатЗаключения = Истина;
	Исключение
		РезультатЗаключения = Ложь;
	КонецПопытки;
	Возврат РезультатЗаключения;
КонецФункции 

Процедура УдалитьСогласиеНаОбработкуПД(Клиент, Период) Экспорт
	
	НаборЗаписей = РегистрыСведений.ЛБ_СогласияНаОбработкуПД.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Период);
	НаборЗаписей.Отбор.Клиент.Установить(Клиент);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() Тогда
		Запись = НаборЗаписей[0];
		Запись.Ошибочное = Истина;
		НаборЗаписей.Записать();
	КонецЕсли;
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_СогласияНаОбработкуПД.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период        = ТекущаяДата() + 1;
		МенеджерЗаписи.Клиент        = Клиент;
		МенеджерЗаписи.Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус        = Перечисления.ЛБ_СтатусыСоглашенийПД.НеПолучено;
		МенеджерЗаписи.Основание     = "Удалено полученное согласие на обработку ПДн";
		МенеджерЗаписи.Записать();
	Исключение
	КонецПопытки;
	
КонецПроцедуры

