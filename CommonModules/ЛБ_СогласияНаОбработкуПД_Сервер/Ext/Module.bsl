
#Область ДанныеДляПечати

Функция ПечатьСогласиеНаОбработкуПД(Клиент) Экспорт 
	
	СтруктураДанных = ПолучитьДанныеДляПечатиСогласияНаОбработкуПД(Клиент);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.Защита = Истина;
		
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СогласиеНаОбработкуПД_ЭДО";
	
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_СогласиеНаОбработкуПД_ЭДО");
	
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьТекст   = Макет.ПолучитьОбласть("ТекстСогласия");
	ОбластьПодвал    = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(СтруктураДанных);
	ОбластьТекст.Параметры.Заполнить(СтруктураДанных);
	ОбластьПодвал.Параметры.Заполнить(СтруктураДанных);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТабличныйДокумент.Вывести(ОбластьТекст);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
КонецФункции

