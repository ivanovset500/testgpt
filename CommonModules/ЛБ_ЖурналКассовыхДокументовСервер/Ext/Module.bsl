			СтрМ = ТЗИтогДопМеталлы.Скопировать(ОтборНачало, "СуммаОценки");
			
			Если СтрК.Количество() = 0 Тогда
				СуммаК = 0;
			Иначе
				СуммаК = СтрК.Итог("СуммаОценки");
			КонецЕсли;
			
			Если СтрМ.Количество() = 0 Тогда
				СуммаМ = 0;
			Иначе
				СуммаМ = СтрМ.Итог("СуммаОценки");
			КонецЕсли;
			
			ОбластьОстатокНачало.Параметры.Проба = Строка(Стр.Проба);
			ОбластьОстатокНачало.Параметры.ОбщаяМасса = СтрОЗ.Итог("Вес");
			ИтогоОстатокОбщаяМасса = ИтогоОстатокОбщаяМасса + СтрОЗ.Итог("Вес");
			ОбластьОстатокНачало.Параметры.МассаЛигатуры = СтрОЗ.Итог("МассаЛигатуры");
			ИтогоОстатокМассаЛигатуры = ИтогоОстатокМассаЛигатуры + СтрОЗ.Итог("МассаЛигатуры");
			ОбластьОстатокНачало.Параметры.МассаХим = СтрОЗ.Итог("МассаХим");
			ИтогоОстатокМассаХим = ИтогоОстатокМассаХим + СтрОЗ.Итог("МассаХим");
			ОбластьОстатокНачало.Параметры.ВесДК = "";
			ОбластьОстатокНачало.Параметры.Количество = СтрОЗ.Итог("КоличествоОстаток");
			ИтогоОстатокКоличество = ИтогоОстатокКоличество + СтрОЗ.Итог("КоличествоОстаток");
			ОбластьОстатокНачало.Параметры.Стоимость = СтрОЗ.Итог("СуммаОценкиМакс") - СуммаК - СуммаМ;
			ИтогоОстатокСтоимость = ИтогоОстатокСтоимость + (СтрОЗ.Итог("СуммаОценкиМакс") - СуммаК - СуммаМ);
			ТабличныйДокумент.Вывести(ОбластьОстатокНачало);
		Иначе
			ОтборНачало = Новый Структура;
			ОтборНачало.Вставить("Проба", Стр.Проба);
			
			СтрИтогК = ТЗИтог.Скопировать(ОтборНачало);
			
			//Если Выборка.Вес <> 0 Тогда
			Для каждого Стр Из СтрИтогК Цикл
				ОбластьОстатокНачало.Параметры.Проба = Стр.ВидВставки;
