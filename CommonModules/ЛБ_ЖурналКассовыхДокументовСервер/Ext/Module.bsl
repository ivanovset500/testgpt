				ОбластьОстатокНачало.Параметры.МассаЛигатуры = "";
				ОбластьОстатокНачало.Параметры.МассаХим = "";
				ОбластьОстатокНачало.Параметры.ВесДК = Стр.Вес;
				ИтогоОстатокВесДК = ИтогоОстатокВесДК + Стр.Вес;
				ОбластьОстатокНачало.Параметры.Количество = Стр.КоличествоОстаток;
				ИтогоОстатокКоличество = ИтогоОстатокКоличество + Стр.КоличествоОстаток;
				ОбластьОстатокНачало.Параметры.Стоимость = Стр.СуммаОценкиМакс;
				ИтогоОстатокСтоимость = ИтогоОстатокСтоимость + Стр.СуммаОценкиМакс;
				//+МАН 01.12.25 Добавлено количество камней
				ИтогоОстатокКоличествоКамней = ИтогоОстатокКоличествоКамней + Стр.КоличествоКамней;
				ОбластьОстатокНачало.Параметры.КоличествоДК = Стр.КоличествоКамней;
				//-МАН
				ТабличныйДокумент.Вывести(ОбластьОстатокНачало);
			КонецЦикла;
		КонецЕсли;
