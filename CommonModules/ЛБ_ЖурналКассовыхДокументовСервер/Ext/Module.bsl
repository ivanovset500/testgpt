			ОбластьВставкаБриллиантРасход.Параметры.ВесДК = Выборка.Вес;
			ИтогоРасходВесДК = ИтогоРасходВесДК + Выборка.Вес;
			ОбластьВставкаБриллиантРасход.Параметры.Количество = Выборка.КоличествоРасход;
			ИтогоРасходКоличество = ИтогоРасходКоличество + Выборка.КоличествоРасход;
			ОбластьВставкаБриллиантРасход.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
			ИтогоРасходСтоимость = ИтогоРасходСтоимость + Выборка.СуммаОценкиМакс;
			//+МАН 01.12.25 Добавлено количество камней
			ИтогоРасходКоличествоКамней = ИтогоРасходКоличествоКамней + Выборка.КоличествоКамней;
			ОбластьВставкаБриллиантРасход.Параметры.КоличествоДК = Выборка.КоличествоКамней;
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьВставкаБриллиантРасход);
		ИначеЕсли Выборка.Артикул = "Вставка" И Не ЗначениеЗаполнено(Выборка.ВидВставки) Тогда
			ПробаОбъект = Строка(Выборка.ПробаВладелец) + Строка(Выборка.ПробаПроба);
			ПробаМеталл = Строка(Выборка.ПробаВладелецМеталл) + Строка(Выборка.ПробаПробаМеталл);
			Если ПробаОбъект <> ПробаМеталл Тогда
			ОбластьВставкаРасход.Параметры.Проба = Строка(Выборка.ПробаВладелецМеталл) + " " + Строка(Выборка.ПробаПробаМеталл);
			ОбластьВставкаРасход.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры;
			ИтогоРасходМассаЛигатуры = ИтогоРасходМассаЛигатуры + Выборка.МассаЛигатуры;
			ОбластьВставкаРасход.Параметры.МассаХим = Выборка.МассаХим;
			ИтогоРасходМассаХим = ИтогоРасходМассаХим + Выборка.МассаХим;
			ОбластьВставкаРасход.Параметры.ВесДК = "";
			ОбластьВставкаРасход.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
			ИтогоРасходСтоимость = ИтогоРасходСтоимость + Выборка.СуммаОценкиМакс;
			//+МАН 01.12.25 Добавлено количество камней
			ОбластьВставкаРасход.Параметры.КоличествоДК = "";
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьВставкаРасход);
			КонецЕсли;
		Иначе	
			
		//+МАН 24.02.26 Заявка 3269
		Отбор = Новый Структура;
		Отбор.Вставить("ОбъектЗалога", Выборка.ОбъектЗалога);
		
		ТЗСтрокК = ТЗИтогКамни.Скопировать(Отбор, "СуммаОценки");
		ТЗСтрокМ = ТЗИтогДопМеталлы.Скопировать(Отбор);
		
		СуммаДопМ = 0;
		Для каждого Стр Из ТЗСтрокМ Цикл
			Если Выборка.Проба <> Стр.Проба Тогда
				СуммаДопМ = СуммаДопМ + Стр.СуммаОценки;
			КонецЕсли;
		КонецЦикла;
		
		ИтогоСумма = Выборка.СуммаОценкиМакс - ТЗСтрокК.Итог("СуммаОценки") - СуммаДопМ;
		//-МАН
		
		ОбластьРасход.Параметры.НомерПП = НомерПП;
		НомерПП = НомерПП + 1;
		ОбластьРасход.Параметры.Наименование = Выборка.ОбъектЗалога;
		ОбластьРасход.Параметры.НомерНакладной = Выборка.РегистраторНакладнаяНаОтгрузкуНомер;
		ОбластьРасход.Параметры.НомерЗБ = Выборка.Артикул;
		ОбластьРасход.Параметры.Проба = Строка(Выборка.ПробаВладелец) + " " + Строка(Выборка.ПробаПроба);
		ОбластьРасход.Параметры.ОбщаяМасса = Выборка.Вес * Выборка.КоличествоРасход;
		ИтогоРасходОбщаяМасса = ИтогоРасходОбщаяМасса + (Выборка.Вес * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры * Выборка.КоличествоРасход;
		ИтогоРасходМассаЛигатуры = ИтогоРасходМассаЛигатуры + (Выборка.МассаЛигатуры * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.МассаХим = Выборка.МассаХим * Выборка.КоличествоРасход;
		ИтогоРасходМассаХим = ИтогоРасходМассаХим + (Выборка.МассаХим * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.ВесДК = "";
		ОбластьРасход.Параметры.Количество = Выборка.КоличествоРасход;
		ИтогоРасходКоличество = ИтогоРасходКоличество + Выборка.КоличествоРасход;
		//+МАН 24.02.26 Заявка 3269
		//ОбластьРасход.Параметры.Стоимость = Выборка.СуммаОценкиМакс * Выборка.КоличествоРасход;
		//ИтогоРасходСтоимость = ИтогоРасходСтоимость + (Выборка.СуммаОценкиМакс * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.Стоимость = ИтогоСумма * Выборка.КоличествоРасход;
		ИтогоРасходСтоимость = ИтогоРасходСтоимость + (ИтогоСумма * Выборка.КоличествоРасход);
		//-МАН
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьРасход.Параметры.КоличествоДК = "";
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьРасход);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ИтогоРасходКоличество > 0 Тогда
		Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
			ОбластьИтогоРасход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
		Иначе
			ОбластьИтогоРасход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD") + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
		КонецЕсли;
		
		ОбластьИтогоРасход.Параметры.ИтогоОбщаяМасса = ИтогоРасходОбщаяМасса;
		ОбластьИтогоРасход.Параметры.ИтогоМассаЛигатуры = ИтогоРасходМассаЛигатуры;
		ОбластьИтогоРасход.Параметры.ИтогоМассаХим = ИтогоРасходМассаХим;
		ОбластьИтогоРасход.Параметры.ИтогоВесДК = ИтогоРасходВесДК;
		ОбластьИтогоРасход.Параметры.ИтогоКоличество = ИтогоРасходКоличество;
		ОбластьИтогоРасход.Параметры.ИтогоСтоимость = ИтогоРасходСтоимость;
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьИтогоРасход.Параметры.ИтогоКоличествоДК = ИтогоРасходКоличествоКамней;
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьИтогоРасход);
	КонецЕсли;
	
	ОбластьШапкаОстатокКонец.Параметры.КонецПериода = Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
