		|	СУММА(ВТ_ДопМеталлы.ВесЧистый * (ВТ_ДопМеталлы.ПробаПроба / 10 / 100)) КАК МассаХим,
		|	СУММА(ВТ_ДопМеталлы.СуммаОценки) КАК СуммаОценки,
		|	ВТ_ДопМеталлы.ЗалоговыйБилетНомерЗалоговогоБилета КАК ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогОбъекты.ОбъектЗалога КАК ОбъектЗалога,
		|	ВТ_ИтогОбъекты.РегистраторНакладнаяНаОтгрузкуНомер КАК РегистраторНакладнаяНаОтгрузкуНомер,
		|	ВТ_ИтогОбъекты.ПробаВладелец КАК ПробаВладелецОбъект,
		|	ВТ_ИтогОбъекты.ПробаПроба КАК ПробаПробаОбъект,
		|	ВТ_ИтогОбъекты.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ПОМЕСТИТЬ ВТ_ИтогДопМеталлы
		|ИЗ
		|	ВТ_ИтогОбъекты КАК ВТ_ИтогОбъекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДопМеталлы КАК ВТ_ДопМеталлы
		|		ПО ВТ_ИтогОбъекты.ОбъектЗалога = ВТ_ДопМеталлы.ОбъектЗалога
		|			И ВТ_ИтогОбъекты.ЗалоговыйБилет = ВТ_ДопМеталлы.ЗалоговыйБилет
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ДопМеталлы.ПробаВладелец,
		|	ВТ_ДопМеталлы.ПробаПроба,
		|	ВТ_ДопМеталлы.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогОбъекты.ОбъектЗалога,
		|	ВТ_ИтогОбъекты.РегистраторНакладнаяНаОтгрузкуНомер,
		|	ВТ_ИтогОбъекты.ПробаВладелец,
		|	ВТ_ИтогОбъекты.ПробаПроба,
		|	ВТ_ИтогОбъекты.ЗалоговыйБилет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИтогОбъекты.Артикул КАК Артикул,
		|	ВТ_ИтогОбъекты.ПробаВладелец КАК ПробаВладелец,
		|	ВТ_ИтогОбъекты.ПробаПроба КАК ПробаПроба,
		|	СУММА(ВТ_ИтогОбъекты.КоличествоРасход) КАК КоличествоРасход,
		|	СУММА(ВТ_ИтогОбъекты.Вес) КАК Вес,
		|	СУММА(ВТ_ИтогОбъекты.МассаЛигатуры) КАК МассаЛигатуры,
		|	СУММА(ВТ_ИтогОбъекты.МассаХим) КАК МассаХим,
		|	СУММА(ЕСТЬNULL(ВТ_ИтогОбъекты.СуммаОценкиМакс, 0) - ЕСТЬNULL(ВТ_ИтогКамни.СуммаОценки, 0) - ЕСТЬNULL(ВТ_ИтогДопМеталлы.СуммаОценки, 0)) КАК СуммаОценкиМакс,
		|	"""" КАК ВидВставки,
		|	ВТ_ИтогОбъекты.ЗалоговыйБилетНомерЗалоговогоБилета КАК ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогОбъекты.ОбъектЗалога КАК ОбъектЗалога,
		|	ЕСТЬNULL(ВТ_ИтогОбъекты.РегистраторНакладнаяНаОтгрузкуНомер, """") КАК РегистраторНакладнаяНаОтгрузкуНомер,
		|	"""" КАК ПробаВладелецМеталл,
		|	"""" КАК ПробаПробаМеталл,
		|	СУММА(0) КАК КоличествоКамней
		|ИЗ
		|	ВТ_ИтогОбъекты КАК ВТ_ИтогОбъекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИтогКамни КАК ВТ_ИтогКамни
		|		ПО ВТ_ИтогОбъекты.ОбъектЗалога = ВТ_ИтогКамни.ОбъектЗалога
		|			И ВТ_ИтогОбъекты.ЗалоговыйБилет = ВТ_ИтогКамни.ЗалоговыйБилет
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИтогДопМеталлы КАК ВТ_ИтогДопМеталлы
		|		ПО ВТ_ИтогОбъекты.ОбъектЗалога = ВТ_ИтогДопМеталлы.ОбъектЗалога
		|			И ВТ_ИтогОбъекты.ЗалоговыйБилет = ВТ_ИтогДопМеталлы.ЗалоговыйБилет
		|			И ВТ_ИтогОбъекты.ПробаВладелец <> ВТ_ИтогДопМеталлы.ПробаВладелецМеталл
		|			И ВТ_ИтогОбъекты.ПробаПроба <> ВТ_ИтогДопМеталлы.ПробаПробаМеталл
		|ГДЕ
		|	НЕ ВТ_ИтогОбъекты.ПробаВладелец ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИтогОбъекты.ПробаПроба,
		|	ВТ_ИтогОбъекты.ПробаВладелец,
		|	ВТ_ИтогОбъекты.Артикул,
		|	ВТ_ИтогОбъекты.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогОбъекты.ОбъектЗалога,
		|	ЕСТЬNULL(ВТ_ИтогОбъекты.РегистраторНакладнаяНаОтгрузкуНомер, """")
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	""Вставка"",
		|	"""",
		|	"""",
		|	СУММА(0),
		|	СУММА(ВТ_ИтогКамни.Вес),
		|	СУММА(0),
		|	СУММА(0),
		|	ВТ_ИтогКамни.СуммаОценки,
		|	ВТ_ИтогКамни.ВидВставки,
		|	ВТ_ИтогКамни.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогКамни.ОбъектЗалога,
		|	"""",
		|	"""",
		|	"""",
		|	СУММА(ВТ_ИтогКамни.КоличествоКамней)
		|ИЗ
		|	ВТ_ИтогКамни КАК ВТ_ИтогКамни
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИтогКамни.ВидВставки,
		|	ВТ_ИтогКамни.СуммаОценки,
		|	ВТ_ИтогКамни.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогКамни.ОбъектЗалога
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	""Вставка"",
		|	ВТ_ИтогДопМеталлы.ПробаВладелецОбъект,
		|	ВТ_ИтогДопМеталлы.ПробаПробаОбъект,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(ВТ_ИтогДопМеталлы.МассаЛигатуры),
		|	СУММА(ВТ_ИтогДопМеталлы.МассаХим),
		|	СУММА(ВТ_ИтогДопМеталлы.СуммаОценки),
		|	"""",
		|	ВТ_ИтогДопМеталлы.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогДопМеталлы.ОбъектЗалога,
		|	"""",
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	СУММА(0)
		|ИЗ
		|	ВТ_ИтогДопМеталлы КАК ВТ_ИтогДопМеталлы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИтогДопМеталлы.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогДопМеталлы.ОбъектЗалога,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецОбъект,
		|	ВТ_ИтогДопМеталлы.ПробаПробаОбъект
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВидВставки,
		|	Артикул";
	
	Запрос.УстановитьПараметр("ВидКамня", ВидыКамней);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИтогоРасходОбщаяМасса = 0;
	ИтогоРасходМассаЛигатуры = 0;
	ИтогоРасходМассаХим = 0;
	ИтогоРасходВесДК = 0;
	ИтогоРасходКоличество = 0;
	ИтогоРасходСтоимость = 0;
	НомерПП = 1;
	ШапкаРасход = Ложь;
	//+МАН 01.12.25 Добавлено количество камней
	ИтогоРасходКоличествоКамней = 0;
	//-МАН
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ШапкаРасход Тогда
			Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
				ОбластьШапкаРасход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
			Иначе
				ОбластьШапкаРасход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD") + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьШапкаРасход);
			ШапкаРасход = Истина;
		КонецЕсли;
		
		Если Выборка.Артикул = "Вставка" И ЗначениеЗаполнено(Выборка.ВидВставки) Тогда
			ОбластьВставкаБриллиантРасход.Параметры.Проба = Выборка.ВидВставки;
			ОбластьВставкаБриллиантРасход.Параметры.ВесДК = Выборка.Вес;
			ИтогоРасходВесДК = ИтогоРасходВесДК + Выборка.Вес;
			ОбластьВставкаБриллиантРасход.Параметры.Количество = Выборка.КоличествоРасход;
			ИтогоРасходКоличество = ИтогоРасходКоличество + Выборка.КоличествоРасход;
			ОбластьВставкаБриллиантРасход.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
			ИтогоРасходСтоимость = ИтогоРасходСтоимость + Выборка.СуммаОценкиМакс;
			//+МАН 01.12.25 Добавлено количество камней
			ИтогоРасходКоличествоКамней = ИтогоРасходКоличествоКамней + Выборка.КоличествоКамней;
			ОбластьВставкаБриллиантРасход.Параметры.КоличествоДК = Выборка.КоличествоКамней;
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьВставкаБриллиантРасход);
		ИначеЕсли Выборка.Артикул = "Вставка" И Не ЗначениеЗаполнено(Выборка.ВидВставки) Тогда
			ПробаОбъект = Строка(Выборка.ПробаВладелец) + Строка(Выборка.ПробаПроба);
			ПробаМеталл = Строка(Выборка.ПробаВладелецМеталл) + Строка(Выборка.ПробаПробаМеталл);
			Если ПробаОбъект <> ПробаМеталл Тогда
			ОбластьВставкаРасход.Параметры.Проба = Строка(Выборка.ПробаВладелецМеталл) + " " + Строка(Выборка.ПробаПробаМеталл);
			ОбластьВставкаРасход.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры;
			ИтогоРасходМассаЛигатуры = ИтогоРасходМассаЛигатуры + Выборка.МассаЛигатуры;
			ОбластьВставкаРасход.Параметры.МассаХим = Выборка.МассаХим;
			ИтогоРасходМассаХим = ИтогоРасходМассаХим + Выборка.МассаХим;
			ОбластьВставкаРасход.Параметры.ВесДК = "";
			ОбластьВставкаРасход.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
			ИтогоРасходСтоимость = ИтогоРасходСтоимость + Выборка.СуммаОценкиМакс;
			//+МАН 01.12.25 Добавлено количество камней
			ОбластьВставкаРасход.Параметры.КоличествоДК = "";
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьВставкаРасход);
			КонецЕсли;
		Иначе	
		ОбластьРасход.Параметры.НомерПП = НомерПП;
		НомерПП = НомерПП + 1;
		ОбластьРасход.Параметры.Наименование = Выборка.ОбъектЗалога;
		ОбластьРасход.Параметры.НомерНакладной = Выборка.РегистраторНакладнаяНаОтгрузкуНомер;
		ОбластьРасход.Параметры.НомерЗБ = Выборка.Артикул;
		ОбластьРасход.Параметры.Проба = Строка(Выборка.ПробаВладелец) + " " + Строка(Выборка.ПробаПроба);
		ОбластьРасход.Параметры.ОбщаяМасса = Выборка.Вес * Выборка.КоличествоРасход;
		ИтогоРасходОбщаяМасса = ИтогоРасходОбщаяМасса + (Выборка.Вес * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры * Выборка.КоличествоРасход;
		ИтогоРасходМассаЛигатуры = ИтогоРасходМассаЛигатуры + (Выборка.МассаЛигатуры * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.МассаХим = Выборка.МассаХим * Выборка.КоличествоРасход;
		ИтогоРасходМассаХим = ИтогоРасходМассаХим + (Выборка.МассаХим * Выборка.КоличествоРасход);
		ОбластьРасход.Параметры.ВесДК = "";
		ОбластьРасход.Параметры.Количество = Выборка.КоличествоРасход;
		ИтогоРасходКоличество = ИтогоРасходКоличество + Выборка.КоличествоРасход;
		ОбластьРасход.Параметры.Стоимость = Выборка.СуммаОценкиМакс * Выборка.КоличествоРасход;
		ИтогоРасходСтоимость = ИтогоРасходСтоимость + (Выборка.СуммаОценкиМакс * Выборка.КоличествоРасход);
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьРасход.Параметры.КоличествоДК = "";
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьРасход);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ИтогоРасходКоличество > 0 Тогда
		Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
			ОбластьИтогоРасход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
		Иначе
			ОбластьИтогоРасход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD") + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
		КонецЕсли;
		
		ОбластьИтогоРасход.Параметры.ИтогоОбщаяМасса = ИтогоРасходОбщаяМасса;
		ОбластьИтогоРасход.Параметры.ИтогоМассаЛигатуры = ИтогоРасходМассаЛигатуры;
		ОбластьИтогоРасход.Параметры.ИтогоМассаХим = ИтогоРасходМассаХим;
		ОбластьИтогоРасход.Параметры.ИтогоВесДК = ИтогоРасходВесДК;
		ОбластьИтогоРасход.Параметры.ИтогоКоличество = ИтогоРасходКоличество;
		ОбластьИтогоРасход.Параметры.ИтогоСтоимость = ИтогоРасходСтоимость;
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьИтогоРасход.Параметры.ИтогоКоличествоДК = ИтогоРасходКоличествоКамней;
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьИтогоРасход);
	КонецЕсли;
	
	ОбластьШапкаОстатокКонец.Параметры.КонецПериода = Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
	ТабличныйДокумент.Вывести(ОбластьШапкаОстатокКонец);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ПОМЕСТИТЬ ВТ_Объекты
		|ИЗ
		|	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Период, Ломбард = &Ломбард) КАК ЛБ_ОбъектыЗалогаОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_РеквизитыОбъектаЗалога.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба.Владелец КАК ПробаВладелец,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба.Проба КАК ПробаПроба,
		|	ЛБ_РеквизитыОбъектаЗалога.Вес КАК Вес,
		|	ЛБ_РеквизитыОбъектаЗалога.ВесЧистый КАК ВесЧистый,
		|	ЛБ_РеквизитыОбъектаЗалога.СуммаОценкиМакс КАК СуммаОценкиМакс,
		|	ЛБ_РеквизитыОбъектаЗалога.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ПОМЕСТИТЬ ВТ_Характеристики
		|ИЗ
		|	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога КАК ЛБ_РеквизитыОбъектаЗалога
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
