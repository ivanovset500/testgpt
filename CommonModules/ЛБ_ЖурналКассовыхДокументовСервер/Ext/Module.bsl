
Функция ПечатьКассовыйЛистСервер(ПараметрыОтчета) Экспорт
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КассовыйЛист";
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_КассовыйЛист");
	
	ОбластьШапка   = Макет.ПолучитьОбласть("Шапка");
	ОбластьТаблица = Макет.ПолучитьОбласть("ОбластьТаблица");
	ОбластьПодвал  = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ОбластьШапка.Параметры.Организация = ПараметрыОтчета.Организация.НаименованиеСокращенное;
	ОбластьШапка.Параметры.Ломбард = ПараметрыОтчета.Ломбард;
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыОтчета.Ломбард.ПолучитьОбъект(),,ПараметрыОтчета.Период);
	СтруктураАдреса = фПрочитатьJSON(ПараметрыОтчета.Ломбард.КонтактнаяИнформация[0].Значение);
	ОбластьШапка.Параметры.Город = "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, "");
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьНомерКассовогоЛиста(НачалоДня(ПараметрыОтчета.Период), КонецДня(ПараметрыОтчета.Период), ПараметрыОтчета.Организация, ПараметрыОтчета.Ломбард);
	НомерКЛ = Результат.Номер;
	ОбластьШапка.Параметры.НомерЛиста = НомерКЛ;
	ОбластьШапка.Параметры.Дата = Формат(ПараметрыОтчета.Период, "ДФ='дд ММММ гггг'");
	
	//Остатки
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ПараметрыОтчета.Период));  
	Запрос.УстановитьПараметр("Дата2", КонецДня(ПараметрыОтчета.Период));
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДенежныеСредстваОстаткиИОбороты.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаНачальныйОстаток) КАК СуммаНач,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаКонечныйОстаток) КАК СуммаКон,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаПриход) КАК СуммаПриход,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаРасход) КАК СуммаРасход
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДенежныеСредства.ОстаткиИОбороты(
	               |			&Дата1,
	               |			&Дата2,
	               |			,
	               |			,
	               |			Организация = &Организация
	               |				И ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
	               |				И Ломбард = &Ломбард) КАК ЛБ_ДенежныеСредстваОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ДенежныеСредстваОстаткиИОбороты.Ломбард";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		СуммаОстатокНачало = Выборка.СуммаНач;
		СуммаОстатокКонец = Выборка.СуммаКон; 
		СуммаПриход = Выборка.СуммаПриход;
		СуммаРасход = Выборка.СуммаРасход;
	Иначе
		СуммаОстатокНачало = 0;
		СуммаОстатокКонец = 0; 
		СуммаПриход = 0;
		СуммаРасход = 0;
	КонецЕсли;
	
	ОбластьШапка.Параметры.ОстатокНачало = СуммаОстатокНачало;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	//Обороты
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвиженияДенежныхСредств.Номер КАК НомерДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЛБ_ДвиженияДенежныхСредств.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
		|				И ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДвиженияДС.Приход)
		|			ТОГДА ""Залогодателей с применением ККT""
		|		КОГДА ТИПЗНАЧЕНИЯ(ЛБ_ДвиженияДенежныхСредств.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
		|				И ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДвиженияДС.Расход)
		|			ТОГДА ""Залогодателям с применением ККT""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЛБ_ДвиженияДенежныхСредств.ФизическоеЛицо = НЕОПРЕДЕЛЕНО
		|					ТОГДА ЛБ_ДвиженияДенежныхСредств.ФИО
		|				КОГДА ЛБ_ДвиженияДенежныхСредств.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		|					ТОГДА ЛБ_ДвиженияДенежныхСредств.Контрагент
		|				ИНАЧЕ ЛБ_ДвиженияДенежныхСредств.ФизическоеЛицо
		|			КОНЕЦ
		|	КОНЕЦ КАК Контрагент,
		|	СУММА(ЛБ_ДвиженияДенежныхСредств.Сумма) КАК Сумма,
		|	ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС КАК ВидДвиженияДС,
		|	ЛБ_ДвиженияДенежныхСредств.Кт КАК Кт,
		|	ЛБ_ДвиженияДенежныхСредств.Дт КАК Дт
		|ПОМЕСТИТЬ ВТ1
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
		|ГДЕ
		|	ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЛБ_ДвиженияДенежныхСредств.Организация = &Организация
		|	И ЛБ_ДвиженияДенежныхСредств.Ломбард = &Ломбард
		|	И ЛБ_ДвиженияДенежныхСредств.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ДвиженияДенежныхСредств.Номер,
		|	ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС,
		|	ЛБ_ДвиженияДенежныхСредств.Кт,
		|	ЛБ_ДвиженияДенежныхСредств.Дт,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЛБ_ДвиженияДенежныхСредств.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
		|				И ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДвиженияДС.Приход)
		|			ТОГДА ""Залогодателей с применением ККT""
		|		КОГДА ТИПЗНАЧЕНИЯ(ЛБ_ДвиженияДенежныхСредств.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
		|				И ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДвиженияДС.Расход)
		|			ТОГДА ""Залогодателям с применением ККT""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЛБ_ДвиженияДенежныхСредств.ФизическоеЛицо = НЕОПРЕДЕЛЕНО
		|					ТОГДА ЛБ_ДвиженияДенежныхСредств.ФИО
		|				КОГДА ЛБ_ДвиженияДенежныхСредств.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		|					ТОГДА ЛБ_ДвиженияДенежныхСредств.Контрагент
		|				ИНАЧЕ ЛБ_ДвиженияДенежныхСредств.ФизическоеЛицо
		|			КОНЕЦ
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ1.НомерДокумента КАК НомерДокумента,
		|	ВТ1.Контрагент КАК Контрагент,
		|	ВТ1.Сумма КАК Сумма,
		|	ВТ1.ВидДвиженияДС КАК ВидДвиженияДС,
		|	ВТ1.Кт КАК Кт,
		|	ВТ1.Дт КАК Дт
		|ИЗ
		|	ВТ1 КАК ВТ1
		|ГДЕ
		|	ВТ1.Сумма <> 0";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ПараметрыОтчета.Период));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыОтчета.Период));
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоПриходных = 0;
	КоличествоРасходных = 0;
	
	Пока Выборка.Следующий() Цикл
		ОбластьТаблица.Параметры.НомерДокумента = Выборка.НомерДокумента;
		ОбластьТаблица.Параметры.Контрагент = Выборка.Контрагент;
		Если Выборка.Дт = "20202" Тогда 
			ОбластьТаблица.Параметры.НомерСчета = Выборка.Кт;
		ИначеЕсли Выборка.Кт = "20202" Тогда
			ОбластьТаблица.Параметры.НомерСчета = Выборка.Дт;
		КонецЕсли;
		Если Выборка.ВидДвиженияДС = Перечисления.ЛБ_ВидыДвиженияДС.Приход Тогда
			ОбластьТаблица.Параметры.СуммаПриход = Выборка.Сумма;
			ОбластьТаблица.Параметры.СуммаРасход = " ";
			КоличествоПриходных = КоличествоПриходных + 1;
			ТабличныйДокумент.Вывести(ОбластьТаблица);
		Иначе
			ОбластьТаблица.Параметры.СуммаРасход = Выборка.Сумма;
			ОбластьТаблица.Параметры.СуммаПриход = " ";
			КоличествоРасходных = КоличествоРасходных + 1;
			ТабличныйДокумент.Вывести(ОбластьТаблица);
		КонецЕсли;
	КонецЦикла;
	
	Ответственный              = ПараметрыСеанса.ТекущийСотрудник;	
	ФИООтветственного          = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли;
	
	ОбластьПодвал.Параметры.ИтогоПриход = СуммаПриход;
	ОбластьПодвал.Параметры.ИтогоРасход = СуммаРасход;
	ОбластьПодвал.Параметры.ОстатокКонец = СуммаОстатокКонец;
	
	ОбластьПодвал.Параметры.ФИОКассира = ФамилияОтветственного + " " + ИнициалыОтветственного;
	
	ОбластьПодвал.Параметры.КоличествоПриходных = ЧислоПрописью(КоличествоПриходных,"НП=Ложь",",,,,,,,,0");
	ОбластьПодвал.Параметры.КоличествоРасходных = ЧислоПрописью(КоличествоРасходных,"НП=Ложь",",,,,,,,,0");
	
	ДанныеНачальника_Управляющего = ПолучитьНачальникаОтделения_Управляющего(ПараметрыОтчета.Ломбард, ТекущаяДата());
	Бухгалтер = ?(ДанныеНачальника_Управляющего.Свойство("Сотрудник"), Строка(ДанныеНачальника_Управляющего.Сотрудник), "");
	
	ФИОБухгалтера          = СтрРазделить(Строка(Бухгалтер), " ");
	
	Если ФИОБухгалтера.Количество() > 0 Тогда
		ФамилияБухгалтера  = ФИОБухгалтера[0]; 
		ИнициалыБухгалтера = Лев(ФИОБухгалтера[1], 1) + "." + Лев(ФИОБухгалтера[2], 1) + ".";
	Иначе
		ФамилияБухгалтера  = ""; 
		ИнициалыБухгалтера = "";
	КонецЕсли;
	
	ОбластьПодвал.Параметры.ФИОБухгалтера = ФамилияБухгалтера + " " + ИнициалыБухгалтера;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСлева = Строка(ТекущаяДата()) + 
	" " + ФамилияОтветственного + " " + ИнициалыОтветственного;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "КАССА за " + Формат(ПараметрыОтчета.Период, "ДФ='дд ММММ гггг'") + " года";
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	Шрифт = Новый Шрифт("Times New Roman", 8);
	ТабличныйДокумент.НижнийКолонтитул.Шрифт = Шрифт;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция фПрочитатьJSON(ТекстJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Структура = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);	
	Чтение.Закрыть();
	Возврат Структура;
КонецФункции

Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач Чтение) Экспорт
	Результат = Новый Структура;

	ПоследнееИмяРеквизита = Неопределено;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта И ПоследнееИмяРеквизита<>Неопределено Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
		ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта Тогда 
			Возврат Результат;
			ПоследнееИмяРеквизита = Неопределено;
		ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства Тогда 
			Результат.Вставить(Чтение.ТекущееЗначение, Неопределено);
			ПоследнееИмяРеквизита = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.Булево или Тип = ТипЗначенияJSON.Строка
			или Тип = ТипЗначенияJSON.Число или Тип = ТипЗначенияJSON.Null Тогда 
			Результат[ПоследнееИмяРеквизита] = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.НачалоМассива Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьМассивИзОтветаJSON(Чтение);
		КонецЕсли;
	КонецЦикла;  
		
	Возврат Результат;
КонецФункции

Функция ЗаполнитьМассивИзОтветаJSON(Знач Чтение)
	Результат = Новый Массив;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта Тогда 
			Результат.Добавить(ЗаполнитьСтруктуруИзОтветаJSON(Чтение));
		ИначеЕсли Тип = ТипЗначенияJSON.КонецМассива Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат Результат;
КонецФункции

Функция ПолучитьНачальникаОтделения_Управляющего(Ломбард, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|ПОМЕСТИТЬ ВТОтделение
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ПОМЕСТИТЬ ЛомбардыОтделения
		|ИЗ
		|	ВТОтделение КАК ВТОтделение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|		ПО ВТОтделение.Отделение = ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	ВЫБОР
		|		КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяНачальникомОтделения
		|			ТОГДА ""Начальник отделения ломбардов""
		|		КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяЗаместителемНачальникаОтделения
		|			ТОГДА ""Начальник отделения ломбардов""
		|		КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяУправляющимЛомбарда
		|			ТОГДА ""Управляющий ломбарда""
		|	КОНЕЦ КАК Должность
		|ИЗ
		|	ЛомбардыОтделения КАК ЛомбардыОтделения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&Дата, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
		|		ПО ЛомбардыОтделения.Ломбард = ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение
		|ГДЕ
		|	(ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяНачальникомОтделения
		|			ИЛИ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяЗаместителемНачальникаОтделения
		|			ИЛИ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяУправляющимЛомбарда)
		|	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытияУвольнение";
	
	Запрос.УстановитьПараметр("ВидСобытияУвольнение", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураВозврата = Новый Структура;
	Если Выборка.Следующий() Тогда	
		Заместитель = ПроверкаЗаместителя(Выборка.Сотрудник, Дата);
		Если ЗначениеЗаполнено(Заместитель) Тогда
			СтруктураВозврата.Вставить("Сотрудник", Заместитель);
		Иначе
			СтруктураВозврата.Вставить("Сотрудник", Выборка.Сотрудник);
		КонецЕсли;
		СтруктураВозврата.Вставить("Должность", Выборка.Должность);
	КонецЕсли;
    Возврат СтруктураВозврата;
КонецФункции 

Функция ПроверкаЗаместителя(Сотрудник, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ЗаместителиСрезПоследних.Заместитель КАК Заместитель
		|ИЗ
		|	РегистрСведений.ЛБ_Заместители.СрезПоследних(
		|			&Дата,
		|			СотрудникКогоЗамещают = &Сотрудник
		|				И ОкончаниеЗамещения >= &Дата) КАК ЛБ_ЗаместителиСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заместитель;
	Иначе
		Возврат Справочники.ЛБ_Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция ПечатьОтчетДДССервер(ПараметрыОтчета) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетДДС";
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_ДДС");
	
	ОбластьШапка   = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСвоиБилеты = Макет.ПолучитьОбласть("ОбластьСвоиБилеты");
	ОбластьИтогоСвоиБилеты = Макет.ПолучитьОбласть("ОбластьИтогоСвоиБилеты");
	ОбластьДругиеБилеты = Макет.ПолучитьОбласть("ОбластьДругиеБилеты");
	ОбластьИтогоДругиеБилеты = Макет.ПолучитьОбласть("ОбластьИтогоДругиеБилеты");
	ОбластьИтого = Макет.ПолучитьОбласть("ОбластьИтого");
	ОбластьПодвал  = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ОбластьШапка.Параметры.Ломбард = ПараметрыОтчета.Ломбард;
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыОтчета.Ломбард.ПолучитьОбъект(),,ПараметрыОтчета.НачалоПериода);
	СтруктураАдреса = фПрочитатьJSON(ПараметрыОтчета.Ломбард.КонтактнаяИнформация[0].Значение);
	ОбластьШапка.Параметры.Город = "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, "");
	
	Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДФ='дд ММММ гггг'") + " года";
	Иначе
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДФ='дд ММММ гггг'") + " года" + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДФ='дд ММММ гггг'") + " года";
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	//СвоиЗБ	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвиженияДенежныхСредств.Ломбард КАК Ломбард,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор КАК Регистратор,
		|	ЛБ_ДвиженияДенежныхСредств.Сумма КАК Сумма,
		|	ЛБ_ДвиженияДенежныхСредств.ВидОперации КАК ВидОперации,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.НомерЗалоговогоБилета КАК РегистраторНомерЗалоговогоБилета,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.СуммаОплатыПроценты КАК РегистраторСуммаОплатыПроценты,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.СуммаОплаты КАК РегистраторСуммаОплаты,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.СуммаОплатыСсуда КАК РегистраторСуммаОплатыСсуда,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.Залогодатель КАК РегистраторЗалогодатель
		|ПОМЕСТИТЬ ДДС
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
		|ГДЕ
		|	ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ТИПЗНАЧЕНИЯ(ЛБ_ДвиженияДенежныхСредств.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
		|	И ЛБ_ДвиженияДенежныхСредств.Ломбард = &Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.Период КАК Период,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.Залогодатель КАК Залогодатель,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.Регистратор.Ломбард КАК РегистраторЛомбард
		|ПОМЕСТИТЬ СостояниеЗБ
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПервых(, СтатусЗалоговогоБилета = &СтатусЗБ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПервых
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДДС.Ломбард КАК Ломбард,
		|	ДДС.Регистратор КАК Регистратор,
		|	ДДС.Сумма КАК Сумма,
		|	ДДС.ВидОперации КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА ДДС.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПКО.ОплатаПоЗаймуПереоформление)
		|			ТОГДА ДДС.Регистратор.ПредыдущаяОперация.НомерЗалоговогоБилета
		|		ИНАЧЕ ДДС.Регистратор.НомерЗалоговогоБилета
		|	КОНЕЦ КАК НомерЗалоговогоБилета,
		|	СостояниеЗБ.Период КАК ДатаВыдачиЗайма,
		|	ДДС.РегистраторСуммаОплаты КАК СуммаОплаты,
		|	ДДС.РегистраторСуммаОплатыПроценты КАК СуммаОплатыПроценты,
		|	ДДС.РегистраторСуммаОплатыСсуда КАК СуммаОплатыДолг,
		|	СостояниеЗБ.Залогодатель КАК Залогодатель,
		|	ДДС.РегистраторЗалогодатель КАК Плательщик,
		|	ДДС.Регистратор.Дата КАК РегистраторДата,
		|	ДДС.Регистратор.ОтмененныйДокумент КАК РегистраторОтмененныйДокумент,
		|	ДДС.Регистратор.ПредыдущаяОперация КАК ПредыдущаяОперация,
		|	ДДС.Регистратор.ПредыдущаяОперация.НомерЗалоговогоБилета КАК ПредыдущаяОперацияНомерЗалоговогоБилета
		|ИЗ
		|	ДДС КАК ДДС
		|		ЛЕВОЕ СОЕДИНЕНИЕ СостояниеЗБ КАК СостояниеЗБ
		|		ПО (ВЫБОР
		|				КОГДА ДДС.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПКО.ОплатаПоЗаймуПереоформление)
		|					ТОГДА ДДС.Регистратор.ПредыдущаяОперация.НомерЗалоговогоБилета = СостояниеЗБ.НомерЗалоговогоБилета
		|				ИНАЧЕ ДДС.Регистратор.НомерЗалоговогоБилета = СостояниеЗБ.НомерЗалоговогоБилета
		|			КОНЕЦ)
		|ГДЕ
		|	СостояниеЗБ.РегистраторЛомбард = &Ломбард
		|
		|УПОРЯДОЧИТЬ ПО
		|	РегистраторДата,
		|	ВидОперации";
	
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("Период", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("СтатусЗБ", Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	
	//исключение отмененных операций
	Выборка = Запрос.Выполнить().Выгрузить();
	МассивСтрокКУдалению = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Выборка Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.РегистраторОтмененныйДокумент) Тогда
			МассивСтрокКУдалению.Добавить(ТекущаяСтрока);
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Регистратор", ТекущаяСтрока.РегистраторОтмененныйДокумент);
			СтруктураПоиска.Вставить("Сумма", -ТекущаяСтрока.Сумма);
			ОтмененнаяОперация = Выборка.НайтиСтроки(СтруктураПоиска);
			Если ОтмененнаяОперация.Количество() > 0 Тогда
				МассивСтрокКУдалению.Добавить(ОтмененнаяОперация[0]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из МассивСтрокКУдалению Цикл
		Выборка.Удалить(Элемент);
	КонецЦикла;
	//
	
	НомерПП = 0;
	ИтогоВыданныеСвои = 0;
	ИтогоВозвращенныеСвои = 0;
	ИтогоПроцентыСвои = 0;
	//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
	ИтогоВозвращеноИПроцентыСвои = 0;
	//-МАН
	Для Каждого ТекущаяСтрока Из Выборка Цикл
		НомерПП = НомерПП + 1;
		ОбластьСвоиБилеты.Параметры.НомерПП = НомерПП;
		ОбластьСвоиБилеты.Параметры.НомерЛомбарда = ПараметрыОтчета.Ломбард.НомерЛомбарда;
		ОбластьСвоиБилеты.Параметры.НомерБилета = ТекущаяСтрока.НомерЗалоговогоБилета;
		ОбластьСвоиБилеты.Параметры.ДатаЗалога = ТекущаяСтрока.ДатаВыдачиЗайма;
		Если (ТекущаяСтрока.СуммаОплатыДолг = 0 И ТекущаяСтрока.СуммаОплатыПроценты = 0 И ТекущаяСтрока.Сумма > 0)
			Или ТекущаяСтрока.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.ВыдачаЗаймаПереоформление Тогда
			ОбластьСвоиБилеты.Параметры.СуммаВыданного = ТекущаяСтрока.Сумма;
			ОбластьСвоиБилеты.Параметры.СуммаВозвращенного = "-";
			ОбластьСвоиБилеты.Параметры.СуммаПроцентов = "-";
			ОбластьСвоиБилеты.Параметры.Операция = " ";
			ИтогоВыданныеСвои = ИтогоВыданныеСвои + ТекущаяСтрока.Сумма;
			//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
			ОбластьСвоиБилеты.Параметры.СуммаВозвращеноИПроценты = "-";
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьСвоиБилеты);
		ИначеЕсли ТекущаяСтрока.СуммаОплатыДолг > 0 Или ТекущаяСтрока.СуммаОплатыПроценты > 0 Тогда
			ОбластьСвоиБилеты.Параметры.СуммаВыданного = "-";
			ОбластьСвоиБилеты.Параметры.СуммаВозвращенного = ?(ТекущаяСтрока.СуммаОплатыДолг > 0, ТекущаяСтрока.СуммаОплатыДолг, "-");
			ОбластьСвоиБилеты.Параметры.СуммаПроцентов = ?(ТекущаяСтрока.СуммаОплатыПроценты > 0, ТекущаяСтрока.СуммаОплатыПроценты, "-"); 
			//+МАН 30.10.25 Не было проверки "ПереходНаОХ", что вызывало ошибку. Дата 30.10.2025, ломб "95", плат "Крутиков Иван Андреевич"
			ПереходНаОХ = ПроверкаБилетаНаОХ(ТекущаяСтрока.НомерЗалоговогоБилета, ТекущаяСтрока.РегистраторДата + 2);
			//Было: ОбластьСвоиБилеты.Параметры.Операция = ОпределениеВидаОперации(ТекущаяСтрока.Регистратор, ТекущаяСтрока.Плательщик, ТекущаяСтрока.Залогодатель, ТекущаяСтрока.ВидОперации);
			ОбластьСвоиБилеты.Параметры.Операция = ОпределениеВидаОперации(ТекущаяСтрока.Регистратор, ТекущаяСтрока.Плательщик, ТекущаяСтрока.Залогодатель, ТекущаяСтрока.ВидОперации, ПереходНаОХ);
			//-МАН
			ИтогоВозвращенныеСвои = ИтогоВозвращенныеСвои + ТекущаяСтрока.СуммаОплатыДолг;
	        ИтогоПроцентыСвои = ИтогоПроцентыСвои + ТекущаяСтрока.СуммаОплатыПроценты;
			//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
			СуммаВозвращеноИПроценты = ТекущаяСтрока.СуммаОплатыДолг + ТекущаяСтрока.СуммаОплатыПроценты;
			ОбластьСвоиБилеты.Параметры.СуммаВозвращеноИПроценты = ?(СуммаВозвращеноИПроценты > 0, СуммаВозвращеноИПроценты, "-");
			ИтогоВозвращеноИПроцентыСвои = ИтогоВозвращеноИПроцентыСвои + СуммаВозвращеноИПроценты;
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьСвоиБилеты);
		КонецЕсли;
	КонецЦикла;
	ОбластьИтогоСвоиБилеты.Параметры.ИтогоВыданныеСвои = ИтогоВыданныеСвои;
	ОбластьИтогоСвоиБилеты.Параметры.ИтогоВозвращенныеСвои = ИтогоВозвращенныеСвои;
	ОбластьИтогоСвоиБилеты.Параметры.ИтогоПроцентыСвои = ИтогоПроцентыСвои;
	//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
	ОбластьИтогоСвоиБилеты.Параметры.ИтогоВозвращеноИПроцентыСвои = ИтогоВозвращеноИПроцентыСвои;
	//-МАН
