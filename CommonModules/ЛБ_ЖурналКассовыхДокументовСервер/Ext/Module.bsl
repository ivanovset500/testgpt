	ВидыКамней = Новый СписокЗначений;
	ВидыКамней.Добавить(Перечисления.ЛБ_ВидыКамней.Драгоценные);
	ВидыКамней.Добавить(Перечисления.ЛБ_ВидыКамней.Полудрагоценные);
	ВидыКамней.Добавить(Перечисления.ЛБ_ВидыКамней.Синтетические);
	
	Запрос.УстановитьПараметр("ВидКамня", ВидыКамней);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("Период", ПараметрыОтчета.НачалоПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИтогоОстатокОбщаяМасса = 0;
	ИтогоОстатокМассаЛигатуры = 0;
	ИтогоОстатокМассаХим = 0;
	ИтогоОстатокВесДК = 0;
	ИтогоОстатокКоличество = 0;
	ИтогоОстатокСтоимость = 0;
	//+МАН 01.12.25 Добавлено количество камней
	ИтогоОстатокКоличествоКамней = 0;
	//-МАН
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ПробаВладелец) Тогда
		ПробаОбъект = Строка(Выборка.ПробаВладелец) + Строка(Выборка.ПробаПроба);
		ПробаМеталл = Строка(Выборка.ПробаВладелецМеталл) + Строка(Выборка.ПробаПробаМеталл);
		Если ПробаОбъект = ПробаМеталл Тогда
			Продолжить;
		Иначе
			Если ЗначениеЗаполнено(Выборка.ПробаВладелецМеталл) Тогда
				ОбластьОстатокНачало.Параметры.Проба = Строка(Выборка.ПробаВладелецМеталл) + " " + Строка(Выборка.ПробаПробаМеталл);
			Иначе
				ОбластьОстатокНачало.Параметры.Проба = Строка(Выборка.ПробаВладелец) + " " + Строка(Выборка.ПробаПроба);
			КонецЕсли;
		КонецЕсли;
		ОбластьОстатокНачало.Параметры.ОбщаяМасса = Выборка.Вес;
		ИтогоОстатокОбщаяМасса = ИтогоОстатокОбщаяМасса + Выборка.Вес;
		ОбластьОстатокНачало.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры;
		ИтогоОстатокМассаЛигатуры = ИтогоОстатокМассаЛигатуры + Выборка.МассаЛигатуры;
		ОбластьОстатокНачало.Параметры.МассаХим = Выборка.МассаХим;
		ИтогоОстатокМассаХим = ИтогоОстатокМассаХим + Выборка.МассаХим;
		ОбластьОстатокНачало.Параметры.ВесДК = "";
		ОбластьОстатокНачало.Параметры.Количество = Выборка.КоличествоОстаток;
		ИтогоОстатокКоличество = ИтогоОстатокКоличество + Выборка.КоличествоОстаток;
		ОбластьОстатокНачало.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
		ИтогоОстатокСтоимость = ИтогоОстатокСтоимость + Выборка.СуммаОценкиМакс;
		ТабличныйДокумент.Вывести(ОбластьОстатокНачало);
	Иначе
		Если Выборка.Вес <> 0 Тогда
		ОбластьОстатокНачало.Параметры.Проба = Выборка.ВидВставки;
		ОбластьОстатокНачало.Параметры.ОбщаяМасса = "";
		ОбластьОстатокНачало.Параметры.МассаЛигатуры = "";
		ОбластьОстатокНачало.Параметры.МассаХим = "";
		ОбластьОстатокНачало.Параметры.ВесДК = Выборка.Вес;
		ИтогоОстатокВесДК = ИтогоОстатокВесДК + Выборка.Вес;
		ОбластьОстатокНачало.Параметры.Количество = Выборка.КоличествоОстаток;
		ИтогоОстатокКоличество = ИтогоОстатокКоличество + Выборка.КоличествоОстаток;
		ОбластьОстатокНачало.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
		ИтогоОстатокСтоимость = ИтогоОстатокСтоимость + Выборка.СуммаОценкиМакс;
		//+МАН 01.12.25 Добавлено количество камней
        ИтогоОстатокКоличествоКамней = ИтогоОстатокКоличествоКамней + Выборка.КоличествоКамней;
		ОбластьОстатокНачало.Параметры.КоличествоДК = Выборка.КоличествоКамней;
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьОстатокНачало);
		КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОбластьИтогоОстатокНачало.Параметры.ИтогоОбщаяМасса = ИтогоОстатокОбщаяМасса;
	ОбластьИтогоОстатокНачало.Параметры.ИтогоМассаЛигатуры = ИтогоОстатокМассаЛигатуры;
	ОбластьИтогоОстатокНачало.Параметры.ИтогоМассаХим = ИтогоОстатокМассаХим;
	ОбластьИтогоОстатокНачало.Параметры.ИтогоВесДК = ИтогоОстатокВесДК;
	ОбластьИтогоОстатокНачало.Параметры.ИтогоКоличество = ИтогоОстатокКоличество;
	ОбластьИтогоОстатокНачало.Параметры.ИтогоСтоимость = ИтогоОстатокСтоимость;
	//+МАН 01.12.25 Добавлено количество камней
	ОбластьИтогоОстатокНачало.Параметры.ИтогоКоличествоДК = ИтогоОстатокКоличествоКамней;
	//-МАН
	ТабличныйДокумент.Вывести(ОбластьИтогоОстатокНачало);
	
	//Приход	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
		|	СУММА(ЛБ_ОбъектыЗалогаОбороты.КоличествоПриход) КАК КоличествоПриход,
		|	ЛБ_ОбъектыЗалогаОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет
