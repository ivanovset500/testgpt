	Возврат ТабличныйДокумент;
	
КонецФункции 

Функция ОпределениеВидаОперации(Операция, Плательщик, Залогодатель, ВидОперации = Неопределено, ПереходНаОХ = Неопределено)
	Если Операция.Выкуп И Операция.ВыдачаЗалога Тогда
		Если Плательщик = Залогодатель Тогда
			Обозначение = "В(Заемщ.)";
		Иначе
			Обозначение = "В(Дов. лицо)";
		КонецЕсли;
	ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОплатаПоЗаймуПереоформление Тогда
		Если Плательщик = Залогодатель Тогда
			Обозначение = "В(Заемщ.)";
		Иначе
			Обозначение = "В(Дов. лицо)";
		КонецЕсли;
	ИначеЕсли Операция.Выкуп И НЕ Операция.ВыдачаЗалога Тогда
		Если ПереходНаОХ Тогда
			Если Плательщик = Залогодатель Тогда
				Обозначение = "В(Заемщ.)";
			ИначеЕсли Плательщик <> Залогодатель Тогда
				Если ПроверкаДоверенногоЛица(Залогодатель, Плательщик, Операция.Дата, Операция.НомерЗалоговогоБилета) Тогда
					Обозначение = "В(Дов. лицо)";
				Иначе
					Обозначение = "В(3л.)";
				КонецЕсли;	
			КонецЕсли;
		Иначе	
		Обозначение = "В(3л.)";
		КонецЕсли;
	ИначеЕсли (Операция.СуммаОплатыПроценты <> 0 И Операция.СуммаОплатыСсуда <> 0)
		Или (Операция.СуммаОплатыПроценты = 0 И Операция.СуммаОплатыСсуда <> 0) Тогда
		
		Если Плательщик = Залогодатель Тогда
			Обозначение = "В Част.(Заемщ.)";
		ИначеЕсли Плательщик <> Залогодатель Тогда
			Если ПроверкаДоверенногоЛица(Залогодатель, Плательщик, Операция.Дата, Операция.НомерЗалоговогоБилета) Тогда
				Обозначение = "В Част.(Дов. лицо)";
			Иначе
				Обозначение = "В Част.(3л.)";
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли Операция.СуммаОплатыПроценты <> 0 И Операция.СуммаОплатыСсуда = 0  Тогда
		ПредыдущаяДатаВыкупа = ПолучитьДатуВыкупа(Операция.НомерЗалоговогоБилета, Операция.Дата - 1);
		НоваяДатаВыкупа = ПолучитьДатуВыкупа(Операция.НомерЗалоговогоБилета, Операция.Дата);
		Если Плательщик = Залогодатель Тогда
			Если НоваяДатаВыкупа <> ПредыдущаяДатаВыкупа Тогда
				Обозначение = "П(Заемщ. с продлен. срока займа)";
			Иначе
				Обозначение = "П(Заемщ. без продлен. срока займа)";
			КонецЕсли;
		ИначеЕсли Плательщик <> Залогодатель Тогда
			Если ПроверкаДоверенногоЛица(Залогодатель, Плательщик, Операция.Дата, Операция.НомерЗалоговогоБилета) Тогда
				Если НоваяДатаВыкупа <> ПредыдущаяДатаВыкупа Тогда
				Обозначение = "П(Дов. лицо с продлен. срока займа)";
			Иначе
				Обозначение = "П(Дов. лицо без продлен. срока займа)";
			КонецЕсли;
			Иначе
				Если НоваяДатаВыкупа <> ПредыдущаяДатаВыкупа Тогда
				Обозначение = "П(3л. с продлен. срока займа)";
			Иначе
				Обозначение = "П(3л. без продлен. срока займа)";
			КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Возврат Обозначение;
КонецФункции

Функция ПроверкаДоверенногоЛица(Залогодатель, Плательщик, Период, НомерЗБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
		|	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности,
		|	ЛБ_ДоверенностиСрезПоследних.Доверенность.СрокДействияДоверенности КАК ДоверенностьСрокДействияДоверенности
		|ИЗ
		|	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
		|			&Период,
		|			Клиент = &Залогодатель
		|				И Доверенность.ПредставительКлиента = &Плательщик
		|				И ЗалоговыйБилет.НомерЗалоговогоБилета = &НомерЗБ
		|				И СтатусДоверенности = &Действует
		|				И Доверенность.СрокДействияДоверенности > &Период) КАК ЛБ_ДоверенностиСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
	Запрос.УстановитьПараметр("Действует", Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДатуВыкупа(НомерЗБ, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК Дата
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Период, НомерЗалоговогоБилета = &НомерЗБ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дата;
	Иначе
		Возврат Период;
	КонецЕсли;	

КонецФункции

Функция ПечатьОтчетОплатаБилетовВДругихЛомбардахСервер(ПараметрыОтчета) Экспорт
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетОплатаБилетовВДругихЛомбардах";
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_ОплатаБилетовВДругихЛомбардах");
	
	ОбластьШапка   = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьБилеты = Макет.ПолучитьОбласть("ОбластьБилеты");
	ОбластьИтого = Макет.ПолучитьОбласть("ОбластьИтого");
	ОбластьПодвал  = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ОбластьШапка.Параметры.НомерЛомбарда = ПараметрыОтчета.Ломбард.НомерЛомбарда;
	
	Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДФ='дд ММММ гггг'") + " года";
	Иначе
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДФ='дд ММММ гггг'") + " года" + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДФ='дд ММММ гггг'") + " года";
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерЗалоговогоБилета КАК Билет
		|ПОМЕСТИТЬ ВТБилеты
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(
		|			&КонецПериода,
		|			СтатусЗалоговогоБилета = &СтатусПринят
		|				И ЗалоговыйБилет.Ломбард = &Ломбард) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.НомерЗалоговогоБилета КАК РегистраторНомерЗалоговогоБилета,
		|	ЛБ_ДвиженияДенежныхСредств.Ломбард КАК Ломбард,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.СуммаОплатыПроценты КАК СуммаПроценты,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.СуммаОплатыСсуда КАК СуммаДолг,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор.Залогодатель КАК РегистраторЗалогодатель,
		|	ЛБ_ДвиженияДенежныхСредств.Регистратор КАК Регистратор,
		|	ЛБ_ДвиженияДенежныхСредств.Сумма КАК Сумма,
		|	ЛБ_ДвиженияДенежныхСредств.ВидОперации КАК ВидОперации
		|ПОМЕСТИТЬ ВТ_ОплатыБилетов
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
		|ГДЕ
		|	ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЛБ_ДвиженияДенежныхСредств.ВидОперации В(&ВидОперации)
		|	И ЛБ_ДвиженияДенежныхСредств.Ломбард <> &Ломбард
		|	И ЛБ_ДвиженияДенежныхСредств.Регистратор.НомерЗалоговогоБилета В
		|			(ВЫБРАТЬ
		|				ВТБилеты.Билет
		|			ИЗ
		|				ВТБилеты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.Период КАК ДатаЗалога,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.СуммаЗайма КАК СуммаЗайма,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПервых.Залогодатель КАК Залогодатель
		|ПОМЕСТИТЬ ВТ_СуммыЗаймов
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПервых(, СтатусЗалоговогоБилета = &СтатусПринят) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПервых
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОплатыБилетов.РегистраторНомерЗалоговогоБилета КАК РегистраторНомерЗалоговогоБилета,
		|	ВТ_ОплатыБилетов.Ломбард КАК Ломбард,
		|	ВТ_ОплатыБилетов.СуммаПроценты КАК СуммаПроценты,
		|	ВТ_ОплатыБилетов.СуммаДолг КАК СуммаДолг,
		|	ВТ_СуммыЗаймов.СуммаЗайма КАК СуммаЗайма,
		|	ВТ_СуммыЗаймов.ДатаЗалога КАК ДатаВыдачиЗайма,
		|	ВТ_СуммыЗаймов.Залогодатель КАК Залогодатель,
		|	ВТ_ОплатыБилетов.РегистраторЗалогодатель КАК Плательщик,
		|	ВТ_ОплатыБилетов.Регистратор КАК Регистратор,
		|	ВТ_ОплатыБилетов.Регистратор.ОтмененныйДокумент КАК РегистраторОтмененныйДокумент,
		|	ВТ_ОплатыБилетов.Сумма КАК Сумма,
		|	ВТ_ОплатыБилетов.ВидОперации КАК ВидОперации
		|ИЗ
		|	ВТ_ОплатыБилетов КАК ВТ_ОплатыБилетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммыЗаймов КАК ВТ_СуммыЗаймов
		|		ПО ВТ_ОплатыБилетов.РегистраторНомерЗалоговогоБилета = ВТ_СуммыЗаймов.НомерЗалоговогоБилета";
	
	СписокВидОперации = Новый СписокЗначений;
	СписокВидОперации.Добавить(Перечисления.ЛБ_ВидыОперацийПКО.ОплатаПоЗайму);
	СписокВидОперации.Добавить(Перечисления.ЛБ_ВидыОперацийПКО.ОплатаПоЗаймуПереоформление);
	
	Запрос.УстановитьПараметр("ВидОперации", СписокВидОперации);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("СтатусПринят", Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	
	//исключение отмененных операций
	Выборка = Запрос.Выполнить().Выгрузить();
	МассивСтрокКУдалению = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Выборка Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.РегистраторОтмененныйДокумент) Тогда
			МассивСтрокКУдалению.Добавить(ТекущаяСтрока);
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Регистратор", ТекущаяСтрока.РегистраторОтмененныйДокумент);
			СтруктураПоиска.Вставить("Сумма", -ТекущаяСтрока.Сумма);
			ОтмененнаяОперация = Выборка.НайтиСтроки(СтруктураПоиска);
			Если ОтмененнаяОперация.Количество() > 0 Тогда
				МассивСтрокКУдалению.Добавить(ОтмененнаяОперация[0]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из МассивСтрокКУдалению Цикл
		Выборка.Удалить(Элемент);
	КонецЦикла;
	//
	
	НомерПП = 0;
	ИтогоВыданные = 0;
	ИтогоВозвращенные = 0;
	ИтогоПроценты = 0;
	Для Каждого ТекущаяСтрока Из Выборка Цикл
		НомерПП = НомерПП + 1;
		ОбластьБилеты.Параметры.НомерПП = НомерПП;
		ОбластьБилеты.Параметры.НомерЛомбарда = ТекущаяСтрока.Ломбард.НомерЛомбарда;
		ОбластьБилеты.Параметры.НомерБилета = ТекущаяСтрока.РегистраторНомерЗалоговогоБилета;
		ОбластьБилеты.Параметры.ДатаЗалога = ТекущаяСтрока.ДатаВыдачиЗайма;
		ОбластьБилеты.Параметры.СуммаВыданного = ТекущаяСтрока.СуммаЗайма;
		ОбластьБилеты.Параметры.СуммаВозвращенного = ТекущаяСтрока.СуммаДолг;
		ОбластьБилеты.Параметры.СуммаПроцентов = ?(ТекущаяСтрока.СуммаПроценты = 0, "-", ТекущаяСтрока.СуммаПроценты);
		ПереходНаОХ = ПроверкаБилетаНаОХ(ТекущаяСтрока.РегистраторНомерЗалоговогоБилета, ТекущаяСтрока.Регистратор.Дата + 2);
		ОбластьБилеты.Параметры.Операция = ОпределениеВидаОперации(ТекущаяСтрока.Регистратор, ТекущаяСтрока.Плательщик, ТекущаяСтрока.Залогодатель, ТекущаяСтрока.ВидОперации, ПереходНаОХ);
		ИтогоВозвращенные = ИтогоВозвращенные + ТекущаяСтрока.СуммаДолг;
		ИтогоПроценты = ИтогоПроценты + ТекущаяСтрока.СуммаПроценты;
		ТабличныйДокумент.Вывести(ОбластьБилеты);
	КонецЦикла;

	ОбластьИтого.Параметры.ИтогоВозвращенные = ИтогоВозвращенные;
	ОбластьИтого.Параметры.ИтогоПроценты = ИтогоПроценты;
	ТабличныйДокумент.Вывести(ОбластьИтого);	
	
	ОбластьПодвал.Параметры.ИтогоВозвращенныеПрописью = ЧислоПрописью(ИтогоВозвращенные,"Л=ru_RU; ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж" );
	ОбластьПодвал.Параметры.ИтогоПроцентыПропиьсю = ЧислоПрописью(ИтогоПроценты,"Л=ru_RU; ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж" );
	
	Ответственный              = ПараметрыСеанса.ТекущийСотрудник;
	
	ФИООтветственного          = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.Ответственный = ФамилияОтветственного + " " + ИнициалыОтветственного;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;

	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСлева = Строка(ТекущаяДата()) + 
	" " + ФамилияОтветственного + " " + ИнициалыОтветственного;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "Отчет по оплатам билетов ломбарда № " + ОбластьШапка.Параметры.НомерЛомбарда + " в других ломбардах за период " + ОбластьШапка.Параметры.Период;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	Шрифт = Новый Шрифт("Times New Roman", 8);
	ТабличныйДокумент.НижнийКолонтитул.Шрифт = Шрифт;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПечатьОтчетВыданныеСОХСервер(ПараметрыОтчета) Экспорт
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетВыданныеСОХ";
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_ВыданныеСОХ");
	
	ОбластьШапка   = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьБилеты = Макет.ПолучитьОбласть("ОбластьБилеты");
	ОбластьИтого = Макет.ПолучитьОбласть("ОбластьИтого");
	ОбластьПодвал  = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ОбластьШапка.Параметры.Ломбард = ПараметрыОтчета.Ломбард;
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыОтчета.Ломбард.ПолучитьОбъект(),,ПараметрыОтчета.НачалоПериода);
	СтруктураАдреса = фПрочитатьJSON(ПараметрыОтчета.Ломбард.КонтактнаяИнформация[0].Значение);
	ОбластьШапка.Параметры.Город = "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, "");
	
	Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
		ВыводЗаПериод = Ложь;
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДФ='дд ММММ гггг'") + " года";
	Иначе
		ВыводЗаПериод = Истина;
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДФ='дд ММММ гггг'") + " года" + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДФ='дд ММММ гггг'") + " года";
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилета.Период КАК Период,
		|	ЛБ_СостояниеЗалоговогоБилета.Регистратор.Ломбард КАК РегистраторЛомбард,
		|	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
		|	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
		|ПОМЕСТИТЬ ВТ1
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
		|ГДЕ
		|	ЛБ_СостояниеЗалоговогоБилета.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.Ломбард = &Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ОперацияПоЗалогуТовары.Ссылка КАК Ссылка,
		|	ЛБ_ОперацияПоЗалогуТовары.НомерСтроки КАК НомерСтроки,
		|	ЛБ_ОперацияПоЗалогуТовары.СуммаОценкиМаксимальная КАК СуммаОценкиМаксимальная,
		|	ЛБ_ОперацияПоЗалогуТовары.ВидИзделия КАК ВидИзделия,
		|	ЛБ_ОперацияПоЗалогуТовары.Ссылка.СуммаОплаты КАК СуммаОплаты,
		|	ЛБ_ОперацияПоЗалогуТовары.ОбъектЗалога КАК ОбъектЗалога
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	Документ.ЛБ_ОперацияПоЗалогу.Товары КАК ЛБ_ОперацияПоЗалогуТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ1.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ВТ1.Период КАК Период,
		|	ВТ1.РегистраторЛомбард КАК РегистраторЛомбард,
		|	ВТ2.НомерСтроки КАК НомерСтроки,
		|	ВТ2.СуммаОценкиМаксимальная КАК СуммаОценкиМаксимальная,
		|	ВТ2.Ссылка.Залогодатель КАК СсылкаЗалогодатель,
		|	ВТ2.ВидИзделия КАК ВидИзделия,
		|	ВТ1.Регистратор.ОтмененныйДокумент КАК РегистраторОтмененныйДокумент,
		|	ВТ1.Регистратор КАК Регистратор,
		|	ВТ1.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
		|	ЕСТЬNULL(ВТ2.СуммаОплаты, 0) КАК Сумма,
		|	ВТ2.ОбъектЗалога КАК ОбъектЗалога
		|ИЗ
		|	ВТ1 КАК ВТ1
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ2 КАК ВТ2
		|		ПО ВТ1.Регистратор = ВТ2.Ссылка";
	
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.КонецПериода);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	
	//исключение отмененных операций
	Выборка = Запрос.Выполнить().Выгрузить();
	МассивСтрокКУдалению = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Выборка Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.РегистраторОтмененныйДокумент) Тогда
			МассивСтрокКУдалению.Добавить(ТекущаяСтрока);
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Регистратор", ТекущаяСтрока.РегистраторОтмененныйДокумент);
			СтруктураПоиска.Вставить("Сумма", -ТекущаяСтрока.Сумма);
			ОтмененнаяОперация = Выборка.НайтиСтроки(СтруктураПоиска);
			Если ОтмененнаяОперация.Количество() > 0 Тогда
				МассивСтрокКУдалению.Добавить(ОтмененнаяОперация[0]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из МассивСтрокКУдалению Цикл
		Выборка.Удалить(Элемент);
	КонецЦикла;
	//
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОХ_Итог.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ОХ_Итог.Период КАК Период,
		|	ОХ_Итог.РегистраторЛомбард КАК РегистраторЛомбард,
		|	ОХ_Итог.НомерСтроки КАК НомерСтроки,
		|	ОХ_Итог.СуммаОценкиМаксимальная КАК СуммаОценкиМаксимальная,
		|	ОХ_Итог.СсылкаЗалогодатель КАК СсылкаЗалогодатель,
		|	ОХ_Итог.ВидИзделия КАК ВидИзделия,
		|	ОХ_Итог.РегистраторОтмененныйДокумент КАК РегистраторОтмененныйДокумент,
		|	ОХ_Итог.Регистратор КАК Регистратор,
		|	ОХ_Итог.ОбъектЗалога КАК ОбъектЗалога,
		|	ОХ_Итог.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
		|ПОМЕСТИТЬ ОХ_Итог
		|ИЗ
		|	&ОХ_Итог КАК ОХ_Итог
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОХ_Итог.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ОХ_Итог.Период КАК Период,
		|	ОХ_Итог.РегистраторЛомбард КАК РегистраторЛомбард,
		|	ОХ_Итог.НомерСтроки КАК НомерСтроки,
		|	ОХ_Итог.СуммаОценкиМаксимальная КАК СуммаОценкиМаксимальная,
		|	ОХ_Итог.СсылкаЗалогодатель КАК СсылкаЗалогодатель,
		|	ОХ_Итог.ВидИзделия КАК ВидИзделия,
		|	ОХ_Итог.РегистраторОтмененныйДокумент КАК РегистраторОтмененныйДокумент,
		|	ОХ_Итог.Регистратор КАК Регистратор,
		|	ОХ_Итог.ОбъектЗалога КАК ОбъектЗалога
		|ИЗ
		|	ОХ_Итог КАК ОХ_Итог
		|ГДЕ
		|	ОХ_Итог.СтатусЗалоговогоБилета = &СтатусЗалоговогоБилета";
	
    Запрос.УстановитьПараметр("ОХ_Итог", Выборка);
	Запрос.УстановитьПараметр("СтатусЗалоговогоБилета", Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	НомерПП = 0;
	ИтогоСуммаОценки = 0;

	Для Каждого ТекущаяСтрока Из Выборка Цикл
		Если ПроверкаОбъектаНаОХ(ТекущаяСтрока.ОбъектЗалога, ТекущаяСтрока.Период) Тогда
		НомерПП = НомерПП + 1;
		ОбластьБилеты.Параметры.НомерПП = НомерПП;
		ОбластьБилеты.Параметры.НомерЗБ = ТекущаяСтрока.НомерЗалоговогоБилета + "-" + Строка(ТекущаяСтрока.НомерСтроки);
		ОбластьБилеты.Параметры.Залог = ТекущаяСтрока.ВидИзделия;
		ОбластьБилеты.Параметры.СуммаОценки = ТекущаяСтрока.СуммаОценкиМаксимальная;
		ИтогоСуммаОценки = ИтогоСуммаОценки + ТекущаяСтрока.СуммаОценкиМаксимальная;
		ОбластьБилеты.Параметры.ФИО = ТекущаяСтрока.СсылкаЗалогодатель;
		ТабличныйДокумент.Вывести(ОбластьБилеты);
		КонецЕсли;
	КонецЦикла;

	ОбластьИтого.Параметры.Количество = НомерПП;
	ОбластьИтого.Параметры.ИтогоСуммаОценки = ИтогоСуммаОценки;
	ТабличныйДокумент.Вывести(ОбластьИтого);	
	
	Ответственный              = ПараметрыСеанса.ТекущийСотрудник;
	
	ФИООтветственного          = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.Ответственный = ФамилияОтветственного + " " + ИнициалыОтветственного;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСлева = Строка(ТекущаяДата()) + 
	" " + ФамилияОтветственного + " " + ИнициалыОтветственного;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "Отчет о выданных предметах залога с ответственного хранения за " + ОбластьШапка.Параметры.Период;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	Шрифт = Новый Шрифт("Times New Roman", 8);
	ТабличныйДокумент.НижнийКолонтитул.Шрифт = Шрифт;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПроверкаБилетаНаОХ(НомерЗБ, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Период, НомерЗалоговогоБилета = &НомерЗБ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
	Запрос.УстановитьПараметр("Период", Период - 1);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение 
			Или Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ГотовКОтправкеОХ
			Или Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВПутиОХ Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция ПроверкаОбъектаНаОХ(ОбъектЗалога, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Период, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних";
	
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	Запрос.УстановитьПараметр("Период", Период - 1);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение 
			Или Выборка.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ГотовКОтправкеОХ
			Или Выборка.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ВПутиОХ
			Или Выборка.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ПринятНаСклад Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

