	Запрос.УстановитьПараметр("ВидКамня", ВидыКамней);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("Период", КонецДня(ПараметрыОтчета.КонецПериода));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИтогоОстатокКонецОбщаяМасса = 0;
	ИтогоОстатокКонецМассаЛигатуры = 0;
	ИтогоОстатокКонецМассаХим = 0;
	ИтогоОстатокКонецВесДК = 0;
	ИтогоОстатокКонецКоличество = 0;
	ИтогоОстатокКонецСтоимость = 0;
	//+МАН 01.12.25 Добавлено количество камней
	ИтогоОстатокКонецКоличествоКамней = 0;
	//-МАН
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ПробаВладелец) Тогда	
		ПробаОбъект = Строка(Выборка.ПробаВладелец) + Строка(Выборка.ПробаПроба);
		ПробаМеталл = Строка(Выборка.ПробаВладелецМеталл) + Строка(Выборка.ПробаПробаМеталл);
		Если ПробаОбъект = ПробаМеталл Тогда
			Продолжить;
		Иначе
			Если ЗначениеЗаполнено(Выборка.ПробаВладелецМеталл) Тогда
				ОбластьОстатокКонец.Параметры.Проба = Строка(Выборка.ПробаВладелецМеталл) + " " + Строка(Выборка.ПробаПробаМеталл);
			Иначе
				ОбластьОстатокКонец.Параметры.Проба = Строка(Выборка.ПробаВладелец) + " " + Строка(Выборка.ПробаПроба);
			КонецЕсли;
		КонецЕсли;
		ОбластьОстатокКонец.Параметры.ОбщаяМасса = Выборка.Вес;
		ИтогоОстатокКонецОбщаяМасса = ИтогоОстатокКонецОбщаяМасса + Выборка.Вес;
		ОбластьОстатокКонец.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры;
		ИтогоОстатокКонецМассаЛигатуры = ИтогоОстатокКонецМассаЛигатуры + Выборка.МассаЛигатуры;
		ОбластьОстатокКонец.Параметры.МассаХим = Выборка.МассаХим;
		ИтогоОстатокКонецМассаХим = ИтогоОстатокКонецМассаХим + Выборка.МассаХим;
		ОбластьОстатокКонец.Параметры.ВесДК = "";
		ОбластьОстатокКонец.Параметры.Количество = Выборка.КоличествоОстаток;
		ИтогоОстатокКонецКоличество = ИтогоОстатокКонецКоличество + Выборка.КоличествоОстаток;
		ОбластьОстатокКонец.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
		ИтогоОстатокКонецСтоимость = ИтогоОстатокКонецСтоимость + Выборка.СуммаОценкиМакс;
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьОстатокКонец.Параметры.КоличествоДК = "";
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьОстатокКонец);
	Иначе
		Если Выборка.Вес <> 0 Тогда
		ОбластьОстатокКонец.Параметры.Проба = Выборка.ВидВставки;
		ОбластьОстатокКонец.Параметры.ОбщаяМасса = "";
		ОбластьОстатокКонец.Параметры.МассаЛигатуры = "";
		ОбластьОстатокКонец.Параметры.МассаХим = "";
		ОбластьОстатокКонец.Параметры.ВесДК = Выборка.Вес;
		ИтогоОстатокКонецВесДК = ИтогоОстатокКонецВесДК + Выборка.Вес;
		ОбластьОстатокКонец.Параметры.Количество = Выборка.КоличествоОстаток;
		ИтогоОстатокКонецКоличество = ИтогоОстатокКонецКоличество + Выборка.КоличествоОстаток;
		ОбластьОстатокКонец.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
		ИтогоОстатокКонецСтоимость = ИтогоОстатокКонецСтоимость + Выборка.СуммаОценкиМакс;
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьОстатокКонец.Параметры.КоличествоДК = Выборка.КоличествоКамней;
		ИтогоОстатокКонецКоличествоКамней = ИтогоОстатокКонецКоличествоКамней + Выборка.КоличествоКамней;
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьОстатокКонец);
		КонецЕсли;
	КонецЕсли;
	КонецЦикла;
	
	ОбластьИтогоОстатокКонец.Параметры.ИтогоОбщаяМасса = ИтогоОстатокКонецОбщаяМасса;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоМассаЛигатуры = ИтогоОстатокКонецМассаЛигатуры;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоМассаХим = ИтогоОстатокКонецМассаХим;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоВесДК = ИтогоОстатокКонецВесДК;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоКоличество = ИтогоОстатокКонецКоличество;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоСтоимость = ИтогоОстатокКонецСтоимость;
	//+МАН 01.12.25 Добавлено количество камней
	ОбластьИтогоОстатокКонец.Параметры.ИтогоКоличествоДК = ИтогоОстатокКонецКоличествоКамней;
	//-МАН
	ТабличныйДокумент.Вывести(ОбластьИтогоОстатокКонец);
	
	ОбластьПодвал.Параметры.ДатаСоставления = Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
	
	Ответственный              = ПараметрыСеанса.ТекущийСотрудник;	
	ФИООтветственного          = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли;
		
	ОбластьПодвал.Параметры.Ответственный = ФамилияОтветственного + " " + ИнициалыОтветственного;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

//+МАН 02.12.25 Вызов функции по формированию табличного документа ПКО
Функция СформироватьТабличныйДокументПКО(ПараметрыОтчета) Экспорт
	Возврат Документы.ЛБ_ОперацияПоЗалогу.ПечатьПКО(ПараметрыОтчета, Неопределено);
КонецФункции

