		|	ВТ_Характеристики.ПробаПроба КАК ПробаПроба,
		|	СУММА(ВТ_Объекты.КоличествоРасход) КАК КоличествоРасход,
		|	СУММА(ВТ_Характеристики.Вес) КАК Вес,
		|	СУММА(ВТ_Характеристики.ВесЧистый) КАК МассаЛигатуры,
		|	СУММА(ВТ_Характеристики.СуммаОценкиМакс) КАК СуммаОценкиМакс,
		|	СУММА(ВТ_Характеристики.ВесЧистый * (ВТ_Характеристики.ПробаПроба / 10 / 100)) КАК МассаХим,
		|	ВТ_Объекты.ОбъектЗалога КАК ОбъектЗалога,
		|	ВТ_Характеристики.Артикул КАК Артикул,
		|	ВТ_Характеристики.ЗалоговыйБилетНомерЗалоговогоБилета КАК ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_Объекты.ЗалоговыйБилет КАК ЗалоговыйБилет,
