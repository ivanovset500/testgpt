Функция ПечатьЖурналДвиженияДМ_Измененная(ПараметрыОтчета) Экспорт 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	//ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЖурналДвиженияДМ";
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_ЖурналДвиженияДМ");
	
	ОбластьШапка                  = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьШапкаОстатокНачало     = Макет.ПолучитьОбласть("ОбластьШапкаОстатокНачало");
	ОбластьОстатокНачало          = Макет.ПолучитьОбласть("ОбластьОстатокНачало");	
	ОбластьИтогоОстатокНачало     = Макет.ПолучитьОбласть("ОбластьИтогоОстатокНачало");
	ОбластьШапкаПриход            = Макет.ПолучитьОбласть("ОбластьШапкаПриход");
	ОбластьПриход                 = Макет.ПолучитьОбласть("ОбластьПриход");
	ОбластьВставкаПриход          = Макет.ПолучитьОбласть("ОбластьВставкаПриход");
	ОбластьВставкаБриллиантПриход = Макет.ПолучитьОбласть("ОбластьВставкаБриллиантПриход");
	ОбластьИтогоПриход            = Макет.ПолучитьОбласть("ОбластьИтогоПриход");
	ОбластьШапкаРасход            = Макет.ПолучитьОбласть("ОбластьШапкаРасход");
	ОбластьРасход                 = Макет.ПолучитьОбласть("ОбластьРасход");
	ОбластьВставкаРасход          = Макет.ПолучитьОбласть("ОбластьВставкаРасход");
	ОбластьВставкаБриллиантРасход = Макет.ПолучитьОбласть("ОбластьВставкаБриллиантРасход");
	ОбластьИтогоРасход            = Макет.ПолучитьОбласть("ОбластьИтогоРасход");
	ОбластьШапкаОстатокКонец      = Макет.ПолучитьОбласть("ОбластьШапкаОстатокКонец");
	ОбластьОстатокКонец           = Макет.ПолучитьОбласть("ОбластьОстатокКонец");
	ОбластьИтогоОстатокКонец      = Макет.ПолучитьОбласть("ОбластьИтогоОстатокКонец");
	ОбластьПодвал                 = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	
	ОбластьШапка.Параметры.НомерЛомбарда = ПараметрыОтчета.Ломбард.НомерЛомбарда;
	
	СтруктураАдреса = фПрочитатьJSON(ПараметрыОтчета.Ломбард.КонтактнаяИнформация[0].Значение);
	ОбластьШапка.Параметры.АдресЛомбарда = СтруктураАдреса.value;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапкаОстатокНачало.Параметры.НачалоПериода = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
	ТабличныйДокумент.Вывести(ОбластьШапкаОстатокНачало);
				
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
