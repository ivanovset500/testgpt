		|	ВТ_ИтогКамни.СуммаОценки
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(ВТ_ИтогДопМеталлы.МассаЛигатуры),
		|	СУММА(ВТ_ИтогДопМеталлы.МассаХим),
		|	СУММА(ВТ_ИтогДопМеталлы.СуммаОценки),
		|	"""",
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	СУММА(0),
		|	ВТ_ИтогДопМеталлы.Проба,
		|	ВТ_ИтогДопМеталлы.Проба.Наименование
		|ИЗ
		|	ВТ_ИтогДопМеталлы КАК ВТ_ИтогДопМеталлы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИтогДопМеталлы.Проба,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	ВТ_ИтогДопМеталлы.Проба.Наименование,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИТОГ.ПробаВладелец КАК ПробаВладелец,
		|	ВТ_ИТОГ.ПробаПроба КАК ПробаПроба,
		|	СУММА(ВТ_ИТОГ.КоличествоОстаток) КАК КоличествоОстаток,
		|	СУММА(ЕСТЬNULL(ВТ_ИТОГ.Вес, 0)) КАК Вес,
		|	СУММА(ВТ_ИТОГ.МассаЛигатуры) КАК МассаЛигатуры,
		|	СУММА(ВТ_ИТОГ.МассаХим) КАК МассаХим,
		|	СУММА(ВТ_ИТОГ.СуммаОценкиМакс) КАК СуммаОценкиМакс,
		|	ВТ_ИТОГ.ВидВставки КАК ВидВставки,
		|	ВТ_ИТОГ.ПробаВладелецМеталл КАК ПробаВладелецМеталл,
		|	ВТ_ИТОГ.ПробаПробаМеталл КАК ПробаПробаМеталл,
		|	СУММА(ВТ_ИТОГ.КоличествоКамней) КАК КоличествоКамней,
		|	ВТ_ИТОГ.Проба КАК Проба,
		|	ВТ_ИТОГ.ПробаНаименование КАК ПробаНаименование
		|ИЗ
		|	ВТ_ИТОГ КАК ВТ_ИТОГ
		|ГДЕ
		|	НЕ ВТ_ИТОГ.ПробаВладелецМеталл ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИТОГ.ПробаВладелец,
		|	ВТ_ИТОГ.ПробаПроба,
		|	ВТ_ИТОГ.ВидВставки,
		|	ВТ_ИТОГ.ПробаВладелецМеталл,
		|	ВТ_ИТОГ.ПробаПробаМеталл,
		|	ВТ_ИТОГ.Проба,
		|	ВТ_ИТОГ.ПробаНаименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидВставки,
		|	ПробаНаименование";
	
	Запрос.УстановитьПараметр("ВидКамня", ВидыКамней);
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("Период", КонецДня(ПараметрыОтчета.КонецПериода));

	//+МАН 24.02.26 Заявка 3269
	ВыборкаПоПакетно = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	ТЗИтогОЗ = ВыборкаПоПакетно[2].Выгрузить();
	ТЗИтогКамни = ВыборкаПоПакетно[4].Выгрузить();
	ТЗИтогДопМеталлы = ВыборкаПоПакетно[6].Выгрузить();
	ТЗИтог = ВыборкаПоПакетно[8].Выгрузить();
	ТЗПроб = ТЗИтог.Скопировать(, "Проба");
	ТЗПроб.Свернуть("Проба");
	//-МАН

	ИтогоОстатокКонецОбщаяМасса = 0;
	ИтогоОстатокКонецМассаЛигатуры = 0;
	ИтогоОстатокКонецМассаХим = 0;
	ИтогоОстатокКонецВесДК = 0;
	ИтогоОстатокКонецКоличество = 0;
	ИтогоОстатокКонецСтоимость = 0;
	//+МАН 01.12.25 Добавлено количество камней
	ИтогоОстатокКонецКоличествоКамней = 0;
	//-МАН
	
	Для каждого Стр Из ТЗПроб Цикл
		Если ТипЗнч(Стр.Проба) = Тип("СправочникСсылка.ЛБ_Пробы") Тогда
			
			ОтборНачало = Новый Структура;
			ОтборНачало.Вставить("Проба", Стр.Проба);
			
			СтрОЗ = ТЗИтогОЗ.Скопировать(ОтборНачало, "Вес, КоличествоОстаток, МассаЛигатуры, МассаХим, СуммаОценкиМакс");
			СтрК = ТЗИтогКамни.Скопировать(ОтборНачало, "СуммаОценки");
			СтрМ = ТЗИтогДопМеталлы.Скопировать(ОтборНачало, "СуммаОценки");
			
			Если СтрК.Количество() = 0 Тогда
				СуммаК = 0;
			Иначе
				СуммаК = СтрК.Итог("СуммаОценки");
			КонецЕсли;
			
			Если СтрМ.Количество() = 0 Тогда
				СуммаМ = 0;
			Иначе
				СуммаМ = СтрМ.Итог("СуммаОценки");
			КонецЕсли;
			
			ОбластьОстатокКонец.Параметры.Проба = Строка(Стр.Проба);
			ОбластьОстатокКонец.Параметры.ОбщаяМасса = СтрОЗ.Итог("Вес");
			ИтогоОстатокКонецОбщаяМасса = ИтогоОстатокКонецОбщаяМасса + СтрОЗ.Итог("Вес");
			ОбластьОстатокКонец.Параметры.МассаЛигатуры = СтрОЗ.Итог("МассаЛигатуры");
			ИтогоОстатокКонецМассаЛигатуры = ИтогоОстатокКонецМассаЛигатуры + СтрОЗ.Итог("МассаЛигатуры");
			ОбластьОстатокКонец.Параметры.МассаХим = СтрОЗ.Итог("МассаХим");
			ИтогоОстатокКонецМассаХим = ИтогоОстатокКонецМассаХим + СтрОЗ.Итог("МассаХим");
			ОбластьОстатокКонец.Параметры.ВесДК = "";
			ОбластьОстатокКонец.Параметры.Количество = СтрОЗ.Итог("КоличествоОстаток");
			ИтогоОстатокКонецКоличество = ИтогоОстатокКонецКоличество + СтрОЗ.Итог("КоличествоОстаток");
			ОбластьОстатокКонец.Параметры.Стоимость = СтрОЗ.Итог("СуммаОценкиМакс") - СуммаК - СуммаМ;
			ИтогоОстатокКонецСтоимость = ИтогоОстатокКонецСтоимость + (СтрОЗ.Итог("СуммаОценкиМакс") - СуммаК - СуммаМ);
			//+МАН 01.12.25 Добавлено количество камней
			ОбластьОстатокКонец.Параметры.КоличествоДК = "";
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьОстатокКонец);
		Иначе
			ОтборНачало = Новый Структура;
			ОтборНачало.Вставить("Проба", Стр.Проба);
			
			СтрИтогК = ТЗИтог.Скопировать(ОтборНачало);
			
			Для каждого Стр Из СтрИтогК Цикл
				ОбластьОстатокКонец.Параметры.Проба = Стр.ВидВставки;
				ОбластьОстатокКонец.Параметры.ОбщаяМасса = "";
				ОбластьОстатокКонец.Параметры.МассаЛигатуры = "";
				ОбластьОстатокКонец.Параметры.МассаХим = "";
				ОбластьОстатокКонец.Параметры.ВесДК = Стр.Вес;
				ИтогоОстатокКонецВесДК = ИтогоОстатокКонецВесДК + Стр.Вес;
				ОбластьОстатокКонец.Параметры.Количество = Стр.КоличествоОстаток;
				ИтогоОстатокКонецКоличество = ИтогоОстатокКонецКоличество + Стр.КоличествоОстаток;
				ОбластьОстатокКонец.Параметры.Стоимость = Стр.СуммаОценкиМакс;
				ИтогоОстатокКонецСтоимость = ИтогоОстатокКонецСтоимость + Стр.СуммаОценкиМакс;
				//+МАН 01.12.25 Добавлено количество камней
				ОбластьОстатокКонец.Параметры.КоличествоДК = Стр.КоличествоКамней;
				ИтогоОстатокКонецКоличествоКамней = ИтогоОстатокКонецКоличествоКамней + Стр.КоличествоКамней;
				//-МАН
				ТабличныйДокумент.Вывести(ОбластьОстатокКонец);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ОбластьИтогоОстатокКонец.Параметры.ИтогоОбщаяМасса = ИтогоОстатокКонецОбщаяМасса;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоМассаЛигатуры = ИтогоОстатокКонецМассаЛигатуры;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоМассаХим = ИтогоОстатокКонецМассаХим;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоВесДК = ИтогоОстатокКонецВесДК;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоКоличество = ИтогоОстатокКонецКоличество;
	ОбластьИтогоОстатокКонец.Параметры.ИтогоСтоимость = ИтогоОстатокКонецСтоимость;
	//+МАН 01.12.25 Добавлено количество камней
	ОбластьИтогоОстатокКонец.Параметры.ИтогоКоличествоДК = ИтогоОстатокКонецКоличествоКамней;
	//-МАН
	ТабличныйДокумент.Вывести(ОбластьИтогоОстатокКонец);
	
	ОбластьПодвал.Параметры.ДатаСоставления = Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
	
	Ответственный              = ПараметрыСеанса.ТекущийСотрудник;	
	ФИООтветственного          = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли;
		
	ОбластьПодвал.Параметры.Ответственный = ФамилияОтветственного + " " + ИнициалыОтветственного;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

//+МАН 24.02.26 Сохранил прежнюю функцию без изменени. Посмотри Функцию выше. Там уже все исправлено и быстрей происходит обработка.
Функция ПечатьЖурналДвиженияДМ(ПараметрыОтчета) Экспорт 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	//ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЖурналДвиженияДМ";
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_ЖурналДвиженияДМ");
	
	ОбластьШапка                  = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьШапкаОстатокНачало     = Макет.ПолучитьОбласть("ОбластьШапкаОстатокНачало");
	ОбластьОстатокНачало          = Макет.ПолучитьОбласть("ОбластьОстатокНачало");	
	ОбластьИтогоОстатокНачало     = Макет.ПолучитьОбласть("ОбластьИтогоОстатокНачало");
	ОбластьШапкаПриход            = Макет.ПолучитьОбласть("ОбластьШапкаПриход");
	ОбластьПриход                 = Макет.ПолучитьОбласть("ОбластьПриход");
	ОбластьВставкаПриход          = Макет.ПолучитьОбласть("ОбластьВставкаПриход");
	ОбластьВставкаБриллиантПриход = Макет.ПолучитьОбласть("ОбластьВставкаБриллиантПриход");
	ОбластьИтогоПриход            = Макет.ПолучитьОбласть("ОбластьИтогоПриход");
	ОбластьШапкаРасход            = Макет.ПолучитьОбласть("ОбластьШапкаРасход");
	ОбластьРасход                 = Макет.ПолучитьОбласть("ОбластьРасход");
	ОбластьВставкаРасход          = Макет.ПолучитьОбласть("ОбластьВставкаРасход");
	ОбластьВставкаБриллиантРасход = Макет.ПолучитьОбласть("ОбластьВставкаБриллиантРасход");
	ОбластьИтогоРасход            = Макет.ПолучитьОбласть("ОбластьИтогоРасход");
	ОбластьШапкаОстатокКонец      = Макет.ПолучитьОбласть("ОбластьШапкаОстатокКонец");
	ОбластьОстатокКонец           = Макет.ПолучитьОбласть("ОбластьОстатокКонец");
	ОбластьИтогоОстатокКонец      = Макет.ПолучитьОбласть("ОбластьИтогоОстатокКонец");
	ОбластьПодвал                 = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	
	ОбластьШапка.Параметры.НомерЛомбарда = ПараметрыОтчета.Ломбард.НомерЛомбарда;
	
	СтруктураАдреса = фПрочитатьJSON(ПараметрыОтчета.Ломбард.КонтактнаяИнформация[0].Значение);
	ОбластьШапка.Параметры.АдресЛомбарда = СтруктураАдреса.value;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапкаОстатокНачало.Параметры.НачалоПериода = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
	ТабличныйДокумент.Вывести(ОбластьШапкаОстатокНачало);
				
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ПОМЕСТИТЬ ВТ_Объекты
		|ИЗ
		|	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Период, Ломбард = &Ломбард) КАК ЛБ_ОбъектыЗалогаОстатки
		|;
