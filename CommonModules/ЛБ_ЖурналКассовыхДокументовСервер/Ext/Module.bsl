			ОбластьДругиеБилеты.Параметры.СуммаПроцентов = "-";
			ОбластьДругиеБилеты.Параметры.Операция = " ";
			ИтогоВыданныеДругие = ИтогоВыданныеДругие + ТекущаяСтрока.Сумма;
