			ОбластьДругиеБилеты.Параметры.Операция = ОпределениеВидаОперации(ТекущаяСтрока.Регистратор, ТекущаяСтрока.Плательщик, ТекущаяСтрока.Залогодатель, ТекущаяСтрока.ВидОперации, ПереходНаОХ);
			ИтогоВозвращенныеДругие = ИтогоВозвращенныеДругие + ТекущаяСтрока.СуммаОплатыДолг;
	        ИтогоПроцентыДругие = ИтогоПроцентыДругие + ТекущаяСтрока.СуммаОплатыПроценты;
			//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
			СуммаВозвращеноИПроценты = ТекущаяСтрока.СуммаОплатыДолг + ТекущаяСтрока.СуммаОплатыПроценты;
			ОбластьДругиеБилеты.Параметры.СуммаВозвращеноИПроценты = ?(СуммаВозвращеноИПроценты > 0, СуммаВозвращеноИПроценты, "-");
			ИтогоВозвращеноИПроцентыДругие = ИтогоВозвращеноИПроцентыДругие + СуммаВозвращеноИПроценты;
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьДругиеБилеты);
		КонецЕсли;
	КонецЦикла;
	
	ОбластьИтогоДругиеБилеты.Параметры.ИтогоВыданныеДругие = ИтогоВыданныеДругие;
	ОбластьИтогоДругиеБилеты.Параметры.ИтогоВозвращенныеДругие = ИтогоВозвращенныеДругие;
	ОбластьИтогоДругиеБилеты.Параметры.ИтогоПроцентыДругие = ИтогоПроцентыДругие;
	//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
	ОбластьИтогоДругиеБилеты.Параметры.ИтогоВозвращеноИПроцентыДругие = ИтогоВозвращеноИПроцентыДругие;
	//-МАН
	ТабличныйДокумент.Вывести(ОбластьИтогоДругиеБилеты);
	
	ИтогоВыданные = ИтогоВыданныеСвои + ИтогоВыданныеДругие;
	ИтогоВозвращенные = ИтогоВозвращенныеСвои + ИтогоВозвращенныеДругие;
	ИтогоПроценты = ИтогоПроцентыСвои + ИтогоПроцентыДругие;
	//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
	ИтогоВозвращеноИПроценты = ИтогоВозвращеноИПроцентыСвои + ИтогоВозвращеноИПроцентыДругие;
	//-МАН
	
	ОбластьИтого.Параметры.ИтогоВыданные = ИтогоВыданные;
	ОбластьИтого.Параметры.ИтогоВозвращенные = ИтогоВозвращенные;
	ОбластьИтого.Параметры.ИтогоПроценты = ИтогоПроценты;
	//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
	ОбластьИтого.Параметры.ИтогоВозвращеноИПроценты = ИтогоВозвращеноИПроценты;
	//-МАН
	ТабличныйДокумент.Вывести(ОбластьИтого);
	
	ОбластьПодвал.Параметры.ИтогоВыданныеПрописью = ЧислоПрописью(ИтогоВыданные,"Л=ru_RU; ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж" );
	ОбластьПодвал.Параметры.ИтогоВозвращенныеПрописью = ЧислоПрописью(ИтогоВозвращенные,"Л=ru_RU; ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж" );
	ОбластьПодвал.Параметры.ИтогоПроцентыПропиьсю = ЧислоПрописью(ИтогоПроценты,"Л=ru_RU; ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж" );
	//+МАН 01.12.25 Вывод суммы по возвращенным и процентам
	ОбластьПодвал.Параметры.ИтогоВозвращеноИПроцентыПропиьсю = ЧислоПрописью(ИтогоВозвращеноИПроценты,"Л=ru_RU; ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж" );
	//-МАН
	
