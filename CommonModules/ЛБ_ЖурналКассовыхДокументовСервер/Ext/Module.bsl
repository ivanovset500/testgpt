		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_РеквизитыОбъектаЗалога.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба.Владелец КАК ПробаВладелец,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба.Проба КАК ПробаПроба,
		|	ЛБ_РеквизитыОбъектаЗалога.Вес КАК Вес,
		|	ЛБ_РеквизитыОбъектаЗалога.ВесЧистый КАК ВесЧистый,
		|	ЛБ_РеквизитыОбъектаЗалога.СуммаОценкиМакс КАК СуммаОценкиМакс,
		|	ЛБ_РеквизитыОбъектаЗалога.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ПОМЕСТИТЬ ВТ_Характеристики
		|ИЗ
		|	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога КАК ЛБ_РеквизитыОбъектаЗалога
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Характеристики.ПробаВладелец.Наименование КАК ПробаВладелец,
		|	ВТ_Характеристики.ПробаПроба КАК ПробаПроба,
		|	СУММА(ВТ_Объекты.КоличествоОстаток) КАК КоличествоОстаток,
		|	СУММА(ВТ_Характеристики.Вес) КАК Вес,
		|	СУММА(ВТ_Характеристики.ВесЧистый) КАК МассаЛигатуры,
		|	СУММА(ВТ_Характеристики.СуммаОценкиМакс) КАК СуммаОценкиМакс,
		|	СУММА(ВТ_Характеристики.ВесЧистый * (ВТ_Характеристики.ПробаПроба / 10 / 100)) КАК МассаХим,
		|	ВТ_Объекты.ОбъектЗалога КАК ОбъектЗалога,
		|	ВТ_Объекты.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ПОМЕСТИТЬ ВТ_ИтогОбъекты
		|ИЗ
		|	ВТ_Объекты КАК ВТ_Объекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Характеристики КАК ВТ_Характеристики
		|		ПО ВТ_Объекты.ОбъектЗалога = ВТ_Характеристики.ОбъектЗалога
		|			И ВТ_Объекты.ЗалоговыйБилет = ВТ_Характеристики.ЗалоговыйБилет
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Характеристики.ПробаПроба,
		|	ВТ_Объекты.ОбъектЗалога,
		|	ВТ_Объекты.ЗалоговыйБилет,
		|	ВТ_Характеристики.ПробаВладелец.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ВставкиОбъектаЗалога.ОбъектЗалога КАК ОбъектЗалога,
