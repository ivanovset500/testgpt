		|	ВТ_ИтогОбъекты.Артикул,
		|	ВТ_ИтогОбъекты.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогОбъекты.ОбъектЗалога,
		|	ВТ_ИтогОбъекты.Проба
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	""Вставка"",
		|	"""",
		|	"""",
		|	СУММА(0),
		|	СУММА(ВТ_ИтогКамни.Вес),
		|	СУММА(0),
		|	СУММА(0),
		|	ВТ_ИтогКамни.СуммаОценки,
		|	ВТ_ИтогКамни.ВидВставки,
		|	ВТ_ИтогКамни.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогКамни.ОбъектЗалога,
		|	"""",
		|	"""",
		|	СУММА(ВТ_ИтогКамни.КоличествоКамней),
		|	ЗНАЧЕНИЕ(Справочник.ЛБ_Пробы.ПустаяСсылка)
		|ИЗ
		|	ВТ_ИтогКамни КАК ВТ_ИтогКамни
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИтогКамни.ВидВставки,
		|	ВТ_ИтогКамни.СуммаОценки,
		|	ВТ_ИтогКамни.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогКамни.ОбъектЗалога
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	""Вставка"",
		|	ВТ_ИтогДопМеталлы.ПробаВладелецОбъект,
		|	ВТ_ИтогДопМеталлы.ПробаПробаОбъект,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(ВТ_ИтогДопМеталлы.МассаЛигатуры),
		|	СУММА(ВТ_ИтогДопМеталлы.МассаХим),
		|	СУММА(ВТ_ИтогДопМеталлы.СуммаОценки),
		|	"""",
		|	ВТ_ИтогДопМеталлы.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогДопМеталлы.ОбъектЗалога,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	СУММА(0),
		|	ВТ_ИтогДопМеталлы.Проба
		|ИЗ
		|	ВТ_ИтогДопМеталлы КАК ВТ_ИтогДопМеталлы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ИтогДопМеталлы.ОбъектЗалога,
		|	ВТ_ИтогДопМеталлы.ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецОбъект,
		|	ВТ_ИтогДопМеталлы.ПробаПробаОбъект,
		|	ВТ_ИтогДопМеталлы.ПробаВладелецМеталл,
		|	ВТ_ИтогДопМеталлы.ПробаПробаМеталл,
		|	ВТ_ИтогДопМеталлы.Проба
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ОбъектЗалога,
		|	ВидВставки,
		|	Артикул";
	
	Запрос.УстановитьПараметр("ВидКамня", ВидыКамней);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчета.Ломбард);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	
	//+МАН 24.02.26 Заявка 3269
	ВыборкаПоПакетно = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	ТЗИтогКамни = ВыборкаПоПакетно[4].Выгрузить();
	ТЗИтогДопМеталлы = ВыборкаПоПакетно[6].Выгрузить();
	//-МАН
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИтогоПриходОбщаяМасса = 0;
	ИтогоПриходМассаЛигатуры = 0;
	ИтогоПриходМассаХим = 0;
	ИтогоПриходВесДК = 0;
	ИтогоПриходКоличество = 0;
	ИтогоПриходСтоимость = 0;
	НомерПП = 1;
	ШапкаПриход = Ложь;
	//+МАН 01.12.25 Добавлено количество камней
	ИтогоПриходКоличествоКамней = 0;
	//-МАН
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ШапкаПриход Тогда 
			Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
				ОбластьШапкаПриход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
			Иначе
				ОбластьШапкаПриход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD") + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьШапкаПриход);
			ШапкаПриход = Истина;
		КонецЕсли;
		
		Если Выборка.Артикул = "Вставка" И ЗначениеЗаполнено(Выборка.ВидВставки) Тогда
			ОбластьВставкаБриллиантПриход.Параметры.Проба = Выборка.ВидВставки;
			ОбластьВставкаБриллиантПриход.Параметры.ВесДК = Выборка.Вес;
			ИтогоПриходВесДК = ИтогоПриходВесДК + Выборка.Вес;
			ОбластьВставкаБриллиантПриход.Параметры.Количество = Выборка.КоличествоПриход;
			ИтогоПриходКоличество = ИтогоПриходКоличество + Выборка.КоличествоПриход;
			ОбластьВставкаБриллиантПриход.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
			ИтогоПриходСтоимость = ИтогоПриходСтоимость + Выборка.СуммаОценкиМакс;
			//+МАН 01.12.25 Добавлено количество камней
			ИтогоПриходКоличествоКамней = ИтогоПриходКоличествоКамней + Выборка.КоличествоКамней;
			ОбластьВставкаБриллиантПриход.Параметры.КоличествоДК = Выборка.КоличествоКамней;
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьВставкаБриллиантПриход);
		ИначеЕсли Выборка.Артикул = "Вставка" И Не ЗначениеЗаполнено(Выборка.ВидВставки) Тогда
			ПробаОбъект = Строка(Выборка.ПробаВладелец) + Строка(Выборка.ПробаПроба);
			ПробаМеталл = Строка(Выборка.ПробаВладелецМеталл) + Строка(Выборка.ПробаПробаМеталл);
			Если ПробаОбъект <> ПробаМеталл Тогда
			ОбластьВставкаПриход.Параметры.Проба = Строка(Выборка.ПробаВладелецМеталл) + " " + Строка(Выборка.ПробаПробаМеталл);
			ОбластьВставкаПриход.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры;
			ИтогоПриходМассаЛигатуры = ИтогоПриходМассаЛигатуры + Выборка.МассаЛигатуры;
			ОбластьВставкаПриход.Параметры.МассаХим = Выборка.МассаХим;
			ИтогоПриходМассаХим = ИтогоПриходМассаХим + Выборка.МассаХим;
			ОбластьВставкаПриход.Параметры.ВесДК = "";
			ОбластьВставкаПриход.Параметры.Стоимость = Выборка.СуммаОценкиМакс;
			ИтогоПриходСтоимость = ИтогоПриходСтоимость + Выборка.СуммаОценкиМакс;
			//+МАН 01.12.25 Добавлено количество камней
			ОбластьВставкаПриход.Параметры.КоличествоДК = "";
			//-МАН
			ТабличныйДокумент.Вывести(ОбластьВставкаПриход);
			КонецЕсли;
		Иначе
			
		//+МАН 24.02.26 Заявка 3269
		Отбор = Новый Структура;
		Отбор.Вставить("ОбъектЗалога", Выборка.ОбъектЗалога);
		
		ТЗСтрокК = ТЗИтогКамни.Скопировать(Отбор, "СуммаОценки");
		ТЗСтрокМ = ТЗИтогДопМеталлы.Скопировать(Отбор);
		
		СуммаДопМ = 0;
		Для каждого Стр Из ТЗСтрокМ Цикл
			Если Выборка.Проба <> Стр.Проба Тогда
				СуммаДопМ = СуммаДопМ + Стр.СуммаОценки;
			КонецЕсли;
		КонецЦикла;
		
		ИтогоСумма = Выборка.СуммаОценкиМакс - ТЗСтрокК.Итог("СуммаОценки") - СуммаДопМ;
		//-МАН
			
		ОбластьПриход.Параметры.НомерПП = НомерПП;
		НомерПП = НомерПП + 1;
		ОбластьПриход.Параметры.Наименование = Выборка.ОбъектЗалога;
		ОбластьПриход.Параметры.НомерЗБ = Выборка.Артикул;
		ОбластьПриход.Параметры.Проба = Строка(Выборка.ПробаВладелец) + " " + Строка(Выборка.ПробаПроба);
		ОбластьПриход.Параметры.ОбщаяМасса = Выборка.Вес * Выборка.КоличествоПриход;
		ИтогоПриходОбщаяМасса = ИтогоПриходОбщаяМасса + (Выборка.Вес * Выборка.КоличествоПриход);
		ОбластьПриход.Параметры.МассаЛигатуры = Выборка.МассаЛигатуры * Выборка.КоличествоПриход;
		ИтогоПриходМассаЛигатуры = ИтогоПриходМассаЛигатуры + (Выборка.МассаЛигатуры * Выборка.КоличествоПриход);
		ОбластьПриход.Параметры.МассаХим = Выборка.МассаХим * Выборка.КоличествоПриход;
		ИтогоПриходМассаХим = ИтогоПриходМассаХим + (Выборка.МассаХим * Выборка.КоличествоПриход);
		ОбластьПриход.Параметры.ВесДК = "";
		ОбластьПриход.Параметры.Количество = Выборка.КоличествоПриход;
		ИтогоПриходКоличество = ИтогоПриходКоличество + Выборка.КоличествоПриход;
		//+МАН 24.02.26
		//ОбластьПриход.Параметры.Стоимость = Выборка.СуммаОценкиМакс * Выборка.КоличествоПриход;
		//ИтогоПриходСтоимость = ИтогоПриходСтоимость + (Выборка.СуммаОценкиМакс * Выборка.КоличествоПриход);
		ОбластьПриход.Параметры.Стоимость = ИтогоСумма * Выборка.КоличествоПриход;
		ИтогоПриходСтоимость = ИтогоПриходСтоимость + (ИтогоСумма * Выборка.КоличествоПриход);
		//-МАН
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьПриход.Параметры.КоличествоДК = "";
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьПриход);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ИтогоПриходКоличество > 0 Тогда	
		Если НачалоДня(ПараметрыОтчета.НачалоПериода) = НачалоДня(ПараметрыОтчета.КонецПериода) Тогда
			ОбластьИтогоПриход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD");
		Иначе
			ОбластьИтогоПриход.Параметры.Период = Формат(ПараметрыОтчета.НачалоПериода, "ДЛФ=DD") + "-" + Формат(ПараметрыОтчета.КонецПериода, "ДЛФ=DD");
		КонецЕсли;
		ОбластьИтогоПриход.Параметры.ИтогоОбщаяМасса = ИтогоПриходОбщаяМасса;
		ОбластьИтогоПриход.Параметры.ИтогоМассаЛигатуры = ИтогоПриходМассаЛигатуры;
		ОбластьИтогоПриход.Параметры.ИтогоМассаХим = ИтогоПриходМассаХим;
		ОбластьИтогоПриход.Параметры.ИтогоВесДК = ИтогоПриходВесДК;
		ОбластьИтогоПриход.Параметры.ИтогоКоличество = ИтогоПриходКоличество;
		ОбластьИтогоПриход.Параметры.ИтогоСтоимость = ИтогоПриходСтоимость;
		//+МАН 01.12.25 Добавлено количество камней
		ОбластьИтогоПриход.Параметры.ИтогоКоличествоДК = ИтогоПриходКоличествоКамней;
		//-МАН
		ТабличныйДокумент.Вывести(ОбластьИтогоПриход);
	КонецЕсли;
	
	//Расход
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога.Код КАК ОбъектЗалогаКод,
		|	ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
		|	СУММА(ЛБ_ОбъектыЗалогаОбороты.КоличествоРасход) КАК КоличествоРасход,
		|	ЛБ_ОбъектыЗалогаОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
		|	ЛБ_ОбъектыЗалогаОбороты.Регистратор.НакладнаяНаОтгрузку.ПредставлениеНомераНакладной КАК РегистраторНакладнаяНаОтгрузкуНомер
		|ПОМЕСТИТЬ ВТ_Объекты
		|ИЗ
		|	РегистрНакопления.ЛБ_ОбъектыЗалога.Обороты(&НачалоПериода, &КонецПериода, Регистратор, Ломбард = &Ломбард) КАК ЛБ_ОбъектыЗалогаОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки КАК ЛБ_ОбъектыЗалогаОстатки
		|		ПО ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога = ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			КОГДА ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток = 0
		|				ТОГДА ИСТИНА
		|		КОНЕЦ
		|	И ЛБ_ОбъектыЗалогаОбороты.КоличествоРасход > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ОбъектыЗалогаОбороты.ЗалоговыйБилет,
		|	ЛБ_ОбъектыЗалогаОбороты.Регистратор.НакладнаяНаОтгрузку.ПредставлениеНомераНакладной,
		|	ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога,
		|	ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_РеквизитыОбъектаЗалога.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба.Владелец КАК ПробаВладелец,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба.Проба КАК ПробаПроба,
		|	ЛБ_РеквизитыОбъектаЗалога.Вес КАК Вес,
		|	ЛБ_РеквизитыОбъектаЗалога.ВесЧистый КАК ВесЧистый,
		|	ЛБ_РеквизитыОбъектаЗалога.СуммаОценкиМакс КАК СуммаОценкиМакс,
		|	ЛБ_РеквизитыОбъектаЗалога.Артикул КАК Артикул,
		|	ЛБ_РеквизитыОбъектаЗалога.ЗалоговыйБилет.НомерЗалоговогоБилета КАК ЗалоговыйБилетНомерЗалоговогоБилета,
		|	ЛБ_РеквизитыОбъектаЗалога.ЗалоговыйБилет КАК ЗалоговыйБилет,
		|	ЛБ_РеквизитыОбъектаЗалога.Проба КАК Проба
		|ПОМЕСТИТЬ ВТ_Характеристики
		|ИЗ
		|	ВТ_Объекты КАК ВТ_Объекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&КонецПериода, ) КАК ЛБ_РеквизитыОбъектаЗалога
		|		ПО ВТ_Объекты.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалога.ОбъектЗалога
		|;
