Функция СообщитьЕслиСтрокаНеправильная(Строка, НаименованиеПоля = "Строка") Экспорт
	
	Сообщение = СтрШаблон("Строка ""%1"" не должна содержать только цифры или некорректные символы", НаименованиеПоля);
	
	ТолькоЦифрыВСтроке = ТолькоЦифрыВСтроке(Строка); 
	Если ТолькоЦифрыВСтроке Тогда
		//Сообщение = НаименованиеПоля + " не может содержать только цифры!";
		Возврат Сообщение;
	КонецЕсли;
	// ++ Сербаев 30.05.2023 Разрешаем вводить латиницу а при записи проверяем на ввод только кирилицы
	//ЕстьЛатиницаИКирилица = ЕстьЛатиницаИКирилицаВСтроке(Строка);
	//Если ЕстьЛатиницаИКирилица Тогда
	//	Сообщение = СтрШаблон("Строка ""%1"" не может одновременно содержать буквы кириллицы и латиницы!", НаименованиеПоля);
	//	Возврат Сообщение;
	//КонецЕсли;
	// -- Сербаев 30.05.2023
	
	// ++ Сербаев 23.05.2023
	СтрокаБезПробела = СтрЗаменить(Строка, " ", "");
	
	//ТолькоРазрешенныеСимволы = ПроверитьСтроку(Строка,"[A-Za-zА-Яа-я0-9-]+");
	ТолькоРазрешенныеСимволы = ПроверитьСтроку(СтрокаБезПробела,"[A-Za-zА-Яа-яёЁ0-9-]+");
	// -- Сербаев 23.05.2023
	
	Если Не ТолькоРазрешенныеСимволы Тогда
		//Сообщение = НаименованиеПоля + " должно содержать только кирилицу (или латиницу), тире, цифры!";
		Возврат Сообщение;
	КонецЕсли;
	
	// ++ Сербаев 29.05.2023
	Если СтрДлина(СтрокаБезПробела) > 0 Тогда
	    СтрокаБезБукв = СтрокаНеСодержитБукв(СтрокаБезПробела);
	КонецЕсли;
	
	Если СтрокаБезБукв Тогда
	    Возврат Сообщение;
	КонецЕсли;
	// -- Сербаев 29.05.2023
	
	Возврат "";
	
КонецФункции

Процедура СообщитьПользователю(
		Знач ТекстСообщенияПользователю,
		Знач КлючДанных = Неопределено,
		Знач Поле = "",
		Знач ПутьКДанным = "",
		Отказ = Ложь) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	
	ЭтоОбъект = Ложь;
	
#Если НЕ ТонкийКлиент И НЕ ВебКлиент И НЕ МобильныйКлиент Тогда
	Если КлючДанных <> Неопределено
	   И XMLТипЗнч(КлючДанных) <> Неопределено Тогда
		ТипЗначенияСтрокой = XMLТипЗнч(КлючДанных).ИмяТипа;
		ЭтоОбъект = СтрНайти(ТипЗначенияСтрокой, "Object.") > 0;
	КонецЕсли;
#КонецЕсли
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
