&НаСервере
Функция ПроверитьПоПеречням(Дата, ЗБ) Экспорт
	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК Статус
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период УБЫВ"; 
	Запрос.УстановитьПараметр("Залогодатель", ЗБ.Залогодатель);  
	Запрос.УстановитьПараметр("Дата", Дата); 	

	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.Террористы);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);  
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			Возврат Истина;
		ИначеЕсли Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
			Возврат Ложь;
 		КонецЕсли;   
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.МВК);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			Возврат Истина;
		ИначеЕсли Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
			Возврат Ложь;
		КонецЕсли;                        
	Иначе
		Возврат Ложь;
	КонецЕсли;	

	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ООН);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;  
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
