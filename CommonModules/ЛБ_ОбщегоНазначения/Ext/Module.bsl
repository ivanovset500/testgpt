&НаСервере
Процедура ЗаписатьВРегистр(Дата, Залогодатель, ВидСовпадения, СтрокаСовпадения, ТребуетПроверки) Экспорт //ВидПеречня, 
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Если ТекПользователь.ЭтоЛомбард Тогда   
		ТекЛомбард = ПараметрыСеанса.ТекущийЛомбард;
	Иначе
		ТекЛомбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
	КонецЕсли;	     
	
	НаборЗаписей = РегистрыСведений.ЛБ_ЧастичныеСовпаденияПоПеречням.СоздатьНаборЗаписей();
	НаваяЗапись = НаборЗаписей.Добавить();
	НаваяЗапись.Период = Дата;
	НаваяЗапись.Залогодатель = Залогодатель;
	НаваяЗапись.ВидСовпадения = ВидСовпадения;
	//НаваяЗапись.ВидПеречня = ВидПеречня;
	НаваяЗапись.Ломбард = ТекЛомбард;
	НаваяЗапись.ТребуетПроверки = ТребуетПроверки;
	НаваяЗапись.Разрешено = Ложь;
	НаваяЗапись.Запрещено = Ложь;
	НаваяЗапись.СотрудникОбнаружил = ПараметрыСеанса.ТекущийСотрудник;
	НаваяЗапись.Фамилия = Залогодатель.Фамилия;
	НаваяЗапись.Имя = Залогодатель.Имя;
	НаваяЗапись.Отчество = Залогодатель.Отчество;
	НаваяЗапись.СтрокаСовпадения = СтрокаСовпадения;
	
	НаборЗаписей.Записать(Ложь);
	
КонецПроцедуры

&НаСервере
Функция НайтиЗаписьВРегистре(Дата, Залогодатель) Экспорт
	
	СтруктураВозврата = Новый Структура("Количество, ТребуетПроверки, Запрещено, Разрешено", 0, Ложь, Ложь, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПоследних.Залогодатель КАК Залогодатель,
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПоследних.ТребуетПроверки КАК ТребуетПроверки,
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПоследних.Запрещено КАК Запрещено,
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПоследних.Разрешено КАК Разрешено
		|ИЗ
		|	РегистрСведений.ЛБ_ЧастичныеСовпаденияПоПеречням.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		СтруктураВозврата.Количество = РезультатЗапроса.Количество();
		СтруктураВозврата.ТребуетПроверки = РезультатЗапроса.ТребуетПроверки;
		СтруктураВозврата.Запрещено = РезультатЗапроса.Запрещено;
		СтруктураВозврата.Разрешено = РезультатЗапроса.Разрешено;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ПроверитьИНН(ИНН, СписокПеречней)
	Дата = ТекущаяДата();
	
	//+МАН 17.11.25
	СтруктураВозврата = Новый Структура("Совпадение, Результат", Ложь);
	//-МАН
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса("ИНН");
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидПеречня", СписокПеречней);
	
	РезультатИНН = Запрос.Выполнить().Выбрать();
	
	Если РезультатИНН.Следующий() Тогда
		//+МАН 17.11.25
		СтруктураВозврата.Совпадение = Истина;
		СтруктураВозврата.Результат = РезультатИНН;
		//-МАН
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
КонецФункции

&НаСервере
Функция СравнитьДанныеКлиентов(СтруктураЗалогодатель, СтрокаВыборки, СписокПеречней)
	
	РождениеСовпадает = Ложь;
	ДокументСовпадает = Ложь;
	ИННСовпадает = Ложь;
	
	Дата = ТекущаяДата();
	
	СтруктураВозврата = Новый Структура("Совпадение, Текст", Ложь, "");
	
	Если ЗначениеЗаполнено(СтруктураЗалогодатель.ДатаРождения) И СтруктураЗалогодатель.ТаблицаДокументов.Количество() > 0 Тогда
		
		РождениеСовпадает = ПроверкаДатыРождения(СтруктураЗалогодатель.ДатаРождения, СтрокаВыборки.ДатаРождения, СтрокаВыборки.ГодРождения);
		
		Запрос = Новый Запрос;
		Запрос.Текст = НайтиДокументыВПеречне("ИД");
		
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("ВидПеречня", СписокПеречней);
		Запрос.УстановитьПараметр("ИД", СтрокаВыборки.ИД);
		
		ТаблицаДокументовСубъекта = Запрос.Выполнить().Выгрузить();
		
		Для каждого СтрДок Из СтруктураЗалогодатель.ТаблицаДокументов Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ДокументНомер", СокрЛП(СтрДок.ДокументНомер));
			Отбор.Вставить("ДокументСерия", СокрЛП(СтрДок.ДокументСерия));
			СтрокиД = ТаблицаДокументовСубъекта.НайтиСтроки(Отбор);
			
			Если СтрокиД.Количество() <> 0 Тогда
				ДокументСовпадает = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если РождениеСовпадает И ДокументСовпадает Тогда
			СтруктураВозврата.Совпадение = Истина;
			СтруктураВозврата.Текст = "Дата рождения и ДУЛ";
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураЗалогодатель.ДатаРождения) Тогда
		
		РождениеСовпадает = ПроверкаДатыРождения(СтруктураЗалогодатель.ДатаРождения, СтрокаВыборки.ДатаРождения, СтрокаВыборки.ГодРождения);
		
		Если РождениеСовпадает Тогда
			СтруктураВозврата.Совпадение = Истина;
			СтруктураВозврата.Текст = "Дата рождения";
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураЗалогодатель.ТаблицаДокументов.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = НайтиДокументыВПеречне("ИД");
		
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("ВидПеречня", СписокПеречней);
		Запрос.УстановитьПараметр("ИД", СтрокаВыборки.ИД);
		
		ТаблицаДокументовСубъекта = Запрос.Выполнить().Выгрузить();
		
		Для каждого СтрДок Из СтруктураЗалогодатель.ТаблицаДокументов Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ДокументНомер", СокрЛП(СтрДок.ДокументНомер));
			Отбор.Вставить("ДокументСерия", СокрЛП(СтрДок.ДокументСерия));
			СтрокиД = ТаблицаДокументовСубъекта.НайтиСтроки(Отбор);
			
			Если СтрокиД.Количество() <> 0 Тогда
				ДокументСовпадает = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ДокументСовпадает Тогда
			СтруктураВозврата.Совпадение = Истина;
			СтруктураВозврата.Текст = "ДУЛ";
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
КонецФункции

&НаСервере
Функция ПроверкаДатыРождения(ДатаРождения, ДатаРожденияПеречень, ГодРождения)
	
	ДатаРождениеСовпадает = Ложь;
	ГодРождениеСовпадает = Ложь;
	
	Если НЕ ПустаяСтрока(ДатаРожденияПеречень) Тогда
		ДатаРождениеСовпадает = ДатаРождения = ДатаРожденияПеречень;
	ИначеЕсли НЕ ПустаяСтрока(ГодРождения) Тогда
		ГодРождениеСовпадает = Год(ДатаРождения) = ГодРождения;
	КонецЕсли;

	Возврат (ДатаРождениеСовпадает ИЛИ ГодРождениеСовпадает);
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапроса(ПараметрЗапроса)

	Текст = "ВЫБРАТЬ
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаПеречня КАК ДатаПеречня,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаВключенияВПеречень КАК ДатаВключенияВПеречень,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ИД КАК ИД,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Наименование КАК Наименование,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.НаименованиеЛат КАК НаименованиеЛат,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаРождения КАК ДатаРождения,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ГодРождения КАК ГодРождения,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ИНН КАК ИНН,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Статус КАК Статус,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ВидПеречня КАК ВидПеречня,
	|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.КодОтказа КАК КодОтказа
	|ИЗ
	|	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц.СрезПоследних(
	|			&Дата,
	|			ВидПеречня В (&ВидПеречня)";
	
	Если ПараметрЗапроса = "Наименование" Тогда
		Текст = Текст + Символы.ПС + "И Наименование = &Наименование) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "НаименованиеЛат" Тогда
		Текст = Текст + Символы.ПС + "И НаименованиеЛат = &Наименование) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "ТехническоеНаименование" Тогда
		Текст = Текст + Символы.ПС + "И ТехническоеНаименование = &Наименование) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "ИД" Тогда
		Текст = Текст + Символы.ПС + "И ИД = &ИД) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "ИНН" Тогда
		Текст = Текст + Символы.ПС + "И ИНН = &ИНН) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "ФИ" Тогда
		Текст = Текст + Символы.ПС + "И Фамилия = &Фамилия
				|	И Имя = &Имя) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "ФО" Тогда
		Текст = Текст + Символы.ПС + "И Фамилия = &Фамилия
				|	И Отчество = &Отчество) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	ИначеЕсли ПараметрЗапроса = "ИО" Тогда
		Текст = Текст + Символы.ПС + "И Имя = &Имя
				|	И Отчество = &Отчество) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних";
	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС + "СГРУППИРОВАТЬ ПО
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаПеречня,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ИД,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаВключенияВПеречень,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Наименование,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.НаименованиеЛат,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаРождения,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ГодРождения,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ИНН,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ЮридическоеФизическоеЛицо,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Статус,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ВидПеречня,
				|	ЛБ_ПереченьНежелательныхЛицСрезПоследних.КодОтказа
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДатаПеречня УБЫВ";
	
	Возврат Текст;
КонецФункции

