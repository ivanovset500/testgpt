&НаСервере
Функция СотрудникЯвляетсяНачальникомОтделения(Сотрудник, НаДату) Экспорт
	Если ЗначениеЗаполнено(Сотрудник.Должность) и Сотрудник.Должность.ЯвляетсяНачальникомОтделения Тогда
		Возврат Истина;
	КонецЕсли;
	// Проверим в совмещениях
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ЗаместителиСрезПоследних.СотрудникКогоЗамещают КАК СотрудникКогоЗамещают
	               |ИЗ
	               |	РегистрСведений.ЛБ_Заместители.СрезПоследних(
	               |			&НаДату,
	               |			Заместитель = &Сотрудник
	               |				И ОкончаниеЗамещения >= &НаДату) КАК ЛБ_ЗаместителиСрезПоследних";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Если ЗначениеЗаполнено(Выборка.СотрудникКогоЗамещают) и Выборка.СотрудникКогоЗамещают.Должность.ЯвляетсяНачальникомОтделения Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция СотрудникЯвляетсяНачальникомОтделенияБезСовмещения(Сотрудник, НаДату) Экспорт
	Если ЗначениеЗаполнено(Сотрудник.Должность) и Сотрудник.Должность.ЯвляетсяНачальникомОтделения Тогда
		Возврат Истина;
	КонецЕсли;
		
	Возврат Ложь;
	
КонецФункции


//+МАН 24.10.25 Проверка по перечням
#Область ПроверкаПоПеречням

&НаСервере                                                        
Функция ПроверитьКлиентаПоПеречням(Залогодатель) Экспорт
	//РезультатПроверки = Ложь; 
	РезультатПроверки = Новый Структура("Совпадение, Текст, ВидСовпадения", Ложь, "", "Полное");
	
	СовпадениеИНН = Ложь;
	
	Дата =ТекущаяДата();
	
	СписокПеречней = Новый СписокЗначений;
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);  
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	СтруктураЗалогодатель = Новый Структура("Наименование, НаименованиеЛат, ТехническоеНаименование, ДатаРождения, ЮридическоеФизическоеЛицо, ИНН, ТаблицаДокументов");

	ТекстТеррорист = "Клиент найден в перечне террористов. Операции с клиентом запрещены!";
	ТекстФРОМУ = "Клиент найден в перечне ФРОМУ. Операции с клиентом запрещены!";
	ТекстМВК = "Клиент найден в списке МВК. Операции с клиентом запрещены!";
	ТекстООН = "Клиент найден в перечне ООН. Операции с клиентом запрещены!";
	
	ТекстИНН = "Совпал ИНН";
 	ТекстФИО = "Совадение по ФИО, ";
	ТекстФИОЛат = "Совадение по ФИО в латинском написании, ";
	ТекстФИОТех = "Совадение по ФИО в равнозначном написании, ";
	ТекстФИОДр = "Совадение по ФИО другие наименования, ";
	ТекстФИОДрЛат = "Совадение по ФИО другие наименования в латинском написании, ";
	ТекстФИОДрТех = "Совадение по ФИО другие наименования в равнозначном написании, ";
	
	//ТекстДокТеррорист = "Документ клиента найден в перечне террористов. Операции с клиентом запрещены!";
	//ТекстДокФРОМУ = "Документ клиента найден в перечне ФРОМУ. Операции с клиентом запрещены!";
	//ТекстДокМВК = "Документ клиента найден в списке МВК. Операции с клиентом запрещены!";
	//ТекстДокООН = "Документ клиента найден в перечне ООН. Операции с клиентом запрещены!";
	
	ТекстДок = "Документ клиента найден в перечне. Операции с клиентом запрещены!";
	ТекстЧастьФИДР = "Частичное совпадение по Фамилии, Имени и дате рождения";
	ТекстЧастьФОДР = "Частичное совпадение по Фамилии, Отчеству и дате рождения";
	ТекстЧастьИОДР = "Частичное совпадение по Имени, Отчеству и дате рождения";
	ТекстЧастьДрНаимФИДР = "Частичное совпадение по другим наименованиям Фамилии, Имени и дате рождения";
	ТекстЧастьДрНаимФОДР = "Частичное совпадение по другим наименованиям Фамилии, Отчеству и дате рождения";
	ТекстЧастьДрНаимИОДР = "Частичное совпадение по другим наименованиям Имени, Отчеству и дате рождения";
	ТекстТребуетпроверки = "Было частичное совпадение. Проверка еще не выполнена";
	ТекстЗапрещено = "После проверки частичного совпадения залогодателю выставлен запрет";

	ШаблонСтроки = "%1|%2|%3|%4|%5"; //Перечень наименований или других наименований, Кто, ИД, ДатаРождения, Вид перечня
	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК СтатусКлиентаВПеречне,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Клиент
	               |				И ВидПеречня В (&ВидПеречня)) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ"; 

	Запрос.УстановитьПараметр("Клиент", Залогодатель);  
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидПеречня", СписокПеречней);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда     
		Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
			Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
				Сообщить(ТекстТеррорист, СтатусСообщения.Важное);
				
				РезультатПроверки.Текст = ТекстТеррорист;
				РезультатПроверки.Совпадение = Истина;
			ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
				Сообщить(ТекстФРОМУ, СтатусСообщения.Важное);
				
				РезультатПроверки.Текст = ТекстФРОМУ;
				РезультатПроверки.Совпадение = Истина;
			ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
				Сообщить(ТекстМВК, СтатусСообщения.Важное);

				РезультатПроверки.Текст = ТекстМВК;
				РезультатПроверки.Совпадение = Истина;
			ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
				Сообщить(ТекстООН, СтатусСообщения.Важное);
				
				РезультатПроверки.Текст = ТекстООН;
				РезультатПроверки.Совпадение = Истина;	
			КонецЕсли;	  
		КонецЕсли;	
	КонецЕсли;     
	
	Если РезультатПроверки.Совпадение Тогда
		Возврат РезультатПроверки;
		//Возврат НЕ РезультатПроверки.Совпадение;
	КонецЕсли;
	
	Если НЕ РезультатПроверки.Совпадение Тогда
		Запрос.Текст = "ВЫБРАТЬ
			|	ЛБ_Залогодатели.Ссылка КАК Клиент,
			|	ЛБ_Залогодатели.Наименование КАК Наименование,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
			|	ЛБ_АнкетаЗалогодателяСрезПоследних.ИНН КАК ИНН,
			|	ЛБ_АнкетаЗалогодателяСрезПоследних.ТипФизЛица КАК ЮридическоеФизическоеЛицо,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия_А КАК Фамилия_А,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя_А КАК Имя_А,
			|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество_А КАК Отчество_А
			|ИЗ
			|	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
			|		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних КАК ЛБ_АнкетаЗалогодателяСрезПоследних
			|		ПО (ЛБ_АнкетаЗалогодателяСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
			|ГДЕ
			|	ЛБ_Залогодатели.Ссылка = &Клиент";
		
		ВыборкаЗалогодатель = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаЗалогодатель.Следующий() Тогда
			Если ЗначениеЗаполнено(ВыборкаЗалогодатель.ИНН) Тогда
				//СовпадениеИНН = ПроверитьИНН(ВыборкаЗалогодатель.ИНН, СписокПеречней);
				СтруктураПроверкиИНН = ПроверитьИНН(ВыборкаЗалогодатель.ИНН, СписокПеречней);
				
				//Если СовпадениеИНН Тогда
				Если СтруктураПроверкиИНН.Совпадение Тогда
					Сообщить(ТекстИНН);
					
					РезультатПроверки.Текст = ТекстИНН;
					РезультатПроверки.Совпадение = СтруктураПроверкиИНН.Совпадение;
					
					//+МАН 17.11.25
					ЗаписатьСовпадениеВРегистр(Залогодатель, СтруктураПроверкиИНН.Результат, Дата);
					//-МАН
					
					Возврат РезультатПроверки;
					//Возврат НЕ СовпадениеИНН;
				КонецЕсли;
			КонецЕсли;
			
			Запрос.Текст = "ВЫБРАТЬ
				|	ЛБ_ДокументыЗалогодателя.Владелец КАК Клиент,
				|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
				|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
				|	ЛБ_ДокументыЗалогодателя.Наименование КАК Наименование
				|ИЗ
				|	Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
				|		ПО (ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка)
				|ГДЕ
				|	ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
				|	И ЛБ_ДокументыЗалогодателя.Владелец = &Клиент";
				
			Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
			
			ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
			
			СтруктураЗалогодатель.Наименование = ВРег(СокрЛП(Залогодатель.Наименование));
			НаименованиеЛат = СокрЛП(ВыборкаЗалогодатель.Фамилия_А) + ?(ПустаяСтрока(ВыборкаЗалогодатель.Имя_А), "", " " + СокрЛП(ВыборкаЗалогодатель.Имя_А)) + ?(ПустаяСтрока(ВыборкаЗалогодатель.Отчество_А), "", " " + СокрЛП(ВыборкаЗалогодатель.Отчество_А));
			СтруктураЗалогодатель.НаименованиеЛат = ВРег(НаименованиеЛат);
			СтруктураЗалогодатель.ТехническоеНаименование = ВРег(СокрЛП(Залогодатель.ТехническоеНаименование));
			СтруктураЗалогодатель.ДатаРождения = ВыборкаЗалогодатель.ДатаРождения;
			СтруктураЗалогодатель.ЮридическоеФизическоеЛицо = ВыборкаЗалогодатель.ЮридическоеФизическоеЛицо; 
			СтруктураЗалогодатель.ИНН = СокрЛП(ВыборкаЗалогодатель.ИНН);
			СтруктураЗалогодатель.ТаблицаДокументов = ТаблицаДокументов;
			
			ЗапросНежЛиц = Новый Запрос;
			ЗапросНежЛиц.Текст = ПолучитьТекстЗапроса("Наименование");
			
			ЗапросНежЛиц.УстановитьПараметр("Наименование", СтруктураЗалогодатель.Наименование);
			ЗапросНежЛиц.УстановитьПараметр("Дата", Дата);
			ЗапросНежЛиц.УстановитьПараметр("ВидПеречня", СписокПеречней);
			
			ВыборкаНаименование = ЗапросНежЛиц.Выполнить().Выбрать();
			
			Если ВыборкаНаименование.Следующий() Тогда
				Если ВыборкаНаименование.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
					РезультатПроверки = СравнитьДанныеКлиентов(СтруктураЗалогодатель, ВыборкаНаименование, СписокПеречней);
				КонецЕсли;
				
				Если РезультатПроверки.Совпадение Тогда
					Сообщить(ТекстФИО + РезультатПроверки.Текст);
					РезультатПроверки.Текст = ТекстФИО + РезультатПроверки.Текст;
					
					//+МАН 17.11.25
					ЗаписатьСовпадениеВРегистр(Залогодатель, ВыборкаНаименование, Дата);
					//-МАН
					
					Возврат РезультатПроверки;
					//Возврат НЕ РезультатПроверки.Совпадение;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ Пустаястрока(СтруктураЗалогодатель.НаименованиеЛат) Тогда
				
				ЗапросНежЛиц.Текст = ПолучитьТекстЗапроса("НаименованиеЛат");
				
				ЗапросНежЛиц.УстановитьПараметр("Наименование", СтруктураЗалогодатель.НаименованиеЛат);
				
				ВыборкаНаименованиеЛат = ЗапросНежЛиц.Выполнить().Выбрать();
				
				Если ВыборкаНаименованиеЛат.Следующий() Тогда
					Если ВыборкаНаименованиеЛат.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
						РезультатПроверки = СравнитьДанныеКлиентов(СтруктураЗалогодатель, ВыборкаНаименованиеЛат, СписокПеречней);
					КонецЕсли;
					
