// функция возвращает часть строки после последнего встреченного символа в строке
Функция ПолучитьЧастьСтрокиОтделеннойСимволом(Знач ИсходнаяСтрока, Знач СимволПоиска, ЕслиНетСимволаТоВсюСтроку = Ложь)
	
	ПозицияСимвола = СтрДлина(ИсходнаяСтрока);
	Пока ПозицияСимвола >= 1 Цикл
		
		Если Сред(ИсходнаяСтрока, ПозицияСимвола, 1) = СимволПоиска Тогда
						
			Возврат Сред(ИсходнаяСтрока, ПозицияСимвола + 1); 
			
		КонецЕсли;
		
		ПозицияСимвола = ПозицияСимвола - 1;	
	КонецЦикла;

	Возврат ?(ЕслиНетСимволаТоВсюСтроку, ИсходнаяСтрока, "");
  	
КонецФункции


// Выделяет из имени файла его расширение (набор символов после последней точки).
//
// Параметры
//  ИмяФайла     – Строка, содержащая имя файла, неважно с именем каталога или без.
//
// Возвращаемое значение:
//   Строка – расширение файла.
//
Функция ПолучитьРасширениеФайла(Знач ИмяФайла) Экспорт
	
	Расширение = ПолучитьЧастьСтрокиОтделеннойСимволом(ИмяФайла, ".");
	Возврат Расширение;
	
КонецФункции

Функция ЗаполнитьИнфорациюОМестеРождения(Страна, Область, Район, НасленныйПункт) Экспорт
	
    // ++ Сербаев 20.06.2023
	Если Не ПустаяСтрока(СокрЛП(Страна)) Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Страна, "Страна");
		Если ТекстОшибки <> "" Тогда 	
			Страна = "";
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(СокрЛП(Область)) Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Область, "Область");
		Если ТекстОшибки <> "" Тогда 	
			Область = "";
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(СокрЛП(Район)) Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Район, "Район");
		Если ТекстОшибки <> "" Тогда 	
			Район = "";
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(СокрЛП(НасленныйПункт)) Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(НасленныйПункт, "НасленныйПункт");
		Если ТекстОшибки <> "" Тогда 	
			НасленныйПункт = "";
		КонецЕсли;
	КонецЕсли;
    // -- Сербаев 20.06.2023
	
	Информация = "";
	Информация = Информация + ?(ПустаяСтрока(Страна), "", ?(ПустаяСтрока(Информация), "", ", ") + СокрЛП(Страна));
	Информация = Информация + ?(ПустаяСтрока(Область), "", ?(ПустаяСтрока(Информация), "", ", ") + СокрЛП(Область));
	Информация = Информация + ?(ПустаяСтрока(Район), "", ?(ПустаяСтрока(Информация), "", ", ") + СокрЛП(Район));
	Информация = Информация + ?(ПустаяСтрока(НасленныйПункт), "", ?(ПустаяСтрока(Информация), "", ", ") + СокрЛП(НасленныйПункт));
	Возврат Информация;
КонецФункции	

Функция ПрописнаяПерваяБуква(Строка) Экспорт
	Если НЕ ПустаяСтрока(Строка) Тогда
		НоваяСтрока = СокрЛП(Строка); 
		Симв = Врег(Лев(НоваяСтрока, 1));
		Если СтрДлина(НоваяСтрока) = 1 Тогда
			Возврат Симв;
		Иначе	
	        НоваяСтрока = Сред(НоваяСтрока, 2);
			НоваяСтрока = Симв + НоваяСтрока;
			Возврат НоваяСтрока;
		КонецЕсли;	
    КонецЕсли;
    Возврат Строка;
КонецФункции	
	
Функция ОписаниеВозраста(Возраст) Экспорт
	Если Возраст >= 10 И Возраст <= 20 Тогда
		Возврат "лет";
	КонецЕсли;	
	СимволПравый = Прав(СокрЛП(Возраст), 1);
	Если СимволПравый = "1" Тогда
		Возврат "год";
	ИначеЕсли СимволПравый = "2" ИЛИ СимволПравый = "3" ИЛИ СимволПравый = "4" Тогда
		Возврат "года";
	Иначе
		Возврат "лет";
	КонецЕсли;	
КонецФункции

Функция ПроверкаВсеСимволыНули(Значение, ДопСимволы = неопределено) Экспорт
	ПроверяемыСимволы = "0" + ?(ДопСимволы = неопределено, "", ДопСимволы);
	ЕстьНеНоль = ложь;
	Для Сч = 1 по СтрДлина(Значение) Цикл
        Символ = Сред(Значение, Сч, 1);
		Если Не Найти(ПроверяемыСимволы, Символ) Тогда
			ЕстьНеНоль = Истина;
            Прервать;
        КонецЕсли;
	КонецЦикла;
	Если ЕстьНеНоль Тогда
		Возврат ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

