Функция НайтиДокументыВПеречне(ПараметрПоиска)
	Текст = "ВЫБРАТЬ
			|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ИД КАК ИД,
			|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументНомер КАК ДокументНомер,
			|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументСерия КАК ДокументСерия,
			|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ВидПеречня КАК ВидПеречня
			|ИЗ
			|	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДокументы.СрезПоследних(&Дата, ВидПеречня В (&ВидПеречня)) КАК ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних";

	Если ПараметрПоиска = "Документ" Тогда
		Текст = Текст + Символы.ПС + "ГДЕ
			|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументНомер = &ДокументНомер
			|	И ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументСерия = &ДокументСерия";
	ИначеЕсли ПараметрПоиска = "ИД" Тогда
		Текст = Текст + Символы.ПС + "ГДЕ
			|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ИД = &ИД";
	КонецЕсли;
	
	Текст = Текст + Символы.ПС + Символы.ПС + "СГРУППИРОВАТЬ ПО
		|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ИД,
		|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументНомер,
		|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументСерия,
		|	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ВидПеречня";

	Возврат Текст;
	
КонецФункции

&НаСервере
Процедура ЗаписатьСовпадениеВРегистр(Залогодатель, Результат, Дата)
	
	Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
	НаборЗаписей = Рег.СоздатьНаборЗаписей();    
	НаборЗаписей.Отбор.ИД.Установить(Результат.ИД);
	НаборЗаписей.Отбор.Залогодатель.Установить(Залогодатель);
	НаборЗаписей.Отбор.ВидПеречня.Установить(Результат.ВидПеречня); 
	НаборЗаписей.Отбор.ДатаПеречня.Установить(Результат.ДатаПеречня);
	НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню);
	
	НоваяЗапись = НаборЗаписей.Добавить();   
	НоваяЗапись.Период = Дата;         
	НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню;
	НоваяЗапись.ВидПеречня = Результат.ВидПеречня; 
	НоваяЗапись.ДатаПеречня = Результат.ДатаПеречня;
	НоваяЗапись.Залогодатель = Залогодатель;  
	НоваяЗапись.ИД = Результат.ИД;
	НоваяЗапись.СтатусКлиентаВПеречне = Результат.Статус;
	НоваяЗапись.ДатаВключенияВПеречень = Результат.ДатаВключенияВПеречень;
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Ответственный = ТекПользователь.Сотрудник;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	НоваяЗапись.Ответственный = Ответственный;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

