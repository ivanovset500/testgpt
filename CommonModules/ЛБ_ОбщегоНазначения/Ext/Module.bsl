Функция СтрокаНеСодержитБукв(ИсходнаяСтрока) Экспорт
	
	ЕстьКирилица = Ложь;
	ЕстьЛатиница = Ложь;
	
	Если СтрДлина(ИсходнаяСтрока)>0 Тогда
		Для Сч=1 по СтрДлина(ИсходнаяСтрока) Цикл
			Символ = НРег(Сред(ИсходнаяСтрока, Сч, 1));
			Если Найти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", Символ) Тогда
				ЕстьКирилица = Истина;
			КонецЕсли;
			Если Найти("qwertyuiopasdfghjklzxcvbnm", Символ) Тогда
				ЕстьЛатиница = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
	Если ЕстьКирилица Или ЕстьЛатиница Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

&НаКлиенте
Функция ПроверитьСтрокуНаОдниБуквы(Знач ПроверяемаяСтрока, ПроверитьБезПробеловВСередина = Ложь) Экспорт
	
	Результат = Ложь;
	
	Если ПроверитьБезПробеловВСередина Тогда
	    ПроверяемаяСтрока = СтрЗаменить(ПроверяемаяСтрока, " ", "")
	КонецЕсли;
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.Global     = Истина;
	RegExp.IgnoreCase = Истина;
	RegExp.Pattern    = "[A-Za-zА-Яа-я]";
	Matches           = RegExp.Execute(ПроверяемаяСтрока);
	КоличествоБукв     = Matches.Count; 
	КоличествоСимволов = СтрДлина(ПроверяемаяСтрока);
	Если КоличествоБукв = КоличествоСимволов Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
