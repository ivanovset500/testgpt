Процедура ОбработатьРасчетныйПериодДокументов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеЗарплаты.Ссылка КАК Ссылка,
	|	""МесяцНачисления"" КАК ИмяРеквизита
	|ИЗ
	|	Документ.НачислениеЗарплаты КАК НачислениеЗарплаты
	|ГДЕ
	|	НачислениеЗарплаты.МесяцНачисления <> НАЧАЛОПЕРИОДА(НачислениеЗарплаты.МесяцНачисления, МЕСЯЦ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БольничныйЛист.Ссылка,
	|	""ПериодРегистрации""
	|ИЗ
	|	Документ.БольничныйЛист КАК БольничныйЛист
	|ГДЕ
	|	БольничныйЛист.ПериодРегистрации <> НАЧАЛОПЕРИОДА(БольничныйЛист.ПериодРегистрации, МЕСЯЦ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Отпуск.Ссылка,
	|	""ПериодРегистрации""
	|ИЗ
	|	Документ.Отпуск КАК Отпуск
	|ГДЕ
	|	Отпуск.ПериодРегистрации <> НАЧАЛОПЕРИОДА(Отпуск.ПериодРегистрации, МЕСЯЦ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВедомостьНаВыплатуЗарплатыВБанк.Ссылка,
	|	""ПериодРегистрации""
	|ИЗ
	|	Документ.ВедомостьНаВыплатуЗарплатыВБанк КАК ВедомостьНаВыплатуЗарплатыВБанк
	|ГДЕ
	|	ВедомостьНаВыплатуЗарплатыВБанк.ПериодРегистрации <> НАЧАЛОПЕРИОДА(ВедомостьНаВыплатуЗарплатыВБанк.ПериодРегистрации, МЕСЯЦ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВедомостьНаВыплатуЗарплатыВКассу.Ссылка,
	|	""ПериодРегистрации""
	|ИЗ
	|	Документ.ВедомостьНаВыплатуЗарплатыВКассу КАК ВедомостьНаВыплатуЗарплатыВКассу
	|ГДЕ
	|	ВедомостьНаВыплатуЗарплатыВКассу.ПериодРегистрации <> НАЧАЛОПЕРИОДА(ВедомостьНаВыплатуЗарплатыВКассу.ПериодРегистрации, МЕСЯЦ)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект[Выборка.ИмяРеквизита] = НачалоМесяца(ДокументОбъект[Выборка.ИмяРеквизита]);
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьРеквизитыБольничныхЛистов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БольничныйЛист.Ссылка КАК Ссылка,
	|	БольничныйЛист.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Документ.БольничныйЛист КАК БольничныйЛист
	|ГДЕ
	|	БольничныйЛист.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		// Код нарушения режима
		Если ЗначениеЗаполнено(ДокументОбъект.ДатаНарушенияРежима)
			И НЕ ЗначениеЗаполнено(ДокументОбъект.КодНарушенияРежима) Тогда
			ДокументОбъект.КодНарушенияРежима = 24;
		КонецЕсли;
		
		// Стаж
		Если ДокументОбъект.СтажЛет = 0 И ДокументОбъект.СтажМесяцев = 0 Тогда
			Если (ДокументОбъект.ПрименятьЛьготыПриНачисленииПособия
					И ДокументОбъект.ОграничениеПособияБезЛьгот = Перечисления.ВидыОграниченияПособия.ОграничениеВРазмереММОТ)
				ИЛИ (НЕ ДокументОбъект.ПрименятьЛьготыПриНачисленииПособия
					И ДокументОбъект.ОграничениеПособия = Перечисления.ВидыОграниченияПособия.ОграничениеВРазмереММОТ) Тогда
				ДокументОбъект.СтажМесяцев = 1;
			ИначеЕсли ДокументОбъект.ПроцентОплаты > 0 И ДокументОбъект.ПроцентОплаты <= 60 Тогда
				ДокументОбъект.СтажЛет = 1;
			ИначеЕсли ДокументОбъект.ПроцентОплаты > 60 И ДокументОбъект.ПроцентОплаты <= 80 Тогда
				ДокументОбъект.СтажЛет = 5;
			Иначе
				ДокументОбъект.СтажЛет = 8;
			КонецЕсли;
		КонецЕсли;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
		
		// Льготы
		Если ДокументОбъект.ПрименятьЛьготыПриНачисленииПособия Тогда
			СправочникОбъект = Выборка.ФизическоеЛицо.ПолучитьОбъект();
			Если НЕ ЗначениеЗаполнено(СправочникОбъект.ЛьготаПриНачисленииПособий) Тогда
				СправочникОбъект.ЛьготаПриНачисленииПособий = ДокументОбъект.ФинансированиеФедеральнымБюджетом;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьРеквизитыНачисленияЗарплаты() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НачислениеЗарплаты.Ссылка КАК Ссылка,
	|	НачислениеЗарплаты.КорректироватьНДФЛ КАК КорректироватьНДФЛ,
	|	НачислениеЗарплаты.КорректироватьВзносы КАК КорректироватьВзносы
	|ИЗ
	|	Документ.НачислениеЗарплаты КАК НачислениеЗарплаты
	|ГДЕ
	|	(НачислениеЗарплаты.КорректироватьНДФЛ
	|			ИЛИ НачислениеЗарплаты.КорректироватьВзносы)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если Выборка.КорректироватьНДФЛ Тогда
			ВременнаяТаблица = ДокументОбъект.НДФЛ.Выгрузить();
			ВременнаяТаблица.ЗаполнитьЗначения(Истина, "ФиксСтрока");
			ВременнаяТаблица.ЗаполнитьЗначения(Истина, "ФиксРасчет");
			ДокументОбъект.НДФЛ.Загрузить(ВременнаяТаблица);
		КонецЕсли;
		
		Если Выборка.КорректироватьВзносы Тогда
			ВременнаяТаблица = ДокументОбъект.Взносы.Выгрузить();
			ВременнаяТаблица.ЗаполнитьЗначения(Истина, "ФиксРасчет");
			ДокументОбъект.Взносы.Загрузить(ВременнаяТаблица);
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	
	КонецЦикла;
	
КонецПроцедуры

