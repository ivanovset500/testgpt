Функция СоздатьФизическоеЛицо(Наименование, ИНН, СсылкаНового = Неопределено) Экспорт

	ДанныеФизическогоЛица = Новый Структура;
	ДанныеФизическогоЛица.Вставить("ИНН", ИНН);
	Если СсылкаНового <> Неопределено Тогда
		ДанныеФизическогоЛица.Вставить("Ссылка", СсылкаНового);
	КонецЕсли;
	НовоеФизическоеЛицо = КадровыйУчет.НовоеФизическоеЛицо(Наименование, ДанныеФизическогоЛица);
	Возврат НовоеФизическоеЛицо.Ссылка;
	
КонецФункции

Функция СоздатьСчетФизическогоЛица(ФизическоеЛицо, СтруктураРеквизиовСчета) Экспорт
	
	НовыйЭлемент = Справочники.БанковскиеСчета.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, СтруктураРеквизиовСчета,
	"НомерСчета, Банк, БанкДляРасчетов, ВалютаДенежныхСредств, ВидСчета, ТекстКорреспондента, ТекстНазначения, МесяцПрописью, СуммаБезКопеек, ВсегдаУказыватьКПП");
	НовыйЭлемент.Владелец = ФизическоеЛицо;
	НовыйЭлемент.Наименование = Лев(СокрЛП(СтруктураРеквизиовСчета.НомерСчета) + ", " + СтруктураРеквизиовСчета.Банк, 100);
	
	Если НовыйЭлемент.ПолучитьСсылкуНового().Пустая() Тогда
		НовыйЭлемент.УстановитьСсылкуНового(Справочники.БанковскиеСчета.ПолучитьСсылку());
	КонецЕсли;
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Функция Просклонять(Знач ФИО, Знач Падеж, Результат, Знач Пол = Неопределено) Экспорт
	
	Возврат ФизическиеЛицаЗарплатаКадры.Просклонять(ФИО, Падеж, Результат, Пол);
	
КонецФункции

Функция ПолучитьСчетаУчетаСотрудников(ВестиУчетПоРаботникам, Реквизиты, СтрокаТаблицы, ТаблицаЗаработнойПлаты)		
	
	ТаблицаДляПолученияСчетов = ТаблицаЗаработнойПлаты.СкопироватьКолонки("ФизическоеЛицо, Подразделение, ВидОперации, СпособОтраженияЗарплатыВБухучете");			
	СтрокаТаб 				  = ТаблицаДляПолученияСчетов.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаТаб, СтрокаТаблицы);
	
	СоответствиеСчетовУчета = Новый Соответствие;				
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаПассивный, "СчетУчетаПассивный");
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаАктивный, 	"СчетУчетаАктивный");
	
	ТаблицаЕПСПараметрОтраженияВБУ = ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления, Реквизиты, ТаблицаДляПолученияСчетов);
	
	СтруктураПараметры = Новый Структура("Подразделение, ВидыОперацийПоЗарплате", СтрокаТаблицы.Подразделение, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоЗарплате.НачисленоДоход"));			
	
	Если ВестиУчетПоРаботникам Тогда
		СтруктураПараметры.Вставить("Контрагент", СтрокаТаблицы.ФизическоеЛицо);
	КонецЕсли;		
	
	ЕПСПараметрОтраженияВБУ 	 = ТаблицаЕПСПараметрОтраженияВБУ[0].ЕПСПараметрОтраженияВБУ;			
	ИспользуемыеСчетаСотрудников = ЮС_СчетаУчетаВДокументах.ПолучитьИспользуемыеСчетаУчета();
	
	Возврат ИспользуемыеСчетаСотрудников;

КонецФункции

Функция ПолучитьСчетаУчетаВзносовСотрудников(ВестиУчетПоРаботникам, Реквизиты, СтрокаТаблицы, ТаблицаЗаработнойПлаты)		
	
	ТаблицаДляПолученияСчетов = ТаблицаЗаработнойПлаты.СкопироватьКолонки("ФизическоеЛицо, Подразделение, ВидОперации, СпособОтраженияЗарплатыВБухучете");		
	СтрокаТаб = ТаблицаДляПолученияСчетов.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТаб, СтрокаТаблицы);
	СтрокаТаб.СпособОтраженияЗарплатыВБухучете = ПредопределенноеЗначение("Справочник.СпособыОтраженияЗарплатыВБухУчете.ВзносыСРезервовПоОтпускам");
	СтрокаТаб.ВидОперации = СтрокаТаблицы.ВедущийВидОперации;
	
	СоответствиеСчетовУчета = Новый Соответствие;				
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаПассивный, "СчетУчетаПассивный");
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаАктивный, 	"СчетУчетаАктивный");
	
	ТаблицаЕПСПараметрОтраженияВБУ = ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления, Реквизиты, ТаблицаДляПолученияСчетов);
	
	СтруктураПараметры = Новый Структура("Подразделение, ВидыОперацийПоЗарплате", СтрокаТаблицы.Подразделение, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервы"));			
	Если ВестиУчетПоРаботникам Тогда
		СтруктураПараметры.Вставить("Контрагент", СтрокаТаблицы.ФизическоеЛицо);
	КонецЕсли;	
	
	Если НЕ ТаблицаЕПСПараметрОтраженияВБУ.Количество() Тогда 
		Возврат Новый Структура;
	КонецЕсли;	
	
	ЕПСПараметрОтраженияВБУ 	 = ТаблицаЕПСПараметрОтраженияВБУ[0].ЕПСПараметрОтраженияВБУ;			
	ИспользуемыеСчетаСотрудников = ЮС_СчетаУчетаВДокументах.ПолучитьИспользуемыеСчетаУчета();
	
	Возврат ИспользуемыеСчетаСотрудников;

КонецФункции

Функция СписокСчетовАгентскогоНДФЛ(Организация) Экспорт
	
	СправочникНалогНДФЛ = Справочники.ВидыНалоговИПлатежейВБюджет.НайтиПоРеквизиту("КодБК", "18210102010011000110");

	МассивЛицевыхСчетов = Новый Массив();
	
	КоличествоИспользуемыхАналитик 	= ЮС_СчетаУчетаВДокументах.ПолучитьКоличествоИспользуемойАналитики();
	ТекстУсловиеАналитикиПоля 		= ""; 
	ТекстУсловиеАналитики 			= "";
	
	//Сформируем ТекстУсловиеАналитики и ТекстПоляАналитики
	Сч = 1;
	Пока Сч <= КоличествоИспользуемыхАналитик Цикл
		ТекстУсловиеАналитикиПоля = ТекстУсловиеАналитикиПоля + "ЕПСИспользуемыеЛицевыеСчета.Аналитика" + Сч + ",";  
		Сч = Сч + 1;
	КонецЦикла;
	
	//уберем лишние "," 
	Если ТекстУсловиеАналитикиПоля <> "" Тогда
		ТекстУсловиеАналитикиПоля = Лев(ТекстУсловиеАналитикиПоля,СтрДлина(ТекстУсловиеАналитикиПоля)-1);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСИспользуемыеЛицевыеСчета.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ЕПСИспользуемыеЛицевыеСчета КАК ЕПСИспользуемыеЛицевыеСчета
		|ГДЕ
		|	&ОбъектАналитики В (&УсловияАналитикиПоля)
		|	И ЕПСИспользуемыеЛицевыеСчета.Организация = &Организация";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияАналитикиПоля", 	ТекстУсловиеАналитикиПоля); 
	
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("ОбъектАналитики", 	СправочникНалогНДФЛ);
             
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 МассивЛицевыхСчетов.Добавить(ВыборкаДетальныеЗаписи.ЛицевойСчет);
	КонецЦикла;	
			
	СписокСчетовАгентскогоНДФЛ = Новый СписокЗначений;
	
	Для Каждого СтрокаМассивЛицевыхСчетов Из МассивЛицевыхСчетов Цикл
		СписокСчетовАгентскогоНДФЛ.Добавить(СтрокаМассивЛицевыхСчетов);
	КонецЦикла;	
	
	Возврат СписокСчетовАгентскогоНДФЛ;
	
КонецФункции

