// Получить контрагента и основной договор по физическому лицу
//
// Параметры:
//  Организация		 - СправочникСсылка.Организации	 - организация, по которой нужно найти основной договор контрагента
//  ФизическоеЛицо	 - СправочникСсылка.ФизическиеЛица	 - физ. лицо, по которому нужно выполнить поиск 
// 
// Возвращаемое значение:
//  Структуру - Контрагент, Договор 
//
Функция ПолучитьКонтрагентаПоФизическомуЛицу(Организация, ФизическоеЛицо) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Контрагент");
	СтруктураВозврата.Вставить("Договор");
	
	// Необходимо найти контрагента, связанного с физ. лицом
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Контрагент
	|ПОМЕСТИТЬ ВрТ_Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ИНН = &ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТ_Контрагент.Контрагент КАК Контрагент,
	|	ОсновныеДоговорыКонтрагента.Договор КАК Договор
	|ИЗ
	|	ВрТ_Контрагент КАК ВрТ_Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
	|		ПО ВрТ_Контрагент.Контрагент = ОсновныеДоговорыКонтрагента.Контрагент
	|ГДЕ
	|	ОсновныеДоговорыКонтрагента.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Наименование", 	ФизическоеЛицо.Наименование);
	Запрос.УстановитьПараметр("ИНН", 			ФизическоеЛицо.ИНН);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	Иначе
		СтруктураВозврата.Контрагент 	= Справочники.Контрагенты.ПустаяСсылка();
		СтруктураВозврата.Договор 		= Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

// Процедура дополняет таблицу с начислениями по ЗП, резервам лицевыми счетами по работникам
//
Процедура ДополнитьТаблицуЗаработнойПлатыРезервовЛицевымиСчетами(ТаблицаЗаработнойПлаты, Реквизиты, ВестиУчетПоРаботникам = Истина, ДоначислениеРезервовПоОтпускам = Ложь) 
	
	ТаблицаЗаработнойПлаты.Колонки.Добавить("СчетУчетаПассивный", 	Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаЗаработнойПлаты.Колонки.Добавить("СчетУчетаАктивный", 	Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаЗаработнойПлаты.Колонки.Добавить("СчетУчета", 			Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаЗаработнойПлаты.Колонки.Добавить("СубконтоНДФЛ1");
	ТаблицаЗаработнойПлаты.Колонки.Добавить("СубконтоНДФЛ2");
	ТаблицаЗаработнойПлаты.Колонки.Добавить("СубконтоНДФЛ3");
	
	// Для сохранения признака ЭтоМатериалньаяПомощь для определения правильного лицевого счета
	Если ТипЗнч(Реквизиты.Регистратор) = Тип("ДокументСсылка.ДепонированиеЗарплаты") Тогда 
		СтрокаКолонокДляОпределенияСчетов = "Подразделение, ВидОперации, СпособОтраженияЗарплатыВБухучете, ФизическоеЛицо, СтатьяРасходов, РегистрацияВНалоговомОргане, ДоговорКонтрагента, ЭтоМатериальнаяПомощь"; 		
	Иначе
		СтрокаКолонокДляОпределенияСчетов = "Подразделение, ВидОперации, СпособОтраженияЗарплатыВБухучете, ФизическоеЛицо, СтатьяРасходов, РегистрацияВНалоговомОргане, ДоговорКонтрагента";
	КонецЕсли;
	
	ТаблицаДляПолученияСчетов = ТаблицаЗаработнойПлаты.Скопировать(,СтрокаКолонокДляОпределенияСчетов);
	
	Если Не ВестиУчетПоРаботникам Тогда
		ТаблицаДляПолученияСчетов.ЗаполнитьЗначения(Неопределено, "ФизическоеЛицо");	
	КонецЕсли;
	
	ТаблицаДляПолученияСчетов.Свернуть(СтрокаКолонокДляОпределенияСчетов);
	
	// Для взносов требуется определить - взносы для резервов по отпускам или иным начислениям
	// Для начислений требуется определить - начисление отпуска это или заработной платы
	ЭтоВзносыДляРезервовПоОтпускам 			= Ложь;
	ЭтоНачисленияЗаСчетРезервовПоОтпускам 	= Ложь;
	Если ТипЗнч(Реквизиты.Регистратор) = Тип("ДокументСсылка.НачислениеОценочныхОбязательствПоОтпускам") 
		Или ТипЗнч(Реквизиты.Регистратор) = Тип("ДокументСсылка.Отпуск") // Документ Отпуск может доначислять сумму необходимого резерва
		Или ДоначислениеРезервовПоОтпускам Тогда 
		ЭтоВзносыДляРезервовПоОтпускам 			= Истина;
		ЭтоНачисленияЗаСчетРезервовПоОтпускам	= Истина;
	КонецЕсли;
	
	ОтражениеСуммРезервовПоОтпускамДо2022Года = Ложь;
	Если ТипЗнч(Реквизиты.Регистратор) = Тип("ДокументСсылка.НачислениеОценочныхОбязательствПоОтпускам") 
		И Реквизиты.КорректировкаОбязательств
		И ЗначениеЗаполнено(Реквизиты.Регистратор.СчетНачисленияДляКорректировкиОстатков)
		И Реквизиты.Регистратор.СчетНачисленияДляКорректировкиОстатков.Владелец = ПланыСчетов.ЕПС.ВспомогательныйСчет Тогда
		ОтражениеСуммРезервовПоОтпускамДо2022Года = Истина;
	КонецЕсли;
		
	МассивТаблицаДляПолученияСчетов = Новый Массив;
	
	Если ЭтоНачисленияЗаСчетРезервовПоОтпускам Тогда
		МассивТаблицаДляПолученияСчетов.Добавить(ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.РезервыПоОтпускам,        	Реквизиты, ТаблицаДляПолученияСчетов));
	Иначе
		МассивТаблицаДляПолученияСчетов.Добавить(ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления,        			Реквизиты, ТаблицаДляПолученияСчетов));
	КонецЕсли;
	Если ЭтоВзносыДляРезервовПоОтпускам Тогда
		МассивТаблицаДляПолученияСчетов.Добавить(ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.ВзносыСРезервовПоОтпускам,   Реквизиты, ТаблицаДляПолученияСчетов));
	Иначе
		МассивТаблицаДляПолученияСчетов.Добавить(ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Взносы,            			Реквизиты, ТаблицаДляПолученияСчетов));
	КонецЕсли;

	МассивТаблицаДляПолученияСчетов.Добавить(ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Депонирование,     				Реквизиты, ТаблицаДляПолученияСчетов));
	МассивТаблицаДляПолученияСчетов.Добавить(ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.СписаниеДепонента, 				Реквизиты, ТаблицаДляПолученияСчетов));

	ТаблицаДляПолученияСчетовНДФЛ = ДополнитьТаблицуНДФЛПараметрамиОтраженияВБУ(ТаблицаДляПолученияСчетов, Реквизиты);
	
	// Для отпуска требуется дозаполнить в таблице строки с переносом сумм со счетов, НЕ ПРИНИМАЕМЫХ к НУ на счета ПРИНИМАЕМЫЕ к НУ
	Если ТипЗнч(Реквизиты.Регистратор) = Тип("ДокументСсылка.Отпуск") 
		Или ДоначислениеРезервовПоОтпускам Тогда
		
		ВспомогательныйСчет00000 = ЮС_СчетаУчетаВДокументах.ПолучитьСчетаУчетаВспомогательныеСчета(Реквизиты.Организация, ПланыСчетов.ЕПС.ВспомогательныйСчет);
		
		ТаблицаЗаработнойПлаты.Колонки.Добавить("СубконтоКт1");
		ТаблицаЗаработнойПлаты.Колонки.Добавить("СубконтоКт2");
		ТаблицаЗаработнойПлаты.Колонки.Добавить("СубконтоКт3");

		МассивПравилОтражения = Новый Массив;
		МассивПравилОтражения.Добавить(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Взносы);
		МассивПравилОтражения.Добавить(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.ВзносыСРезервовПоОтпускам);
		МассивПравилОтражения.Добавить(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.РезервыПоОтпускам);
		МассивПравилОтражения.Добавить(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения КАК ПравилоОтражения,
		               |	ЕПСПорядокОтраженияЗарплаты.Счет КАК Счет,
		               |	ЕПСПорядокОтраженияЗарплаты.Субконто1 КАК Субконто1,
		               |	ЕПСПорядокОтраженияЗарплаты.Субконто2 КАК Субконто2,
		               |	ЕПСПорядокОтраженияЗарплаты.Субконто3 КАК Субконто3
		               |ИЗ
		               |	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
		               |ГДЕ
		               |	ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения В(&ПравилаОтражения)
		               |	И ВЫБОР
		               |			КОГДА ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления)
		               |				ТОГДА ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете = &СпособОтраженияЗарплатыВБухУчете
		               |			ИНАЧЕ ИСТИНА
		               |		КОНЕЦ
		               |	И ЕПСПорядокОтраженияЗарплаты.Организация = &Организация";
		
		Запрос.УстановитьПараметр("Организация",						Реквизиты.Организация);
		Запрос.УстановитьПараметр("ПравилаОтражения",					МассивПравилОтражения);
		Запрос.УстановитьПараметр("СпособОтраженияЗарплатыВБухУчете",	Справочники.СпособыОтраженияЗарплатыВБухУчете.ОтражениеНачисленийПоУмолчанию);
		
		ТаблицаСчетовОтражения = Запрос.Выполнить().Выгрузить();
		Если ТаблицаСчетовОтражения.Количество() Тогда
			
			Для Каждого СтрокаТаблицы Из ТаблицаЗаработнойПлаты Цикл
				
				Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоОплатеТрудаЗаСчетРезервовПоОтпускам Тогда
										
					СтрокаСчетРезервыПоОтпускам = ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.РезервыПоОтпускам);
					СтрокаСчетНачисления		= ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления);
					
					Если СтрокаСчетРезервыПоОтпускам <> Неопределено 
						И СтрокаСчетНачисления <> Неопределено Тогда
						
						СтрокаТаблицы.Счет 					= СтрокаСчетНачисления.Счет;
						СтрокаТаблицы.СчетУчетаПассивный 	= СтрокаСчетРезервыПоОтпускам.Счет;
						
						СтрокаТаблицы.Субконто1 			= СтрокаСчетНачисления.Субконто1;
						СтрокаТаблицы.Субконто2 			= СтрокаСчетНачисления.Субконто2;
						СтрокаТаблицы.Субконто3 			= СтрокаСчетНачисления.Субконто3;

						СтрокаТаблицы.СубконтоКт1 			= СтрокаСчетРезервыПоОтпускам.Субконто1;
						СтрокаТаблицы.СубконтоКт2 			= СтрокаСчетРезервыПоОтпускам.Субконто2;
						СтрокаТаблицы.СубконтоКт3 			= СтрокаСчетРезервыПоОтпускам.Субконто3;

					КонецЕсли;
					
				ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоОплатеТрудаЗаСчетРезервовПоОтпускамЗаПрошлыеПериоды Тогда
					
					СтрокаСчетНачисления		= ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления);
					СтрокаСчетРезервыПоОтпускам = ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.РезервыПоОтпускам);

					Если СтрокаСчетНачисления <> Неопределено 
						И ВспомогательныйСчет00000 <> Неопределено Тогда
						
						СтрокаТаблицы.СчетНУ 				= СтрокаСчетНачисления.Счет;
						СтрокаТаблицы.СчетУчетаПассивный 	= ВспомогательныйСчет00000;
						
						СтрокаТаблицы.СубконтоНУ1 			= СтрокаСчетНачисления.Субконто1;
						СтрокаТаблицы.СубконтоНУ2 			= СтрокаСчетНачисления.Субконто2;
						СтрокаТаблицы.СубконтоНУ3 			= СтрокаСчетНачисления.Субконто3;
												
					КонецЕсли;
					
				ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтраховымВзносамЗаСчетРезервовПоОтпускам Тогда
					
					СтрокаСчетВзносыСРезервовПоОтпускам = ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.ВзносыСРезервовПоОтпускам);
					СтрокаСчетВзносы					= ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Взносы);
					
					Если СтрокаСчетВзносыСРезервовПоОтпускам <> Неопределено 
						И СтрокаСчетВзносы <> Неопределено Тогда
						
						СтрокаТаблицы.Счет 					= СтрокаСчетВзносы.Счет;
						СтрокаТаблицы.СчетУчетаПассивный 	= СтрокаСчетВзносыСРезервовПоОтпускам.Счет;
						
						СтрокаТаблицы.Субконто1 			= СтрокаСчетВзносы.Субконто1;
						СтрокаТаблицы.Субконто2 			= СтрокаСчетВзносы.Субконто2;
						СтрокаТаблицы.Субконто3 			= СтрокаСчетВзносы.Субконто3;

						СтрокаТаблицы.СубконтоКт1 			= СтрокаСчетВзносыСРезервовПоОтпускам.Субконто1;
						СтрокаТаблицы.СубконтоКт2 			= СтрокаСчетВзносыСРезервовПоОтпускам.Субконто2;
						СтрокаТаблицы.СубконтоКт3 			= СтрокаСчетВзносыСРезервовПоОтпускам.Субконто3;

					КонецЕсли;
					
				ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтраховымВзносамЗаСчетРезервовПоОтпускамЗаПрошлыеПериоды Тогда
					
					СтрокаСчетВзносы					= ТаблицаСчетовОтражения.Найти(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Взносы);

					Если ВспомогательныйСчет00000 <> Неопределено 
						И СтрокаСчетВзносы <> Неопределено Тогда
						
						СтрокаТаблицы.СчетНУ 				= СтрокаСчетВзносы.Счет;
						СтрокаТаблицы.СчетУчетаПассивный 	= ВспомогательныйСчет00000;
						
						СтрокаТаблицы.СубконтоНУ1 			= СтрокаСчетВзносы.Субконто1;
						СтрокаТаблицы.СубконтоНУ2 			= СтрокаСчетВзносы.Субконто2;
						СтрокаТаблицы.СубконтоНУ3 			= СтрокаСчетВзносы.Субконто3;

					КонецЕсли;

				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СоответствиеСчетовУчета = Новый Соответствие;
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаПассивный, "СчетУчетаПассивный");
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаАктивный, 	"СчетУчетаАктивный");
	
	ИспользуемыеСчетаПоРаботникам = Новый Соответствие;
	
	// СС 11.01.2023
	СписыватьСуммуСформированногоРезерваПриКомпенсацииБезДоначисления = РегистрыСведений.НастройкиРасчетаРезервовОтпусков.СписыватьСуммуСформированногоРезерваПриКомпенсацииБезДоначисления(Реквизиты.Организация, Реквизиты.Период);
	
	Для каждого СтрокаТаблицы Из МассивТаблицаДляПолученияСчетов[0] Цикл // начисления
		
		// Для поиска открытых лицевых счетов требуется определить по виду начисления нужный тип выплаты
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ТипВыплатыРаботнику = Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускамДо2022Года;  
		Иначе
			Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервы // Формирование резерва на отпуск
				Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервыЗаПрошлыеПериоды Тогда 
				ТипВыплатыРаботнику = Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускам;
			ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.МатериальнаяПомощь Тогда
				ТипВыплатыРаботнику = Перечисления.ЮС_ВидыВыплатРаботникам.СоциальныеВыплаты;
			Иначе // Включая выплаты отпуска за счет резерва
				ТипВыплатыРаботнику = Перечисления.ЮС_ВидыВыплатРаботникам.ОплатаТруда;  
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпуска
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпускаОценочныеОбязательства Тогда 
			
			ТипВыплатыРаботникуРезервы 			= Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускам;
