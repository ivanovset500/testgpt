						СтрокаЗаработнойПлаты.Счет 		= ИспользуемыеСчетаПоРаботникуСоциальныеВыплаты.СчетУчетаПассивный;
					Иначе
						// Должны отразить отнесение суммы начислений с счета 60305 (оплата труда) на счет 60305 (депонирование выплаты)
						СтрокаЗаработнойПлаты.СчетУчета = ИспользуемыеСчетаПоРаботникуОплатаТруда.СчетУчетаПассивный;
						СтрокаЗаработнойПлаты.Счет 		= ИспользуемыеСчетаПоРаботникуОплатаТруда.СчетУчетаПассивный;
					КонецЕсли;
				КонецЕсли;
				Если ИспользуемыеСчетаПоРаботникуДепоненты.Свойство("СчетУчетаПассивный") Тогда
					СтрокаЗаработнойПлаты.СчетУчетаПассивный 	= ИспользуемыеСчетаПоРаботникуДепоненты.СчетУчетаПассивный;
				КонецЕсли;
				Если ИспользуемыеСчетаПоРаботникуДепоненты.Свойство("СчетУчетаАктивный") Тогда
					СтрокаЗаработнойПлаты.СчетУчетаАктивный 	= ИспользуемыеСчетаПоРаботникуДепоненты.СчетУчетаАктивный;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По сотруднику " + СтрокаТаблицы.ФизическоеЛицо + " не найдены лицевые счета! Начисления по нему не будут сформированы");
		КонецЕсли;
		
	КонецЦикла;
	
	МассивНеНайденныхЛСПоРегистрацииВНалоговомОргане = Новый Массив;
	Для каждого СтрокаТаблицы Из ТаблицаДляПолученияСчетовНДФЛ Цикл // НДФЛ
			
		СтруктураПоиска = Новый Структура("Подразделение, ВидОперации, СпособОтраженияЗарплатыВБухучете, СтатьяРасходов, РегистрацияВНалоговомОргане");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
		
		СтрокиЗаработнойПлаты = ТаблицаЗаработнойПлаты.НайтиСтроки(СтруктураПоиска);
		
		Для каждого СтрокаЗаработнойПлаты Из СтрокиЗаработнойПлаты Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
				Если МассивНеНайденныхЛСПоРегистрацииВНалоговомОргане.Найти(СтрокаТаблицы.РегистрацияВНалоговомОргане) = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По регистрации в налоговом органе " + СтрокаТаблицы.РегистрацияВНалоговомОргане + " не найдены лицевые счета! Начисления НДФЛ не будут сформированы");
					МассивНеНайденныхЛСПоРегистрацииВНалоговомОргане.Добавить(СтрокаТаблицы.РегистрацияВНалоговомОргане);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаЗаработнойПлаты.СчетУчета 	= СтрокаТаблицы.Счет;
			СтрокаЗаработнойПлаты.СубконтоНДФЛ1 = СтрокаТаблицы.Субконто1;
			СтрокаЗаработнойПлаты.СубконтоНДФЛ2 = СтрокаТаблицы.Субконто2;
			СтрокаЗаработнойПлаты.СубконтоНДФЛ3 = СтрокаТаблицы.Субконто3;
			
		КонецЦикла;
				
		// "КА" - расчеты с контрагентом. Возникает при договорах ГПХ
		// "ДВ" - дивиденды
		Если СтрокаТаблицы.СтатьяРасходов.Код = "КА"
			Или СтрокаТаблицы.СтатьяРасходов.Код = "ДВ" Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДоговорКонтрагента) Тогда
				СтруктураДанныхПоФизЛицу = ПолучитьКонтрагентаПоФизическомуЛицу(Реквизиты.Организация, СтрокаТаблицы.ФизическоеЛицо);
				СтрокаЗаработнойПлаты.ДоговорКонтрагента 	= СтруктураДанныхПоФизЛицу.Договор;
				СтрокаТаблицы.ДоговорКонтрагента 			= СтруктураДанныхПоФизЛицу.Договор;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДоговорКонтрагента) Тогда
				
				// Ищем лицевые счета по найденному договору и контрагенту
				ЛицевыеСчетПоДоговору = ЮС_СчетаУчетаВДокументах.ПолучитьСчетаРасчетовСКонтрагентом(Реквизиты.Организация, СтрокаТаблицы.ДоговорКонтрагента.Владелец, 
											СтрокаТаблицы.ДоговорКонтрагента, СтрокаТаблицы.ДоговорКонтрагента.ЕПСПараметрОтраженияВБУ);
				
				ИспользуемыеСчетаПоРаботнику = Новый Структура;
				ИспользуемыеСчетаПоРаботнику.Вставить("СчетУчетаПассивный");
				ИспользуемыеСчетаПоРаботнику.Вставить("СчетУчетаАктивный");
				
				ИспользуемыеСчетаПоРаботнику.СчетУчетаПассивный = ЛицевыеСчетПоДоговору.СчетУчетаКредиторскойЗадолженности;
				ИспользуемыеСчетаПоРаботнику.СчетУчетаАктивный 	= ЛицевыеСчетПоДоговору.СчетУчетаДебиторскойЗадолженности;
				
			КонецЕсли;
			
		Иначе
			
			ИспользуемыеСчетаПоРаботнику = ИспользуемыеСчетаПоРаботникам.Получить(СтрокаТаблицы.ФизическоеЛицо);
						
		КонецЕсли;
		
		Если ИспользуемыеСчетаПоРаботнику <> Неопределено 
			И ЗначениеЗаполнено(ИспользуемыеСчетаПоРаботнику.СчетУчетаПассивный) Тогда
			
			СтруктураПоиска = Новый Структура("Подразделение, ВидОперации, СпособОтраженияЗарплатыВБухучете, СтатьяРасходов");
			Если ВестиУчетПоРаботникам Тогда
				СтруктураПоиска.Вставить("ФизическоеЛицо");
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДоговорКонтрагента) Тогда
				СтруктураПоиска.Вставить("ДоговорКонтрагента");
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
			
			СтрокиЗаработнойПлаты = ТаблицаЗаработнойПлаты.НайтиСтроки(СтруктураПоиска);
			
			Для каждого СтрокаЗаработнойПлаты Из СтрокиЗаработнойПлаты Цикл
				
				Если ИспользуемыеСчетаПоРаботнику.Свойство("СчетУчетаПассивный") Тогда
					СтрокаЗаработнойПлаты.СчетУчетаПассивный 	= ИспользуемыеСчетаПоРаботнику.СчетУчетаПассивный;
				КонецЕсли;
				Если ИспользуемыеСчетаПоРаботнику.Свойство("СчетУчетаАктивный") Тогда
					СтрокаЗаработнойПлаты.СчетУчетаАктивный 	= ИспользуемыеСчетаПоРаботнику.СчетУчетаАктивный;
				КонецЕсли;
				
				Если СтрокаТаблицы.СтатьяРасходов.Код = "КА" Тогда
					СтрокаЗаработнойПлаты.Субконто1 = СтрокаТаблицы.ДоговорКонтрагента.Владелец;
					СтрокаЗаработнойПлаты.Субконто2 = СтрокаТаблицы.ДоговорКонтрагента;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По сотруднику " + СтрокаТаблицы.ФизическоеЛицо + " не найдены лицевые счета! Начисления по нему не будут сформированы");
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьВидСтраховогоВзносаДляПоискаЛицевогоСчета(СтрокаТаблицы, ЭтоВзносыДляРезервовПоОтпускам, 
			ОтражениеСуммРезервовПоОтпускамДо2022Года)
		
	// Для поиска открытых лицевых счетов требуется определить по виду операции нужную группу страховых взносов
	Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРСтраховаяЧасть
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРПоСуммарномуТарифу
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРДоПредельнойВеличины
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРСПревышения Тогда
		
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года;
		Иначе
			Если ЭтоВзносыДляРезервовПоОтпускам Тогда
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам;
			Иначе
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.ОбязательноеПенсионноеСтрахование;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифЛЭ
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифШахтеры
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка Тогда
		
		ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.ОбязательноеПенсионноеСтрахование;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПособиеНаПогребение Тогда
		
		ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.РасчетыПоСоциальномуСтрахованию;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ФСС
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФСС Тогда
		
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года;
		Иначе
			Если ЭтоВзносыДляРезервовПоОтпускам Тогда
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам;
			Иначе
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.РасчетыПоСоциальномуСтрахованию;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ФССНС
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФССНС Тогда
		
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года;
		Иначе
			Если ЭтоВзносыДляРезервовПоОтпускам Тогда
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам;
			Иначе
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.РасчетыПоОбязательномуСоцСтрахованиюОтНСИПЗ;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ФФОМС Тогда
		
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года;
		Иначе
			Если ЭтоВзносыДляРезервовПоОтпускам Тогда
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам;
			Иначе
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.ФедеральныйФондОМС;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.СтраховыеВзносыПоРезервамПоОтпускам 
		Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.СтраховыеВзносыПоРезервамПоОтпускамЗаПрошлыеПериоды Тогда
		
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года;
		Иначе
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам;
		КонецЕсли;
		
	ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВзносыПоЕдиномуТарифу Тогда
		
		Если ОтражениеСуммРезервовПоОтпускамДо2022Года Тогда
			ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года;
		Иначе
			Если ЭтоВзносыДляРезервовПоОтпускам Тогда
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам;
			Иначе
				ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.СоциальныйФондРоссии;
			КонецЕсли;
		КонецЕсли;

	Иначе
		
		ВидСтраховогоВзноса = Перечисления.ЮС_ВидыСтраховыхВзносов.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат ВидСтраховогоВзноса;

КонецФункции

Функция ПодготовитьТаблицуНалоговВзносовСФОТ(ТаблицаЗаработнойПлаты, УСН = Ложь, ИП = Ложь, Реквизиты)
	
	МассивОперацийНалоговВзносовСФОТ = Новый Массив;
	
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРНакопительнаяЧасть);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРСтраховаяЧасть);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРПоСуммарномуТарифу);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРДоПредельнойВеличины);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРСПревышения);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифЛЭ);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифШахтеры);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаПодземныхИВредныхРаботах);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ФСС);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ФССНС);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ФФОМС);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ТФОМС);
	МассивОперацийНалоговВзносовСФОТ.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВзносыПоЕдиномуТарифу);

	ОперацииУчетаОсобыхДопВзносов = Новый Массив;
	ОперацииУчетаОсобыхДопВзносов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки);
	ОперацииУчетаОсобыхДопВзносов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки);
	
	ТаблицаНалоговВзносовСФОТ = ТаблицаЗаработнойПлаты.СкопироватьКолонки();
	ТаблицаНалоговВзносовСФОТ.Колонки.Добавить("КорСчет");
	ТаблицаНалоговВзносовСФОТ.Колонки.Добавить("КорСубконто1");
	ТаблицаНалоговВзносовСФОТ.Колонки.Добавить("КорСубконто2");
	ТаблицаНалоговВзносовСФОТ.Колонки.Добавить("КорСубконто3");	
	ТаблицаНалоговВзносовСФОТ.Колонки.Добавить("КлючСортировки");
			
	// Аналитика учета
	ПустоеСубконто                           = ПланыВидовХарактеристик.ЕПСВидыСубконто.ПустаяСсылка();
	ВидПлатежаВГосБюджет                     = Перечисления.ВидыПлатежейВГосБюджет.Налог;
	РасходыПоУплатеСтраховыхВзносов          = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПрочиеДоходыИРасходы.РасходыПоУплатеСтраховыхВзносов");
	ВидПлатежаВГосБюджетВзносыБезСпецоценки  = Перечисления.ВидыПлатежейВГосБюджет.ВзносыБезСпецоценки;
	ВидПлатежаВГосБюджетРасходыПоСтрахованию = Перечисления.ВидыПлатежейВГосБюджет.РасходыПоСтрахованию;
	
	НастройкиУчетаЗарплаты = РегистрыСведений.НастройкиУчетаЗарплаты.Получить(Новый Структура("Организация", Реквизиты.Организация));
	РезервОтпусковЭлемент  = НастройкиУчетаЗарплаты.РезервОтпусков;
	
	УчетРезервовОтпусковНУ = ВедетсяУчетРезервовОтпусковПоВидамУчета(Реквизиты.Организация, Реквизиты.Период, "НУ");
	
	МассивСчет108 = Новый Массив();
	ВыборкаСчетов = ПланыСчетов.ЕПС.ВыбратьИерархически(ПланыСчетов.ЕПС.НайтиПоКоду("108"));
	Пока ВыборкаСчетов.Следующий() Цикл
		МассивСчет108.Добавить(ВыборкаСчетов.Ссылка);
	КонецЦикла;
	
	// СС 11.01.2023
	СписыватьСуммуСформированногоРезерваПриКомпенсацииБезДоначисления = РегистрыСведений.НастройкиРасчетаРезервовОтпусков.СписыватьСуммуСформированногоРезерваПриКомпенсацииБезДоначисления(Реквизиты.Организация, Реквизиты.Период);
	
	МассивВидовОперацииВзносыЗаСчетРезервов = Новый Массив;
	Если СписыватьСуммуСформированногоРезерваПриКомпенсацииБезДоначисления Тогда
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательстваИРезервы);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательства);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервы);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпуск);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпускаОценочныеОбязательства);
	Иначе
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательстваИРезервы);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательства);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервы);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпуск);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпуска);
		МассивВидовОперацииВзносыЗаСчетРезервов.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпускаОценочныеОбязательства);
	КонецЕсли;
	
	ПараметрОтраженияВБУСтраховыеВзносы = ЮС_СчетаУчетаВДокументах.ПараметрОтраженияВБУСтраховыеВзносы();
	Для Каждого СтрокаТаблицы Из ТаблицаЗаработнойПлаты Цикл
		
		Если МассивОперацийНалоговВзносовСФОТ.Найти(СтрокаТаблицы.ВидОперации) = Неопределено Тогда
			
			Продолжить;
			
		Иначе
			
			НоваяСтрока = ТаблицаНалоговВзносовСФОТ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			Если МассивВидовОперацииВзносыЗаСчетРезервов.Найти(НоваяСтрока.ВедущийВидОперации) <> Неопределено Тогда
				
				СчетаУчетаСтраховыхВзносовПоРезервамПоОтпускма = ЮС_СчетаУчетаВДокументах.ПолучитьСчетаУчетаВидовСтраховыхВзносов(
					Реквизиты.Организация, 
					Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам, 
					ПараметрОтраженияВБУСтраховыеВзносы);
				
				Если ЗначениеЗаполнено(СчетаУчетаСтраховыхВзносовПоРезервамПоОтпускма) Тогда					
					
					НоваяСтрока.КорСчет     = СтрокаТаблицы.СчетУчетаПассивный;
					
					НоваяСтрока.Счет      = СчетаУчетаСтраховыхВзносовПоРезервамПоОтпускма.СчетУчетаПассивный;
					НоваяСтрока.Субконто1 = ВидПлатежаВГосБюджет;
					НоваяСтрока.Субконто2 = ПустоеСубконто;
					НоваяСтрока.Субконто3 = ПустоеСубконто;
					
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.Счет) И МассивСчет108.Найти(НоваяСтрока.Счет.Владелец) = Неопределено Тогда
				
				НоваяСтрока.Счет         = НоваяСтрока.Счет;
				НоваяСтрока.Субконто1    = НоваяСтрока.Субконто1;
				НоваяСтрока.Субконто2    = НоваяСтрока.Субконто2;
				НоваяСтрока.Субконто3    = НоваяСтрока.Субконто3;

			КонецЕсли;
			
			КорСубконто = ОперацииУчетаОсобыхДопВзносов.Найти(СтрокаТаблицы.ВидОперации);
			НоваяСтрока.КорСчет      = СтрокаТаблицы.СчетУчетаПассивный;
			НоваяСтрока.КорСубконто1 = ?(КорСубконто = Неопределено, ВидПлатежаВГосБюджет, ВидПлатежаВГосБюджетВзносыБезСпецоценки);
			НоваяСтрока.КорСубконто2 = ПустоеСубконто;
			НоваяСтрока.КорСубконто3 = ПустоеСубконто;
			
			НоваяСтрока.КлючСортировки = СоздатьКлючСортировки(СтрокаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// СК [07.10.2022] (доходы/расходы ЗП по подразделениям) - добавила ПодразделениеУчетаНачислений

	СтрокаСвертки = "КлючСортировки, ВидОперации, Подразделение, ПодразделениеУчетаНачислений, ПодразделениеДоходовРасходов, Счет, Субконто1, Субконто2, Субконто3, КорСчет, КорСубконто1, КорСубконто2, КорСубконто3";
	СтрокаСвертки = СтрокаСвертки + ", СчетНУ, СубконтоНУ1, СубконтоНУ2, СубконтоНУ3";
	
	ТаблицаНалоговВзносовСФОТ.Свернуть(СтрокаСвертки, "Сумма");
	ТаблицаНалоговВзносовСФОТ.Сортировать(СтрокаСвертки);
	
	// Замена статей затрат, видов прочих расходов	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатратНачисления <> НЕОПРЕДЕЛЕНО
	|			ТОГДА СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатратНачисления
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатрат ССЫЛКА Справочник.ПрочиеДоходыИРасходы
	|					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатьиЗатрат.ПустаяСсылка)
	|			КОНЕЦ
	|	КОНЕЦ КАК СтатьяЗатратНачисления,
	|	СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатрат КАК СтатьяЗатрат
	|ИЗ
	|	РегистрСведений.СтатьиЗатратПоНалогамВзносамСФОТ КАК СтатьиЗатратПоНалогамВзносамСФОТ
	|ГДЕ
	|	СтатьиЗатратПоНалогамВзносамСФОТ.ВидСтатьиЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхСтатейЗатрат.ФСС_НС)";
	
	СтатьиЗатрат_ФСС_НСиПЗ = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатратНачисления <> НЕОПРЕДЕЛЕНО
	|			ТОГДА СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатратНачисления
	|		ИНАЧЕ ВЫБОР
	|				КОГДА СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатрат ССЫЛКА Справочник.ПрочиеДоходыИРасходы
	|					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатьиЗатрат.ПустаяСсылка)
	|			КОНЕЦ
	|	КОНЕЦ КАК СтатьяЗатратНачисления,
	|	СтатьиЗатратПоНалогамВзносамСФОТ.СтатьяЗатрат КАК СтатьяЗатрат
	|ИЗ
	|	РегистрСведений.СтатьиЗатратПоНалогамВзносамСФОТ КАК СтатьиЗатратПоНалогамВзносамСФОТ
	|ГДЕ
	|	СтатьиЗатратПоНалогамВзносамСФОТ.ВидСтатьиЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхСтатейЗатрат.СтраховыеВзносы)";
	
	СтатьиЗатрат_СтраховыеВзносы = Запрос.Выполнить().Выгрузить();
	
	ЕстьУчетНУ = Ложь;
	Если ТаблицаНалоговВзносовСФОТ.Колонки.Найти("СчетНУ") <> Неопределено Тогда
		ЕстьУчетНУ = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы ИЗ ТаблицаНалоговВзносовСФОТ Цикл
		
		Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ФССНС
			ИЛИ СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФССНС Тогда
			
			// Взносы в ФСС от НС и ПЗ
			Для НомерСубконто = 1 По 3 Цикл
				
				ЗаменитьЗначениеСтатьиЗатрат(СтрокаТаблицы, НомерСубконто, , СтатьиЗатрат_ФСС_НСиПЗ);
				Если ЕстьУчетНУ Тогда
					ЗаменитьЗначениеСтатьиЗатрат(СтрокаТаблицы, НомерСубконто, "НУ", СтатьиЗатрат_ФСС_НСиПЗ);
				КонецЕсли;

			КонецЦикла;
			
		Иначе
			
			// Взносы в ПФР, ФОМС и ФСС
			Для НомерСубконто = 1 По 3 Цикл
				
				ЗаменитьЗначениеСтатьиЗатрат(СтрокаТаблицы, НомерСубконто, , СтатьиЗатрат_СтраховыеВзносы);
				Если ЕстьУчетНУ Тогда
					ЗаменитьЗначениеСтатьиЗатрат(СтрокаТаблицы, НомерСубконто, "НУ", СтатьиЗатрат_СтраховыеВзносы);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаНалоговВзносовСФОТ;
		
КонецФункции

Функция ПодготовитьТаблицуДепонентов(Реквизиты, ТаблицаЗаработнойПлаты, УСН = Ложь)
	
	ТаблицаНачисленийИУдержаний = ТаблицаЗаработнойПлаты.СкопироватьКолонки();
	ТаблицаНачисленийИУдержаний.Колонки.Добавить("КорСчет");
	ТаблицаНачисленийИУдержаний.Колонки.Добавить("КорСубконто1");
	ТаблицаНачисленийИУдержаний.Колонки.Добавить("КорСубконто2");
	ТаблицаНачисленийИУдержаний.Колонки.Добавить("КорСубконто3");
	ТаблицаНачисленийИУдержаний.Колонки.Добавить("КлючСортировки");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПорядокОтраженияЗарплатыВБухУчете.Счет КАК КорСчет,
	|	ПорядокОтраженияЗарплатыВБухУчете.Субконто1 КАК КорСубконто1,
	|	ПорядокОтраженияЗарплатыВБухУчете.Субконто2 КАК КорСубконто2,
	|	ПорядокОтраженияЗарплатыВБухУчете.Субконто3 КАК КорСубконто3,
	|	ПорядокОтраженияЗарплатыВБухУчете.ОтражениеВУСН КАК ОтражениеВУСН,
	|	НастройкиУчетаЗарплаты.СписаниеДепонированныхСумм
	|ИЗ
	|	РегистрСведений.НастройкиУчетаЗарплаты КАК НастройкиУчетаЗарплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияЗарплатыВБухУчете КАК ПорядокОтраженияЗарплатыВБухУчете
	|		ПО НастройкиУчетаЗарплаты.СписаниеДепонированныхСумм = ПорядокОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете
	|ГДЕ
	|	НастройкиУчетаЗарплаты.Организация = &Организация
	|	И НЕ ПорядокОтраженияЗарплатыВБухУчете.ЕНВД";
	
	ПорядокСписанияДепонентов = Запрос.Выполнить().Выбрать();
	ПорядокСписанияДепонентов.Следующий();
				
	ВестиУчетПоРаботникам                    = Константы.ВедетсяУчетРасчетовПоЗарплатеПоРаботникам.Получить();
	УчетЗарплатыИКадровСредствамиБухгалтерии = Константы.УчетЗарплатыИКадровСредствамиБухгалтерии.Получить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗаработнойПлаты Цикл
		
		Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.Депонирование Тогда
			
			НоваяСтрока = ТаблицаНачисленийИУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			НоваяСтрока.Счет = СтрокаТаблицы.Счет;
			НоваяСтрока.КорСчет = СтрокаТаблицы.СчетУчетаПассивный;
			
			Если ВестиУчетПоРаботникам Тогда 
				НоваяСтрока.Субконто1    = СтрокаТаблицы.ФизическоеЛицо;
				НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;				
			КонецЕсли;
			
			НоваяСтрока.КлючСортировки = СоздатьКлючСортировки(СтрокаТаблицы);
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.СписаниеДепонента Тогда
			
			Если Не ЗначениеЗаполнено(ПорядокСписанияДепонентов.СписаниеДепонированныхСумм) Тогда
				ТекстСообщения = НСтр("ru = '%1. В настройках учета зарплаты не задан способ учета для списания депонированных сумм.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщения,
				Реквизиты.Регистратор); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Реквизиты.Регистратор);
			КонецЕсли;
			
			НоваяСтрока = ТаблицаНачисленийИУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПорядокСписанияДепонентов);
						
			НоваяСтрока.Счет 	= СтрокаТаблицы.СчетУчетаПассивный;
			НоваяСтрока.КорСчет = СтрокаТаблицы.Счет; 
			
			Если ВестиУчетПоРаботникам Тогда
				НоваяСтрока.Субконто1    = СтрокаТаблицы.ФизическоеЛицо;
			КонецЕсли;
						
			НоваяСтрока.КлючСортировки = СоздатьКлючСортировки(СтрокаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаСвертки = "КлючСортировки, ВидОперации, Подразделение, ПодразделениеУчетаНачислений, Счет, Субконто1, Субконто2, Субконто3, КорСчет, КорСубконто1, КорСубконто2, КорСубконто3";
		
	ТаблицаНачисленийИУдержаний.Свернуть(СтрокаСвертки, "Сумма");
	ТаблицаНачисленийИУдержаний.Сортировать(СтрокаСвертки);
	
	Возврат ТаблицаНачисленийИУдержаний;
		
КонецФункции

Процедура ЗаменитьЗначениеСтатьиЗатрат(СтрокаТаблицы, НомерСубконто, ВидУчета = "", ТаблицаЗамены)
	
	ТекущаяКолонка = "Субконто" + ВидУчета + НомерСубконто;
	
	ИскомоеЗначение = СтрокаТаблицы[ТекущаяКолонка];
	
	СтрокаЗамещения = ТаблицаЗамены.Найти(ИскомоеЗначение, "СтатьяЗатратНачисления");
	
	Если СтрокаЗамещения <> Неопределено Тогда
		СтрокаТаблицы[ТекущаяКолонка] = СтрокаЗамещения.СтатьяЗатрат;
	Иначе
		Если ТипЗнч(ИскомоеЗначение) = Тип("СправочникСсылка.СтатьиЗатрат") Тогда
			СтрокаЗамещения = ТаблицаЗамены.Найти(Справочники.СтатьиЗатрат.ПустаяСсылка(), "СтатьяЗатратНачисления");
			Если СтрокаЗамещения <> Неопределено Тогда
				СтрокаТаблицы[ТекущаяКолонка] = СтрокаЗамещения.СтатьяЗатрат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ИскомоеЗначение) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
			СтрокаЗамещения = ТаблицаЗамены.Найти(Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка(), "СтатьяЗатратНачисления");
			Если СтрокаЗамещения <> Неопределено Тогда
				СтрокаТаблицы[ТекущаяКолонка] = СтрокаЗамещения.СтатьяЗатрат;
			КонецЕсли;
		КонецЕсли;					
	КонецЕсли;
		
КонецПроцедуры

Процедура ПроверитьЗаполненностьСпособаОтраженияВУчете(ТаблицаЗаработнойПлаты, Реквизиты)
	
	ТаблицаПроверки = ТаблицаЗаработнойПлаты.Скопировать(,"ФизическоеЛицо, СпособОтраженияЗарплатыВБухУчете, Счет");	
	ТаблицаПроверки.Свернуть("ФизическоеЛицо, СпособОтраженияЗарплатыВБухУчете, Счет",);
	
	ДополнениеСообщения = "";
	Если Константы.УчетЗарплатыИКадровСредствамиБухгалтерии.Получить() Тогда
		ДополнениеСообщения = НСтр("ru = ' Проверьте настройку начислений/удержаний.'");
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы ИЗ ТаблицаПроверки Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СпособОтраженияЗарплатыВБухУчете) Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
				ТекстСообщения = НСтр("ru = '%1. Работник: %2 - не указаны счет и аналитика для способа учета зарплаты ""%3""!%4'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ТекстСообщения,
					Реквизиты.Регистратор,
					СтрокаТаблицы.ФизическоеЛицо,
					СтрокаТаблицы.СпособОтраженияЗарплатыВБухУчете,
					ДополнениеСообщения); 
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Реквизиты.Регистратор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура ПроверитьЗаполненностьРегистрацииВНалоговомОргане(ТаблицаНДФЛ, Реквизиты, Отказ)
	
	Если Константы.УчетЗарплатыИКадровСредствамиБухгалтерии.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПроверки = ТаблицаНДФЛ.Скопировать(,"ФизическоеЛицо, РегистрацияВНалоговомОргане");
	
	ДополнениеСообщения = "";
	
	Для Каждого СтрокаТаблицы ИЗ ТаблицаПроверки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.РегистрацияВНалоговомОргане) Тогда
			ТекстСообщения = НСтр("ru = '%1. Работник: %2 - на закладке ""Начисленный НДФЛ"" не указана регистрация в налоговом органе!%4'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщения,
				Реквизиты.Регистратор,
				СтрокаТаблицы.ФизическоеЛицо,
				ДополнениеСообщения); 
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Реквизиты.Регистратор,,,Отказ);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьРегистрациюВНалоговомОрганеВКоллекцииСтрок(Организация, КоллекцияНачисленныйНДФЛ) Экспорт
	
	СведенияОбОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ГоловнаяОрганизация, ЮридическоеФизическоеЛицо");
	ОрганизацияЮрлицо     = СведенияОбОрганизации.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", СведенияОбОрганизации.ГоловнаяОрганизация);
	
	Если ТипЗнч(КоллекцияНачисленныйНДФЛ) = Тип("ДанныеФормыКоллекция") Тогда
		ТаблицаНДФЛ = КоллекцияНачисленныйНДФЛ.Выгрузить();
	Иначе
		// передана таблица значений
		
		ТаблицаНДФЛ = КоллекцияНачисленныйНДФЛ.Скопировать();
		
		Если КоллекцияНачисленныйНДФЛ.Колонки.Найти("РегистрацияВНалоговомОргане") = Неопределено Тогда
			КоллекцияНачисленныйНДФЛ.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
		КонецЕсли;
		
	КонецЕсли;
	
	ИмяКолонкиОКТМО = "КодПоОКТМО";
	Если ТаблицаНДФЛ.Колонки.Найти("КодПоОКТМО") = Неопределено Тогда
		ТаблицаНДФЛ.Колонки.ОКАТО.Имя = "КодПоОКТМО";
		ИмяКолонкиОКТМО = "ОКАТО";		
	КонецЕсли;
	
	ПоляСвертки = "КодНалоговогоОргана";
	Если ОрганизацияЮрлицо Тогда
		ПоляСвертки = ПоляСвертки + ",КПП";
	КонецЕсли;
	ПоляДополнительногоОтбора = ПоляСвертки;
	ПоляСвертки = ПоляСвертки + ",КодПоОКТМО";
	
	ТаблицаНДФЛ.Свернуть(ПоляСвертки);
	ТаблицаНДФЛ.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистрацииВНалоговомОргане.Ссылка КАК РегистрацияВНалоговомОргане,
	|	РегистрацииВНалоговомОргане.КодПоОКТМО КАК КодПоОКТМО,
	|	РегистрацииВНалоговомОргане.КПП КАК КПП,
	|	РегистрацииВНалоговомОргане.Код КАК КодНалоговогоОргана
	|ИЗ
	|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|ГДЕ
	|	РегистрацииВНалоговомОргане.Владелец = &Организация";
	
	ДействующиеРегистрации = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура(ПоляСвертки);
	ОтборДополнительный = Новый Структура(ПоляДополнительногоОтбора);
	
	Для каждого СтрокаТЗ Из ТаблицаНДФЛ Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТЗ);
		Регистрации = ДействующиеРегистрации.НайтиСтроки(Отбор);
		Если Регистрации.Количество() > 0 Тогда
			СтрокаТЗ.РегистрацияВНалоговомОргане = Регистрации[0].РегистрацияВНалоговомОргане;
		Иначе
			ЗаполнитьЗначенияСвойств(ОтборДополнительный, СтрокаТЗ);
			Регистрации = ДействующиеРегистрации.НайтиСтроки(ОтборДополнительный);
			Если Регистрации.Количество() > 0 Тогда
				СтрокаТЗ.РегистрацияВНалоговомОргане = Регистрации[0].РегистрацияВНалоговомОргане;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаКоллекции Из КоллекцияНачисленныйНДФЛ Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаКоллекции); 
		Отбор.КодПоОКТМО = СтрокаКоллекции[ИмяКолонкиОКТМО];		
		Регистрации = ТаблицаНДФЛ.НайтиСтроки(Отбор);
		Если Регистрации.Количество() > 0 Тогда
			СтрокаКоллекции.РегистрацияВНалоговомОргане = Регистрации[0].РегистрацияВНалоговомОргане;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область НачислениеУСН

// Формирует движения по отражению зарплаты в УСН
Процедура СформироватьДвиженияОтраженияЗарплатыУСН(ТаблицаОтраженияЗарплатыУСН, ТаблицаРеквизиты, Движения, Отказ) Экспорт
	
	Параметры = ПодготовитьПараметрыДвиженийОтраженияЗарплатыУСН(ТаблицаОтраженияЗарплатыУСН, ТаблицаРеквизиты);
	Реквизиты = Параметры.Реквизиты[0];
	
	Если Параметры.ТаблицаОтраженияЗарплатыУСН.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Движения.Найти("РасходыПриУСН") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Вставить("ТаблицаУСННачислениеЗарплаты", Параметры.ТаблицаОтраженияЗарплатыУСН);
	Параметры.Вставить("ПериодРегистрации", Реквизиты.Период);
	
	ДокументОбъект = Новый Структура();
	ДокументОбъект.Вставить("Организация", Реквизиты.Организация);
	ДокументОбъект.Вставить("Дата",        Реквизиты.Период);
	ДокументОбъект.Вставить("Имя",         "НачислениеЗарплаты");
	ДокументОбъект.Вставить("Ссылка",      Реквизиты.Ссылка);	
	ДокументОбъект.Вставить("Движения",    Движения);
	
	НалоговыйУчетУСН.СформироватьДвиженияУСН(ДокументОбъект, Параметры, Ложь);

КонецПроцедуры

Функция ПодготовитьПараметрыДвиженийОтраженияЗарплатыУСН(ТаблицаОтраженияЗарплатыУСН, ТаблицаРеквизиты)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы шапки документа
	СписокОбязательныхКолонок = ""
	+ "Период,"				// <Дата> - счет по дебету проводки (счет учета денежных средств)
	+ "Организация,"		// <СправочникСсылка.Организации> - организация документа
	+ "Ссылка,"				// <ДокументСсылка> - документ-регистратор
	+ "ПериодРегистрации"   // <Дата> - период регистрации
	;
	
	Параметры.Вставить("Реквизиты", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаРеквизиты, СписокОбязательныхКолонок));
	
	
	// Подготовка таблицы по заработной плате:
	СписокОбязательныхКолонок = ""
	+ "Счет,"						// <ПланСчетовСсылка.Хозрасчетный>
	+ "Субконто1,"					// <> - значение аналитики 
	+ "Субконто2,"					// <> - значение аналитики 
	+ "Субконто3,"					// <> - значение аналитики
	+ "КорСчет,"					// <ПланСчетовСсылка.Хозрасчетный>
	+ "КорСубконто1,"				// <> - значение аналитики 
	+ "КорСубконто2,"				// <> - значение аналитики 
	+ "КорСубконто3,"				// <> - значение аналитики	
	+ "ОтражениеВУСН,"				// <Перечисление.ОтражениеВУСН>
	+ "РасчетныйДокумент,"			// <ДокументСсылка> - документ-регистратор
	+ "Сумма"						// <Число(15,2)>
	;	
	
	Параметры.Вставить("ТаблицаОтраженияЗарплатыУСН", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаОтраженияЗарплатыУСН, СписокОбязательныхКолонок));

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область НачислениеИП

Процедура ОпределитьВидНачисленийУдержанийИП(ТаблицаЗаработнойПлаты, Реквизиты)
	
	СоответствиеВидовНачисленийУдержаний = Новый Соответствие;
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход,               Перечисления.ИПВидыНачисленийУдержаний.НачисленоПовременно);
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпуск,              Перечисления.ИПВидыНачисленийУдержаний.НачисленоПовременно);
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпуска, Перечисления.ИПВидыНачисленийУдержаний.НачисленоПовременно);
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.НачисленоСдельноДоход,        Перечисления.ИПВидыНачисленийУдержаний.НачисленоСдельно);
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.НатуральныйДоход,             Перечисления.ИПВидыНачисленийУдержаний.НачисленоНатуральныйДоход);
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.НДФЛ,                         Перечисления.ИПВидыНачисленийУдержаний.УдержаноНДФЛ);
	СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.НДФЛСПревышения,              Перечисления.ИПВидыНачисленийУдержаний.УдержаноНДФЛ);

	Если Реквизиты.Период >= ДатаНачалаАдминистрированияСтраховыхВзносовФНС() Тогда
		СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюРаботодатель, Перечисления.ИПВидыНачисленийУдержаний.НачисленоДругое);
		СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФСС,          Перечисления.ИПВидыНачисленийУдержаний.НачисленоДругое);
		СоответствиеВидовНачисленийУдержаний.Вставить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФССНС,        Перечисления.ИПВидыНачисленийУдержаний.НачисленоДругое);
	КонецЕсли;
	
	Если ТаблицаЗаработнойПлаты.Колонки.Найти("ВидНачисленияУдержания") = Неопределено Тогда
		ТаблицаЗаработнойПлаты.Колонки.Добавить("ВидНачисленияУдержания", Новый ОписаниеТипов("ПеречислениеСсылка.ИПВидыНачисленийУдержаний"));
		Для каждого Начисление Из ТаблицаЗаработнойПлаты Цикл
			Начисление.ВидНачисленияУдержания	= СоответствиеВидовНачисленийУдержаний.Получить(Начисление.ВидОперации);			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьПараметрыДвиженийОтраженияЗарплатыИП(ТаблицаНачисленияУдержания, ТаблицаРеквизитов)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы Параметры.Реквизиты
	
	СписокОбязательныхКолонок = ""
		+ "Период,"						// <Дата> - период движений - дата документа
		+ "Ссылка,"						// <ДокументСсылка.*> - документ-регистратор движений
		+ "Организация";				// <СправочникСсылка.Организации> - оранизация
		
	Параметры.Вставить("Реквизиты", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(
		ТаблицаРеквизитов, СписокОбязательныхКолонок));
	
	// Подготовка таблицы Параметры.ТаблицаОтраженияЗарплатыИП
	
	СписокОбязательныхКолонок = ""
		+ "Счет,"						//	<ПланСчетовСсылка.Хозрасчетный>
		+ "Субконто1,"					//  <Характеристика.ВидыСубконтоХозрасчетные>
		+ "Субконто2,"					//  <Характеристика.ВидыСубконтоХозрасчетные> 
		+ "Субконто3,"					//  <Характеристика.ВидыСубконтоХозрасчетные>
		+ "КорСчет,"					//	<ПланСчетовСсылка.Хозрасчетный> 
		+ "КорСубконто1,"				//  <Характеристика.ВидыСубконтоХозрасчетные>
		+ "КорСубконто2,"				//  <Характеристика.ВидыСубконтоХозрасчетные> 
		+ "КорСубконто3,"				//  <Характеристика.ВидыСубконтоХозрасчетные>
		+ "ВидНачисленияУдержания,"		//  <ПеречислениеСсылка.ИПВидыНачисленийУдержаний> - вид начисления/удержания
		+ "Сумма";						//	<Сумма, 15, 2> - сумма начисления/удержания в рублях
		
	Параметры.Вставить("ТаблицаОтраженияЗарплатыИП", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(
		ТаблицаНачисленияУдержания, СписокОбязательныхКолонок));
		
	Возврат Параметры;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область Удержание

Процедура СформироватьДвиженияУдержания(Движения, Отказ, Организация, Знач ПериодРегистрации, ДанныеДляОтражения, НачисленнаяЗарплатаИВзносы = Неопределено)
		
	Если Константы.УчетЗарплатыИКадровСредствамиБухгалтерии.Получить() И НЕ Константы.РасчетЗарплатыДляНебольшихОрганизаций.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Регистратор       = Движения.ЕПС.Отбор.Регистратор.Значение;
	ПериодРегистрации = ПолучитьПериодРегистрации(Регистратор, ПериодРегистрации);
	Параметры         = ПодготовитьПараметрыПоОтражениюУдержанийВУчете(ДанныеДляОтражения, Организация, ПериодРегистрации, Регистратор);
	Реквизиты         = Параметры.Реквизиты[0];
	
	СформироватьПроводкиПоОтражениюУдержанийВУчете(Параметры.ТаблицаУдержаний, Реквизиты, Движения, Отказ);
		
КонецПроцедуры

Функция ПодготовитьПараметрыПоОтражениюУдержанийВУчете(ДанныеДляПроводок, Организация, ПериодРегистрации, Регистратор)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы шапки документа
	Реквизиты = Новый ТаблицаЗначений;
	
	Реквизиты.Колонки.Добавить("Организация");
	Реквизиты.Колонки.Добавить("Период");
	Реквизиты.Колонки.Добавить("Регистратор");
	
	НоваяСтрока             = Реквизиты.Добавить();
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.Период      = ПериодРегистрации;
	НоваяСтрока.Регистратор = Регистратор;
	
	Параметры.Вставить("Реквизиты", Реквизиты);
		
	// Подготовка таблицы по заработной плате:
	СписокОбязательныхКолонок = ""
	+ "ФизическоеЛицо,"
	+ "ВидОперации,"
	+ "Подразделение,"
	+ "ПодразделениеУчетаНачислений,"
	+ "Контрагент,"	
	+ "ДоговорКонтрагента,"	
	+ "НазначениеПодотчетныхСредствПриВозмещениеУщерба,"
	+ "ЛицевойСчетНачУдержания,"	
	+ "Сумма"
	;	
	Параметры.Вставить("ТаблицаУдержаний", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(
		ДанныеДляПроводок, СписокОбязательныхКолонок));

	Возврат Параметры;

КонецФункции

Процедура СформироватьПроводкиПоОтражениюУдержанийВУчете(ТаблицаУдержаний, Реквизиты, Движения, Отказ)
	
	Если ТаблицаУдержаний.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВестиУчетПоРаботникам = Константы.ВедетсяУчетРасчетовПоЗарплатеПоРаботникам.Получить();
	ВалютаУчета			  = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДополнитьТаблицуУдержанийЛицевымиСчетами(ТаблицаУдержаний, Реквизиты);
		
	ТаблицаУдержанийРаботников = ПодготовитьТаблицуУдержаний(ТаблицаУдержаний);
	
	СодержанияПроводок = Новый Соответствие;
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму,
								"Начислены проценты по займу");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ПроцентыПоЗайму,
									"Удержаны проценты по займам");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ПогашениеЗаймов,
									"Удержано погашение займа");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛисты,
									"Удержано по исполнительному листу");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.Профвзносы,
									"Удержаны профвзносы");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ДСВ,
									"Удержаны добровольные взносы на накопительная часть трудовой пенсии");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ПрочиеУдержания,
									"Прочие удержания из заработной платы");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ДобровольныеВзносыВНПФ,
									"Удержаны добровольные взносы в негосударственный пенсионный фонд");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгента,
									"Удержано вознаграждение платежного агента");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ВозмещениеУщерба,
									"Удержано возмещение ущерба");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеПоПрочимОперациямСРаботниками,
									"Удержание по прочим операциям с работниками");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм,
									"Удержание неизрасходованных подотчетных сумм");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ВозвратИзлишнеВыплаченныхСуммВследствиеСчетныхОшибок,
									"Возврат излишне выплаченных сумм");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеЗаОтпуск,
									"Удержание за неотработанные дни предоставленного авансом отпуска");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгентаКонтрагенты,
									"Удержано вознаграждение платежного агента из доходов контрагента");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛистыКонтрагенты,
									"Удержано по исполнительному листу из доходов контрагента");
	СодержанияПроводок.Вставить(Перечисления.ВидыОперацийПоЗарплате.СписаниеКорректировкиАСПоЗайму,
									"Корректировка амортизированной стоимости выданного займа");
	
	МассивСчетРасчетовСПерсоналомПоОплатеТруда = Новый Массив();
	МассивСчетРасчетовСПерсоналомПоОплатеТруда.Добавить(ПланыСчетов.ЕПС.НайтиПоКоду("60305"));
	МассивСчетРасчетовСПерсоналомПоОплатеТруда.Добавить(ПланыСчетов.ЕПС.НайтиПоКоду("60306"));

	Для Каждого СтрокаТаблицы Из ТаблицаУдержанийРаботников Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет)
			Или Не ЗначениеЗаполнено(СтрокаТаблицы.КорСчет) Тогда
			// не заполнены счет и аналитика
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Проводка = Движения.ЕПС.Добавить();
		Проводка.Период      = Реквизиты.Период;
		Проводка.Организация = Реквизиты.Организация;
		Проводка.Сумма       = СтрокаТаблицы.Сумма;
		Проводка.Содержание  = СодержанияПроводок.Получить(СтрокаТаблицы.ВидОперации);
		
		Проводка.ЛицевойСчетКт 	= СтрокаТаблицы.Счет;
		Проводка.СчетКт 		= СтрокаТаблицы.Счет.Владелец;
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютаКт        = ВалютаУчета;
			Проводка.ВалютнаяСуммаКт = Проводка.Сумма;
		КонецЕсли;

		БухгалтерскийУчет.УстановитьСубконто(Проводка.ЛицевойСчетКт, Проводка.СубконтоКт, 1, СтрокаТаблицы.Субконто1);
		БухгалтерскийУчет.УстановитьСубконто(Проводка.ЛицевойСчетКт, Проводка.СубконтоКт, 2, СтрокаТаблицы.Субконто2);
		БухгалтерскийУчет.УстановитьСубконто(Проводка.ЛицевойСчетКт, Проводка.СубконтоКт, 3, СтрокаТаблицы.Субконто3);
		
		СвойстваСчетаКт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		
		Если СвойстваСчетаКт.УчетПоПодразделениям Тогда
			Проводка.ПодразделениеКт = СтрокаТаблицы.Подразделение;
		КонецЕсли;
		
		Проводка.ЛицевойСчетДт 	= СтрокаТаблицы.КорСчет;
		Проводка.СчетДт 		= СтрокаТаблицы.КорСчет.Владелец;
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютаДт        = ВалютаУчета;
			Проводка.ВалютнаяСуммаДт = Проводка.Сумма;
		КонецЕсли;

		Если ВестиУчетПоРаботникам Тогда
			БухгалтерскийУчет.УстановитьСубконто(Проводка.ЛицевойСчетДт, Проводка.СубконтоДт, 1, СтрокаТаблицы.КорСубконто1);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.ЛицевойСчетДт, Проводка.СубконтоДт, 2, СтрокаТаблицы.КорСубконто2);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.ЛицевойСчетДт, Проводка.СубконтоДт, 3, СтрокаТаблицы.КорСубконто3);
		КонецЕсли;
		
		СвойстваСчетаДт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		
		// СС 11.01.2023
		//Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
		//	Проводка.ПодразделениеДт = СтрокаТаблицы.Подразделение;
		//КонецЕсли;
		
		Если МассивСчетРасчетовСПерсоналомПоОплатеТруда.Найти(Проводка.СчетДт) <> Неопределено  Тогда
			Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
				Проводка.ПодразделениеДт = СтрокаТаблицы.ПодразделениеУчетаНачислений;
			КонецЕсли;
		Иначе
			Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
				Проводка.ПодразделениеДт = СтрокаТаблицы.Подразделение;	
			КонецЕсли;
		КонецЕсли;
		//\
		
	КонецЦикла;
	
	Движения.ЕПС.Записывать = Истина;
	
КонецПроцедуры

Функция ПодготовитьТаблицуУдержаний(ТаблицаУдержанийРаботника, УСН = Ложь, ИП = Ложь)
	
	Если ТаблицаУдержанийРаботника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаУдержаний = ТаблицаУдержанийРаботника.СкопироватьКолонки();
	ТаблицаУдержаний.Колонки.Добавить("Счет");
	ТаблицаУдержаний.Колонки.Добавить("Субконто1");
	ТаблицаУдержаний.Колонки.Добавить("Субконто2");
	ТаблицаУдержаний.Колонки.Добавить("Субконто3");
	ТаблицаУдержаний.Колонки.Добавить("КорСчет");
	ТаблицаУдержаний.Колонки.Добавить("КорСубконто1");
	ТаблицаУдержаний.Колонки.Добавить("КорСубконто2");
	ТаблицаУдержаний.Колонки.Добавить("КорСубконто3");
	
	ПустоеСубконто 			= ПланыВидовХарактеристик.ЕПСВидыСубконто.ПустаяСсылка();
	ВидПлатежаВГосБюджет 	= Перечисления.ВидыПлатежейВГосБюджет.Налог;

	Для Каждого СтрокаТаблицы Из ТаблицаУдержанийРаботника Цикл
		
		Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПогашениеЗаймов
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПроцентыПоЗайму Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.Контрагент;
			НоваяСтрока.Субконто2    = СтрокаТаблицы.ДоговорКонтрагента;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.НачислениеСчетУчетаПассивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
						
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛисты
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛистыКонтрагенты Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.Контрагент;
			НоваяСтрока.Субконто2    = СтрокаТаблицы.ДоговорКонтрагента;

			НоваяСтрока.КорСчет      = СтрокаТаблицы.НачислениеСчетУчетаПассивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ДСВ 
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ДобровольныеВзносыВНПФ Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.Контрагент;
			НоваяСтрока.Субконто2    = СтрокаТаблицы.ДоговорКонтрагента;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.НачислениеСчетУчетаПассивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.Профвзносы Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.Контрагент;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.УдержаниеСчетУчетаАктивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПрочиеУдержания Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			Если ЗначениеЗаполнено(СтрокаТаблицы.Контрагент) Тогда
				НоваяСтрока.Счет      = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
				НоваяСтрока.Субконто1 = СтрокаТаблицы.Контрагент;
			Иначе
				НоваяСтрока.Счет      = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
				НоваяСтрока.Субконто1 = СтрокаТаблицы.ФизическоеЛицо;
			КонецЕсли;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.УдержаниеСчетУчетаАктивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгента
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгентаКонтрагенты Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.Контрагент;
			Если СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгентаКонтрагенты Тогда
				НоваяСтрока.КорСчет      = СтрокаТаблицы.УдержаниеСчетУчетаАктивный;
			Иначе
				НоваяСтрока.КорСчет      = СтрокаТаблицы.УдержаниеСчетУчетаАктивный;
			КонецЕсли;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВозмещениеУщерба 
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеПоПрочимОперациямСРаботниками Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.СубконтоУдержания1;
			НоваяСтрока.Субконто2    = СтрокаТаблицы.СубконтоУдержания2;
			НоваяСтрока.Субконто3    = СтрокаТаблицы.СубконтоУдержания3;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.НачислениеСчетУчетаПассивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.УдержаниеСчетУчетаПассивный;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.ФизическоеЛицо;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.УдержаниеСчетУчетаАктивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВозвратИзлишнеВыплаченныхСуммВследствиеСчетныхОшибок Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.СчетУдержания;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.СубконтоУдержания1;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.НачислениеСчетУчетаАктивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеЗаОтпуск Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет         = СтрокаТаблицы.СчетУдержания;
			НоваяСтрока.Субконто1    = СтрокаТаблицы.СубконтоУдержания1;
			НоваяСтрока.КорСчет      = СтрокаТаблицы.НачислениеСчетУчетаАктивный;
			НоваяСтрока.КорСубконто1 = СтрокаТаблицы.ФизическоеЛицо;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму
			Или СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПогашениеПроцентовПоЗайму Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Счет      = СтрокаТаблицы.СчетУдержания;
			НоваяСтрока.Субконто1 = СтрокаТаблицы.СубконтоУдержания1;
			НоваяСтрока.Субконто2 = ?(ЗначениеЗаполнено(СтрокаТаблицы.СубконтоУдержания2), СтрокаТаблицы.СубконтоУдержания2, ПустоеСубконто);
			НоваяСтрока.Субконто3 = ПустоеСубконто;
			НоваяСтрока.КорСчет         = СтрокаТаблицы.НачислениеСчетУчетаАктивный;
			НоваяСтрока.КорСубконто1    = СтрокаТаблицы.Контрагент;
			НоваяСтрока.КорСубконто2    = СтрокаТаблицы.ДоговорКонтрагента;
			НоваяСтрока.КорСубконто3    = ПустоеСубконто;
			
		ИначеЕсли СтрокаТаблицы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.СписаниеКорректировкиАСПоЗайму Тогда
			
			НоваяСтрока = ТаблицаУдержаний.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			Если ЗначениеЗаполнено(СтрокаТаблицы.НачислениеСчетУчетаПассивный) Тогда // 48608
				НоваяСтрока.Счет      = СтрокаТаблицы.СчетУдержания;
				НоваяСтрока.Субконто1 = СтрокаТаблицы.СубконтоУдержания1;
				НоваяСтрока.Субконто2 = ПустоеСубконто;
				НоваяСтрока.Субконто3 = ПустоеСубконто;
				НоваяСтрока.КорСчет         = СтрокаТаблицы.НачислениеСчетУчетаПассивный;
				НоваяСтрока.КорСубконто1    = СтрокаТаблицы.Контрагент;
				НоваяСтрока.КорСубконто2    = СтрокаТаблицы.ДоговорКонтрагента;
				НоваяСтрока.КорСубконто3    = ПустоеСубконто;
			Иначе //48607
				НоваяСтрока.Счет      = СтрокаТаблицы.НачислениеСчетУчетаАктивный;
				НоваяСтрока.Субконто1 = СтрокаТаблицы.Контрагент;
				НоваяСтрока.Субконто2 = СтрокаТаблицы.ДоговорКонтрагента;
				НоваяСтрока.Субконто3 = ПустоеСубконто;
				НоваяСтрока.КорСчет         = СтрокаТаблицы.СчетУдержания;
				НоваяСтрока.КорСубконто1    = СтрокаТаблицы.СубконтоУдержания1;
				НоваяСтрока.КорСубконто2    = ПустоеСубконто;
				НоваяСтрока.КорСубконто3    = ПустоеСубконто;
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
		
	СтрокаСвертки = "ВидОперации, Подразделение, ПодразделениеУчетаНачислений, Счет, Субконто1, Субконто2, Субконто3, КорСчет, КорСубконто1, КорСубконто2, КорСубконто3"; // СС 11.01.2023
			
	ТаблицаУдержаний.Свернуть(СтрокаСвертки, "Сумма");
	
	Возврат ТаблицаУдержаний;
	
КонецФункции

Процедура ДополнитьТаблицуУдержанийЛицевымиСчетами(ТаблицаУдержаний, Реквизиты, ВестиУчетПоРаботникам = Истина)
	
	ТаблицаУдержаний.Колонки.Добавить("УдержаниеСчетУчетаПассивный", 		Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаУдержаний.Колонки.Добавить("УдержаниеСчетУчетаАктивный", 		Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаУдержаний.Колонки.Добавить("НачислениеСчетУчетаПассивный", 		Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаУдержаний.Колонки.Добавить("НачислениеСчетУчетаАктивный", 		Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаУдержаний.Колонки.Добавить("СчетУдержания", 						Новый ОписаниеТипов("СправочникСсылка.ЕПСЛицевыеСчета"));
	ТаблицаУдержаний.Колонки.Добавить("СубконтоУдержания1");
	ТаблицаУдержаний.Колонки.Добавить("СубконтоУдержания2");
	ТаблицаУдержаний.Колонки.Добавить("СубконтоУдержания3");
	
	СтрокаКолонокДляОпределенияСчетов = "Подразделение, ВидОперации, Контрагент, ДоговорКонтрагента, ЛицевойСчетНачУдержания, ФизическоеЛицо, НазначениеПодотчетныхСредствПриВозмещениеУщерба";
	
	ТаблицаДляПолученияСчетов = ТаблицаУдержаний.Скопировать(,СтрокаКолонокДляОпределенияСчетов);
	
	Если Не ВестиУчетПоРаботникам Тогда
		ТаблицаДляПолученияСчетов.ЗаполнитьЗначения(Неопределено, "ФизическоеЛицо");	
	КонецЕсли;
	
	ТаблицаДляПолученияСчетов.Свернуть(СтрокаКолонокДляОпределенияСчетов);
	
	ТаблицаДляПолученияСчетов = ДополнитьТаблицуУдержанийПараметрамиОтраженияВБУ(ТаблицаДляПолученияСчетов, Реквизиты);
	
	СоответствиеСчетовУчета = Новый Соответствие;
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаПассивный, "СчетУчетаПассивный");
	СоответствиеСчетовУчета.Вставить(Перечисления.ЕПСВидыСчетов.СчетУчетаАктивный, 	"СчетУчетаАктивный");
	
	// СС 04.10.202
	// Выданные займы сотрудникам
	УчетнаяПолитикаЛомбарда = ЮС_УправлениеЛомбардомРасчет.ПолучитьУчетнуюПолитикуЛомбарда(Реквизиты.Период, Реквизиты.Организация);
	СтатьяДляОтраженияКорректировокУменПроцентныеДоходы		= УчетнаяПолитикаЛомбарда.СтатьяДляОтраженияКорректировокУменПроцентныеДоходы;
	СтатьяДляОтраженияКорректировокУвелПроцентныеДоходы 	= УчетнаяПолитикаЛомбарда.СтатьяДляОтраженияКорректировокУвелПроцентныеРасходыПоВыданнымЗаймам;
	ЛицевойСчетКорректировокУвеличивающихПроцентныеДоходы 	= ЮС_СчетаУчетаВДокументах.ПолучитьСчетаУчетаДоходовИРасходовИзРегистраСведений(Реквизиты.Организация,
																СтатьяДляОтраженияКорректировокУвелПроцентныеДоходы.ЕПСВидДоходов, СтатьяДляОтраженияКорректировокУвелПроцентныеДоходы).СчетУчета;
	ЛицевойСчетКорректировокУменьшающихПроцентныеДоходы		= ЮС_СчетаУчетаВДокументах.ПолучитьСчетаУчетаДоходовИРасходовИзРегистраСведений(Реквизиты.Организация,
																СтатьяДляОтраженияКорректировокУменПроцентныеДоходы.ЕПСВидРасходов, СтатьяДляОтраженияКорректировокУменПроцентныеДоходы).СчетУчета;

	Для каждого СтрокаТаблицы Из ТаблицаДляПолученияСчетов Цикл
		
		ИспользуемыеСчетаНачисление = ЮС_СчетаУчетаВДокументах.ПолучитьСчетаРасчетовСРаботниками(Реквизиты.Организация, СтрокаТаблицы.ФизическоеЛицо,,
			Перечисления.ЮС_ВидыВыплатРаботникам.ОплатаТруда);
		
		Если ЗначениеЗаполнено(ИспользуемыеСчетаНачисление) Тогда
			
			СтруктураПоиска = Новый Структура("Подразделение, ВидОперации");
			
			Если ВестиУчетПоРаботникам Тогда
				СтруктураПоиска.Вставить("ФизическоеЛицо");
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДоговорКонтрагента) Тогда
				СтруктураПоиска.Вставить("ДоговорКонтрагента");
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
			
			СтрокиТаблицыУдержаний = ТаблицаУдержаний.НайтиСтроки(СтруктураПоиска);
			
			Для каждого СтрокаТаблицыУдержаний Из СтрокиТаблицыУдержаний Цикл
				
				Если СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеЗаОтпуск Тогда
					Если ИспользуемыеСчетаНачисление.Свойство("СчетУчетаАктивный") Тогда
						СтрокаТаблицыУдержаний.НачислениеСчетУчетаАктивный 	= ИспользуемыеСчетаНачисление.СчетУчетаПассивный;
					КонецЕсли;
				ИначеЕсли СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму 
					Или СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПогашениеПроцентовПоЗайму Тогда
					СтрокаТаблицыУдержаний.НачислениеСчетУчетаАктивный 	= СтрокаТаблицыУдержаний.ЛицевойСчетНачУдержания;
				ИначеЕсли СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.СписаниеКорректировкиАСПоЗайму Тогда
					Если СтрокаТаблицыУдержаний.ЛицевойСчетНачУдержания.Владелец.Вид = ВидСчета.Пассивный Тогда // 48608
						СтрокаТаблицыУдержаний.НачислениеСчетУчетаПассивный = СтрокаТаблицыУдержаний.ЛицевойСчетНачУдержания;
					Иначе  // 48607
						СтрокаТаблицыУдержаний.НачислениеСчетУчетаАктивный 	= СтрокаТаблицыУдержаний.ЛицевойСчетНачУдержания;
					КонецЕсли;
				Иначе
					Если ИспользуемыеСчетаНачисление.Свойство("СчетУчетаПассивный") Тогда
						СтрокаТаблицыУдержаний.НачислениеСчетУчетаПассивный = ИспользуемыеСчетаНачисление.СчетУчетаПассивный;
					КонецЕсли;
					Если ИспользуемыеСчетаНачисление.Свойство("СчетУчетаАктивный") Тогда
						СтрокаТаблицыУдержаний.НачислениеСчетУчетаАктивный 	= ИспользуемыеСчетаНачисление.СчетУчетаАктивный;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
				
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЛицевойСчетНачУдержания) Тогда
			
			СтруктураПоиска = Новый Структура("Подразделение, ВидОперации, Контрагент");
			Если ВестиУчетПоРаботникам Тогда
				СтруктураПоиска.Вставить("ФизическоеЛицо");
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДоговорКонтрагента) Тогда
				СтруктураПоиска.Вставить("ДоговорКонтрагента");
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
			
			СтрокиТаблицыУдержаний = ТаблицаУдержаний.НайтиСтроки(СтруктураПоиска);
			
			Для каждого СтрокаТаблицыУдержаний Из СтрокиТаблицыУдержаний Цикл
				СтрокаТаблицыУдержаний.УдержаниеСчетУчетаПассивный = СтрокаТаблицы.ЛицевойСчетНачУдержания;
			КонецЦикла;
			
		КонецЕсли;

		СтруктураПоиска = Новый Структура("Подразделение, ВидОперации, ФизическоеЛицо, ДоговорКонтрагента");
			
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
		
		СтрокиТаблицыУдержаний = ТаблицаУдержаний.НайтиСтроки(СтруктураПоиска);
		
		Для каждого СтрокаТаблицыУдержаний Из СтрокиТаблицыУдержаний Цикл
			
			СтрокаТаблицыУдержаний.СчетУдержания = СтрокаТаблицы.ЛицевойСчетНачУдержания;
			Если СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВозмещениеУщерба Тогда
				// Назначение подотчетных средств
				СтрокаТаблицыУдержаний.СубконтоУдержания1 = СтрокаТаблицы.ФизическоеЛицо;
				СтрокаТаблицыУдержаний.СубконтоУдержания2 = СтрокаТаблицы.НазначениеПодотчетныхСредствПриВозмещениеУщерба;
			ИначеЕсли СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеЗаОтпуск Тогда
				СтрокаТаблицыУдержаний.СчетУдержания      = СтрокаТаблицы.СчетУдержания;
				СтрокаТаблицыУдержаний.СубконтоУдержания1 = СтрокаТаблицы.СубконтоУдержания1;
			ИначеЕсли СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму Тогда
				СтрокаТаблицыУдержаний.СчетУдержания      = СтрокаТаблицы.СчетУдержания;
				СтрокаТаблицыУдержаний.СубконтоУдержания1 = СтрокаТаблицы.СубконтоУдержания1;
			ИначеЕсли СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.СписаниеКорректировкиАСПоЗайму Тогда
				Если СтрокаТаблицыУдержаний.ЛицевойСчетНачУдержания.Владелец.Вид = ВидСчета.Пассивный Тогда // 48608
					// Дт 71006 (символ ОФР 31618) Кт 48607
					СтрокаТаблицыУдержаний.СчетУдержания 		= ЛицевойСчетКорректировокУвеличивающихПроцентныеДоходы;
					СтрокаТаблицыУдержаний.СубконтоУдержания1 	= СтатьяДляОтраженияКорректировокУвелПроцентныеДоходы;
				Иначе // Дт 48608 Кт 71005 (символ ОФР 31518)
					СтрокаТаблицыУдержаний.СчетУдержания 		= ЛицевойСчетКорректировокУменьшающихПроцентныеДоходы;
					СтрокаТаблицыУдержаний.СубконтоУдержания1 	= СтатьяДляОтраженияКорректировокУменПроцентныеДоходы;
				КонецЕсли;
			ИначеЕсли СтрокаТаблицыУдержаний.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПогашениеПроцентовПоЗайму Тогда
				// Необходимо найти счет начисления процентов
				СтруктураПоискаСчетНачислениеПроцентов = Новый Структура("ВидОперации, ДоговорКонтрагента");
				СтруктураПоискаСчетНачислениеПроцентов.ВидОперации 			= Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму;
				СтруктураПоискаСчетНачислениеПроцентов.ДоговорКонтрагента 	= СтрокаТаблицы.ДоговорКонтрагента;
				
				СтрокиТаблицыУдержанийНачислениеПроцентов = ТаблицаУдержаний.НайтиСтроки(СтруктураПоискаСчетНачислениеПроцентов);
				Если СтрокиТаблицыУдержанийНачислениеПроцентов.Количество() Тогда
					СтрокаТаблицыУдержаний.СчетУдержания 		= СтрокиТаблицыУдержанийНачислениеПроцентов[0].ЛицевойСчетНачУдержания;					
					СтрокаТаблицыУдержаний.СубконтоУдержания1 	= СтрокаТаблицы.Контрагент;
					СтрокаТаблицыУдержаний.СубконтоУдержания2 	= СтрокаТаблицы.ДоговорКонтрагента;
				КонецЕсли;
			Иначе
				СтрокаТаблицыУдержаний.СубконтоУдержания1 = СтрокаТаблицы.Контрагент;
				СтрокаТаблицыУдержаний.СубконтоУдержания2 = СтрокаТаблицы.ДоговорКонтрагента;
			КонецЕсли;
			СтрокаТаблицыУдержаний.СубконтоУдержания3 = Неопределено;
			
		КонецЦикла;
		
	КонецЦикла;
			
КонецПроцедуры

Функция ДополнитьТаблицуУдержанийПараметрамиОтраженияВБУ(ТаблицаУдержаний, Реквизиты)
	
	Запрос = Новый Запрос;
	
	МассивОпераций = Новый Массив;	
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПогашениеЗаймов);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПроцентыПоЗайму);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛисты);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДСВ);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.Профвзносы);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДобровольныеВзносыВНПФ);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгента);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВозмещениеУщерба);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеПоПрочимОперациямСРаботниками);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВозвратИзлишнеВыплаченныхСуммВследствиеСчетныхОшибок);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеЗаОтпуск);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму); 
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПрочиеУдержания); 
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПогашениеПроцентовПоЗайму); 
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.СписаниеКорректировкиАСПоЗайму); 

	ПравилаОтражений = Новый Массив;
	ПравилаОтражений.Добавить(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления);
	ПравилаОтражений.Добавить(ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Удержания);
	
	Запрос.УстановитьПараметр("Организация", 		Реквизиты.Организация);
	Запрос.УстановитьПараметр("ПравилаОтражения",	ПравилаОтражений);
	Запрос.УстановитьПараметр("ВидыОпераций",       МассивОпераций);
	Запрос.УстановитьПараметр("ТаблицаУдержаний", 	ТаблицаУдержаний);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаУдержаний.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаУдержаний.Контрагент КАК Контрагент,
	|	ТаблицаУдержаний.Подразделение КАК Подразделение,
	|	ТаблицаУдержаний.ВидОперации КАК ВидОперации,
	|	ТаблицаУдержаний.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТаблицаУдержаний.ЛицевойСчетНачУдержания КАК ЛицевойСчетНачУдержания,
	|	ТаблицаУдержаний.НазначениеПодотчетныхСредствПриВозмещениеУщерба КАК НазначениеПодотчетныхСредствПриВозмещениеУщерба
	|ПОМЕСТИТЬ ТаблицаУдержанийИсходная
	|ИЗ
	|	&ТаблицаУдержаний КАК ТаблицаУдержаний
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУдержаний.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаУдержаний.Контрагент КАК Контрагент,
	|	ТаблицаУдержаний.Подразделение КАК Подразделение,
	|	ТаблицаУдержаний.ВидОперации КАК ВидОперации,
	|	ТаблицаУдержаний.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТаблицаУдержаний.ЛицевойСчетНачУдержания КАК ЛицевойСчетНачУдержания,
	|	ТаблицаУдержаний.НазначениеПодотчетныхСредствПриВозмещениеУщерба КАК НазначениеПодотчетныхСредствПриВозмещениеУщерба
	|ПОМЕСТИТЬ ТаблицаУдержаний
	|ИЗ
	|	ТаблицаУдержанийИсходная КАК ТаблицаУдержаний
	|ГДЕ
	|	ТаблицаУдержаний.ВидОперации В(&ВидыОпераций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете КАК Перечисление.ВидыОперацийПоЗарплате), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.Пустаяссылка)) КАК СпособОтраженияЗарплатыВБухУчете,
	|	ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения КАК ПравилоОтражения,
	|	ЕПСПорядокОтраженияЗарплаты.Счет КАК Счет,
	|	ЕПСПорядокОтраженияЗарплаты.ЕПСПараметрОтраженияВБУ КАК ЕПСПараметрОтраженияВБУ,
	|	0 КАК Порядок,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто1 КАК Субконто1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто2 КАК Субконто2,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ ВТ_ПорядокОтражения
	|ИЗ
	|	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
	|ГДЕ
	|	ЕПСПорядокОтраженияЗарплаты.Организация = &Организация
	|	И ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения В(&ПравилаОтражения)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете КАК Перечисление.ВидыОперацийПоЗарплате), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.Пустаяссылка)),
	|	ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения,
	|	ЕПСПорядокОтраженияЗарплаты.Счет,
	|	ЕПСПорядокОтраженияЗарплаты.ЕПСПараметрОтраженияВБУ,
	|	1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто2,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто3
	|ИЗ
	|	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
	|ГДЕ
	|	ЕПСПорядокОтраженияЗарплаты.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения В(&ПравилаОтражения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПорядокОтражения.ПравилоОтражения КАК ПравилоОтражения,
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете КАК СпособОтраженияЗарплатыВБухУчете,
	|	МИНИМУМ(ВТ_ПорядокОтражения.Порядок) КАК Порядок
	|ПОМЕСТИТЬ ВТ_ТаблицаОтбор
	|ИЗ
	|	ВТ_ПорядокОтражения КАК ВТ_ПорядокОтражения
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПорядокОтражения.ПравилоОтражения,
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете КАК СпособОтраженияЗарплатыВБухУчете,
	|	ВТ_ПорядокОтражения.ПравилоОтражения КАК ПравилоОтражения,
	|	ВТ_ПорядокОтражения.Счет КАК Счет,
	|	ВТ_ПорядокОтражения.ЕПСПараметрОтраженияВБУ КАК ЕПСПараметрОтраженияВБУ,
	|	ВЫБОР
	|		КОГДА ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПорядокПараметраОтраженияВБУ,
	|	ВТ_ПорядокОтражения.Субконто1 КАК Субконто1,
	|	ВТ_ПорядокОтражения.Субконто2 КАК Субконто2,
	|	ВТ_ПорядокОтражения.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ ВТ_Итоговая
	|ИЗ
	|	ВТ_ПорядокОтражения КАК ВТ_ПорядокОтражения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаОтбор КАК ВТ_ТаблицаОтбор
	|		ПО ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете = ВТ_ТаблицаОтбор.СпособОтраженияЗарплатыВБухУчете
	|			И ВТ_ПорядокОтражения.Порядок = ВТ_ТаблицаОтбор.Порядок
	|			И ВТ_ПорядокОтражения.ПравилоОтражения = ВТ_ТаблицаОтбор.ПравилоОтражения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУдержаний.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаУдержаний.Контрагент КАК Контрагент,
	|	ТаблицаУдержаний.Подразделение КАК Подразделение,
	|	ТаблицаУдержаний.ВидОперации КАК ВидОперации,
	|	ВТ_ИтоговаяУдержания.ЕПСПараметрОтраженияВБУ КАК ЕПСПараметрОтраженияВБУУдержания,
	|	ВТ_ИтоговаяНачисления.ЕПСПараметрОтраженияВБУ КАК ЕПСПараметрОтраженияВБУНачисления,
	|	ВТ_ИтоговаяУдержания.ПорядокПараметраОтраженияВБУ КАК ПорядокПараметраОтраженияВБУУдержания,
	|	ВТ_ИтоговаяНачисления.ПорядокПараметраОтраженияВБУ КАК ПорядокПараметраОтраженияВБУНачисления,
	|	ВТ_ИтоговаяУдержания.Счет КАК СчетУдержания,
	|	ВТ_ИтоговаяУдержания.Субконто1 КАК Субконто1,
	|	ВТ_ИтоговаяУдержания.Субконто2 КАК Субконто2,
	|	ВТ_ИтоговаяУдержания.Субконто3 КАК Субконто3,
	|	ТаблицаУдержаний.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТаблицаУдержаний.ЛицевойСчетНачУдержания КАК ЛицевойСчетНачУдержания,
	|	ТаблицаУдержаний.НазначениеПодотчетныхСредствПриВозмещениеУщерба КАК НазначениеПодотчетныхСредствПриВозмещениеУщерба
	|ПОМЕСТИТЬ ВТ_ПредварительныйРезультат
	|ИЗ
	|	ТаблицаУдержаний КАК ТаблицаУдержаний
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Итоговая КАК ВТ_ИтоговаяУдержания
	|		ПО (ВТ_ИтоговаяУдержания.ПравилоОтражения = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Удержания))
	|			И (ВЫБОР
	|				КОГДА ВТ_ИтоговаяУдержания.ПорядокПараметраОтраженияВБУ = 1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ТаблицаУдержаний.ВидОперации = ВТ_ИтоговаяУдержания.СпособОтраженияЗарплатыВБухУчете
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Итоговая КАК ВТ_ИтоговаяНачисления
	|		ПО (ВТ_ИтоговаяНачисления.ПравилоОтражения = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления))
	|			И (ВЫБОР
	|				КОГДА ВТ_ИтоговаяНачисления.ПорядокПараметраОтраженияВБУ = 1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ТаблицаУдержаний.ВидОперации = ВТ_ИтоговаяНачисления.СпособОтраженияЗарплатыВБухУчете
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
