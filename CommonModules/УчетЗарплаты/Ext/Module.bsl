////////////////////////////////////////////////////////////////////////////////
// УчетЗарплаты: методы, используемые:
//               - при настройке зарплаты и кадров;
//               - при отражении зарплаты и налогов/взносов с ФОТ в учете;
//               - при получении сведений о документах подсистем учета зарплаты и кадров;
//               - ...
////////////////////////////////////////////////////////////////////////////////

#Область ИнтерфейсВзаимодейтвияБЗКБ

////////////////////////////////////////////////////////////////////////////////
// ИНТЕРФЕЙС ВЗАИМОДЕЙСТВИЯ С БЗКБ
//
// Предназначена для генерации всех движений, связанных с отражением в регл. учете
//
// Параметры:
//	Движения
//	Отказ
//	Организация
//	ПериодРегистрации
//	ДанныеДляОтражения - таблицы движений
//
Процедура СформироватьДвиженияПоОтражениюЗарплатыВРегламентированномУчете(Движения, Отказ, Организация, ПериодРегистрации, ДанныеДляОтражения) Экспорт
	
	ВедетсяУчетРасчетовПоЗарплатеПоРаботникам = ПолучитьФункциональнуюОпцию("ВедетсяУчетРасчетовПоЗарплатеПоРаботникам");
	Если Не ВедетсяУчетРасчетовПоЗарплатеПоРаботникам Тогда
		ОбщегоНазначения.СообщитьПользователю("В форме ""Настройки зарплаты"" не установлен флаг ""Ведется учет расчетов по зарплате по работникам""! Проводки не будут сформированы");
		Возврат;
	КонецЕсли;
	
	// Резервы по отпускам
	Если ДанныеДляОтражения.Свойство("ОценочныеОбязательстваПоСотрудникам") Тогда
		ДанныеПоРезервам = ДанныеДляОтражения.ОценочныеОбязательстваПоСотрудникам;
		Если ДанныеПоРезервам.Количество() <> 0 Тогда
			СформироватьДвиженияНачислениеРезервов(Движения, Отказ, Организация, ПериодРегистрации, ДанныеПоРезервам);
		КонецЕсли;
	КонецЕсли;

	// Начисление зарплаты и налогов с ФОТ, НДФЛ
	ДанныеПоЗарплате = Новый Структура;
	Если ДанныеДляОтражения.Свойство("НачисленнаяЗарплатаИВзносы") Тогда
		ДанныеПоЗарплате.Вставить("НачисленнаяЗарплатаИВзносы", ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы);
		Если ДанныеДляОтражения.Свойство("УдержаннаяЗарплата") Тогда
			ДанныеПоЗарплате.Вставить("УдержаннаяЗарплата", ДанныеДляОтражения.УдержаннаяЗарплата);
		КонецЕсли;
	КонецЕсли;
	Если ДанныеДляОтражения.Свойство("НачисленныйНДФЛ") Тогда
		ДанныеПоЗарплате.Вставить("НачисленныйНДФЛ", ДанныеДляОтражения.НачисленныйНДФЛ);
	КонецЕсли;
	Если ДанныеПоЗарплате.Количество() <> 0 Тогда
		СформироватьДвиженияНачислениеЗарплаты(Движения, Отказ, Организация, ПериодРегистрации, ДанныеПоЗарплате);
	КонецЕсли;
	
	// Зачет аванса
	Если ДанныеДляОтражения.Свойство("ЗачетАванса") Тогда
		Если ДанныеДляОтражения.ЗачетАванса = Истина Тогда
			СформироватьДвиженияЗачетАванса(Движения, Отказ, Организация, ПериодРегистрации);
		КонецЕсли;
	КонецЕсли;

	// Депонирование выплат
	Если ДанныеДляОтражения.Свойство("Депоненты") Тогда
		ДанныеПоДепонентам = ДанныеДляОтражения.Депоненты;
		Если ДанныеПоДепонентам.Количество() <> 0 Тогда
			СформироватьДвиженияДепонированиеЗарплаты(Движения, Отказ, Организация, ПериодРегистрации, ДанныеПоДепонентам);
		КонецЕсли;
	КонецЕсли;
	
	// Удержания
	Если ДанныеДляОтражения.Свойство("УдержаннаяЗарплата") Тогда
		ДанныеПоУдержаниям = ДанныеДляОтражения.УдержаннаяЗарплата;
		Если ДанныеДляОтражения.Свойство("НачисленнаяЗарплатаИВзносы") Тогда
			НачисленнаяЗарплатаИВзносы = ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы;
		Иначе
			НачисленнаяЗарплатаИВзносы = Неопределено;
		КонецЕсли;
		Если ДанныеПоУдержаниям.Количество() <> 0 Тогда
			СформироватьДвиженияУдержания(Движения, Отказ, Организация, ПериодРегистрации, ДанныеПоУдержаниям, НачисленнаяЗарплатаИВзносы);
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти

#Область Начисление

Процедура СформироватьДвиженияЗачетАванса(Движения, Отказ, Организация, Знач ПериодРегистрации)
	
	Регистратор         = Движения.ЕПС.Отбор.Регистратор.Значение;
	ПериодРегистрации	= ПолучитьПериодРегистрации(Регистратор, ПериодРегистрации);

	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Организация", 	Организация);
	Реквизиты.Вставить("Период", 		ПериодРегистрации);

	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапросаСверткаПарныхСчетовДляЗачетаАвансов();
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Период",			Новый Граница(Реквизиты.Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Содержание",		"Свёртка парных лицевых счетов");
	Запрос.УстановитьПараметр("СчетАктивный",	ПланыСчетов.ЕПС.НайтиПоКоду("60306"));

	ДанныеСверткиПарныхСчетов = Запрос.Выполнить().Выгрузить();
	
	ЮС_РегламентныеОперации.СверткаПарныхСчетовРасчетовСКонтрагентами(Реквизиты, ДанныеСверткиПарныхСчетов, Движения, Отказ);
	
КонецПроцедуры

Функция ТекстЗапросаСверткаПарныхСчетовДляЗачетаАвансов() Экспорт

	// Расшифровка временных таблиц запроса:
	// ПарныеСчетаУчета 		- данные из р-ра ЕПСПарныеСчетаУчета
	// ПарныеЛицевыеСчета 	- данные парных лицевых счетов из р-ра ЕПСПарныеЛицевыеСчета по счетам из ПарныеСчетаУчета
	// РазличныеПарныеЛицевыеСчета - итоговая таблица данных парных лицевых счетов
	
	// СК [01.11.2022] - разбила субконто на СубконтоДт1,СубконтоДт2,СубконтоДт3,СубконтоКт1,СубконтоКт1,СубконтоКт1
	
	Возврат "ВЫБРАТЬ
	        |	ЕПСПарныеСчетаУчета.СчетАктивный КАК СчетАктивный,
	        |	ЕПСПарныеСчетаУчета.СчетПассивный КАК СчетПассивный
	        |ПОМЕСТИТЬ ПарныеСчетаУчета
	        |ИЗ
	        |	РегистрСведений.ЕПСПарныеСчетаУчета КАК ЕПСПарныеСчетаУчета
	        |ГДЕ
	        |	ЕПСПарныеСчетаУчета.СчетАктивный = &СчетАктивный
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ЕПСПарныеЛицевыеСчета.СчетАктивный КАК ЛицевойСчетАктивный,
	        |	ЕПСПарныеЛицевыеСчета.СчетПассивный КАК ЛицевойСчетПассивный,
	        |	ЕПСИспользуемыеЛицевыеСчета.Аналитика2 КАК Аналитика2
	        |ПОМЕСТИТЬ ПарныеЛицевыеСчета
	        |ИЗ
	        |	РегистрСведений.ЕПСПарныеЛицевыеСчета КАК ЕПСПарныеЛицевыеСчета
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЕПСИспользуемыеЛицевыеСчета КАК ЕПСИспользуемыеЛицевыеСчета
	        |		ПО ЕПСПарныеЛицевыеСчета.СчетАктивный = ЕПСИспользуемыеЛицевыеСчета.ЛицевойСчет
	        |ГДЕ
	        |	ЕПСПарныеЛицевыеСчета.Организация = &Организация
	        |	И ЕПСПарныеЛицевыеСчета.СчетАктивный.Владелец В
	        |			(ВЫБРАТЬ
	        |				ПарныеСчетаУчета.СчетАктивный
	        |			ИЗ
	        |				ПарныеСчетаУчета КАК ПарныеСчетаУчета)
	        |	И ЕПСПарныеЛицевыеСчета.СчетПассивный.Владелец В
	        |			(ВЫБРАТЬ
	        |				ПарныеСчетаУчета.СчетПассивный
	        |			ИЗ
	        |				ПарныеСчетаУчета КАК ПарныеСчетаУчета)
	        |	И ЕПСИспользуемыеЛицевыеСчета.Аналитика2 = ЗНАЧЕНИЕ(Перечисление.ЮС_ВидыВыплатРаботникам.ОплатаТруда)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	ЛицевыеСчета.ЛицевойСчет КАК ЛицевойСчет,
	        |	ВЫРАЗИТЬ(ЛицевыеСчета.ЛицевойСчет КАК Справочник.ЕПСЛицевыеСчета).Владелец КАК ЛицевойСчетВладелец
	        |ПОМЕСТИТЬ РазличныеПарныеЛицевыеСчета
	        |ИЗ
	        |	(ВЫБРАТЬ
	        |		ПарныеЛицевыеСчета.ЛицевойСчетАктивный КАК ЛицевойСчет
	        |	ИЗ
	        |		ПарныеЛицевыеСчета КАК ПарныеЛицевыеСчета
	        |	
	        |	ОБЪЕДИНИТЬ ВСЕ
	        |	
	        |	ВЫБРАТЬ
	        |		ПарныеЛицевыеСчета.ЛицевойСчетПассивный
	        |	ИЗ
	        |		ПарныеЛицевыеСчета КАК ПарныеЛицевыеСчета) КАК ЛицевыеСчета
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ЕПСОстатки.ЛицевойСчет КАК ЛицевойСчет,
	        |	ЕПСОстатки.Субконто1 КАК Субконто1,
	        |	ЕПСОстатки.Субконто2 КАК Субконто2,
	        |	ЕПСОстатки.Субконто3 КАК Субконто3,
	        |	ЕПСОстатки.Валюта КАК Валюта,
	        |	ЕПСОстатки.СуммаОстаток * ВЫБОР
	        |		КОГДА ЕПСОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	        |			ТОГДА -1
	        |		ИНАЧЕ 1
	        |	КОНЕЦ КАК СуммаОстаток,
	        |	ЕСТЬNULL(ЕПСОстатки.СуммаНУОстаток, 0) * ВЫБОР
	        |		КОГДА ЕПСОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	        |			ТОГДА -1
	        |		ИНАЧЕ 1
	        |	КОНЕЦ КАК СуммаНУОстаток,
	        |	ЕСТЬNULL(ЕПСОстатки.СуммаПРОстаток, 0) * ВЫБОР
	        |		КОГДА ЕПСОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	        |			ТОГДА -1
	        |		ИНАЧЕ 1
	        |	КОНЕЦ КАК СуммаПРОстаток,
	        |	ЕСТЬNULL(ЕПСОстатки.СуммаВРОстаток, 0) * ВЫБОР
	        |		КОГДА ЕПСОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	        |			ТОГДА -1
	        |		ИНАЧЕ 1
	        |	КОНЕЦ КАК СуммаВРОстаток,
	        |	ЕСТЬNULL(ЕПСОстатки.ВалютнаяСуммаОстаток, 0) * ВЫБОР
	        |		КОГДА ЕПСОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	        |			ТОГДА -1
	        |		ИНАЧЕ 1
	        |	КОНЕЦ КАК ВалютнаяСуммаОстаток,
	        |	ЕПСОстатки.Подразделение КАК Подразделение
	        |ПОМЕСТИТЬ ДанныеРегистра
	        |ИЗ
	        |	РегистрБухгалтерии.ЕПС.Остатки(
	        |			&Период,
	        |			Счет В
	        |				(ВЫБРАТЬ
	        |					РазличныеПарныеЛицевыеСчета.ЛицевойСчетВладелец
	        |				ИЗ
	        |					РазличныеПарныеЛицевыеСчета КАК РазличныеПарныеЛицевыеСчета),
	        |			,
	        |			Организация = &Организация
	        |				И ЛицевойСчет В
	        |					(ВЫБРАТЬ
	        |						РазличныеПарныеЛицевыеСчета.ЛицевойСчет
	        |					ИЗ
	        |						РазличныеПарныеЛицевыеСчета КАК РазличныеПарныеЛицевыеСчета)) КАК ЕПСОстатки
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВложенныйЗапрос.ЛицевойСчетАктивный КАК ЛицевойСчетАктивный,
	        |	ВложенныйЗапрос.ЛицевойСчетПассивный КАК ЛицевойСчетПассивный,
	        |	ВложенныйЗапрос.Субконто1 КАК Субконто1,
	        |	ВложенныйЗапрос.Субконто2 КАК Субконто2,
	        |	ВложенныйЗапрос.Субконто3 КАК Субконто3,
	        |	ВложенныйЗапрос.Валюта КАК Валюта,
	        |	ВложенныйЗапрос.Подразделение КАК Подразделение,
	        |	СУММА(ВложенныйЗапрос.СуммаАктивный) КАК СуммаАктивный,
	        |	СУММА(ВложенныйЗапрос.СуммаНУАктивный) КАК СуммаНУАктивный,
	        |	СУММА(ВложенныйЗапрос.СуммаПРАктивный) КАК СуммаПРАктивный,
	        |	СУММА(ВложенныйЗапрос.СуммаВРАктивный) КАК СуммаВРАктивный,
	        |	СУММА(ВложенныйЗапрос.ВалютнаяСуммаАктивный) КАК ВалютнаяСуммаАктивный,
	        |	СУММА(ВложенныйЗапрос.СуммаПассивный) КАК СуммаПассивный,
	        |	СУММА(ВложенныйЗапрос.СуммаНУПассивный) КАК СуммаНУПассивный,
	        |	СУММА(ВложенныйЗапрос.СуммаПРПассивный) КАК СуммаПРПассивный,
	        |	СУММА(ВложенныйЗапрос.СуммаВРПассивный) КАК СуммаВРПассивный,
	        |	СУММА(ВложенныйЗапрос.ВалютнаяСуммаПассивный) КАК ВалютнаяСуммаПассивный,
	        |	ВЫБОР
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаАктивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаАктивный) < 0
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаНУАктивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаНУАктивный) < 0
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаПРАктивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаПРАктивный) < 0
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаВРАктивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаВРАктивный) < 0
	        |		ИНАЧЕ ЛОЖЬ
	        |	КОНЕЦ КАК ОтрицательныйОстатокАктивный,
	        |	ВЫБОР
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаПассивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаПассивный) < 0
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаНУПассивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаНУПассивный) < 0
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаПРПассивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаПРПассивный) < 0
	        |		КОГДА СУММА(ВложенныйЗапрос.СуммаВРПассивный) <> 0
	        |			ТОГДА СУММА(ВложенныйЗапрос.СуммаВРПассивный) < 0
	        |		ИНАЧЕ ЛОЖЬ
	        |	КОНЕЦ КАК ОтрицательныйОстатокПассивный
	        |ПОМЕСТИТЬ ДанныеСвертки
	        |ИЗ
	        |	(ВЫБРАТЬ
	        |		ПарныеЛицевыеСчета.ЛицевойСчетАктивный КАК ЛицевойСчетАктивный,
	        |		ПарныеЛицевыеСчета.ЛицевойСчетПассивный КАК ЛицевойСчетПассивный,
	        |		ДанныеРегистра.Субконто1 КАК Субконто1,
	        |		ДанныеРегистра.Субконто2 КАК Субконто2,
	        |		ДанныеРегистра.Субконто3 КАК Субконто3,
	        |		ДанныеРегистра.Валюта КАК Валюта,
	        |		ДанныеРегистра.Подразделение КАК Подразделение,
	        |		ДанныеРегистра.СуммаОстаток КАК СуммаАктивный,
	        |		ДанныеРегистра.СуммаНУОстаток КАК СуммаНУАктивный,
	        |		ДанныеРегистра.СуммаПРОстаток КАК СуммаПРАктивный,
	        |		ДанныеРегистра.СуммаВРОстаток КАК СуммаВРАктивный,
	        |		ДанныеРегистра.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаАктивный,
	        |		0 КАК СуммаПассивный,
	        |		0 КАК СуммаНУПассивный,
	        |		0 КАК СуммаПРПассивный,
	        |		0 КАК СуммаВРПассивный,
	        |		0 КАК ВалютнаяСуммаПассивный
	        |	ИЗ
	        |		ПарныеЛицевыеСчета КАК ПарныеЛицевыеСчета
	        |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеРегистра КАК ДанныеРегистра
	        |			ПО ПарныеЛицевыеСчета.ЛицевойСчетАктивный = ДанныеРегистра.ЛицевойСчет
	        |	
	        |	ОБЪЕДИНИТЬ ВСЕ
	        |	
	        |	ВЫБРАТЬ
	        |		ПарныеЛицевыеСчета.ЛицевойСчетАктивный,
	        |		ПарныеЛицевыеСчета.ЛицевойСчетПассивный,
