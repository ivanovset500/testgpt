	|			И ВТ_ПредварительныйРезультат.ПорядокПараметраОтраженияВБУНачисления = ВТ_РезультатПромежуточная.ПорядокПараметраОтраженияВБУНачисления
	|			И ВТ_ПредварительныйРезультат.ФизическоеЛицо = ВТ_РезультатПромежуточная.ФизическоеЛицо
	|			И ВТ_ПредварительныйРезультат.Контрагент = ВТ_РезультатПромежуточная.Контрагент
	|			И ВТ_ПредварительныйРезультат.Подразделение = ВТ_РезультатПромежуточная.Подразделение
	|			И ВТ_ПредварительныйРезультат.ВидОперации = ВТ_РезультатПромежуточная.ВидОперации";
		
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
