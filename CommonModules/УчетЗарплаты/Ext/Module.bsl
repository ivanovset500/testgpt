	ТаблицаНДФЛ.Колонки.Добавить("Организация",                 Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаНДФЛ.Колонки.Добавить("РегистрацияВНалоговомОргане", Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
	ТаблицаНДФЛ.Колонки.Добавить("КодНалоговогоОргана",         Новый ОписаниеТипов("Строка"));
	ТаблицаНДФЛ.Колонки.Добавить("Налог",                       Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежейВБюджет"));
	ТаблицаНДФЛ.Колонки.Добавить("ВидНалога",                   Новый ОписаниеТипов("ПеречислениеСсылка.ВидыНалогов"));
	ТаблицаНДФЛ.Колонки.Добавить("КБК",                         Новый ОписаниеТипов("Строка"));
	ТаблицаНДФЛ.Колонки.Добавить("КПП",                         Новый ОписаниеТипов("Строка"));
	ТаблицаНДФЛ.Колонки.Добавить("ОКАТО",                       Новый ОписаниеТипов("Строка"));
	ТаблицаНДФЛ.Колонки.Добавить("Сумма",                       Новый ОписаниеТипов("Число"));
	ТаблицаНДФЛ.Колонки.Добавить("СрокУплаты",                  Новый ОписаниеТипов("Дата"));
	
	Возврат ТаблицаНДФЛ;
	
КонецФункции

#Область РегламентныеОперации

// Формирование переноса остатков резервов по отпускам за прошлый год
//
// Параметры:
//  Движения	 - КоллекцияДвижений	 - коллекция движений документа, который выполняет перенос
//  Реквизиты	 - СтрокаТаблицыЗначений - строка таблицы параметров проведения
//  МассивОшибок - Массив - массив ошибок, которые могут возникнуть при выполнении переноса 
//
Процедура СформироватьПереносОстатковРезервовПоОтпускамЗаПрошлыйГод(Движения, Реквизиты, МассивОшибок) Экспорт
		
	МассивСчетаУчетаВознагражденияРаботникам = Новый Массив;
	МассивСчетаУчетаВознагражденияРаботникам.Добавить(ПланыСчетов.ЕПС.ОбязательстваПоВыплатеКраткосрочныхВознагражденийРаботникам); // 60305
	// 60306 не используем, т.к. нет базовых операций, когда резервы ведутся на этом счете
	
	МассивСчетаУчетаСтраховыхВзносовПоРезервамОтпусков = Новый Массив;
	МассивСчетаУчетаСтраховыхВзносовПоРезервамОтпусков.Добавить(ПланыСчетов.ЕПС.РасчетыПоСоциальномуСтрахованиюИОбеспечениюП); // 60335
	// 60336 не используем, т.к. нет базовых операций, когда резервы страховых взносов ведутся на этом счете

	МассивВидовРезервовПоОтпускам = Новый Массив;
	МассивВидовРезервовПоОтпускам.Добавить(Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускам);
	МассивВидовРезервовПоОтпускам.Добавить(Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускамДо2022Года);
	МассивВидовРезервовПоОтпускам.Добавить(Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускамЗаПрошлыеПериоды); 
	
	МассивВидовСтраховыхВзносов = Новый Массив;
	МассивВидовСтраховыхВзносов.Добавить(Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускам);
	МассивВидовСтраховыхВзносов.Добавить(Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамДо2022Года);
	МассивВидовСтраховыхВзносов.Добавить(Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамЗаПрошлыеПериоды);

	ОсновноеПодразделение = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации");
	// Чтобы не подставлять подразделение от другой организации
	Если ОсновноеПодразделение.Владелец <> Реквизиты.Организация Тогда
		ОсновноеПодразделение = Неопределено;
	КонецЕсли;
	
	// Собрать таблицы с остатками резервов
	// - по БУ, остатки по резервам (текущего года и прошлого)
	// - по управленческому учета, по регистру накопления (остатки общие)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьЗапросДляПолученияОстатковПоРезервамПоОтпускам();
	
	Запрос.УстановитьПараметр("Период", 								Новый Граница(Реквизиты.Период, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 							Реквизиты.Организация);
	Запрос.УстановитьПараметр("СчетаУчетаВознагражденияРаботникам", 	МассивСчетаУчетаВознагражденияРаботникам);
	Запрос.УстановитьПараметр("ВидыРезервовПоОтпускам", 				МассивВидовРезервовПоОтпускам);
	Запрос.УстановитьПараметр("СчетаУчетаСтраховыхВзносовПоОтпускам", 	МассивСчетаУчетаСтраховыхВзносовПоРезервамОтпусков);
	Запрос.УстановитьПараметр("ВидыСтраховыхВзносов", 					МассивВидовСтраховыхВзносов);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ОстаткиРезервовПоОтпускамСотрудникиБУ 	= РезультатЗапроса[1].Выбрать();
	ОстаткиРезервовПоОтпускамСотрудникиУпр 	= РезультатЗапроса[3].Выбрать();
	ОстаткиРезервовПоОтпускамВзносыБУ       = РезультатЗапроса[5].Выбрать();
	
	// ФОРМИРОВАНИЕ ДВИЖЕНИЙ
	
	ТаблицаПроверкиБУИУпрУчета = Новый ТаблицаЗначений;
	ТаблицаПроверкиБУИУпрУчета.Колонки.Добавить("ФизическоеЛицо");
	ТаблицаПроверкиБУИУпрУчета.Колонки.Добавить("СуммаРезерва");
	
	Пока ОстаткиРезервовПоОтпускамСотрудникиБУ.Следующий() Цикл
		
		ТипВыплатыРаботникуРезервыЗаПрошлыеПериоды 			= Перечисления.ЮС_ВидыВыплатРаботникам.РезервыПоОтпускамЗаПрошлыеПериоды;
		ИспользуемыеСчетаПоРаботникуРезервыЗаПрошлыеПериоды	= ЮС_СчетаУчетаВДокументах.ПолучитьСчетаРасчетовСРаботниками(Реквизиты.Организация, 
		ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто1,, ТипВыплатыРаботникуРезервыЗаПрошлыеПериоды);
		
		Если ИспользуемыеСчетаПоРаботникуРезервыЗаПрошлыеПериоды = Неопределено
			Или Не ЗначениеЗаполнено(ИспользуемыеСчетаПоРаботникуРезервыЗаПрошлыеПериоды.СчетУчетаПассивный) Тогда
			
			ШаблонСообщения = НСтр("ru = 'По сотруднику %1 не найдены лицевые счета для учета резервов отпусков за прошлые периоды! Перенос не будет сформирован'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто1);
			МассивОшибок.Добавить(ТекстСообщения);
			
			Продолжить;
			
		КонецЕсли;
		
		ЮС_УправлениеЛомбардом.СформироватьПроводкуЕПС(Движения.ЕПС, Реквизиты.Период, Реквизиты.Организация, 
			ОстаткиРезервовПоОтпускамСотрудникиБУ.СуммаРезерваБУ,,,,,,,
			,,
			"Перенос суммы сформированного резерва за прошлый период",,
			ОстаткиРезервовПоОтпускамСотрудникиБУ.ЛицевойСчет.Владелец, ИспользуемыеСчетаПоРаботникуРезервыЗаПрошлыеПериоды.СчетУчетаПассивный.Владелец,
			ОстаткиРезервовПоОтпускамСотрудникиБУ.ЛицевойСчет, ИспользуемыеСчетаПоРаботникуРезервыЗаПрошлыеПериоды.СчетУчетаПассивный,
			ОсновноеПодразделение, ОсновноеПодразделение, // резервы всегда на основном подразделении
			ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто1, ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто2,,
			ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто1, ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто2);
		
		СтрокаТаблицаПроверкиБУИУпрУчета = ТаблицаПроверкиБУИУпрУчета.Найти(ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто1, "ФизическоеЛицо");	
		Если СтрокаТаблицаПроверкиБУИУпрУчета = Неопределено Тогда
			НоваяСтрокаТаблицаПроверкиБУИУпрУчета = ТаблицаПроверкиБУИУпрУчета.Добавить();
			НоваяСтрокаТаблицаПроверкиБУИУпрУчета.ФизическоеЛицо 	= ОстаткиРезервовПоОтпускамСотрудникиБУ.Субконто1;
			НоваяСтрокаТаблицаПроверкиБУИУпрУчета.СуммаРезерва 		= ОстаткиРезервовПоОтпускамСотрудникиБУ.СуммаРезерваБУ;
		Иначе
			СтрокаТаблицаПроверкиБУИУпрУчета.СуммаРезерва = СтрокаТаблицаПроверкиБУИУпрУчета.СуммаРезерва + ОстаткиРезервовПоОтпускамСотрудникиБУ.СуммаРезерваБУ;
		КонецЕсли;
		
	КонецЦикла;
		
	Пока ОстаткиРезервовПоОтпускамСотрудникиУпр.Следующий() Цикл
		
		СтрокаТаблицаПроверкиБУИУпрУчета = ТаблицаПроверкиБУИУпрУчета.Найти(ОстаткиРезервовПоОтпускамСотрудникиУпр.ФизическоеЛицо, "ФизическоеЛицо");	
		Если СтрокаТаблицаПроверкиБУИУпрУчета = Неопределено Тогда
			СтрокаТаблицаПроверкиБУИУпрУчета = Новый Структура;
			СтрокаТаблицаПроверкиБУИУпрУчета.Вставить("ФизическоеЛицо", 	ОстаткиРезервовПоОтпускамСотрудникиУпр.ФизическоеЛицо);
			СтрокаТаблицаПроверкиБУИУпрУчета.Вставить("СуммаРезерва", 		0);
		КонецЕсли;	
		Если СтрокаТаблицаПроверкиБУИУпрУчета.СуммаРезерва <> ОстаткиРезервовПоОтпускамСотрудникиУпр.СуммаРезерваУпр Тогда
			
			ШаблонСообщения = НСтр("ru = 'По сотруднику %1 обнаружено расхождение бухгалтерского и управленческого учета по суммам резервов по отпускам!
				|Сумма по БУ %2, сумма по управленческому учету %3'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
				ОстаткиРезервовПоОтпускамСотрудникиУпр.ФизическоеЛицо, СтрокаТаблицаПроверкиБУИУпрУчета.СуммаРезерва, ОстаткиРезервовПоОтпускамСотрудникиУпр.СуммаРезерваУпр);
			МассивОшибок.Добавить(ТекстСообщения);
			
			Продолжить;
			
		КонецЕсли;
		
		СуммаРезерваДляОтражения = ОстаткиРезервовПоОтпускамСотрудникиУпр.СуммаРезерваУпр - ОстаткиРезервовПоОтпускамСотрудникиУпр.СуммаРезерваПрошлыйПериодУпр;
		СуммаРезерваВзносыДляОтражения = ОстаткиРезервовПоОтпускамСотрудникиУпр.СуммаРезерваВзносыУпр - ОстаткиРезервовПоОтпускамСотрудникиУпр.СуммаРезерваВзносыПрошлыйПериодУпр;
		
		Если СуммаРезерваДляОтражения <> 0 
			Или СуммаРезерваВзносыДляОтражения <> 0 Тогда
			НоваяСтрока = Движения.ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериоды.ДобавитьПриход();
			НоваяСтрока.Организация    		= Реквизиты.Организация;
			НоваяСтрока.Период         		= Реквизиты.Период;
			НоваяСтрока.ФизическоеЛицо	 	= ОстаткиРезервовПоОтпускамСотрудникиУпр.ФизическоеЛицо;
			НоваяСтрока.СуммаРезерва        = СуммаРезерваДляОтражения;
			НоваяСтрока.СуммаРезерваВзносы 	= СуммаРезерваВзносыДляОтражения;
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериоды.Записывать = Истина;

	ПараметрОтраженияВБУСтраховыеВзносы = ЮС_СчетаУчетаВДокументах.ПараметрОтраженияВБУСтраховыеВзносы();
	ВидСтраховогоВзносаПоРезервамПоОтпускамПрошлогоПериода 		= Перечисления.ЮС_ВидыСтраховыхВзносов.СтраховыеВзносыПоРезервамПоОтпускамЗаПрошлыеПериоды;
	ИспользуемыеСчетаВзносыПоРезервамПоОтпускамПрошлогоПериода	= ЮС_СчетаУчетаВДокументах.ПолучитьСчетаУчетаВидовСтраховыхВзносов(
		Реквизиты.Организация, 
		ВидСтраховогоВзносаПоРезервамПоОтпускамПрошлогоПериода,
		ПараметрОтраженияВБУСтраховыеВзносы);
	Если ИспользуемыеСчетаВзносыПоРезервамПоОтпускамПрошлогоПериода = Неопределено
		Или Не ЗначениеЗаполнено(ИспользуемыеСчетаВзносыПоРезервамПоОтпускамПрошлогоПериода.СчетУчетаПассивный) Тогда
		
		ТекстСообщения = НСтр("ru = 'По виду страхового взноса ""Страховые взносы по резервам по отпускам за прошлые периоды"" не найдены лицевые счета! Перенос не будет сформирован'");
		МассивОшибок.Добавить(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;

	Пока ОстаткиРезервовПоОтпускамВзносыБУ.Следующий() Цикл
		
		ЮС_УправлениеЛомбардом.СформироватьПроводкуЕПС(Движения.ЕПС, Реквизиты.Период, Реквизиты.Организация, 
			ОстаткиРезервовПоОтпускамВзносыБУ.СуммаРезерваВзносыБУ,,,,,,,
			,,
			"Перенос суммы сформированного резерва по страховым взносам за прошлый период",,
			ОстаткиРезервовПоОтпускамВзносыБУ.ЛицевойСчет.Владелец, ИспользуемыеСчетаВзносыПоРезервамПоОтпускамПрошлогоПериода.СчетУчетаПассивный.Владелец,
			ОстаткиРезервовПоОтпускамВзносыБУ.ЛицевойСчет, ИспользуемыеСчетаВзносыПоРезервамПоОтпускамПрошлогоПериода.СчетУчетаПассивный,
			ОсновноеПодразделение, ОсновноеПодразделение, // резервы по страховым взносам всегда на основном подразделении
			Перечисления.ВидыПлатежейВГосБюджет.Налог,,,
			Перечисления.ВидыПлатежейВГосБюджет.Налог);
				
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗапросДляПолученияОстатковПоРезервамПоОтпускам()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЕПСОстатки.Счет КАК Счет,
	               |	ЕПСОстатки.Субконто1 КАК Субконто1,
	               |	ЕПСОстатки.Субконто2 КАК Субконто2,
	               |	ЕПСОстатки.Организация КАК Организация,
	               |	ЕПСОстатки.ЛицевойСчет КАК ЛицевойСчет,
	               |	ЕПСОстатки.СуммаОстатокКт КАК СуммаРезерваБУ
	               |ПОМЕСТИТЬ ВрТ_ОстаткиБУ
	               |ИЗ
	               |	РегистрБухгалтерии.ЕПС.Остатки(&Период, Счет В (&СчетаУчетаВознагражденияРаботникам), , Организация = &Организация) КАК ЕПСОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВрТ_ОстаткиБУ.Счет КАК Счет,
	               |	ВрТ_ОстаткиБУ.Субконто1 КАК Субконто1,
	               |	ВрТ_ОстаткиБУ.Субконто2 КАК Субконто2,
	               |	ВрТ_ОстаткиБУ.Организация КАК Организация,
	               |	ВрТ_ОстаткиБУ.ЛицевойСчет КАК ЛицевойСчет,
	               |	ВрТ_ОстаткиБУ.СуммаРезерваБУ КАК СуммаРезерваБУ,
	               |	ЕПСИспользуемыеЛицевыеСчета.Аналитика2 КАК ВидВыплаты
	               |ИЗ
	               |	ВрТ_ОстаткиБУ КАК ВрТ_ОстаткиБУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЕПСИспользуемыеЛицевыеСчета КАК ЕПСИспользуемыеЛицевыеСчета
	               |		ПО ВрТ_ОстаткиБУ.Счет = ЕПСИспользуемыеЛицевыеСчета.СчетУчета
	               |			И ВрТ_ОстаткиБУ.ЛицевойСчет = ЕПСИспользуемыеЛицевыеСчета.ЛицевойСчет
	               |ГДЕ
	               |	ЕПСИспользуемыеЛицевыеСчета.Аналитика2 В(&ВидыРезервовПоОтпускам)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериодыОстатки.Организация КАК Организация,
	               |	ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериодыОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	               |	ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериодыОстатки.СуммаРезерваОстаток КАК СуммаРезерваОстаток,
	               |	ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериодыОстатки.СуммаРезерваВзносыОстаток КАК СуммаРезерваВзносыОстаток
	               |ПОМЕСТИТЬ ВрТ_ОстаткиПоРезервамЗаПрошедшиеПериоды
	               |ИЗ
	               |	РегистрНакопления.ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериоды.Остатки(&Период, Организация = &Организация) КАК ОценочныеОбязательстваПоСотрудникамЗаПрошедшиеПериодыОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОценочныеОбязательстваПоСотрудникамОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	               |	ОценочныеОбязательстваПоСотрудникамОстатки.СуммаРезерваОстаток КАК СуммаРезерваУпр,
	               |	ОценочныеОбязательстваПоСотрудникамОстатки.СуммаРезерваСтраховыхВзносовОстаток + ОценочныеОбязательстваПоСотрудникамОстатки.СуммаРезерваФССНесчастныеСлучаиОстаток КАК СуммаРезерваВзносыУпр,
	               |	ЕСТЬNULL(ВрТ_ОстаткиПоРезервамЗаПрошедшиеПериоды.СуммаРезерваОстаток, 0) КАК СуммаРезерваПрошлыйПериодУпр,
	               |	ЕСТЬNULL(ВрТ_ОстаткиПоРезервамЗаПрошедшиеПериоды.СуммаРезерваВзносыОстаток, 0) КАК СуммаРезерваВзносыПрошлыйПериодУпр
	               |ИЗ
	               |	РегистрНакопления.ОценочныеОбязательстваПоСотрудникам.Остатки(&Период, Организация = &Организация) КАК ОценочныеОбязательстваПоСотрудникамОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВрТ_ОстаткиПоРезервамЗаПрошедшиеПериоды КАК ВрТ_ОстаткиПоРезервамЗаПрошедшиеПериоды
	               |		ПО ОценочныеОбязательстваПоСотрудникамОстатки.ФизическоеЛицо = ВрТ_ОстаткиПоРезервамЗаПрошедшиеПериоды.ФизическоеЛицо
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕПСОстатки.Счет КАК Счет,
	               |	ЕПСОстатки.Субконто1 КАК Субконто1,
