	|	ВТ_ТаблицаСПроводками.ВедущийВидОперации КАК ВедущийВидОперации,
	|	ВТ_ТаблицаСПроводками.РасчетныйДокумент КАК РасчетныйДокумент,
	|	ВТ_ТаблицаСПроводками.СтатьяРасходов КАК СтатьяРасходов,
	|	ВТ_ТаблицаСПроводками.ЭтоМатериальнаяПомощь КАК ЭтоМатериальнаяПомощь,
	|	ВТ_ТаблицаСПроводками.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ВТ_ИтоговаяТаблица
	|ИЗ
	|	ВТ_ТаблицаСПроводками КАК ВТ_ТаблицаСПроводками
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПорядокОтраженияЗарплатыВБухУчете КАК ПорядокОтраженияЗарплатыВБухУчете
	|		ПО ВТ_ТаблицаСПроводками.СпособОтраженияЗарплатыВБухУчете = ПорядокОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете
	|			И (ВТ_ТаблицаСПроводками.ОблагаетсяЕНВД)
	|			И (ЕСТЬNULL(ВТ_ТаблицаСПроводками.Счет, ЗНАЧЕНИЕ(Справочник.ЕПСЛицевыеСчета.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ЕПСЛицевыеСчета.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИтоговаяТаблица.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТ_ИтоговаяТаблица.Сумма КАК Сумма,
	|	ВТ_ИтоговаяТаблица.ВидОперации КАК ВидОперации,
	|	ВТ_ИтоговаяТаблица.ВидНачисленияОплатыТрудаДляНУ КАК ВидНачисленияОплатыТрудаДляНУ,
	|	ВТ_ИтоговаяТаблица.ОблагаетсяЕНВД КАК ОблагаетсяЕНВД,
	|	ВТ_ИтоговаяТаблица.СпособОтраженияЗарплатыВБухУчете КАК СпособОтраженияЗарплатыВБухУчете,
	|	ВТ_ИтоговаяТаблица.Подразделение КАК Подразделение,
	|	ВТ_ИтоговаяТаблица.ПодразделениеУчетаНачислений КАК ПодразделениеУчетаНачислений,
	|	ВТ_ИтоговаяТаблица.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ВТ_ИтоговаяТаблица.Счет КАК Счет,
	|	ВТ_ИтоговаяТаблица.Субконто1 КАК Субконто1,
	|	ВТ_ИтоговаяТаблица.Субконто2 КАК Субконто2,
	|	ВТ_ИтоговаяТаблица.Субконто3 КАК Субконто3,
	|	ВТ_ИтоговаяТаблица.СчетНУ КАК СчетНУ,
	|	ВТ_ИтоговаяТаблица.СубконтоНУ1 КАК СубконтоНУ1,
	|	ВТ_ИтоговаяТаблица.СубконтоНУ2 КАК СубконтоНУ2,
	|	ВТ_ИтоговаяТаблица.СубконтоНУ3 КАК СубконтоНУ3,
	|	ВТ_ИтоговаяТаблица.ВидОперацииРасходовЗаСчетФСС КАК ВидОперацииРасходовЗаСчетФСС,
	|	ВТ_ИтоговаяТаблица.ВедущийВидОперации КАК ВедущийВидОперации,
	|	ВТ_ИтоговаяТаблица.РасчетныйДокумент КАК РасчетныйДокумент,
	|	ВТ_ИтоговаяТаблица.СтатьяРасходов КАК СтатьяРасходов,
	|	ВТ_ИтоговаяТаблица.ЭтоМатериальнаяПомощь КАК ЭтоМатериальнаяПомощь,
	|	ВТ_ИтоговаяТаблица.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	ВТ_ИтоговаяТаблица КАК ВТ_ИтоговаяТаблица";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьПорядокОтраженияЗарплаты(ПравилоОтражения, Реквизиты, СпособОтражения = Неопределено)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", 		Реквизиты.Организация);
	Запрос.УстановитьПараметр("ПравилоОтражения",	ПравилоОтражения);
	Запрос.УстановитьПараметр("СпособОтражения", 	СпособОтражения);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете,
	|	ЕПСПорядокОтраженияЗарплаты.Счет,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто2,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто3,
	|	ЕПСПорядокОтраженияЗарплаты.ЕПСПараметрОтраженияВБУ,
	|	ЕПСПорядокОтраженияЗарплаты.СчетНУ,
	|	ЕПСПорядокОтраженияЗарплаты.СубконтоНУ1,
	|	ЕПСПорядокОтраженияЗарплаты.СубконтоНУ2,
	|	ЕПСПорядокОтраженияЗарплаты.СубконтоНУ3,
	|	ЕПСПорядокОтраженияЗарплаты.ЕНВД,
	|	0 КАК Порядок
	|ПОМЕСТИТЬ ВТ_ПорядокОтражения
	|ИЗ
	|	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
	|ГДЕ
	|	ЕПСПорядокОтраженияЗарплаты.Организация = &Организация
	|	И ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения = &ПравилоОтражения
	|	И ВЫБОР
	|			КОГДА &СпособОтражения = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете = &СпособОтражения
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете,
	|	ЕПСПорядокОтраженияЗарплаты.Счет,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто2,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто3,
	|	ЕПСПорядокОтраженияЗарплаты.ЕПСПараметрОтраженияВБУ,
	|	ЕПСПорядокОтраженияЗарплаты.СчетНУ,
	|	ЕПСПорядокОтраженияЗарплаты.СубконтоНУ1,
	|	ЕПСПорядокОтраженияЗарплаты.СубконтоНУ2,
	|	ЕПСПорядокОтраженияЗарплаты.СубконтоНУ3,
	|	ЕПСПорядокОтраженияЗарплаты.ЕНВД,
	|	1
	|ИЗ
	|	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
	|ГДЕ
	|	ЕПСПорядокОтраженияЗарплаты.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения = &ПравилоОтражения
	|	И ВЫБОР
	|			КОГДА &СпособОтражения = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете = &СпособОтражения
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете,
	|	МИНИМУМ(ВТ_ПорядокОтражения.Порядок) КАК Порядок
	|ПОМЕСТИТЬ ВТ_ТаблицаОтбор
	|ИЗ
	|	ВТ_ПорядокОтражения КАК ВТ_ПорядокОтражения
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете,
	|	ВТ_ПорядокОтражения.ЕНВД,
	|	ВТ_ПорядокОтражения.Счет,
	|	ВТ_ПорядокОтражения.Субконто1,
	|	ВТ_ПорядокОтражения.Субконто2,
	|	ВТ_ПорядокОтражения.Субконто3,
	|	ВТ_ПорядокОтражения.ЕПСПараметрОтраженияВБУ,
	|	ВТ_ПорядокОтражения.СчетНУ,
	|	ВТ_ПорядокОтражения.СубконтоНУ1,
	|	ВТ_ПорядокОтражения.СубконтоНУ2,
	|	ВТ_ПорядокОтражения.СубконтоНУ3
	|ИЗ
	|	ВТ_ПорядокОтражения КАК ВТ_ПорядокОтражения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаОтбор КАК ВТ_ТаблицаОтбор
	|		ПО ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете = ВТ_ТаблицаОтбор.СпособОтраженияЗарплатыВБухУчете
	|			И ВТ_ПорядокОтражения.Порядок = ВТ_ТаблицаОтбор.Порядок";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		
		ПустаяТаблица = РегистрыСведений.ЕПСПорядокОтраженияЗарплаты.СоздатьНаборЗаписей().ВыгрузитьКолонки();
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДополнитьТаблицуНачисленийПараметрамиОтраженияВБУ(ПравилоОтражения, Реквизиты, ТаблицаНачислений)
	
	Запрос = Новый Запрос;
	
	Если ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Начисления Тогда
		
		МассивОпераций = Новый Массив;
	
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НачисленоСдельноДоход);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДивидендыСотрудников);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФССНС);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФСС);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюРаботодатель);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюБюджет);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДоговорАвторскогоЗаказа);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДоговорРаботыУслуги);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.МатериальнаяПомощь);
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпуска);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЕжегодногоОтпускаОценочныеОбязательства);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательстваИРезервы);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.КомпенсацияЗаЗадержкуЗарплаты);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПрочиеРасчетыСПерсоналом);
				
	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Взносы Тогда
		
		МассивОпераций = Новый Массив;
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРНакопительнаяЧасть);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРСтраховаяЧасть);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРПоСуммарномуТарифу);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРДоПредельнойВеличины);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРСПревышения);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифЛЭ);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифШахтеры);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаПодземныхИВредныхРаботах);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ФСС);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ФССНС);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ФФОМС);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ТФОМС);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.СтраховыеВзносыПоРезервамПоОтпускам);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПособиеНаПогребение);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВзносыПоЕдиномуТарифу);

	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.НДФЛ Тогда
		
		МассивОпераций = Новый Массив;
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛ); 
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛСПревышения); 
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛДоначисленныйПоРезультатамПроверки);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛДоходыКонтрагентов);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛПередачаЗадолженностиВНалоговыйОрган);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛПрочиеРасчетыСПерсоналом);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛРасчетыСБывшимиСотрудниками);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НФДЛДивиденды);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НФДЛДивидендыСотрудникам);
		
	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Удержания Тогда
		
		МассивОпераций = Новый Массив;
	
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПогашениеЗаймов);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПроцентыПоЗайму);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛисты);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДСВ);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.Профвзносы);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ДобровольныеВзносыВНПФ);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВознаграждениеПлатежногоАгента);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВозмещениеУщерба);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеПоПрочимОперациямСРаботниками);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ВозвратИзлишнеВыплаченныхСуммВследствиеСчетныхОшибок);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.УдержаниеЗаОтпуск);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму); 
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПрочиеУдержания); 
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ПогашениеПроцентовПоЗайму); 
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.СписаниеКорректировкиАСПоЗайму); 

	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.Депонирование Тогда
		
		МассивОпераций = Новый Массив;
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.Депонирование); 
	
	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.СписаниеДепонента Тогда
		
		МассивОпераций = Новый Массив;
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.СписаниеДепонента);

	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.РезервыПоОтпускам Тогда
		
		МассивОпераций = Новый Массив;
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпуск);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервы);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательства);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательстваИРезервы);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускРезервыЗаПрошлыеПериоды);

	ИначеЕсли ПравилоОтражения = ПланыВидовХарактеристик.ЕПСПравилаОтраженияЗарплаты.ВзносыСРезервовПоОтпускам Тогда
		
		МассивОпераций = Новый Массив;
		
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.СтраховыеВзносыПоРезервамПоОтпускам);
		МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.СтраховыеВзносыПоРезервамПоОтпускамЗаПрошлыеПериоды);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 		Реквизиты.Организация);
	Запрос.УстановитьПараметр("ПравилоОтражения",	ПравилоОтражения);
	Запрос.УстановитьПараметр("ВидыОпераций",       МассивОпераций);
	Запрос.УстановитьПараметр("ТаблицаНачислений", 	ТаблицаНачислений);
	Запрос.УстановитьПараметр("СоединениеПоВиду",   Истина);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНачислений.ФизическоеЛицо,
	|	ТаблицаНачислений.Подразделение,
	|	ТаблицаНачислений.ВидОперации,
	|	ТаблицаНачислений.ДоговорКонтрагента,
	|	ТаблицаНачислений.СпособОтраженияЗарплатыВБухучете
	|ПОМЕСТИТЬ ТаблицаНачисленийИсходная
	|ИЗ
	|	&ТаблицаНачислений КАК ТаблицаНачислений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНачислений.ФизическоеЛицо,
	|	ТаблицаНачислений.Подразделение,
	|	ТаблицаНачислений.ВидОперации,
	|	ТаблицаНачислений.ДоговорКонтрагента,
	|	ТаблицаНачислений.СпособОтраженияЗарплатыВБухучете
	|ПОМЕСТИТЬ ТаблицаНачислений
	|ИЗ
	|	ТаблицаНачисленийИсходная КАК ТаблицаНачислений
	|ГДЕ
	|	ТаблицаНачислений.ВидОперации В(&ВидыОпераций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &СоединениеПоВиду
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете КАК Перечисление.ВидыОперацийПоЗарплате), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.Пустаяссылка))
	|		ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете КАК Справочник.СпособыОтраженияЗарплатыВБухУчете), ЗНАЧЕНИЕ(Справочник.СпособыОтраженияЗарплатыВБухУчете.Пустаяссылка))
	|	КОНЕЦ КАК СпособОтраженияЗарплатыВБухУчете,
	|	ЕПСПорядокОтраженияЗарплаты.Счет,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто2,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто3,
	|	ЕПСПорядокОтраженияЗарплаты.ЕПСПараметрОтраженияВБУ,
	|	0 КАК Порядок
	|ПОМЕСТИТЬ ВТ_ПорядокОтражения
	|ИЗ
	|	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
	|ГДЕ
	|	ЕПСПорядокОтраженияЗарплаты.Организация = &Организация
	|	И ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения = &ПравилоОтражения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &СоединениеПоВиду
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете КАК Перечисление.ВидыОперацийПоЗарплате), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.Пустаяссылка))
	|		ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(ЕПСПорядокОтраженияЗарплаты.СпособОтраженияЗарплатыВБухУчете КАК Справочник.СпособыОтраженияЗарплатыВБухУчете), ЗНАЧЕНИЕ(Справочник.СпособыОтраженияЗарплатыВБухУчете.Пустаяссылка))
	|	КОНЕЦ,
	|	ЕПСПорядокОтраженияЗарплаты.Счет,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто1,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто2,
	|	ЕПСПорядокОтраженияЗарплаты.Субконто3,
	|	ЕПСПорядокОтраженияЗарплаты.ЕПСПараметрОтраженияВБУ,
	|	1
	|ИЗ
	|	РегистрСведений.ЕПСПорядокОтраженияЗарплаты КАК ЕПСПорядокОтраженияЗарплаты
	|ГДЕ
	|	ЕПСПорядокОтраженияЗарплаты.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ЕПСПорядокОтраженияЗарплаты.ПравилоОтражения = &ПравилоОтражения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете,
	|	МИНИМУМ(ВТ_ПорядокОтражения.Порядок) КАК Порядок
	|ПОМЕСТИТЬ ВТ_ТаблицаОтбор
	|ИЗ
	|	ВТ_ПорядокОтражения КАК ВТ_ПорядокОтражения
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете,
	|	ВТ_ПорядокОтражения.Счет,
	|	ВТ_ПорядокОтражения.Субконто1,
	|	ВТ_ПорядокОтражения.Субконто2,
	|	ВТ_ПорядокОтражения.Субконто3,
	|	ВТ_ПорядокОтражения.ЕПСПараметрОтраженияВБУ,
	|	ВЫБОР
	|		КОГДА ВТ_ПорядокОтражения.ЕПСПараметрОтраженияВБУ В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.Пустаяссылка), ЗНАЧЕНИЕ(Справочник.СпособыОтраженияЗарплатыВБухУчете.Пустаяссылка))
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПорядокПараметраОтраженияВБУ
	|ПОМЕСТИТЬ ВТ_Итоговая
	|ИЗ
	|	ВТ_ПорядокОтражения КАК ВТ_ПорядокОтражения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаОтбор КАК ВТ_ТаблицаОтбор
	|		ПО ВТ_ПорядокОтражения.СпособОтраженияЗарплатыВБухУчете = ВТ_ТаблицаОтбор.СпособОтраженияЗарплатыВБухУчете
	|			И ВТ_ПорядокОтражения.Порядок = ВТ_ТаблицаОтбор.Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНачислений.ФизическоеЛицо,
	|	ТаблицаНачислений.Подразделение,
	|	ТаблицаНачислений.ВидОперации,
	|	ТаблицаНачислений.ДоговорКонтрагента,
	|	ТаблицаНачислений.СпособОтраженияЗарплатыВБухучете,
	|	ВТ_Итоговая.Счет,
	|	ВТ_Итоговая.Субконто1,
	|	ВТ_Итоговая.Субконто2,
	|	ВТ_Итоговая.Субконто3,
	|	ВТ_Итоговая.ЕПСПараметрОтраженияВБУ,
	|	ВТ_Итоговая.ПорядокПараметраОтраженияВБУ
	|ПОМЕСТИТЬ ВТ_ПредварительныйРезультат
	|ИЗ
	|	ТаблицаНачислений КАК ТаблицаНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Итоговая КАК ВТ_Итоговая
	|		ПО %Условие соединения%
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПредварительныйРезультат.ФизическоеЛицо,
	|	ВТ_ПредварительныйРезультат.Подразделение,
	|	ВТ_ПредварительныйРезультат.ВидОперации,
	|	ВТ_ПредварительныйРезультат.ДоговорКонтрагента,
	|	ВТ_ПредварительныйРезультат.СпособОтраженияЗарплатыВБухучете,
	|	МИНИМУМ(ВТ_ПредварительныйРезультат.ПорядокПараметраОтраженияВБУ) КАК ПорядокПараметраОтраженияВБУ
	|ПОМЕСТИТЬ ВТ_ПромежуточныйРезультат
	|ИЗ
	|	ВТ_ПредварительныйРезультат КАК ВТ_ПредварительныйРезультат
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПредварительныйРезультат.ФизическоеЛицо,
	|	ВТ_ПредварительныйРезультат.Подразделение,
	|	ВТ_ПредварительныйРезультат.ВидОперации,
	|	ВТ_ПредварительныйРезультат.ДоговорКонтрагента,
	|	ВТ_ПредварительныйРезультат.СпособОтраженияЗарплатыВБухучете
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПредварительныйРезультат.ФизическоеЛицо,
	|	ВТ_ПредварительныйРезультат.Подразделение,
	|	ВТ_ПредварительныйРезультат.ВидОперации,
	|	ВТ_ПредварительныйРезультат.ДоговорКонтрагента,
	|	ВТ_ПредварительныйРезультат.Счет,
	|	ВТ_ПредварительныйРезультат.Субконто1,
	|	ВТ_ПредварительныйРезультат.Субконто2,
	|	ВТ_ПредварительныйРезультат.Субконто3,
	|	ВТ_ПредварительныйРезультат.СпособОтраженияЗарплатыВБухучете,
	|	ВТ_ПредварительныйРезультат.ЕПСПараметрОтраженияВБУ
	|ИЗ
	|	ВТ_ПредварительныйРезультат КАК ВТ_ПредварительныйРезультат
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПромежуточныйРезультат КАК ВТ_ПромежуточныйРезультат
	|		ПО ВТ_ПредварительныйРезультат.ФизическоеЛицо = ВТ_ПромежуточныйРезультат.ФизическоеЛицо
	|			И ВТ_ПредварительныйРезультат.Подразделение = ВТ_ПромежуточныйРезультат.Подразделение
	|			И ВТ_ПредварительныйРезультат.ВидОперации = ВТ_ПромежуточныйРезультат.ВидОперации
	|			И ВТ_ПредварительныйРезультат.СпособОтраженияЗарплатыВБухучете = ВТ_ПромежуточныйРезультат.СпособОтраженияЗарплатыВБухучете
	|			И ВТ_ПредварительныйРезультат.ПорядокПараметраОтраженияВБУ = ВТ_ПромежуточныйРезультат.ПорядокПараметраОтраженияВБУ";
	
	ТекстУсловияЗапроса = "";
	
	ТекстУсловияЗапроса = "(ВЫБОР
	|				КОГДА ВТ_Итоговая.СпособОтраженияЗарплатыВБухУчете = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.ПустаяСсылка)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ТаблицаНачислений.ВидОперации = ВТ_Итоговая.СпособОтраженияЗарплатыВБухУчете
	|			КОНЕЦ)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Условие соединения%", ТекстУсловияЗапроса);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ДополнитьТаблицуНДФЛПараметрамиОтраженияВБУ(ТаблицаНачислений, Реквизиты)
	
	// Подбор счетов по НДФЛ идет через поиск лицевых счетов, открытых по Регистрации в налоговом органе
	МассивОпераций = Новый Массив;
	
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛ); 
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛСПревышения); 
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛДоначисленныйПоРезультатамПроверки);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛДоходыКонтрагентов);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛПередачаЗадолженностиВНалоговыйОрган);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛПрочиеРасчетыСПерсоналом);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛРасчетыСБывшимиСотрудниками);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НФДЛДивиденды);
	МассивОпераций.Добавить(Перечисления.ВидыОперацийПоЗарплате.НФДЛДивидендыСотрудникам);

	Запрос = Новый Запрос;
		
	Запрос.УстановитьПараметр("ВидыОпераций",       МассивОпераций);
	Запрос.УстановитьПараметр("ТаблицаНачислений", 	ТаблицаНачислений);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНачислений.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаНачислений.СпособОтраженияЗарплатыВБухучете КАК СпособОтраженияЗарплатыВБухучете,
	|	ТаблицаНачислений.Подразделение КАК Подразделение,
	|	ТаблицаНачислений.ВидОперации КАК ВидОперации,
	|	ТаблицаНачислений.СтатьяРасходов КАК СтатьяРасходов,
	|	ТаблицаНачислений.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТаблицаНачисленийИсходная
	|ИЗ
	|	&ТаблицаНачислений КАК ТаблицаНачислений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНачислений.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаНачислений.СпособОтраженияЗарплатыВБухучете КАК СпособОтраженияЗарплатыВБухучете,
	|	ТаблицаНачислений.Подразделение КАК Подразделение,
	|	ТаблицаНачислений.ВидОперации КАК ВидОперации,
	|	ТаблицаНачислений.СтатьяРасходов КАК СтатьяРасходов,
	|	ТаблицаНачислений.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТаблицаНачислений
	|ИЗ
	|	ТаблицаНачисленийИсходная КАК ТаблицаНачислений
	|ГДЕ
	|	ТаблицаНачислений.ВидОперации В(&ВидыОпераций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНачислений.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаНачислений.Подразделение КАК Подразделение,
	|	ТаблицаНачислений.ВидОперации КАК ВидОперации,
	|	ТаблицаНачислений.СпособОтраженияЗарплатыВБухучете КАК СпособОтраженияЗарплатыВБухучете,
	|	ТаблицаНачислений.СтатьяРасходов КАК СтатьяРасходов,
	|	НЕОПРЕДЕЛЕНО КАК Счет,
	|	НЕОПРЕДЕЛЕНО КАК Субконто1,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3,
	|	ТаблицаНачислений.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ТаблицаНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	ТаблицаНачислений КАК ТаблицаНачислений";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СправочникНалогНДФЛ = Справочники.ВидыНалоговИПлатежейВБюджет.НайтиПоРеквизиту("КодБК", "18210102010011000110");
	
	Для Каждого СтрокаРезультат Из Результат Цикл
		СтрокаРезультат.Счет 		= ЮС_СчетаУчетаВДокументах.ПолучитьСчетаУчетаВидовНалогов(Реквизиты.Организация, СправочникНалогНДФЛ, СтрокаРезультат.РегистрацияВНалоговомОргане).СчетУчетаПассивный;
		СтрокаРезультат.Субконто1 	= Перечисления.ВидыПлатежейВГосБюджет.Налог;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

