#Область ДанныеДляПечати

Функция ПолучитьДанныеДляПечатиСоглашенияЭДО(Клиент, ИзФормыПечати = Ложь) Экспорт
	
	Структура = Новый Структура();
	
	Если ИзФормыПечати Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДОСрезПоследних.Период КАК Период,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Ломбард КАК Ломбард,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(
		|			&Дата,
		|			Клиент = &Клиент
		|				И Статус = &Статус
		|				И Основание = ""Заключено ЭДО"") КАК ЛБ_СоглашенияЭДОСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыСоглашенийЭДО.Заключено);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаСреза     = Выборка.Период;
		Ломбард       = Выборка.Ломбард;
		Ответственный = Выборка.Ответственный;
	КонецЕсли;
	
	Иначе
		ДатаСреза     = ТекущаяДата();
		Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		Если Не ЗначениеЗаполнено(Ответственный) Тогда
			Ответственный = ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;
		КонецЕсли;
	КонецЕсли;	
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Поля = "НаименованиеПолное, АдресОрганизацииФакт, ТелефонОрганизации, АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = ОрганизацииСервер.СведенияОбОрганизации(Организация, Поля, ДатаСреза);	
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ломбард.ПолучитьОбъект(),,ДатаСреза);
	СтруктураАдреса = фПрочитатьJSON(Ломбард.КонтактнаяИнформация[0].Значение);
	Структура.Вставить("Город",                         "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, ""));
	Структура.Вставить("ДатаЗаключения",                ?(ЗначениеЗаполнено(ДатаСреза), Формат(ДатаСреза, "ДЛФ=D"), ""));
	
	Структура.Вставить("НаименованиеОрганизации",       ?(ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеДляПечати),
	                                                    СведенияОбОрганизации.НаименованиеДляПечати, ""));
	Структура.Вставить("АдресОрганизации",              ?(ЗначениеЗаполнено(СведенияОбОрганизации.АдресОрганизации),
	                                                    СведенияОбОрганизации.АдресОрганизации, ""));
	Структура.Вставить("ИНН",                           ?(ЗначениеЗаполнено(Организация.ИНН), Организация.ИНН, ""));
	Структура.Вставить("ОГРН",                          ?(ЗначениеЗаполнено(Организация.ОГРН), Организация.ОГРН, ""));
	//Структура.Вставить("ПочтаОрганизации",              СведенияОбОрганизации.АдресЭлектроннойПочтыОрганизации);
	//Структура.Вставить("ТелефонОрганизации",            СведенияОбОрганизации.ТелефонОрганизации);
	
	Структура.Вставить("Ломбард",                       ?(ЗначениеЗаполнено(Ломбард), Строка(Ломбард), ""));
	Структура.Вставить("АдресЛомбарда",                 СтруктураАдреса.value);
	Структура.Вставить("ТелефонЛомбарда",               "");
	
	ДолжностьОтветственного                             = ДолжностьОтветственного(Ответственный, ДатаСреза);
	СклонениеДолжностиОтветственного                    = ПолучитьСклоненияСтроки(Строка(ДолжностьОтветственного), , "ПД=Родительный");
	Структура.Вставить("ДолжностьОтветственногоВПадеже",     ?(ЗначениеЗаполнено(СклонениеДолжностиОтветственного), 
	                                                    НРег(?(СклонениеДолжностиОтветственного.Количество() > 0, СклонениеДолжностиОтветственного[0], "")), ""));
	Структура.Вставить("ДолжностьОтветственного",       ?(ЗначениеЗаполнено(ДолжностьОтветственного), Строка(ДолжностьОтветственного), ""));
	ФИООтветственного                                   = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		Если ФИООтветственного.Количество() > 2 Тогда 
			ФамилияОтветственного  = ФИООтветственного[0]; 
			ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
		Иначе
			ФамилияОтветственного  = ФИООтветственного[0]; 
			ИнициалыОтветственного = Лев(ФИООтветственного[1], 3) + ".";
		КонецЕсли;
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли;
	
	СклонениеФамилииОтветственного                      = ПолучитьСклоненияСтроки(ФамилияОтветственного, , "ПД=Родительный");
	ФамилияОтветственногоВПадеже                        = ?(СклонениеФамилииОтветственного.Количество() > 0, СклонениеФамилииОтветственного[0], "");
	
	Структура.Вставить("ФамилияИнициалыОтветственногоВПадеже",ФамилияОтветственногоВПадеже + " " + ИнициалыОтветственного);
	Структура.Вставить("ФамилияИнициалыОтветственного", ФамилияОтветственного + " " + ИнициалыОтветственного);
	ДанныеКлиента                                       = ДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("Клиент",                        ДанныеКлиента.Фамилия + " " +  ДанныеКлиента.Имя + " " + ДанныеКлиента.Отчество);
	ПаспортныеДанныеКлиента                             = ПаспортныеДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("ДатаРожденияКлиента",           Формат(ДанныеКлиента.ДатаРождения, "ДФ=dd.MM.yyyy"));
	Структура.Вставить("ПаспортныеДанныеКлиента",       ?(ЗначениеЗаполнено(ПаспортныеДанныеКлиента.ПаспортныеДанные), ПаспортныеДанныеКлиента.ПаспортныеДанные, ""));
	
	КонтактнаяИнформацияКлиента                         = КонтактнаяИнформацияКлиента(Клиент, ДатаСреза);
	Структура.Вставить("МестоЖительстваКлиента",        ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.АдресПоПрописке), 
	                                                    КонтактнаяИнформацияКлиента.АдресПоПрописке, ""));
	Структура.Вставить("ТелефонКлиента",                ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.Телефон), 
	                                                    КонтактнаяИнформацияКлиента.Телефон, ""));
	Структура.Вставить("ПочтаКлиента",                  ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.Email),
	                                                                КонтактнаяИнформацияКлиента.Email, "нет"));
	Структура.Вставить("ФамилияИнициалыКлиента",        ДанныеКлиента.Фамилия + " " + Лев(ДанныеКлиента.Имя, 1) + "." + Лев(ДанныеКлиента.Отчество, 1) + ".");
	
	Возврат Структура;
КонецФункции

Функция ПолучитьДанныеДляПечатиРасторженияЭДО(Клиент, ИзФормыПечати = Ложь) Экспорт
	
	Структура = Новый Структура();
	
	Если ИзФормыПечати Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДОСрезПоследних.Период КАК Период,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(
		|			&Дата,
		|			Клиент = &Клиент
		|				И Статус = &Статус) КАК ЛБ_СоглашенияЭДОСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыСоглашенийЭДО.Расторгнуто);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаСреза     = Выборка.Период;
		Ответственный = Выборка.Ответственный;	
	КонецЕсли;	
	
	Иначе
		ДатаСреза     = ТекущаяДата();
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;
	
	ЗапросДатаЗаключения = Новый Запрос;
	ЗапросДатаЗаключения.Текст = "ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДОСрезПоследних.Период КАК Период,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(
		|			&Дата,
		|			Клиент = &Клиент
		|				И Статус = &Статус) КАК ЛБ_СоглашенияЭДОСрезПоследних";
	ЗапросДатаЗаключения.УстановитьПараметр("Клиент", Клиент);
	ЗапросДатаЗаключения.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыСоглашенийЭДО.Заключено);
	ЗапросДатаЗаключения.УстановитьПараметр("Дата", ТекущаяДата());
	
	Выборка = ЗапросДатаЗаключения.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
		ДатаЗаключения = Выборка.Период;
	КонецЕсли;
	
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Поля = "НаименованиеПолное, АдресОрганизацииФакт, ТелефонОрганизации, АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = ОрганизацииСервер.СведенияОбОрганизации(Организация, Поля, ДатаСреза);	
	
	Структура.Вставить("ДатаЗаключения",                ?(ЗначениеЗаполнено(ДатаЗаключения), Формат(ДатаЗаключения, "ДЛФ=D"), ""));
	
	Структура.Вставить("Дата",                          ?(ЗначениеЗаполнено(ДатаСреза), Формат(ДатаСреза, "ДЛФ=D"), ""));
	
	Структура.Вставить("НаименованиеОрганизации",       ?(ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеДляПечати),
	                                                    СведенияОбОрганизации.НаименованиеДляПечати, ""));	
	ДолжностьОтветственного                             = ДолжностьОтветственного(Ответственный, ДатаСреза);

	Структура.Вставить("ДолжностьОтветственного",       ?(ЗначениеЗаполнено(ДолжностьОтветственного), Строка(ДолжностьОтветственного), ""));
	
	ФИООтветственного                                   = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли;
	
	Структура.Вставить("ФИООтветственного",             ФамилияОтветственного + " " + ИнициалыОтветственного);
	
	ДанныеКлиента                                       = ДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("Клиент",                        ДанныеКлиента.Фамилия + " " +  ДанныеКлиента.Имя + " " + ДанныеКлиента.Отчество);
	ПаспортныеДанныеКлиента                             = ПаспортныеДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("ДатаРожденияКлиента",           Формат(ДанныеКлиента.ДатаРождения, "ДФ=dd.MM.yyyy"));
	Структура.Вставить("ПаспортныеДанныеКлиента",       ?(ЗначениеЗаполнено(ПаспортныеДанныеКлиента.ПаспортныеДанные), ПаспортныеДанныеКлиента.ПаспортныеДанные, ""));
	
	КонтактнаяИнформацияКлиента                         = КонтактнаяИнформацияКлиента(Клиент, ДатаСреза);
	Структура.Вставить("МестоЖительстваКлиента",        ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.АдресПоПрописке), 
	                                                    КонтактнаяИнформацияКлиента.АдресПоПрописке, ""));
	Структура.Вставить("ТелефонКлиента",                ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.Телефон), 
	                                                    КонтактнаяИнформацияКлиента.Телефон, ""));
	Структура.Вставить("ПочтаКлиента",                  ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.Email),
	                                                                КонтактнаяИнформацияКлиента.Email, "нет"));
	Структура.Вставить("ФамилияИнициалыКлиента",        ДанныеКлиента.Фамилия + " " + Лев(ДанныеКлиента.Имя, 1) + "." + Лев(ДанныеКлиента.Отчество, 1) + ".");
	
	Возврат Структура;
КонецФункции

Функция ПолучитьДанныеДляПечатиИзменениеКонтактныхДанных(Клиент, Период, ИзФормыПечати = Ложь, СтруктураРеквизитовКонтактныеДанныеДляПечати = Неопределено) Экспорт
	
	Структура = Новый Структура();
	
	Если ИзФормыПечати Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Период КАК Период,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Телефон КАК Телефон,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ТелефонДополнительный КАК ТелефонДополнительный,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Email КАК Email,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.КонтактноеЛицо КАК КонтактноеЛицо,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ФактическийАдрес КАК ФактическийАдрес,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ПочтовыйАдрес КАК ПочтовыйАдрес
		|ИЗ
		|	РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента КАК ЛБ_ИзменениеКонтактныхДанныхКлиента
		|ГДЕ
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Статус = &Статус
		|	И ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент = &Клиент
		|	И ЛБ_ИзменениеКонтактныхДанныхКлиента.Период = &Период
		|	И НЕ ЛБ_ИзменениеКонтактныхДанныхКлиента.Ошибочное";
		
		Запрос.УстановитьПараметр("Клиент", Клиент);
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыИзмененийКонтактныхДанных.Изменены);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДатаСреза = Выборка.Период;
			СтруктураРеквизитовКонтактныеДанныеДляПечати = Новый Структура;
			Если ЗначениеЗаполнено(Выборка.Телефон) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Телефон", Выборка.Телефон);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ТелефонДополнительный) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ТелефонДополнительный", Выборка.ТелефонДополнительный);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Email) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Email", Выборка.Email);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.КонтактноеЛицо) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("КонтактноеЛицо", Выборка.КонтактноеЛицо);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ТелефонКонтактногоЛица) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ТелефонКонтактногоЛица", Выборка.ТелефонКонтактногоЛица);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ФактическийАдрес) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ФактическийАдрес", Выборка.ФактическийАдрес);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ПочтовыйАдрес) Тогда
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ПочтовыйАдрес", Выборка.ПочтовыйАдрес);
			КонецЕсли;
		КонецЕсли;	
		
	Иначе
		ДатаСреза     = ТекущаяДата();
	КонецЕсли;
	
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Поля = "НаименованиеПолное, АдресОрганизацииФакт, ТелефонОрганизации, АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = ОрганизацииСервер.СведенияОбОрганизации(Организация, Поля, ДатаСреза);	
	
	Структура.Вставить("Дата",                          ?(ЗначениеЗаполнено(ДатаСреза), Формат(ДатаСреза, "ДЛФ=D"), ""));
	
	Структура.Вставить("НаименованиеОрганизации",       ?(ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеДляПечати),
	СведенияОбОрганизации.НаименованиеДляПечати, ""));
	ДанныеКлиента                                       = ДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("Клиент",                        ДанныеКлиента.Фамилия + " " +  ДанныеКлиента.Имя + " " + ДанныеКлиента.Отчество);													
	//Структура.Вставить("Клиент",                        ?(ЗначениеЗаполнено(Клиент), Строка(Клиент), ""));
	ПаспортныеДанныеКлиента                             = ПаспортныеДанныеКлиента(Клиент, ДатаСреза);
	Структура.Вставить("ДатаРожденияКлиента",           Формат(ДанныеКлиента.ДатаРождения, "ДФ=dd.MM.yyyy"));
	Структура.Вставить("ПаспортныеДанныеКлиента",       ?(ЗначениеЗаполнено(ПаспортныеДанныеКлиента.ПаспортныеДанные), ПаспортныеДанныеКлиента.ПаспортныеДанные, ""));
	КонтактнаяИнформацияКлиента                         = КонтактнаяИнформацияКлиента(Клиент, ДатаСреза);
	Структура.Вставить("МестоЖительстваКлиента",        ?(ЗначениеЗаполнено(КонтактнаяИнформацияКлиента.АдресПоПрописке), 
	КонтактнаяИнформацияКлиента.АдресПоПрописке, ""));
	Структура.Вставить("Телефон",				        ?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("Телефон"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.Телефон, Символы.НПП));
	Структура.Вставить("ТелефонДополнительный",			?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ТелефонДополнительный"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.ТелефонДополнительный, Символы.НПП));
	Структура.Вставить("Email",				            ?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("Email"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.Email, Символы.НПП));
	Структура.Вставить("КонтактноеЛицо",				?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("КонтактноеЛицо"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.КонтактноеЛицо, Символы.НПП));
	Структура.Вставить("ТелефонКонтактногоЛица",		?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ТелефонКонтактногоЛица"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.ТелефонКонтактногоЛица, Символы.НПП));
	Структура.Вставить("ФактическийАдрес",				?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ФактическийАдрес"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.ФактическийАдрес, Символы.НПП));
	Структура.Вставить("ПочтовыйАдрес",				    ?(СтруктураРеквизитовКонтактныеДанныеДляПечати.Свойство("ПочтовыйАдрес"), 
	СтруктураРеквизитовКонтактныеДанныеДляПечати.ПочтовыйАдрес, Символы.НПП));
