Функция ПечатьОтчетОбЭДОСервер(ПараметрыОтчетаОбЭДО) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.Защита = Истина;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетОбЭДО";
	
	//+МАН 02.12.25 Добавил параметры
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	
	Макет = ПолучитьОбщийМакет("ЛБ_ОтчетОбЭДОИИзмененииКонтактныхДанных");
	
	ОбластьШапка   = Макет.ПолучитьОбласть("Шапка");
	ОбластьТаблица = Макет.ПолучитьОбласть("ОбластьТаблица");
	ОбластьПодвал  = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ОбластьШапка.Параметры.Организация = ПараметрыОтчетаОбЭДО.Организация.НаименованиеСокращенное;
	ОбластьШапка.Параметры.Ломбард = ПараметрыОтчетаОбЭДО.Ломбард;
	
	АдресЛомбарда = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыОтчетаОбЭДО.Ломбард.ПолучитьОбъект(),,ПараметрыОтчетаОбЭДО.НачалоПериода);
	СтруктураАдреса = фПрочитатьJSON(ПараметрыОтчетаОбЭДО.Ломбард.КонтактнаяИнформация[0].Значение);
	ОбластьШапка.Параметры.Город = "г. " + ?(СтруктураАдреса.Свойство("city"), СтруктураАдреса.city, "");
	
	Если ПараметрыОтчетаОбЭДО.НачалоПериода = ПараметрыОтчетаОбЭДО.КонецПериода Тогда
		ВыводЗаПериод = Ложь;
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчетаОбЭДО.НачалоПериода, "ДЛФ=DD");
	Иначе
		ВыводЗаПериод = Истина;
		ОбластьШапка.Параметры.Период = Формат(ПараметрыОтчетаОбЭДО.НачалоПериода, "ДЛФ=DD") + "-" + Формат(ПараметрыОтчетаОбЭДО.КонецПериода, "ДЛФ=DD");
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДО.Клиент КАК Клиент,
		|	ЛБ_СоглашенияЭДО.Клиент.ДатаРождения КАК КлиентДатаРождения,
		|	ЛБ_СоглашенияЭДО.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ЛБ_СоглашенияЭДО.Статус = &Заключено
		|			ТОГДА ""Соглашение ЭДО""
		|		ИНАЧЕ ""Расторжение ЭДО""
		|	КОНЕЦ КАК Вид,
		|	ЛБ_СоглашенияЭДО.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ ВТСоглашенияОбЭДО
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО КАК ЛБ_СоглашенияЭДО
		|ГДЕ
		|	ЛБ_СоглашенияЭДО.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЛБ_СоглашенияЭДО.Ломбард = &Ломбард
		|	И ЛБ_СоглашенияЭДО.Основание <> ""Удалено заключение ЭДО""
		|	И ЛБ_СоглашенияЭДО.Основание <> ""Удалено расторжение ЭДО""
		|	И НЕ ЛБ_СоглашенияЭДО.Ошибочное
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент КАК Клиент,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент.ДатаРождения КАК КлиентДатаРождения,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Период КАК Период,
		|	""Контактные данные"" КАК Вид,
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ ВТИзменениеКонтактныхДанных
		|ИЗ
		|	РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента КАК ЛБ_ИзменениеКонтактныхДанныхКлиента
		|ГДЕ
		|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЛБ_ИзменениеКонтактныхДанныхКлиента.Ломбард = &Ломбард
		|	И ЛБ_ИзменениеКонтактныхДанныхКлиента.Статус <> &Статус
		|	И НЕ ЛБ_ИзменениеКонтактныхДанныхКлиента.Ошибочное
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_СогласияНаОбработкуПД.Клиент КАК Клиент,
		|	ЛБ_СогласияНаОбработкуПД.Клиент.ДатаРождения КАК КлиентДатаРождения,
		|	ЛБ_СогласияНаОбработкуПД.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ЛБ_СогласияНаОбработкуПД.Статус = &ПолученоПД
		|			ТОГДА ""Согласие на обработку ПДн""
		|		ИНАЧЕ ""Отзыв Согласия на обработку ПДн""
		|	КОНЕЦ КАК Вид,
		|	ЛБ_СогласияНаОбработкуПД.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ ВТСогласияПД
		|ИЗ
		|	РегистрСведений.ЛБ_СогласияНаОбработкуПД КАК ЛБ_СогласияНаОбработкуПД
		|ГДЕ
		|	ЛБ_СогласияНаОбработкуПД.Ломбард = &Ломбард
		|	И ЛБ_СогласияНаОбработкуПД.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ЛБ_СогласияНаОбработкуПД.Ошибочное
		|	И ЛБ_СогласияНаОбработкуПД.Основание <> ""Удалено полученное согласие на обработку ПДн""
		|   И ЛБ_СогласияНаОбработкуПД.Основание <> ""Отозвано согласие на обработку персональных данных (ЦО)""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСоглашенияОбЭДО.Клиент КАК Клиент,
		|	ВТСоглашенияОбЭДО.КлиентДатаРождения КАК ДатаРождения,
		|	ВТСоглашенияОбЭДО.Период КАК Период,
		|	ВТСоглашенияОбЭДО.Вид КАК Вид,
		|	ВТСоглашенияОбЭДО.Ответственный КАК Ответственный
		|ИЗ
		|	ВТСоглашенияОбЭДО КАК ВТСоглашенияОбЭДО
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТИзменениеКонтактныхДанных.Клиент,
		|	ВТИзменениеКонтактныхДанных.КлиентДатаРождения,
		|	ВТИзменениеКонтактныхДанных.Период,
		|	ВТИзменениеКонтактныхДанных.Вид,
		|	ВТИзменениеКонтактныхДанных.Ответственный
		|ИЗ
		|	ВТИзменениеКонтактныхДанных КАК ВТИзменениеКонтактныхДанных
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТСогласияПД.Клиент,
		|	ВТСогласияПД.КлиентДатаРождения,
		|	ВТСогласияПД.Период,
		|	ВТСогласияПД.Вид,
		|	ВТСогласияПД.Ответственный
		|ИЗ
		|	ВТСогласияПД КАК ВТСогласияПД
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("Заключено", Перечисления.ЛБ_СтатусыСоглашенийЭДО.Заключено);
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыИзмененийКонтактныхДанных.ОтменаИзменения);
	Запрос.УстановитьПараметр("ПолученоПД", Перечисления.ЛБ_СтатусыСоглашенийПД.Получено);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ПараметрыОтчетаОбЭДО.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыОтчетаОбЭДО.КонецПериода));
	Запрос.УстановитьПараметр("Ломбард", ПараметрыОтчетаОбЭДО.Ломбард);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	н = 1;
	Соглашения = 0;
	Расторжения = 0;
	Изменения = 0;
	СогласияПД = 0;
	ОтзывыСогласийПД = 0;
	Пока Выборка.Следующий() Цикл
		ОбластьТаблица.Параметры.Заполнить(Выборка);
		
		ФИООтветственного          = СтрРазделить(Строка(Выборка.Ответственный), " ");
		
		Если ФИООтветственного.Количество() > 0 Тогда
			ФамилияОтветственного  = ФИООтветственного[0]; 
			ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
		Иначе
			ФамилияОтветственного  = ""; 
			ИнициалыОтветственного = "";
		КонецЕсли;
		
		ОбластьТаблица.Параметры.Ответственный = ФамилияОтветственного + " " + ИнициалыОтветственного;
		
		ДанныеКлиента = ДанныеКлиента(Выборка.Клиент, Выборка.Период);
		ОбластьТаблица.Параметры.Клиент = ДанныеКлиента.Фамилия + " " +  ДанныеКлиента.Имя + " " + ДанныеКлиента.Отчество;
		ОбластьТаблица.Параметры.ДатаРождения = Формат(ДанныеКлиента.ДатаРождения, "ДФ=dd.MM.yyyy");
		ОбластьТаблица.Параметры.Номер = н;
		н = н +1;
		Если Выборка.Вид = "Соглашение ЭДО" Тогда
			Соглашения = Соглашения + 1;
		ИначеЕсли Выборка.Вид = "Расторжение ЭДО" Тогда
			Расторжения = Расторжения + 1;
		ИначеЕсли Выборка.Вид = "Контактные данные" Тогда
			Изменения = Изменения + 1;
		ИначеЕсли Выборка.Вид = "Согласие на обработку ПДн" Тогда
			СогласияПД = СогласияПД + 1;
		ИначеЕсли Выборка.Вид = "Отзыв Согласия на обработку ПДн" Тогда
			ОтзывыСогласийПД = ОтзывыСогласийПД + 1;	
		КонецЕсли;
	ТабличныйДокумент.Вывести(ОбластьТаблица);	
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Соглашения         = Соглашения;
	ОбластьПодвал.Параметры.Расторжения        = Расторжения;
	ОбластьПодвал.Параметры.КонтактныеДанные   = Изменения;
	ОбластьПодвал.Параметры.СогласияПД         = СогласияПД;
	ОбластьПодвал.Параметры.ОтзывыСогласийПД   = ОтзывыСогласийПД;
	
	Ответственный              = ПараметрыСеанса.ТекущийСотрудник;
	
	ФИООтветственного          = СтрРазделить(Строка(Ответственный), " ");
	
	Если ФИООтветственного.Количество() > 0 Тогда
		ФамилияОтветственного  = ФИООтветственного[0]; 
		ИнициалыОтветственного = Лев(ФИООтветственного[1], 1) + "." + Лев(ФИООтветственного[2], 1) + ".";
	Иначе
		ФамилияОтветственного  = ""; 
		ИнициалыОтветственного = "";
	КонецЕсли; 
	
	ДолжностьОтветственного = ДолжностьОтветственного(Ответственный, ТекущаяДата());
	
	ОбластьПодвал.Параметры.ДолжностьОтветственного = ДолжностьОтветственного;
	ОбластьПодвал.Параметры.Ответственный = ФамилияОтветственного + " " + ИнициалыОтветственного;
	
	Если ВыводЗаПериод Тогда
	    ДанныеНачальника_Управляющего = ПолучитьНачальникаОтделения_Управляющего(ПараметрыОтчетаОбЭДО.Ломбард, ТекущаяДата());
		ОбластьПодвал.Параметры.НачальникОтделения = ?(ДанныеНачальника_Управляющего.Свойство("Должность"), Строка(ДанныеНачальника_Управляющего.Должность), "") 
		+ "______________________" + "(" + ?(ДанныеНачальника_Управляющего.Свойство("Сотрудник"), Строка(ДанныеНачальника_Управляющего.Сотрудник), "") + ")";
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПолучитьНачальникаОтделения_Управляющего(Ломбард, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|ПОМЕСТИТЬ ВТОтделение
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ПОМЕСТИТЬ ЛомбардыОтделения
		|ИЗ
		|	ВТОтделение КАК ВТОтделение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|		ПО ВТОтделение.Отделение = ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	ВЫБОР
		|		КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяНачальникомОтделения
		|			ТОГДА ""Начальник отделения ломбардов""
		|		КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяЗаместителемНачальникаОтделения
		|			ТОГДА ""Начальник отделения ломбардов""
		|		КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяУправляющимЛомбарда
		|			ТОГДА ""Управляющий ломбарда""
		|	КОНЕЦ КАК Должность
		|ИЗ
		|	ЛомбардыОтделения КАК ЛомбардыОтделения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&Дата, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
		|		ПО ЛомбардыОтделения.Ломбард = ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение
		|ГДЕ
		|	(ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяНачальникомОтделения
		|			ИЛИ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяЗаместителемНачальникаОтделения
		|			ИЛИ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяУправляющимЛомбарда)
		|	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытияУвольнение";
	
	Запрос.УстановитьПараметр("ВидСобытияУвольнение", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураВозврата = Новый Структура;
	Если Выборка.Следующий() Тогда	
		Заместитель = ПроверкаЗаместителя(Выборка.Сотрудник, Дата);
		Если ЗначениеЗаполнено(Заместитель) Тогда
			СтруктураВозврата.Вставить("Сотрудник", Заместитель);
		Иначе
			СтруктураВозврата.Вставить("Сотрудник", Выборка.Сотрудник);
		КонецЕсли;
		СтруктураВозврата.Вставить("Должность", Выборка.Должность);
	КонецЕсли;
    Возврат СтруктураВозврата;
КонецФункции 

Функция ПроверкаЗаместителя(Сотрудник, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ЗаместителиСрезПоследних.Заместитель КАК Заместитель
		|ИЗ
		|	РегистрСведений.ЛБ_Заместители.СрезПоследних(
		|			&Дата,
		|			СотрудникКогоЗамещают = &Сотрудник
		|				И ОкончаниеЗамещения >= &Дата) КАК ЛБ_ЗаместителиСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заместитель;
	Иначе
		Возврат Справочники.ЛБ_Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция ПечатьСоглашениеОбЭДОСервер(Клиент, ИзФормыПечати = Ложь) Экспорт 
	
	СтруктураДанных = ПолучитьДанныеДляПечатиСоглашенияЭДО(Клиент, ИзФормыПечати);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.Защита = Истина;
		
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СоглашениеОбЭДО";
	
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_СоглашениеОбЭДО");
	
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьДоговор   = Макет.ПолучитьОбласть("Договор");
	ОбластьСогласия  = Макет.ПолучитьОбласть("Согласия");
	ОбластьПодвал    = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(СтруктураДанных);
	ОбластьСогласия.Параметры.Заполнить(СтруктураДанных);
	ОбластьПодвал.Параметры.Заполнить(СтруктураДанных);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТабличныйДокумент.Вывести(ОбластьДоговор);
	ТабличныйДокумент.Вывести(ОбластьСогласия);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСлева = Строка(СтруктураДанных.Ломбард) + 
	"; " + Строка(СтруктураДанных.Клиент) + "; " + "Соглашение об ЭДО от " + Строка(СтруктураДанных.ДатаЗаключения);
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	ОбластьШрифт = ТабличныйДокумент.Область("R39C1:R39C5");
	ТабличныйДокумент.НижнийКолонтитул.Шрифт = ОбластьШрифт.Шрифт;
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПечатьЗаявлениеИзменениеКонтактныхДанных(Клиент, Период, ИзФормыПечати, СтруктураРеквизитовКонтактныеДанныеДляПечати = Неопределено) Экспорт
	
	СтруктураДанных = ПолучитьДанныеДляПечатиИзменениеКонтактныхДанных(Клиент, Период, ИзФормыПечати, СтруктураРеквизитовКонтактныеДанныеДляПечати);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.Защита = Истина;
		
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИзменениеКонтактныхДанных";
	
	Макет = ПолучитьОбщийМакет("ЛБ_ПФ_ИзменениеКонтактныхДанных");
	
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьДанные   = Макет.ПолучитьОбласть("Данные");
	ОбластьПодвал    = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(СтруктураДанных);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Если ЗначениеЗаполнено(СтруктураДанных.Телефон) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.Телефон;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ТелефонДополнительный) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.ТелефонДополнительный;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.Email) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.Email;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.КонтактноеЛицо) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.КонтактноеЛицо;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ТелефонКонтактногоЛица) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.ТелефонКонтактногоЛица;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СтруктураДанных.ФактическийАдрес) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.ФактическийАдрес;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ПочтовыйАдрес) Тогда
		ОбластьДанные.Параметры.КонтактныеДанные = СтруктураДанных.ПочтовыйАдрес;
		ТабличныйДокумент.Вывести(ОбластьДанные);
	КонецЕсли;

	
	ОбластьПодвал.Параметры.Заполнить(СтруктураДанных);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	//ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
