
Функция ЗаключитьЭДОСервер(Клиент, Период) Экспорт
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_СоглашенияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период        = Период;
		МенеджерЗаписи.Клиент        = Клиент;
		МенеджерЗаписи.Ломбард       = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		МенеджерЗаписи.ДатаОкончания = ДобавитьМесяц(МенеджерЗаписи.Период, 60);
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус        = Перечисления.ЛБ_СтатусыСоглашенийЭДО.Заключено;
		МенеджерЗаписи.Основание     = "Заключено ЭДО";
		МенеджерЗаписи.Записать();
		РезультатЗаключения = Истина;
	Исключение
		РезультатЗаключения = Ложь;
	КонецПопытки;
	Возврат РезультатЗаключения;
КонецФункции // ЗаключитьЭДОСервер()

Функция НаличиеДействующегоСоглашения(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДОСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(&ТекущаяДата, Клиент = &Клиент) КАК ЛБ_СоглашенияЭДОСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Статус = Выборка.Статус;
		Если Статус = Перечисления.ЛБ_СтатусыСоглашенийЭДО.Заключено Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;	

КонецФункции 

Функция НаличиеСоглашения(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДОСрезПоследних.Статус КАК Статус,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Ошибочное КАК Ошибочное
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(
		|			&ТекущаяДата,
		|			Клиент = &Клиент
		|				И Статус = &Статус) КАК ЛБ_СоглашенияЭДОСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыСоглашенийЭДО.Заключено);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Не Выборка.Ошибочное Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	Иначе
		Возврат Ложь;
	КонецЕсли;	

КонецФункции

