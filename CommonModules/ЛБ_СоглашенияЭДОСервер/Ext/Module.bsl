КонецФункции 

Функция ПроверитьНаличиеПредыдущихДанных(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
			"ВЫБРАТЬ
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.Период КАК Период,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.Телефон КАК Телефон,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ТелефонДополнительный КАК ТелефонДополнительный,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.Email КАК Email,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.КонтактноеЛицо КАК КонтактноеЛицо,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних.Клиент КАК Клиент
			|ПОМЕСТИТЬ ПоследниеДанные
			|ИЗ
			|	РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента.СрезПоследних(
			|			&ТекущаяДата,
			|			Клиент = &Клиент
			|				И Статус = &Статус) КАК ЛБ_ИзменениеКонтактныхДанныхКлиентаСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(ЛБ_ИзменениеКонтактныхДанныхКлиента.Период) КАК Период,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент КАК Клиент
			|ПОМЕСТИТЬ ПредпоследниеДанные_Период
			|ИЗ
			|	ПоследниеДанные КАК ПоследниеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента КАК ЛБ_ИзменениеКонтактныхДанныхКлиента
			|		ПО ПоследниеДанные.Клиент = ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент
			|			И ПоследниеДанные.Период > ЛБ_ИзменениеКонтактныхДанныхКлиента.Период
			|
			|СГРУППИРОВАТЬ ПО
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Период КАК Период,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Телефон КАК Телефон,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ТелефонДополнительный КАК ТелефонДополнительный,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Email КАК Email,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.КонтактноеЛицо КАК КонтактноеЛицо,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ФактическийАдрес КАК ФактическийАдрес,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.ПочтовыйАдрес КАК ПочтовыйАдрес,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент КАК Клиент,
			|	ЛБ_ИзменениеКонтактныхДанныхКлиента.Ошибочное КАК Ошибочное
			|ИЗ
			|	ПредпоследниеДанные_Период КАК ПредпоследниеДанные_Период
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента КАК ЛБ_ИзменениеКонтактныхДанныхКлиента
			|		ПО (ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент = ПредпоследниеДанные_Период.Клиент)
			|			И (ЛБ_ИзменениеКонтактныхДанныхКлиента.Период = ПредпоследниеДанные_Период.Период)
			|ГДЕ
			|	НЕ ЛБ_ИзменениеКонтактныхДанныхКлиента.Клиент ЕСТЬ NULL
			|	И ЛБ_ИзменениеКонтактныхДанныхКлиента.Статус = &Статус";
		
		Запрос.УстановитьПараметр("Клиент", Клиент);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыИзмененийКонтактныхДанных.Изменены);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если Выборка.Ошибочное Тогда
				Возврат "Ошибочное";
			Иначе	
				Возврат Истина;
			КонецЕсли;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	
КонецФункции

Функция ПаспортныеДанныеКлиента(Залогодатель, Дата, ДокументСПрописнойБуквы = Ложь)
	
	Результат = Новый Структура("ПаспортныеДанные, ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения", "", "", "", "", "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента.Представление КАК ВидДокумента,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК КемВыдан,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА """"
		|		ИНАЧЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи
		|	КОНЕЦ КАК ДатаВыдачи,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК КодПодразделения
		|ИЗ
		|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		|ГДЕ
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя = &ДУЛ
		|	И НЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен
		|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ";
	
	Запрос.УстановитьПараметр("ДУЛ", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		
		ВидДокументаВыборка = ?(ДокументСПрописнойБуквы, СтрШаблон("%1%2", НРег(Лев(Выборка.ВидДокумента, 1)), Сред(Выборка.ВидДокумента, 2)), Выборка.ВидДокумента);
		
		ВидДокумента     = ?(ПустаяСтрока(ВидДокументаВыборка),      "", СтрШаблон(" %1:",                    ВидДокументаВыборка));
		Серия            = ?(ПустаяСтрока(Выборка.Серия),            "", СтрШаблон(" серия %1",              Выборка.Серия));
		Номер            = ?(ПустаяСтрока(Выборка.Номер),            "", СтрШаблон(" номер %1,",              Выборка.Номер));
		КемВыдан         = ?(ПустаяСтрока(Выборка.КемВыдан),         "", СтрШаблон(" выдан: %1,",             Выборка.КемВыдан));
		ДатаВыдачи       = ?(ПустаяСтрока(Выборка.ДатаВыдачи),       "", СтрШаблон(" дата выдачи: %1,",       Формат(Выборка.ДатаВыдачи,"ДФ=dd.MM.yyyy")));
		КодПодразделения = ?(ПустаяСтрока(Выборка.КодПодразделения), "", СтрШаблон(" код подразделения: %1,", Выборка.КодПодразделения)); 
		
		Результат.Вставить("ПаспортныеДанные", СтрШаблон("%1%2%3%4%5%6", ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения));
		Результат.Вставить("ВидДокумента",     Выборка.ВидДокумента);
		Результат.Вставить("Серия",            Выборка.Серия);
		Результат.Вставить("Номер",            Выборка.Номер);
		Результат.Вставить("КемВыдан",         Выборка.КемВыдан);
		Результат.Вставить("ДатаВыдачи",       Выборка.ДатаВыдачи);
		Результат.Вставить("КодПодразделения", Выборка.КодПодразделения);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

