Функция ПоследнийСтатусЭДО(Клиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СоглашенияЭДОСрезПоследних.Статус КАК Статус,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Период КАК Период,
		|	ЛБ_СоглашенияЭДОСрезПоследних.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.ЛБ_СоглашенияЭДО.СрезПоследних(&ТекущаяДата, Клиент = &Клиент) КАК ЛБ_СоглашенияЭДОСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураВыборки = Новый Структура;
	Если Выборка.Следующий() Тогда
		СтруктураВыборки.Вставить("Статус",        Выборка.Статус);
		СтруктураВыборки.Вставить("Период",        Выборка.Период);
		СтруктураВыборки.Вставить("Ответственный", Выборка.Ответственный);
	КонецЕсли;
	Возврат СтруктураВыборки;

КонецФункции

Процедура ЗаписатьИзмененияКонтактныхДанных(Клиент, КонтактныеДанные, ПредыдущиеКонтактныеДанные) Экспорт
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЛБ_ИзменениеКонтактныхДанныхКлиента.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период                           = КонтактныеДанные.Период;
		МенеджерЗаписи.Клиент                           = Клиент;
		МенеджерЗаписи.Ломбард                          = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		Если КонтактныеДанные.Свойство("Телефон") Тогда
		МенеджерЗаписи.Телефон                          = КонтактныеДанные.Телефон;
		МенеджерЗаписи.ТелефонПредыдущий                = ПредыдущиеКонтактныеДанные.Телефон;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ТелефонДополнительный") Тогда
		МенеджерЗаписи.ТелефонДополнительный            = КонтактныеДанные.ТелефонДополнительный;
		МенеджерЗаписи.ТелефонДополнительныйПредыдущий  = ПредыдущиеКонтактныеДанные.ТелефонДополнительный;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("Email") Тогда
		МенеджерЗаписи.Email                            = КонтактныеДанные.Email;
		МенеджерЗаписи.EmailПредыдущий                  = ПредыдущиеКонтактныеДанные.Email;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("КонтактноеЛицо") Тогда
		МенеджерЗаписи.КонтактноеЛицо                   = КонтактныеДанные.КонтактноеЛицо;
		МенеджерЗаписи.КонтактноеЛицоПредыдущий         = ПредыдущиеКонтактныеДанные.КонтактноеЛицо;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ТелефонКонтактногоЛица") Тогда
		МенеджерЗаписи.ТелефонКонтактногоЛица           = КонтактныеДанные.ТелефонКонтактногоЛица;
		МенеджерЗаписи.ТелефонКонтактногоЛицаПредыдущий = ПредыдущиеКонтактныеДанные.ТелефонКонтактногоЛица;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ФактическийАдрес") Тогда
		МенеджерЗаписи.ФактическийАдрес                 = КонтактныеДанные.ФактическийАдрес;
		МенеджерЗаписи.ФактическийАдресПредыдущий       = ПредыдущиеКонтактныеДанные.ФактическийАдрес;
		КонецЕсли;
		Если КонтактныеДанные.Свойство("ПочтовыйАдрес") Тогда
		МенеджерЗаписи.ПочтовыйАдрес                    = КонтактныеДанные.ПочтовыйАдрес;
		МенеджерЗаписи.ПочтовыйАдресПредыдущий          = ПредыдущиеКонтактныеДанные.ПочтовыйАдрес;
		КонецЕсли;
		МенеджерЗаписи.Ответственный                    = ПараметрыСеанса.ТекущийСотрудник;
		МенеджерЗаписи.Статус                           = Перечисления.ЛБ_СтатусыИзмененийКонтактныхДанных.Изменены;
		МенеджерЗаписи.Основание                        = "Подписано заявление об изменении контактных данных";
		МенеджерЗаписи.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры

