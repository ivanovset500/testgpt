Функция ПолучитьЛьготнуюСуммуЗаймаСотрудника(Дата, Клиент) Экспорт  
	Если Константы.ЛБ_ЕстьЛьготыСотрудникам.Получить() = Ложь Тогда
		Возврат 0;
	КонецЕсли;
	
	ДопустимыйОстаток = Константы.ЛБ_ОграничениеСуммыЗаймаСотрудники.Получить();
	Если ДопустимыйОстаток = 0 Тогда
		Возврат 0;
	КонецЕсли;	
	
	ОстатокЗайма = 0;
	Запрос = Новый Запрос;        	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.Остатки(
	               |			&Дата,
	               |			Клиент = &Клиент
	               |				И ВидРасчета = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыРасчетов.ПоОсновномуДолгу)) КАК ЛБ_РасчетыСКлиентамиОстатки"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ОстатокЗайма = ОстатокЗайма + ?(Выборка.СуммаОстаток = null, 0, Выборка.СуммаОстаток);
    КонецЕсли;
	
	СуммаЗаймаЛьготы = ДопустимыйОстаток - ОстатокЗайма;
	Возврат ?(СуммаЗаймаЛьготы <= 0, 0, СуммаЗаймаЛьготы);
КонецФункции	

