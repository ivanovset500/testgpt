Функция ПолучитьОписаниеОбъектаЗалога(Дата, ОбъектЗалога) Экспорт 
	ИнформацияОЗ = "";
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Период УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесЧистый,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДополнительныеМатериалыОбъектаЗалога.СрезПоследних(&Дата, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ,
	               |	ВесЧистый УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.ВидВставки КАК ВидВставки,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.ФормаОгранки КАК ФормаОгранки,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.ВидОгранки КАК ВидОгранки,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.КачествоОгранки КАК КачествоОгранки,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Длина КАК Длина,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Ширина КАК Ширина,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Высота КАК Высота,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Диаметр КАК Диаметр,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Диаметр1 КАК Диаметр1,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Диаметр2 КАК Диаметр2,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Вес КАК Вес,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Период КАК Период,
	               |	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Количество КАК Количество
	               |ИЗ
	               |	РегистрСведений.ЛБ_ВставкиОбъектаЗалога.СрезПоследних(&Дата, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_ВставкиОбъектаЗалогаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ,
	               |	ВидВставки,
	               |	Вес УБЫВ";
	МассивРезультатов = Запрос.ВыполнитьПакет();

    Выборка1 = МассивРезультатов[0].Выбрать();
	Если Выборка1.Следующий() Тогда		
		ИнформацияОЗ = ИнформацияОЗ + СокрЛП(Выборка1.ВидИзделия) + " " + СокрЛП(Формат(Выборка1.ВесИзделия, "ЧЦ=10; ЧДЦ=2")) + " " + сокрЛП(Выборка1.ЕдиницаИзмерения); 
	КонецЕсли;	   
	
	Выборка2 = МассивРезультатов[1].Выбрать();
	Период = Дата(1,1,1); 
	Ном = 0;
	Пока Выборка2.Следующий() Цикл
	    Если Период = Дата(1,1,1) тогда
		    Период = Выборка2.Период;
		ИначеЕсли НЕ Период = Выборка2.Период Тогда
			Прервать;
		КонецЕсли;
	    ИнформацияОЗ = ИнформацияОЗ + ?(Ном = 0, " ", "+") + СокрЛП(Выборка2.Проба);
		Ном = Ном + 1;
	Конеццикла;  
	
	Выборка3 = МассивРезультатов[2].Выбрать();
	Период = Дата(1,1,1); 
	Ном = 0;
	Пока Выборка3.Следующий() Цикл
	    Если Период = Дата(1,1,1) тогда
		    Период = Выборка3.Период;
		ИначеЕсли НЕ Период = Выборка3.Период Тогда
			Прервать;
		КонецЕсли;
	    ИнформацияОЗ = ИнформацияОЗ + ?(Ном = 0, "; ", ", ") + Строка(Выборка3.Количество) + " " + СокрЛП(Выборка3.ВидВставки) + 
		     ?(ЗначениеЗаполнено(Выборка3.ВидОгранки), " " + СокрЛП(Выборка3.ВидОгранки), "") + ?(ЗначениеЗаполнено(Выборка3.КачествоОгранки), " " + СокрЛП(Выборка3.КачествоОгранки), "");
		ОписаниеРазмера = "";
		Если НЕ Выборка3.Диаметр = 0 Тогда
			ОписаниеРазмера = СокрЛП(Выборка3.Диаметр) + " мм";
		ИначеЕсли НЕ Выборка3.Диаметр1 = 0 Тогда	   
			ОписаниеРазмера = СокрЛП(Выборка3.Диаметр1) + ?(НЕ Выборка3.Диаметр2 = 0, "х" + СокрЛП(Выборка3.Диаметр2), "") + " мм";
		ИначеЕсли НЕ Выборка3.Длина = 0 Тогда  
			ОписаниеРазмера = СокрЛП(Выборка3.Длина) + ?(НЕ Выборка3.Ширина = 0, "х" + СокрЛП(Выборка3.Ширина), "") + ?(НЕ Выборка3.Высота = 0, "х" + СокрЛП(Выборка3.Высота), "") + " мм";
		КонецЕсли;	
		ИнформацияОЗ = ИнформацияОЗ + " " + ОписаниеРазмера;  
		ИнформацияОЗ = ИнформацияОЗ + " " + СокрЛП(Формат(Выборка3.Вес, "ЧЦ=10; ЧДЦ=3")) + " " + сокрЛП(Выборка3.ЕдиницаИзмерения);
		Ном = Ном + 1;
    Конеццикла;
	
	Возврат ИнформацияОЗ;
Конецфункции	

Функция ПолучитьПредельныйСрокЗайма(Дата, СхемаКредитования) Экспорт  
	МассивСК = Новый Массив;
	МассивСК.Добавить(Справочники.ЛБ_СхемыКредитования.ПустаяСсылка()); 
	Если ЗначениеЗаполнено(СхемаКредитования) Тогда
	    МассивСК.Добавить(СхемаКредитования);  
	КонецЕсли;	
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("СК", МассивСК);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ПредельныеСрокиЗаймаСрезПоследних.КоличествоДней КАК КоличествоДней
	              |ИЗ
	              |	РегистрСведений.ЛБ_ПредельныеСрокиЗайма.СрезПоследних(&Дата, СхемаКредитования В (&СК)) КАК ЛБ_ПредельныеСрокиЗаймаСрезПоследних
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	ЛБ_ПредельныеСрокиЗаймаСрезПоследних.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.КоличествоДней;
	КонецЕсли;	
	Возврат 0;
КонецФункции	

Функция ПолучитьОсновнойЛомбардПользователя() Экспорт 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если ТекПользователь.ЭтоЛомбард Тогда   
		Возврат ПараметрыСеанса.ТекущийЛомбард;
	КонецЕсли;	     
	
    Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ТекущийЛомбардПользователя.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_ТекущийЛомбардПользователя КАК ЛБ_ТекущийЛомбардПользователя
	               |ГДЕ
	               |	ЛБ_ТекущийЛомбардПользователя.Пользователь = &Пользователь"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ломбард;
	КонецЕсли;	
    Возврат Константы.ЛБ_ОсновнойЛомбард.Получить();
КонецФункции

