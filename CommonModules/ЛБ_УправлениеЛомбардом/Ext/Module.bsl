Процедура ГлобальнаяПроверкаПоПеречням(Дата1, Дата2) Экспорт              
	ДатаПроверки = ТекущаяДата();
	ВидыПеречней = Новый СписокЗначений;
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ); 
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	ЗапросП = Новый Запрос; 
	ЗапросП.УстановитьПараметр("ВидыПеречней", ВидыПеречней);
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_ВидыПеречней.Ссылка КАК ВидПеречня
	                |ИЗ
	                |	Перечисление.ЛБ_ВидыПеречней КАК ЛБ_ВидыПеречней
	                |ГДЕ
	                |	ЛБ_ВидыПеречней.Ссылка В(&ВидыПеречней)";
	ТаблицаП = ЗапросП.Выполнить().Выгрузить();
	
	ЗапросП1 = Новый Запрос;
	ЗапросП1.УстановитьПараметр("Дата1", НачалоДня(Дата1));  
	ЗапросП1.УстановитьПараметр("Дата2", КонецДня(Дата2));
	ЗапросП1.Текст = "ВЫБРАТЬ
	                 |	ЛБ_ПереченьНежелательныхЛиц.ВидПеречня КАК ВидПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ДатаПеречня КАК ДатаПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ДатаВключенияВПеречень КАК ДатаВключенияВПеречень,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ИД КАК ИД,
	                 |	ЛБ_ПереченьНежелательныхЛиц.Наименование КАК Наименование,
	                 |	ЛБ_ПереченьНежелательныхЛиц.НаименованиеЛат КАК НаименованиеЛат,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ДатаРождения КАК ДатаРождения,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ГодРождения КАК ГодРождения,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ИНН КАК ИНН,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,
	                 |	ЛБ_ПереченьНежелательныхЛиц.Статус КАК Статус,
	                 |	ЛБ_ПереченьНежелательныхЛиц.РазмерФайла КАК РазмерФайла
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц КАК ЛБ_ПереченьНежелательныхЛиц
	                 |ГДЕ
	                 |	ЛБ_ПереченьНежелательныхЛиц.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыКлиентаВПеречнях.Включен)
	                 |	И ЛБ_ПереченьНежелательныхЛиц.Период МЕЖДУ &Дата1 И &Дата2
	                 |
