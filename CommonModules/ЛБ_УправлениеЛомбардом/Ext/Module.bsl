Функция СоздатьПКО(Реализация, КассоваяСмена) Экспорт
	ПКОСсылка = ПолучитьПКОРеализации(Реализация);
	Если НЕ ПКОСсылка = неопределено Тогда   
		ДокОбъект = ПКОСсылка.ПолучитьОбъект();
	Иначе 
		ДокОбъект = Документы.ЛБ_ПриходныйКассовыйОрдер.СоздатьДокумент();
		ДокОбъект.Ответственный = Реализация.ОтветственныйПользователь;
		ДокОбъект.ОтветственныйСотрудник = Реализация.ОтветственныйСотрудник;
	КонецЕсли;	  
	ДокОбъект.Дата = Реализация.Дата;
	ДокОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПоступленияОтПокупателейНевостребованныхЗалогов;
	Результат = ЛБ_ОбщийМодуль.ЗаполнитьДтКт(ДокОбъект.ВидОперации);
	ДокОбъект.Дт = Результат.Дт;
    ДокОбъект.Кт = Результат.Кт; 
	ДокОбъект.Ломбард = Реализация.Ломбард;
	ДокОбъект.Организация = Реализация.Организация; 
	ДокОбъект.Контрагент = ?(ЗначениеЗаполнено(Реализация.Контрагент), Реализация.Контрагент, Реализация.Ломбард);   
	ДокОбъект.НомерПКО = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерПКО(ДокОбъект.Дата, ДокОбъект.Организация, ДокОбъект.Ломбард);
	Если  ДокОбъект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда 
		ДокОбъект.ПредставлениеНомераПКО = Строка(ДокОбъект.НомерПКО);
	Иначе	
	    ДокОбъект.ПредставлениеНомераПКО = СокрЛП(ДокОбъект.Ломбард.НомерЛомбарда) + "/" + СокрЛП(ДокОбъект.НомерПКО);
	КонецЕсли;	
	ДокОбъект.ПринятоОт = "Покупателей невостребованных залогов с применением ККТ"; 
	ДокОбъект.Основание = "Поступления от покупателей по реализации НЗ № " + СокрЛП(Реализация.ПредставлениеНомера) + " за " + Формат(Реализация.Дата, "ДФ=dd.MM.yyyy");  
	ДокОбъект.Сумма = Реализация.СуммаПродажи;
	ДокОбъект.КассоваяСмена = КассоваяСмена;
	ДокОбъект.ДокументОснование = Реализация;
	
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись); 
	Попытка
	    ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);  
	Исключение 
		ОбщегоНазначения.СообщитьПользователю("Ошибка при проведени ПКО. Обратитесь к разработчикам");
	КонецПопытки;	 
	Возврат ДокОбъект.Ссылка;
КонецФункции	        

Функция ПроверитьОбъектЗалогаДобавленВРеализацию(ЗалоговыйБилет, ОбъектЗалога) Экспорт
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	Запрос.Текст = "ВЫБРАТЬ
	               |	1 КАК Вид,
	               |	ЛБ_РеализованныеОбъектыЗалогаОбороты.Регистратор КАК Регистратор,
	               |	ЛБ_РеализованныеОбъектыЗалогаОбороты.Регистратор.ОтветственныйСотрудник КАК Ответственный
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РеализованныеОбъектыЗалога.Обороты(
	               |			,
	               |			,
	               |			Регистратор,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_РеализованныеОбъектыЗалогаОбороты
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	0,
	               |	ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.ДокументРеализации,
	               |	ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.Ответственный
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОбъектыЗалогаДобавленныеВРеализацию КАК ЛБ_ОбъектыЗалогаДобавленныеВРеализацию
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.ОбъектЗалога = &ОбъектЗалога";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		СтруктураВозврата = Новый структура;
		СтруктураВозврата.Вставить("Вид", Выборка.Вид);
		СтруктураВозврата.Вставить("Регистратор", Выборка.Регистратор); 
		СтруктураВозврата.Вставить("Ответственный", Выборка.Ответственный); 
		
		Возврат СтруктураВозврата;
	КонецЕсли;
	Возврат неопределено;

КонецФункции	   

Функция ПроверитьЗалоговыйБилетСогласованКОплате(Дата, ЗалоговыйБилет) Экспорт      
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СогласованиеОплатыОтгруженныхЗБСрезПоследних.ДатаОплаты КАК ДатаОплаты
	               |ИЗ
	               |	РегистрСведений.ЛБ_СогласованиеОплатыОтгруженныхЗБ.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СогласованиеОплатыОтгруженныхЗБСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Если НачалоДня(Дата) <= НачалоДня(Выборка.ДатаОплаты) Тогда
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;
	Возврат Ложь;
КонецФункции	

Функция ПроверкаНеНачислятьПроцентыПриРеализации(Дата, ЗалоговыйБилет) Экспорт  
	
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят); 
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен);
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
    Запрос.УстановитьПараметр("Статусы", СписокСтатусов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ВЫБОР
	               |		КОГДА ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьОтмена
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Дата, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
	               |		ПО ЛБ_СостояниеЗалоговогоБилета.Регистратор = ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета В(&Статусы)
	               |	И ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период < &Дата";   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если НЕ Выборка.ЕстьОтмена Тогда
		    Возврат Истина; 
		КонецЕсли;	
	КонецЦикла;
	Возврат Ложь;
КонецФункции	      

Функция ПолучитьДокументУстановкиУсловийСхемыКредитования(Дата, СхемаКредитования) Экспорт  
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УстановкаУсловийСхемыКредитования.Дата КАК Дата,
	               |	ЛБ_УстановкаУсловийСхемыКредитования.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЛБ_УстановкаУсловийСхемыКредитования КАК ЛБ_УстановкаУсловийСхемыКредитования
	               |ГДЕ
	               |	ЛБ_УстановкаУсловийСхемыКредитования.СхемаКредитования = &СхемаКредитования
	               |	И ЛБ_УстановкаУсловийСхемыКредитования.Проведен = ИСТИНА
	               |	И ЛБ_УстановкаУсловийСхемыКредитования.Дата <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";    
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	КонецЕсли;	
	Возврат Документы.ЛБ_УстановкаУсловийСхемыКредитования.ПустаяСсылка();
КонецФункции	

Функция ПолучитьТекущуюПроцентнуюСтавку(ЗалоговыйБилет, ПричинаПрименения) Экспорт
	СтавкаП = 0;
	ДатаКонРезультат = ТекущаяДатаСеанса();
	
	ТаблицаСтавок = ЗалоговыйБилет.ПроцентныеСтавкиПоПериодам.Выгрузить();
	УдСтроки = новый СписокЗначений;
	Для каждого стр Из ТаблицаСтавок Цикл 
		Если Стр.ПричинаПрименения =  ПричинаПрименения Тогда
			Продолжить;
		КонецЕсли;
		УдСтроки.Добавить(Стр);
	Конеццикла;	               
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаСтавок.Удалить(Эл.Значение);
	Конеццикла;	  
	
	Если ТаблицаСтавок.Количество() > 0 Тогда
		СтрС = ТаблицаСтавок.Получить(0);  
		СтавкаП = СтрС.ПроцентнаяСтавка; 
		Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
			Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
				СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
				СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
				СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
		    КонецЕсли; 
		КонецЕсли;	
	КонецЕсли;	
  
   	Возврат СтавкаП;
КонецФункции   

Функция ПолучитьВидОкругленияСуммыПроцентов(Дата) Экспорт
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Организация", Константы.ЛБ_ОсновнаяОрганизация.Получить());
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.ВидОкругленияСуммыПроцентов КАК ВидОкругленияСуммыПроцентов
				   |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
	    Возврат Выборка.ВидОкругленияСуммыПроцентов;
	КонецЕсли;  
	Возврат Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеДоУмноженияНаКоличествоДней;
КонецФункции	


Функция ЕстьДоверенности(ЗБ) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);  
	Запрос.УстановитьПараметр("СтатусДоверенности", Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ДоверенностиСрезПоследних
	               |ГДЕ
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности = &СтатусДоверенности";
	ТаблицаД = Запрос.Выполнить().Выгрузить();
	ДатаПроверки = ТекущаяДатаСеанса();
	Для каждого стрД из ТаблицаД цикл   
		Если СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			ДоверенностьДействует = Истина;
			Если СтрД.Доверенность.СрокДействияДоверенности >= НачалоДня(ДатаПроверки) Тогда 
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.Клиент, ДатаПроверки) = неопределено Тогда   
					ДоверенностьДействует = Ложь;
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, ДатаПроверки) = неопределено Тогда  
                    ДоверенностьДействует = Ложь;					
				КонецЕсли;	              
			ИначеЕсли СтрД.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, ДатаПроверки) = неопределено Тогда  
					ДоверенностьДействует = Ложь;	
				КонецЕсли;	
			Иначе                         	
				ДоверенностьДействует = Ложь;
			КонецЕсли;  
		Иначе
			ДоверенностьДействует = Ложь;
		КонецЕсли; 
		Если ДоверенностьДействует Тогда  
			Возврат Истина;
        КонецЕсли;
	КонецЦикла;  
  	Возврат Ложь;
КонецФункции    

Функция РасчитатьДолгПоПроцентам(Дата, ЗалоговыйБилет, СуммаЗайма, ПричинаПримененияПроцентнойСхемы, ДатаНачалаРасчета) Экспорт 
	ДокументОбъект = СоздатьНовуюОплатуПроцентов(Дата, ЗалоговыйБилет); 	    
		   
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
	Если НЕ СтруктураП = неопределено Тогда
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
	Иначе
		ПредельноеЗначениеПроцентов = 0;
	КонецЕсли;   
	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр); 

	Возврат Результат.СуммаПроцентов;
КонецФункции

Функция СформироватьСообщениеПольхователюПоРасчетуЗБ(НомерЗБ, ПроцентнаяСтавка, СуммаПроцентовВДень, Долг, ЕстьДоверенность) 
	ТекстС = СокрЛП(НомерЗБ);  
	ТекстС = ТекстС + "; " + ПроцентнаяСтавка;
	ТекстС = ТекстС + "; " + СуммаПроцентовВДень;
	ТекстС = ТекстС + "; " + СокрЛП(Формат(Долг, "ЧЦ=15; ЧДЦ=2; ЧН=0"));
	ТекстС = ТекстС + "; " + ?(ЕстьДоверенность, "да", "нет");   
	
	Возврат ТекстС;
КонецФункции	

Функция ПроверитьМестонахождениеОЗ(ЗалоговыйБилет, Ломбард) Экспорт
	ТестСообщения = "";
	СкладЗалоги = ЛБ_Общиймодуль.ПолучитьСклад(Ломбард, Перечисления.ЛБ_ВидыСкладов.Залоги);		
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаОстатки.Склад КАК Склад,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |ГДЕ
	               |	НЕ ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток = 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.Склад,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард,
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	УдСтроки = Новый списокЗначений;
	Для каждого Стр Из ТаблицаЗапроса Цикл 
		Если Стр.Ломбард = Ломбард И Стр.Склад = СкладЗалоги Тогда 
			УдСтроки.Добавить(Стр);
		КонецЕсли;	
	Конеццикла;	  
	
	Для каждого Эл из Удстроки цикл  
		ТаблицаЗапроса.Удалить(Эл.Значение);
	Конеццикла;	                          
	
	ТаблицаОЗ = ТаблицаЗапроса.Скопировать();
	ТаблицаОЗ.Свернуть("ОбъектЗалога, Ломбард, Склад");
	Для каждого СтрОЗ Из ТаблицаОЗ Цикл  
		Отбор = новый Структура;
		Отбор.Вставить("ОбъектЗалога", СтрОЗ.ОбъектЗалога); 
		Отбор.Вставить("Ломбард", СтрОЗ.Ломбард);  
		Отбор.Вставить("Склад", СтрОЗ.Склад);
		
		СписокОЗ = "";
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Для каждого Стр Из Строки Цикл
			 СписокОЗ = СписокОЗ + ?(ПустаяСтрока(СписокОЗ), "", ", ") + СокрЛП(Стр.Артикул);
		КонецЦикла;	
		Если Строки.Количество() = 1 Тогда
			СтрокаОЗ = "Объект залога " + СписокОЗ + " находится в ";
		Иначе  
			СтрокаОЗ = "Объекты залога " + СписокОЗ + " находятся в ";
		КонецЕсли;	
		ТестСообщения = ТестСообщения + ?(ПустаяСтрока(ТестСообщения), "", Символы.ПС) + СтрокаОЗ + 
		           ?(СтрОЗ.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис, "ЦО", "ломбарде № " + СтрОЗ.Ломбард.НомерЛомбарда) +
				   " на складе " + СокрЛП(СтрОЗ.Склад);
	КонецЦикла;	
	
	Возврат ТестСообщения;
КонецФункции

Функция ВыполнитьОбработкуДанныхТаблицыЗБ(СписокЗБ, ДатаСмерти) Экспорт 
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыеБилеты", СписокЗБ);		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(, ЗалоговыйБилет В (&ЗалоговыеБилеты)) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Для каждого Эл Из СписокЗБ цикл   
		Отбор = Новый структура;
		Отбор.Вставить("ЗалоговыйБилет", Эл.Значение); 
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Стр = Строки.Получить(0);   
			
			НачисленоПроценты = 0; 
			СуммаПроцентовВДень = "";
			ПроцентнаяСтавка = "";
			Если НЕ Стр.СуммаЗайма = 0 Тогда 
				НачисленияОстановлены = Ложь;
				Если Стр.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
					 Стр.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
					 Стр.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда   
					НачисленияОстановлены = Истина;
				КонецЕсли;	
				
				Если НЕ НачисленияОстановлены Тогда
					Если НЕ ДатаСмерти = Дата(1,1,1) Тогда   
						ПредыдущийСтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ДатаСмерти-1, Стр.ЗалоговыйБилет); 
						Если ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
						     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
						     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда 
							НачисленияОстановлены = Истина; 
						КонецЕсли; 
					КонецЕсли;
				КонецЕсли;	

				СтавкаП = ПолучитьТекущуюПроцентнуюСтавку(Стр.ЗалоговыйБилет, Стр.ПричинаПрименения); 
				ПроцентнаяСтавка = Формат(СтавкаП, "ЧЦ=10; ЧДЦ=3"); 
				Если НачисленияОстановлены Тогда  
					НачисленоПроценты = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(, Стр.ЗалоговыйБилет);
					СуммаПроцентовВДень = "0,00";
				Иначе	
					ВидОкругленияСуммыПроцентов = ПолучитьВидОкругленияСуммыПроцентов(Стр.ЗалоговыйБилет.Дата);
					Если ВидОкругленияСуммыПроцентов = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеПослеУмноженияНаКоличествоДней") Тогда
				        СуммаПроцентовВДень = Формат(Стр.СуммаЗайма*СтавкаП/100, "ЧЦ=15; ЧДЦ=5");   
					Иначе
						СуммаПроцентовВДень = Формат(Стр.СуммаЗайма*СтавкаП/100, "ЧЦ=15; ЧДЦ=2");
					КонецЕсли;		
					
					НачисленоПроценты = РасчитатьДолгПоПроцентам(ТекущаяДатаСеанса(), Стр.ЗалоговыйБилет, Стр.СуммаЗайма, Стр.ПричинаПрименения, Стр.ДатаНачалаРасчетаПроцентов); 
				КонецЕсли;
			КонецЕсли;	
			Долг = Стр.СуммаЗайма + НачисленоПроценты;
			ЕстьДоверенность = ЕстьДоверенности(Стр.ЗалоговыйБилет);
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СформироватьСообщениеПольхователюПоРасчетуЗБ(Стр.ЗалоговыйБилет.НомерЗалоговогоБилета, ПроцентнаяСтавка, СуммаПроцентовВДень, Долг, ЕстьДоверенность);
			Сообщение.Сообщить();   
		КонецЕсли;	
	Конеццикла;	 
	Возврат "Выполнено"; 
КонецФункции	

