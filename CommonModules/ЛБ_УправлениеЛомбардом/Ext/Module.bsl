Функция РассчитатьДатуЛьготногоПериода(ДатаДоговора, Сдвиг)
 
 // Отсчет месяца ведем с даты, следующей за датой окончания договора (согласно ГК РФ)
 ДатаСледующаяЗаДатойОкончанияДоговора = НачалоДня(ДатаДоговора) + 24*60*60;
 
 ДатаСледующаяЗаДатойОкончанияДоговораСоСдвигом = ДобавитьМесяц(ДатаСледующаяЗаДатойОкончанияДоговора, Сдвиг);
 
 МассивДат = Новый Массив();
 МассивДат.Добавить(ДатаСледующаяЗаДатойОкончанияДоговораСоСдвигом);
 
 ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
 РабочиеДаты = КалендарныеГрафики.ДатыБлижайшихРабочихДней(ПроизводственныйКалендарь, МассивДат, , Истина);
 ДатаОкончанияЛьготногоПериода = РабочиеДаты.Получить(ДатаСледующаяЗаДатойОкончанияДоговораСоСдвигом);
 
 Возврат ДатаОкончанияЛьготногоПериода;
 
КонецФункции  

Функция ИсключитьДатаВыкупаПразничныйДень(ДатаВыкупа) Экспорт
	Пока истина Цикл      
		ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	
		Если НЕ ЗначениеЗаполнено(ПроизводственныйКалендарь) Тогда
			Возврат ДатаВыкупа;
		КонецЕсли;
		
		Отбор = Новый Структура;  
		Отбор.Вставить("Год",                       Год(ДатаВыкупа));
		Отбор.Вставить("Дата",                      ДатаВыкупа);
		Отбор.Вставить("ПроизводственныйКалендарь", ПроизводственныйКалендарь);

	    СведенияНаДень = РегистрыСведений.ДанныеПроизводственногоКалендаря.Получить(Отбор);
		Если СведенияНаДень.ВидДня=Перечисления.ВидыДнейПроизводственногоКалендаря.Праздник Тогда 
			ДатаВыкупа = НачалоДня(ДатаВыкупа) + 24*60*60;
		Иначе
			Прервать;
        КонецЕсли; 
	Конеццикла;
		
	Возврат ДатаВыкупа;	
КонецФункции	

Функция ПолучитьЛьготныйСрокЗалоговогоБилета(ДатаВыкупа) Экспорт 
	ДатаВыкупаЛьготная = ДатаВыкупа + 24*60*60;
	Число = День(ДатаВыкупаЛьготная);
	Месяц = Месяц(ДатаВыкупаЛьготная);
	Год = Год(ДатаВыкупаЛьготная);
	
	Если Месяц = 12 Тогда 
		Месяц = 1; 
		Год = Год + 1;
	Иначе  
		Месяц = Месяц+1;
	КонецЕсли;
	Попытка
	    ДатаВыкупаЛьготная = Дата(Год, Месяц, Число);
	Исключение     
		ДатаВыкупаЛьготная = КонецМесяца(Дата(Год, Месяц, 1));      		
	КонецПопытки;
	
	Возврат  ДатаВыкупаЛьготная;     	
КонецФункции	

Функция ПолучитьДатуНачалаРасчетаПроцентов(Дата, Организация) Экспорт 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.НачислятьПроцентыЗаДеньЗалога КАК НачислятьПроцентыЗаДеньЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Если Выборка.НачислятьПроцентыЗаДеньЗалога Тогда
			Возврат НачалоДня(Дата);
		Иначе	
			Возврат НачалоДня(Дата) + 86400;
		КонецЕсли;	
	КонецЕсли;	
	Возврат НачалоДня(Дата) + 86400;
