Функция РасчетПСКГод(Дата, СрокЗалога, СуммаЗайма, СуммаПроцентов) Экспорт  
	
	Если СрокЗалога = 0 Тогда
		ПСКГод = 0;
	Иначе			
		Коэф1 = 365/СрокЗалога;
		
		//Коэф2 = (СуммаЗайма + СуммаПроцентов)/СуммаЗайма - 1; 
		Коэф2 = СуммаПроцентов/СуммаЗайма;
		
		ПСКГод = Коэф1*Коэф2*100; 
	КонецЕсли;	
	Возврат ПСКГод;
КонецФункции  

Функция РасчетПСКГодПрейскурант(Дата, СрокЗалога, СуммарнаяСтавка) Экспорт
	Если СрокЗалога = 0 Тогда
		ПСКГод = 0;
	Иначе		
		Коэф1 = КоличествоДнейВГоду(Дата)/СрокЗалога;		
		ПСКГод = Коэф1*СуммарнаяСтавка; 
	КонецЕсли;	
	Возврат ПСКГод;
КонецФункции  

