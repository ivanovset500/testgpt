Функция ЗаполнитьСписокКлиентовДляПроверкиПоПеречням(Дата) Экспорт 
	СписокКлиентов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;                                
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));                  
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт);
	СписокСтатусов.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Реализован);
	Запрос.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
                   |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Залогодатель КАК Клиент
                   |ИЗ
                   |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, НЕ СтатусЗалоговогоБилета В (&СписокСтатусов)) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
                   |		ПО ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Залогодатель = ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель
                   |ГДЕ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти = &ПустаяДата"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл   
		СписокКлиентов.Добавить(Выборка.Клиент);
	Конеццикла;	
	
	Запрос.УстановитьПараметр("СрокДействия", НачалоДня(Дата)); 
	Запрос.УстановитьПараметр("СтатусДоверенности", Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Доверенности.Доверенность.ПредставительКлиента КАК ПредставительКлиента
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности КАК ЛБ_Доверенности
	               |ГДЕ
	               |	ЛБ_Доверенности.СтатусДоверенности = &СтатусДоверенности
	               |	И (ЛБ_Доверенности.Доверенность.СрокДействияДоверенности >= &СрокДействия
	               |			ИЛИ ЛБ_Доверенности.Доверенность.СрокДействияДоверенности = &ПустаяДата)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если СписокКлиентов.НайтиПоЗначению(Выборка.ПредставительКлиента) = неопределено Тогда
			СписокКлиентов.Добавить(Выборка.ПредставительКлиента);
		КонецЕсли;	
	Конеццикла;	
	
	Запрос.УстановитьПараметр("Клиенты", СписокКлиентов);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_БенефициарныеВладельцыСрезПоследних.Бенефициар КАК Бенефициар
	               |ИЗ
	               |	РегистрСведений.ЛБ_БенефициарныеВладельцы.СрезПоследних(&Дата, Залогодатель В (&Клиенты)) КАК ЛБ_БенефициарныеВладельцыСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если СписокКлиентов.НайтиПоЗначению(Выборка.Бенефициар) = неопределено Тогда
			СписокКлиентов.Добавить(Выборка.Бенефициар);
		КонецЕсли;	
	Конеццикла;  
	
	СписокКлиентов.СортироватьПоЗначению();
	Возврат СписокКлиентов;
КонецФункции

Функция ЗаполнитьСписокКлиентовДляГлобальнойПроверкиПоПеречням(Дата1, Дата2) Экспорт 
	СписокКлиентов = ЗаполнитьСписокКлиентовДляПроверкиПоПеречням(Дата2);
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата1", НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));   
	Запрос.УстановитьПараметр("Клиенты", СписокКлиентов);   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОперацияПоЗалогу.Залогодатель КАК Клиент
	               |ИЗ
	               |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	               |ГДЕ
	               |	ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)
	               |	И ЛБ_ОперацияПоЗалогу.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И ЛБ_ОперацияПоЗалогу.Залогодатель <> ЛБ_ОперацияПоЗалогу.ПредыдущаяОперация.Залогодатель
	               |	И ЛБ_ОперацияПоЗалогу.Проведен = ИСТИНА
	               |	И НЕ ЛБ_ОперацияПоЗалогу.Залогодатель В (&Клиенты)"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Если СписокКлиентов.НайтиПоЗначению(Выборка.Клиент) = неопределено Тогда
			СписокКлиентов.Добавить(Выборка.Клиент);
		КонецЕсли;	
	Конеццикла;  
	
	СписокКлиентов.СортироватьПоЗначению();
	Возврат СписокКлиентов;
КонецФункции	

Функция ПроверитьОсновныеДокументыЗалогодателя(Клиент, Дата = неопределено) Экспорт 
	Если Дата = неопределено Тогда
		ДатаПроверки = ТекущаяДата();
	Иначе
		ДатаПроверки = Дата;
	КонецЕсли;
	
	Гражданство = Справочники.СтраныМира.Россия; 
	ДатаРождения = Дата(1,1,1);
	
	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("Дата", ДатаПроверки); 
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Гражданство = Выборка.Гражданство;
		ДатаРождения = Выборка.ДатаРождения;
	КонецЕсли;   
	
	СтруктураВозврата = Новый Структура;   
	СтруктураВозврата.Вставить("ОшибкаДУЛ", "");
	СтруктураВозврата.Вставить("ОшибкаДоп", "");
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ КАК ОсновнойДУЛ,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДоп КАК ОсновнойДоп,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК СрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументКлиента
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя.Владелец = &Клиент) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |ГДЕ
	               |	(ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ = ИСТИНА
	               |			ИЛИ ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДоп = ИСТИНА)
	               |	И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен = ЛОЖЬ";
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	//проверка осн. документа
	Отбор = Новый Структура;
	Отбор.Вставить("ОсновнойДУЛ", Истина);
	Строки = ТаблицаДокументов.НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда 
		СтруктураВозврата.Вставить("ОшибкаДУЛ", "Не найден основной ДУЛ.");
	Иначе   
		Стр = Строки.Получить(0);
		Если НЕ Стр.Гражданство = Гражданство Тогда
			СтруктураВозврата.Вставить("ОшибкаДУЛ", "Гражданство основного ДУЛ не соответствует текущему гражданству.");
		Иначе 
			Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
				Парам = Новый Структура("Серия, Номер", СокрЛП(Стр.Серия), СокрЛП(Стр.Номер));
				Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
					СтруктураВозврата.Вставить("ОшибкаДУЛ", "Основной ДУЛ найден в списке недействительных паспортов.");
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, Стр.ДатаВыдачи) Тогда			
					СтруктураВозврата.Вставить("ОшибкаДУЛ", "Основной ДУЛ не действителен.");
				    ВсеОК = ложь;
				КонецЕсли;	
			ИначеЕсли НЕ Стр.СрокДействия = Дата(1,1,1) Тогда
				Если Стр.СрокДействия < НачалоДня(ДатаПроверки) Тогда 
					СтруктураВозврата.Вставить("ОшибкаДУЛ", "Основной ДУЛ просрочен.");
				КонецЕсли;	
			ИначеЕсли Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда		 
		        ТекстСообщения1 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоВозраст(ДатаРождения, стр.ДатаВыдачи); 
				Если НЕ Пустаястрока(ТекстСообщения1) тогда  
				    СтруктураВозврата.Вставить("ОшибкаДУЛ", ТекстСообщения1);
				Иначе	  						   
				    ТекстСообщения2 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоКонтактнаяИнформация(Клиент, Стр.ДатаВыдачи, ДатаПроверки); 
					Если НЕ Пустаястрока(ТекстСообщения2) тогда 
						СтруктураВозврата.Вставить("ОшибкаДУЛ", ТекстСообщения2);
					КонецЕсли;	
				КонецЕсли;	 
			КонецЕсли;   
		КонецЕсли;	
	КонецЕсли;	  
	
	Если НЕ Гражданство = Справочники.СтраныМира.Россия Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("ОсновнойДоп", Истина);
		Строки = ТаблицаДокументов.НайтиСтроки(Отбор);
		
		Строки = ТаблицаДокументов.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда 
			СтруктураВозврата.Вставить("ОшибкаДоп", "Не найден основной документ на право пребывания в РФ.");
		Иначе   
			Стр = Строки.Получить(0);
			Если НЕ Стр.Гражданство = Гражданство Тогда
				СтруктураВозврата.Вставить("ОшибкаДоп", "Гражданство основного документа на право пребывания в РФ не соответствует текущему гражданству.");
			Иначе 
				Если НЕ Стр.СрокДействия = Дата(1,1,1) Тогда
					Если Стр.СрокДействия < НачалоДня(ДатаПроверки) Тогда 
						СтруктураВозврата.Вставить("ОшибкаДоп", "Основной документ на право пребывания в РФ просрочен.");
					КонецЕсли;	
				ИначеЕсли Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда		 
			        ТекстСообщения1 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоВозраст(ДатаРождения, стр.ДатаВыдачи); 
					Если НЕ Пустаястрока(ТекстСообщения1) тогда  
					    СтруктураВозврата.Вставить("ОшибкаДоп", ТекстСообщения1);
					Иначе	  						   
					    ТекстСообщения2 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоКонтактнаяИнформация(Клиент, Стр.ДатаВыдачи, ДатаПроверки); 
						Если НЕ Пустаястрока(ТекстСообщения2) тогда 
							СтруктураВозврата.Вставить("ОшибкаДоп", ТекстСообщения2);
						КонецЕсли;	
					КонецЕсли;	 
				КонецЕсли;   
			КонецЕсли;	
		КонецЕсли;	  
	КонецЕсли;	      
	
    Возврат СтруктураВозврата;
КонецФункции	

Функция ПроверитьИзделияЗБВЛомбарде(Дата, ЗалоговыйБилет, Ломбард, ЭтоПереоформление = Истина) Экспорт 
	Сообщение = "";

	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
		
	ВнеЛомбарда = "";
	Ном = 0;
	Для каждого Стр из ЗалоговыйБилет.Товары Цикл
		Если НЕ Стр.Переоформить Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);  
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда   
			СтрОст = строки.Получить(0);
			Если НЕ Ломбард = СтрОст.Ломбард Тогда   
				Ном = ном + 1;
				ВнеЛомбарда = ВнеЛомбарда + ?(ПустаяСтрока(ВнеЛомбарда), "", ", ") + сокрЛП(Стр.ОбъектЗалога);
			КонецЕсли;	
		Иначе  
			Ном = ном + 1;
			ВнеЛомбарда = ВнеЛомбарда + ?(ПустаяСтрока(ВнеЛомбарда), "", ", ") + сокрЛП(Стр.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	 
	
	Если НЕ ПустаяСтрока(ВнеЛомбарда) Тогда  
		Сообщение = Сообщение + ?(Ном > 1, "Изделия ", "Изделие ") + ВнеЛомбарда + ?(Ном > 1, " не найдены в ", " не найдено в ") + СокрЛП(Ломбард);
	КонецЕсли;	
		
	Возврат Сообщение;
КонецФункции

//+Мельников 25.04.24 В функцию добавил два парамтра "Отмена" и "ОперацияДоОтменяемой".
