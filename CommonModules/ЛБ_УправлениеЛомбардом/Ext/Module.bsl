Функция ПолучитьТоварыНаСкладеЛомбардаПоВставкамБриллианты(Дата, Организация, Ломбард, Склад) Экспорт  
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад); 
	Запрос.УстановитьПараметр("Бриллиант", Справочники.ЛБ_ДрагоценныеКамни.Бриллиант);
	Запрос.Текст =  "ВЫБРАТЬ
	                |	Остатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                |	Остатки.ОбъектЗалога КАК ОбъектЗалога,
	                |	Остатки.Количество КАК Количество,
	                |	Остатки.СуммаОценки КАК СуммаОценки
	                |ИЗ
	                |	(ВЫБРАТЬ
	                |		ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                |		ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	                |		СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество,
	                |		СУММА(ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток) КАК СуммаОценки
	                |	ИЗ
	                |		РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
	                |				&Дата,
	                |				Организация = &Организация
	                |					И Ломбард = &Ломбард
	                |					И Склад = &Склад) КАК ЛБ_ОбъектыЗалогаОстатки
	                |	
	                |	СГРУППИРОВАТЬ ПО
	                |		ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет,
	                |		ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога) КАК Остатки
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                |			ЛБ_ВставкиОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                |			ЛБ_ВставкиОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога
	                |		ИЗ
	                |			РегистрСведений.ЛБ_ВставкиОбъектаЗалога.СрезПоследних(&Дата, ВидВставки = &Бриллиант) КАК ЛБ_ВставкиОбъектаЗалогаСрезПоследних) КАК ВставкиБриллианты
	                |		ПО Остатки.ЗалоговыйБилет = ВставкиБриллианты.ЗалоговыйБилет
	                |			И Остатки.ОбъектЗалога = ВставкиБриллианты.ОбъектЗалога"; 
