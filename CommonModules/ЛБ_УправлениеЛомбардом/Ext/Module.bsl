	Запрос.УстановитьПараметр("Дата", Дата);   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗайма.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	               |ГДЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период < &Дата
	               |	И ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = &ЗалоговыйБилет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ОборотыПоОперациямЗайма.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Возврат Выборка.НакладнаяНаОтгрузку;
	КонецЕсли;	                            
	Возврат неопределено;
КонецФункции

Функция ПолучитьСтатусНакладнойПоЗБ(Дата, ЗалоговыйБилет) Экспорт  
	СтатусЗБ = ПолучитьСтатусЗалоговогоБилета(Дата, ЗалоговыйБилет);
	Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг Тогда 
		НакладнаяНаОтгрузку = ПолучитьНакладнуюНаОтгрузкуЗалогоговогоБилета(Дата, ЗалоговыйБилет);
		Если НЕ НакладнаяНаОтгрузку = неопределено Тогда    
			СтатусНакладной = ПолучитьСтатусНакладнойНаОтгрузку(Дата, НакладнаяНаОтгрузку);
			Если СтатусНакладной = Перечисления.ЛБ_СтатусыНакладнойНаОтгрузку.Проект Тогда
				Возврат неопределено;
			Иначе
				СтруктураВ = Новый структура;     
				СтруктураВ.Вставить("НакладнаяНаОтгрузку", НакладнаяНаОтгрузку);
				СтруктураВ.Вставить("СтатусНакладной", СтатусНакладной);
			    Возврат СтруктураВ;
			КонецЕсли;	
		Иначе
			Возврат неопределено;
		КонецЕсли;	
	Иначе  
		Возврат неопределено; 
	КонецЕсли;	 
КонецФункции	

