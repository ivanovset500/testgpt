Функция ПолучитьДатуОкончанияДоверенностейКлиента(Дата, Клиент) Экспорт
	ДатаОкончания = Дата(1,1,1);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("ПредставительКлиента", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Период КАК Период,
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(&Дата, Доверенность.ПредставительКлиента = &ПредставительКлиента) КАК ЛБ_ДоверенностиСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Для каждого Стр Из ТаблицаЗапроса Цикл
		Если Стр.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			Если Стр.Доверенность.СрокДействияДоверенности >= НачалоДня(Дата) Тогда 
				ДатаСмертиДоверителя = ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(Стр.Доверенность.Клиент, Дата); 
				Если НЕ ДатаСмертиДоверителя = неопределено Тогда 	  
				    ДатаОкончания = ?(ДатаОкончания < ДатаСмертиДоверителя, ДатаСмертиДоверителя, ДатаОкончания); 
				КонецЕсли;	 
				Возврат неопределено;
			Иначе       
				ДатаОкончания = ?(ДатаОкончания < Стр.Доверенность.СрокДействияДоверенности, Стр.Доверенность.СрокДействияДоверенности, ДатаОкончания); 
			КонецЕсли;
		Иначе
			ДатаОкончания = ?(ДатаОкончания < Стр.Период, НачалоДня(Стр.Период), ДатаОкончания);
		КонецЕсли;
	КонецЦикла;	
    Возврат ?(ДатаОкончания = Дата(1,1,1), неопределено, ДатаОкончания);
КонецФункции	     

