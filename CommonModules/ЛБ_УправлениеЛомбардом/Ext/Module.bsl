Функция ПолучитьДействующиеДокуметныЗалогодателя(Залогодатель, Гражданство, Дата = неопределено) Экспорт
	Если Дата = неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Гражданство", Гражданство);
	Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
                   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия
                   |ИЗ
                   |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
                   |			&Дата,
                   |			Залогодатель = &Залогодатель
                   |				И Гражданство = &Гражданство
                   |				И ДокументНеДействителен = ЛОЖЬ) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
        СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ВидДокументаЗалогодателя", Выборка.ВидДокументаЗалогодателя);
		СтруктураВозврата.Вставить("ВидДокумента", Выборка.ВидДокумента);
		СтруктураВозврата.Вставить("ДокументСерия", Выборка.ДокументСерия);
        СтруктураВозврата.Вставить("ДокументНомер", Выборка.ДокументНомер);
		СтруктураВозврата.Вставить("ДокументДатаВыдачи", Выборка.ДокументДатаВыдачи);
		СтруктураВозврата.Вставить("ДокументКемВыдан", Выборка.ДокументКемВыдан);
		СтруктураВозврата.Вставить("ДокументКодПодразделения", Выборка.ДокументКодПодразделения);
		СтруктураВозврата.Вставить("ДокументНачалоДействия", Выборка.ДокументНачалоДействия);
		СтруктураВозврата.Вставить("ДокументСрокДействия", Выборка.ДокументСрокДействия);
    КонецЕсли; 
	
	Возврат неопределено;
