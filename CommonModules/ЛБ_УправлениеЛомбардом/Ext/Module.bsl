Процедура ЗаполнитьДополнительныеРеквизитыПриказа(ДокументОбъект) Экспорт 
	ЗапросБазовыеЦены = Новый Запрос;
	ЗапросБазовыеЦены.Текст = "ВЫБРАТЬ
	                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.Период КАК Период,
	                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.Проба КАК Проба,
	                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.КатегорияОбъектаЗалога КАК Категория
	                          |ИЗ
	                          |	РегистрСведений.ЛБ_БазовыеЦеныНаДрагоценныеМеталлы КАК ЛБ_БазовыеЦеныНаДрагоценныеМеталлы
	                          |
	                          |УПОРЯДОЧИТЬ ПО
	                          |	Период";
	ТаблицаБазовыеЦены = ЗапросБазовыеЦены.Выполнить().Выгрузить();

	ДокументОбъект.ЕстьМеталлы = ?(ДокументОбъект.ЦеныМеталлы.Количество() = 0, ложь, Истина);
	ДокументОбъект.ЕстьВставки = ?(ДокументОбъект.ЦеныВставки.Количество() = 0, ложь, Истина);
	ДокументОбъект.ЕстьПроцентныеСтавки = ?(ДокументОбъект.СтавкиПроцентов.Количество() = 0, ложь, Истина);
	ДокументОбъект.ЕстьАкцииПроцентныеСтавки = ?(ДокументОбъект.УсловияАкцииСтавки.Количество() = 0, ложь, Истина); 
	ДокументОбъект.ЕстьАкцииМеталлы = ?(ДокументОбъект.УсловияАкцииМеталлы.Количество() = 0, ложь, Истина);
	ДокументОбъект.КоличествоЛомбардов = ДокументОбъект.Ломбарды.Количество(); 
	//+МАН 24.01.25 Добавление отметки наличия отклонений металлов. Заявка 2792.
	ДокументОбъект.ЕстьОтклМеталлы = ?(ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() = 0, Ложь, Истина);
	//-МАН
	Если ДокументОбъект.ЕстьМеталлы Тогда
		Проба = Справочники.ЛБ_Пробы.ПустаяСсылка(); 
		Категория = Справочники.ЛБ_КатегорииОбъектовЗалога.ПустаяСсылка();
		Для каждого СтрБ Из ТаблицаБазовыеЦены Цикл                                
			Если СтрБ.Период > НачалоДня(ДокументОбъект.Дата) Тогда
				Прервать;
			КонецЕсли;
			Проба = СтрБ.Проба;
			Категория = СтрБ.Категория;
		КонецЦикла;	 
		Отбор = Новый Структура;
		Отбор.Вставить("Проба", Проба); 
		Отбор.Вставить("КатегорияОбъектаЗалога", Категория);
	    Строки = ДокументОбъект.ЦеныМеталлы.НайтиСтроки(Отбор);
		МаксЦена = 0;
		Если НЕ Строки.Количество() = 0 Тогда
		    МаксЦена = Строки[0].Цена;
		КонецЕсли;		

		ДокументОбъект.БазоваяЦенаМеталлы = МаксЦена; 
	КонецЕсли;	  
	Если ДокументОбъект.ЕстьПроцентныеСтавки Тогда  
		ТЗМакс = ДокументОбъект.СтавкиПроцентов.Выгрузить(,"Ставка");
		ТЗМакс.Сортировать("Ставка Убыв");
	    ДокументОбъект.МаксимальнаяПроцентнаяСтавка = ТЗМакс[0].Ставка; 
	КонецЕсли;	

КонецПроцедуры	 

