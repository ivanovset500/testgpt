Функция ПолучитьПричинуПримененияПроцентнойСхемы(ДокументОбъект = неопределено, ЗалоговыйБилет, Дата = неопределено) Экспорт   
	Если ЗалоговыйБилет.СхемаКредитования.ПризнакПримененияГибкогоПроцента Тогда 
		Если ДокументОбъект = неопределено Тогда
			ДатаДок = ?(Дата = неопределено, ТекущаяДата(), Дата);
		Иначе	
			Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда	  
				МоментДоДокумента = Новый Граница(Новый МоментВремени(ДокументОбъект.Дата, ДокументОбъект.Ссылка), ВидГраницы.Исключая);
				ДатаДок = МоментДоДокумента; 
			Иначе	
			    ДатаДок = ДокументОбъект.Дата;		
			КонецЕсли;
		КонецЕсли;	
	  			
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата", ДатаДок);
		Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения
		               |ИЗ
		               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Возврат Выборка.ПричинаПрименения;
		КонецЕсли;	 
	КонецЕсли;	
	Возврат Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
КонецФункции	

