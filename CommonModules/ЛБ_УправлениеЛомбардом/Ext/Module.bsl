Процедура СообщитьОбОшибке(ОбъектДанных, СтрокаСообщения, Отказ)  Экспорт
	Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = СтрокаСообщения;
    Сообщение.УстановитьДанные(ОбъектДанных);
    Сообщение.Сообщить();
	
	Отказ = Истина;
КонецПроцедуры	

Процедура ПроверитьЗаполнениеШапкиДокумента(ДокументОбъект, СтруктураОбязательныхПолей, Отказ) Экспорт

	МетаданныеРеквизиты = ДокументОбъект.Метаданные().Реквизиты;
	
	Для каждого КлючЗначение Из СтруктураОбязательныхПолей Цикл

		Значение = ДокументОбъект[КлючЗначение.Ключ];
		Если НЕ ЗначениеЗаполнено(Значение) Тогда

			Если НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
				ПредставлениеРеквизита = МетаданныеРеквизиты[КлючЗначение.Ключ].Представление();
				СтрокаСообщения = "Не заполнено значение реквизита """ + СокрЛП(ПредставлениеРеквизита) + """!";
			Иначе
				СтрокаСообщения = КлючЗначение.Значение;
			КонецЕсли;
			СообщитьОбОшибке(ДокументОбъект, СтрокаСообщения, Отказ);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры // ПроверитьЗаполнениеШапкиДокумента()

// Проверяет правильность заполнения строк табличной части документа.
// Если какой-то из реквизтов, влияющий на проведение не заполнен или
// заполнен не корректно, то выставляется флаг отказа в проведении.
//
// Параметры:
//  ДокументОбъект             - объект проводимого документа, 
//  ИмяТабличнойЧасти          - табличная часть документа,
//  СтруктураОбязательныхПолей - структура, содержащая имена полей, которые собственно и надо проверить.
//  Отказ                      - флаг отказа в проведении.
//  Заголовок                  - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти, СтруктураОбязательныхПолей, 
                                                    Отказ) Экспорт

	ПредставлениеТабличнойЧасти = ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти].Представление();
	ТабличнаяЧасть = ДокументОбъект[ИмяТабличнойЧасти];
	МетаданныеРеквизиты = ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;

	// Цикл по строкам табличной части.
	Для каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл

		СтрокаНачалаСообщенияОбОшибке = "В строке номер """+ СокрЛП(СтрокаТаблицы.НомерСтроки) +
		                               """ табличной части """ + ПредставлениеТабличнойЧасти + """: ";

		// Цикл по проверяемым полям
		Для каждого КлючЗначение Из СтруктураОбязательныхПолей Цикл

			Значение = СтрокаТаблицы[КлючЗначение.Ключ];
			Если НЕ ЗначениеЗаполнено(Значение) Тогда

				Если НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					ПредставлениеРеквизита = МетаданныеРеквизиты[КлючЗначение.Ключ].Представление();
					СтрокаСообщения = "Не заполнено значение реквизита """ + СокрЛП(ПредставлениеРеквизита) + """!";
				Иначе
					СтрокаСообщения = КлючЗначение.Значение;
				КонецЕсли;
				СообщитьОбОшибке(ДокументОбъект, СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, Отказ);

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры // ПроверитьЗаполнениеТабличнойЧасти()

Функция РасчитатьМаксимальнуюСуммуЗалога(Дата, СхемаКредитования, СтатусыЗалогодателя, СтрокаТабличнойЧасти) Экспорт
	МаксимальнаяСуммаОценки = СтрокаТабличнойЧасти.СуммаОценки;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
	Запрос.УстановитьПараметр("СтатусыЗалогодателя", СтатусыЗалогодателя); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних";
	ВыборкаДок = Запрос.Выполнить().Выбрать();
	Если ВыборкаДок.Следующий() Тогда   
		Запрос.УстановитьПараметр("Регистратор", ВыборкаДок.Регистратор);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.УвеличениеСтоимостиЗалога КАК УвеличениеСтоимостиЗалога
		               |ИЗ
		               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних
		               |ГДЕ
		               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.СтатусЗалогодателя В(&СтатусыЗалогодателя)
		               |	И ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.Регистратор = &Регистратор";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			МаксимальнаяСуммаОценки = МаксимальнаяСуммаОценки + МаксимальнаяСуммаОценки*Выборка.УвеличениеСтоимостиЗалога/100;
		КонецЕсли;
	КонецЕсли;	
			
	Возврат МаксимальнаяСуммаОценки;
КонецФункции

Функция ОкруглитьСуммуСсудыПоНастройкам(Дата, Организация, Сумма) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст ="ВЫБРАТЬ
	              |	УсловияПредоставленияКредита.ОкруглятьСуммуОценка КАК ОкруглятьЦены,
	              |	УсловияПредоставленияКредита.ПорядокОкругленияОценка КАК ПорядокОкругления,
	              |	УсловияПредоставленияКредита.ОкруглятьВБольшуюСторонуОценка КАК ОкруглятьВБольшуюСторону
	              |ИЗ
	              |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ОкруглятьЦены Тогда
		    Сумма = ЛБ_ОбщийМодуль.ОкруглитьЦену(Сумма, Выборка.ПорядокОкругления, Выборка.ОкруглятьВБольшуюСторону);
		КонецЕсли;	
	КонецЕсли; 
	Возврат Сумма;
 КонецФункции

Функция СоздатьОбъектЗалога(ДокументОбъект, СтрокаТЧ) Экспорт
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ОбъектЗалога) Тогда
	    НовыйОбъектЗалога = Справочники.ЛБ_ОбъектыЗалога.СоздатьЭлемент();
	Иначе
		НовыйОбъектЗалога = СтрокаТЧ.ОбъектЗалога.ПолучитьОбъект();
		Если НовыйОбъектЗалога.ПометкаУдаления Тогда
			НовыйОбъектЗалога.УстановитьПометкуУдаления(ложь);
		КонецЕсли;	
	КонецЕсли;	
	НовыйОбъектЗалога.Залогодатель = ДокументОбъект.Залогодатель;	 
	Попытка
		НовыйОбъектЗалога.Наименование = СокрЛП(СтрокаТЧ.ВидИзделия.Наименование) + ?(СтрокаТЧ.ЕстьВставки, " с/в", " б/в"); 
	    НовыйОбъектЗалога.Записать();
		СтрокаТЧ.ОбъектЗалога = НовыйОбъектЗалога.Ссылка;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;	 
КонецФункции	

Функция ПолучитьНомерЗалоговогоБилета(ДокументОбъект) Экспорт
	ДатаДок = ?(НЕ ЗначениеЗаполнено(ДокументОбъект.Ссылка), ТекущаяДата(), ДокументОбъект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Ломбард", ДокументОбъект.Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйЗапрос.Номер КАК Номер,
	               |	СУММА(ВложенныйЗапрос.Количество) КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЛБ_БланкиЗалоговыхБилетовОстатки.Номер КАК Номер,
	               |		ЛБ_БланкиЗалоговыхБилетовОстатки.КоличествоОстаток КАК Количество
	               |	ИЗ
	               |		РегистрНакопления.ЛБ_БланкиЗалоговыхБилетов.Остатки(
	               |				&Дата,
	               |				Организация = &Организация
	               |					И Ломбард = &Ломбард) КАК ЛБ_БланкиЗалоговыхБилетовОстатки
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ЛБ_ИспользованныеЗалоговыеБилеты.Номер,
	               |		-ЛБ_ИспользованныеЗалоговыеБилеты.Количество
	               |	ИЗ
	               |		РегистрСведений.ЛБ_ИспользованныеЗалоговыеБилеты КАК ЛБ_ИспользованныеЗалоговыеБилеты
	               |	ГДЕ
	               |		ЛБ_ИспользованныеЗалоговыеБилеты.Организация = &Организация
	               |		И ЛБ_ИспользованныеЗалоговыеБилеты.Ломбард = &Ломбард) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номер";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаЗапроса.Сортировать("Номер");

	Для сч = 0 По ТаблицаЗапроса.Количество() - 1 Цикл
		Если НЕ ТаблицаЗапроса.Получить(сч).Количество = 0 Тогда
			Возврат ТаблицаЗапроса.Получить(сч).Номер;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат неопределено;
КонецФункции

Процедура УдалитьДвиженияДокумента(Документ) Экспорт

    ДокОбъект = Документ.ПолучитьОбъект();

    Для Каждого Движение ИЗ ДокОбъект.Движения Цикл

        Если Движение.Количество() > 0 Тогда

            Точка = Найти(Строка(Движение), ".");
            ВидРегистра = Лев(Строка(Движение), Точка - 13);
            РегистрИмя = СокрП(Сред(Строка(Движение), Точка + 1));

            Если ВидРегистра = "РегистрНакопления" Тогда
                Регистр = РегистрыНакопления[РегистрИмя];            
            ИначеЕсли ВидРегистра = "РегистрБухгалтерии" Тогда
                Регистр = РегистрыБухгалтерии[РегистрИмя];  
            ИначеЕсли ВидРегистра = "РегистрСведений" Тогда
                Регистр = РегистрыСведений[РегистрИмя];  
            ИначеЕсли ВидРегистра = "РегистрРасчета" Тогда
                Регистр = РегистрыРасчета[РегистрИмя];    
            КонецЕсли;

            НаборЗаписей = Регистр.СоздатьНаборЗаписей();
            НаборЗаписей.Отбор.Регистратор.Установить(ДокОбъект.Ссылка);            

        Иначе
            НаборЗаписей = Движение;
        КонецЕсли;

        Попытка
            НаборЗаписей.Записать();
        Исключение
            Сообщить(ОписаниеОшибки());
        КонецПопытки;

    КонецЦикла;

КонецПроцедуры

Функция ПолучитьКонтактнуюИнформациюЗалогодателя(Залогодатель, Дата = неопределено) Экспорт
	Если Дата = неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияСтрана КАК МестоРожденияСтрана,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияОбласть КАК МестоРожденияОбласть,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияРайон КАК МестоРожденияРайон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияНаселенныйПункт КАК МестоРожденияНаселенныйПункт,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонСтруктура КАК ТелефонСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПропискеСтруктура КАК АдресПоПропискеСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдресСтруктура КАК ФактическийАдресСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдресСтруктура КАК ПочтовыйАдресСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонДополнительный КАК ТелефонДополнительный,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонДополнительныйСтруктура КАК ТелефонДополнительныйСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.КонтактноеЛицо КАК КонтактноеЛицо,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонКонтактногоЛицаСтруктура КАК ТелефонКонтактногоЛицаСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ИсточникИнформации КАК ИсточникИнформации,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Комментарий КАК Комментарий,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("Фамилия", Выборка.Фамилия);
		СтруктураВозврата.Вставить("Имя", Выборка.Имя);
		СтруктураВозврата.Вставить("Отчество", Выборка.Отчество);
		СтруктураВозврата.Вставить("ДатаРождения", Выборка.ДатаРождения);
		СтруктураВозврата.Вставить("МестоРождения", Выборка.МестоРождения);
		СтруктураВозврата.Вставить("МестоРожденияСтрана", Выборка.МестоРожденияСтрана);
		СтруктураВозврата.Вставить("МестоРожденияОбласть", Выборка.МестоРожденияОбласть);
		СтруктураВозврата.Вставить("МестоРожденияРайон", Выборка.МестоРожденияРайон);
		СтруктураВозврата.Вставить("МестоРожденияНаселенныйПункт", Выборка.МестоРожденияНаселенныйПункт);
		СтруктураВозврата.Вставить("Телефон", Выборка.Телефон);
		СтруктураВозврата.Вставить("ТелефонСтруктура", Выборка.ТелефонСтруктура);
