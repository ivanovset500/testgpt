Функция ПолучитьОписаниеОъектаЗалога(ОбъектЗалога)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОперацияПоЗалогуТовары.Описание КАК Описание
		|ИЗ
		|	Документ.ЛБ_ОперацияПоЗалогу.Товары КАК ЛБ_ОперацияПоЗалогуТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
		|		ПО ЛБ_ОперацияПоЗалогуТовары.Ссылка = ЛБ_ОперацияПоЗалогу.Ссылка
		|ГДЕ
		|	ЛБ_ОперацияПоЗалогу.Проведен
		|	И НЕ ЛБ_ОперацияПоЗалогу.ПометкаУдаления
		|	И ЛБ_ОперацияПоЗалогуТовары.ОбъектЗалога = &ОбъектЗалога";
	
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Описание;
	Иначе
		Возврат "";
	КонецЕсли;;
	
КонецФункции

