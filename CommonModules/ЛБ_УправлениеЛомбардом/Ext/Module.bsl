КонецФункции

Функция ПолучитьСкидку(Дата, СкидкаВДокументах, Ломбард) Экспорт
	Для сч = 1 По 2 Цикл    
		ТекЛомбард = ?(сч = 1, Ломбард, Справочники.ЛБ_Ломбарды.ПустаяСсылка());
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.УстановитьПараметр("СкидкаВДокументах", СкидкаВДокументах);
		Запрос.УстановитьПараметр("Ломбард", ТекЛомбард); 
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_УстановкаОтменаСкидкиСрезПоследних.Ломбард КАК Ломбард,
		               |	ЛБ_УстановкаОтменаСкидкиСрезПоследних.ДокументСкидки КАК ДокументСкидки,
		               |	ЛБ_УстановкаОтменаСкидкиСрезПоследних.Отменен КАК Отменен
		               |ИЗ
		               |	РегистрСведений.ЛБ_УстановкаОтменаСкидки.СрезПоследних(
		               |			&Дата,
		               |			СкидкаВДокументах = &СкидкаВДокументах
		               |				И Ломбард = &Ломбард
		               |				И ДействуетС <= &Дата) КАК ЛБ_УстановкаОтменаСкидкиСрезПоследних"; 
		ВыборкаУ = Запрос.Выполнить().Выбрать();
		Если ВыборкаУ.Следующий() Тогда  
			Если ВыборкаУ.Отменен Тогда
				Продолжить;
			КонецЕсли;	
	        Запрос.УстановитьПараметр("Регистратор", ВыборкаУ.ДокументСкидки);
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_СкидкаНаОбъектыЗалога.Скидка КАК Скидка,
			               |	ЛБ_СкидкаНаОбъектыЗалога.Отклонение КАК Отклонение
			               |ИЗ
			               |	РегистрСведений.ЛБ_СкидкаНаОбъектыЗалога КАК ЛБ_СкидкаНаОбъектыЗалога
			               |ГДЕ
			               |	ЛБ_СкидкаНаОбъектыЗалога.Регистратор = &Регистратор
			               |	И ЛБ_СкидкаНаОбъектыЗалога.СкидкаВДокументах = &СкидкаВДокументах"; 
			Выборка = Запрос.Выполнить().Выбрать(); 
			Если Выборка.Следующий() тогда 
				РезультатС = Новый структура;
				РезультатС.Вставить("Скидка", Выборка.Скидка); 
				РезультатС.Вставить("Отклонение", Выборка.Отклонение);
				
				Возврат РезультатС;
			КонецЕсли;  
		КонецЕсли;	  
	КонецЦикла;	
	Возврат неопределено;
КонецФункции	

