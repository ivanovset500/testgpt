Функция РассчитатьПоФормуле(Формула, Диаметр, Диаметр1, Диаметр2, Длина, Ширина, Высота, Сторона) Экспорт
	Формула = СтрЗаменить(Формула, "[Диаметр]", Строка(Диаметр)); 
	Формула = СтрЗаменить(Формула, "[Диаметр1]", Строка(Диаметр1));
	Формула = СтрЗаменить(Формула, "[Диаметр2]", Строка(Диаметр2));
	Формула = СтрЗаменить(Формула, "[Длина]", Строка(Длина));
	Формула = СтрЗаменить(Формула, "[Ширина]", Строка(Ширина));	
	Формула = СтрЗаменить(Формула, "[Высота]", Строка(Высота));
	Формула = СтрЗаменить(Формула, "[Сторона]", Строка(Сторона));
	Формула = СтрЗаменить(Формула, ",", ".");
	
	Попытка
	    Возврат Вычислить(Формула); 
	Исключение
		Возврат 0;
	КонецПопытки;	
КонецФункции

