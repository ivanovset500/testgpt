					СтрокиК = ТаблицаПеречней.НайтиСтроки(Отбор); 
					Если НЕ СтрокиК.Количество() = 0 Тогда
						СтрИД = СтрокиК.Получить(0);  
						ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрИД.ДатаПеречня, СтрИД.Ид, СтрИД.ДатаВключенияВПеречень, ДатаПроверки);
						ЕстьСовпадение = Истина;
					КонецЕсли;	
				КонецЕсли; 
				Если ЕстьСовпадение Тогда
					Продолжить;
				КонецЕсли; 

				
				ОтборДок = Новый Структура;
				ОтборДок.Вставить("Клиент", Выборка.Клиент); 
				СтрокиДок = ТаблицаДокументов.НайтиСтроки(ОтборДок);
				Для каждого СтрДок Из СтрокиДок Цикл 
					ОтборК = Новый Структура;  
					ОтборК.Вставить("ВидПеречня", Стр.ВидПеречня);
				    ОтборК.Вставить("ДатаПеречня", Стр.ДатаПеречня);
					ОтборК.Вставить("ДокументНомер", СокрЛП(СтрДок.ДокументНомер)); 
					ОтборК.Вставить("ДокументСерия", СокрЛП(СтрДок.ДокументСерия));
					СтрокиК = ТаблицаПеречнейДокументы.НайтиСтроки(ОтборК); 
					Если НЕ СтрокиК.Количество() = 0 Тогда 
						Для каждого СтрК Из СтрокиК Цикл  
							ОтборИД = Новый Структура; 
							ОтборИД.Вставить("ИД", СтрК.ИД);
							СтрокиИД = ТаблицаПеречней.НайтиСтроки(ОтборИД);
							Если НЕ СтрокиИД.Количество() = 0 Тогда    
								СтрИД = СтрокиИД.Получить(0); 
								ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрИД.ДатаПеречня, СтрИД.Ид, СтрИД.ДатаВключенияВПеречень, ДатаПроверки);
								ЕстьСовпадение = Истина; 	
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;  
	                Если ЕстьСовпадение Тогда
						Прервать;
					КонецЕсли; 
	  			КонецЦикла;		
			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьВПеречень(Клиент, ВидПеречня, ДатаПеречня, Ид, ДатаВключенияВПеречень, Статус) 
	
	Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
	НаборЗаписей = Рег.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Залогодатель.Установить(Клиент);
	НаборЗаписей.Отбор.ВидПеречня.Установить(ВидПеречня); 
	НаборЗаписей.Отбор.ДатаПеречня.Установить(ДатаПеречня);
	НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню);   
	
	НоваяЗапись = НаборЗаписей.Добавить();   
	НоваяЗапись.Период = ТекущаяДата();
	НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню;
	НоваяЗапись.ВидПеречня = ВидПеречня; 
    НоваяЗапись.ДатаПеречня = ДатаПеречня;
	НоваяЗапись.Залогодатель = Клиент;                                                    
	НоваяЗапись.ИД = ИД;
	НоваяЗапись.ДатаВключенияВПеречень = ДатаВключенияВПеречень;
	НоваяЗапись.СтатусКлиентаВПеречне = Статус;
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	НоваяЗапись.Ответственный = Ответственный;
	
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

Процедура ЗаписатьВПереченьГлобальнаяПроверка(Клиент, ВидПеречня, ДатаПеречня, Ид, ДатаВключенияВПеречень, ДатаПроверки) 
	
	Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
	НаборЗаписей = Рег.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Залогодатель.Установить(Клиент); 
	НаборЗаписей.Отбор.ВидПеречня.Установить(ВидПеречня); 
	НаборЗаписей.Отбор.ДатаПеречня.Установить(ДатаПеречня);
	НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка);
	
	НоваяЗапись = НаборЗаписей.Добавить();   
	НоваяЗапись.Период = ДатаПроверки;   
	НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка;
	НоваяЗапись.ВидПеречня = ВидПеречня; 
    НоваяЗапись.ДатаПеречня = ДатаПеречня;
	НоваяЗапись.Залогодатель = Клиент;  
	НоваяЗапись.ИД = ИД;
	НоваяЗапись.ДатаВключенияВПеречень = ДатаВключенияВПеречень;
	НоваяЗапись.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен; 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	НоваяЗапись.Ответственный = Ответственный;
	
	НаборЗаписей.Записать(Истина);

КонецПроцедуры	 

