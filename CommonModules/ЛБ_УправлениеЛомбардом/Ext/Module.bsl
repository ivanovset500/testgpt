Функция ПолучитьНовыйНомерЗалоговогоБилета(Ломбард) Экспорт  
	НаборЗаписей = РегистрыСведений.ЛБ_ПачкиЗалоговыхБилетов.СоздатьНаборЗаписей();  			
	НаборЗаписей.Отбор.Ломбард.Установить(Ломбард);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда  
		ТекНомерПачки = Константы.ЛБ_ТекущийНомерПачки.Получить() + 1;
		Константы.ЛБ_ТекущийНомерПачки.Установить(ТекНомерПачки);
		ТекНомерБилета = ТекНомерПачки*1000 + 1;  
		ПоследнийНомерБилета = ТекНомерПачки*1000 + 999;
		НовыйНомер = НаборЗаписей.Добавить();
		НовыйНомер.Ломбард = Ломбард;
		НовыйНомер.Пачка = ТекНомерПачки;
		НовыйНомер.ТекущийНомерЗалоговогоБилета = ТекНомерБилета;
		НовыйНомер.ПоследнийНомерВПачке = ПоследнийНомерБилета; 
	ИначеЕсли НаборЗаписей.Количество() = 1 Тогда
		НовыйНомер = НаборЗаписей[0];
		ТекНомерБилета = НовыйНомер.ТекущийНомерЗалоговогоБилета + 1;
		Если ТекНомерБилета > НовыйНомер.ПоследнийНомерВПачке Тогда  
			ТекНомерПачки = Константы.ЛБ_ТекущийНомерПачки.Получить() + 1;
			Константы.ЛБ_ТекущийНомерПачки.Установить(ТекНомерПачки);
		    ТекНомерБилета = ТекНомерПачки*1000 + 1;  
		    ПоследнийНомерБилета = ТекНомерПачки*1000 + 999;
            НовыйНомер.Пачка = ТекНомерПачки;
			НовыйНомер.ТекущийНомерЗалоговогоБилета = ТекНомерБилета;
			НовыйНомер.ПоследнийНомерВПачке = ПоследнийНомерБилета; 
		Иначе
			НовыйНомер.ТекущийНомерЗалоговогоБилета = ТекНомерБилета;
		КонецЕсли;	
	КонецЕсли;  
	НаборЗаписей.Записать(); 
	
	
	//+Мельников 26.04.24 Если захотят использовать префикс в номере ЗБ. Добавлено условие.
	//Было: ПрефиксЗБ = СокрЛП(Ломбард.Префикс);	
	Если Ломбард.ИспользоватьПрефиксВНомереЗБ Тогда
		ПрефиксЗБ = СокрЛП(Ломбард.Префикс);
	Иначе
		ПрефиксЗБ = "";
	КонецЕсли;
	//-Мельников
	
    Возврат ПрефиксЗБ + Формат(ТекНомерБилета, "ЧГ=");
КонецФункции	                                            

