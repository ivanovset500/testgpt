Функция ПреобразованиеТаблицыЗначенийВМассив(ТЗ) Экспорт

   Массив = Новый Массив;

   // Запишем в массив
   Для Каждого Строка Из ТЗ Цикл

       СтрТЗ = Новый Структура;
       Для Каждого ИмяКолонки Из ТЗ.Колонки Цикл
           СтрТЗ.Вставить(ИмяКолонки.Имя, Строка[ИмяКолонки.Имя]);
       КонецЦикла;

       Массив.Добавить(СтрТЗ);

   КонецЦикла;

   Возврат Массив;

КонецФункции   

Функция ПреобразованиеМассивВТаблицуЗначений(Массив) Экспорт

   ТЗ = Новый ТаблицаЗначений;

   Для Каждого СтрокаМассива Из Массив Цикл

       Если ТЗ.Колонки.Количество() = 0 Тогда
           Для Каждого ЭлементМассива Из СтрокаМассива Цикл
               ТЗ.Колонки.Добавить(ЭлементМассива.Ключ);
           КонецЦикла;
       КонецЕсли;

       НоваяСтрока = ТЗ.Добавить();
       Для Каждого ЭлементМассива Из СтрокаМассива Цикл
           НоваяСтрока[ЭлементМассива.Ключ] = ЭлементМассива.Значение;
       КонецЦикла;
   КонецЦикла;

   Возврат ТЗ;

КонецФункции

Процедура ПроверитьИсключитьИзПеречня(ДатаСверки, ВидПеречня, Клиент)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаСверки); 
	Запрос.УстановитьПараметр("ВидПеречня", ВидПеречня);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Залогодатель КАК Залогодатель,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ДатаПеречня КАК ДатаПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ИД КАК ИД,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК СтатусКлиентаВПеречне,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ДатаВключенияВПеречень КАК ДатаВключенияВПеречень,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Клиент
	               |				И ВидПеречня = &ВидПеречня) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
			Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
			НаборЗаписей = Рег.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Залогодатель.Установить(Клиент);
			НаборЗаписей.Отбор.ВидПеречня.Установить(ВидПеречня); 
			НаборЗаписей.Отбор.ДатаПеречня.Установить(Выборка.ДатаПеречня);
			НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню);
			
			НоваяЗапись = НаборЗаписей.Добавить();   
			НоваяЗапись.Период = ТекущаяДата();
			НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню;
			НоваяЗапись.ВидПеречня = ВидПеречня; 
		    НоваяЗапись.ДатаПеречня = Выборка.ДатаПеречня;
			НоваяЗапись.Залогодатель = Клиент;                                                    
			НоваяЗапись.ИД = Выборка.ИД;
			НоваяЗапись.ДатаВключенияВПеречень = Выборка.ДатаВключенияВПеречень;
			НоваяЗапись.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен;
			ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
	       		Ответственный = ТекПользователь;
			Иначе
				Ответственный = ПараметрыСеанса.ТекущийСотрудник;
			КонецЕсли;	
			НоваяЗапись.Ответственный = Ответственный;
			
			НаборЗаписей.Записать(Истина);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

