Функция ПроверкаСтатусаЗалогодателя(Дата, Залогодатель, СтатусЗалогодателяСтарый, ЭтоВыкуп = ложь, ЭтоИзъятие = ложь) Экспорт
	ТаблицаЗ = Новый ТаблицаЗначений;
	ТаблицаЗ.Колонки.Добавить("КоличествоЗалогов");  
	ТаблицаЗ.Колонки.Добавить("КоличествоВыкупов");
	
	ЕстьЗБ = Ложь;
	ДатаАрхив = Дата;
	Запрос = Новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.Период КАК Дата
	               |ИЗ
	               |	РегистрСведений.ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса КАК ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаАрхив = Выборка.Дата;
	КонецЕсли;	
	СписокСКАрхив = ПолучитьСхемыКредитованияДляРасчета(ДатаАрхив);
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.СхемаКредитования КАК СхемаКредитования,
                   |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоВыкуплено КАК КоличествоВыкуплено,
                   |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоОтгружено КАК КоличествоОтгружено,
                   |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоИзъято КАК КоличествоИзъято,
                   |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоОХ КАК КоличествоОХ
                   |ИЗ
                   |	РегистрСведений.ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса КАК ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса
                   |ГДЕ
                   |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.Период <= &Дата
                   |	И ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.Клиент = &Залогодатель";
    Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Количество() = 0 Тогда  
		ЕстьЗБ = Истина;
		Пока Выборка.Следующий() Цикл   
			Если НЕ СписокСКАрхив.НайтиПоЗначению(Выборка.СхемаКредитования) = неопределено Тогда  
				НоваяСтр = ТаблицаЗ.Добавить();
				НоваяСтр.КоличествоЗалогов = Выборка.КоличествоВыкуплено + Выборка.КоличествоОХ + Выборка.КоличествоОтгружено + Выборка.КоличествоИзъято;   
				НоваяСтр.КоличествоВыкупов = Выборка.КоличествоВыкуплено + Выборка.КоличествоОХ; 
			КонецЕсли;	
		КонецЦикла;	 
	КонецЕсли;		
	
	СписокСК = ПолучитьСхемыКредитованияДляРасчета(Дата);
	//+МАН 19.06.25 Изменил запрос. Добавил проверку отмененных операций.
	   //Запрос.Текст = "ВЫБРАТЬ
	   //            |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	   //            |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	   //            |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
	   //            |ИЗ
	   //            |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
   	Запрос.Текст = "ВЫБРАТЬ
   	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СхемаКредитования КАК СхемаКредитования,
   	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
   	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
   	               |ИЗ
   	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(
   	               |			&Дата,
   	               |			Залогодатель = &Залогодатель
   	               |				И НЕ Регистратор В
   	               |						(ВЫБРАТЬ
   	               |							ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
   	               |						ИЗ
   	               |							РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Дата, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
   	               |						ГДЕ
   	               |							ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор В (Регистратор))
   	               |				И СтатусЗалоговогоБилета <> ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления)) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	//-МАН
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Количество() = 0 Тогда
		ЕстьЗБ = ?(ЕстьЗБ, ЕстьЗБ, Истина);
		Пока Выборка.Следующий() Цикл   
			Если СписокСК.НайтиПоЗначению(Выборка.СхемаКредитования) = неопределено Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ (Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт) И 
				 НЕ (Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение) И
				 НЕ (Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят) И 
				 НЕ (Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен) Тогда  
				Продолжить;
			КонецЕсли;	
			НоваяСтр = ТаблицаЗ.Добавить(); 
			НоваяСтр.КоличествоЗалогов = 1;   
			Если (Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт) ИЛИ (Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение) Тогда 
			    НоваяСтр.КоличествоВыкупов = 1; 
			Иначе  
				НоваяСтр.КоличествоВыкупов = 0;
			конецЕсли;	
		КонецЦикла;	    
	КонецЕсли;
		
	Если НЕ ТаблицаЗ.Количество() = 0 тогда  
		//ТаблицаЗ.Свернуть("КоличествоВыкупов, КоличествоЗалогов");

		КоличествоВыкупов = 0; 
		КоличествоЗалогов = 0;
		Для сч = 0 По ТаблицаЗ.Количество()-1 Цикл
		    Выборка = ТаблицаЗ.Получить(сч); 
			КоличествоВыкупов = КоличествоВыкупов + Выборка.КоличествоВыкупов;
			КоличествоЗалогов = КоличествоЗалогов + Выборка.КоличествоЗалогов;  
		КонецЦикла;
		Если ЭтоВыкуп Тогда      
			КоличествоЗалогов = КоличествоЗалогов + 1;
			КоличествоВыкупов = КоличествоВыкупов + 1;  
		ИначеЕсли ЭтоИзъятие Тогда
			КоличествоЗалогов = КоличествоЗалогов + 1;	
		КонецЕсли;
		// ++ Савранин, 16.08.2024
		Если КоличествоЗалогов > 0 Тогда
			Коэфф = КоличествоВыкупов/КоличествоЗалогов*100;
		Иначе
			Коэфф = 0;
		КонецЕсли;
		// ++ Савранин, 16.08.2024	
		Если КоличествоЗалогов >= 3 Тогда			
			Если Коэфф <= 30 Тогда
				Возврат Справочники.ЛБ_СтатусыЗалогодателей.Невыкупающий;
			ИначеЕсли Коэфф >= 70 Тогда     
				СтатусЗ =  Справочники.ЛБ_СтатусыЗалогодателей.Добросовестный;   
				Если КоличествоЗалогов >= 5 И Коэфф >= 90 Тогда	
				    СтатусЗ = Справочники.ЛБ_СтатусыЗалогодателей.Постоянный;
				КонецЕсли;
				Возврат СтатусЗ;
			Иначе    
				Возврат Справочники.ЛБ_СтатусыЗалогодателей.Неопределенный;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	Если НЕ ЕстьЗБ тогда
		//+МАН 19.06.25 Добавил условие.
		//Было: Если ЗначениеЗаполнено(СтатусЗалогодателяСтарый) Тогда
		Если СтатусЗалогодателяСтарый = Справочники.ЛБ_СтатусыЗалогодателей.Новый Тогда
			Возврат Справочники.ЛБ_СтатусыЗалогодателей.Сверхновый;
		ИначеЕсли ЗначениеЗаполнено(СтатусЗалогодателяСтарый) Тогда
		//-МАН
		    Возврат СтатусЗалогодателяСтарый;
		Иначе
			Возврат Справочники.ЛБ_СтатусыЗалогодателей.Сверхновый;
		КонецЕсли;	
	Иначе
		Возврат Справочники.ЛБ_СтатусыЗалогодателей.Новый;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьМинимальнуюПроцентнуюСтавкуПоСтатусамКлиента(ТаблицаДляПроверки, СхемаКредитования, СписокСтатусов)
	МинПроцентнаяСтавка = 0;
	Для каждого Эл Из СписокСтатусов Цикл
		ОтборП = Новый структура;
		ОтборП.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборП.Вставить("СтатусЗалогодателя", Эл.Значение); 
		
		СтрокиП = ТаблицаДляПроверки.НайтиСтроки(ОтборП);
		Если НЕ СтрокиП.Количество() = 0 Тогда
			Если МинПроцентнаяСтавка = 0 Тогда
			    МинПроцентнаяСтавка = СтрокиП.Получить(0).ПроцентнаяСтавка;
			Иначе 
				ПС = СтрокиП.Получить(0).ПроцентнаяСтавка; 
				МинПроцентнаяСтавка = ?(МинПроцентнаяСтавка <= ПС, МинПроцентнаяСтавка, ПС);
			КонецЕсли;	
		КонецЕсли;                
	КонецЦикла;	 
	Возврат МинПроцентнаяСтавка;
КонецФункции

Функция ПолучитьСоставнойСтатусКлиента(Дата, СтатусОсновной, СтатусДополнительный) Экспорт
	ЗапросС = Новый Запрос;
	ЗапросС.УстановитьПараметр("Дата", Дата);
	ЗапросС.УстановитьПараметр("СтатусОсновной", СтатусОсновной);
	ЗапросС.УстановитьПараметр("СтатусДополнительный", СтатусДополнительный);
	ЗапросС.Текст = "ВЫБРАТЬ
	          |	ЛБ_СоставныеСтатусыКлиентаСрезПоследних.СтатусКлиентаСоставной КАК СтатусСоставной
	          |ИЗ
	          |	РегистрСведений.ЛБ_СоставныеСтатусыКлиента.СрезПоследних(
	          |			&Дата,
	          |			СтатусКлиентаОсновной = &СтатусОсновной
	          |				И СтатусКлиентаДополнительный = &СтатусДополнительный
	          |				И НеАктуален = ЛОЖЬ) КАК ЛБ_СоставныеСтатусыКлиентаСрезПоследних
	          |
	          |УПОРЯДОЧИТЬ ПО
	          |	ЛБ_СоставныеСтатусыКлиентаСрезПоследних.Период УБЫВ";
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() Тогда
		Возврат ВыборкаС.СтатусСоставной;
	КонецЕсли;
	Возврат неопределено;
КонецФункции	

//+МАН 27.12.24 Добавил параметр Залогодатель для проверки на наличие действующих условий по процентным ставкам.. Заявка 2792.
Функция ПолучитьДоступныеПроцентныеСхемыАкции(Дата, Ломбард, СтатусПоСистемеЛояльности, СуммаЗайма, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель, Залогодатель = Неопределено)Экспорт		
	МассивСтатусовКлиента = Новый Массив;
	МассивСтатусовКлиента.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
	Если ЗначениеЗаполнено(СтатусПоСистемеЛояльности) Тогда
		МассивСтатусовКлиента.Добавить(СтатусПоСистемеЛояльности);
		Если ЗначениеЗаполнено(СтатусПоСистемеЛояльности.Родитель) Тогда 
			МассивСтатусовКлиента.Добавить(СтатусПоСистемеЛояльности.Родитель);
		КонецЕсли;	
	КонецЕсли;	

	//+МАН 27.12.24 Проверить действующие условия по ставкам для ВИПа. Заявка 2792.
	ЕстьВИПУсловияПоСтавкам = ПроверитьВИПУсловияПОСтавкам(Дата, Залогодатель);
	//-МАН

	Для каждого Эл Из СписокДопСтатусов Цикл 
		//+МАН 27.12.24 Добавляем или нет статус ВИП. Заявка 2792. Было без условия
		Если Эл.Значение = Справочники.ЛБ_СтатусыЗалогодателей.VIP И ЕстьВИПУсловияПоСтавкам Тогда
			МассивСтатусовКлиента.Добавить(Эл.Значение);
			Если ЗначениеЗаполнено(Эл.Значение.Родитель) Тогда 
				МассивСтатусовКлиента.Добавить(Эл.Значение.Родитель);
			КонецЕсли;	 
			СоставнойСтатус = ПолучитьСоставнойСтатусКлиента(Дата, СтатусПоСистемеЛояльности, Эл.Значение);
			Если НЕ СоставнойСтатус = неопределено Тогда
				МассивСтатусовКлиента.Добавить(СоставнойСтатус);
			КонецЕсли;	
		ИначеЕсли Эл.Значение <> Справочники.ЛБ_СтатусыЗалогодателей.VIP Тогда
			МассивСтатусовКлиента.Добавить(Эл.Значение);
			
			Если ЗначениеЗаполнено(Эл.Значение.Родитель) Тогда 
				МассивСтатусовКлиента.Добавить(Эл.Значение.Родитель);
			КонецЕсли;	 
			
			СоставнойСтатус = ПолучитьСоставнойСтатусКлиента(Дата, СтатусПоСистемеЛояльности, Эл.Значение);
			
			Если НЕ СоставнойСтатус = неопределено Тогда
				МассивСтатусовКлиента.Добавить(СоставнойСтатус);
			КонецЕсли;
		КонецЕсли;
		//-МАН
	Конеццикла;	
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок КАК ЛБ_ПрейскурантПроцентныхСтавок
	               |ГДЕ
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Ломбард = &Ломбард
	               |	И ЛБ_ПрейскурантПроцентныхСтавок.ДатаНачалаДействия <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
        Запрос.УстановитьПараметр("Регистратор", Выборка.Регистратор);
		Запрос.УстановитьПараметр("ПричинаПрименения", ПричинаПримененияПроцентнойСхемы);
		Запрос.УстановитьПараметр("СуммаЗайма", СуммаЗайма);
		Запрос.УстановитьПараметр("Статусы", МассивСтатусовКлиента); 
		Запрос.УстановитьПараметр("ПустаяАкция", Справочники.ЛБ_Акции.ПустаяСсылка());
		Запрос.УстановитьПараметр("ОтказОтВыкупа", ОтказОтВыкупа);
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.СхемаКредитования КАК СхемаКредитования,
		               |	&ПустаяАкция КАК Акция
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок.СрезПоследних(
		               |			&Дата,
		               |			ДатаНачалаДействия <= &Дата
		               |				И Ломбард = &Ломбард
		               |				И ПричинаПрименения = &ПричинаПрименения
		               |				И СтатусЗалогодателя В (&Статусы)
		               |				И ДиапазонСуммЗайма.СуммаОт <= &СуммаЗайма
		               |				И ВЫБОР
		               |					КОГДА ДиапазонСуммЗайма.СуммаДо = 0
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ ДиапазонСуммЗайма.СуммаДо >= &СуммаЗайма
		               |				КОНЕЦ) КАК ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних
		               |ГДЕ
		               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Регистратор = &Регистратор
		               |	И ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.СхемаКредитования.ОтказОтВыкупа = &ОтказОтВыкупа";	
		ТаблицаСхемКредитованияАкций = Запрос.Выполнить().Выгрузить(); 
					
		МассивСК = Новый Массив;  
		МассивСК.Добавить(Справочники.ЛБ_СхемыКредитования.ПустаяСсылка());
		Для каждого Стр Из ТаблицаСхемКредитованияАкций Цикл 
			Если Стр.СхемаКредитования.НеПрименятьАкции тогда
				Продолжить;
			КонецЕсли;	
			Если МассивСК.Найти(Стр.СхемаКредитования) = неопределено Тогда
		       МассивСК.Добавить(Стр.СхемаКредитования);
			КонецЕсли;   
		КонецЦикла;	   
		ТаблицаАкций = ЛБ_ОбщийМодуль.ВыбратьДействующиеАкции(Дата, Ломбард, ПричинаПримененияПроцентнойСхемы, МассивСтатусовКлиента, СуммаЗайма, СписокЛьготныхСтатусов, МассивСК, Промокод, Предъявитель);
	
		Для каждого Выборка из ТаблицаАкций Цикл 
			Если НЕ ЗначениеЗаполнено(Выборка.СхемаКредитования) Тогда 
				Для каждого СК Из МассивСК Цикл
					Если НЕ ЗначениеЗаполнено(СК) Тогда
						Продолжить;
					КонецЕсли;	
					НоваяСтр = ТаблицаСхемКредитованияАкций.Добавить();
					НоваяСтр.СхемаКредитования = СК; 
					НоваяСтр.Акция = Выборка.Акция;   	
				КонецЦикла;	
			Иначе
				НоваяСтр = ТаблицаСхемКредитованияАкций.Добавить();
				НоваяСтр.СхемаКредитования = Выборка.СхемаКредитования; 
				НоваяСтр.Акция = Выборка.Акция;   	
			КонецЕсли;	
		КонецЦикла;	
	
		ТаблицаСхемКредитованияАкций.Свернуть("СхемаКредитования, Акция");
		ТаблицаСхемКредитованияАкций.Колонки.Добавить("Приоритет");
		ТаблицаСхемКредитованияАкций.ЗаполнитьЗначения(0, "Приоритет");
		
		 
		Запрос.Текст = "ВЫБРАТЬ
		                |	ЛБ_ПриоритетыВыбораУсловийЗайма.СхемаКредитования КАК СхемаКредитования,
		                |	ЛБ_ПриоритетыВыбораУсловийЗайма.Акция КАК Акция,
		                |	ЛБ_ПриоритетыВыбораУсловийЗайма.Приоритет КАК Приоритет
		                |ИЗ
		                |	РегистрСведений.ЛБ_ПриоритетыВыбораУсловийЗайма КАК ЛБ_ПриоритетыВыбораУсловийЗайма
		                |ГДЕ
		                |	ЛБ_ПриоритетыВыбораУсловийЗайма.ОтказОтВыкупа = &ОтказОтВыкупа";
		ТаблицаП = Запрос.Выполнить().Выгрузить();
		
		Для каждого стр из ТаблицаСхемКредитованияАкций Цикл 
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", стр.СхемаКредитования);
			Отбор.Вставить("Акция", стр.Акция);
			
			Строки = ТаблицаП.НайтиСтроки(Отбор);
			Если НЕ строки.Количество() = 0 Тогда
				Стр.Приоритет = Строки.Получить(0).Приоритет;
			КонецЕсли;	
		КонецЦикла;	
				
		Возврат ТаблицаСхемКредитованияАкций;
	КонецЕсли;
	Возврат неопределено;
КонецФункции	

Функция ПолучитьНачисленныеПроцентыПоДоговору(ДокументОбъект = неопределено, ЗалоговыйБилет) Экспорт  
	Если ДокументОбъект = неопределено Тогда
		ДатаДок = ТекущаяДата();
	Иначе	
		Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда	  
			МоментДоДокумента = Новый Граница(Новый МоментВремени(ДокументОбъект.Дата, ДокументОбъект.Ссылка), ВидГраницы.Исключая);
			ДатаДок = МоментДоДокумента; 
		Иначе	
		    ДатаДок = ДокументОбъект.Дата;
		КонецЕсли;
	КонецЕсли;	

	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ЛБ_РасчетыСКлиентамиОбороты.СуммаПриход) КАК СуммаПроценты
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.Обороты(
	               |			,
	               |			&Дата,
	               |			,
	               |			ВидРасчета = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыРасчетов.ПоПроцентам)
	               |				И ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РасчетыСКлиентамиОбороты"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ?(Выборка.СуммаПроценты  = NULL, 0, Выборка.СуммаПроценты);
	КонецЕсли;
	Возврат 0;
КонецФункции	  

