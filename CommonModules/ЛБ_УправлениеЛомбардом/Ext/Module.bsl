Функция ПридуматьТокен()
	Токен = "";         
	НаборСимв = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
	Для Цкл = 1 по 48 Цикл                               
		ГСЧ = Новый ГенераторСлучайныхЧисел(); 
		СлучСимвол = Сред(НаборСимв,ГСЧ.СлучайноеЧисло(1,СтрДлина(НаборСимв)),1);
		Токен = Токен + СлучСимвол;
	КонецЦикла;
	Возврат Токен;
КонецФункции
 
Функция фПрочитатьJSON(ТекстJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Структура = ЗаполнитьСтруктуруИзОтветаJSON(Чтение); 
	Чтение.Закрыть();
	Возврат Структура;
КонецФункции
 
Функция ПроверитьПаспорт(Парам) Экспорт 
	Серия = Парам.Серия;  
	Номер = Парам.Номер;
	URL = "rc-data.ru"; // URL-адрес веб-сервера, на который отправляется запрос
	    //PostData = "pssprt/get_info?series=" + СокрЛП(Серия) + "&number=" + СокрЛП(Номер) + "&token=" + ПридуматьТокен(); // Данные, которые нужно отправить в запросе
	PostData = "/pssprt/get_info";
	ПараметрыЗапроса = "series=" + СокрЛП(Серия) + "&number=" + СокрЛП(Номер) + "&token=" + ПридуматьТокен();
	 
	Соединение = Новый HTTPСоединение(URL,,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	 
    Заголовки = Новый Соответствие;                    
    Заголовки.Вставить("User-Agent", "Mozilla/4.0 (compatible; MSIE 6.0; Windows NT 5.0)");
    Заголовки.Вставить("Content-type", "application/x-www-form-urlencoded");
 
    Запрос = Новый HTTPЗапрос(PostData, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ПараметрыЗапроса);
	    //Запрос.УстановитьТелоИзСтроки(КодПриглашения);
	 
    Результат = Соединение.ОтправитьДляОбработки(Запрос);
	
	СтруктураВозврата = Новый Структура;
	
	Если Результат.КодСостояния<>200 тогда
		СтруктураВозврата.Вставить("Проверка", ложь);
	    СтруктураВозврата.Вставить("Сообщение", "Сервис проверки паспортов не работает, либо ошибки в запросе");
	Иначе
	    Рез = фПрочитатьJSON(Результат.ПолучитьТелоКакСтроку());
		Если НЕ Рез.Свойство("status") Тогда 
			СтруктураВозврата.Вставить("Проверка", ложь);
	        СтруктураВозврата.Вставить("Сообщение", "Сервис проверки паспортов не работает, либо ошибки в запросе");
		   Возврат "Ошибки в запросе";
		ИначеЕсли Рез.status = 1 Тогда
		   Возврат "Паспорт "+Серия+" "+Номер+" действительный";
		ИначеЕсли Рез.status = 0 Тогда
		   Возврат "Паспорт "+Серия+" "+Номер+" не действительный";
		Иначе
		   Возврат "Не могу разобрать ответ:" + Результат.ПолучитьТелоКакСтроку();
		КонецЕсли;
	КонецЕсли;   
	
	Возврат СтруктураВозврата;
КонецФункции
 
Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач Чтение) Экспорт
	Результат = Новый Структура;
	ПоследнееИмяРеквизита = Неопределено;
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта И ПоследнееИмяРеквизита<>Неопределено Тогда 
		    Результат[ПоследнееИмяРеквизита] = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
		ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта Тогда 
		    Возврат Результат;
		    ПоследнееИмяРеквизита = Неопределено;
		ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства Тогда 
			Результат.Вставить(Чтение.ТекущееЗначение, Неопределено);
			ПоследнееИмяРеквизита = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.Булево или Тип = ТипЗначенияJSON.Строка
		  или Тип = ТипЗначенияJSON.Число или Тип = ТипЗначенияJSON.Null Тогда 
		    Результат[ПоследнееИмяРеквизита] = Чтение.ТекущееЗначение;
		КонецЕсли;
	КонецЦикла;  
	Возврат Результат;
КонецФункции 
