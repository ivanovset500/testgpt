Функция ПроверитьСтатусПочетный(ДатаРождения, Пол) Экспорт
	Если ДатаРождения = Дата(1,1,1) Тогда 
		Возврат ложь;
	КонецЕсли;	 
	Если НЕ ЗначениеЗаполнено(Пол) Тогда
		Возврат ложь;
	КонецЕсли; 
	
	ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
		
	Если Пол = Перечисления.ПолФизическогоЛица.Женский Тогда 
		Если ВозрастЗалогодателя  >= 55 Тогда  
			Возврат  Истина;
		КонецЕсли;	
	ИначеЕсли Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
		Если ВозрастЗалогодателя  >= 60 Тогда  
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	 
	
	Возврат ложь;
КонецФункции	

Функция ПолучитьСхемыКредитованияДляРасчета(Дата)
	СписокСК = Новый СписокЗначений;
	
	ЗапросСК = Новый Запрос; 
	ЗапросСК.УстановитьПараметр("Дата", Дата);
	ЗапросСК.Текст = "ВЫБРАТЬ
	                 |	ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльностиСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	                 |	ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльностиСрезПоследних.Участвует КАК Участвует
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльности.СрезПоследних(&Дата, ) КАК ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльностиСрезПоследних";  
	ВыборкаСК = ЗапросСК.Выполнить().Выбрать();
	Пока ВыборкаСК.Следующий() цикл  
