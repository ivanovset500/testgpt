
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Результат.Очистить();  
	
	ДатаКон = ?(Отчет.ДатаКон = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.ДатаКон));
	
	Результат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИндивидуальныеУсловия";
	
	Макет = Отчет.РеквизитМакет;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ДатаОтчета = Формат(ДатаКон, "ДФ=dd.MM.yyyy");
	Результат.Вывести(ОбластьШапка);

	//Для каждого Стр Из РезультатЗапроса Цикл
	Если ЗначениеЗаполнено(Отчет.Залогодатель) Тогда
		ДействующийПриказ = НайтиДействующийПриказ(ДатаКон, Отчет.Залогодатель);

		Если ДействующийПриказ = Неопределено Тогда
			ОбластьНетУсловий = Макет.ПолучитьОбласть("СтрокаНетУсловий");
			Результат.Вывести(ОбластьНетУсловий);
			
			Возврат;
		КонецЕсли;
		
		//Заполняем таблицу залогодателя
		//ДатаРождения = ПолучитьДатуРожденияЗалогодателя(ДатаКон, Стр.Залогодатель);
		//ДатаНачалаДействия = ДействующийПриказ[0].ДатаНачалаДействия;
		ДатаИФИО = "" + ?(НачалоДня(ДействующийПриказ[0].ДатаНачалаДействия) > НачалоДня(ДействующийПриказ[0].ДатаДокумента), ДействующийПриказ[0].ДатаНачалаДействия, ДействующийПриказ[0].ДатаДокумента)
			+ " " + ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ДействующийПриказ[0].Приказ.Ответственный.Сотрудник.Наименование);
		//Пока нет этого поля
		//Основание = "";
		//
		ДатаОкончанияДействия = Дата(1,1,1);
		
		ПрСтавки = "";
		ПрМеталлы = "";
		ПрВставки = "";
		
		ЕстьПустаяДата = Ложь;
		
		Для каждого Стр Из ДействующийПриказ Цикл
			Если Стр.Ставки И ПрСтавки = "" Тогда
				ПрСтавки = Стр.Приказ;
			КонецЕсли;
			
			Если Стр.Металлы И ПрМеталлы = "" Тогда
				ПрМеталлы = Стр.Приказ;
			КонецЕсли;
			
			Если Стр.Вставки И ПрВставки = "" Тогда
				ПрВставки = Стр.Приказ;
			КонецЕсли;
			
			Основание = ?(СокрЛП(Основание) = "", "", ", ");
			Основание = Основание + Стр.Приказ.ОснованиеПриказа;
			
			Если Стр.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ЕстьПустаяДата = Истина;
			Иначе
				ДатаОкончанияДействия = Макс(ДатаОкончанияДействия, Стр.ДатаОкончанияДействия);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьПустаяДата Тогда
			ДатаОкончанияДействия = Дата(1,1,1);
		КонецЕсли;
		
		//ОбластьЗаголовокЗ = Макет.ПолучитьОбласть("ЗаголовокЗ");
		//Результат.Вывести(ОбластьЗаголовокЗ);
		//
		//ОбластьСтрокаЗ = Макет.ПолучитьОбласть("СтрокаЗ");
		//ОбластьСтрокаЗ.Параметры.ФИОЗаемщика = Отчет.Залогодатель;
		//ОбластьСтрокаЗ.Параметры.ДатаРождения = ПолучитьДатуРожденияЗалогодателя(ДатаКон, Отчет.Залогодатель);;
		//ОбластьСтрокаЗ.Параметры.ДатаНачалаДействияСтатуса = ДействующийПриказ[0].ДатаНачалаДействия;
		//ОбластьСтрокаЗ.Параметры.ДатаОкончанияДействияСтатуса = ?(ДатаОкончанияДействия = Дата(1,1,1), "-", ДатаОкончанияДействия);
		//ОбластьСтрокаЗ.Параметры.ДатаПрисвоенияФИОИсполнителя = ДатаИФИО;
		//ОбластьСтрокаЗ.Параметры.Основание = Основание;
		//
		//Результат.Вывести(ОбластьСтрокаЗ);
		
		ОбластьШапкаЗ = Макет.ПолучитьОбласть("ШапкаЗ");
		ОбластьШапкаЗ.Параметры.ФИОЗаемщика = Отчет.Залогодатель;
		ОбластьШапкаЗ.Параметры.ДатаРождения = ПолучитьДатуРожденияЗалогодателя(ДатаКон, Отчет.Залогодатель);;
		ОбластьШапкаЗ.Параметры.ДатаНачалаДействияСтатуса = ДействующийПриказ[0].ДатаНачалаДействия;
		ОбластьШапкаЗ.Параметры.ДатаОкончанияДействияСтатуса = ?(ДатаОкончанияДействия = Дата(1,1,1), "-", ДатаОкончанияДействия);
		ОбластьШапкаЗ.Параметры.ДатаПрисвоенияФИОИсполнителя = ДатаИФИО;
		ОбластьШапкаЗ.Параметры.Основание = Основание;
		
		Результат.Вывести(ОбластьШапкаЗ);
		
		//Подготавливаем данные для заполнения условий
		МассивУдаленияСтрок = Новый Массив;
		
		Если ПрСтавки <> "" Тогда
			ТЗСтавки = ПрСтавки.СтавкиПроцентов.Выгрузить();
			МассивУдаленияСтрок.Очистить();
			
			Для каждого СтрС Из ТЗСтавки Цикл
				Если СтрС.Ставка = 0 Тогда
					МассивУдаленияСтрок.Добавить(СтрС);
				КонецЕсли;			
			КонецЦикла;
			
			Если МассивУдаленияСтрок.Количество() > 0 Тогда
				Для каждого СтрМ Из МассивУдаленияСтрок Цикл
					ТЗСтавки.Удалить(СтрМ);
				КонецЦикла;
			КонецЕсли;
			
			ТЗСКСтавки = ТЗСтавки.Скопировать(, "СхемаКредитования");
			ТЗСКСтавки.Свернуть("СхемаКредитования");
			ТЗСКСтавки.Сортировать("СхемаКредитования Возр");
			
		КонецЕсли;
		
		Если ПрМеталлы <> "" Тогда
			ТЗМеталлы = ПрМеталлы.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить();
			
			МассивУдаленияСтрок.Очистить();
			
			Для каждого СтрМ Из ТЗМеталлы Цикл
				Если НЕ ЗначениеЗаполнено(СтрМ.ОтклонениеОтБазовойЦены) Тогда
					МассивУдаленияСтрок.Добавить(СтрМ);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивУдаленияСтрок.Количество() > 0 Тогда
				Для каждого СтрМ Из МассивУдаленияСтрок Цикл
					ТЗМеталлы.Удалить(СтрМ);
				КонецЦикла;
			КонецЕсли;
			
			ТЗСКМеталлы = ТЗМеталлы.Скопировать(, "СхемаКредитования");
			ТЗСКМеталлы.Свернуть("СхемаКредитования");
			ТЗСКМеталлы.Сортировать("СхемаКредитования Возр");
			
		КонецЕсли;
		
		Если ПрВставки <> "" Тогда
			ТЗВставки = ПрВставки.НастройкаОтклоненийОтБазовыхЦенВставки.Выгрузить();
			
			ТЗСКВставки = ТЗВставки.Скопировать(, "СхемаКредитования");
			ТЗСКВставки.Свернуть("СхемаКредитования");
			ТЗСКВставки.Сортировать("СхемаКредитования Возр");
		КонецЕсли;
		
		//Заполняем ставки
		Если ПрСтавки = "" Тогда
			ОбластьШапкаС = Макет.ПолучитьОбласть("ШапкаС");
			ОбластьШапкаС.Параметры.Приказ = " - не установлены.";
			Результат.Вывести(ОбластьШапкаС);
		Иначе
			ОбластьШапкаС = Макет.ПолучитьОбласть("ШапкаС");
			ОбластьШапкаС.Параметры.Приказ = ". Приказ № " + ПрСтавки.НомерПриказа + " от " + Формат(ПрСтавки.Дата, "ДФ=dd.MM.yyyy")
			+ ", действует с " + Формат(ПрСтавки.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy")
			+ ?(ПрСтавки.ДатаОкончанияДействияПриказа = Дата(1,1,1), "", " по " + Формат(ПрСтавки.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy"));
			Результат.Вывести(ОбластьШапкаС);
			
			Для каждого СтрСК Из ТЗСКСтавки Цикл
				ОтборСК = Новый Структура;
				ОтборСК.Вставить("СхемаКредитования", СтрСК.СхемаКредитования);
				
				СтрокиС = ТЗСтавки.НайтиСтроки(ОтборСК);
				
				Если СтрокиС.Количество() > 0 Тогда
					//Добавляем колонки заголовка
					Инд = 1;
					
					Для каждого СтрС Из СтрокиС Цикл
						Если Инд = 1 Тогда
							ОбластьЗаголовокС = Макет.ПолучитьОбласть("ЗаголовокС|КолонкаЗаголовокС");
							ОбластьЗаголовокС.Параметры.СК = СтрС.СхемаКредитования.Наименование; //СтрС.СхемаКредитования.НаименованиеДляПечати;
							ОбластьЗаголовокС.Параметры.Диапазон = СтрС.ДиапазонСумм;
							Результат.Вывести(ОбластьЗаголовокС);
							Инд = Инд + 1;
						Иначе
							ОбластьЗаголовокС = Макет.ПолучитьОбласть("ЗаголовокС|КолонкаДопС");
							ОбластьЗаголовокС.Параметры.Диапазон = СтрС.ДиапазонСумм;
							Результат.Присоединить(ОбластьЗаголовокС);
						КонецЕсли;
					КонецЦикла;
					
					//Обединяем заголовок
					НомерСтр = Результат.ВысотаТаблицы;
					Результат.Область(НомерСтр - 2, 1, НомерСтр - 2, СтрокиС.Количество()).Объединить();
					
					//Добавляем колонки строк
					Инд = 1;
					
					Для каждого СтрС Из СтрокиС Цикл
						Если Инд = 1 Тогда
							ОбластьСтрокаС = Макет.ПолучитьОбласть("СтрокаС|КолонкаЗаголовокС");
							ОбластьСтрокаС.Параметры.Ставка = СтрС.Ставка;
							Результат.Вывести(ОбластьСтрокаС);
							Инд = Инд + 1;
						Иначе
							ОбластьСтрокаС = Макет.ПолучитьОбласть("СтрокаС|КолонкаДопС");
							ОбластьСтрокаС.Параметры.Ставка = СтрС.Ставка;
							Результат.Присоединить(ОбластьСтрокаС);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		//Заполняем металлы
		Если ПрМеталлы = "" Тогда
			ОбластьШапкаМ = Макет.ПолучитьОбласть("ШапкаМ");
			ОбластьШапкаМ.Параметры.Приказ = " - не установлены.";
			Результат.Вывести(ОбластьШапкаМ);
		Иначе
			ОбластьШапкаМ = Макет.ПолучитьОбласть("ШапкаМ");
			ОбластьШапкаМ.Параметры.Приказ = ". Приказ № " + ПрМеталлы.НомерПриказа + " от " + Формат(ПрМеталлы.Дата, "ДФ=dd.MM.yyyy")
			+ ", действует с " + Формат(ПрМеталлы.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy")
			+ ?(ПрМеталлы.ДатаОкончанияДействияПриказа = Дата(1,1,1), "", " по " + Формат(ПрМеталлы.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy"));
			Результат.Вывести(ОбластьШапкаМ);
			
			Для каждого СтрСК Из ТЗСКМеталлы Цикл
				ОтборСК = Новый Структура;
				ОтборСК.Вставить("СхемаКредитования", СтрСК.СхемаКредитования);
				
				ТЗМетСК = ТЗМеталлы.Скопировать(ОтборСК,);
				
				Если ТЗМетСК.Количество() > 0 Тогда
					ОтборОтклонение = Новый Структура;
					ОтборОтклонение.Вставить("ОтклонениеОтБазовойЦены", Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное);
					
					ТЗОтн = ТЗМетСК.Скопировать(ОтборОтклонение,);
					
					ТаблицаМеталловОтн = ТЗОтн.Скопировать();
					ТаблицаМеталловОтн.Свернуть("КатегорияОбъектаЗалога, Металл, ЗначениеОтклонения, СхемаКредитования");
					
					ОтборОтклонение = Новый Структура;
					ОтборОтклонение.Вставить("ОтклонениеОтБазовойЦены", Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное);
					
					ТЗАбс = ТЗМетСК.Скопировать(ОтборОтклонение,);
					
					ТаблицаМеталловАбс = ТЗАбс.Скопировать();
					ТаблицаМеталловАбс.Свернуть("КатегорияОбъектаЗалога, Металл, ЗначениеОтклонения, СхемаКредитования");
					
					Если ТЗОтн.Количество() > 0 Тогда
						ТЗОтнМет = ТЗОтн.Скопировать();
						ТЗОтнМет.Свернуть("Металл");
						ТЗОтнМет.Сортировать("Металл Возр");
						
						
						ОбластьЗаголовокМеталлы = Макет.ПолучитьОбласть("ЗаголовокМ|КолонкаЗаголовок");
						ОбластьЗаголовокМеталлы.Параметры.СК = СтрСК.СхемаКредитования.Наименование;
						Результат.Вывести(ОбластьЗаголовокМеталлы);
						
						//Заполняем шапку заголовка таблицы
						НомерКолонки = 2;
						Для каждого СтрМетОтн Из ТЗОтнМет Цикл
							ОбластьЗаголовокМеталлыДоп = Макет.ПолучитьОбласть("ЗаголовокМ|КолонкаДоп");
							
							Если НомерКолонки = 2 Тогда
								ОбластьЗаголовокМеталлыДоп.Параметры.Отклонение = "Увеличение суммы оценки за грамм драгоценного металла в % от базовой оценки";
							КонецЕсли;
							
							ОбластьЗаголовокМеталлыДоп.Параметры.Металл = СтрМетОтн.Металл.Наименование;
							Результат.Присоединить(ОбластьЗаголовокМеталлыДоп);
							
							НомерКолонки = НомерКолонки + 1;
						КонецЦикла;
						
						НомерСтр = Результат.ВысотаТаблицы;
						
						//Подготавливаем ТЗ для заполнения строк
						Если ТЗОтнМет.Количество() > 1 Тогда
							//Результат.Область(НомерСтр - 2, 3, НомерСтр - 1, НомерКолонки + ТЗОтнМет.Количество()).Объединить();
							Результат.Область(НомерСтр - 2, 3, НомерСтр - 1, НомерКолонки).Объединить();

							ПромежуточнаяТабМет = ТаблицаМеталловОтн.Скопировать();

							КоличествоМеталлов = ТЗОтнМет.Количество();
							
							ТЗРезультат = ПромежуточнаяТабМет.Скопировать(,"КатегорияОбъектаЗалога, ЗначениеОтклонения");
							ТЗРезультат.Очистить();
							
							Для Сч = 0 По КоличествоМеталлов - 1 Цикл
								Отбор = Новый Структура;
								Отбор.Вставить("Металл", ТЗОтнМет[Сч].Металл);
								
								Если ТЗРезультат.Количество() = 0 Тогда
									ТЗРезультат = ПромежуточнаяТабМет.Скопировать(Отбор,);
									ТЗРезультат.Сортировать("КатегорияОбъектаЗалога Возр");
								Иначе
									ПромежуточнаяТабМет2 = ПромежуточнаяТабМет.Скопировать(Отбор,);
									ПромежуточнаяТабМет2.Сортировать("КатегорияОбъектаЗалога Возр");
									
									//Добавляем колонку в которую потом загрузим данные нового металла
									ТЗРезультат.Колонки.Добавить("ЗначениеОтклонения" + ТЗОтнМет[Сч].Металл.Наименование);
									
									Для каждого СтрПромежуточная Из ПромежуточнаяТабМет2 Цикл
										НайденнаяСтр = ТЗРезультат.Найти(СтрПромежуточная.КатегорияОбъектаЗалога, "КатегорияОбъектаЗалога");
										
										Если НайденнаяСтр = Неопределено Тогда
											НаяСтр = ТЗРезультат.Добавить();
											НаяСтр.КатегорияОбъектаЗалога = СтрПромежуточная.КатегорияОбъектаЗалога;
											НаяСтр["ЗначениеОтклонения" + ТЗОтнМет[Сч].Металл.Наименование] = СтрПромежуточная.ЗначениеОтклонения;
										Иначе
											НайденнаяСтр["ЗначениеОтклонения" + ТЗОтнМет[Сч].Металл.Наименование] = СтрПромежуточная.ЗначениеОтклонения;
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЦикла;
						Иначе
							ТЗРезультат = ТаблицаМеталловОтн.Скопировать();
						КонецЕсли;
						
						//Заполняем строки
						Для каждого СтрРез Из ТЗРезультат Цикл
							ОбластьСтрокаМеталлы = Макет.ПолучитьОбласть("СтрокаМ|КолонкаЗаголовок");
							ОбластьСтрокаМеталлыДоп = Макет.ПолучитьОбласть("СтрокаМ|КолонкаДоп");
							
							ОбластьСтрокаМеталлы.Параметры.Категория = СтрРез.КатегорияОбъектаЗалога;
							Результат.Вывести(ОбластьСтрокаМеталлы);					
							
							Если ТЗОтнМет.Количество() > 1 Тогда
								КоличествоМеталлов = ТЗОтнМет.Количество();
								Для Сч = 0 По КоличествоМеталлов - 1 Цикл
									Если Сч = 0 Тогда
										ОбластьСтрокаМеталлыДоп.Параметры.ЗнчОтклонения = СтрРез.ЗначениеОтклонения;
									Иначе
