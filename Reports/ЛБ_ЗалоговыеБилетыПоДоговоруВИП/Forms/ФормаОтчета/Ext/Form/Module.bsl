КонецПроцедуры

&НаСервере
Функция ПолучитьОтменыПриказа(ДатаНач, ДатаКон, Залогодатель, ОтменяемыйПриказ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период КАК Период
		|ИЗ
		//|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.СрезПоследних(
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.СрезПервых(
		//|			&Дата,
		|			,
		|			Залогодатель В (&Залогодатель)
		|				И Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|				И ОтменяемыйПриказ = &ОтменяемыйПриказ) КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		|ГДЕ
		//|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор КАК Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период КАК Период
		|ИЗ
		//|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.СрезПоследних(
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.СрезПервых(
		//|			&Дата,
		|			,
		|			Залогодатель В (&Залогодатель)
		|				И Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|				И ОтменяемыйПриказ = &ОтменяемыйПриказ) КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
		|ГДЕ
		//|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия <= &Дата
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор КАК Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период КАК Период
		|ИЗ
		//|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.СрезПоследних(
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.СрезПервых(
		//|			&Дата,
		|			,
		|			Залогодатель В (&Залогодатель)
		|				И Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|				И ОтменяемыйПриказ = &ОтменяемыйПриказ) КАК ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок
		|ГДЕ
		//|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия <= &Дата
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия,
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("ОтменяемыйПриказ", ОтменяемыйПриказ);
	
	Пакеты = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Ставки = Пакеты[0].Выгрузить();
	Металлы = Пакеты[1].Выгрузить();
	Вставки = Пакеты[2].Выгрузить();
	
	СтруктураВозврата = Новый Структура("Приказы, МаксДата");
	МассивПриказы = Новый Массив;
	
	МТип = Новый Массив;
	МТип.Добавить(Тип("ДокументСсылка.ЛБ_ПриказИндивидуальныеУсловия"));
	
	ОписаниеТиповПриказ = Новый ОписаниеТипов(МТип);
	
	ТЗПриказы = Новый ТаблицаЗначений;
	ТЗПриказы.Колонки.Добавить("Приказ", ОписаниеТиповПриказ);
	
	МассивУдаленияСтрок = Новый Массив;

	ТЗСтавки = ОтменяемыйПриказ.СтавкиПроцентов.Выгрузить(, "Ставка");
	
	Для каждого СтрС Из ТЗСтавки Цикл
		Если СтрС.Ставка = 0 Тогда
			МассивУдаленияСтрок.Добавить(СтрС);
		КонецЕсли;			
	КонецЦикла;
	
	Если МассивУдаленияСтрок.Количество() > 0 Тогда
		Для каждого СтрМ Из МассивУдаленияСтрок Цикл
			ТЗСтавки.Удалить(СтрМ);
		КонецЦикла;
	КонецЕсли;

	УстановленныСтавки = ТЗСтавки.Количество() > 0;
	УстановленныМеталлы = ОтменяемыйПриказ.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0;
	УстановленныВставки = ОтменяемыйПриказ.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0;
	
	МаксДатаСтавки = Дата(1,1,1);
	МаксДатаМеталлы = Дата(1,1,1);
	МаксДатаВствки = Дата(1,1,1);
	
	Если УстановленныСтавки Тогда
		Для каждого СтрС Из Ставки Цикл
			МаксДатаСтавки = Макс(МаксДатаСтавки, ?(НачалоДня(СтрС.ДатаНачалаДействия) > НачалоДня(СтрС.Период), СтрС.ДатаНачалаДействия, СтрС.Период));
			//МассивПриказы.Добавить(СтрС.Регистратор);
			НоваяСтр = ТЗПриказы.Добавить();
			НоваяСтр.Приказ = СтрС.Регистратор;
		КонецЦикла;
	КонецЕсли;
	
	//Если МаксДатаСтавки = Дата(1,1,1) И УстановленныСтавки Тогда
	//	//МаксДатаСтавки = ?(ТекущаяДата() < Отчет.ДатаКон, Отчет.ДатаКон, ТекущаяДата());
	//	МаксДатаСтавки = Отчет.ДатаКон;
	//КонецЕсли;
	
	Если УстановленныМеталлы Тогда
		Для каждого СтрМ Из Металлы Цикл
			МаксДатаМеталлы = Макс(МаксДатаМеталлы, ?(НачалоДня(СтрМ.ДатаНачалаДействия) > НачалоДня(СтрМ.Период), СтрМ.ДатаНачалаДействия, СтрМ.Период));
			//МассивПриказы.Добавить(СтрМ.Регистратор);
			НоваяСтр = ТЗПриказы.Добавить();
			НоваяСтр.Приказ = СтрМ.Регистратор;
		КонецЦикла;
	КонецЕсли;

	//Если МаксДатаМеталлы = Дата(1,1,1) И УстановленныМеталлы Тогда
	//	//МаксДатаМеталлы = ?(ТекущаяДата() < Отчет.ДатаКон, Отчет.ДатаКон, ТекущаяДата());
	//	МаксДатаМеталлы = Отчет.ДатаКон;
	//КонецЕсли;
	
	Если УстановленныВставки Тогда
		Для каждого СтрВ Из Вставки Цикл
			МаксДатаВствки = Макс(МаксДатаВствки, ?(НачалоДня(СтрВ.ДатаНачалаДействия) > НачалоДня(СтрВ.Период), СтрВ.ДатаНачалаДействия, СтрВ.Период));
			//МассивПриказы.Добавить(СтрВ.Регистратор);
			НоваяСтр = ТЗПриказы.Добавить();
			НоваяСтр.Приказ = СтрВ.Регистратор;
		КонецЦикла;
	КонецЕсли;
	
	//Если МаксДатаВствки = Дата(1,1,1) И УстановленныВставки Тогда
	//	//МаксДатаВствки = ?(ТекущаяДата() < Отчет.ДатаКон, Отчет.ДатаКон, ТекущаяДата());
	//	МаксДатаВствки = Отчет.ДатаКон;
	//КонецЕсли;
	
	//СтруктураВозврата.Приказы = МассивПриказы;
	СтруктураВозврата.Приказы = ТЗПриказы;
	СтруктураВозврата.МаксДата = Макс(МаксДатаСтавки, МаксДатаМеталлы, МаксДатаВствки);
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ПолучитьДокументы(ДатаНач, ДатаКон, Залогодатель)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.Залогодатель КАК Залогодатель,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.НомерЗалоговогоБилета КАК НомерЗБ,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗБ,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.Ломбард КАК Ломбард,
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.Дата КАК ДатаПриема,
		|	"" "" КАК ПризнакЭЗБ,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.ПроцентнаяСхема КАК Ставка,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.ПСКГод КАК ПСК,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаСсудыОборот КАК СуммаСсудыОборот,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.СуммаСсуды КАК ВыданоСуммаЗайма,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыЗаймОборот + ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыПроцентыОборот КАК ОплаченоВсего,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыЗаймОборот КАК ОплаченоТелоЗайма,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыПроцентыОборот КАК ОплаченоПроценты,
		|	ВЫБОР
		|		КОГДА ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.СуммаСсуды - (ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыЗаймОборот + ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыПроцентыОборот) <= 0
		|			ТОГДА 0
		|		ИНАЧЕ ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.СуммаСсуды - (ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыЗаймОборот + ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыПроцентыОборот)
		|	КОНЕЦ КАК ДолгЗайм,
		|	"" "" КАК ДолгПроценты,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.СхемаКредитования КАК ЗалоговыйБилетСхемаКредитования,
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов
		|ИЗ
		|	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(&ДатаНач, &ДатаКон, Авто, Залогодатель В (&Залогодатель)) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&ДатаКон, ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|		ПО ЛБ_ОборотыПоОперациямЗаймаОбороты.Ломбард = ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&ДатаКон, ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
		|		ПО ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет = ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ОборотыПоОперациямЗаймаОбороты.Залогодатель.Наименование,
		|	ДатаПриема,
		|	НомерЗБ";
	
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаКлиенте
Процедура ДатаКонПриИзменении(Элемент)
	Отчет.ДатаКон = КонецДня(Дата(Элемент.ВыделенныйТекст))
КонецПроцедуры

&НаСервере
Функция ПроверитьНаличиеНовыхПриказов(ДатаНач, ДатаКон, Залогодатель, ПриказУстановки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период КАК Период,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия КАК ДатаНачалаДействия,
		//+МАН 25.08.25 Добавил
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		//-МАН
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.СрезПервых(
		|			&ДатаНач,
		|			Залогодатель В (&Залогодатель)
		|				И ВЫБОР
		|					КОГДА Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|						ТОГДА ВЫБОР
		|								КОГДА ОтменяемыйПриказ = &Регистратор
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					КОГДА Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ВИП)
		|						ТОГДА ВЫБОР
		|								КОГДА Регистратор <> &Регистратор
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ) КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия,
		//+МАН 25.08.25 Добавил
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаОкончанияДействия
		//-МАН
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.СрезПервых(
		|			&ДатаНач,
		|			Залогодатель В (&Залогодатель)
		|				И ВЫБОР
		|					КОГДА Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|						ТОГДА ВЫБОР
		|								КОГДА ОтменяемыйПриказ = &Регистратор
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					КОГДА Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ВИП)
		|						ТОГДА ВЫБОР
		|								КОГДА Регистратор <> &Регистратор
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ) КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор,
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период,
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия,
		//+МАН 25.08.25 Добавил
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаОкончанияДействия
		//-МАН
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.СрезПервых(
		|			&ДатаНач,
		|			Залогодатель В (&Залогодатель)
		|				И ВЫБОР
		|					КОГДА Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|						ТОГДА ВЫБОР
		|								КОГДА ОтменяемыйПриказ = &Регистратор
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					КОГДА Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ВИП)
		|						ТОГДА ВЫБОР
		|								КОГДА Регистратор <> &Регистратор
		|									ТОГДА ИСТИНА
		|								ИНАЧЕ ЛОЖЬ
		|							КОНЕЦ
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ) КАК ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаНачалаДействия";

	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Регистратор", ПриказУстановки);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	СтруктураВозврата = Новый Структура("Приказы, Дата");
	МассивПриказы = Новый Массив;
	
	МТип = Новый Массив;
	МТип.Добавить(Тип("ДокументСсылка.ЛБ_ПриказИндивидуальныеУсловия"));
	
	ОписаниеТиповПриказ = Новый ОписаниеТипов(МТип);
	
	ТЗПриказы = Новый ТаблицаЗначений;
	ТЗПриказы.Колонки.Добавить("Приказ", ОписаниеТиповПриказ);
	
	МассивУдаленияСтрок = Новый Массив;
	
	ТЗСтавки = ПриказУстановки.СтавкиПроцентов.Выгрузить(, "Ставка");
	
	Для каждого СтрС Из ТЗСтавки Цикл
		Если СтрС.Ставка = 0 Тогда
			МассивУдаленияСтрок.Добавить(СтрС);
		КонецЕсли;			
	КонецЦикла;
	
	Если МассивУдаленияСтрок.Количество() > 0 Тогда
		Для каждого СтрМ Из МассивУдаленияСтрок Цикл
			ТЗСтавки.Удалить(СтрМ);
		КонецЦикла;
	КонецЕсли;

	УстановленныСтавки = ТЗСтавки.Количество() > 0;
	УстановленныМеталлы = ПриказУстановки.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0;
	УстановленныВставки = ПриказУстановки.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0;

	Для каждого Стр Из РезультатЗапроса Цикл
		Если УстановленныСтавки Тогда
			Если Стр.Регистратор.СтавкиПроцентов.Количество() > 0 Тогда
					
					ТЗСтавки.Очистить();
					МассивУдаленияСтрок.Очистить();
					
					ТЗСтавки = Стр.Регистратор.СтавкиПроцентов.Выгрузить(, "Ставка");
					
					Для каждого СтрТЗ Из ТЗСтавки Цикл
						Если СтрТЗ.Ставка = 0 Тогда
							МассивУдаленияСтрок.Добавить(СтрТЗ);
						КонецЕсли;			
					КонецЦикла;
					
					Если МассивУдаленияСтрок.Количество() > 0 Тогда
						Для каждого СтрМ Из МассивУдаленияСтрок Цикл
							ТЗСтавки.Удалить(СтрМ);
						КонецЦикла;
					КонецЕсли;

					Если ТЗСтавки.Количество() > 0 Тогда
						//+МАН 25.08.25 Изменил
						//УстановленныСтавки = НЕ ТЗСтавки.Количество() > 0;
						
						Если Стр.ДатаОкончанияДействия <> Дата(1,1,1) И Стр.ДатаОкончанияДействия < ДатаКон Тогда
							УстановленныСтавки = Ложь;
						Иначе	
							УстановленныСтавки = НЕ ТЗСтавки.Количество() > 0;
						КонецЕсли;
						//-МАН
						
						НоваяСтр = ТЗПриказы.Добавить();
						НоваяСтр.Приказ = Стр.Регистратор;
					КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если УстановленныМеталлы Тогда
			Если Стр.Регистратор.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0 Тогда
				//+МАН 25.08.25 Изменил
				//УстановленныМеталлы = НЕ Стр.Регистратор.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0;
				
				Если Стр.ДатаОкончанияДействия <> Дата(1,1,1) И Стр.ДатаОкончанияДействия < ДатаКон Тогда
					УстановленныМеталлы = Ложь;
				Иначе	
					УстановленныМеталлы = НЕ Стр.Регистратор.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0;
				КонецЕсли;
				//-МАН
				
				НоваяСтр = ТЗПриказы.Добавить();
				НоваяСтр.Приказ = Стр.Регистратор;
			КонецЕсли;
		КонецЕсли;
		
		Если УстановленныВставки Тогда
			Если Стр.Регистратор.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0 Тогда
				//+МАН 25.08.25 Изменил
				//УстановленныВставки = НЕ Стр.Регистратор.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0;
				
				Если Стр.ДатаОкончанияДействия <> Дата(1,1,1) И Стр.ДатаОкончанияДействия < ДатаКон Тогда
					УстановленныВставки = Ложь;
				Иначе	
					УстановленныВставки = НЕ Стр.Регистратор.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0;
				КонецЕсли;
				//-МАН
				
				НоваяСтр = ТЗПриказы.Добавить();
				НоваяСтр.Приказ = Стр.Регистратор;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ УстановленныСтавки И НЕ УстановленныМеталлы И НЕ УстановленныВставки Тогда
			
			СтруктураВозврата.Приказы = ТЗПриказы;
			СтруктураВозврата.Дата = ?(НачалоДня(Стр.ДатаНачалаДействия) > НачалоДня(Стр.Период), Стр.ДатаНачалаДействия, Стр.Период);
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураВозврата.Приказы = ТЗПриказы;
	СтруктураВозврата.Дата = Дата(1,1,1);
	
	Возврат СтруктураВозврата;
	
КонецФункции













