		//+МАН 25.08.25 Изменил
		ДатаКон = ?(Отчет.Приказ.ДатаОкончанияДействияПриказа <> Дата(1,1,1), Отчет.Приказ.ДатаОкончанияДействияПриказа, Отчет.ДатаКон);
		
		//СтруктураНовыйПриказ = ПроверитьНаличиеНовыхПриказов(Отчет.Приказ.Дата, Отчет.ДатаКон, СтрЗ.Залогодатель, Отчет.Приказ);
		СтруктураНовыйПриказ = ПроверитьНаличиеНовыхПриказов(Отчет.Приказ.Дата, ДатаКон, СтрЗ.Залогодатель, Отчет.Приказ);
		//-МАН
		
		СтруктураНовыйПриказ.Приказы.Свернуть("Приказ");
		
		КонецПериода = Дата(1,1,1);
		
		//тест = Новый ТаблицаЗначений;
		//тест.Скопировать()
		
		//ТЗПриказы = СтруктураНовыйПриказ.Приказы.Скопировать();
		
		//Для каждого СтрП Из СтруктураНовыйПриказ.Приказы Цикл
		//	НоваяСтр = ТЗПриказы.Добавить();
		//	НоваяСтр.Приказ = СтрП.Приказ;
		//КонецЦикла;

		//Если СтруктураОтмены.МаксДата = Дата(1,1,1) И СтруктураНовыйПриказ.Дата = Дата(1,1,1) Тогда
		//	КонецПериода = Отчет.ДатаКон;
		//ИначеЕсли СтруктураОтмены.МаксДата <> Дата(1,1,1) ИЛИ СтруктураНовыйПриказ.Дата <> Дата(1,1,1) Тогда
