
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДатаНач") Тогда
		Отчет.ДатаНач = Параметры.ДатаНач;
	КонецЕсли;

	Если Параметры.Свойство("ДатаКон") Тогда
		Отчет.ДатаКон = КонецДня(Параметры.ДатаКон);
	КонецЕсли;

	Если Параметры.Свойство("Ссылка") Тогда
		Отчет.Залогодатели.Загрузить(Параметры.Ссылка.Залогодатели.Выгрузить(, "Залогодатель"));
		
		Для каждого СтрЗ Из Отчет.Залогодатели Цикл
			Отчет.Залогодатель = ?(Отчет.Залогодатель = "", СтрЗ.Залогодатель.Наименование, Отчет.Залогодатель + "; " + СтрЗ.Залогодатель.Наименование);
		КонецЦикла;
		
		Отчет.Приказ = Параметры.Ссылка;
		Отчет.ПриказСтрока = "Приказ №" + Параметры.Ссылка.НомерПриказа + " от " + Параметры.Ссылка.Дата;
	КонецЕсли;

	СформироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Интервал(Команда)
	ДиалогРедактирования = Новый ДиалогРедактированияСтандартногоПериода;
	
	Если ДиалогРедактирования.Редактировать() Тогда
		Отчет.ДатаНач	= ДиалогРедактирования.Период.ДатаНачала;
		Отчет.ДатаКон 	= ДиалогРедактирования.Период.ДатаОкончания;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Результат.Очистить();  
	
