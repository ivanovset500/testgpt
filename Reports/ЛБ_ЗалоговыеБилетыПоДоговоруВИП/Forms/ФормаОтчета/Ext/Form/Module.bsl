	    ПериодОтчета = "на " + Формат(Отчет.ДатаКон, "ДФ=dd.MM.yyyy");
	Иначе
		ПериодОтчета = "за период с " + Формат(Отчет.ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(Отчет.ДатаКон, "ДФ=dd.MM.yyyy");
	КонецЕсли;	

	ОбластьШапка.Параметры.ОсновнойПриказ = "№ " + Отчет.Приказ.НомерПриказа + " от " + Отчет.Приказ.Дата;
