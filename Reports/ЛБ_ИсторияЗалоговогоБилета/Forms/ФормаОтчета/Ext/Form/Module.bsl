				ОбластьСтрокаТовары.Параметры.ОбъектЗалога = СтруктураОписанияОЗ.Описание + ?(НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ), Символы.ПС + "Вставки:" + Символы.ПС + СтруктураОписанияОЗ.ОписаниеВ, "");   
				ОбластьСтрокаТовары.Параметры.Склад = СтрТ.Склад;  
				ОбластьСтрокаТовары.Параметры.Статус = СтрТ.Статус;
				ОбластьСтрокаТовары.Параметры.Оценка = СтрТ.Оценка;
				ОбластьСтрокаТовары.Параметры.Займ = СтрТ.Займ;
				ОбластьСтрокаТовары.Параметры.Оплата = СтрТ.Оплата;
				ОбластьСтрокаТовары.Параметры.Остаток = СтрТ.Остаток;  
				ОбластьСтрокаТовары.Параметры.Комментарий = СтрТ.Комментарий;
				ДокументРезультат.Вывести(ОбластьСтрокаТовары, 2); 
				
				//Если НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ) Тогда
				//	ОбластьСтрокаВставки.Параметры.Вставки = СтруктураОписанияОЗ.ОписаниеВ; 
				//	ДокументРезультат.Вывести(ОбластьСтрокаВставки, 2);
				//КонецЕсли;
			КонецЦикла;	
			ДокументРезультат.Вывести(ОбластьПусто, 2);

			Продолжить;     
		ИначеЕсли ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.ЛБ_КорректировкаНакладной") И 
			      (Стр.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.БлокировкаВключенияЗБВНакладные ИЛИ
				   Стр.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОплатаОтгруженногоЗБ) Тогда  
			Архив = Ложь;	   
			ОбластьСтрокаН.Параметры.Дата = Стр.Период; 
			Если Стр.ОтменаБлокировки Тогда
				ОбластьСтрокаН.Параметры.Вид = "Отмена блокировки включения ЗБ в накладные";
			Иначе	
			    ОбластьСтрокаН.Параметры.Вид = СокрЛП(Стр.ВидОперации); 
				Если Стр.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОплатаОтгруженногоЗБ Тогда  
					Если НЕ Стр.Регистратор.ЗалоговыеБилеты.Количество() = 0 Тогда
						Если НачалоДня(Стр.Регистратор.ЗалоговыеБилеты.Получить(0).ДатаОплаты) < НачалоДня(ТекущаяДатаСеанса()) Тогда 
							ОбластьСтрокаН.Параметры.Вид = ОбластьСтрокаН.Параметры.Вид + " (Архив)";
							Архив = Истина;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			СостояниеЗБ = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Стр.Регистратор, Отчет.ЗалоговыйБилет);
			СтатусЗалоговогоБилета = СостояниеЗБ.СтатусЗалоговогоБилета;  
			
			ОбластьСтрокаН.Параметры.Ломбард = Стр.Ломбард; 
			ОбластьСтрокаН.Параметры.Ответственный = Стр.Регистратор.Ответственный;
			ОбластьСтрокаН.Параметры.Статус = Строка(СтатусЗалоговогоБилета);  
		   	ОбластьСтрокаН.Параметры.Регистратор = Стр.Регистратор;   
			ОбластьСтрокаН.Параметры.ДатаВыкупа = СостояниеЗБ.ДатаВыкупа;
		    ОбластьСтрокаН.Параметры.ДатаВыкупаЛьготная = СостояниеЗБ.ДатаВыкупаЛьготныйСрок; 
			ОбластьСтрокаН.Параметры.НомерНакладной = Стр.НакладнаяНаОтгрузку.ПредставлениеНомераНакладной;  		 
			Если СтрС.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог Или  СтрС.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда  
				ОбластьСтрокаН.Параметры.ОстатокЗайм = СтрС.СуммаСсуды;  
			Иначе        			 
				ОбластьСтрокаН.Параметры.ОстатокПроценты = Формат(ОстатокПроценты, "ЧЦ=15; ЧДЦ=2; ЧН=0,00");
				ОбластьСтрокаН.Параметры.ОстатокЗайм = ОстатокЗайм;
