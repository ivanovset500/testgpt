		ДокументРезультат.Вывести(ОбластьЗБНач);
	КонецЕсли;	
	ДокументРезультат.Вывести(ОбластьЗаголовок);
		
	НачисленоИтог = 0; 
	ОплатаПроцентыИтог = 0;  
	ОплатаЗаймИтог = 0;  
	ОстатокПредыдущий = 0; 
	ОстатокЗайм = 0;
	ОстатокПроценты = 0;
	ТекНомерДС = 0;   
