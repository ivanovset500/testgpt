&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Клиент") Тогда
		Отчет.Клиент = Параметры.Клиент;		
	КонецЕсли;    
	Если Параметры.Свойство("ЗалоговыйБилет") Тогда
		Отчет.ЗалоговыйБилет = Параметры.ЗалоговыйБилет;		
	КонецЕсли; 
	Если Параметры.Свойство("Дата") Тогда
		Отчет.Дата = Параметры.Дата;    
	Иначе
		Отчет.Дата = ТекущаяДата();
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда
		ЗаполнитьСписокЗБ();
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Отчет.ЗалоговыйБилет) Тогда
		Элементы.ГруппаБыстрыеОтборы.Видимость = ложь;  
		Элементы.Отбор.ЦветФона = WebЦвета.Белый;
		СформироватьНаСервере();
	Иначе
		Элементы.Отбор.ЦветФона = WebЦвета.БледноЗеленый;
	КонецЕсли;	     
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	Если НЕ ЗначениеЗаполнено(Отчет.ЗалоговыйБилет) Тогда
		Сообщить("Не выбран залоговый билет!");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьКомментарииПеремещения(Регистратор) 
	Запрос = новый Запрос; 
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеОбъектаЗалога.Комментарий КАК Комментарий,
	               |	ЛБ_СостояниеОбъектаЗалога.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СостояниеОбъектаЗалога.ОбъектЗалога КАК ОбъектЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога КАК ЛБ_СостояниеОбъектаЗалога
	               |ГДЕ
	               |	ЛБ_СостояниеОбъектаЗалога.Регистратор = &Регистратор"; 
	Возврат Запрос.Выполнить().Выгрузить();
Конецфункции

&НаСервере
Процедура СформироватьНаСервере()    
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь; 
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
			СотрудникЦО = Истина;
		КонецЕсли;	  
	КонецЕсли;	

	ДокументРезультат.Очистить(); 
	Дата1 = НачалоДня(Отчет.ЗалоговыйБилет.Дата);
	//Дата2 = ?(Отчет.Дата = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.Дата));
	Дата2 = КонецДня(Дата(2199, 12, 31)); 
	
	Запрос = Новый Запрос;				
	Запрос.УстановитьПараметр("Дата1", Дата1); 
	Запрос.УстановитьПараметр("Дата2", Дата2);  
	Запрос.УстановитьПараметр("Залогодатель", Отчет.Клиент);
	
	//Проверим есть дата смерти клиента 
	ДатаСмерти = Дата(1,1,1);    
	ПериодС = Дата(1,1,1);
	РегистраторС = неопределено; 
	ОтветственныйС = неопределено;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателей.Период КАК Период,
	               |	ЛБ_ДокументыЗалогодателей.Регистратор КАК Регистратор,
	               |	ЛБ_ДокументыЗалогодателей.ДатаСмерти КАК ДатаСмерти,
	               |	ЛБ_ДокументыЗалогодателей.Ответственный КАК Ответственный
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей КАК ЛБ_ДокументыЗалогодателей
	               |ГДЕ
	               |	ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя.Владелец = &Залогодатель
	               |	И ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти)
	               |	И ЛБ_ДокументыЗалогодателей.ДокументНеДействителен = ЛОЖЬ"; 
	Выборка = Запрос.Выполнить().Выбрать();   
	Если Выборка.Следующий() тогда  
		ДатаСмерти = Выборка.ДатаСмерти; 
		СтатусНаследство = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(Выборка.Период, Отчет.ЗалоговыйБилет);  
		ПериодС = Выборка.Период; 
		РегистраторС = Выборка.Регистратор;  
		ОтветственныйС = Выборка.Ответственный;
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("ЗБ", Отчет.ЗалоговыйБилет); 	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период КАК Период,
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор КАК Регистратор,
	               |	ЛБ_ОборотыПоОперациямЗайма.ВидОперации КАК ВидОперации,
	               |	ЛБ_ОборотыПоОперациямЗайма.Ломбард КАК Ломбард,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготная,
	               |	СУММА(ЛБ_ОборотыПоОперациямЗайма.СуммаСсуды) КАК СуммаСсуды,
	               |	СУММА(ЛБ_ОборотыПоОперациямЗайма.СуммаОплатыПроценты) КАК ОплатаПроценты,
	               |	СУММА(ЛБ_ОборотыПоОперациямЗайма.СуммаОплатыЗайм) КАК ОплатаЗайм,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения КАК НомерДопСоглашения,
	               |	ЛБ_ОборотыПоОперациямЗайма.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_ОборотыПоОперациямЗайма.Комментарий КАК Комментарий,
	               |	ЛБ_ОборотыПоОперациямЗайма.ОтменаБлокировки КАК ОтменаБлокировки,
	               |	ЛБ_ОборотыПоОперациямЗайма.РеестрПлатежей КАК РеестрПлатежей
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |		ПО ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет
	               |			И ЛБ_ОборотыПоОперациямЗайма.Регистратор = ЛБ_СостояниеЗалоговогоБилета.Регистратор
	               |ГДЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период >= &Дата1
	               |	И ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = &ЗБ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОборотыПоОперациямЗайма.Период,
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор,
	               |	ЛБ_ОборотыПоОперациямЗайма.ВидОперации,
	               |	ЛБ_ОборотыПоОперациямЗайма.Ломбард,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения,
	               |	ЛБ_ОборотыПоОперациямЗайма.НакладнаяНаОтгрузку,
	               |	ЛБ_ОборотыПоОперациямЗайма.Комментарий,
	               |	ЛБ_ОборотыПоОперациямЗайма.ОтменаБлокировки,
	               |	ЛБ_ОборотыПоОперациямЗайма.РеестрПлатежей
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";    
	ТаблицаЗБ = Запрос.Выполнить().Выгрузить();  
	
	Если ЗначениеЗаполнено(ДатаСмерти) Тогда  
		ДатаНач = ТаблицаЗБ.Получить(0).Период;
		НомерКон = ТаблицаЗБ.Количество()-1;
		ДатаКон = ТаблицаЗБ.Получить(НомерКон).Период;      
		Если ПериодС >= ДатаНач И ПериодС <= ДатаКон Тогда
			НоваяСтр = ТаблицаЗБ.Добавить();   
			НоваяСтр.Период = ПериодС;    
			ТаблицаЗБ.Колонки.Регистратор.Имя = "Регистратор1"; 
			ТаблицаЗБ.Колонки.Добавить("Регистратор"); 
			Для каждого Стр Из ТаблицаЗБ Цикл 
				Стр.Регистратор = Стр.Регистратор1;				
			Конеццикла;
			ТаблицаЗБ.Колонки.Удалить("Регистратор1");
			НоваяСтр.Регистратор = РегистраторС;  
			ТаблицаЗБ.Сортировать("Период");
		КонецЕсли;	
	КонецЕсли;	       
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.Регистратор КАК Регистратор,
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.ВидРасчета КАК ВидРасчета,
	               |	СУММА(ЛБ_РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход) КАК Сумма,
	               |	СУММА(ЛБ_РасчетыСКлиентамиОстаткиИОбороты.СуммаКонечныйОстаток) КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.ОстаткиИОбороты(&Дата1, , Регистратор, , ЗалоговыйБилет = &ЗБ) КАК ЛБ_РасчетыСКлиентамиОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.ВидРасчета,
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.Регистратор"; 
	ТаблицаРасчетов = Запрос.Выполнить().Выгрузить();

	
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЛБ_НачислениеПроцентовДетально.Регистратор КАК Регистратор,
	                |	ЛБ_НачислениеПроцентовДетально.ДеньНач КАК ДеньНач,
	                |	ЛБ_НачислениеПроцентовДетально.ДеньКон КАК ДеньКон,
	                |	ЛБ_НачислениеПроцентовДетально.ДатаНач КАК ДатаНач,
	                |	ЛБ_НачислениеПроцентовДетально.ДатаКон КАК ДатаКон,
	                |	ЛБ_НачислениеПроцентовДетально.ВидПроцентнойСтавки КАК ВидПроцентнойСтавки,
	                |	ЛБ_НачислениеПроцентовДетально.ПроцентнаяСтавкаБазовая КАК ПроцентнаяСтавкаБазовая,
	                |	ЛБ_НачислениеПроцентовДетально.ПроцентнаяСтавкаАкция КАК ПроцентнаяСтавкаАкция,
	                |	ЛБ_НачислениеПроцентовДетально.ОтклонениеАкцияОтностельное КАК ОтклонениеАкцияОтностельное,
	                |	ЛБ_НачислениеПроцентовДетально.ОтклонениеАкцияАбсолютное КАК ОтклонениеАкцияАбсолютное,
	                |	ЛБ_НачислениеПроцентовДетально.СуммаПроцентов КАК СуммаПроцентов,
	                |	ЛБ_НачислениеПроцентовДетально.СуммаПроцентовДень КАК СуммаПроцентовДень
	                |ИЗ
	                |	РегистрНакопления.ЛБ_НачислениеПроцентовДетально КАК ЛБ_НачислениеПроцентовДетально
	                |ГДЕ
	                |	ЛБ_НачислениеПроцентовДетально.ЗалоговыйБилет = &ЗБ";
	ТаблицаРасчетовДетально = Запрос.Выполнить().Выгрузить(); 
	
	ЗапросРасчетыОЗ = Новый Запрос; 
	ЗапросРасчетыОЗ.УстановитьПараметр("ЗБ", Отчет.ЗалоговыйБилет); 
	ЗапросРасчетыОЗ.Текст = "ВЫБРАТЬ
	                        |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.Период КАК Период,
	                        |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.ОбъектЗалога КАК ОбъектЗалога,
	                        |	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.СуммаПриход) КАК Займ,
	                        |	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.СуммаРасход) КАК Оплата,
	                        |	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.СуммаКонечныйОстаток) КАК Остаток
	                        |ИЗ
	                        |	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.ОстаткиИОбороты(, &Дата, Регистратор, , ЗалоговыйБилет = &ЗБ) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты
	                        |
	                        |СГРУППИРОВАТЬ ПО
	                        |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.ОбъектЗалога,
	                        |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОстаткиИОбороты.Период
	                        |
	                        |УПОРЯДОЧИТЬ ПО
	                        |	Период УБЫВ";
		
	ЗапросОЗ = Новый Запрос;   
	ЗапросОЗ.УстановитьПараметр("ЗБ", Отчет.ЗалоговыйБилет);
	ЗапросОЗ.Текст = "ВЫБРАТЬ
	                 |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	                 |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОписаниеИзделия КАК Описание,
	                 |	0 КАК Оценка,
	                 |	0 КАК Займ,
	                 |	0 КАК Оплата,
	                 |	0 КАК Остаток,
	                 |	НЕОПРЕДЕЛЕНО КАК Статус,
	                 |	НЕОПРЕДЕЛЕНО КАК Комментарий,
	                 |	НЕОПРЕДЕЛЕНО КАК Склад
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	                 |			&Дата,
	                 |			ЗалоговыйБилет = &ЗБ
	                 |				И ОбъектЗалога В (&ОбъектыЗалога)) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних";
	
	ЗапросСклад = Новый Запрос;   
	ЗапросСклад.УстановитьПараметр("ЗБ", Отчет.ЗалоговыйБилет);
	ЗапросСклад.Текст = "ВЫБРАТЬ
	                    |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	                    |	ЛБ_ОбъектыЗалогаОстатки.Склад КАК Склад,
	                    |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	                    |ИЗ
	                    |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
	                    |			&Дата,
	                    |			ЗалоговыйБилет = &ЗБ
	                    |				И ОбъектЗалога В (&ОбъектыЗалога)) КАК ЛБ_ОбъектыЗалогаОстатки
	                    |ГДЕ
						//+МАН 12.03.26 Изменил т.к. в список попадали строки дез склада. Заявка 3654.
						//|	НЕ ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток = 0
	                    |	НЕ ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток <= 0
						//-МАН
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	ЛБ_ОбъектыЗалогаОстатки.Склад,
	                    |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога
	                    |
	                    |ОБЪЕДИНИТЬ ВСЕ
	                    |
	                    |ВЫБРАТЬ
	                    |	ЛБ_ОбъектыЗалогаВСумкеОстатки.ОбъектЗалога,
	                    |	ЛБ_ОбъектыЗалогаВСумкеОстатки.СкладПолучатель,
	                    |	СУММА(ЛБ_ОбъектыЗалогаВСумкеОстатки.КоличествоОстаток)
	                    |ИЗ
	                    |	РегистрНакопления.ЛБ_ОбъектыЗалогаВСумке.Остатки(
	                    |			&Дата,
	                    |			ЗалоговыйБилет = &ЗБ
	                    |				И ОбъектЗалога В (&ОбъектыЗалога)) КАК ЛБ_ОбъектыЗалогаВСумкеОстатки
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	ЛБ_ОбъектыЗалогаВСумкеОстатки.СкладПолучатель,
	                    |	ЛБ_ОбъектыЗалогаВСумкеОстатки.ОбъектЗалога";
		
	ДокументРезультат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_История_Залогового_Билета";
	
	Макет 			 = Отчет.РеквизитМакет;
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка"); 
	ОбластьЗаголовок  = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаТовары  = Макет.ПолучитьОбласть("ШапкаТовары");
	ОбластьСтрока  = Макет.ПолучитьОбласть("Строка");  
	ОбластьСтрокаС  = Макет.ПолучитьОбласть("СтрокаС");
	ОбластьСтрокаН  = Макет.ПолучитьОбласть("СтрокаН");  
	ОбластьСтрокаР  = Макет.ПолучитьОбласть("СтрокаР");
	ОбластьСтрокаТовары  = Макет.ПолучитьОбласть("СтрокаТовары"); 
	ОбластьСтрокаВставки  = Макет.ПолучитьОбласть("СтрокаВставки");
	ОбластьПусто  = Макет.ПолучитьОбласть("ПустаяСтрока"); 
	ОбластьЗБНач  = Макет.ПолучитьОбласть("НачальныйЗБ");
		
