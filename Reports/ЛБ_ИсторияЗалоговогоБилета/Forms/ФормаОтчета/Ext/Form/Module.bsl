				Если ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.ЛБ_НакладнаяНаОтгрузку") Тогда
				    Комментарий = ?(Стр.НакладнаяНаОтгрузку.ВидОперации = Перечисления.ЛБ_ВидыНакладнойНаОтгрузку.Автоматически, "", "Включен в накладную сотрудником ЦО");
				КонецЕсли;	
			Иначе 
				ОбластьСтрокаН.Параметры.Вид = СокрЛП(Стр.ВидОперации) + ?(ЭтоПеремещение, "", " (" + СтатусЗБВНакладной+ ")");   
				Если Стр.СтатусЗалоговогоБилета = null Тогда					 
					СтатусЗалоговогоБилета = СостояниеЗБ.СтатусЗалоговогоБилета;
                Иначе
				    СтатусЗалоговогоБилета = Стр.СтатусЗалоговогоБилета; 
				КонецЕсли;	
				ОбластьСтрокаН.Параметры.Комментарий = "";
				Попытка
				    Если Стр.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ИсключениеЗБИзНакладной Тогда
					   Комментарий = "Исключен из накладной сотрудником ЦО";  
					КонецЕсли;   
				Исключение  
