			ОбластьСтрокаН.Параметры.Комментарий = стр.Комментарий;
			
			ДокументРезультат.Вывести(ОбластьСтрокаН, 1);
			Если Архив Тогда
				ДокументРезультат.Области.СтрокаН.ЦветФона = WebЦвета.ТусклоРозовый;
            КонецЕсли;
			
			ЗапросОЗ.УстановитьПараметр("Дата", Стр.Период); 
