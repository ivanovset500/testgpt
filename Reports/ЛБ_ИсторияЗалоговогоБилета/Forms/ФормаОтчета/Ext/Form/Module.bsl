		ДокументРезультат.Вывести(ОбластьШапкаТовары, 2); 
		Для каждого СтрТ Из ТаблицаТовары Цикл
			СтруктураОписанияОЗ = ЛБ_УправлениеЛомбардом.ОписаниеОбъектаЗалогаДляПечати(Отчет.ЗалоговыйБилет, СтрТ.ОбъектЗалога);
			ОбластьСтрокаТовары.Параметры.ОбъектЗалога = СтруктураОписанияОЗ.Описание + ?(НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ), Символы.ПС + "Вставки:" + Символы.ПС + СтруктураОписанияОЗ.ОписаниеВ, ""); 
			НакладнаяНаОтгрузку = ЛБ_УправлениеЛомбардом.ПолучитьНакладнуюНаОтгрузкуЗалогоговогоБилета(стр.Период-1, отчет.ЗалоговыйБилет);
			Если ЗначениеЗаполнено(НакладнаяНаОтгрузку) Тогда
				СтатусВНакладной = ЛБ_УправлениеЛомбардом.ПолучитьСтатусОбъектаЗалогаВНакладнойНаОтгрузку(Стр.Регистратор.Дата, НакладнаяНаОтгрузку, Отчет.ЗалоговыйБилет, СтрТ.ОбъектЗалога);
				ОбластьСтрокаТовары.Параметры.Статус = Строка(СтрТ.Статус) + ?(ЗначениеЗаполнено(СтатусВНакладной), Символы.ПС + "(" + Строка(СтатусВНакладной) + ")", ""); 
			Иначе
			    ОбластьСтрокаТовары.Параметры.Статус = СтрТ.Статус;  
			КонецЕсли;	   
			ОбластьСтрокаТовары.Параметры.Склад = СтрТ.Склад;
			ОбластьСтрокаТовары.Параметры.Оценка = СтрТ.Оценка;
			ОбластьСтрокаТовары.Параметры.Займ = СтрТ.Займ;
			
			//+МАН 02.02.26 Добавил условие. Убрал вывод для реализации. Заявка 3649
			Если ЭтоРеализация И ТекПользователь.ЭтоЛомбард Тогда
				ОбластьСтрокаТовары.Параметры.Оплата = "";
			Иначе
			//-МАН
				ОбластьСтрокаТовары.Параметры.Оплата = СтрТ.Оплата;
			КонецЕсли;
			
			ОбластьСтрокаТовары.Параметры.Остаток = СтрТ.Остаток;
			ОбластьСтрокаТовары.Параметры.Комментарий = СтрТ.Комментарий;
			ДокументРезультат.Вывести(ОбластьСтрокаТовары, 2); 
			
			//Если НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ) Тогда
			//	ОбластьСтрокаВставки.Параметры.Вставки = СтруктураОписанияОЗ.ОписаниеВ; 
			//	ДокументРезультат.Вывести(ОбластьСтрокаВставки, 2);
			//КонецЕсли;

		КонецЦикла;	
		ДокументРезультат.Вывести(ОбластьПусто, 2);  
		СтрС = Стр;
	Конеццикла;	    
	
	ДокументРезультат.ЗакончитьАвтогруппировкуСтрок(); 
	//ОбластьИтог.Параметры.ОплатаПроценты = ОплатаПроцентыИтог;
	//ОбластьИтог.Параметры.ОплатаЗайм = ОплатаЗаймИтог;
	//ОбластьИтог.Параметры.ОплатаВсего = ОплатаПроцентыИтог + ОплатаЗаймИтог; 
	//ДокументРезультат.Вывести(ОбластьИтог);   
	
	ДокументРезультат.ФиксацияСверху = 5;
	ДокументРезультат.ПоказатьУровеньГруппировокСтрок(0);
КонецПроцедуры

&НаКлиенте
Процедура КлиентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь; 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Дата", Отчет.Дата);	
    ПараметрыФормы.Вставить("БезДокументов", истина);
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Отчет.Клиент);
	КонецЕсли;		
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораКлиента",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКлиента(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	Отчет.Клиент = Результат.Залогодатель;  
	
	ЗаполнитьСписокЗБ();
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокЗБ(НомерЗБ = неопределено) 
	СписокВыбораЗБ.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", КонецДня(Отчет.Дата));
	Запрос.УстановитьПараметр("Клиент", Отчет.Клиент);
	СписокВО = Новый списокЗначений;
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление); 
	Запрос.УстановитьПараметр("ВидыОперации", СписокВО); 
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
	              |	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета
	              |ИЗ
	              |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(
	              |			,
				  |			&Дата,
	              |			Регистратор,
	              |			Залогодатель = &Клиент
	              |				И ВидОперации В (&ВидыОперации)) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	НомерЗалоговогоБилета";
	Выборка = Запрос.Выполнить().Выбрать();  
	Пока Выборка.Следующий() Цикл 
		Если НЕ НомерЗБ = неопределено Тогда
			Если Найти(Выборка.НомерЗалоговогоБилета, СокрЛП(НомерЗБ)) = 0 Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		СписокВыбораЗБ.Добавить(Выборка.ЗалоговыйБилет, Выборка.НомерЗалоговогоБилета + "            ");
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Функция ПолучитьНомерЗБ()
	Возврат Отчет.ЗалоговыйБилет.НомерЗалоговогоБилета;
КонецФункции

&НаКлиенте
Процедура Отбор(Команда)
	Если Элементы.ГруппаБыстрыеОтборы.Видимость Тогда 
		Элементы.ГруппаБыстрыеОтборы.Видимость = Ложь;
		Элементы.Отбор.ЦветФона = WebЦвета.Белый;
	Иначе 
		Элементы.ГруппаБыстрыеОтборы.Видимость = Истина;
		Элементы.Отбор.ЦветФона = WebЦвета.БледноЗеленый;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗалоговыйБилетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;  
	НомерЗБ = Элемент.ТекстРедактирования;
	ЗаполнитьСписокЗБ(?(ПустаяСтрока(НомерЗБ), неопределено, НомерЗБ));
	ВыбранноеЗначение = ВыбратьИзСписка(СписокВыбораЗБ, Элементы.ЗалоговыйБилет); 

	Если ВыбранноеЗначение <> Неопределено Тогда 
	    Отчет.ЗалоговыйБилет = ВыбранноеЗначение.Значение;
	    НомерЗБ  = СокрЛП(ВыбранноеЗначение.Представление);
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ПолучитьВидОперации(Документ)
	Если Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог Тогда 
		Возврат 1;
	ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда 
		Возврат 2;
	КонецЕсли;
	Возврат 0;
КонецФункции      

&НаСервере
Функция ПолучитьНачальногоЗаемщика(Документ)
	Возврат Документ.Залогодатель;
КонецФункции	

&НаСервере
Функция ПолучитьИмяФормыКорректировки(Ссылка)  
	Возврат ЛБ_ОбщийМодуль.ПолучитьИмяФормыКорректировкиНакладных(Ссылка);
КонецФункции	

&НаКлиенте
Процедура ДокументРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
	    СтандартнаяОбработка = ложь;  
		ПараметрыФормы = Новый структура;        
		Если Расшифровка.вид = 1 Тогда
			ПараметрыФормы.Вставить("Документ", Расшифровка.Документ);
			Если Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") Тогда
				ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗайма", ПараметрыФормы, ЭтаФорма); 
			ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма);	
			ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаОплатыПроцентов", ПараметрыФормы, ЭтаФорма);
			ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗалога", ПараметрыФормы, ЭтаФорма);
		    ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ИзъятиеОбъектовЗалога", ПараметрыФормы, ЭтаФорма);
	        ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ВозвратОбъектовЗалога", ПараметрыФормы, ЭтаФорма);
	        ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма);   
			ИначеЕсли Расшифровка.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма);	
			КонецЕсли;  
		ИначеЕсли Расшифровка.вид = 2 Тогда    
			Если НЕ Расшифровка.НомерДС = 0 Тогда
				ПараметрыФормы.Вставить("ИменаМакетов", "ДополнительноеСоглашение"); 
				ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ОперацияПоЗалогу");
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(Расшифровка.Документ);
				ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
				ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
            КонецЕсли;
		КонецЕсли;	    
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") Тогда	
		СтандартнаяОбработка = ложь; 
		//Если ПолучитьВидОперации(Расшифровка) = 1 Тогда
		//	ПараметрыФормы = Новый Структура;
		//	ПараметрыФормы.Вставить("Документ", Расшифровка);
		//	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗайма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		//ИначеЕсли ПолучитьВидОперации(Расшифровка) = 2 Тогда  
		//	СтандартнаяОбработка = ложь; 
		//	ПараметрыФормы = Новый Структура;
		//	ПараметрыФормы.Вставить("Документ", Расшифровка);
		//	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		//КонецЕсли;	 
		Если НЕ ПолучитьВидОперации(Расшифровка) = 0 Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Клиент", ПолучитьНачальногоЗаемщика(Расшифровка));
			ПараметрыФормы.Вставить("ЗалоговыйБилет", Расшифровка);	 
		    ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
        КонецЕсли;
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_КарточкаЗалогодателя") Тогда	
		СтандартнаяОбработка = ложь; 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Отчет.Клиент);
		ПараметрыФормы.Вставить("Дата", ТекущаяДата());	
		ПараметрыФормы.Вставить("ТолькоПросмотр", истина);
		ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_НакладнаяНаОтгрузку") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Ключ", Расшифровка);
		ОткрытьФорму("Документ.ЛБ_НакладнаяНаОтгрузку.ФормаОбъекта", ПараметрыФормы);
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_КорректировкаНакладной") Тогда 
		СтандартнаяОбработка = ложь; 
		ИмяФормыК = ПолучитьИмяФормыКорректировки(Расшифровка); 
		Если ИмяФормыК = неопределено Тогда     
			ПараметрыФормы = Новый Структура("Ключ", Расшифровка);
            ОткрытьФорму("Документ.ЛБ_КорректировкаНакладной.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		Иначе
			ПараметрыФормыДоп = Новый Структура; 
			ПараметрыФормыДоп.Вставить("Документ", Расшифровка);  
			ОткрытьФорму("ОбщаяФорма." + ИмяФормыК, ПараметрыФормыДоп, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	   
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_ПеремещениеОбъектовЗалога") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Ключ", Расшифровка);
		ОткрытьФорму("Документ.ЛБ_ПеремещениеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы);	
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_ОприходованиеОбъектовЗалога") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Ключ", Расшифровка);
		ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы);
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("ДокументСсылка.ЛБ_Реализация") Тогда 
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", Расшифровка); 
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
		ОткрытьФорму("Документ.ЛБ_Реализация.ФормаОбъекта", ПараметрыФормы);	
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ЗалоговыйБилетПриИзменении(Элемент)
	НомерЗБ = Элемент.ТекстРедактирования;
	ЗаполнитьСписокЗБ(?(ПустаяСтрока(НомерЗБ), неопределено, НомерЗБ));
	ВыбранноеЗначение = ВыбратьИзСписка(СписокВыбораЗБ, Элементы.ЗалоговыйБилет); 

	Если ВыбранноеЗначение <> Неопределено Тогда 
	    Отчет.ЗалоговыйБилет = ВыбранноеЗначение.Значение;
	    НомерЗБ  = СокрЛП(ВыбранноеЗначение.Представление);
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументОтмены(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|ГДЕ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент В(&ЗБ)";
	
	Запрос.УстановитьПараметр("ЗБ", Ссылка);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Регистратор;
	КонецЕсли;
	
	Возврат Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка();
	
КонецФункции



