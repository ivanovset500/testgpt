			Для каждого СтрДок Из Отчет.ЗалоговыйБилет.Товары Цикл	   
				МассивОЗ.Добавить(СтрДок.ОбъектЗалога);
			КонецЦикла;	
			ЗапросОЗ.УстановитьПараметр("ОбъектыЗалога", МассивОЗ);
			ТаблицаТовары = ЗапросОЗ.Выполнить().Выгрузить();  
			
			ЗапросСклад.УстановитьПараметр("Дата", Стр.Период+1); 
			ЗапросСклад.УстановитьПараметр("ОбъектыЗалога", МассивОЗ);
			ТаблицаТоваровНаСкладах = ЗапросСклад.Выполнить().Выгрузить();
			
			ОтборТ = новый структура;
			Для каждого СтрТ Из ТаблицаТовары Цикл 
				СтруктураСостояниеОЗ = ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектовЗалогаЗалоговогоБилета(Стр.Период+1, Отчет.ЗалоговыйБилет, СтрТ.ОбъектЗалога);
				Если НЕ СтруктураСостояниеОЗ = неопределено Тогда
					СтрТ.Статус = СтруктураСостояниеОЗ.СтатусОбъектаЗалога;  
					СтрТ.Оценка = СтруктураСостояниеОЗ.СуммаОценки; 
					Если НЕ СтруктураСостояниеОЗ.СуммаДолгаЗайма = 0 Тогда
						СтрТ.Займ = СтруктураСостояниеОЗ.СуммаЗайма; 					
						СтрТ.Оплата = СтруктураСостояниеОЗ.СуммаОплаты; 
					Иначе
						СтрТ.Займ = 0; 					
						СтрТ.Оплата = 0; 
					КонецЕсли;	
					СтрТ.Остаток = СтруктураСостояниеОЗ.СуммаДолгаЗайма;   	   
					СтрТ.Комментарий = СтруктураСостояниеОЗ.Комментарий;
					ОтборСклад = Новый Структура;
					ОтборСклад.Вставить("ОбъектЗалога", СтрТ.ОбъектЗалога);
					СтрокиСклад = ТаблицаТоваровНаСкладах.НайтиСтроки(ОтборСклад);
					Если СтрокиСклад.Количество() = 0 тогда 
						СтрТ.Склад = "";
					Иначе              
						Склад = СтрокиСклад.Получить(0).Склад;
						СтрТ.Склад = СокрЛП(Склад.Владелец) + Символы.ПС + СокрЛП(Склад);
					КонецЕсли;	
				КонецЕсли;		
			Конеццикла;
			
			ДокументРезультат.Вывести(ОбластьШапкаТовары, 2); 
			Для каждого СтрТ Из ТаблицаТовары Цикл
				СтруктураОписанияОЗ = ЛБ_УправлениеЛомбардом.ОписаниеОбъектаЗалогаДляПечати(Отчет.ЗалоговыйБилет, СтрТ.ОбъектЗалога);
				ОбластьСтрокаТовары.Параметры.ОбъектЗалога = СтруктураОписанияОЗ.Описание + ?(НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ), Символы.ПС + "Вставки:" + Символы.ПС + СтруктураОписанияОЗ.ОписаниеВ, "");   
				ОбластьСтрокаТовары.Параметры.Статус = Строка(СтрТ.Статус);  
				ОбластьСтрокаТовары.Параметры.Склад = СтрТ.Склад; 
				ОбластьСтрокаТовары.Параметры.Оценка = СтрТ.Оценка;
				ОбластьСтрокаТовары.Параметры.Займ = СтрТ.Займ;
				ОбластьСтрокаТовары.Параметры.Оплата = СтрТ.Оплата;
				ОбластьСтрокаТовары.Параметры.Остаток = СтрТ.Остаток; 
				ОбластьСтрокаТовары.Параметры.Комментарий = "";
				ДокументРезультат.Вывести(ОбластьСтрокаТовары, 2); 
				
				//Если НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ) Тогда
				//	ОбластьСтрокаВставки.Параметры.Вставки = СтруктураОписанияОЗ.ОписаниеВ; 
				//	ДокументРезультат.Вывести(ОбластьСтрокаВставки, 2);
				//КонецЕсли;

			КонецЦикла;	
			ДокументРезультат.Вывести(ОбластьПусто, 2); 

			Продолжить;		
		ИначеЕсли НЕ (ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу")) И ЗначениеЗаполнено(Стр.НакладнаяНаОтгрузку) Тогда 
			ОбластьСтрокаН.Параметры.Дата = Стр.Период;  
			Комментарий = "";
			СтатусЗБВНакладной = ЛБ_УправлениеЛомбардом.ПолучитьСтатусНакладнойНаОтгрузку(Стр.Регистратор.Дата, Стр.НакладнаяНаОтгрузку);
			СостояниеЗБ = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Стр.Регистратор, Отчет.ЗалоговыйБилет);
			Если НЕ ЗначениеЗаполнено(Стр.ВидОперации) Тогда
			    ОбластьСтрокаН.Параметры.Вид = "Накладная на отгрузку (" + Строка(СтатусЗБВНакладной) + ")";  
