
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ВидПеречня") Тогда
		Отчет.ВидПеречня = Параметры.ВидПеречня;
	КонецЕсли;     
	
	Если НЕ ЗначениеЗаполнено(Отчет.ВидПеречня) тогда  
		Сообщить("Отчет используется только в обработке заполнения перечней!");
		Возврат;
	КонецЕсли;	
	
	Если Параметры.Свойство("ДатаСверки") Тогда
		Отчет.ДатаСверки = Параметры.ДатаСверки;
	КонецЕсли;  
	
	Если Параметры.Свойство("ДатаПеречня") Тогда
		Отчет.ДатаПеречня = Параметры.ДатаПеречня;
	КонецЕсли;  
	
	Если Параметры.Свойство("МассивКлиентов") Тогда 
		Если НЕ Параметры.МассивКлиентов.Количество() = 0 Тогда
			ТЗ = ЛБ_УправлениеЛомбардом.ПреобразованиеМассивВТаблицуЗначений(Параметры.МассивКлиентов);
			Отчет.ТаблицаКлиентов.Загрузить(ТЗ); 
		КонецЕсли;	
	КонецЕсли;  	

	СформироватьНаСервере();
КонецПроцедуры  

&НаСервере
Процедура СформироватьНаСервере()
	
	ДокументРезультат.Очистить();
	
	ДокументРезультат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СверкаПеречня";

	Макет 			 = Отчет.РеквизитМакет;
	
	ОбластьШапки 	 = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 	 = Макет.ПолучитьОбласть("Строка"); 
	ОбластьПодвал 	 = Макет.ПолучитьОбласть("Подвал");  
	
	Если Отчет.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
		//ИнформацияПеречень = "сверки Перечня организаций и физических лиц, в отношении которых имеются сведения об их причастности к распространению оружия массового уничтожения 04 июля 2022 г. с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		ИнформацияПеречень = "сверки Перечня организаций и физических лиц, в отношении которых имеются сведения об их причастности к распространению оружия массового уничтожения от " + Формат(Отчет.ДатаПеречня, "ДЛФ=DD") + " с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		Перечень = "со статусом «Перечень ФРОМУ»";
	ИначеЕсли Отчет.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда  
		//ИнформацияПеречень = "сверки Перечня организаций и физических лиц, в отношении которых имеются сведения об их участии в террористической, в т.ч. экстремистской деятельности от 29 августа 2022 г. с клиентской базой ООО «Ломбард «Драгоценности Урала»"; 
		ИнформацияПеречень = "сверки Перечня организаций и физических лиц, в отношении которых имеются сведения об их участии в террористической, в т.ч. экстремистской деятельности от " + Формат(Отчет.ДатаПеречня, "ДЛФ=DD") + " с клиентской базой ООО «Ломбард «Драгоценности Урала»"; 
		Перечень = "со статусом «Черный»"; 
	ИначеЕсли Отчет.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда 
		//ИнформацияПеречень = "сверки Списка лиц, в отношении которых приняты Решения Межведомственной комиссии по противодействию финансирования терроризма от 26 августа 2022 г. с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		ИнформацияПеречень = "сверки Списка лиц, в отношении которых приняты Решения Межведомственной комиссии по противодействию финансирования терроризма от " + Формат(Отчет.ДатаПеречня, "ДЛФ=DD") + " с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		Перечень = "со статусом «Замороженный»";  
	ИначеЕсли Отчет.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ЦБ Тогда 
		//ИнформацияПеречень = "сверки Списка по 764-П от 17 августа 2022 г. с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		ИнформацияПеречень = "сверки Списка по 764-П от " + Формат(Отчет.ДатаПеречня, "ДЛФ=DD") + " с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		Перечень = "со списком по 764-П (отказники)";  
	ИначеЕсли Отчет.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда 
		ИнформацияПеречень = "сверки Перечня ООН от " + Формат(Отчет.ДатаПеречня, "ДЛФ=DD") + " с клиентской базой ООО «Ломбард «Драгоценности Урала»";
		Перечень = "со статусом «В перечене ООН»";  	
	Иначе
		ИнформацияПеречень = "";
		Перечень = "";
	КонецЕсли;	
		
	ОбластьШапки.Параметры.ИнформацияПеречень = ИнформацияПеречень;
	ОбластьШапки.Параметры.Перечень = Перечень;  
	ОбластьШапки.Параметры.ДатаСверки = Отчет.ДатаСверки; 
	ОбластьШапки.Параметры.Кол = Отчет.ТаблицаКлиентов.Количество(); 
	ДокументРезультат.Вывести(ОбластьШапки);  
	
	Если Отчет.ТаблицаКлиентов.Количество() = 0 Тогда  
		ОбластьСтрока.Параметры.Ном = 1;
		ДокументРезультат.Вывести(ОбластьСтрока);
		ОбластьПодвал.Параметры.ИнформацияСверки = "Совпадений не выявлено.";
	Иначе   
		Запрос = Новый Запрос; 
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК Адрес,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия_А КАК Фамилия_А,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя_А КАК Имя_А,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество_А КАК Отчество_А
		               |ИЗ
		               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
		               |ГДЕ
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = &Клиент";

		ЗапросДок = Новый Запрос;  
		ЗапросДок.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
		ЗапросДок.Текст = "ВЫБРАТЬ
		                  |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
		                  |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
		                  |	ЛБ_ДокументыЗалогодателя.Наименование КАК Наименование
		                  |ИЗ
		                  |	Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
		                  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		                  |		ПО (ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка)
		                  |ГДЕ
		                  |	ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
		                  |	И ЛБ_ДокументыЗалогодателя.Владелец = &Клиент";
						
		//перечни
		ЗапросК1 = Новый Запрос; 
		ЗапросК1.УстановитьПараметр("ВидПеречня", Отчет.ВидПеречня);
		ЗапросК1.УстановитьПараметр("Дата", Отчет.ДатаСверки);  
		ЗапросК1.УстановитьПараметр("ДатаПеречня", Отчет.ДатаПеречня);
		ЗапросК1.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен);
		ЗапросК1.Текст = "ВЫБРАТЬ
		                 |	ЛБ_ПереченьНежелательныхЛицСрезПоследних.Наименование КАК Наименование,
		                 |	ЛБ_ПереченьНежелательныхЛицСрезПоследних.ДатаРождения КАК ДатаРождения,
		                 |	ЛБ_ПереченьНежелательныхЛицСрезПоследних.МестоРождения КАК МестоРождения,
		                 |	ЛБ_ПереченьНежелательныхЛицСрезПоследних.НаименованиеЛат КАК НаименованиеЛат
		                 |ИЗ
		                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц.СрезПоследних(
		                 |			&Дата,
		                 |			ВидПеречня = &ВидПеречня
		                 |				И ДатаПеречня = &ДатаПеречня
		                 |				И ИД = &ИД
		                 |				И Статус = &Статус) КАК ЛБ_ПереченьНежелательныхЛицСрезПоследних"; 
		//другие наименования
		ЗапросК2 = Новый Запрос; 
		ЗапросК2.УстановитьПараметр("ВидПеречня", Отчет.ВидПеречня);
		ЗапросК2.УстановитьПараметр("ДатаПеречня", Отчет.ДатаПеречня);
		ЗапросК2.УстановитьПараметр("Дата", Отчет.ДатаСверки);
		ЗапросК2.Текст = "ВЫБРАТЬ
		                 |	ЛБ_ПереченьНежелательныхЛицДрНаименованияСрезПоследних.Наименование КАК Наименование
		                 |ИЗ
		                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДрНаименования.СрезПоследних(
		                 |			&Дата,
		                 |			ВидПеречня = &ВидПеречня
		                 |				И ДатаПеречня = &ДатаПеречня
		                 |				И ИД = &ИД) КАК ЛБ_ПереченьНежелательныхЛицДрНаименованияСрезПоследних";  
		//документы
		ЗапросК3 = Новый Запрос;  
		ЗапросК3.УстановитьПараметр("ВидПеречня", Отчет.ВидПеречня);
		ЗапросК3.УстановитьПараметр("ДатаПеречня", Отчет.ДатаПеречня);
		ЗапросК3.УстановитьПараметр("Дата", Отчет.ДатаСверки);
		ЗапросК3.Текст = "ВЫБРАТЬ
		                 |	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументНаименование КАК Наименование,
		                 |	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументНомер КАК ДокументНомер,
		                 |	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументСерия КАК ДокументСерия,
		                 |	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
		                 |	ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи
		                 |ИЗ
		                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДокументы.СрезПоследних(
		                 |			&Дата,
		                 |			ВидПеречня = &ВидПеречня
						 |				И ДатаПеречня = &ДатаПеречня
		                 |				И ИД = &ИД) КАК ЛБ_ПереченьНежелательныхЛицДокументыСрезПоследних"; 
		//адреса
        ЗапросК4 = Новый Запрос; 
		ЗапросК4.УстановитьПараметр("ВидПеречня", Отчет.ВидПеречня); 
		ЗапросК4.УстановитьПараметр("ДатаПеречня", Отчет.ДатаПеречня);
		ЗапросК4.УстановитьПараметр("Дата", Отчет.ДатаСверки);
		ЗапросК4.Текст = "ВЫБРАТЬ
		                 |	ЛБ_ПереченьНежелательныхЛицАдресаСрезПоследних.Адрес КАК Адрес
		                 |ИЗ
		                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицАдреса.СрезПоследних(
		                 |			&Дата,
		                 |			ВидПеречня = &ВидПеречня
		                 |				И ДатаПеречня = &ДатаПеречня
		                 |				И ИД = &ИД) КАК ЛБ_ПереченьНежелательныхЛицАдресаСрезПоследних";


		Для каждого СтрК Из Отчет.ТаблицаКлиентов Цикл
			ОбластьСтрока.Параметры.Ном = СтрК.НомерСтроки;
					
			//заполним таблицу сверки
			Отчет.ТаблицаСверки.Очистить();  
			Запрос.УстановитьПараметр("Клиент", СтрК.Клиент);
			Выборка = Запрос.Выполнить().Выбрать(); 
			Пока Выборка.Следующий() Цикл    
				Наименование = СокрЛП(Выборка.Фамилия + " " + Выборка.Имя + " " + Выборка.Отчество);
				НаименованиеЛат = СокрЛП(Выборка.Фамилия_А + " " + Выборка.Имя_А + " " + Выборка.Отчество_А);
			    НоваяСтр = Отчет.ТаблицаСверки.Добавить();
				НоваяСтр.Клиент = СтрК.Клиент; 
				НоваяСтр.ФИОЛомбарды = Наименование; 
				НоваяСтр.ДРЛомбарды = Выборка.ДатаРождения;  
				НоваяСтр.МРЛомбарды = Выборка.МестоРождения;
				НоваяСтр.АдресЛомбарды = Выборка.Адрес; 
				
				ЗапросДок.УстановитьПараметр("Клиент", СтрК.Клиент); 
				ТаблицаДокЛомбарды = ЗапросДок.Выполнить().Выгрузить(); 				
				
				ЗапросК1.УстановитьПараметр("ИД", СтрК.Ид);   
				Выборка1 = ЗапросК1.Выполнить().Выбрать();
				Если Выборка1.Следующий() Тогда 
					Если Врег(СокрЛП(Наименование)) = Врег(СокрЛП(Выборка1.Наименование)) Тогда
						НоваяСтр.ФИОПеречень = Выборка1.Наименование; 
					ИначеЕсли Врег(СокрЛП(НаименованиеЛат)) = Врег(СокрЛП(Выборка1.НаименованиеЛат)) Тогда  
						НоваяСтр.ФИОЛомбарды = НаименованиеЛат;
						НоваяСтр.ФИОПеречень = Выборка1.НаименованиеЛат; 	
					Иначе 
						ЗапросК2.УстановитьПараметр("ИД", СтрК.Ид);   
						Выборка2 = ЗапросК2.Выполнить().Выбрать(); 
						ЕстьРезультат= ложь;
						Пока Выборка2.Следующий() Цикл 
							Если Врег(СокрЛП(Наименование)) = Врег(СокрЛП(Выборка2.Наименование)) Тогда
						        НоваяСтр.ФИОПеречень = Выборка2.Наименование;  
								ЕстьРезультат= истина;
								Прервать; 
							ИначеЕсли Врег(СокрЛП(НаименованиеЛат)) = Врег(СокрЛП(Выборка2.Наименование)) Тогда
						        НоваяСтр.ФИОПеречень = Выборка2.Наименование;
								НоваяСтр.ФИОЛомбарды = НаименованиеЛат; 
								ЕстьРезультат= истина;
								Прервать; 	
                            КонецЕсли;
						КонецЦикла;  
						Если НЕ ЕстьРезультат Тогда 
							НоваяСтр.ФИОПеречень = Выборка1.Наименование;
						КонецЕсли;	
					КонецЕсли;
					НоваяСтр.ДРПеречень = Выборка1.ДатаРождения;  
				    НоваяСтр.МРПеречень = Выборка1.МестоРождения;
				КонецЕсли;	 
				НоваяСтр.РезультатФИО = ?(ВРег(СокрЛП(НоваяСтр.ФИОЛомбарды)) = ВРег(СокрЛП(НоваяСтр.ФИОПеречень)), "Полное совпадение", "Не совпадает");  
				НоваяСтр.РезультатДР = ?(НоваяСтр.ДРЛомбарды = НоваяСтр.ДРПеречень, "Полное совпадение", "Не совпадает");  
				НоваяСтр.РезультатМР = ?(ВРег(СокрЛП(НоваяСтр.МРЛомбарды)) = ВРег(СокрЛП(НоваяСтр.МРПеречень)), "Полное совпадение", "Не совпадает"); 
				
				ЗапросК3.УстановитьПараметр("ИД", СтрК.Ид); 
				ТаблицаДокПеречень = ЗапросК3.Выполнить().Выгрузить(); 
				
				ЗапросК4.УстановитьПараметр("ИД", СтрК.Ид); 
				Выборка4 = ЗапросК4.Выполнить().Выбрать(); 
				АдресаПеречень = "";
				Пока Выборка4.Следующий() Цикл  
					АдресаПеречень = ?(ПустаяСтрока(АдресаПеречень), "", Символы.ПС) + СокрЛП(Выборка4.Адрес);
				Конеццикла;
				НоваяСтр.АдресПеречень = АдресаПеречень;  
				НоваяСтр.РезультатАдрес = ?(ВРег(СокрЛП(НоваяСтр.АдресЛомбарды)) = ВРег(СокрЛП(НоваяСтр.АдресПеречень)), "Полное совпадение", "Не совпадает");
				
				ЕстьРезультат = ложь;
				Для каждого СтрДок Из ТаблицаДокЛомбарды Цикл
					ОтборДок = Новый Структура;
					ОтборДок.Вставить("ДокументСерия", СокрЛП(СтрДок.ДокументСерия)); 
					ОтборДок.Вставить("ДокументНомер", СокрЛП(СтрДок.ДокументНомер));  
					 
					СтрокиДок = ТаблицаДокПеречень.НайтиСтроки(ОтборДок);
					Если НЕ СтрокиДок.Количество() = 0 Тогда 
						НоваяСтр.ПаспортЛомбарды = СтрДок.Наименование; 
						СтрД = СтрокиДок.Получить(0);
