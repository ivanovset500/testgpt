		Запрос.Текст = СтрЗаменить(Запрос.Текст, "222 = 222", "ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "333 = 333", "ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период <= &Дата");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "444 = 444", "ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия <= &Дата");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "555 = 555", "ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период <= &Дата");
