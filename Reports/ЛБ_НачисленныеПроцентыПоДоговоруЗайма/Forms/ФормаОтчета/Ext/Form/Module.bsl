&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Клиент") Тогда
		Отчет.Клиент = Параметры.Клиент;		
	КонецЕсли;    
	Если Параметры.Свойство("ЗалоговыйБилет") Тогда
		Отчет.ЗалоговыйБилет = Параметры.ЗалоговыйБилет;		
	КонецЕсли;      
	Если Параметры.Свойство("Детально") Тогда
		Отчет.Детально = Параметры.Детально;		
		//+МАН 19.02.26 Заявка 3649
		Если Параметры.Детально Тогда
			ЭтаФорма.Заголовок = "Начисленные проценты по договору займа";
		Иначе
			ЭтаФорма.Заголовок = "Отчет о начисленных и оплаченных процентах по договору займа";
		КонецЕсли;
		//-МАН
	КонецЕсли;   
	Если Параметры.Свойство("Дата") Тогда  
		Если Отчет.Детально Тогда
			Отчет.Дата = Параметры.Дата;
		Иначе	
		    Отчет.Дата = ?(Параметры.Дата < ТекущаяДата(), ТекущаяДата(), Параметры.Дата);
		КонецЕсли;	
	Иначе
		Отчет.Дата = ТекущаяДата();
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда
		ЗаполнитьСписокЗБ(); 
		Если ЗначениеЗаполнено(Отчет.ЗалоговыйБилет) тогда 
			ВыбранноеЗначение = СписокВыбораЗБ.НайтиПоЗначению(Отчет.ЗалоговыйБилет); 
			Если ВыбранноеЗначение <> Неопределено Тогда 
			     НомерЗБ  = СокрЛП(ВыбранноеЗначение.Представление);
			КонецЕсли; 

		КонецЕсли;	
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Отчет.ЗалоговыйБилет) Тогда
		//+МАН 19.02.26 Изменил. Заявка 3649
		//Элементы.ГруппаБыстрыеОтборы.Видимость = ложь;  
		//Элементы.Отбор.ЦветФона = WebЦвета.Белый;  
		//-МАН
		ПроверитьПредварительныйРасчет();
		Если Отчет.Детально Тогда
			//+МАН 19.02.26 Изменил. Заявка 3649
			Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
				Элементы.Клиент.Доступность = Ложь;
			Иначе
				Элементы.Клиент.Доступность = Истина;
			КонецЕсли;
			Элементы.ГруппаБыстрыеОтборы.Видимость = Истина;
			Элементы.Отбор.ЦветФона = WebЦвета.БледноЗеленый;
			//-МАН
		    СформироватьНаСервереДетально();
		Иначе	
			//+МАН 19.02.26 Изменил. Заявка 3649
			Элементы.ГруппаБыстрыеОтборы.Видимость = Ложь;
			Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
				Элементы.Отбор.Видимость = Ложь;
				Элементы.Сформировать.Доступность = Ложь;
			Иначе
				Элементы.Отбор.Видимость = Истина;
				Элементы.Сформировать.Доступность = Истина;
			КонецЕсли;
			Элементы.Отбор.ЦветФона = WebЦвета.Белый;
			//-МАН
		    СформироватьНаСервере();                 
		КонецЕсли;
	Иначе
		Элементы.Отбор.ЦветФона = WebЦвета.БледноЗеленый;
	КонецЕсли;	
	
	//+МАН 19.02.26 заявка 3649
	Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		Элементы.Детально.Доступность = Ложь;
	Иначе
		Элементы.Детально.Доступность = Истина;
	КонецЕсли;
	//-МАН
КонецПроцедуры

&НаСервере
Процедура ПроверитьПредварительныйРасчет()
    ЗапросИзъятие = Новый Запрос;
	ЗапросИзъятие.УстановитьПараметр("Дата", ?(Отчет.Дата = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.Дата)));      
	ЗапросИзъятие.УстановитьПараметр("ЗБ", Отчет.ЗалоговыйБилет);
	ЗапросИзъятие.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет КАК ЗалоговыйБилет
	                      |ИЗ
	                      |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	                      |ГДЕ
	                      |	(ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Изъят)
						  //+МАН 28.04.25 Из-за того что условие было объеденено, то запрос выдавал документы не по указанному ЗБ. Итоговый результат всегда был Ложь. Заявка 2641
	                      //Было: |			ИЛИ ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Остановлен)
	                      |			ИЛИ ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Остановлен))
						  //-МАН
	                      |				И ЛБ_СостояниеЗалоговогоБилета.Период <= &Дата
						  //+МАН 28.04.25 Из-за того что условие объеденено, то запрос выдавал документы не по указанному ЗБ. Итоговый результат всегда был Ложь. Заявка 2641
	                      //Было: |				И ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗБ)"; 
	                      |				И ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗБ"; 
						  //-МАН
	ВыборкаИзътие = ЗапросИзъятие.Выполнить().Выбрать();
	Если ВыборкаИзътие.Следующий() Тогда 
		ПредварительныйРасчет = ложь;
	Иначе
		ПредварительныйРасчет = Истина;
	КонецЕсли; 
КонецПроцедуры	

&НаКлиенте
Процедура Сформировать(Команда)
	Если НЕ ЗначениеЗаполнено(Отчет.ЗалоговыйБилет) Тогда
		Сообщить("Не выбран залоговый билет!");
		Возврат;
	КонецЕсли;
	
	Если Отчет.Детально Тогда
		СформироватьНаСервереДетально();
	Иначе	
	   СформироватьНаСервере();
	КонецЕсли;   
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()	
	ДокументРезультат.Очистить(); 
	Дата1 = НачалоДня(Отчет.ЗалоговыйБилет.Дата);
	Дата2 = ?(Отчет.Дата = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.Дата)); 
	
	Запрос = Новый Запрос;	
			
	Запрос.УстановитьПараметр("Дата1", Дата1); 
	Запрос.УстановитьПараметр("Дата2", Дата2);
	Запрос.УстановитьПараметр("ЗБ", Отчет.ЗалоговыйБилет); 	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Период КАК Период,
	               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор,
	               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.ВидОперации КАК ВидОперации,
	               |	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаСсудыОборот) КАК СуммаСсуды,
	               |	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыПроцентыОборот) КАК СуммаОплаты,
	               |	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаОплатыЗаймОборот) КАК СуммаОплатыЗайм
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(&Дата1, &Дата2, Регистратор, ЗалоговыйБилет = &ЗБ) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Период,
	               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор,
	               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.ВидОперации
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";   
	ТаблицаЗБ = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.Регистратор КАК Регистратор,
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.ВидРасчета КАК ВидРасчета,
	               |	СУММА(ЛБ_РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход) КАК Сумма,
	               |	СУММА(ЛБ_РасчетыСКлиентамиОстаткиИОбороты.СуммаКонечныйОстаток) КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.ОстаткиИОбороты(&Дата1, &Дата2, Регистратор, , ЗалоговыйБилет = &ЗБ) КАК ЛБ_РасчетыСКлиентамиОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.ВидРасчета,
	               |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.Регистратор"; 
	ТаблицаРасчетов = Запрос.Выполнить().Выгрузить();

	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЛБ_НачислениеПроцентовДетально.Регистратор КАК Регистратор,
	                |	ЛБ_НачислениеПроцентовДетально.ДеньНач КАК ДеньНач,
	                |	ЛБ_НачислениеПроцентовДетально.ДеньКон КАК ДеньКон,
	                |	ЛБ_НачислениеПроцентовДетально.ДатаНач КАК ДатаНач,
	                |	ЛБ_НачислениеПроцентовДетально.ДатаКон КАК ДатаКон,
	                |	ЛБ_НачислениеПроцентовДетально.ВидПроцентнойСтавки КАК ВидПроцентнойСтавки,
	                |	ЛБ_НачислениеПроцентовДетально.ПроцентнаяСтавкаБазовая КАК ПроцентнаяСтавкаБазовая,
	                |	ЛБ_НачислениеПроцентовДетально.ПроцентнаяСтавкаАкция КАК ПроцентнаяСтавкаАкция,
	                |	ЛБ_НачислениеПроцентовДетально.ОтклонениеАкцияОтностельное КАК ОтклонениеАкцияОтностельное,
	                |	ЛБ_НачислениеПроцентовДетально.ОтклонениеАкцияАбсолютное КАК ОтклонениеАкцияАбсолютное,
	                |	ЛБ_НачислениеПроцентовДетально.СуммаПроцентов КАК СуммаПроцентов,
	                |	ЛБ_НачислениеПроцентовДетально.СуммаПроцентовДень КАК СуммаПроцентовДень
	                |ИЗ
	                |	РегистрНакопления.ЛБ_НачислениеПроцентовДетально КАК ЛБ_НачислениеПроцентовДетально
	                |ГДЕ
	                |	ЛБ_НачислениеПроцентовДетально.ЗалоговыйБилет = &ЗБ";
	ТаблицаРасчетовДетально = Запрос.Выполнить().Выгрузить();

	//+Мельников 27.06.24 Заявка 2641
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Период КАК Период,
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПричинаПрименения КАК ПричинаПрименения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗБ";
	ТаблицаСостояний = Запрос.Выполнить().Выгрузить();	
	//-Мельников      
	
		
	ДокументРезультат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Статистика_Обращений_По_Клиенту";
	
	Макет 			 = Отчет.РеквизитМакет;
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьИтог  = Макет.ПолучитьОбласть("Итог"); 
	ОбластьСтрока  = Макет.ПолучитьОбласть("Строка");  
	ОбластьСтрока1  = Макет.ПолучитьОбласть("Строка1");
	ОбластьИтог  = Макет.ПолучитьОбласть("Итог");
		
	ОбластьШапка.Параметры.НомерЗБ = СокрЛП(Отчет.ЗалоговыйБилет.НомерЗалоговогоБилета); 
	ОбластьШапка.Параметры.Дата1 = Формат(Отчет.ЗалоговыйБилет.Дата, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Дата2 = Формат(Отчет.Дата, "ДФ=dd.MM.yyyy"); 
	ДокументРезультат.Вывести(ОбластьШапка); 
	
	НачисленоИтог = 0; 
	ОплатаПроцентыИтог = 0;  
	ОплатаЗаймИтог = 0;
	Для каждого стр Из ТаблицаЗБ Цикл
		//+Мельников 16.05.24 Добавлено условие для НЕ отображения документов отмены и отмененных документов. 
		Если ТипЗнч(стр.Регистратор) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") Тогда
			//Если НЕ ?(ЗначениеЗаполнено(стр.Регистратор.ДокументОтмены), Ложь, ?(ЗначениеЗаполнено(стр.Регистратор.ОтмененныйДокумент), Ложь, Истина)) Тогда  
			Если НЕ ?(ЗначениеЗаполнено(ПолучитьДокументОтмены(стр.Регистратор)), Ложь, ?(ЗначениеЗаполнено(стр.Регистратор.ОтмененныйДокумент), Ложь, Истина)) Тогда  
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		//-Мельников
		ОбластьСтрока.Параметры.Дата = Формат(Стр.Период, "ДФ=dd.MM.yyyy");   
		ОбластьСтрока.Параметры.Вид = Строка(Стр.ВидОперации);
		СтруктураР = Новый Структура;
		СтруктураР.Вставить("ВидОперации", Стр.ВидОперации);
		СтруктураР.Вставить("Документ", Стр.Регистратор);
		Если Стр.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог Или 
			(Стр.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление И Стр.Регистратор = Отчет.ЗалоговыйБилет) Тогда
			ОбластьСтрока.Параметры.СуммаЗайма = Стр.СуммаСсуды; 
			ОбластьСтрока.Параметры.ОстатокЗайм = Стр.СуммаСсуды;
			ОстатокЗайм = Стр.СуммаСсуды;  
			ОстатокПроценты = 0;
			ОбластьСтрока.Параметры.СтруктураР = СтруктураР;
			ДокументРезультат.Вывести(ОбластьСтрока);
		Иначе	
			//+Мельников 27.06.24 Заявка 2641
			Отбор = Новый Структура;
			Отбор.Вставить("Регистратор", Стр.Регистратор); 
			СтрокиДоп = ТаблицаРасчетовДетально.НайтиСтроки(Отбор);
			
			Если ТаблицаЗБ.Количество() = 1 Тогда
				Если СтрокиДоп.Количество() = 0 Тогда
					ПоследнийРегистратор = Стр.Регистратор;  
					ПоследняяДатаРасчета = ПоследнийРегистратор.Дата;
					
					НачисленоПредварительно = 0;
					Если НачалоДня(ПоследняяДатаРасчета) < НачалоДня(Дата2) ИЛИ НачалоДня(ПоследняяДатаРасчета) = НачалоДня(Отчет.ЗалоговыйБилет.Дата) Тогда   
						СтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(Дата2, Отчет.ЗалоговыйБилет);
						Если ПредварительныйРасчет И НЕ (СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт ИЛИ   
							СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение ИЛИ
							СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
							СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
							СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен) Тогда	 
							СтрС = ТаблицаСостояний.Получить(ТаблицаСостояний.Количество()-1);   
							ТаблицаНачислений = РасчитатьДолгПоПроцентам(Дата2, СтрС.СуммаЗайма, СтрС.ПричинаПрименения, СтрС.ДатаНачалаРасчетаПроцентов); 
							ОбластьСтрока.Параметры.Дата = Формат(Дата2, "ДФ=dd.MM.yyyy");   
							ОбластьСтрока.Параметры.Вид = "Предварительный расчет";
							ОбластьСтрока.Параметры.СтруктураР = "";
							Если НЕ ТаблицаНачислений.Количество() = 0 Тогда  				 				 
								Ном = 0;       
								НачисленоПериод = 0;
								//ОбщаяСумма = 0;
								//Для каждого СтрДоп из ТаблицаНачислений Цикл
								//	ОбщаяСумма = ОбщаяСумма + СтрДоп.СуммаПроцентов;
								//КонецЦикла;
								
								Для каждого СтрДоп из ТаблицаНачислений Цикл
									СтавкаП = СтрДоп.ПроцентнаяСтавкаБазовая; 
									Если СтрДоп.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
										Если НЕ СтрДоп.ПроцентнаяСтавкаАкция = 0 Тогда
											СтавкаП = СтрДоп.ПроцентнаяСтавкаАкция;
