//+МАН 28.02.25
&НаСервере
Функция ПроверитьУсловияВДокументеПоЗалогодателю(Документ, Залогодатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИСТИНА КАК НетУсловий
		|ИЗ
		|	Документ.ЛБ_ПриказИндивидуальныеУсловия.Залогодатели КАК ЛБ_ПриказИндивидуальныеУсловияЗалогодатели
		|ГДЕ
		|	ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Ссылка = &Ссылка
		|	И ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Залогодатель = &Залогодатель
		|	И ВЫБОР
		|			КОГДА ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.НетСтавок = ИСТИНА
		|					И ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.НетМеталлов = ИСТИНА
		|					И ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.НетВставок = ИСТИНА
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
