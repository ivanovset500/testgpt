	ЗапросС.УстановитьПараметр("МомВрем", Новый Граница(Регистратор.МоментВремени(), ВидГраницы.Исключая));  
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() тогда
		Результат.ЗначениеСтарое = ?(ВыборкаС.Используется, "установлен", "не установлен");  
		Если ВыборкаС.Используется Тогда 
			Результат.ЗначениеСтарое = Результат.ЗначениеСтарое + ?(ПустаяСтрока(ВыборкаС.Комментарий), "", ", " + СокрЛП(ВыборкаС.Комментарий));
        КонецЕсли;
	КонецЕсли;
	
	ЗапросС.Текст = "ВЫБРАТЬ
	                |	ЛБ_СтатусыЗалогодателей.Используется КАК Используется,
	                |	ЛБ_СтатусыЗалогодателей.Комментарий КАК Комментарий
	                |ИЗ
	                |	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные КАК ЛБ_СтатусыЗалогодателей
	                |ГДЕ
	                |	ЛБ_СтатусыЗалогодателей.Регистратор = &Регистратор
	                |	И ЛБ_СтатусыЗалогодателей.Залогодатель = &Залогодатель
	                |	И ЛБ_СтатусыЗалогодателей.Статус = &Статус";
	ЗапросС.УстановитьПараметр("Регистратор", Регистратор);  
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() тогда
		Результат.ЗначениеНовое = ?(ВыборкаС.Используется, "установлен", "не установлен"); 
		Если ВыборкаС.Используется Тогда 
			Результат.ЗначениеНовое = Результат.ЗначениеНовое + ?(ПустаяСтрока(ВыборкаС.Комментарий), "", ", " + СокрЛП(ВыборкаС.Комментарий));
        КонецЕсли;
	Иначе
		Результат.ЗначениеНовое = Результат.ЗначениеСтарое;
	КонецЕсли;  
		
	Возврат Результат;	
КонецФункции	                            

&НаСервере
Процедура СформироватьНаСервере()
	
	ТаблицаИзменений = Новый ТаблицаЗначений; 
	ТаблицаИзменений.Колонки.Добавить("Вид"); 
	ТаблицаИзменений.Колонки.Добавить("ЗначениеСтарое");
	ТаблицаИзменений.Колонки.Добавить("ЗначениеНовое");
	
	ТаблицаИзмененийДок = Новый ТаблицаЗначений; 
	ТаблицаИзмененийДок.Колонки.Добавить("Документ");
	ТаблицаИзмененийДок.Колонки.Добавить("ПричинаИзменения");
	ТаблицаИзмененийДок.Колонки.Добавить("Вид"); 
	ТаблицаИзмененийДок.Колонки.Добавить("ЗначениеСтарое");
	ТаблицаИзмененийДок.Колонки.Добавить("ЗначениеНовое"); 
	ТаблицаИзмененийДок.Колонки.Добавить("Обработано");

	
	ДокументРезультат.Очистить(); 
	
	НачДата = Отчет.НачПериода;
	КонДата = ?(Отчет.КонПериода = Дата(1,1,1), ТекущаяДата(), КонецДня(Отчет.КонПериода));

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Отчет.Залогодатель); 
	Запрос.УстановитьПараметр("ПустаяПричинаИзмененияФИО", Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПериодНач", НачДата);
	Запрос.УстановитьПараметр("ПериодКон", КонДата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.Период КАК Период,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.Регистратор КАК Регистратор,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ПричинаИзменения КАК ПричинаИзменения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ПричинаИзмененияФИО КАК ПричинаИзмененияФИО,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.Ответственный КАК Ответственный,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ОтветственныйЛомбард КАК ОтветственныйЛомбард,	//+++ МоисеевЕС 20250526
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.Изменения КАК Изменения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ОснованиеИзмененияФИО КАК ОснованиеИзмененияФИО,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.СменилсяАдресПрописки КАК СменилсяАдресПрописки,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.СменилсяФактическийАдрес КАК СменилсяФактическийАдрес,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.СменилсяПочтовыйАдрес КАК СменилсяПочтовыйАдрес,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ПричинаИзмененияАдресаПоПрописке КАК ПричинаИзмененияАдресаПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ПричинаИзмененияФактическогоАдреса КАК ПричинаИзмененияФактическогоАдреса,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ПричинаИзмененияПочтовогоАдреса КАК ПричинаИзмененияПочтовогоАдреса
