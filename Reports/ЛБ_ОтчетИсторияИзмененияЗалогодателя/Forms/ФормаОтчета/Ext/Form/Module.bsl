&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Залогодатель") Тогда
		Отчет.Залогодатель = Параметры.Залогодатель;
	КонецЕсли;  
	Если ЗначениеЗаполнено(Отчет.Залогодатель) Тогда
		Отчет.НачПериода = Дата(1,1,1);
		Отчет.КонПериода = Дата(1,1,1);
		Отчет.Горизонтальный = Истина;
		СформироватьНаСервере();
	КонецЕсли;
 КонецПроцедуры

&НаКлиенте
Процедура НастроитьИнтервал(Команда)
	
	ДиалогРедактирования = Новый ДиалогРедактированияСтандартногоПериода;
	
	Если ДиалогРедактирования.Редактировать() Тогда
		Отчет.НачПериода	= ДиалогРедактирования.Период.ДатаНачала;
		Отчет.КонПериода 	= ДиалогРедактирования.Период.ДатаОкончания;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	Если НЕ ЗначениеЗаполнено(Отчет.Залогодатель) Тогда
		Сообщить("Не выбран залогодатель!");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуИзменений(Изменения, ТаблицаИзменений)
	 ТаблицаИзменений.Очистить();
	 КоличествоСтрок = СтрЧислоСтрок(Изменения);
	 Для НомерСтроки = 1 По КоличествоСтрок Цикл   
		 ИсходнаяСтрока = СтрПолучитьСтроку(Изменения, НомерСтроки);
		 Поз = Найти(ИсходнаяСтрока, "Изменен");
		 Если НЕ Поз = 0 Тогда
			 ИсходнаяСтрока = Сред(ИсходнаяСтрока, Поз + 7);  
			 Пока НЕ Лев(ИсходнаяСтрока, 1) = " " Цикл  
				  ИсходнаяСтрока = " " + Сред(ИсходнаяСтрока, 2);
			 КонецЦикла;	 
			 
			 Поз = Найти(ИсходнаяСтрока, " с "); 
			 Если НЕ Поз = 0 Тогда 
				 Вид = СокрЛП(Сред(ИсходнаяСтрока, 1, Поз-1)); 
				 НоваяСтр = ТаблицаИзменений.Добавить(); 
				 НоваяСтр.Вид = Врег(Лев(Вид,1)) + Сред(Вид, 2);
				 ИсходнаяСтрока = Сред(ИсходнаяСтрока, Поз + 2);
				 
				 Поз = Найти(ИсходнаяСтрока, " на ");
				 Если НЕ Поз = 0 Тогда 
					 СтароеЗнч = Сред(ИсходнаяСтрока, 1, Поз-1);
					 СтароеЗнч = СтрЗаменить(СтароеЗнч, "<", "");
					 СтароеЗнч = СтрЗаменить(СтароеЗнч, ">", ""); 
					 СтароеЗнч = СокрЛП(СтароеЗнч);  
					 НоваяСтр.ЗначениеСтарое = СтароеЗнч;  
					 
					 НовоеЗнч = Сред(ИсходнаяСтрока, Поз+3);
					 НовоеЗнч = СтрЗаменить(НовоеЗнч, "<", "");
					 НовоеЗнч = СтрЗаменить(НовоеЗнч, ">", ""); 
					 НовоеЗнч = СокрЛП(НовоеЗнч);  
					 НоваяСтр.ЗначениеНовое = НовоеЗнч;
				 КонецЕсли;	 
			 КонецЕсли;	 
		 КонецЕсли;	 
	 КонецЦикла;
	 Возврат ТаблицаИзменений;
 КонецФункции      
 
 &НаСервере
Функция ПолучитьТаблицуИзмененийДок(Изменения, ПричинаИзменения, Документ, ТаблицаИзменений)
	 КоличествоСтрок = СтрЧислоСтрок(Изменения);
	 Для НомерСтроки = 1 По КоличествоСтрок Цикл   
		 ИсходнаяСтрока = СтрПолучитьСтроку(Изменения, НомерСтроки);
		 Поз = Найти(ИсходнаяСтрока, "Изменен");
		 Если НЕ Поз = 0 Тогда
			 ИсходнаяСтрока = Сред(ИсходнаяСтрока, Поз + 7);  
			 Пока НЕ Лев(ИсходнаяСтрока, 1) = " " Цикл  
				  ИсходнаяСтрока = " " + Сред(ИсходнаяСтрока, 2);
			 КонецЦикла;	 
			 
			 Поз = Найти(ИсходнаяСтрока, " с "); 
			 Если НЕ Поз = 0 Тогда 
				 Вид = СокрЛП(Сред(ИсходнаяСтрока, 1, Поз-1)); 
				 НоваяСтр = ТаблицаИзменений.Добавить(); 
				 НоваяСтр.Вид = Врег(Лев(Вид,1)) + Сред(Вид, 2);  
				 НоваяСтр.ПричинаИзменения = ПричинаИзменения;
			     НоваяСтр.Документ = Документ;
				 ИсходнаяСтрока = Сред(ИсходнаяСтрока, Поз + 2);
				 
				 Поз = Найти(ИсходнаяСтрока, " на ");
				 Если НЕ Поз = 0 Тогда 
					 СтароеЗнч = Сред(ИсходнаяСтрока, 1, Поз-1);
					 СтароеЗнч = СтрЗаменить(СтароеЗнч, "<", "");
					 СтароеЗнч = СтрЗаменить(СтароеЗнч, ">", ""); 
					 СтароеЗнч = СокрЛП(СтароеЗнч);  
					 НоваяСтр.ЗначениеСтарое = СтароеЗнч;  
					 
					 НовоеЗнч = Сред(ИсходнаяСтрока, Поз+3);
					 НовоеЗнч = СтрЗаменить(НовоеЗнч, "<", "");
					 НовоеЗнч = СтрЗаменить(НовоеЗнч, ">", ""); 
					 НовоеЗнч = СокрЛП(НовоеЗнч);  
					 НоваяСтр.ЗначениеНовое = НовоеЗнч;
				 КонецЕсли;	 
			 КонецЕсли;	 
		 КонецЕсли;	 
	 КонецЦикла;   
	 Если ТаблицаИзменений.Количество() = 0 Тогда 
		 Если Изменения = "Создан новый документ" Тогда
			 НоваяСтр = ТаблицаИзменений.Добавить(); 
			 НоваяСтр.ПричинаИзменения = ?(ЗначениеЗаполнено(ПричинаИзменения), ПричинаИзменения, Изменения);
			 НоваяСтр.Документ = Документ;
			 НоваяСтр.Вид = "";
			 НоваяСтр.ЗначениеСтарое = ""; 
			 НоваяСтр.ЗначениеНовое = "";
         КонецЕсли;
	 КонецЕсли;	 
	 Возврат ТаблицаИзменений;
КонецФункции

&НаСервере
Функция ПолучитьПричинуОтказа(Регистратор)	
	ЗапросС = Новый Запрос; 
	ЗапросС.УстановитьПараметр("Залогодатель", Отчет.Залогодатель);  
	ЗапросС.УстановитьПараметр("Регистратор", Регистратор);  
	ЗапросС.Текст = "ВЫБРАТЬ
	                |	ЛБ_ОтказыКлиентамВОбслуживании.Изменения КАК Изменения
	                |ИЗ
	                |	РегистрСведений.ЛБ_ОтказыКлиентамВОбслуживании КАК ЛБ_ОтказыКлиентамВОбслуживании
	                |ГДЕ
	                |	ЛБ_ОтказыКлиентамВОбслуживании.Залогодатель = &Залогодатель
	                |	И ЛБ_ОтказыКлиентамВОбслуживании.Регистратор = &Регистратор";
	
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() тогда
		Возврат ВыборкаС.Изменения;  
	КонецЕсли;		
	Возврат "";	
КонецФункции	   

&НаСервере
Функция ПолучитьСтатусКлиента(Дата)	
	ЗапросС = Новый Запрос; 
	ЗапросС.УстановитьПараметр("Залогодатель", Отчет.Залогодатель);  
	ЗапросС.УстановитьПараметр("Дата", Дата);  
	ЗапросС.Текст = "ВЫБРАТЬ
	                |	ЛБ_СтатусыЗалогодателейСрезПоследних.Статус КАК Статус
	                |ИЗ
	                |	РегистрСведений.ЛБ_СтатусыЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_СтатусыЗалогодателейСрезПоследних";
	
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() тогда
		Возврат ВыборкаС.Статус;  
	КонецЕсли;		
	Возврат неопределено;	
КонецФункции	   

&НаСервере
Функция ПолучитьСтатусыКлиентаДоп(Регистратор, Статус) 
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеСтарое", "не установлен");
	Результат.Вставить("ЗначениеНовое", "не установлен");
	
	ЗапросС = Новый Запрос; 
	ЗапросС.УстановитьПараметр("Залогодатель", Отчет.Залогодатель);	
	ЗапросС.УстановитьПараметр("Статус", Статус);
	ЗапросС.Текст = "ВЫБРАТЬ
	                |	ЛБ_СтатусыЗалогодателейСрезПоследних.Используется КАК Используется,
	                |	ЛБ_СтатусыЗалогодателейСрезПоследних.СрокДействия КАК СрокДействия,
	                |	ЛБ_СтатусыЗалогодателейСрезПоследних.Комментарий КАК Комментарий
	                |ИЗ
	                |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	                |			&МомВрем,
	                |			Залогодатель = &Залогодатель
	                |				И Статус = &Статус) КАК ЛБ_СтатусыЗалогодателейСрезПоследних";
	ЗапросС.УстановитьПараметр("МомВрем", Новый Граница(Регистратор.МоментВремени(), ВидГраницы.Исключая));  
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() тогда
		Результат.ЗначениеСтарое = ?(ВыборкаС.Используется, "установлен", "не установлен");  
		Если ВыборкаС.Используется Тогда
			Если НЕ ВыборкаС.СрокДействия = Дата(1,1,1) Тогда 
			    Результат.ЗначениеСтарое = Результат.ЗначениеСтарое + " до " + Формат(КонецДня(ВыборкаС.СрокДействия)+1, "ДФ=dd.MM.yyyy");
			КонецЕсли;	
			Результат.ЗначениеСтарое = Результат.ЗначениеСтарое + ?(ПустаяСтрока(ВыборкаС.Комментарий), "", " " + СокрЛП(ВыборкаС.Комментарий));
		КонецЕсли;	
	КонецЕсли;
	
	ЗапросС.Текст = "ВЫБРАТЬ
	                |	ЛБ_СтатусыЗалогодателей.Используется КАК Используется,
	                |	ЛБ_СтатусыЗалогодателей.СрокДействия КАК СрокДействия,
	                |	ЛБ_СтатусыЗалогодателей.Комментарий КАК Комментарий
	                |ИЗ
	                |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные КАК ЛБ_СтатусыЗалогодателей
	                |ГДЕ
	                |	ЛБ_СтатусыЗалогодателей.Регистратор = &Регистратор
	                |	И ЛБ_СтатусыЗалогодателей.Залогодатель = &Залогодатель
	                |	И ЛБ_СтатусыЗалогодателей.Статус = &Статус";
	ЗапросС.УстановитьПараметр("Регистратор", Регистратор);  
	ВыборкаС = ЗапросС.Выполнить().Выбрать();
	Если ВыборкаС.Следующий() тогда
		Результат.ЗначениеНовое = ?(ВыборкаС.Используется, "установлен", "не установлен");  
		Если ВыборкаС.Используется Тогда
			Если НЕ ВыборкаС.СрокДействия = Дата(1,1,1) Тогда 
			    Результат.ЗначениеНовое = Результат.ЗначениеНовое + " до " + Формат(КонецДня(ВыборкаС.СрокДействия)+1, "ДФ=dd.MM.yyyy");
			КонецЕсли;	
			Результат.ЗначениеНовое = Результат.ЗначениеНовое + ?(ПустаяСтрока(ВыборкаС.Комментарий), "", ", " + СокрЛП(ВыборкаС.Комментарий));
		КонецЕсли;	
	Иначе
		Результат.ЗначениеНовое = Результат.ЗначениеСтарое;
	КонецЕсли;  
		
	Возврат Результат;	
КонецФункции	                            

&НаСервере
Функция ПолучитьСтатусыКлиентаСлужебные(Регистратор, Статус) 
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеСтарое", "не установлен");
	Результат.Вставить("ЗначениеНовое", "не установлен");
	
	ЗапросС = Новый Запрос; 
