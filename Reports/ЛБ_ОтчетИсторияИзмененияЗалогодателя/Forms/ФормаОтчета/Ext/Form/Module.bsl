			Для каждого Стр Из ТаблицаСтатусовСлужебных Цикл 
				Статусы = ПолучитьСтатусыКлиентаСлужебные(СтрДок.Регистратор, Стр.Статус);
				Если НЕ Статусы.ЗначениеСтарое = Статусы.ЗначениеНовое Тогда
					Если Ном = 0 Тогда
						ДокументРезультат.Вывести(ОбластьПусто, 2);
			            ДокументРезультат.Вывести(ОбластьСтатусС, 2); 
					КонецЕсли;	
		            						
					ДокументРезультат.Вывести(ОбластьПусто, 2);  
					ОбластьСтрокаСтатусС.Параметры.СтатусСлужебный = Стр.Статус;
					ОбластьСтрокаСтатусС.Параметры.СтароеСтатус = Статусы.ЗначениеСтарое;
					ОбластьСтрокаСтатусС.Параметры.НовоеСтатус = Статусы.ЗначениеНовое; 
			        ДокументРезультат.Вывести(ОбластьСтрокаСтатусС, 2);
					Ном = Ном + 1;
				КонецЕсли;
			КонецЦикла;  

			Запрос = Новый Запрос;   
			Запрос.УстановитьПараметр("Регистратор", СтрДок.Регистратор);
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_СогласиеНаСМСРассылку.Согласен КАК Согласен
			               |ИЗ
			               |	РегистрСведений.ЛБ_СогласиеНаСМСРассылку КАК ЛБ_СогласиеНаСМСРассылку
			               |ГДЕ
			               |	ЛБ_СогласиеНаСМСРассылку.Регистратор = &Регистратор
			               |АВТОУПОРЯДОЧИВАНИЕ";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда 
				Если ТипЗнч(СтрДок.Регистратор) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") Тогда
					ПричинаИзменения = "ЗБ № " + СокрЛП(СтрДок.Регистратор.НомерЗалоговогоБилета) + " от " + Формат(СтрДок.Регистратор.Дата, "ДФ=dd.MM.yyyy");  
				Иначе 
					ПричинаИзменения = "Карточка клиента";
				КонецЕсли;                                   
				ОбластьСМС.Параметры.ПричинаИзменения = ПричинаИзменения;
				ДокументРезультат.Вывести(ОбластьПусто, 2);
			    ДокументРезультат.Вывести(ОбластьСМС, 2); 
						
				ДокументРезультат.Вывести(ОбластьПусто, 2);  
				ОбластьСтрокаСМС.Параметры.СтароеЗначение = ?(Выборка.Согласен, "Не согласен", "Согласен");
				ОбластьСтрокаСМС.Параметры.НовоеЗначение = ?(Выборка.Согласен, "Согласен", "Не согласен");; 
		        ДокументРезультат.Вывести(ОбластьСтрокаСМС, 2);
   			КонецЕсли;  

			ПричинаОтказа = ПолучитьПричинуОтказа(СтрДок.Регистратор);  
			Если НЕ ПустаяСтрока(ПричинаОтказа) Тогда 
				ДокументРезультат.Вывести(ОбластьПусто, 2); 
				ОбластьОтказ.Параметры.ПричинаОтказа = ПричинаОтказа;
			    ДокументРезультат.Вывести(ОбластьОтказ, 2); 
			КонецЕсли;	
		Конеццикла;		
		ДокументРезультат.ЗакончитьАвтогруппировкуСтрок();  
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьОперацию(Документ)
	Возврат Документ.ВидОперации;
КонецФункции	

&НаКлиенте
Процедура ДокументРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда 
		СтандартнаяОбработка = Ложь; 
		Если Расшифровка.Вид = 1 Тогда			
			Расшифровка.Вставить("НеРедактировать", Истина);
			ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", Расшифровка, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		Иначе
			Параметрыформы = Новый Структура;
			Параметрыформы.Вставить("Документ", Расшифровка.Регистратор); 
			ВидОперации = ПолучитьОперацию(Расшифровка.Регистратор);
			Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") Тогда
				ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗайма", Параметрыформы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда 
				ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", Параметрыформы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;  
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьДопСтатусыКлиента(Регистратор, Статус, ИстекСрок = Ложь, ДатаОтчета = Неопределено) 
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеСтарое", "не установлен");
	Результат.Вставить("ЗначениеНовое", "не установлен");
	
	ЗапросС = Новый Запрос; 
	ЗапросС.УстановитьПараметр("Залогодатель", Отчет.Залогодатель);	
	ЗапросС.УстановитьПараметр("Статус", Статус);
	Если ИстекСрок Тогда
		//+МАН 25.08.25 Изменил
		//ДействующийПриказ = НайтиДействующийПриказ(Отчет.Залогодатель, Регистратор.ДатаОкончанияДействияПриказа, ИстекСрок, Регистратор, Истина, ДатаОтчета); //, Истина);
		ДействующийПриказ = НайтиДействующийПриказ(Отчет.Залогодатель, Регистратор.ДатаОкончанияДействияПриказа, ИстекСрок, Регистратор); //, Истина);
		//-МАН
	Иначе
		Если НачалоДня(Регистратор.Дата) = НачалоДня(Регистратор.ДатаНачалаДействияПриказа) Тогда
			ДатаНачала = Регистратор.Дата;
		Иначе
			ДатаНачала = Регистратор.ДатаНачалаДействияПриказа;
		КонецЕсли;
		ДействующийПриказ = НайтиДействующийПриказ(Отчет.Залогодатель, ДатаНачала, ИстекСрок, Регистратор, Истина);
	КонецЕсли;
	
	Если ДействующийПриказ = Неопределено ИЛИ ?(ИстекСрок, Ложь, ДействующийПриказ = Регистратор) Тогда
		Результат.ЗначениеНовое = "не установлен";
	Иначе					
		Если ИстекСрок Тогда
			Результат.ЗначениеСтарое = ?(ДействующийПриказ <> Неопределено, "установлен", "не установлен");
			Если ДействующийПриказ <> Неопределено И ДействующийПриказ.ДатаОкончанияДействияПриказа <> Дата(1,1,1) Тогда
				Результат.ЗначениеСтарое = Результат.ЗначениеСтарое + " по " + Формат(ДействующийПриказ.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy") + " включительно";
			КонецЕсли;
		Иначе
			Результат.ЗначениеСтарое = ?(ДействующийПриказ <> Неопределено, "установлен", "не установлен");
			Если ДействующийПриказ <> Неопределено Тогда
				Если ДействующийПриказ <> Неопределено И ДействующийПриказ.ДатаОкончанияДействияПриказа <> Дата(1,1,1) Тогда // НЕ ВыборкаС.СрокДействия = Дата(1,1,1) Тогда 
					Если Регистратор.ВидОперации <> Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
						Результат.ЗначениеСтарое = Результат.ЗначениеСтарое + " по " + Формат(ДействующийПриказ.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy") + " включительно";
					Иначе
						Результат.ЗначениеСтарое = Результат.ЗначениеСтарое + " по " + Формат(ДействующийПриказ.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy") + " включительно";
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если Регистратор.ВидОперации <> Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
		ЗапросС.Текст = "ВЫБРАТЬ
		|	ЛБ_СтатусыЗалогодателей.Используется КАК Используется,
		|	ЛБ_СтатусыЗалогодателей.СрокДействия КАК СрокДействия,
		|	ЛБ_СтатусыЗалогодателей.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные КАК ЛБ_СтатусыЗалогодателей
		|ГДЕ
		|	ЛБ_СтатусыЗалогодателей.Регистратор = &Регистратор
		|	И ЛБ_СтатусыЗалогодателей.Залогодатель = &Залогодатель
		|	И ЛБ_СтатусыЗалогодателей.Статус = &Статус";
		ЗапросС.УстановитьПараметр("Регистратор", Регистратор);  
		ВыборкаС = ЗапросС.Выполнить().Выбрать();
		Если ВыборкаС.Следующий() Тогда
			Если ИстекСрок Тогда
				//+МАН 25.08.25
				//ДействующийПриказ = НайтиДействующийПриказ(Отчет.Залогодатель, Регистратор.ДатаОкончанияДействияПриказа, Истина, Регистратор,,ДатаОтчета);
				ДействующийПриказ = НайтиДействующийПриказ(Отчет.Залогодатель, ДатаОтчета, Истина, Регистратор);
				//-МАН
				
				Если ДействующийПриказ = Неопределено Тогда
					Результат.ЗначениеНовое = "не установлен";
				Иначе					
					Результат.ЗначениеНовое = ?(ВыборкаС.Используется, "установлен", "не установлен");  
					Если ВыборкаС.Используется Тогда
						Если НЕ ДействующийПриказ.ДатаОкончанияДействияПриказа = Дата(1,1,1) Тогда 
							//Было: Результат.ЗначениеНовое = Результат.ЗначениеНовое + " до " + Формат(КонецДня(ДействующийПриказ.ДатаОкончанияДействияПриказа)+1, "ДФ=dd.MM.yyyy");
							Результат.ЗначениеНовое = Результат.ЗначениеНовое + " по " + Формат(ДействующийПриказ.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy") + " включительно";
						КонецЕсли;	
						Результат.ЗначениеНовое = Результат.ЗначениеНовое + ?(ПустаяСтрока(ВыборкаС.Комментарий), "", ", " + СокрЛП(ВыборкаС.Комментарий));
						Результат.ЗначениеНовое = Результат.ЗначениеНовое + Символы.ПС + "Действует приказ №" + ДействующийПриказ.НомерПриказа;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Результат.ЗначениеНовое = ?(ВыборкаС.Используется, "установлен", "не установлен");  
				Если ВыборкаС.Используется Тогда
					Если НЕ ВыборкаС.СрокДействия = Дата(1,1,1) Тогда 
						//Было: Результат.ЗначениеНовое = Результат.ЗначениеНовое + " до " + Формат(КонецДня(ВыборкаС.СрокДействия)+1, "ДФ=dd.MM.yyyy");
						Результат.ЗначениеНовое = Результат.ЗначениеНовое + " по " + Формат(ВыборкаС.СрокДействия, "ДФ=dd.MM.yyyy") + " включительно";
					КонецЕсли;	
					Результат.ЗначениеНовое = Результат.ЗначениеНовое + ?(ПустаяСтрока(ВыборкаС.Комментарий), "", ", " + СокрЛП(ВыборкаС.Комментарий));
				КонецЕсли;
			КонецЕсли;
		Иначе
			Результат.ЗначениеНовое = Результат.ЗначениеСтарое;
		КонецЕсли;
	Иначе
		//+МАН 08.04.25
		ЗапросС.Текст = "ВЫБРАТЬ
		                |	ЛБ_СтатусыЗалогодателей.Используется КАК Используется,
		                |	ЛБ_СтатусыЗалогодателей.СрокДействия КАК СрокДействия,
		                |	ЛБ_СтатусыЗалогодателей.Комментарий КАК Комментарий,
		                |	ЛБ_СтатусыЗалогодателей.Регистратор КАК Регистратор,
		                |	ЛБ_СтатусыЗалогодателей.Период КАК Период,
		                |	ЛБ_СтатусыЗалогодателей.Регистратор.НомерПриказа КАК РегистраторНомерПриказа
		                |ИЗ
		                |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные КАК ЛБ_СтатусыЗалогодателей
		                |ГДЕ
		                |	ЛБ_СтатусыЗалогодателей.Залогодатель = &Залогодатель
		                |	И ЛБ_СтатусыЗалогодателей.Статус = &Статус
		                |	И ЛБ_СтатусыЗалогодателей.Период < &Дата
						//+МАН 08.04.25
						|	И 100 = 100
		                |
		                |УПОРЯДОЧИТЬ ПО
		                //Было: |	ЛБ_СтатусыЗалогодателей.Период УБЫВ";
						|	ЛБ_СтатусыЗалогодателей.Регистратор.Дата УБЫВ";
						//-МАН
		//+МАН 08.04.25
		//Было: ЗапросС.УстановитьПараметр("Дата", Регистратор.Дата);
		Если НачалоДня(Регистратор.Дата) = НачалоДня(Регистратор.ДатаНачалаДействияПриказа) Тогда
			ЗапросС.УстановитьПараметр("Дата", Регистратор.Дата);
		Иначе
			ЗапросС.УстановитьПараметр("Дата", Регистратор.ДатаНачалаДействияПриказа);
		КонецЕсли;
		
		Если Регистратор.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
			ЗапросС.Текст = СтрЗаменить(ЗапросС.Текст, "100 = 100", "НЕ ЛБ_СтатусыЗалогодателей.Регистратор = &Регистратор");
			ЗапросС.УстановитьПараметр("Регистратор", Регистратор);
		КонецЕсли;
		//-МАН

		ВыборкаС = ЗапросС.Выполнить().Выгрузить();
		Если ВыборкаС.Количество() > 0 тогда
			ДействующийПриказ = НайтиДействующийПриказ(Отчет.Залогодатель, ЗапросС.Параметры.Дата,, Регистратор);
			
			Если ДействующийПриказ <> Неопределено Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Регистратор", ДействующийПриказ);
				
				МассивСтр = ВыборкаС.НайтиСтроки(Отбор);
				
				Если МассивСтр.Количество() > 0 Тогда
					Стр = МассивСтр.Получить(0);
					Результат.ЗначениеНовое = ?(Стр.Используется, "установлен", "не установлен");
					Если Стр.Используется Тогда
						Если НЕ Стр.СрокДействия = Дата(1,1,1) Тогда 
							//Было: Результат.ЗначениеНовое = Результат.ЗначениеНовое + " до " + Формат(КонецДня(Стр.СрокДействия)+1, "ДФ=dd.MM.yyyy");
							Результат.ЗначениеНовое = Результат.ЗначениеНовое + " по " + Формат(Стр.СрокДействия, "ДФ=dd.MM.yyyy") + " включительно";
						КонецЕсли;
						
						Результат.ЗначениеНовое = Результат.ЗначениеНовое + Символы.ПС + "Действует приказ №" + Стр.РегистраторНомерПриказа;
						
					КонецЕсли;	
				Иначе
					Результат.ЗначениеНовое = "не установлен";
				КонецЕсли;
			Иначе
				Результат.ЗначениеНовое = "не установлен";
			КонецЕсли;
		Иначе
			Результат.ЗначениеНовое = Результат.ЗначениеСтарое;
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Результат;	
КонецФункции	                            

//+МАН 25.08.25 Переименовал и сделал новую, с изменениями.
&НаСервере
Функция НайтиДействующийПриказСтарый(Залогодатель, Дата, ИстекСрок = Ложь, Регистратор = Неопределено, СтароеЗначение = Ложь, ДатаОтчета = Неопределено)
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	                |	Ставки.Регистратор КАК Регистратор,
	                |	Ставки.Период КАК Период
	                |ИЗ
	                |	(ВЫБРАТЬ ПЕРВЫЕ 1
	                |		ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК Регистратор,
	                |		ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период КАК Период
	                |	ИЗ
	                |		РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
	                |	ГДЕ
	                |		ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель = &Залогодатель
					|		И ВЫБОР
					|			КОГДА РАЗНОСТЬДАТ(ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период, ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия, ДЕНЬ) = 0
					|				ТОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период <= &Дата
					|			ИНАЧЕ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
					|		КОНЕЦ
	                //|		И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
	                |		И ВЫБОР
