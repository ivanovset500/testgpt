Процедура КварталПриИзменении(Элемент)
	УстановитьДатыОтчета();
КонецПроцедуры

&НаКлиенте
Процедура ГодПриИзменении(Элемент)
	УстановитьДатыОтчета();
КонецПроцедуры

&НаСервере
Процедура УстановитьДатыОтчета(ОткрытиеОтчета = Ложь)
	
	Если ОткрытиеОтчета Тогда
		Если Месяц(Отчет.ДатаНач) = 1 Тогда
			Квартал = 1;
		ИначеЕсли Месяц(Отчет.ДатаНач) = 4 Тогда
			Квартал = 2;
		ИначеЕсли Месяц(Отчет.ДатаНач) = 7 Тогда
			Квартал = 3;
		ИначеЕсли Месяц(Отчет.ДатаНач) = 10 Тогда
			Квартал = 4;
		КонецЕсли;
	Иначе
		Если Квартал = 1 Тогда
			ДатаКвартала = Дата(Год, 1, 1);
			Отчет.ДатаНач = НачалоКвартала(ДатаКвартала);
			Отчет.ДатаКон = КонецКвартала(ДатаКвартала);
		ИначеЕсли Квартал = 2 Тогда
			ДатаКвартала = Дата(Год, 4, 1);
			Отчет.ДатаНач = НачалоКвартала(ДатаКвартала);
			Отчет.ДатаКон = КонецКвартала(ДатаКвартала);
		ИначеЕсли Квартал = 3 Тогда
			ДатаКвартала = Дата(Год, 7, 1);
			Отчет.ДатаНач = НачалоКвартала(ДатаКвартала);
			Отчет.ДатаКон = КонецКвартала(ДатаКвартала);
		ИначеЕсли Квартал = 4 Тогда
			ДатаКвартала = Дата(Год, 10, 1);
			Отчет.ДатаНач = НачалоКвартала(ДатаКвартала);
			Отчет.ДатаКон = КонецКвартала(ДатаКвартала);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры





