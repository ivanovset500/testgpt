
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Отчет.Организация = Справочники.Организации.НайтиПоКоду("ДМ-000003");
	Год = Год(ТекущаяДата());
	Отчет.ДатаНач = НачалоКвартала(ТекущаяДата());
	Отчет.ДатаКон = КонецКвартала(ТекущаяДата());
	
	УстановитьДатыОтчета(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Интервал(Команда)
	ДиалогРедактирования = Новый ДиалогРедактированияСтандартногоПериода;
	
	Если ДиалогРедактирования.Редактировать() Тогда
		Отчет.ДатаНач	= ДиалогРедактирования.Период.ДатаНачала;
		Отчет.ДатаКон 	= ДиалогРедактирования.Период.ДатаОкончания;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Результат.Очистить();  
	
	ДатаНач = Отчет.ДатаНач;
	ДатаКон = ?(Отчет.ДатаКон = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.ДатаКон));
	
	Результат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РасчетЛимитов";
	
	//НеЕктИлиЦО = Отчет.Ломбард <> Справочники.ЛБ_Ломбарды.ЦентральныйОфис ИЛИ СтрНайти(Отчет.Отделение.Наименование, "Екатеринбург") = 0;
	ЕктИлиЦО = Отчет.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис
		ИЛИ Отчет.Отделение.НайтиПоЗначению(Справочники.ЛБ_ОтделенияЛомбардов.НайтиПоНаименованию("Екатеринбург")) <> Неопределено;
	
	Если НЕ ЕктИлиЦО Тогда
		Макет = Отчет.РеквизитМакет;
	Иначе
		Макет = Отчет.РеквизитМакетЕкт;
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	ПериодОтчета = "период с " + Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаКон, "ДФ=dd.MM.yyyy");
	
	ОбластьШапка.Параметры.Период = ПериодОтчета; 
	Результат.Вывести(ОбластьШапка);
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Результат.Вывести(ОбластьЗаголовок);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса(ЕктИлиЦО);
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	
	Если ЗначениеЗаполнено(Отчет.Ломбард) Тогда
		Запрос.УстановитьПараметр("Ломбард", Отчет.Ломбард);
	Иначе
		Запрос.УстановитьПараметр("Ломбард", ПолучитьСписокЛомбардов(ДатаКон, ?(ЗначениеЗаполнено(Отчет.Отделение), Отчет.Отделение.ВыгрузитьЗначения(), Неопределено)));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Нпп = 0;
	Для каждого Стр Из РезультатЗапроса Цикл
		Если ПроверкаЧислаНаЧетность(Нпп) Тогда
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаЧет");
		Иначе
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаНечет");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Стр);
		Результат.Вывести(ОбластьСтрока);
		Нпп = Нпп + 1;
	КонецЦикла;
	
	ОбластьИтого = Макет.ПолучитьОбласть("Итого");
	ОбластьИтого.Параметры.ИтогоСуммаВыданныхЗаймов = РезультатЗапроса.Итог("СуммаВыданныхЗаймов");
	ОбластьИтого.Параметры.ИтогоРассчетныйЛимит = РезультатЗапроса.Итог("РассчетныйЛимит");
	
	Если НЕ ЕктИлиЦО Тогда
		ОбластьИтого.Параметры.ИтогоФактическийЛимит = РезультатЗапроса.Итог("ФактическийЛимит");
	Иначе
		ОбластьИтого.Параметры.ИтогоПроцентРасп = РезультатЗапроса.Итог("ПроцентРасп");
		ОбластьИтого.Параметры.ИтогоСуммаРасп = РезультатЗапроса.Итог("СуммаРасп");
		ОбластьИтого.Параметры.ИтогоЛимитОстатка = РезультатЗапроса.Итог("ЛимитОстатка");
	КонецЕсли;
	
	Результат.Вывести(ОбластьИтого);
	
КонецПроцедуры

