		        |				ИЗ
		        |					РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&ДатаКон, Ломбард В (&Ломбард)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		        |ГДЕ
		        |	НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		        |;
		        |
		        |////////////////////////////////////////////////////////////////////////////////
		        |ВЫБРАТЬ
		        |	ЛБ_КассовыеЛимитыСрезПоследних.Ломбард КАК Ломбард,
		        |	ЛБ_КассовыеЛимитыСрезПоследних.ФактическийЛимит КАК ФактическийЛимит
		        |ПОМЕСТИТЬ ФактЛимит
		        |ИЗ
		        |	РегистрСведений.ЛБ_КассовыеЛимиты.СрезПоследних(&ДатаКон, Ломбард В (&Ломбард)) КАК ЛБ_КассовыеЛимитыСрезПоследних
		        |ГДЕ
		        |	ЛБ_КассовыеЛимитыСрезПоследних.Период >= &ДатаКон
		        |;
		        |
		        |////////////////////////////////////////////////////////////////////////////////
		        |ВЫБРАТЬ
		        |	СуммаЗаймов.Ломбард КАК Ломбард,
		        |	СуммаЗаймов.Сумма КАК СуммаВыданныхЗаймов,
		        |	ВЫБОР
		        |		КОГДА (ВЫРАЗИТЬ(КолРабДней.КоличествоРабочихДней / КолСнятий.КоличествоДнейСнятий КАК ЧИСЛО(15, 0))) > 7
		        |			ТОГДА 7
		        |		ИНАЧЕ ВЫРАЗИТЬ(КолРабДней.КоличествоРабочихДней / КолСнятий.КоличествоДнейСнятий КАК ЧИСЛО(15, 0))
		        |	КОНЕЦ КАК ПериодМеждуДнямиПолученияСредств,
		        |	СуммаЗаймов.Сумма / КолРабДней.КоличествоРабочихДней КАК СуммаЗаймовНаКоличествоРабочихДней
		        |ПОМЕСТИТЬ ПромежуточныеРассчеты
		        |ИЗ
		        |	СуммаЗаймов КАК СуммаЗаймов
		        |		ЛЕВОЕ СОЕДИНЕНИЕ КолСнятий КАК КолСнятий
		        |		ПО СуммаЗаймов.Ломбард = КолСнятий.Ломбард
		        |		ЛЕВОЕ СОЕДИНЕНИЕ КолРабДней КАК КолРабДней
		        |		ПО СуммаЗаймов.Ломбард = КолРабДней.Ломбард
		        |;
		        |
		        |////////////////////////////////////////////////////////////////////////////////
		        |ВЫБРАТЬ
		        |	Отделения.Отделение КАК Отделение,
		        |	СуммаЗаймов.Ломбард КАК Ломбард,
		        |	СуммаЗаймов.Ломбард.НомерЛомбарда КАК НомерЛомбарда,
		        |	СуммаЗаймов.Сумма КАК СуммаВыданныхЗаймов,
		        |	КолРабДней.КоличествоРабочихДней КАК КоличествоРабочихДней,
		        |	КолСнятий.КоличествоДнейСнятий КАК КоличествоДнейСнятий,
		        |	ПромежуточныеРассчеты.ПериодМеждуДнямиПолученияСредств КАК ПериодМеждуДнямиПолученияСредств,
		        |	ВЫРАЗИТЬ(ПромежуточныеРассчеты.СуммаЗаймовНаКоличествоРабочихДней * ПромежуточныеРассчеты.ПериодМеждуДнямиПолученияСредств КАК ЧИСЛО(15, 2)) КАК РассчетныйЛимит,
		        |	ВЫБОР
		        |		КОГДА ФактЛимит.ФактическийЛимит ЕСТЬ NULL
		        |			ТОГДА 0
		        |		ИНАЧЕ ФактЛимит.ФактическийЛимит
		        |	КОНЕЦ КАК ФактическийЛимит
		        |ИЗ
		        |	СуммаЗаймов КАК СуммаЗаймов
		        |		ЛЕВОЕ СОЕДИНЕНИЕ КолСнятий КАК КолСнятий
		        |		ПО СуммаЗаймов.Ломбард = КолСнятий.Ломбард
		        |		ЛЕВОЕ СОЕДИНЕНИЕ КолРабДней КАК КолРабДней
		        |		ПО СуммаЗаймов.Ломбард = КолРабДней.Ломбард
		        |		ЛЕВОЕ СОЕДИНЕНИЕ Отделения КАК Отделения
		        |		ПО СуммаЗаймов.Ломбард = Отделения.Ломбард
		        |		ЛЕВОЕ СОЕДИНЕНИЕ ФактЛимит КАК ФактЛимит
		        |		ПО СуммаЗаймов.Ломбард = ФактЛимит.Ломбард
		        |		ЛЕВОЕ СОЕДИНЕНИЕ ПромежуточныеРассчеты КАК ПромежуточныеРассчеты
		        |		ПО СуммаЗаймов.Ломбард = ПромежуточныеРассчеты.Ломбард
		        |
		        |УПОРЯДОЧИТЬ ПО
		        |	Отделения.Отделение.Наименование,
		        |	СуммаЗаймов.Ломбард.НомерЧисловой";
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокЛомбардов(Дата, Отделение)
	
	Условие = "";
	
	Если Отделение = Неопределено Тогда
		Условие = "НЕ Отделение.Наименование ПОДОБНО ""%Екатеринбург%""
			|				И НЕ Ломбард = ЗНАЧЕНИЕ(Справочник.ЛБ_Ломбарды.ЦентральныйОфис)";
	Иначе
		Условие = "Отделение В (&Отделение)";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			&Дата,"
		+ Символы.ПС + Условие + Символы.ПС
		+ "				И НЕ Ломбард.Закрыт
		|				И НЕ Ломбард.ПометкаУдаления) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		//|ГДЕ
		//|	НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЧисловой";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Отделение", Отделение);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	СписокВозврата = Новый СписокЗначений;
	
	Пока РезультатЗапроса.Следующий() Цикл
		СписокВозврата.Добавить(РезультатЗапроса.Ломбард);
	КонецЦикла;
	
	Возврат СписокВозврата;
	
КонецФункции

&НаСервере
Функция ПроверкаЧислаНаЧетность(ВходящееЧисло) Экспорт
   РезультатВычисления = ВходящееЧисло%2 = 0; //Четное = Истина
   Возврат РезультатВычисления; //Возвращает Булево
КонецФункции

&НаКлиенте
Процедура ОтделениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбора(Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбора(Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбора(Имя)
	ПараметрыФормы = новый структура;
	ПараметрыФормы.Вставить(Имя, Истина);
	ПараметрыФормы.Вставить("Дата", ?(Отчет.ДатаКон = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.ДатаКон)));
	
	Если Имя = "Отделение" Тогда
		ПараметрыФормы.Вставить("Список", Отчет.Отделение);
	Иначе
		ПараметрыФормы.Вставить("Список", Отчет.Ломбард);
	КонецЕсли;
	
	ОповещениеПослеВыборка = Новый ОписаниеОповещения("ПослеВыбораЗначений", ЭтаФорма); 
	ОткрытьФорму("Отчет.ЛБ_ОтчетРасчетКассовыхЛимитов.Форма.ФормаВыбораЗначений", ПараметрыФормы, Этаформа,,,,ОповещениеПослеВыборка,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗначений(РезультатВыбора, ДопПараметры) Экспорт
	Если РезультатВыбора <> Неопределено И РезультатВыбора.Количество() > 0 Тогда
		
 		СсылкаЕкт = ПолучитьСсылкуОтделения("Екатеринбург");
		Отчет.Отделение.Очистить();
		Отчет.Ломбард.Очистить();
		
		Если ТипЗнч(РезультатВыбора[0]) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			Для каждого Стр Из РезультатВыбора Цикл
				Если РезультатВыбора.Количество() > 1 И Стр = СсылкаЕкт Тогда
					Продолжить;
				Иначе
					Отчет.Отделение.Добавить(Стр);
				КонецЕсли;
			КонецЦикла;
			//Отчет.Отделение.ЗагрузитьЗначения(РезультатВыбора);
		Иначе
			ЕстьЦО = РезультатВыбора.Найти(ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис")) <> Неопределено;
			
			ДатаКон = ?(Отчет.ДатаКон = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.ДатаКон));
			
			ТолькоЕкт = ПроверитьСписокВыбора(ДатаКон, РезультатВыбора, СсылкаЕкт);
			
			ЛомбардыЕкт = Новый Массив;
			
			Если НЕ ТолькоЕкт Тогда
				ЛомбардыЕкт = ПолучитьСписокЛомбардовЕкт(ДатаКон, СсылкаЕкт);
			КонецЕсли;
			
			Для каждого Стр Из РезультатВыбора Цикл
				Если НЕ ТолькоЕкт ИЛИ ЕстьЦО Тогда
					Если НЕ ТолькоЕкт Тогда
						НайденныеСтроки = ЛомбардыЕкт.Найти(Стр);
					КонецЕсли;
					
					Если НайденныеСтроки <> Неопределено ИЛИ Стр = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис") Тогда
						Продолжить;
					Иначе
						Отчет.Ломбард.Добавить(Стр);
					КонецЕсли;
				Иначе
					Отчет.Ломбард.Добавить(Стр);
				КонецЕсли;
			КонецЦикла;
			//Отчет.Ломбард.ЗагрузитьЗначения(РезультатВыбора);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуОтделения(Текст)
	Возврат Справочники.ЛБ_ОтделенияЛомбардов.НайтиПоНаименованию(Текст)
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьСписокВыбора(Дата, ДанныеВыбора, ОтделениеЕкт)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			&Дата,
		|			Ломбард В (&Ломбард)
		|				И НЕ Ломбард.ПометкаУдаления) КАК ЛБ_ОтделенияЛомбардовСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", ДанныеВыбора);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса.Количество() = 1 И РезультатЗапроса.Найти(ОтделениеЕкт, "Отделение") <> Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокЛомбардовЕкт(Дата, Отделение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			&Дата,
		|			Отделение В (&Отделение)
		|				И НЕ Ломбард.ПометкаУдаления) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЛомбарда";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Отделение", Отделение);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ломбард");
	
КонецФункции

