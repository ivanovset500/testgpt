&НаСервере
Функция ПолучитьИнформациюДляКлиента(Статус, ТаблицаСК, ТаблицаРезультат)
	Если Статус = неопределено тогда
		Возврат "";
	КонецЕсли;    
	Если ТаблицаСК.Количество() = 0 Тогда
	    Возврат "Для повышения статуса необходимо выкупить 3 ЗБ с видом займа, участвующем в расчетах по системе лояльности"; 
	КонецЕсли;	
	ТаблицаСК.Колонки.Добавить("Количество");
	ТаблицаСК.ЗаполнитьЗначения(0, "Количество"); 
	ДобавитьКорректировкаПонижения = 0;
	 
	Для каждого СтрК Из ТаблицаСК Цикл  
		Если стрК.РасчетВсего = 0 Тогда
			Продолжить;
		КонецЕсли;	
		РасчетВсего = стрК.РасчетВсего;
		Отбор = Новый Структура;
		Отбор.Вставить("СхемаКредитования", СтрК.СхемаКредитования);
		Отбор.Вставить("Уровень", 2);//повышает уровень
		Строки = ТаблицаРезультат.НайтиСтроки(Отбор); 
		Если Строки.Количество() = 0 Тогда  
			Количество = 0;
		Иначе
			Количество = Строки.Получить(0).Количество;
		КонецЕсли; 
		//+МАН 23.01.25 Для дальнейшего сравнения. Заявка 2956.
		КоличествоУр2 = Количество;
		//-МАН
		Отбор.Вставить("Уровень", 1); //понижает   
		ДобавитьКорректировкаПонижения = 0;
		Строки = ТаблицаРезультат.НайтиСтроки(Отбор); 
		Если НЕ Строки.Количество() = 0 Тогда 
			ДобавитьКорректировкаПонижения = Строки.Получить(0).Количество;
			Количество = Количество + ДобавитьКорректировкаПонижения;
			РасчетВсего = РасчетВсего + ДобавитьКорректировкаПонижения; 
			Если (Статус = Справочники.ЛБ_СтатусыЗалогодателей.Добросовестный) И (Количество >= 5) И (Количество/РасчетВсего*100 >= 90) Тогда   
				Возврат "Для повышения статуса необходимо выкупить " + Строка(ДобавитьКорректировкаПонижения) + " ЗБ " + СокрЛП(СтрК.СхемаКредитования);
			ИначеЕсли НЕ (Статус = Справочники.ЛБ_СтатусыЗалогодателей.Добросовестный) И (Количество/РасчетВсего*100 >= 70) Тогда
				Возврат "Для повышения статуса необходимо выкупить " + Строка(ДобавитьКорректировкаПонижения) + " ЗБ " + СокрЛП(СтрК.СхемаКредитования);
			КонецЕсли;	
		КонецЕсли;   
		КолДобавить = 1; 
		РасчетВсего = РасчетВсего + КолДобавить;
		Количество = Количество + КолДобавить;
		Пока Истина Цикл 
			Если Количество/РасчетВсего*100 < 70 Тогда 
				КолДобавить = КолДобавить + 1;
				РасчетВсего = РасчетВсего + 1;  
				Количество = Количество + 1;
			Иначе  
				Если (Статус = Справочники.ЛБ_СтатусыЗалогодателей.Добросовестный) Тогда  
					Если Количество < 5 Тогда
						КолДобавить = КолДобавить + 1;
					    РасчетВсего = РасчетВсего + 1;  
					    Количество = Количество + 1;
						Продолжить;  
					ИначеЕсли Количество/РасчетВсего*100 < 90 Тогда 
						КолДобавить = КолДобавить + 1;
					    РасчетВсего = РасчетВсего + 1;  
					    Количество = Количество + 1;
						Продолжить; 
					КонецЕсли;	
				КонецЕсли;
				//+МАН 23.01.25 Проверяем новый или нет и сколько ЗБ. Заявка 2956.
				//Было:
				//СтрК.Количество = КолДобавить;
				//Прервать;
				//
				Если Статус = Справочники.ЛБ_СтатусыЗалогодателей.Новый И КоличествоУр2 = 1 Тогда
					СтрК.Количество = 2;
					Прервать;
				Иначе
					СтрК.Количество = КолДобавить;
					Прервать;
				КонецЕсли;
				//-МАН
			КонецЕсли;	
		КонецЦикла	 
    КонецЦикла;		 
	
	ТаблицаСК.Сортировать("Количество Возр"); 
	СтрК = ТаблицаСК.Получить(0);  
	СтрК.Количество = СтрК.Количество + ДобавитьКорректировкаПонижения;
	СтрК.Количество = ?(СтрК.Количество = 0, 3, СтрК.Количество);
	//+Мельников 16.07.24 Если количество ЗБ для повышения статуса больше 10 то ни чего не выводим. Заявка 2657
	//Добавил условие. Первоначальный "Возврат" после "Иначе".
	Если СтрК.Количество > 10 Тогда
		Возврат "";
	Иначе
	//-Мельников
		Возврат "Для повышения статуса необходимо выкупить " + Строка(СтрК.Количество) + " ЗБ " + СокрЛП(СтрК.СхемаКредитования);
	КонецЕсли;
КонецФункции	

&НаКлиенте
Процедура КлиентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь; 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Дата", Отчет.Дата);	
    ПараметрыФормы.Вставить("БезДокументов", истина);
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Отчет.Клиент);
	КонецЕсли;		
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораКлиента",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКлиента(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	Отчет.Клиент = Результат.Залогодатель;
КонецПроцедуры 

&НаКлиенте
Процедура Отбор(Команда)
	Если Элементы.ГруппаБыстрыеОтборы.Видимость Тогда 
		Элементы.ГруппаБыстрыеОтборы.Видимость = Ложь;
		Элементы.Отбор.ЦветФона = WebЦвета.Белый;
	Иначе 
		Элементы.ГруппаБыстрыеОтборы.Видимость = Истина;
		Элементы.Отбор.ЦветФона = WebЦвета.БледноЗеленый;
	КонецЕсли;	
КонецПроцедуры




