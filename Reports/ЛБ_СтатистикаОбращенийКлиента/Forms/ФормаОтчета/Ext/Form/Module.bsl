&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Клиент") Тогда
		Отчет.Клиент = Параметры.Клиент;		
	КонецЕсли; 
	Если Параметры.Свойство("Дата") Тогда
		Отчет.Дата = Параметры.Дата;    
	Иначе
		Отчет.Дата = ТекущаяДатаСеанса();
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда
		Элементы.ГруппаБыстрыеОтборы.Видимость = ложь;  
		Элементы.Отбор.ЦветФона = WebЦвета.Белый;
		СформироватьНаСервере(); 
	Иначе
		Элементы.Отбор.ЦветФона = WebЦвета.БледноЗеленый;
	КонецЕсли;	
 КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	Если НЕ ЗначениеЗаполнено(Отчет.Клиент) Тогда
		Сообщить("Не выбран клиент!");
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Функция ПроверитьУчастиеСКВРасчетах(Дата, СхемаКредитования, ТаблицаУчастие)
	Отбор = Новый Структура;
	Отбор.Вставить("СхемаКредитования", СхемаКредитования);
	СтрокиУ = ТаблицаУчастие.НайтиСтроки(Отбор);
	Участвует = Ложь;
	Для каждого СтрУ из СтрокиУ Цикл
		Если СтрУ.Период > Дата Тогда
			Прервать;
		КонецЕсли;	 
		Участвует = СтрУ.Участвует;	
	КонецЦикла;	
	Возврат Участвует;
КонецФункции	

Функция ВыбратьДокументыПочетный(Описание) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Отчет.Дата);  
	Запрос.УстановитьПараметр("Владелец", Отчет.Клиент);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателей.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателей.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателей.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателей.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателей.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателей.ДокументСрокДействия КАК ДокументСрокДействия
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей КАК ЛБ_ДокументыЗалогодателей
	               |ГДЕ
	               |	ЛБ_ДокументыЗалогодателей.Период <= &Дата
	               |	И ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя.Владелец = &Владелец
	               |	И ЛБ_ДокументыЗалогодателей.ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент)
	               |	И ЛБ_ДокументыЗалогодателей.ДокументНеДействителен = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ДокументыЗалогодателей.Период УБЫВ";
	ДокументыЗалогодателя = Запрос.Выполнить().Выгрузить();
	
	Запрос.УстановитьПараметр("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл   
		СтатусЛояльности = ЛБ_УправлениеЛомбардом.ПолучитьСтатусПоСистемеЛояльности(Отчет.Дата, Выборка.статус);
		Если НЕ СтатусЛояльности = Справочники.ЛБ_СтатусыЗалогодателей.Почетный Тогда  
			Продолжить;
		КонецЕсли;	

		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		
		СтрокиД = ДокументыЗалогодателя.НайтиСтроки(Отбор); 
		Для сч = 0 По СтрокиД.Количество()-1 Цикл			
			СтрД = строкиД.Получить(сч);  
			Если НЕ (СтрД.ДокументСрокДействия = Дата(1,1,1)) Тогда
				Если СтрД.ДокументСрокДействия < НачалоДня(Отчет.Дата) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;    
			Описание = Описание + ?(ПустаяСтрока(Описание), "", Символы.ПС);    
			Описание = Описание + "наличие в карточке клиента документа " + СокрЛП(Выборка.ВидДокумента);
			Прервать;
		КонецЦикла;
	Конеццикла;	
    Возврат Описание;
КонецФункции

&НаСервере
Процедура СформироватьНаСервере()	
	ДокументРезультат.Очистить();   
	ДатаОтчета = ?(Отчет.Дата = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.Дата)); 
	ФИО = "";
	ДатаРождения = "";
	УровеньРиска = "";
	ДатаНачалаРаботы = "";
		
	Запрос = Новый Запрос;	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльности.Период КАК Период,
	              |	ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльности.СхемаКредитования КАК СхемаКредитования,
	              |	ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльности.Участвует КАК Участвует
	              |ИЗ
	              |	РегистрСведений.ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльности КАК ЛБ_УчастиеВРасчетеСтатусовПоСистемеЛояльности
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Период";
	ТаблицаУчастие = Запрос.Выполнить().Выгрузить();
		
	Запрос.УстановитьПараметр("Дата", ДатаОтчета);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГруппыСхемКредитованияСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_ГруппыСхемКредитованияСрезПоследних.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.ЛБ_ГруппыСхемКредитования.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыСхемКредитованияСрезПоследних";
	ТаблицаГруппыСК = Запрос.Выполнить().Выгрузить(); 
		
	Запрос.УстановитьПараметр("Клиент", Отчет.Клиент);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	              |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	              |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	              |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	              |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол
	              |ИЗ
	              |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ФИО = СокрЛП(Выборка.Фамилия) + " " + СокрЛП(Выборка.Имя) + ?(НЕ ПустаяСтрока(Выборка.Отчество), " " + СокрЛП(Выборка.Отчество), "");
		ДатаРождения = Выборка.ДатаРождения; 
		Пол = Выборка.Пол;
	КонецЕсли;	
	
	//+МАН 03.03.25 Изменил запрос, чтобы корректно учитывался статус ВИП. Заявка 2792
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	//               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.СрокДействия КАК СрокДействия,
	//               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется,
	//               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Комментарий КАК Комментарий
	//               |ИЗ
	//               |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних";
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.СрокДействия КАК СрокДействия,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Комментарий КАК Комментарий,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Клиент
	               |				И ВЫБОР
	               |					КОГДА СрокДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |						ТОГДА ИСТИНА
	               |					КОГДА ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(СрокДействия, ДЕНЬ), СЕКУНДА, 1) >= &Дата
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ЛОЖЬ
	               |				КОНЕЦ) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Статус КАК Статус,
	               |	ВТ.СрокДействия КАК СрокДействия,
	               |	ВТ.Используется КАК Используется,
	               |	ВТ.Комментарий КАК Комментарий,
	               |	ВТ.Регистратор КАК Регистратор
	               |ИЗ
	               |	ВТ КАК ВТ
	               |ГДЕ
	               |	НЕ ВТ.Регистратор В
	               |				(ВЫБРАТЬ
	               |					ЛБ_ПриказИндивидуальныеУсловия.ОтменяемыйПриказ КАК ОтменяемыйПриказ
	               |				ИЗ
	               |					Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
	               |				ГДЕ
	               |					НЕ ЛБ_ПриказИндивидуальныеУсловия.ПометкаУдаления
	               |					И ЛБ_ПриказИндивидуальныеУсловия.Проведен
	               |					И ЛБ_ПриказИндивидуальныеУсловия.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
	               |					И ЛБ_ПриказИндивидуальныеУсловия.Залогодатели.Залогодатель = &Клиент)";
	
	//-МАН
	ТаблицаСтатусовКлиентаДоп = Запрос.Выполнить().Выгрузить(); 
	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_АнкетаЗалогодателяСрезПоследних.УровеньРиска КАК УровеньРиска,
	              |	ЛБ_АнкетаЗалогодателяСрезПоследних.ДатаОформленияАнкеты КАК ДатаОформленияАнкеты
	              |ИЗ
	              |	РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_АнкетаЗалогодателяСрезПоследних"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		УровеньРиска = СокрЛП(Выборка.УровеньРиска); 
		ДатаНачалаРаботы = Формат(Выборка.ДатаОформленияАнкеты, "ДЛФ=DD");
	КонецЕсли;    
	
	Статус = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДатаОтчета, Отчет.Клиент);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("СхемаКредитования");
	ТаблицаРезультат.Колонки.Добавить("Уровень"); //2-повышение статуса, 1-понижение статуса, 0-нейтральные
	ТаблицаРезультат.Колонки.Добавить("УчастиеВРасчетах");
	ТаблицаРезультат.Колонки.Добавить("Количество");  	
	КолБилетовВсего = 0; 
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.Период КАК Период,
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоВыкуплено КАК КоличествоВыкуплено,
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоОтгружено КАК КоличествоОтгружено,
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоИзъято КАК КоличествоИзъято,
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.КоличествоОХ КАК КоличествоОХ
	               |ИЗ
	               |	РегистрСведений.ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса КАК ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса
	               |ГДЕ
	               |	ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.Клиент = &Клиент
	               |	И ЛБ_АрхивныеДанныеКлиентовДляОпределенияСтатуса.Период <= &Дата";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Для каждого стр из ТаблицаЗапроса Цикл     
		ОтборГ = Новый Структура;
		ОтборГ.Вставить("СхемаКредитования", Стр.СхемаКредитования); 
		СтрокиГ = ТаблицаГруппыСК.НайтиСтроки(ОтборГ);
		Если НЕ СтрокиГ.Количество() = 0 тогда 
			ТекущаяСхемаКредитования = СтрокиГ.Получить(0).Группа;
		Иначе
			ТекущаяСхемаКредитования = Стр.СхемаКредитования;
		КонецЕсли; 
		УчастиеВРасчетах = ПроверитьУчастиеСКВРасчетах(Стр.Период, Стр.СхемаКредитования, ТаблицаУчастие);
            
		Если НЕ (стр.КоличествоВыкуплено + стр.КоличествоОХ) = 0  Тогда
		   	НоваяСтр = ТаблицаРезультат.Добавить(); 
			НоваяСтр.СхемаКредитования = ТекущаяСхемаКредитования;
		    НоваяСтр.УчастиеВРасчетах = УчастиеВРасчетах; 
			НоваяСтр.Уровень = ?(УчастиеВРасчетах, 2, 0);  
			НоваяСтр.Количество = стр.КоличествоВыкуплено  + стр.КоличествоОХ; 
			КолБилетовВсего = КолБилетовВсего + НоваяСтр.Количество; 
		КонецЕсли;	
		Если НЕ (стр.КоличествоОтгружено + стр.КоличествоИзъято) = 0  Тогда
			НоваяСтр = ТаблицаРезультат.Добавить(); 
			НоваяСтр.СхемаКредитования = ТекущаяСхемаКредитования;
		    НоваяСтр.УчастиеВРасчетах = УчастиеВРасчетах; 
			НоваяСтр.Уровень = ?(УчастиеВРасчетах, 1, 0);  
			НоваяСтр.Количество = стр.КоличествоОтгружено + стр.КоличествоИзъято;
            КолБилетовВсего = КолБилетовВсего + НоваяСтр.Количество;
		КонецЕсли;	
	Конеццикла;	             

	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ЛБ_АрхивныеДанныеКлиента.Период КАК Период,
	//               |	ЛБ_АрхивныеДанныеКлиента.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
	//               |	ЛБ_АрхивныеДанныеКлиента.СхемаКредитования КАК СхемаКредитования,
	//               |	ЛБ_АрхивныеДанныеКлиента.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
	//               |ИЗ
	//               |	РегистрСведений.ЛБ_АрхивныеДанныеКлиента КАК ЛБ_АрхивныеДанныеКлиента
	//               |ГДЕ
	//               |	ЛБ_АрхивныеДанныеКлиента.Период <= &Дата
	//               |	И ЛБ_АрхивныеДанныеКлиента.Клиент = &Клиент";
	//ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	//Для каждого стр из ТаблицаЗапроса Цикл  
	//	КолБилетовВсего = КолБилетовВсего + 1;
	//	НоваяСтр = ТаблицаРезультат.Добавить(); 
	//	ОтборГ = Новый Структура;
