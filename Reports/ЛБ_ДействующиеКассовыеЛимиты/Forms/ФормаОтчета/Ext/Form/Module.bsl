&НаСервере
Процедура СформироватьНаСервере()
	Результат.Очистить();  
	
	//ДатаНач = НачалоДня(Отчет.ДатаНач);
	//ДатаНач = ?(Отчет.ДатаНач = Дата(1,1,1), НачалоДня(ТекущаяДата()), НачалоДня(Отчет.ДатаНач));
	ДатаКон = ?(Отчет.ДатаКон = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(Отчет.ДатаКон));
	
	Результат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ДействующиеЛимиты";
	
	//НеЕктИлиЦО = Отчет.Ломбард <> Справочники.ЛБ_Ломбарды.ЦентральныйОфис ИЛИ СтрНайти(Отчет.Отделение.Наименование, "Екатеринбург") = 0;
	//ЕктИлиЦО = Отчет.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис
	//	ИЛИ Отчет.Отделение.НайтиПоЗначению(Справочники.ЛБ_ОтделенияЛомбардов.НайтиПоНаименованию("Екатеринбург")) <> Неопределено;
	//
	//Если НЕ ЕктИлиЦО Тогда
		Макет = Отчет.РеквизитМакет;
	//Иначе
	//	Макет = Отчет.РеквизитМакетЕкт;
	//КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	//Если ПериодОтчета Тогда
	//	ПериодОтчетаТекст = "период с " + Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаКон, "ДФ=dd.MM.yyyy");
	//Иначе
		ПериодОтчетаТекст = "на " + Формат(ДатаКон, "ДФ=dd.MM.yyyy");
	//КонецЕсли;
	
	ОбластьШапка.Параметры.Период = ПериодОтчетаТекст;
	Результат.Вывести(ОбластьШапка);
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Результат.Вывести(ОбластьЗаголовок);
	
	Запрос = Новый Запрос;
	
	//Если ПериодОтчета Тогда
	//	Запрос.Текст = "ВЫБРАТЬ
	//	               |	ЛБ_КассовыеЛимиты.Отделение КАК Отделение,
	//	               |	ЛБ_КассовыеЛимиты.Ломбард КАК Ломбард,
	//	               |	ЛБ_КассовыеЛимиты.РассчетныйЛимит КАК РассчетныйЛимит,
	//	               |	ЛБ_КассовыеЛимиты.ФактическийЛимит КАК ФактическийЛимит,
	//	               |	ЛБ_КассовыеЛимиты.Ломбард.НомерЛомбарда КАК НомерЛомбарда
	//	               |ИЗ
	//	               |	РегистрСведений.ЛБ_КассовыеЛимиты КАК ЛБ_КассовыеЛимиты
	//	               |ГДЕ
	//	               |	ЛБ_КассовыеЛимиты.Период МЕЖДУ &ДатаНач И &ДатаКон
	//	               |	И ЛБ_КассовыеЛимиты.Ломбард В(&Ломбард)
	//	               |
	//	               |УПОРЯДОЧИТЬ ПО
	//	               |	ЛБ_КассовыеЛимиты.Отделение.Наименование,
	//	               |	ЛБ_КассовыеЛимиты.Ломбард.НомерЧисловой";
	//Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_КассовыеЛимитыСрезПоследних.Отделение КАК Отделение,
		               |	ЛБ_КассовыеЛимитыСрезПоследних.Ломбард КАК Ломбард,
		               |	ЛБ_КассовыеЛимитыСрезПоследних.РассчетныйЛимит КАК РассчетныйЛимит,
		               |	ЛБ_КассовыеЛимитыСрезПоследних.ФактическийЛимит КАК ФактическийЛимит,
		               |	ЛБ_КассовыеЛимитыСрезПоследних.Ломбард.НомерЛомбарда КАК НомерЛомбарда
		               |ИЗ
		               |	РегистрСведений.ЛБ_КассовыеЛимиты.СрезПоследних(&ДатаКон, Ломбард В (&Ломбард)) КАК ЛБ_КассовыеЛимитыСрезПоследних
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЛБ_КассовыеЛимитыСрезПоследних.Отделение.Наименование,
		               |	ЛБ_КассовыеЛимитыСрезПоследних.Ломбард.НомерЧисловой";
	//КонецЕсли;
	
	//Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);

	Если ЗначениеЗаполнено(Отчет.Ломбард) Тогда
		Запрос.УстановитьПараметр("Ломбард", Отчет.Ломбард);
	Иначе
		Запрос.УстановитьПараметр("Ломбард", ПолучитьСписокЛомбардов(ДатаКон, ?(ЗначениеЗаполнено(Отчет.Отделение), Отчет.Отделение.ВыгрузитьЗначения(), Неопределено)));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Нпп = 0;
	Для каждого Стр Из РезультатЗапроса Цикл
		Если ПроверкаЧислаНаЧетность(Нпп) Тогда
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаЧет");
		Иначе
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаНечет");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Стр);
		Результат.Вывести(ОбластьСтрока);
		Нпп = Нпп + 1;
	КонецЦикла;

	ОбластьИтого = Макет.ПолучитьОбласть("Итого");
	ОбластьИтого.Параметры.ИтогоРассчетныйЛимит = РезультатЗапроса.Итог("РассчетныйЛимит");
	ОбластьИтого.Параметры.ИтогоФактическийЛимит = РезультатЗапроса.Итог("ФактическийЛимит");
	
	Результат.Вывести(ОбластьИтого);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокЛомбардов(Дата, Отделение)
	
	Условие = "";
	
	Если Отделение = Неопределено Тогда
	//	Условие = "НЕ Отделение.Наименование ПОДОБНО ""%Екатеринбург%""
	//		|				И НЕ Ломбард = ЗНАЧЕНИЕ(Справочник.ЛБ_Ломбарды.ЦентральныйОфис)";
		Условие = "НЕ Ломбард.Закрыт";
	Иначе
		Условие = "Отделение В (&Отделение)
				|				И НЕ Ломбард.Закрыт";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			&Дата,"
		+ Символы.ПС + Условие + Символы.ПС
		+ "				И НЕ Ломбард.ПометкаУдаления) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЧисловой";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Отделение", Отделение);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	СписокВозврата = Новый СписокЗначений;
	
	Пока РезультатЗапроса.Следующий() Цикл
		СписокВозврата.Добавить(РезультатЗапроса.Ломбард);
	КонецЦикла;
	
	Возврат СписокВозврата;
	
КонецФункции

&НаСервере
Функция ПроверкаЧислаНаЧетность(ВходящееЧисло) Экспорт
   РезультатВычисления = ВходящееЧисло%2 = 0; //Четное = Истина
   Возврат РезультатВычисления; //Возвращает Булево
КонецФункции

