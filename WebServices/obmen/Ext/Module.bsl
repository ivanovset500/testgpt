Функция GetReport(Param)      
	ОтветСервиса = "400";
	
	
	ДанныеОбмена = ЗначениеИзСтрокиВнутр(Param);  
	
	СтруктураРеквизитов = ДанныеОбмена.СтруктураОсновныхРеквизитов; 
	
	Если СтруктураРеквизитов.ТипСсылки = "ФизическоеЛицо" Тогда
		
		GUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid);  				
		Ссылка = Справочники.ФизическиеЛица.ПолучитьСсылку(GUID);
		
		Об = Ссылка.ПолучитьОбъект();
		Если Об = Неопределено Тогда  						
			НовОб = Справочники.ФизическиеЛица.СоздатьЭлемент();
			НовОб.УстановитьСсылкуНового(Ссылка);
		Иначе
			НовОб = Об; 
		КонецЕсли; 
		
		НовОб.ДатаРождения 					= СтруктураРеквизитов.ДатаРождения;
		НовОб.Наименование 					= СтруктураРеквизитов.ФИО;
		НовОб.ИНН 							= СтруктураРеквизитов.ИНН;  
		НовОб.Фамилия 						= СтруктураРеквизитов.Фамилия;
		НовОб.Имя 							= СтруктураРеквизитов.Имя;
		НовОб.Отчество 						= СтруктураРеквизитов.Отчество;
		НовОб.Инициалы 						= СтруктураРеквизитов.Инициалы;
		
		НовОб.СерияДокумента                = СтрЗаменить(СтруктураРеквизитов.ДокументСерия," ","");
		НовОб.НомерДокумента                = СтруктураРеквизитов.ДокументНомер;
		НовОб.КемВыданДокумент              = СтруктураРеквизитов.ДокументКемВыдан;
		НовОб.КодПодразделенияДокумента     = СтруктураРеквизитов.ДокументКодПодразделения;
		НовОб.ДатаВыдачиДокумента           = СтруктураРеквизитов.ДокументДатаВыдачи;
		
		
		ОтветСервиса = "200";
		Попытка 		
			НовОб.Записать();
		Исключение
			ОтветСервиса = "Ошибка при записи физлица";
		КонецПопытки;   
		
		Если ОтветСервиса = "200" Тогда
			СтруктураФио = ДанныеОбмена.СтруктураФИО;		
			тзФио = СтруктураФио.тзФио;
			
			НаборЗаписей = РегистрыСведений.ЛБ_ФИОФизическихЛиц.СоздатьНаборЗаписей();		
			НаборЗаписей.Отбор.ФизическоеЛицо.Установить(НовОб.Ссылка);
			
			Для каждого строч из тзФио Цикл 				
				НоваяЗапись 				= НаборЗаписей.Добавить();
				НоваяЗапись.Период   		= строч.Период;
				НоваяЗапись.ФизическоеЛицо  = НовОб.Ссылка; 
				НоваяЗапись.Фамилия 	    = строч.Фамилия;
				НоваяЗапись.Имя 			= строч.Имя; 
				НоваяЗапись.Отчество 		= строч.Отчество;
				НоваяЗапись.Инициалы 		= строч.Инициалы;
				НоваяЗапись.ФИОСлужебные = СокрЛП(строч.Фамилия) + " "+СокрЛП(строч.Имя)+" "+СОкрЛП(строч.Отчество);
			КонецЦикла;	
			НаборЗаписей.Записать(); 
         КонецЕсли;	
		
	ИначеЕсли СтруктураРеквизитов.ТипСсылки = "Сотрудник" Тогда
		
		GUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid);  				
		Ссылка = Справочники.ЛБ_Сотрудники.ПолучитьСсылку(GUID);
		
		Об = Ссылка.ПолучитьОбъект();
		Если Об = Неопределено Тогда
			НовОб = Справочники.ЛБ_Сотрудники.СоздатьЭлемент();
			НовОб.УстановитьСсылкуНового(Ссылка); 
			НовОб.Код = СтруктураРеквизитов.Код;
		Иначе
			НовОб = Об; 
		КонецЕсли; 

		НовОб.Наименование 					= СтруктураРеквизитов.Наименование;
		
		guid_Физлицо = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid_Физлицо);  				
		СсылкаФизЛ = Справочники.ФизическиеЛица.ПолучитьСсылку(guid_Физлицо);
		
		ФизЛицо = СсылкаФизЛ.ПолучитьОбъект();
		Если ФизЛицо = Неопределено Тогда  						

		Иначе
			НовОб.ФизическоеЛицо = СсылкаФизЛ; 
		КонецЕсли;
		
		Если СтруктураРеквизитов.guid_Должность <> "0" Тогда
			guid_Должность = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid_Должность);  				
			СсылкаДолжность = Справочники.Должности.ПолучитьСсылку(guid_Должность);
			
			Должность = СсылкаДолжность.ПолучитьОбъект();
			Если Должность = Неопределено Тогда  						
				
			Иначе
				НовОб.Должность = СсылкаДолжность; 
			КонецЕсли;
		КонецЕсли; 
		НовОб.ДатаПриема = СтруктураРеквизитов.ДатаПриема; 
		НовОб.ДатаУвольнения = СтруктураРеквизитов.ДатаУвольнения;
		
		ОтветСервиса = "200";
		Попытка 		
			НовОб.Записать();
		Исключение
			ОтветСервиса = "Ошибка при записи сотрудника";
		КонецПопытки;  
		
		Если ОтветСервиса = "200" Тогда
			СтруктураТзСост = ДанныеОбмена.СтруктураСостояния;		
			тзСост = СтруктураТзСост.тзСост;
			
			НаборЗаписей = РегистрыСведений.ЛБ_СостоянияСотрудников.СоздатьНаборЗаписей();		
			НаборЗаписей.Отбор.Сотрудник.Установить(НовОб.Ссылка);
			
			Для каждого строч из тзСост Цикл 				
				НоваяЗапись 			= НаборЗаписей.Добавить(); 
				НоваяЗапись.Сотрудник   = НовОб.Ссылка; 
				НоваяЗапись.Год 	    = строч.Год;
				НоваяЗапись.Период 		= строч.Период; 
				НоваяЗапись.ДействуетДо = строч.ДействуетДо;
				сост = Перечисления.ЛБ_СостоянияСотрудника[строч.Состояние];
				НоваяЗапись.Состояние   = сост;    
				НоваяЗапись.ВидВремени  = ВернутьВидВремениСостояния(сост);
				НоваяЗапись.ДокументОснование = строч.ДокументОснование;
			КонецЦикла;	
			НаборЗаписей.Записать();   
			
			СтруктураТзКадр = ДанныеОбмена.СтруктураКадровойИстории;		
			тзКадроваяИсторияСотрудников = СтруктураТзКадр.тзКадроваяИсторияСотрудников;
			
			НаборЗаписей = РегистрыСведений.ЛБ_КадроваяИсторияСотрудников.СоздатьНаборЗаписей();		
			НаборЗаписей.Отбор.Сотрудник.Установить(НовОб.Ссылка);
			
			Для каждого строч из тзКадроваяИсторияСотрудников Цикл 				
				НоваяЗапись 			= НаборЗаписей.Добавить(); 
				НоваяЗапись.Сотрудник   = НовОб.Ссылка; 
				
				НоваяЗапись.Период 		  = строч.Период; 
				Если строч.Администрация Тогда
					
					НоваяЗапись.Подразделение  = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
				Иначе	
					
					
					Если ЗначениеЗаполнено(строч.idLX_Подразделение) Тогда
						СсылкаПодразделение = ВернутьЛомбардПоИД(строч.idLX_Подразделение); 
						Если СсылкаПодразделение <> Неопределено Тогда
							НоваяЗапись.Подразделение = СсылкаПодразделение;
						КонецЕсли; 
					Иначе 
						СсылкаПодразделение = Справочники.ЛБ_Ломбарды.НайтиПоНаименованию(строч.НаимПодразделение);
						Если СсылкаПодразделение <> справочники.ЛБ_Ломбарды.ПустаяСсылка() Тогда
							НоваяЗапись.Подразделение = СсылкаПодразделение;
						КонецЕсли; 				
					КонецЕсли;  
				КонецЕсли;

				
				Если строч.guid_Должность <> "0" Тогда
					guid_Должность = Новый УникальныйИдентификатор(строч.guid_Должность);  				
					СсылкаДолжность = Справочники.Должности.ПолучитьСсылку(guid_Должность);
					
					Должность = СсылкаДолжность.ПолучитьОбъект();
					Если Должность = Неопределено Тогда  						
						
					Иначе
						НоваяЗапись.Должность = СсылкаДолжность; 
					КонецЕсли;
				КонецЕсли;

				ВидСобытия = Перечисления.ЛБ_ВидыКадровыхСобытий[строч.ВидСобытияСтр];
				НоваяЗапись.ВидСобытия   = ВидСобытия;
			
			КонецЦикла;	
			НаборЗаписей.Записать(); 

		КонецЕсли;

	ИначеЕсли СтруктураРеквизитов.ТипСсылки = "Должность" Тогда
		
		GUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid);  				
		Ссылка = Справочники.Должности.ПолучитьСсылку(GUID);
		
		Об = Ссылка.ПолучитьОбъект();
		Если Об = Неопределено Тогда  						
			НовОб = Справочники.Должности.СоздатьЭлемент();
			НовОб.УстановитьСсылкуНового(Ссылка);
		Иначе
			НовОб = Об; 
		КонецЕсли; 
		
		Наим = СтруктураРеквизитов.Наименование; 
		
		НовОб.Наименование 					= Наим; 
		
		нНаим = нрег(Наим);
		
		Если (СтрНайти(нНаим, "начальник") > 0) и (СтрНайти(нНаим, "отделения") > 0) и (СтрНайти(нНаим, "заместит") = 0) Тогда
			НовОб.ЯвляетсяНачальникомОтделения = Истина;			
		КонецЕсли;
		Если (СтрНайти(нНаим, "начальник") > 0) и (СтрНайти(нНаим, "отделения") > 0) и (СтрНайти(нНаим, "заместитель") > 0) Тогда
			НовОб.ЯвляетсяЗаместителемНачальникаОтделения = Истина;			
		КонецЕсли; 
		Если (СтрНайти(нНаим, "управляющий") > 0) и (СтрНайти(нНаим, "ломбард") > 0) Тогда
			НовОб.ЯвляетсяУправляющимЛомбарда = Истина;			
		КонецЕсли;

		
		ОтветСервиса = "200";
		Попытка 		
			НовОб.Записать();
		Исключение
			ОтветСервиса = "Ошибка при записи должности";
		КонецПопытки; 
		
		
	ИначеЕсли СтруктураРеквизитов.ТипСсылки = "Пользователь" Тогда
		ПараметрыПольз = Новый Структура;
		ПараметрыПольз.Вставить("ИмяПользователя",  		СтруктураРеквизитов.ИмяПользователя);  
		ПараметрыПольз.Вставить("ИмяВходаПользователя",  	СтруктураРеквизитов.ИмяВходаПользователя);
		ПараметрыПольз.Вставить("Пароль",  					СтруктураРеквизитов.Пароль);
		ПараметрыПольз.Вставить("ИмяПрофиля",  				СтруктураРеквизитов.ИмяПрофиля);
		ПараметрыПольз.Вставить("guid_Физлица",  			СтруктураРеквизитов.guid_Физлица);
		
		ЛБ_ОбменLX.СоздатьПользователя(ПараметрыПольз);
		ОтветСервиса = "200";  
		
	ИначеЕсли СтруктураРеквизитов.ТипСсылки = "Подразделение" Тогда
		
		//GUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid);  				
		//Ссылка = Справочники.ЛБ_Ломбарды.ПолучитьСсылку(GUID);
		//
		//Об = Ссылка.ПолучитьОбъект();
		//Если Об = Неопределено Тогда  						
		//	НовОб = Справочники.ЛБ_Ломбарды.СоздатьЭлемент();
		//	НовОб.УстановитьСсылкуНового(Ссылка);
		//Иначе
		//	НовОб = Об; 
		//КонецЕсли; 
		//
		//Если ЗначениеЗаполнено(НовОб.НомерЛомбарда) Тогда
		//	НовОб.Наименование 					= НовОб.НомерЛомбарда;
		//Иначе
		//	НовОб.Наименование 					= СтруктураРеквизитов.Наименование;

		//КонецЕсли;
		//НовОб.НаименованиеПолное            = СтруктураРеквизитов.Наименование;
		//
		//Если СтруктураРеквизитов.guid_Родителя <> "нет" Тогда 
		//	GUIDРодителя = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid_Родителя);  				
		//	СсылкаРодитель = Справочники.ЛБ_Ломбарды.ПолучитьСсылку(GUIDРодителя); 
		//	
		//	ОбРодитель = СсылкаРодитель.ПолучитьОбъект();
		//	Если Об <> Неопределено Тогда  						
		//		НовОб.Родитель = СсылкаРодитель;
		//	КонецЕсли;
		//КонецЕсли;	
		//	
		//ОтветСервиса = "200";
		//Попытка 		
		//	НовОб.Записать();
		//Исключение
		//	ОтветСервиса = "Ошибка при записи ломбарда";
		//КонецПопытки;    
		
	ИначеЕсли СтруктураРеквизитов.ТипСсылки = "ПриемНаРаботу" Тогда
		ОтветСервиса = ЗагрузитьПриемНаРаботу(СтруктураРеквизитов);			
