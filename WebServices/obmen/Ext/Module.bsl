Функция ВернутьЛомбардПоИД(id_LX) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Ломбарды.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_Ломбарды КАК ЛБ_Ломбарды
	               |ГДЕ
	               |	ЛБ_Ломбарды.id_LX = &id_LX";
	Запрос.УстановитьПараметр("id_LX",id_LX);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ВернутьВидВремениСостояния(сост)
	Если сост = Перечисления.ЛБ_СостоянияСотрудника.Болезнь Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Болезнь;
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.БолезньБезОплаты Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.БолезньБезОплаты;
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.ВынужденныйПрогул Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВынужденныйПрогул;
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.ДополнительныйОтпуск Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ДополнительныйОтпуск; 
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.Командировка Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Командировка;
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.ОтпускОсновной Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ОсновнойОтпуск;
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.ОтпускПоБеременностиИРодам Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ОтпускПоБеременностиИРодам;  
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.ОтпускПоУходуЗаРебенком Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ОтпускПоУходуЗаРебенком;
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.ОтпускУчебныйОплачиваемый Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ОтпускНаОбучение; 
	ИначеЕсли сост = Перечисления.ЛБ_СостоянияСотрудника.Прогул Тогда
		Возврат Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Прогулы;  
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
	Возврат Неопределено;

КонецФункции


Функция ЗагрузитьПриемНаРаботу(СтруктураРеквизитов)
		GUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid);  				
		Ссылка = Документы.ЛБ_ПриемНаРаботу.ПолучитьСсылку(GUID);
		
		Об = Ссылка.ПолучитьОбъект();
		Если Об = Неопределено Тогда  						
			НовОб = Документы.ЛБ_ПриемНаРаботу.СоздатьДокумент();
			НовОб.УстановитьСсылкуНового(Ссылка);
		Иначе
			НовОб = Об; 
		КонецЕсли;
		НовОб.Номер = СтруктураРеквизитов.Номер;
		НовОб.Дата = СтруктураРеквизитов.Дата;
		
		
		guid_Физлица      = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid_Физлица);
		СсылкаНаФизлицо   = Справочники.ФизическиеЛица.ПолучитьСсылку(guid_Физлица);
		
		guid_Должности    = Новый УникальныйИдентификатор(СтруктураРеквизитов.guid_Должности);
