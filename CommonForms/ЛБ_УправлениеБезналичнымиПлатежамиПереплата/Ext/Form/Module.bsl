&НаСервере
Функция ОтменаОплатыНаСервере(ДокументОплаты)
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.Дата = ДокументОплаты.Дата;
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты;  
	ЗалоговыйБилет = ДокументОплаты.ПредыдущаяОперация; 
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет;
	ДокументОбъект.Организация = ЗалоговыйБилет.Организация; 
	ДокументОбъект.Товары.Загрузить(ДокументОплаты.Товары.Выгрузить());
	ДокументОбъект.СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДокументОбъект.Дата, ЗалоговыйБилет.Залогодатель);
	
	ДокументОбъект.Ломбард = ДокументОплаты.Ломбард; 
	ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	ДокументОбъект.СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;  
	ДокументОбъект.СрокЗалога = ЗалоговыйБилет.СрокЗалога; 
	ДокументОбъект.Акция = ЗалоговыйБилет.Акция;
	ДокументОбъект.НомерЗалоговогоБилета = ЗалоговыйБилет.НомерЗалоговогоБилета;  
	ДокументОбъект.ОтмененныйДокумент = ДокументОплаты; 
	
	СостояниеЗБДоОплаты = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(ДокументОплаты, ЗалоговыйБилет);
	ДокументОбъект.НомерДопСоглашения = СостояниеЗБДоОплаты.НомерДопСоглашения; 
	ДокументОбъект.ДатаВыкупа = СостояниеЗБДоОплаты.ДатаВыкупа;
	ДокументОбъект.ДатаВыкупаЛьготная = СостояниеЗБДоОплаты.ДатаВыкупаЛьготныйСрок;
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ДокументОплаты.Дата-1); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаДолгаЗайма КАК Задолженность
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних";
    ТаблицаОЗ = Запрос.Выполнить().Выгрузить();
	
    ДокументОбъект.ТоварыОтмена.Очистить();
	Для каждого стр из ДокументОбъект.Товары Цикл 		
		СтрТОт = ДокументОбъект.ТоварыОтмена.Добавить();
		СтрТОт.ОбъектЗалога = стр.ОбъектЗалога;  
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", стр.ОбъектЗалога);
		СтрокиОЗ = ТаблицаОЗ.НайтиСтроки(Отбор);   
		Если НЕ СтрокиОЗ.Количество() = 0 Тогда 
			СтрОЗ = СтрокиОЗ.Получить(0);
			СтрТОт.Статус = СтрОЗ.СтатусОбъектаЗалога;
			СтрТОт.СуммаОценки = СтрОЗ.Задолженность;
		КонецЕсли;	
	Конеццикла;
			
	СостояниеДоОтменяемойОперации = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ДокументОбъект.НомерЗалоговогоБилета, ДокументОплаты.Дата-1,, Истина);
	
	Если СостояниеДоОтменяемойОперации <> Неопределено Тогда
		ДокументОбъект.СуммаОплаты = -ДокументОплаты.СуммаОплаты;
		ДокументОбъект.СуммаОплатыПроценты = -ДокументОплаты.СуммаОплатыПроценты;
		ДокументОбъект.СуммаОплатыСсуда = -ДокументОплаты.СуммаОплатыСсуда;
		ДокументОбъект.СуммаСсуды = СостояниеДоОтменяемойОперации.Регистратор.СуммаСсуды;
		ДокументОбъект.Выкуп = СостояниеДоОтменяемойОперации.Регистратор.Выкуп;
		ДокументОбъект.ВыдачаЗалога = СостояниеДоОтменяемойОперации.Регистратор.ВыдачаЗалога;
	КонецЕсли;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Попытка         		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		ДокументОтмены = ДокументОбъект.Ссылка;
		
		//Установка отментки об отмене документа в отменяемом документе
		ОтменяемыйДокумент = ДокументОплаты.ПолучитьОбъект();
		ОтменяемыйДокумент.ДокументОтмены = ДокументОтмены;
		
		ОтменяемыйДокумент.Записать(РежимЗаписиДокумента.Запись);	
		Попытка           
			ОтменяемыйДокумент.Записать(РежимЗаписиДокумента.Проведение); 
			Возврат Истина;
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось установить отметку в отменяемом документе"); 
			Возврат ложь;
		КонецПопытки;
   	Исключение   
		Возврат ложь;
	КонецПопытки;  	
КонецФункции  

&НаСервере
Функция МожноОтменитьОплату(ДатаПлатежа, ИдентификаторПлатежа, НомерЗБ, ДатаПеревода)
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
	Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
	Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ); 
	Запрос.УстановитьПараметр("ДатаПеревода", ДатаПеревода); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.Период КАК Период,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ПереплатаНачальная КАК ПереплатаНачальная,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.СтатусПлатежа КАК СтатусПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежейПереплаты КАК ЛБ_РеестрБезначныхПлатежейПереплаты
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.РеестрПлатежей = &РеестрПлатежей
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.НомерЗБ = &НомерЗБ
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.ДатаПлатежа = &ДатаПлатежа
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.ИдентификаторПлатежа = &ИдентификаторПлатежа
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.Период > &ДатаПеревода
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		ТаблицаНачальныхПереплат = ТаблицаЗапроса.Скопировать(); 
		ТаблицаНачальныхПереплат.Свернуть("ПереплатаНачальная");
		Для Каждого Стр Из ТаблицаНачальныхПереплат Цикл	
			Отбор = новый Структура;
			Отбор.Вставить("ПереплатаНачальная", Стр.ПереплатаНачальная);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
			Если Строки.Количество() > 1 Тогда
				СтрЗ = Строки.Получить(0);
				Если СтрЗ.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли; 
			Возврат Ложь;
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПроверитьПлатежОтмена(ДатаПроверки, ЗалоговыйБилет) 
	Возврат ЗалоговыйБилет.НомерЗалоговогоБилета; 
	
	СообщениеПроверки = "";
	СтруктураВ = ЛБ_ОбщийМодуль.ПроверитьЕстьОплатыРегламентныеНачисленияОтменаБН(ДатаПроверки, ЗалоговыйБилет); 
	Если НЕ СтруктураВ = неопределено Тогда   
		Если СтруктураВ.Вид = 0 Тогда //наличная/безнал оплата
			СообщениеПроверки = "По залоговому билету № "  + СокрЛП(ЗалоговыйБилет.НомерЗалоговогоБилета) +  " есть платеж от " + Формат(СтруктураВ.Период, "ДЛФ=DT"); 
		ИначеЕсли СтруктураВ.Вид = 1 Тогда //регл. начисление 
			СообщениеПроверки = "По залоговому билету № "  + СокрЛП(ЗалоговыйБилет.НомерЗалоговогоБилета) +  " есть /регламентное начисление процентов от " + Формат(СтруктураВ.Период, "ДЛФ=DT");
		КонецЕсли;	
	КонецЕсли;   
	
	Возврат СообщениеПроверки;
КонецФункции

&НаКлиенте
Процедура ОтменаПлатежа(Команда)
	ТекСтрока = Элементы.РасшифровкаПереплаты.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекСтрока.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда
		Возврат;
	КонецЕсли;	

	ТекСтрокаПереплаты = Элементы.Переплаты.ТекущиеДанные;
	
	Если ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") Тогда 
		Если НЕ СотрудникЦО Тогда 
			Предупреждение("Переплата возвращена, для отмены операции возврата обратитесь к сотруднику ЦО.", 60);
		    Возврат; 
		Иначе  
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОтмена", ЭтаФорма); 
            ПоказатьВопрос(Оповещение, "Отменить операцию возврата переплаты?",  РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Да,);
        КонецЕсли;	
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда 
		Если НЕ СотрудникЦО Тогда 
			Предупреждение("Переплата отнесена в доходы, для отмены операции обратитесь к сотруднику ЦО.", 60);
		    Возврат; 
		Иначе  
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОтмена", ЭтаФорма); 
            ПоказатьВопрос(Оповещение, "Отменить операцию отнесения переплаты в доходы?",  РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Да,);
        КонецЕсли;	
	Иначе	
		Если ТекСтрока.ДатаПеревода = Дата(1,1,1) Тогда
			Возврат;
		КонецЕсли;	
		Если МожноОтменитьОплату(ТекСтрока.ДатаПлатежа, ТекСтрока.ИдентификаторПлатежа, ТекСтрока.НомерЗБ, ТекСтрока.ДатаПеревода) Тогда
			Если ЗначениеЗаполнено(ТекСтрока.ДокументОплаты)  Тогда  				
				ДатаПроверки = КонецДня(ТекСтрока.ДатаПлатежа)-9; 
				СообщениеПроверки = ПроверитьПлатежОтмена(ДатаПроверки, ТекСтрока.ЗалоговыйБилет);
								
				Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда 
					СообщениеПроверки = СообщениеПроверки + Символы.ПС + "Отмена платежа запрещена.";
					Предупреждение(СообщениеПроверки, 60);
					Возврат; 
				КонецЕсли;   
						  
				Результат = ОтменаОплатыНаСервере(ТекСтрока.ДокументОплаты);
				Если НЕ Результат  Тогда    
					Предупреждение("Ошибка при отмене учета переплаты. Обратитесь к разработчикам.", 60);
				Иначе							
					СтруктураПлатежа = Новый Структура;	
					СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
					СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
					СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
					СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
					СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
					СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
				    СтруктураПлатежа.Вставить("Переплата", ТекСтрока.ПереплатаНачальная);
					РезультатОтмены = РаспределениеПереплатыОтмена(СтруктураПлатежа, ТекСтрока.ДокументОплаты);
					Если НЕ РезультатОтмены Тогда    
						Предупреждение("Ошибка при отмене изменения статуса переплаты. Обратитесь к разработчикам.", 60);
					Иначе	        
						ЗаполнитьРасшифровку(ТекСтрока.ДатаПлатежа, ТекСтрока.ИдентификаторПлатежа, ТекСтрока.НомерЗБ, ТекСтрока.СуммаПлатежа, ТекСтрока.ПереплатаНачальная);  
						Элементы.Переплаты.Обновить(); 
					КонецЕсли;	
				КонецЕсли;	  
			Иначе	            
			    СтруктураПлатежа = Новый Структура;	
				СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
				СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
				СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
				СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
				Если ЗначениеЗаполнено(ТекСтрока.ЗалоговыйБилет) Тогда
				    СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
				Иначе  
					СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрокаПереплаты.ЗалоговыйБилет);
				КонецЕсли;	
				СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
				СтруктураПлатежа.Вставить("Переплата", ТекСтрока.ПереплатаНачальная);
				РезультатОтмены = РаспределениеПереплатыОтмена(СтруктураПлатежа);
				Если НЕ РезультатОтмены Тогда    
					Предупреждение("Ошибка при отмене переплаты. Обратитесь к разработчикам.", 60);
				Иначе	        
					ЗаполнитьРасшифровку(ТекСтрока.ДатаПлатежа, ТекСтрока.ИдентификаторПлатежа, ТекСтрока.НомерЗБ, ТекСтрока.СуммаПлатежа, ТекСтрока.ПереплатаНачальная);
					Элементы.Переплаты.Обновить(); 
				КонецЕсли;	
			КонецЕсли;  
		Иначе	
			Предупреждение("Невозможно корректно отменить операцию зачисления, т.к. существуют более поздние операции.", 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПлатежа(Команда)
	ТекСтрока = Элементы.РасшифровкаПереплаты.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
    ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РеестрПлатежей", РеестрПлатежей);
	ПараметрыФормы.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
	ПараметрыФормы.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа); 
	ПараметрыФормы.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа); 
	ПараметрыФормы.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа); 
   	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ИсторияБезналичногоПлатежа", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПереплаты(Команда)
	ТекСтрока = Элементы.Переплаты.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РеестрПлатежей", РеестрПлатежей);
	ПараметрыФормы.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
	ПараметрыФормы.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа); 
	ПараметрыФормы.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа); 
	ПараметрыФормы.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	ПараметрыФормы.Вставить("Переплата", ТекСтрока.Переплата); 
	   
	ОткрытьФорму("ОбщаяФорма.ЛБ_ИсторияПереплаты", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ПолучитьПереплаты() 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.НомерЗБ КАК НомерЗБ,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа КАК ДатаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СуммаПлатежа КАК СуммаПлатежа,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_БезналичныеПлатежиКРаспределению.Остатки КАК ЛБ_БезналичныеПлатежиКРаспределениюОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(, РеестрПлатежей = &РеестрПлатежей) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних
	               |		ПО ЛБ_БезналичныеПлатежиКРаспределениюОстатки.РеестрПлатежей = ЛБ_РеестрБезначныхПлатежейСрезПоследних.РеестрПлатежей
	               |			И ЛБ_БезналичныеПлатежиКРаспределениюОстатки.НомерЗБ = ЛБ_РеестрБезначныхПлатежейСрезПоследних.НомерЗБ
	               |			И ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ДатаПлатежа = ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа
	               |			И ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ИдентификаторПлатежа = ЛБ_РеестрБезначныхПлатежейСрезПоследних.ИдентификаторПлатежа
	               |			И (НЕ ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаПлатежа = ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата)
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата <> 0
	               |	И НЕ ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен)
	               |	И НЕ ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаОстаток = 0";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаПереплат.Загрузить(ТаблицаЗапроса); 	
КонецПроцедуры

&НаКлиенте
Процедура ВозвратитьВсе(Команда)      
	ПолучитьПереплаты();  
	Если НЕ ТаблицаПереплат.Количество() = 0 Тогда
		Для каждого Стр Из ТаблицаПереплат Цикл
			ОстатокПереплаты = ПолучитьОстатокПереплаты(Стр.ДатаПлатежа, Стр.ИдентификаторПлатежа, Стр.НомерЗБ); 
			Если ОстатокПереплаты = 0 Тогда
				Продолжить;
			КонецЕсли;	

			НовыйСтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено");
			СтруктураПлатежа = Новый Структура;	
			СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
			СтруктураПлатежа.Вставить("ИдентификаторПлатежа", Стр.ИдентификаторПлатежа);
			СтруктураПлатежа.Вставить("ДатаПлатежа", Стр.ДатаПлатежа);
			СтруктураПлатежа.Вставить("НомерЗБ", Стр.НомерЗБ);
			СтруктураПлатежа.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
			СтруктураПлатежа.Вставить("СуммаПлатежа", Стр.СуммаПлатежа);
			СтруктураПлатежа.Вставить("Переплата", ОстатокПереплаты);
			ДатаПеревода = РаспределениеПереплаты(НовыйСтатусПлатежа, СтруктураПлатежа);
			Если ДатаПеревода = неопределено Тогда    
				Предупреждение("Ошибка при возврате переплаты (" + СокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.", 60);
				Прервать;
			КонецЕсли;	
		КонецЦикла;	  
		Элементы.Переплаты.Обновить();  
		ТекСтрока = Элементы.Переплаты.ТекущиеДанные;  
		Если ТекСтрока = неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗаполнитьРасшифровку(ТекСтрока.ДатаПлатежа, ТекСтрока.ИдентификаторПлатежа, ТекСтрока.НомерЗБ, ТекСтрока.СуммаПлатежа, ТекСтрока.Переплата);  
	Иначе
		Предупреждение("Переплаты для возврата не найдены.", 60);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура КВозврату(Команда)
	ТекСтрока = Элементы.Переплаты.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;    
	Если ТекСтрока.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаР = РасшифровкаПереплаты[РасшифровкаПереплаты.Количество()-1];
    ИдентификаторСтроки = СтрокаР.ПолучитьИдентификатор();
    Элементы.РасшифровкаПереплаты.ТекущаяСтрока = ИдентификаторСтроки;

	ОстатокПереплаты = ПолучитьОстатокПереплаты(ТекСтрока.ДатаПлатежа, ТекСтрока.ИдентификаторПлатежа, ТекСтрока.НомерЗБ); 
	Если ОстатокПереплаты = 0 Тогда
		Предупреждение("Сумма переплаты полностью распределена.", 60);
		Возврат; 
	КонецЕсли;	

	НовыйСтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.КВозврату");
	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
	СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
	СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
	СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	СтруктураПлатежа.Вставить("Переплата", ОстатокПереплаты);
	ДатаПеревода = РаспределениеПереплаты(НовыйСтатусПлатежа, СтруктураПлатежа);
	Если ДатаПеревода = неопределено Тогда    
		Предупреждение("Ошибка установки статуса платежа ""К возврату"". Обратитесь к разработчикам.", 60);
	Иначе	 
		ТекСтрока = Элементы.РасшифровкаПереплаты.ТекущиеДанные;
		ТекСтрока.ИтоговыйСтатус = НовыйСтатусПлатежа;  
		ТекСтрока.ДатаПеревода = ДатаПеревода;  
		ТекСтрока.Ответственный = ТекущийПользователь(); 
		Элементы.Переплаты.Обновить(); 
	КонецЕсли;	
КонецПроцедуры






