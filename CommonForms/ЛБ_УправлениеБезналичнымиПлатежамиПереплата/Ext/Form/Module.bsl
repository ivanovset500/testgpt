			Предупреждение("Ошибка при отмене переплаты. Обратитесь к разработчикам.", 60);
		Иначе	        
			ЗаполнитьРасшифровку(ТекСтрока.ДатаПлатежа, ТекСтрока.ИдентификаторПлатежа, ТекСтрока.НомерЗБ, ТекСтрока.СуммаПлатежа, ТекСтрока.ПереплатаНачальная); 
			Элементы.Переплаты.Обновить(); 
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры		

