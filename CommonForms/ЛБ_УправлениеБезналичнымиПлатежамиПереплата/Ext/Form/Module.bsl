		Возврат; 
	КонецЕсли;	
		
	НовыйСтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы");
	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
