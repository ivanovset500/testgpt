					<v8:lang>ru</v8:lang>
					<v8:content>Переплаты</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.НомерЗБ КАК НомерЗБ,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа КАК ДатаПлатежа,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СуммаПлатежа КАК СуммаПлатежа,
	ВЫБОР
		КОГДА ЛБ_РеестрБезначныхПлатежейСрезПоследних.Регистратор = &amp;РеестрПлатежей
			ТОГДА &amp;ПустойСтатус
		ИНАЧЕ ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа
	КОНЕЦ КАК СтатусПлатежа,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ОплатаПроценты КАК ОплатаПроценты,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ОплатаЗайм КАК ОплатаЗайм,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата КАК Переплата,
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ЗалоговыйБилет.Ломбард.НомерЛомбарда КАК НомерЛомбарда,
	ВЫБОР
		КОГДА ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен)
			ТОГДА 0
		ИНАЧЕ ВЫБОР
				КОГДА ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата = ЛБ_РаспределениеПереплатыОбороты.ОплатаПроцентыОборот + ЛБ_РаспределениеПереплатыОбороты.ОплатаЗаймОборот + ЛБ_РаспределениеПереплатыОбороты.ВозвращеноОборот + ЛБ_РаспределениеПереплатыОбороты.ВДоходыОборот
					ТОГДА 2
				ИНАЧЕ 1
			КОНЕЦ
	КОНЕЦ КАК Распределено
ИЗ
	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
			&amp;Дата,
			РеестрПлатежей = &amp;РеестрПлатежей
				И НЕ СуммаПлатежа = Переплата) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЛБ_РаспределениеПереплаты.Обороты(, , , ) КАК ЛБ_РаспределениеПереплатыОбороты
		ПО ЛБ_РеестрБезначныхПлатежейСрезПоследних.РеестрПлатежей = ЛБ_РаспределениеПереплатыОбороты.РеестрПлатежей
			И ЛБ_РеестрБезначныхПлатежейСрезПоследних.ИдентификаторПлатежа = ЛБ_РаспределениеПереплатыОбороты.ИдентификаторПлатежа
			И ЛБ_РеестрБезначныхПлатежейСрезПоследних.НомерЗБ = ЛБ_РаспределениеПереплатыОбороты.НомерЗБ
			И ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДатаПлатежа = ЛБ_РаспределениеПереплатыОбороты.ДатаПлатежа
			И ЛБ_РеестрБезначныхПлатежейСрезПоследних.СуммаПлатежа = ЛБ_РаспределениеПереплатыОбороты.СуммаПлатежа
ГДЕ
	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата &lt;&gt; 0
	И НЕ ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено)
	И НЕ ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы)
	И НЕ ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью)</QueryText>
				<ListSettings>
					<dcsset:filter>
