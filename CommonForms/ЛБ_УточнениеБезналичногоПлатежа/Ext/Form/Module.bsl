    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	НомерЗБНовый = Результат; 
	ЗалоговыйБилет = ПолучитьЗБ(НомерЗБНовый); 	
	
	Если ЗначениеЗаполнено(ЗалоговыйБилет) Тогда 
		//Результат = ПроверитьДвижениеБН(ЗалоговыйБилет);
		//Если Результат = неопределено тогда 
		Залогодатель = ПолучитьЗаемщика(ЗалоговыйБилет);
		РезультатРасчета = ПолучитьДолгЗБ(); 
		ДолгПроценты = РезультатРасчета.ОстатокПроценты;
		ДолгЗайм = РезультатРасчета.ОстатокЗайм; 
		//Иначе
		//	НомерЗБНовый = "";
		//	Предупреждение("По выбранному залоговому билету в реестре уже сделан зачет " + ?(Результат.Переплата, "переплаты", "платежа") +  " (№ п.п " + СокрЛП(Результат.ИдентификаторПлатежа) + " от " + Формат(Результат.ДатаПлатежа, "ДЛФ=DT")+ ")", 60);
		//	Возврат;
		//КонецЕсли;	

	Иначе 
		Предупреждение("Залоговый билет № " + СокрЛП(НомерЗБНовый) + " в базе не найден.", 60);
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура Расчет(Команда)
	Если ЗначениеЗаполнено(ЗалоговыйБилет) Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет);		
		ПараметрыФормы.Вставить("Дата", ДатаПлатежа);	 
		ПараметрыФормы.Вставить("Детально", Истина);
					
        ОткрытьФорму("Отчет.ЛБ_НачисленныеПроцентыПоДоговоруЗайма.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;		
КонецПроцедуры


