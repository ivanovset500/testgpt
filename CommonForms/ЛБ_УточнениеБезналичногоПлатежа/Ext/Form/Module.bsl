
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("РеестрПлатежей") Тогда
		РеестрПлатежей = Параметры.РеестрПлатежей; 
		Если Параметры.Свойство("ДатаПлатежа") Тогда 
			ДатаПлатежа = Параметры.Датаплатежа;
		КонецЕсли;	
		Если Параметры.Свойство("ИдентификаторПлатежа") Тогда 
			ИдентификаторПлатежа = Параметры.ИдентификаторПлатежа;
		КонецЕсли;	
        Если Параметры.Свойство("СуммаПлатежа") Тогда 
			СуммаПлатежа = Параметры.СуммаПлатежа;
		КонецЕсли;	
        Если Параметры.Свойство("НомерЗБ") Тогда 
			НомерЗБ = Параметры.НомерЗБ;
		КонецЕсли;	
		Если Параметры.Свойство("Переплата") Тогда 
			Переплата = Параметры.Переплата;
		КонецЕсли;	
	Иначе
		Возврат;
	КонецЕсли;	     
	//ИнформацияПлатеж = "Реестр платежей № " + СокрЛП(РеестрПлатежей.НомерРеестра) + "/" + СокрЛП(РеестрПлатежей.ИмяФайла);  
	ИнформацияПлатеж = "Реестр платежей "  + СокрЛП(РеестрПлатежей.ИмяФайла);
	Если РеестрПлатежей.ВидОперации = Перечисления.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет Тогда		
	    ИнформацияПлатеж = ИнформацияПлатеж + Символы.ПС + "п/п № " + СокрЛП(ИдентификаторПлатежа) + " от " + Формат(ДатаПлатежа, "ДЛФ=DT");
	Иначе
		ИнформацияПлатеж = ИнформацияПлатеж + Символы.ПС + СокрЛП(ИдентификаторПлатежа) + " от " + Формат(ДатаПлатежа, "ДЛФ=DT");
	КонецЕсли;	  
	ИнформацияПлатеж = ИнформацияПлатеж + Символы.ПС + "Сумма " + ?(Переплата, "переплаты", "платежа") + " для распределения " + Формат(СуммаПлатежа, "ЧЦ=15; ЧДЦ=2") + " руб.";
	Элементы.ДекорацияПлатеж.Заголовок = ИнформацияПлатеж;
КонецПроцедуры


&НаСервере
Функция ПроверитьПлатеж()
	Если НЕ ЗначениеЗаполнено(ЗалоговыйБилет) Тогда 				
	    Возврат "Залоговый билет № " + СокрЛП(НомерЗБНовый) + " в базе не найден.";
	Иначе                                                                                              
		СтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ТекущаяДатаСеанса(), ЗалоговыйБилет); 
		Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт ИЛИ 
			 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение ИЛИ   
			 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления ИЛИ
			 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен Тогда   
			Возврат "Залоговый билет № " + СокрЛП(НомерЗБНовый) + " в статусе " + строка(СтатусЗБ) + "."; 
		ИначеЕсли ЛБ_ОбщийМодуль.ПроверитьЕстьОплатыКасса(РеестрПлатежей.ВидОперации, РеестрПлатежей.Дата, ДатаПлатежа, ЗалоговыйБилет) Тогда  
			Если РеестрПлатежей.ВидОперации = Перечисления.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет Тогда
			    Возврат "По залоговый билету № " + СокрЛП(НомерЗБНовый) + " есть наличные оплаты позже " + Формат(КонецДня(ДатаПлатежа), "ДЛФ=DT"); 
			ИначеЕсли РеестрПлатежей.ВидОперации = Перечисления.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет Тогда
			    Возврат "По залоговый билету № " + СокрЛП(НомерЗБНовый) + " есть наличные оплаты в промежутке между датой платежа и датой загрузки реестра.";
			КонецЕсли;		
		Иначе                                     
			РезультатРасчета = ЛБ_Общиймодуль.ПроверитьРасчетыПоЗалоговомуБилету(ДатаПлатежа, ЗалоговыйБилет);
			Если РеестрПлатежей.ВидОперации = Перечисления.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет Тогда
				Если (РезультатРасчета.ОстатокПроценты + РезультатРасчета.ОстатокЗайм) <= 0 Тогда
				   Возврат "По залоговый билету № " + СокрЛП(НомерЗБНовый) + " проценты на дату платежа не начислены и не определен остаток задолженности по телу займа.";
				КонецЕсли;  
			ИначеЕсли РеестрПлатежей.ВидОперации = Перечисления.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет Тогда  
				Если РезультатРасчета.ОстатокПроценты <= 0 Тогда
				    Возврат "По залоговый билету № " + СокрЛП(НомерЗБНовый) + " проценты на дату платежа не начислены.";
				КонецЕсли; 
	        КонецЕсли;
		КонецЕсли;	
	КонецЕсли;  
	Возврат "";
КонецФункции

&НаКлиенте
Процедура Зачислить(Команда)
	Если НЕ ЗначениеЗаполнено(ЗалоговыйБилет) Тогда 
		Предупреждение("Не выбран залоговый билет.", 60); 
		Возврат;
	КонецЕсли;
	
	СообщениеОбОшибке = ПроверитьПлатеж();
	Если НЕ ПустаяСтрока(СообщениеОбОшибке) Тогда
		Предупреждение(СообщениеОбОшибке, 60);
	Иначе	
		СтруктураВ = новый Структура;
		СтруктураВ.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
		СтруктураВ.Вставить("НомерЗБ", НомерЗБНовый);
	    Закрыть(СтруктураВ);   
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(неопределено);
КонецПроцедуры

&НаСервере
Функция ПолучитьЗаемщика(ЗалоговыйБилет)
	Возврат ЗалоговыйБилет.Залогодатель;
КонецФункции

&НаСервере
Функция ПолучитьЗБ(НомерЗБ)  
	Если НЕ ПустаяСтрока(НомерЗБ) Тогда
	    Возврат ЛБ_Общиймодуль.ПолучитьЗБПоНомеру(НомерЗБ);  
	КонецЕсли;
	Возврат Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка();
КонецФункции  

&НаКлиенте
Процедура ПоискПоНомеруЗБ(Команда)
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЗБ", ЭтаФорма);	
 
    ПоказатьВводЗначения(
        Оповещение,
        , 
		"Введите номер ЗБ",
        "Строка"
    );
КонецПроцедуры   

&НаСервере
Функция ПолучитьДолгЗБ() 
	Возврат ЛБ_Общиймодуль.ПроверитьРасчетыПоЗалоговомуБилету(ДатаПлатежа, ЗалоговыйБилет);
КонецФункции

&НаСервере
Функция ПроверитьДвижениеБН(ЗалоговыйБилет)     
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей); 	
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИСТИНА КАК Переплата,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ДатаПлатежа КАК ДатаПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежейПереплаты КАК ЛБ_РеестрБезначныхПлатежейПереплаты
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.РеестрПлатежей = &РеестрПлатежей
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.ЗалоговыйБилет = &ЗалоговыйБилет
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛОЖЬ,
	               |	ЛБ_РеестрБезначныхПлатежей.ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежей.ДатаПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей КАК ЛБ_РеестрБезначныхПлатежей
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежей.РеестрПлатежей = &РеестрПлатежей
	               |	И ЛБ_РеестрБезначныхПлатежей.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И НЕ ЛБ_РеестрБезначныхПлатежей.Регистратор = &РеестрПлатежей"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураВ = Новый структура;
		СтруктураВ.Вставить("Переплата", Выборка.Переплата); 
		СтруктураВ.Вставить("ИдентификаторПлатежа", Выборка.ИдентификаторПлатежа);
        СтруктураВ.Вставить("ДатаПлатежа", Выборка.ДатаПлатежа);
		Возврат СтруктураВ;
	КонецЕсли;	
	Возврат неопределено;
КонецФункции	

&НаКлиенте
