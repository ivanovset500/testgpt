&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
		Документ = Параметры.Документ; 
		Если Документ.Проведен тогда
		   СостояниеДокумента = 1;
		ИначеЕсли Документ.ПометкаУдаления тогда
		   СостояниеДокумента = 2;
        КонецЕсли;
		ЗаполнитьСписокЗБПоДокументу();
		ЗаполнитьТаблицу();
		Элементы.ГруппаДокумент.Видимость = Истина; 
		Элементы.ГруппаДокументПодвал.Видимость = Истина;
		Элементы.ДекорацияБлокировать.Видимость = Ложь;  
		Элементы.ДекорацияНеБлокировать.Видимость = Ложь;
		Элементы.ТаблицаВыбора.КоманднаяПанель.Видимость = ложь; 
		Элементы.ТаблицаВыбораВкл.Видимость = Ложь;  
		ЭтаФорма.Заголовок = Метаданные.Документы.ЛБ_КорректировкаНакладной.Синоним + ": " + Строка(Документ.ВидОперации);
	Иначе
		Если Параметры.Свойство("Организация") Тогда
			Организация = Параметры.Организация; 
		Иначе
			Отказ = Истина;
		КонецЕсли;	
		ИнформацияДляПользователя();   
		ЭтаФорма.Заголовок = "Блокировка включения ЗБ в накладную на отгрузку";
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокЗБПоДокументу()
	СписокЗБ.Очистить();
	Для каждого стр Из Документ.ЗалоговыеБилеты Цикл 
		Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда 
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ИнформацияДляПользователя() 
	Элементы.ДекорацияНеБлокировать.Видимость =Ложь;
	Если ТаблицаВыбора.Количество() = 0 тогда 
		Элементы.ДекорацияБлокировать.Заголовок = "Не выбраны залоговые билеты для блокировки включения в накладную"; 
	Иначе   
		Отбор = новый Структура;
		Отбор.Вставить("Вкл", Истина);
		Строки = ТаблицаВыбора.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 тогда 
		    Элементы.ДекорацияБлокировать.Заголовок = "Не выбраны залоговые билеты для блокировки включения в накладную";
		Иначе  
			СтрокаНеБлокировать = "";
			
			ТаблицаЗБ = ТаблицаВыбора.Выгрузить();
			ТаблицаЗБ.Свернуть("Вкл, ЗалоговыйБилет");   
			ОтборЗБ = Новый структура;
            ОтборЗБ.Вставить("Вкл", Истина);
            СтрокиЗБ = ТаблицаЗБ.НайтиСтроки(ОтборЗБ);
			Элементы.ДекорацияБлокировать.Заголовок = "Выбраны для блокировки включения в накладную залоговые билеты " + Строка(СтрокиЗБ.Количество());
			ОтборЗБ.Вставить("Вкл", Ложь);
            СтрокиЗБ = ТаблицаЗБ.НайтиСтроки(ОтборЗБ);
			Для каждого СтрЗБ Из СтрокиЗБ Цикл
				Отбор = Новый структура;
				Отбор.Вставить("ЗалоговыйБилет", стрЗБ.ЗалоговыйБилет);
				Строки = ТаблицаВыбора.НайтиСтроки(Отбор);
                СтрокаАртикулы = "";
				
				КолА = 0;  
				Статус = "";  
				Для каждого стр Из Строки Цикл    
					Если НЕ Стр.Вкл Тогда   
						Если Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную ИЛИ
							 Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг тогда
						    КолА = КолА + 1;
							СтрокаАртикулы = СтрокаАртикулы + ?(ПустаяСтрока(СтрокаАртикулы), "", ", ") + СокрЛП(Стр.Артикул);
							Статус = Строка(Стр.СтатусЗалога); 
						КонецЕсли;   
					КонецЕсли;	
				КонецЦикла;	  
				
				Если НЕ КолА = 0 Тогда
					СтрокаНеБлокировать = СтрокаНеБлокировать + ?(ПустаяСтрока(СтрокаНеБлокировать), "", Символы.ПС) + "По ЗБ № " + СокрЛП(СтрЗБ.ЗалоговыйБилет.НомерЗалоговогоБилета) +
					        " предметы залога с " + ?(КолА>1, "артикулами", "артикулом") + " № " + СтрокаАртикулы + " в статусе «" + Статус + "». Блокировка включения в накладную невозможна.";
                КонецЕсли;
			КонецЦикла;	
			
			Если Не ПустаяСтрока(СтрокаНеБлокировать) Тогда
				Элементы.ДекорацияНеБлокировать.Видимость = Истина;
                Элементы.ДекорацияНЕБлокировать.Заголовок = СтрокаНеБлокировать;
			КонецЕсли;	                                                        
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	
	 
&НаКлиенте
Процедура ВыбратьЗБ(Команда)
	ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Организация", Организация); 
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗБ", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборЗалоговыхБилетов", ПараметрыФормы ,,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры  

&НаСервере
Функция ПолучитьКолИсключений(ОбъектЗалога)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);   
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладной.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной КАК ЛБ_СтатусыОбъектовЗалогаВНакладной
	               |ГДЕ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладной.ОбъектЗалога = &ОбъектЗалога
	               |	И ЛБ_СтатусыОбъектовЗалогаВНакладной.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной)
	               |	И ЛБ_СтатусыОбъектовЗалогаВНакладной.Регистратор ССЫЛКА Документ.ЛБ_КорректировкаНакладной";
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаРезультат.Количество();
КонецФункции


&НаСервере
Процедура ЗаполнитьТаблицу()
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("СписокЗБ", СписокЗБ);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Документ), Документ.Дата-1, ТекущаяДатаСеанса()));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.Статус КАК Статус,
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.ДатаБлокировки КАК ДатаБлокировки
	               |ИЗ
	               |	РегистрСведений.ЛБ_ЗалоговыеБилетыЗаблокированные КАК ЛБ_ЗалоговыеБилетыЗаблокированные
	               |ГДЕ
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБлокировкиЗБ.Блокировка)
	               |	И ЛБ_ЗалоговыеБилетыЗаблокированные.Период < &Дата
	               |	И ЛБ_ЗалоговыеБилетыЗаблокированные.ЗалоговыйБилет В(&СписокЗБ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.Период УБЫВ"; 
	ТаблицаБлокировок = Запрос.Выполнить().Выгрузить();
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Залогодатель КАК Залогодатель,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ЗалоговыйБилет В (&СписокЗБ)) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	               |			ПО (ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет)
	               |		ПО (ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет)
	               |			И (ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога)";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	//ТаблицаВыбора.Очистить();     
	Для каждого Эл из СписокЗБ Цикл 
		Отбор = Новый Структура;
		Отбор.Вставить("ЗалоговыйБилет", Эл.Значение);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для каждого Стр Из Строки Цикл
			НоваяСтр = ТаблицаВыбора.Добавить();
			НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
			НоваяСтр.Ломбард = Стр.ЗалоговыйБилет.Ломбард; 
			НоваяСтр.Залогодатель = Стр.Залогодатель;
			НоваяСтр.НомерЗалоговогоБилета = Стр.ЗалоговыйБилет.НомерЗалоговогоБилета;  
			НоваяСтр.СтатусЗБ = Стр.СтатусЗалоговогоБилета;    
			НоваяСтр.ДатаВыкупаЛьготная = Стр.ДатаВыкупаЛьготныйСрок;
			НоваяСтр.Артикул = Стр.Артикул; 
			НоваяСтр.СтатусЗалога = Стр.СтатусОбъектаЗалога;
			НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
			НоваяСтр.КолИсключений = ПолучитьКолИсключений(Стр.ОбъектЗалога); 
			
			Если ЗначениеЗаполнено(Документ) Тогда 
				Отбор = Новый структура; 
				Отбор.Вставить("ЗалоговыйБилет", НоваяСтр.ЗалоговыйБилет); 
				
				СтрокиДок = Документ.ЗалоговыеБилеты.НайтиСтроки(Отбор);
				Если НЕ СтрокиДок.Количество() = 0 Тогда 
					СтрДок = строкиДок.Получить(0);  
					Если СтрДок.ОтменитьБлокировку Тогда
						НоваяСтр.ЕстьБлокировка = Истина;
						НоваяСтр.ОтменитьБлокировку = СтрДок.ОтменитьБлокировку;
					КонецЕсли;	
					НоваяСтр.ДатаБлокировки = СтрДок.ДатаБлокировки;
					НоваяСтр.Основание = СтрДок.ОснованиеБлокировки;
				КонецЕсли;	
			КонецЕсли;	 
		КонецЦикла;	
	Конеццикла;	 
	Если НЕ ЗначениеЗаполнено(Документ) Тогда 	
		ТаблицаЗБ = ТаблицаВыбора.Выгрузить();
		ТаблицаЗБ.Свернуть("ЗалоговыйБилет");
		Для каждого СтрЗБ Из ТаблицаЗБ Цикл
			Отбор = Новый структура;
			Отбор.Вставить("ЗалоговыйБилет", стрЗБ.ЗалоговыйБилет);
			Строки = ТаблицаВыбора.НайтиСтроки(Отбор); 		
			Недоступно = Ложь;
			Для Каждого Стр Из Строки Цикл
			    Если Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную ИЛИ 
					 Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг ИЛИ
					 Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Отгружен ИЛИ 
					 Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят ИЛИ
					 Стр.СтатусЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен Тогда
					Недоступно = Истина;
					Прервать;
				КонецЕсли;
			Конеццикла;   
			Если НЕ Недоступно Тогда 
				ДатаБлокировки = Дата(1,1,1); 
				СтрокиБ = ТаблицаБлокировок.НайтиСтроки(Отбор);
				Если НЕ СтрокиБ.Количество() = 0 Тогда 
					СтрБ = СтрокиБ.Получить(0); 
					Если СтрБ.статус = Перечисления.ЛБ_СтатусыБлокировкиЗБ.Блокировка тогда 
						Если СтрБ.ДатаБлокировки > ТекущаяДатаСеанса() Тогда
							ДатаБлокировки = СтрБ.ДатаБлокировки; 
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;
				Для Каждого Стр Из Строки Цикл 
					Стр.Вкл = Истина;    
					Если НЕ ДатаБлокировки = Дата(1,1,1) Тогда
						Стр.ДатаБлокировки = ДатаБлокировки;
						Стр.ЕстьБлокировка = Истина;   
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
		КонецЦикла;    
	КонецЕсли;
КонецПроцедуры	
	
&НаКлиенте
Процедура ПослеВыбораЗБ(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	СписокЗБ = Результат; 
	ЗаполнитьТаблицу();  
	ИнформацияДляПользователя();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокировку(Команда)       
	СписокБлокировать = Новый СписокЗначений;  
	СписокДатыБлокировки = Новый СписокЗначений;
	СписокОснованияБлокировки = Новый СписокЗначений;   
	СписокОтменить = Новый СписокЗначений;  
	СписокОснованияОтменить = Новый СписокЗначений;

	Для каждого стр Из ТаблицаВыбора Цикл    
		Если Стр.Вкл Тогда 
			Если Стр.ОтменитьБлокировку Тогда 
				СписокОтменить.Добавить(Стр.ЗалоговыйБилет);
				СписокОснованияОтменить.Добавить(?(ПустаяСтрока(Стр.Основание), "без основания", Стр.Основание));
			Иначе	
				СписокБлокировать.Добавить(Стр.ЗалоговыйБилет);
				Если Стр.ДатаБлокировки = Дата(1,1,1) Тогда
					Продолжить; 
				КонецЕсли;
				СписокДатыБлокировки.Добавить(Стр.ДатаБлокировки); 
				СписокОснованияБлокировки.Добавить(?(ПустаяСтрока(Стр.Основание), "без основания", Стр.Основание));
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	Если СписокБлокировать.Количество() = 0 И СписокОтменить.Количество() = 0 Тогда
		Предупреждение("Не выбраны залоговые билеты для блокировки/отмены блокировки включения ЗБ в накладную", 60); 
	ИначеЕсли НЕ СписокБлокировать.Количество() = СписокДатыБлокировки.Количество() Тогда
		Предупреждение("Необходимо заполнить все даты блокировки залоговых билетов.", 60);
	Иначе  
		СтруктураВ = Новый Структура;
		СтруктураВ.Вставить("СписокБлокировать", СписокБлокировать); 
		СтруктураВ.Вставить("СписокДатыБлокировки", СписокДатыБлокировки); 
		СтруктураВ.Вставить("СписокОснованияБлокировки", СписокОснованияБлокировки);
		СтруктураВ.Вставить("СписокОтменить", СписокОтменить); 
		СтруктураВ.Вставить("СписокОснованияОтменить", СписокОснованияОтменить);

		Закрыть(СтруктураВ);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ОбработатьВкл(ЗБ, Вкл) 
	Отбор = Новый структура;
	Отбор.Вставить("ЗалоговыйБилет", ЗБ);
	Строки = ТаблицаВыбора.НайтиСтроки(Отбор); 		
	Для Каждого Стр Из Строки Цикл  
		Стр.Вкл = Вкл;
		Если НЕ Вкл Тогда 
			Стр.ДатаБлокировки = Дата(1,1,1);  
			Стр.Основание = ""; 
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбораВклПриИзменении(Элемент) 
	ТекСтрока = Элементы.ТаблицаВыбора.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		ОбработатьВкл(ТекСтрока.ЗалоговыйБилет, ТекСтрока.Вкл);
		ИнформацияДляПользователя();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗБ(Идентификатор) 
	Стр = ТаблицаВыбора.НайтиПоИдентификатору(Идентификатор);
	Возврат Стр.ЗалоговыйБилет;
КонецФункции	
	
&НаКлиенте
Процедура ИсторияЗалоговогоБилета(Команда)
	ТекСтрока = Элементы.ТаблицаВыбора.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда
		ЗБ = ПолучитьЗБ(ТекСтрока.ПолучитьИдентификатор());
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", ТекСтрока.Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗБ);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры

