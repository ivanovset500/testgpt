	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ЛБ_РасчетыСКлиентамиОбороты.ВидРасчета"; 
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции 

&НаСервере
Процедура ЗаполнитьТовары() 
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОплаты КАК СуммаОплаты,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаДолгаЗайма КАК СуммаДолга
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.Период УБЫВ";
	ТаблицаСостоянийОЗ = Запрос.Выполнить().Выгрузить();
	
	Товары.Очистить();
	Для каждого стр Из ЗалоговыйБилет.Товары Цикл
		НоваяСтр = Товары.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);  
		НоваяСтр.Артикул = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет, стр.НомерСтроки); 
		Отбор = новый Структура;
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога); 
		СтрокиОЗ = ТаблицаСостоянийОЗ.НайтиСтроки(Отбор);
		Если НЕ СтрокиОЗ.Количество() = 0 Тогда    
			СтрОЗ = СтрокиОЗ.Получить(0);
			НоваяСтр.Статус = СтрОЗ.СтатусОбъектаЗалога;   
			НоваяСтр.Оплачено = СтрОЗ.СуммаОплаты; 
			НоваяСтр.Долг = СтрОЗ.СуммаДолга;
		КонецЕсли;	
	Конеццикла;	 

КонецПроцедуры   	

&НаСервере
Функция ПолучитьТекущийПриказ() 
	Приказ = Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Залоговыйбилет.Дата);
	Запрос.УстановитьПараметр("Ломбард", Залоговыйбилет.Ломбард); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок КАК ЛБ_ПрейскурантПроцентныхСтавок
	               |ГДЕ
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Ломбард = &Ломбард
	               |	И ЛБ_ПрейскурантПроцентныхСтавок.ДатаНачалаДействия <= &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантПроцентныхСтавок.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Регистратор;
    КонецЕсли;
	Возврат Приказ;
Конецфункции

&НаСервере
Функция ПолучитьДатуВыкупаРеализации() 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период КАК Период
