&НаСервере
Функция ЗаполнитьИнформациюПоЗБ()       
	НачисленияОстановлены = Ложь;
	Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда   
		НачисленияОстановлены = Истина;
	КонецЕсли;	

	Если НЕ ДатаСмерти = Дата(1,1,1) Тогда   
		ПредыдущийСтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ДатаСмерти-1, ЗалоговыйБилет); 
		Если ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда 
			НачисленияОстановлены = Истина; 
		КонецЕсли; 
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;  
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщиеМакеты.ЛБ_ТекущееСостояниеЗБ");  
    ОбластьМакета = Макет.ПолучитьОбласть("Основная"); 
	ОбластьМакета.Параметры.СхемаКредитования = ?(Не ПустаяСтрока(ЗалоговыйБилет.СхемаКредитования.НаименованиеДляПечати), ЗалоговыйБилет.СхемаКредитования.НаименованиеДляПечати, ЗалоговыйБилет.СхемаКредитования);  
	ОбластьМакета.Параметры.Продление = ?(ЗалоговыйБилет.СхемаКредитования.БезПродленияДоговора, "Нет", "Да");
	ОбластьМакета.Параметры.СККратко = ЗалоговыйБилет.СхемаКредитования.НаименованиеКраткое;     
	СтавкаПроцентовНач  = ПолучитьПроцентнуюСхему();
	ОбластьМакета.Параметры.ПроцентнаяСтавка = СтавкаПроцентовНач; 
	Если СотрудникЦО Тогда
	    СтруктураП = Новый структура;
	    СтруктураП.Вставить("Вид", 1);  
	 	ОбластьМакета.Параметры.СтруктураП = СтруктураП;                                                 
	КонецЕсли;	
	//Если НЕ ЗалоговыйБилет.СхемаКредитования.БезПродленияДоговора Тогда
	    ОбластьМакета.Параметры.ПСК = ПолучитьПСКГод(); 
	//КонецЕсли;	
	ОбластьМакета.Параметры.ПСЗ = Формат(Этаформа.ПредельныйСрокЗайма, "ДФ=dd.MM.yyyy") + " (" + Строка(Этаформа.ПредельныйСрокЗаймаДни) + ")";
    ОбластьМакета.Параметры.Дата = Формат(ЗалоговыйБилет.Дата, "ДФ=dd.MM.yyyy"); 
	ОбластьМакета.Параметры.СрокЗайма = ЗалоговыйБилет.СрокЗалога;  
	ОбластьМакета.Параметры.СуммаОценки = ЗалоговыйБилет.Товары.Итог("СуммаОценкиМаксимальная");
	ОбластьМакета.Параметры.ДатаВозврата = Формат(ДатаВыкупаНач, "ДФ=dd.MM.yyyy"); 
	ОбластьМакета.Параметры.ДатаВозвратаЛьготная = Формат(ДатаВыкупаЛьготныйСрокНач, "ДФ=dd.MM.yyyy"); 
	ОбластьМакета.Параметры.СуммаСсуды = Формат(СуммаЗаймаНач, "ЧЦ=15; ЧДЦ=2");  
	СуммаПроцентовДеньНач = СуммаЗаймаНач*СтавкаПроцентовНач/100; 
	Если ВидОкругленияСуммыПроцентов = Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеПослеУмноженияНаКоличествоДней Тогда
	    ОбластьМакета.Параметры.ПроцентыДень = Формат(СуммаПроцентовДеньНач, "ЧЦ=15; ЧДЦ=5");  
	Иначе  
		ОбластьМакета.Параметры.ПроцентыДень = Формат(СуммаПроцентовДеньНач, "ЧЦ=15; ЧДЦ=2"); 
	КонецЕсли;	
	ОбластьМакета.Параметры.ПроцентыСрок = Формат(СуммаПроцентовСрок, "ЧЦ=15; ЧДЦ=2");  
	ОбластьМакета.Параметры.СуммаВсего = Формат(СуммаЗаймаНач + СуммаПроцентовСрок, "ЧЦ=15; ЧДЦ=2");
	ОбластьМакета.Параметры.Акция = ЗалоговыйБилет.Акция;
	ОбластьМакета.Параметры.Промокод = ЗалоговыйБилет.Промокод;
	ОбластьМакета.Параметры.Предъявитель = ?(ЗалоговыйБилет.Предъявитель, "V", ""); 
	СтруктураВ = ПолучитьСуммуЗаймовДень();   
	Если НЕ СтруктураВ = неопределено Тогда 
		ОбластьМакета.Параметры.СуммаДень = СтруктураВ.Сумма; 
		ОбластьМакета.Параметры.ЗБДень = СтруктураВ.НомераЗБ;
	КонецЕсли;	
	ДатаОплаты = ПолучитьДатуПоследнейОплатыЗБ();
	Если НЕ ДатаОплаты = неопределено тогда
		ОбластьМакета.Параметры.ДатаОплатыЗБ = Формат(ДатаОплаты , "ДФ=dd.MM.yyyy"); 
		Если НЕ (СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт ИЛИ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Реализован) Тогда
		    ОбластьМакета.Параметры.ДатаОплКолДней = (НачалоДня(ТекущаяДатаСеанса()) - НачалоДня(ДатаОплаты)) / (60 * 60 * 24); 
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ (СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт ИЛИ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Реализован ИЛИ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления) Тогда 
		ЗаймДни = (НачалоДня(ТекущаяДатаСеанса()) - НачалоДня(ЗалоговыйБилет.Дата)) / (60 * 60 * 24);  
		Если (ЗаймДни < ПредельныйСрокЗаймаДни) Тогда
			ОбластьМакета.Параметры.ЗаймДни = Строка(ЗаймДни); 	
        Иначе
			Если НЕ (статусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение ИЛИ
			         статусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВПутиОХ ИЛИ
				     статусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ГотовКОтправкеОХ) тогда 
			    ОбластьМакета.Параметры.ЗаймДни = Строка(ЗаймДни) + " (достигнут ПСЗ)"; 	
			Иначе     
				ОбластьМакета.Параметры.ЗаймДни = Строка(ЗаймДни);
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли НЕ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда
	    ДатаВыкупаРеализации = ПолучитьДатуВыкупаРеализации();   
		Если НЕ ДатаВыкупаРеализации = неопределено Тогда
			ЗаймДни = (НачалоДня(ДатаВыкупаРеализации) - НачалоДня(ЗалоговыйБилет.Дата)) / (60 * 60 * 24); 
			ОбластьМакета.Параметры.ЗаймДни = Строка(ЗаймДни);
		КонецЕсли;	
	КонецЕсли;	    
	Если НЕ ЗалоговыйБилет.СхемаКредитования.БезПродленияДоговора Тогда
		ОбластьМакета.Параметры.ТекДатаВозврата = Формат(ДатаВыкупа, "ДФ=dd.MM.yyyy"); 
		ОбластьМакета.Параметры.ТекДатаВозвратаЛьготная = Формат(ДатаВыкупаЛьготныйСрок, "ДФ=dd.MM.yyyy");  
	КонецЕсли;	
	ОбластьМакета.Параметры.ТекСуммаСсуды = Формат(СуммаЗайма, "ЧЦ=15; ЧДЦ=2"); 
	Если НЕ (СуммаЗайма = 0 ИЛИ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Реализован) Тогда 
		Если НачисленияОстановлены Тогда
			НачисленоВозврат = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(, ЗалоговыйБилет); 
			ОбластьМакета.Параметры.ТекПроцентыСрок = НачисленоВозврат;  
			ОбластьМакета.Параметры.ТекПроцентыДень = "0,00";
		Иначе	
			ТаблицаНачислений = РасчитатьДолгПоПроцентам(ДатаВыкупа, СуммаЗайма, ПричинаПрименения, ДатаНачалаРасчетаПроцентов); 
			НачисленоВозврат = ТаблицаНачислений.Итог("СуммаПроцентов");
			ОбластьМакета.Параметры.ТекПроцентыСрок = НачисленоВозврат;
			СтрДоп = ТаблицаНачислений.Получить(0);
			СтавкаП = СтрДоп.ПроцентнаяСтавкаБазовая;
			Если НЕ СтавкаП = 0 Тогда
				Если СтрДоп.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
					Если НЕ СтрДоп.ПроцентнаяСтавкаАкция = 0 Тогда
						СтавкаП = СтрДоп.ПроцентнаяСтавкаАкция;
					ИначеЕсли НЕ СтрДоп.ОтклонениеАкцияОтносительное = 0 Тогда	 
						СтавкаП = СтрДоп.ПроцентнаяСтавкаБазовая + СтрДоп.ПроцентнаяСтавкаБазовая*СтрДоп.ОтклонениеАкцияОтносительное/100;
					ИначеЕсли НЕ СтрДоп.ОтклонениеАкцияАбсолютное = 0 Тогда
						СтавкаП = СтрДоп.ПроцентнаяСтавкаБазовая + СтрДоп.ОтклонениеАкцияАбсолютное;
				    КонецЕсли; 
				КонецЕсли;	   
				Если ВидОкругленияСуммыПроцентов = Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеПослеУмноженияНаКоличествоДней Тогда
			        ОбластьМакета.Параметры.ТекПроцентыДень = Формат(СуммаЗайма*СтавкаП/100, "ЧЦ=15; ЧДЦ=5");  
				Иначе  
					ОбластьМакета.Параметры.ТекПроцентыДень = Формат(СуммаЗайма*СтавкаП/100, "ЧЦ=15; ЧДЦ=2");
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;		
		ОбластьМакета.Параметры.ТекСуммаВсего = СуммаЗайма + НачисленоВозврат; 
	КонецЕсли;	
	
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	Если НЕ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда  
		ОбластьМакета = Макет.ПолучитьОбласть("Расчет");
		ТаблицаОплат = ПолучитьНачислениеОплатуЗБ();
		НачисленоПроценты = 0; 
		ОплаченоПроценты = 0;

		Отбор = Новый Структура;
		Отбор.Вставить("ВидРасчета", Перечисления.ЛБ_ВидыРасчетов.ПоПроцентам);
		Строки = ТаблицаОплат.Найтистроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.получить(0);
			НачисленоПроценты = Стр.Начислено; 
			ОплаченоПроценты = Стр.Оплачено;
		КонецЕсли;	
		
		Если НЕ СуммаЗайма = 0 И НЕ НачисленияОстановлены Тогда
			ТаблицаНачислений = РасчитатьДолгПоПроцентам(ТекущаяДатаСеанса(), СуммаЗайма, ПричинаПрименения, ДатаНачалаРасчетаПроцентов); 
			НачисленоПроценты = НачисленоПроценты + ТаблицаНачислений.Итог("СуммаПроцентов");
		КонецЕсли;	
		
		ОплаченоЗайм = 0;

		Отбор = Новый Структура;
		Отбор.Вставить("ВидРасчета", Перечисления.ЛБ_ВидыРасчетов.ПоОсновномуДолгу);
		Строки = ТаблицаОплат.Найтистроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.получить(0);
			ОплаченоЗайм = Стр.Оплачено;
		КонецЕсли;	
		
		ОбластьМакета.Параметры.НачисленоЗайм = СуммаЗаймаНач;
		ОбластьМакета.Параметры.ОплаченоЗайм = ОплаченоЗайм;
		ДолгЗайм = СуммаЗаймаНач - ОплаченоЗайм;
		ОбластьМакета.Параметры.ДолгЗайм = ДолгЗайм;
		
		ОбластьМакета.Параметры.НачисленоПроценты = НачисленоПроценты; 
		ОбластьМакета.Параметры.ОплаченоПроценты = ОплаченоПроценты; 
		ДолгПроценты = НачисленоПроценты - ОплаченоПроценты;
		ОбластьМакета.Параметры.ДолгПроценты = ДолгПроценты; 
		
		ОбластьМакета.Параметры.НачисленоВсего = СуммаЗаймаНач + НачисленоПроценты;
		ОбластьМакета.Параметры.ОплаченоВсего = ОплаченоЗайм + ОплаченоПроценты;
		ОбластьМакета.Параметры.ДолгВсего = ДолгЗайм + ДолгПроценты;
		
		ТабличныйДокумент.Вывести(ОбластьМакета); 
	КонецЕсли;	
	
	ЗаполнитьТовары();
	ОбластьМакета = Макет.ПолучитьОбласть("ПредметыЗалогаШапка"); 
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	Дефекты.Очистить();
	Для каждого стр Из ЗалоговыйБилет.Дефекты Цикл
		НоваяСтрД = Дефекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрД, стр);
	Конеццикла;	 
		
	Для каждого Стр Из Товары Цикл    	
        ОбластьМакета = Макет.ПолучитьОбласть("ПредметыЗалогаСтрока");
		ОбластьМакета.Параметры.Артикул = Стр.Артикул; 
		ОбластьМакета.Параметры.Статус = Стр.Статус;
		ОбластьМакета.Параметры.Изделие = Стр.ВидИзделия; 
		ОбластьМакета.Параметры.Проба = Стр.Проба; 
		ОбластьМакета.Параметры.Категория = Стр.Категория;	
        ОбластьМакета.Параметры.Клеймо = Стр.Клеймо;
		ОбластьМакета.Параметры.Состояние = Стр.СостояниеИзделия; 
		//ОбластьМакета.Параметры.Вставки = Стр.ЕстьВставки;
		//ОбластьМакета.Параметры.ДопМеталлы = Стр.ЕстьДопМеталлы;
		//ОбластьМакета.Параметры.Дефекты = Стр.ЕстьДеффекты;  
		Если Стр.ЕстьДеффекты Тогда
			ВидыДефектов = "";
			
			ОтборД = Новый Структура;
			ОтборД.Вставить("КлючСтроки", Стр.КлючСтроки);
			СтрокиД = Дефекты.НайтиСтроки(ОтборД);
			
			Для каждого СтрД Из СтрокиД Цикл
			    ВидыДефектов = ВидыДефектов + ?(Пустаястрока(ВидыДефектов), "", "; ") + сокрЛП(СтрД.Дефект);
			КонецЦикла;	  
			ОбластьМакета.Параметры.ВидыДефектов = ВидыДефектов;
		КонецЕсли;	   
		ОбластьМакета.Параметры.Описание = Стр.Описание;
		ОбластьМакета.Параметры.Кол = Стр.Количество;
		ОбластьМакета.Параметры.Вес = Стр.Вес;
		ОбластьМакета.Параметры.ВесМет = Стр.ВесЧистый;	
		ОбластьМакета.Параметры.Цена = Стр.Цена; 
		Если СотрудникЦО Тогда
			СтруктураМ = Новый структура;
		    СтруктураМ.Вставить("Вид", 2);  
		 	ОбластьМакета.Параметры.СтруктураМ = СтруктураМ;  
		КонецЕсли;	
		ОбластьМакета.Параметры.ОценкаМеталл = Стр.СуммаОценкиМеталлы;	
		ОбластьМакета.Параметры.ОценкаВставки = Стр.СуммаОценкиКамни;	
		ОбластьМакета.Параметры.ОценкаВсего = Стр.СуммаОценки;	
		ОбластьМакета.Параметры.ОценкаМакс = Стр.СуммаОценкиМаксимальная;
		Если НЕ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда
			ОбластьМакета.Параметры.СуммаЗайма = Стр.СуммаСсуды;	
			ОбластьМакета.Параметры.Оплачено = Стр.Оплачено;	
			ОбластьМакета.Параметры.Долг = Стр.Долг;			 
	    КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Этикетка) Тогда 
		    СтруктураЭ = Новый структура;
		    СтруктураЭ.Вставить("Вид", 10);  
		    СтруктураЭ.Вставить("Этикетка", Стр.Этикетка);
		    ОбластьМакета.Параметры.СтруктураЭ = СтруктураЭ; 
		КонецЕсли;   
		ТабличныйДокумент.Вывести(ОбластьМакета);
		Если НЕ Стр.ЕстьВставки Тогда 
			ТабличныйДокумент.Области.ПредметыЗалогаСтрока.ЦветФона = webЦвета.Белый; 
			ТабличныйДокумент.Области.Вставки.Картинка = неопределено;
		КонецЕсли;	     
		Если НЕ Стр.ЕстьДеффекты Тогда 
			ТабличныйДокумент.Области.Дефекты.Картинка = неопределено;
		КонецЕсли;  
		Если НЕ Стр.ЕстьЭтикетка Тогда 
			ТабличныйДокумент.Области.Этикетка.Картинка = неопределено;
		КонецЕсли;
		Если НЕ Стр.ЕстьДопМеталлы Тогда 
			ТабличныйДокумент.Области.ДопМеталлы.Картинка = неопределено;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Стр.Этикетка) Тогда 
			ТабличныйДокумент.Области.Скан.Картинка = неопределено;
		КонецЕсли;
	КонецЦикла;	                        
		
	ОбластьМакета = Макет.ПолучитьОбласть("ПредметыЗалогаИтого");
	ОбластьМакета.Параметры.Кол = Товары.Итог("Количество");
	ОбластьМакета.Параметры.Вес = Товары.Итог("Вес");
	ОбластьМакета.Параметры.ВесМет = Товары.Итог("ВесЧистый");	
	ОбластьМакета.Параметры.ОценкаМеталл = Товары.Итог("СуммаОценкиМеталлы");	
	ОбластьМакета.Параметры.ОценкаВставки = Товары.Итог("СуммаОценкиКамни");
	ОбластьМакета.Параметры.ОценкаВсего = Товары.Итог("СуммаОценки");
	ОбластьМакета.Параметры.ОценкаМакс = Товары.Итог("СуммаОценкиМаксимальная");
	Если НЕ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда
		ОбластьМакета.Параметры.СуммаЗайма = Товары.Итог("СуммаСсуды");	
		ОбластьМакета.Параметры.Оплачено = Товары.Итог("Оплачено");	
		ОбластьМакета.Параметры.Долг = Товары.Итог("Долг");	
	КонецЕсли;	

	ТабличныйДокумент.Вывести(ОбластьМакета);    
	
	Вставки.Очистить();
	Для каждого стр Из ЗалоговыйБилет.Вставки Цикл
		НоваяСтр = Вставки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;	   
	ДополнительныеМеталлы.Очистить();
    Для каждого стр Из ЗалоговыйБилет.ДополнительныеМеталлы Цикл
		НоваяСтр = ДополнительныеМеталлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;

	Если НЕ Вставки.Количество() = 0 Тогда  
		ОбластьМакета = Макет.ПолучитьОбласть("ВставкиШапка"); 
	    ТабличныйДокумент.Вывести(ОбластьМакета); 
		
		ОбластьМакета = Макет.ПолучитьОбласть("ВставкиСтрока"); 
		Для каждого Стр Из Вставки Цикл  
			Отбор = Новый Структура;
		    Отбор.Вставить("КлючСтроки", стр.КлючСтроки); 
			СтрокиТ = Товары.НайтиСтроки(Отбор);
			Если НЕ СтрокиТ.Количество() = 0 Тогда 
				ОбластьМакета.Параметры.Артикул = СтрокиТ.Получить(0).Артикул; 
			КонецЕсли;                                                        
			ОбластьМакета.Параметры.НеОценивать = стр.НеОценивать;
			ОбластьМакета.Параметры.ВидВставки = стр.ВидВставки;
			ОбластьМакета.Параметры.ФормаОгранки = стр.ФормаОгранки;
			ОбластьМакета.Параметры.ВидОгранки = стр.ВидОгранки;
			ОбластьМакета.Параметры.КачествоОгранки = стр.КачествоОгранки;
			ОбластьМакета.Параметры.Размер = Стр.ОписаниеРазмера;
			ОбластьМакета.Параметры.Ед = Стр.ЕдиницаИзмерения;
			ОбластьМакета.Параметры.Кол  = Стр.Количество;	
			ОбластьМакета.Параметры.ВесКар = Стр.Вес;	
			ОбластьМакета.Параметры.ВесГр = Стр.ВесГраммы;	
			ОбластьМакета.Параметры.Оценка = Стр.Цена; 
			Если НЕ Стр.Цена = 0 И СотрудникЦО Тогда
				СтруктураВ = Новый структура;
			    СтруктураВ.Вставить("Вид", 3);  
			 	ОбластьМакета.Параметры.СтруктураВ = СтруктураВ;  
			КонецЕсли;	
			ОбластьМакета.Параметры.ОценкаВсего = Стр.Сумма;
			ТабличныйДокумент.Вывести(ОбластьМакета);   
		КонецЦикла;    
		ОбластьМакета = Макет.ПолучитьОбласть("ВставкиИтого"); 
		ОбластьМакета.Параметры.Кол  = Вставки.Итог("Количество");	
		ОбластьМакета.Параметры.ВесКар = Вставки.Итог("Вес");	
		ОбластьМакета.Параметры.ВесГр = Вставки.Итог("ВесГраммы");		
		ОбластьМакета.Параметры.ОценкаВсего = Вставки.Итог("Сумма"); 
		ТабличныйДокумент.Вывести(ОбластьМакета); 
	КонецЕсли;
	
	Если НЕ ДополнительныеМеталлы.Количество() = 0 Тогда  
		ОбластьМакета = Макет.ПолучитьОбласть("ДопМетШапка"); 
	    ТабличныйДокумент.Вывести(ОбластьМакета); 
		
		ОбластьМакета = Макет.ПолучитьОбласть("ДопМетСтрока"); 
		Для каждого Стр Из ДополнительныеМеталлы Цикл  
			Отбор = Новый Структура;
		    Отбор.Вставить("КлючСтроки", стр.КлючСтроки); 
			СтрокиТ = Товары.НайтиСтроки(Отбор);
			Если НЕ СтрокиТ.Количество() = 0 Тогда 
				ОбластьМакета.Параметры.Артикул = СтрокиТ.Получить(0).Артикул; 
			КонецЕсли;                                                        
			ОбластьМакета.Параметры.Проба = Стр.Проба;
			ОбластьМакета.Параметры.Ед = Стр.ЕдиницаИзмерения;
			ОбластьМакета.Параметры.ВесМет = Стр.ВесЧистый;	
			ОбластьМакета.Параметры.Оценка = Стр.Цена;	
			Если СотрудникЦО Тогда
				СтруктураМДоп = Новый структура;
			    СтруктураМДоп.Вставить("Вид", 4);                 
			 	ОбластьМакета.Параметры.СтруктураМДоп = СтруктураМДоп;  
			КонецЕсли;	
			ОбластьМакета.Параметры.ОценкаВсего = Стр.СуммаОценкиМеталлы;
			ТабличныйДокумент.Вывести(ОбластьМакета);   
		КонецЦикла;    
		ОбластьМакета = Макет.ПолучитьОбласть("ДопМетИтого"); 
		ОбластьМакета.Параметры.ВесМет = ДополнительныеМеталлы.Итог("ВесЧистый");		
		ОбластьМакета.Параметры.ОценкаВсего = ДополнительныеМеталлы.Итог("СуммаОценкиМеталлы"); 
		ТабличныйДокумент.Вывести(ОбластьМакета); 
	КонецЕсли;

	ТабличныйДокумент.Защита = Истина;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	Возврат ТабличныйДокумент;
КонецФункции	

&НаСервере
Процедура ЗаполнитьПоЗБ()
	ИнформацияЗБ = "№ " + СокрЛП(ЗалоговыйБилет.НомерЗалоговогоБилета) + " от " + Формат(ЗалоговыйБилет.Дата, "ДФ=dd.MM.yyyy");  
	Ломбард = ?(НЕ Пустаястрока(ЗалоговыйБилет.Ломбард.НаименованиеПолное), СокрЛП(ЗалоговыйБилет.Ломбард.НаименованиеПолное), СокрЛП(ЗалоговыйБилет.Ломбард.Наименование));   
	ОтказОтВыкупа = ЗалоговыйБилет.ОтказОтВыкупа;
	ОтказОтСМС = НЕ ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ТекущаяДатаСеанса(), ЗалоговыйБилет.Залогодатель);
	СтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ТекущаяДатаСеанса(), ЗалоговыйБилет); 
	ЗаполнитьИнформациюПоЗаемщику();
	СтатусКлиента = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ТекущаяДатаСеанса(), ЗалоговыйБилет.Залогодатель);  
	ПолучитьДопСтатусыКлиента();  
	СтатусыЗалогодателя = ""; 
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл 
		Если СтрС.Используется Тогда 
		    СтатусыЗалогодателя = СтатусыЗалогодателя + ?(ПустаяСтрока(СтатусыЗалогодателя), "", ", ") + СокрЛП(СтрС.Статус);
		конецЕсли;	
	КонецЦикла;	  
	СтатусыЗалогодателя = СтатусыЗалогодателя + ?(ПустаяСтрока(СтатусыЗалогодателя), "", ", ") + сокрЛП(СтатусКлиента);
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьИнформациюПоЗаемщику()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Залогодатель", ЗалоговыйБилет.Залогодатель);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти
                   |ИЗ
                   |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда    
		Фамилия = СокрЛП(Выборка.Фамилия);
		Имя = СокрЛП(Выборка.Имя);
		Отчество = СокрЛП(Выборка.Отчество);
		ФиоЗаемщика = СокрЛП(Фамилия) + " " + СокрЛП(Имя) + ?(НЕ ПустаяСтрока(Отчество), " " + СокрЛП(Отчество), ""); 
		ДатаРождения = Выборка.ДатаРождения;
		СтрокаДатаРождения = Формат(ДатаРождения, "ДЛФ=DD"); 
		Пол = Выборка.Пол;  
		Телефон = Выборка.Телефон;
		АдресПоПрописке = Выборка.АдресПоПрописке;
		ФактическийАдрес = Выборка.ФактическийАдрес; 
		ДатаСмерти = Выборка.ДатаСмерти;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДопСтатусовКлиента() 		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателей.Ссылка КАК Статус
	               |ИЗ
	               |	Справочник.ЛБ_СтатусыЗалогодателей КАК ЛБ_СтатусыЗалогодателей
	               |ГДЕ
	               |	ЛБ_СтатусыЗалогодателей.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ЭтоГруппа = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную = ИСТИНА
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаДопСтатусов.Загрузить(ТаблицаЗапроса); 
	Новаястр = ТаблицаДопСтатусов.Добавить();
	НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
КонецПроцедуры	

&НаСервере
Процедура ПолучитьДопСтатусыКлиента() 
	ЗаполнитьТаблицуДопСтатусовКлиента(); 
	ЭтоСотрудник = Ложь;
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Залогодатель", ЗалоговыйБилет.Залогодатель);  
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса()); 
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1)); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И Статус = &Статус
	               |				И ВЫБОР
	               |					КОГДА СрокДействия = &ПустаяДата
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ВЫБОР
	               |							КОГДА КОНЕЦПЕРИОДА(СрокДействия, ДЕНЬ) < &Дата
	               |								ТОГДА ЛОЖЬ
	               |							ИНАЧЕ ИСТИНА
	               |						КОНЕЦ
	               |				КОНЕЦ) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Период УБЫВ";
	Для каждого Стр Из ТаблицаДопСтатусов Цикл  
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется; 
			Если Выборка.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник Тогда  
				Если стр.Используется Тогда 
					ЭтоСотрудник = Истина;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;   
	
	Если ЭтоСотрудник Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

