&НаКлиенте
Процедура ТаблицыЗалоговогоБилетаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;    
		Если Расшифровка.Вид = 1 Тогда 
			ПараметрыФормы = Новый Структура;   
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
			ПараметрыФормы.Вставить("Установить", ПредопределенноеЗначение("Перечисление.ЛБ_УстановитьВПриказе.Ставки")); 
			ОткрытьФорму("РегистрСведений.ЛБ_ПриказыВОперацияхЗайма.Форма.ФормаПросмотра", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли Расшифровка.Вид = 2 Тогда 
			ПараметрыФормы = Новый Структура;   
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
			ПараметрыФормы.Вставить("Установить", ПредопределенноеЗначение("Перечисление.ЛБ_УстановитьВПриказе.Металлы")); 
			ОткрытьФорму("РегистрСведений.ЛБ_ПриказыВОперацияхЗайма.Форма.ФормаПросмотра", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли Расшифровка.Вид = 3 Тогда 
			ПараметрыФормы = Новый Структура;   
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
			ПараметрыФормы.Вставить("Установить", ПредопределенноеЗначение("Перечисление.ЛБ_УстановитьВПриказе.Вставки")); 
			ОткрытьФорму("РегистрСведений.ЛБ_ПриказыВОперацияхЗайма.Форма.ФормаПросмотра", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли Расшифровка.Вид = 4 Тогда 
			ПараметрыФормы = Новый Структура;   
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
			ПараметрыФормы.Вставить("Установить", ПредопределенноеЗначение("Перечисление.ЛБ_УстановитьВПриказе.Металлы")); 
			ОткрытьФорму("РегистрСведений.ЛБ_ПриказыВОперацияхЗайма.Форма.ФормаПросмотра", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		ИначеЕсли Расшифровка.Вид = 10 Тогда 
			Если ЗначениеЗаполнено(Расшифровка.Этикетка) тогда
				СсылкаНаЭтикетку = Расшифровка.Этикетка;
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Ключ", СсылкаНаЭтикетку); 
				ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
				ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьИзмененныйМакет(ИмяМакета, ИсходныйМакет = "")
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_МакетыПечатныхФормСрезПоследних.Макет КАК Макет
		|ИЗ
		|	РегистрСведений.ЛБ_МакетыПечатныхФорм.СрезПоследних(&Период, ИсходныйМакет = &ИсходныйМакет) КАК ЛБ_МакетыПечатныхФормСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_МакетыПечатныхФормСрезПоследних.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Период", ТекущаяУниверсальнаяДата());
		Запрос.УстановитьПараметр("ИсходныйМакет", ИсходныйМакет);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Макет = Выборка.Макет.Получить();
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПользовательскиеМакетыПечати.Макет КАК Макет,
			|	ПользовательскиеМакетыПечати.Использование КАК Использование
			|ИЗ
			|	РегистрСведений.ПользовательскиеМакетыПечати КАК ПользовательскиеМакетыПечати
			|ГДЕ
			|	ПользовательскиеМакетыПечати.ИмяМакета = &ИмяМакета";
			
			Запрос.УстановитьПараметр("ИмяМакета", ИмяМакета);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Если Выборка.Использование Тогда
					Макет = Выборка.Макет.Получить();
				Иначе	
					Макет = ПолучитьОбщийМакет(ИмяМакета);
				КонецЕсли;
			Иначе
				Макет = ПолучитьОбщийМакет(ИмяМакета);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Макет;
		
КонецФункции 

&НаСервере
Функция НаименованиеОрганизации()
	
	Результат = Новый Структура("НаименованиеПолное, НаименованиеСокращенное", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛБ_ОсновнаяОрганизация.Значение.НаименованиеПолное КАК НаименованиеПолное,
	|	ЛБ_ОсновнаяОрганизация.Значение.НаименованиеСокращенное КАК НаименованиеСокращенное
	|ИЗ
	|	Константа.ЛБ_ОсновнаяОрганизация КАК ЛБ_ОсновнаяОрганизация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ЛБ_ОсновнаяОрганизация.Значение = Организации.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат.НаименованиеПолное      = Выборка.НаименованиеПолное;
		Результат.НаименованиеСокращенное = Выборка.НаименованиеСокращенное;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
