
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ЗалоговыйБилет") тогда         
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		Если НЕ ТекПользователь.ЭтоЛомбард Тогда 
			Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
				СотрудникЦО = Истина;
			КонецЕсли;	 
		КонецЕсли;  
		
		Если Пользователи.ТекущийПользователь().ЭтоЛомбард Тогда
	        ТекущийЛомбард = ПараметрыСеанса.ТекущийЛомбард; 
		Иначе
			ТекущийЛомбард = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(Пользователи.ТекущийПользователь());
		КонецЕсли;	

		ЗалоговыйБилет = Параметры.ЗалоговыйБилет; 
		Залогодатель = ЗалоговыйБилет.Залогодатель; 
		НомерЗалоговогоБилета = ЗалоговыйБилет.НомерЗалоговогоБилета;
		ПолучитьУсловияКредита(); 
		ПолучитьСостояниеЗБНач();
		ПолучитьСостояниеЗБ();
		ЗаполнитьПоЗБ();    		
		ТаблицыЗалоговогоБилета = ЗаполнитьИнформациюПоЗБ();
	Иначе     
		ОбщегоНазначения.СообщитьПользователю("Залоговый билет не выбран");
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ПолучитьСостояниеЗБНач()
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("Дата", ЗалоговыйБилет.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерДопСоглашения КАК НомерДопСоглашения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
		СуммаЗаймаНач = Выборка.СуммаЗайма;
		ДатаНачалаРасчетаПроцентовНач = Выборка.ДатаНачалаРасчетаПроцентов;
		ДатаВыкупаНач = Выборка.ДатаВыкупа;
		ДатаВыкупаЛьготныйСрокНач = Выборка.ДатаВыкупаЛьготныйСрок;
		СуммаПроцентовДень = Выборка.СуммаПроцентовДень;
        СуммаПроцентовСрок = Выборка.СуммаПроцентовСрок;
        ПредельныйСрокЗайма = Выборка.ПредельныйСрокЗайма;
		ПредельныйСрокЗаймаДни = Выборка.ПредельныйСрокЗаймаДни;
    КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ПолучитьСостояниеЗБ()
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерДопСоглашения КАК НомерДопСоглашения,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаОстановкиНачислений КАК ДатаОстановкиНачислений
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		ПричинаПрименения = Выборка.ПричинаПрименения;
		СуммаЗайма = Выборка.СуммаЗайма;
		ДатаНачалаРасчетаПроцентов = Выборка.ДатаНачалаРасчетаПроцентов;
		ДатаВыкупа = Выборка.ДатаВыкупа;
		ДатаВыкупаЛьготныйСрок = Выборка.ДатаВыкупаЛьготныйСрок; 
		ДатаОстановкиНачислений = Выборка.ДатаОстановкиНачислений;
    КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ПолучитьУсловияКредита() 
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Организация", ЗалоговыйБилет.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.НачислятьПроцентыЗаДеньЗалога КАК НачислятьПроцентыЗаДеньЗалога,
	               |	УсловияПредоставленияКредита.НеНачислятьПроцентыЗаПоследнийДень КАК НеНачислятьПроцентыЗаПоследнийДень,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуПроценты КАК ОкруглятьПроценты,
	               |	УсловияПредоставленияКредита.ПорядокОкругленияПроценты КАК ПорядокОкругления,
	               |	УсловияПредоставленияКредита.ОкруглятьВБольшуюСторонуПроценты КАК ОкруглятьВБольшуюСторону,
	               |	УсловияПредоставленияКредита.ВидОкругленияСуммыПроцентов КАК ВидОкругленияСуммыПроцентов,
	               |	УсловияПредоставленияКредита.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа КАК СчитатьПроцентыДеньВыдачиРавенДеньВыкупа,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуОценка КАК ОкруглятьОценка
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(, Организация = &Организация) КАК УсловияПредоставленияКредита";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
		НачислятьПроцентыЗаДеньЗалога = Выборка.НачислятьПроцентыЗаДеньЗалога;
		НеНачислятьПроцентыЗаПоследнийДень = Выборка.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Выборка.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
		ОкруглятьПроценты = Выборка.ОкруглятьПроценты;
		ПорядокОкругления = Выборка.ПорядокОкругления;
        ОкруглятьВБольшуюСторону = Выборка.ОкруглятьВБольшуюСторону;
        ВидОкругленияСуммыПроцентов = Выборка.ВидОкругленияСуммыПроцентов;
		ОкруглятьЦены = Выборка.ОкруглятьОценка;
    КонецЕсли;
КонецПроцедуры 

&НаСервере
Функция ПолучитьПроцентнуюСхему()   
	ПроцентнаяСтавка = 0;
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГрафикПлатежей.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_ГрафикПлатежей.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
	               |	ЛБ_ГрафикПлатежей.ВидПроцентнойСтавки КАК ВидПроцентнойСтавки,
	               |	ЛБ_ГрафикПлатежей.ПроцентнаяСтавкаБазовая КАК ПроцентнаяСтавкаБазовая,
	               |	ЛБ_ГрафикПлатежей.ПроцентнаяСтавкаАкция КАК ПроцентнаяСтавкаАкция,
	               |	ЛБ_ГрафикПлатежей.ОтклонениеАкцияОтностельное КАК ОтклонениеАкцияОтностельное,
	               |	ЛБ_ГрафикПлатежей.ОтклонениеАкцияАбсолютное КАК ОтклонениеАкцияАбсолютное
	               |ИЗ
	               |	РегистрСведений.ЛБ_ГрафикПлатежей КАК ЛБ_ГрафикПлатежей
	               |ГДЕ
	               |	ЛБ_ГрафикПлатежей.Регистратор = &Регистратор"; 
	ГрафикПлатежей = Запрос.Выполнить().Выгрузить();
	ОтборС = Новый Структура;
	ОтборС.Вставить("ПричинаПрименения", Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма);
	СтрокиС = ГрафикПлатежей.НайтиСтроки(ОтборС); 
	Если НЕ СтрокиС.Количество() = 0 Тогда 
		СтрС = СтрокиС.Получить(0);	
		Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая Тогда 
			ПроцентнаяСтавка = СтрС.ПроцентнаяСтавкаБазовая;
		ИначеЕсли СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда	
			Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда 
				ПроцентнаяСтавка = СтрС.ПроцентнаяСтавкаАкция;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
				ПроцентнаяСтавка = СтрС.ПроцентнаяСтавкаБазовая + СтрС.ОтклонениеАкцияАбсолютное;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда
				ПроцентнаяСтавка = СтрС.ПроцентнаяСтавкаБазовая + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	Возврат ПроцентнаяСтавка;
КонецФункции

&НаСервере
Функция ПолучитьСуммуПроцентов()   
	СуммаПроцентов = 0;  
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);  
	Запрос.УстановитьПараметр("Дата", ЗалоговыйБилет.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовСрок КАК СуммаПроцентов
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
		Возврат Выборка.СуммаПроцентов;
    КонецЕсли;
  	Возврат СуммаПроцентов;
КонецФункции	

&НаСервере
Функция ПолучитьПСКГод()
    СрокРасчета = (ДатаВыкупаНач - НачалоДня(ЗалоговыйБилет.Дата))/(24*60*60);  
	СуммаПроцентовЗБ = ПолучитьСуммуПроцентов();
	Возврат ЛБ_УправлениеЛомбардом.РасчетПСКГод(ЗалоговыйБилет.Дата, СрокРасчета, ЗалоговыйБилет.СуммаСсуды, СуммаПроцентовЗБ);
КонецФункции   

&НаСервере
Функция ПолучитьСуммуЗаймовДень()
	 СуммироватьЗаймыЗаДень = ЛОЖЬ;
	 Запрос = новый Запрос;  
	 Запрос.УстановитьПараметр("Дата", ЗалоговыйБилет.Дата);
	 Запрос.Текст = "ВЫБРАТЬ
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Настройка КАК Настройка,
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Значение КАК Значение
	                |ИЗ
	                |	РегистрСведений.ЛБ_НастройкаЗайма.СрезПоследних(&Дата, ) КАК ЛБ_НастройкаЗаймаСрезПоследних";
	 НастройкиЗайма = Запрос.Выполнить().Выгрузить();
	 Отбор = новый структура;
	 Отбор.Вставить("Настройка", Перечисления.ЛБ_ТипыНастроекЗайма.СуммироватьЗаймыЗаДень);
	 СтрокиН = НастройкиЗайма.НайтиСтроки(Отбор);
	 Если НЕ СтрокиН.Количество() = 0 Тогда
	    Если СтрокиН.Получить(0).Значение Тогда 
		    СуммироватьЗаймыЗаДень = Истина;
		КонецЕсли;	 
	 КонецЕсли;	    
	
	 СтруктураВ = Новый структура;
	 СтруктураВ.Вставить("Сумма", 0);
	 СтруктураВ.Вставить("НомераЗБ", "");    
	 
	 Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда
		 Возврат СтруктураВ;
     КонецЕсли;
	 
	 СписокОпераций = Новый СписокЗначений; 
	 СписокОпераций.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
	 СписокОпераций.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление);
	 
	 Запрос = новый Запрос; 
	 Запрос.УстановитьПараметр("Залогодатель", ЗалоговыйБилет.Залогодатель); 
	 Запрос.УстановитьПараметр("Дата1", НачалоДня(ЗалоговыйБилет.Дата)); 
	 Запрос.УстановитьПараметр("Дата2", ЗалоговыйБилет.Дата);  
	 Запрос.УстановитьПараметр("СписокОпераций", СписокОпераций);
	 
	 Запрос.Текст = "ВЫБРАТЬ
	                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор,
	                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                |	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаСсудыОборот) КАК СуммаСсуды
	                |ИЗ
	                |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(
	                |			&Дата1,
	                |			&Дата2,
	                |			Регистратор,
	                |			ВидОперации В (&СписокОпераций)
	                |				И Залогодатель = &Залогодатель) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор,
	                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.ЗалоговыйБилет";  
     Выборка = Запрос.Выполнить().Выбрать();

	 СуммаСсуды = 0;  
	 НомераЗБ = "";
	 Пока Выборка.Следующий() Цикл 
		Если (Выборка.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление) И НЕ (Выборка.ЗалоговыйБилет = ЗалоговыйБилет) Тогда
			Продолжить;
		КонецЕсли;  
		СтатусЗБДень = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ТекущаяДатаСеанса(), Выборка.ЗалоговыйБилет);   
		Если СтатусЗБДень = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда
			 Продолжить;
	    КонецЕсли;

		СуммаСсуды = СуммаСсуды + Выборка.СуммаСсуды;  
		Если НЕ Выборка.Регистратор = ЗалоговыйБилет Тогда
		    НомераЗБ = НомераЗБ + ?(ПустаяСтрока(НомераЗБ), "", ", ") + СокрЛП(Выборка.Регистратор.НомерЗалоговогоБилета);
		КонецЕсли;	
	 КонецЦикла; 
		 
	 СтруктураВ.Сумма = СуммаСсуды;
	 СтруктураВ.НомераЗБ = НомераЗБ; 
	 Возврат СтруктураВ;
КонецФункции	

&НаСервере
Функция СоздатьНовуюОплатуПроцентов(Дата)
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет; 
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	ДокументОбъект.Дата = Дата; 
	ДокументОбъект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	ДокументОбъект.ПроцентнаяСхема = ЗалоговыйБилет.ПроцентнаяСхема;  
	Возврат ДокументОбъект; 
КонецФункции

&НаСервере
Функция РасчитатьДолгПоПроцентам(Дата, СуммаЗайма, ПричинаПримененияПроцентнойСхемы, ДатаНачалаРасчета)
	ДокументОбъект = СоздатьНовуюОплатуПроцентов(Дата); 	    
	
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
	Если НЕ СтруктураП = неопределено Тогда
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
	Иначе
		ПредельноеЗначениеПроцентов = 0;
	КонецЕсли;   
	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр); 
	
	Возврат ДокументОбъект.НачислениеПроцентовДетально;
КонецФункции

&НаСервере
Функция ПолучитьДокументОтмены(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|ГДЕ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент В(&ЗБ)";
	
	Запрос.УстановитьПараметр("ЗБ", Ссылка);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция  ПолучитьДатуПоследнейОплатыЗБ()
	 Запрос = новый Запрос; 
	 Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
     Запрос.Текст = "ВЫБРАТЬ
                    |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Период КАК Период,
                    |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор
                    |ИЗ
                    |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(
                    |			,
                    |			,
                    |			Регистратор,
                    |			ЗалоговыйБилет = &ЗалоговыйБилет
                    |				И (ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)
                    |					ИЛИ ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление))) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
                    |ГДЕ
                    |	НЕ ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор = &ЗалоговыйБилет
                    |
                    |УПОРЯДОЧИТЬ ПО
                    |	Период УБЫВ";
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл 
		 Если ПолучитьДокументОтмены(Выборка.Регистратор) тогда 
			 Продолжить;
		 КонецЕсли;	 
		 Возврат Выборка.Период;
	 КонецЦикла;
	 Возврат неопределено;
КонецФункции  

&НаСервере
Функция  ПолучитьНачислениеОплатуЗБ()
	Запрос = новый Запрос; 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст ="ВЫБРАТЬ
