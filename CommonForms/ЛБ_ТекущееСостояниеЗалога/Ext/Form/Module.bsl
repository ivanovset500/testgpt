		ОписаниеОповещения = новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗалога", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);
