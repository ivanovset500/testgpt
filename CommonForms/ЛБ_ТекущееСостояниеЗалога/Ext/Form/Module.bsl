&НаКлиенте
Процедура ПослеВыбораЗалогодателяПереоформление(Результат,Параметры) Экспорт
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;		
	Иначе             
		Если НЕ Результат.Представитель = Залогодатель Тогда
		    ПроверкаПоПеречням(Результат.Представитель); 
		КонецЕсли;   
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПредыдущаяОперация", Результат.ПредыдущаяОперация); 
		ПараметрыФормы.Вставить("Залогодатель", Результат.Залогодатель);
		ПараметрыФормы.Вставить("ДокументЗалогодателя", Результат.ДокументЗалогодателя); 
		Если Результат.Свойство("Представитель") Тогда  
			ПроверкаПоПеречням(Результат.Представитель);
			ПараметрыФормы.Вставить("Представитель", Результат.Представитель);
			ПараметрыФормы.Вставить("ДокументПредставителя", Результат.ДокументПредставителя);  
		КонецЕсли;	  
		Если Результат.Свойство("ДоверенностьПредставителя") Тогда 
			ПараметрыФормы.Вставить("ДоверенностьПредставителя", Результат.ДоверенностьПредставителя);  
		КонецЕсли;
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеСозданияДокумента", Этаформа);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);
	КонецЕсли;	
КонецПроцедуры	

