		    СтатусыЗалогодателя = СтатусыЗалогодателя + ?(ПустаяСтрока(СтатусыЗалогодателя), "", ", ") + СокрЛП(СтрС.Статус);
		конецЕсли;	
	КонецЦикла;	  
	СтатусыЗалогодателя = СтатусыЗалогодателя + ?(ПустаяСтрока(СтатусыЗалогодателя), "", ", ") + сокрЛП(СтатусКлиента);
