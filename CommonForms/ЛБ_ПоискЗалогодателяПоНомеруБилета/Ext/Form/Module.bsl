		ПараметрыФормы.Вставить("Залогодатель", ТекущаяСтрока.Плательщик);
		ПараметрыФормы.Вставить("ПричинаИзменения", ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИсправлениеДанныхКонтактнаяИнформация")); 
		ПараметрыФормы.Вставить("ЗакрыватьПриСохранении", Истина);
		Если ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда   
			ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе	
		    ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияКлиента(Результат, ДопПараметры) Экспорт
	ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = неопределено Тогда 		
	    ТекущаяСтрокаП = Элементы.Плательщики.ТекущиеДанные;
		Если ТекущаяСтрокаП = неопределено Тогда
			Клиент = ТекущаяСтрока.Залогодатель;
		Иначе
			Клиент = ТекущаяСтрокаП.Плательщик;
		КонецЕсли;						
		Если НЕ ПроверитьДокументыКлиента(Клиент) тогда
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОткрытиеКарточки", ЭтотОбъект); 
	        ПоказатьВопрос(Оповещение, "Открыть карточку клиента?", РежимДиалогаВопрос.ДаНетОтмена, 0,,);
		Иначе  
			ОбработатьВыборКлиента();
		КонецЕсли;	
	КонецЕсли;     	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКлиента() 
	ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = неопределено Тогда
		
		// ++ Сербаев 20.06.2023  разрешаем платить третьим лицам по займам умерших.
		//Если НЕ ТекущаяСтрока.ДатаСмерти = Дата(1,1,1) Тогда
		//	Сообщить("Дата смерти клиента " + Формат(ТекущаяСтрока.ДатаСмерти, "ДФ=dd.MM.yyyy") + ". Выбор не возможен.");
		//	Возврат;
		//КонецЕсли; 
        // -- Сербаев 20.06.2023

	    СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ПредыдущаяОперация", ТекущаяСтрока.ДокументЗалога);
		СтруктураВозврата.Вставить("ВидОперации", ВидОперации);     
		ТекущаяСтрокаП = Элементы.Плательщики.ТекущиеДанные;
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда		
			Если ТекущаяСтрокаП = неопределено Тогда
				СтруктураВозврата.Вставить("Плательщик", ТекущаяСтрока.Залогодатель);
				СтруктураВозврата.Вставить("Доверенность", ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка"));
			Иначе
				СтруктураВозврата.Вставить("Плательщик", ТекущаяСтрокаП.Плательщик);
				СтруктураВозврата.Вставить("Доверенность", ТекущаяСтрокаП.Доверенность);
			КонецЕсли;	       
		ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда  
			Если ТекущаяСтрокаП = неопределено Тогда
				СтруктураВозврата.Вставить("Получатель", ТекущаяСтрока.Залогодатель);
				СтруктураВозврата.Вставить("Доверенность", ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка"));
			Иначе
				СтруктураВозврата.Вставить("Получатель", ТекущаяСтрокаП.Плательщик); 
				СтруктураВозврата.Вставить("Доверенность", ТекущаяСтрокаП.Доверенность);
			КонецЕсли;	
		КонецЕсли;	
		СтруктураВозврата.Вставить("ДокументЗалогодателя", ДокументЗалогодателя);
		ЭтаФорма.Закрыть(СтруктураВозврата);
	КонецЕсли;	                  
КонецПроцедуры

&НаСервере
Процедура ЗаполитьПлательщиков(Идентификатор) 
	Стр = Залогодатели.НайтиПоИдентификатору(Идентификатор);
	Плательщики.Очистить();   
	Если Стр.ДатаСмерти = Дата(1,1,1) Тогда
		НоваяСтр = Плательщики.Добавить();
		НоваяСтр.Плательщик = Стр.Залогодатель; 
		НоваяСтр.Статус = "Клиент";  
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ЗалоговыйБилет", Стр.ДокументЗалога);
	Запрос.УстановитьПараметр("Клиент", Стр.Залогодатель); 	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность.ПредставительКлиента КАК Представитель,
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Клиент = &Клиент) КАК ЛБ_ДоверенностиСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать(); 
	Пока Выборка.Следующий() Цикл  
		Если НЕ Выборка.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			Продолжить; 
		ИначеЕсли НЕ (Стр.ДатаСмерти = Дата(1,1,1)) И НЕ (Выборка.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство) Тогда
			Продолжить;
		КонецЕсли;	 
		Если (Выборка.Доверенность.СрокДействияДоверенности  < ТекущаяДата()) И НЕ (Выборка.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство) Тогда
			Продолжить;
		КонецЕсли;	  
		НоваяСтр = Плательщики.Добавить();
	    НоваяСтр.Плательщик = Выборка.Представитель;
		НоваяСтр.Доверенность = Выборка.Доверенность;     
		Если Выборка.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда 
			НоваяСтр.ДоверенностьСтрока = "Свидетельство о праве на наследство № " + СокрЛП(Выборка.Доверенность.НомерДоверенности) + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy");
		Иначе  	
			НоваяСтр.ДоверенностьСтрока = "Доверенность " + НРег(строка(Выборка.Доверенность.ВидДоверенности)) + " № " +
				   СокрЛП(Выборка.Доверенность.НомерДоверенности) + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
				   " действует до " + Формат(Выборка.Доверенность.СрокДействияДоверенности, "ДФ=dd.MM.yyyy");  
		КонецЕсли;		   
		НоваяСтр.Статус = "Представитель";
	Конеццикла;	
	Если НЕ Плательщики.Количество() = 0 Тогда  
		Элементы.Плательщики.ТекущаяСтрока  = Плательщики[0].ПолучитьИдентификатор();
	КонецЕсли;	
КонецПроцедуры
	
&НаКлиенте
Процедура ЗалогодателиПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элементы.Залогодатели.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		ЗаполитьПлательщиков(ТекСтрока.ПолучитьИдентификатор());  
	КонецЕсли;	
	//+Мельников 25.04.24 Отмена операции. Заполняем последниюю операцию
	Если ТекСтрока <> Неопределено И ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты") Тогда 
		ЗаполитьОперации(ТекСтрока.ПолучитьИдентификатор());  
	КонецЕсли;
	//-Мельников
КонецПроцедуры

