&НаСервере
Функция ПроверитьДокументыКлиента(Клиент) 
	ВсеОК = Истина;      
	Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(Клиент, ТекущаяДата()) = неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Выбранный клиент умер. Операции с клиентом не возможны!");
		Возврат Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Гражданство = Выборка.Гражданство;
		ДокументЗалогодателя = ЛБ_УправлениеЛомбардом.ПроверитьОсновнойДокумент(ТекущаяДата(), Клиент, Гражданство);
		Если НЕ ЗначениеЗаполнено(ДокументЗалогодателя) тогда 
			ОбщегоНазначения.СообщитьПользователю("Основной документ удостоверяющий личность выбранного клиента не найден!");
			ВсеОК = Ложь;
		КонецЕсли;
		Если НЕ Гражданство = Справочники.СтраныМира.Россия тогда 
			ДопДокументы = ЛБ_УправлениеЛомбардом.ПолучитьДокументыПравоПребыванияРФ(ТекущаяДата(), Клиент, Гражданство);
			Если ДопДокументы.Количество() = 0 тогда 
				ОбщегоНазначения.СообщитьПользователю("Не найдены основные документы, подверждающие право клиента на пребывание В РФ!");
				ВсеОК = Ложь;
			КонецЕсли;
		КонецЕсли;	
	Иначе       
		ОбщегоНазначения.СообщитьПользователю("Не определено гражданство выбранного клиента!");
		ВсеОК = Ложь;	
	КонецЕсли;	
	Возврат ВсеОК;
КонецФункции  

