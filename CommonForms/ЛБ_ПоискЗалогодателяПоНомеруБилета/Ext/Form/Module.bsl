			//Было: Иначе
			//-МАН
			   НомерЛомбардаЗБ = ПолучитьНомерЛомбардаЗБ(ТекущаяСтрока.ДокументЗалога);	
			   НомерЛомбарда = ПолучитьНомерЛомбардаПользователя();
