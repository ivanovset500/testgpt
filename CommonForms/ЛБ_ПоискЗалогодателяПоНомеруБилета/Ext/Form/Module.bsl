&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ВидОперации") Тогда
		ВидОперации = Параметры.ВидОперации;
	КонецЕсли;
	Если Параметры.Свойство("Номер") Тогда
		Номер = Параметры.Номер;  
		Элементы.Номер.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Номер.ТолькоПросмотр = Ложь;
	КонецЕсли;
	Если Параметры.Свойство("ЭтоКасса") Тогда
		ЭтоКасса = Параметры.ЭтоКасса;
	КонецЕсли; 
	Если Параметры.Свойство("Ломбард") Тогда
		ТекущийЛомбард = Параметры.Ломбард;
	КонецЕсли;  

	
	Если ЭтоКасса Тогда
		Элементы.Плательщики.Видимость =ложь;
	Иначе	
		Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ПустаяСсылка() Тогда 
			ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
		КонецЕсли;	                                                                   
		
		Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога ИЛИ 
			 ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога ИЛИ 
			 ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОстановкаПроцентов ИЛИ
			 ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога ИЛИ  
			 ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления ИЛИ
			//+Мельников 25.04.24 Отмена операции
			ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты Тогда
			//-Мельников
			Элементы.Плательщики.Видимость =ложь;
		ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление ИЛИ ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога Тогда
			Элементы.ПлательщикиКнопкаСоздать.Видимость =ложь;
		КонецЕсли;
		
		Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога Тогда
			Элементы.ПлательщикиПлательщик.Заголовок = "Получатель"; 
			Элементы.ПлательщикиСтатус.Заголовок = "Статус получателя";
		КонецЕсли;
		//+Мельников 25.04.24 Для отображения последней операции
		Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты Тогда
			Элементы.Операции.Видимость = Истина;
		КонецЕсли;
		//-Мельников   
	КонецЕсли;	
	Если Параметры.Свойство("Номер") Тогда
		Номер = Параметры.Номер;
		НайтиВозможныеВариантыЗалогодатели();
	КонецЕсли;
КонецПроцедуры  


&НаСервере
Процедура НайтиВозможныеВариантыЗалогодатели()
	Если НЕ ПустаяСтрока(Номер) Тогда
		Залогодатели.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Номер", "%"+Номер+"%");		
		//Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		//               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период КАК Период,
		//               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ДокументЗалога,
		//               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет.Залогодатель КАК Залогодатель,
		//               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет.НомерЗалоговогоБилета КАК Номер,
		//               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ДатаРождения КАК ДатаРождения,
		//               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ДатаСмерти КАК ДатаСмерти,
		//               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
		//               |ИЗ
		//               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(, ЗалоговыйБилет.НомерЗалоговогоБилета ПОДОБНО &Номер) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
		//               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателей
		//               |		ПО ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет.Залогодатель = ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель
		//               |
		//               |УПОРЯДОЧИТЬ ПО
		//               |	Период УБЫВ";  	
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет КАК ДокументЗалога,
		               |	ЛБ_СостояниеЗалоговогоБилета.Залогодатель КАК Залогодатель,
		               |	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК Номер,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ДатаРождения КАК ДатаРождения,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателей.ДатаСмерти КАК ДатаСмерти,
		               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
		               |ИЗ
		               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(, ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
		               |		ПО ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателей
		               |		ПО ЛБ_СостояниеЗалоговогоБилета.Залогодатель = ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель
		               |ГДЕ
		               |	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета ПОДОБНО &Номер";  	

		
		Запрос.УстановитьПараметр("Номер", "%"+Номер+"%");
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
				
		Залогодатели.Загрузить(ТаблицаЗапроса); 
		Если НЕ Залогодатели.Количество() = 0  Тогда   
			//проверим возможность выполнения операции  
			Если ЭтоКасса Тогда   
				Элементы.Залогодатели.ТекущаяСтрока  = Залогодатели[0].ПолучитьИдентификатор();
				Возврат;
			КонецЕсли;	
			Для каждого СтрЗ Из Залогодатели Цикл
				Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога Тогда
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение И
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство Тогда 
						СтрЗ.НельзяВыбрать = Истина;
					КонецЕсли;
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда	
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен И
			             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен И 
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен И
                         НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят И
			             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг И
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;   
					Если СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен Тогда
						Если ЛБ_УправлениеЛомбардом.ПроверитьЗалоговыйБилетСогласованКОплате(ТекущаяДатаСеанса(), СтрЗ.ДокументЗалога) Тогда 
							СтрЗ.НельзяВыбрать = Ложь;
						КонецЕсли;	
					КонецЕсли;	
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда	
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен И
			             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен И						 
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг И
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение Тогда
                       СтрЗ.НельзяВыбрать = Истина;
					КонецЕсли;
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОстановкаПроцентов Тогда 
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен И
			             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен И
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство И 
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг Тогда 
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;    
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога Тогда  
					Если НЕ ТекущийЛомбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда	
						Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен И
				             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен И 
							 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение И 
	                         НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят И
				             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен И 
							 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен И
							 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную И  
							 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг И
							 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство Тогда
	                       СтрЗ.НельзяВыбрать = Истина;     
					   КонецЕсли;
					КонецЕсли;   
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога Тогда 
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят И
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство Тогда
                       СтрЗ.НельзяВыбрать = Истина;
			        КонецЕсли;   
                ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВозвратаИзъятого Тогда 
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят И
						НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен И
						НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				   КонецЕсли;   
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВыдачиСОХ Тогда 
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога ИЛИ ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления Тогда 
                    Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;    
                ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОстановкиНачисленияПроцентов Тогда 
                    Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;      
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия Тогда 
                    Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;    
				ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты Тогда 
					Если НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен И
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен И
                         НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят И
			             НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную И  
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг И
						 //+Мельников 20.06.24 Нельзя было выполнить отмену выкупа
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт И
						 //+Мельников 08.07.24 Нельзя было выполнить отмену остановки начислений процентов
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен И
						 //+МАН 20.06.25 Нельзя было выполнить отмену "На ОХ"
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение И
						 //-Мельников
						 НЕ СтрЗ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство Тогда
                       СтрЗ.НельзяВыбрать = Истина;
				    КонецЕсли;   
                КонецЕсли;
			Конеццикла;	
			Элементы.Залогодатели.ТекущаяСтрока  = Залогодатели[0].ПолучитьИдентификатор();
		КонецЕсли;	
	Иначе
		Залогодатели.Очистить();
