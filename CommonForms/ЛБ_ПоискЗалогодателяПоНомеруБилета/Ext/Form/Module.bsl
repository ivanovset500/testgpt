&НаСервере
Функция ПолучитьСписокВыбораПлательщиков() 
	СписокВыбора = Новый СписокЗначений; 

	Отбор = новый Структура;
	Отбор.Вставить("Статус", "Клиент"); 
	СтрокиП = Плательщики.НайтиСтроки(Отбор);  
	Если НЕ СтрокиП.Количество() = 0 Тогда		
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("Клиент", СтрокиП.Получить(0).Плательщик);
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЛБ_ПлательщикиКлиента.Плательщик КАК Плательщик
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПлательщикиКлиента КАК ЛБ_ПлательщикиКлиента
		               |ГДЕ
		               |	ЛБ_ПлательщикиКлиента.Клиент = &Клиент";
		Выборка = Запрос.Выполнить().Выбрать(); 
		Пока Выборка.Следующий() Цикл 
			СписокВыбора.Добавить(Выборка.Плательщик);
		КонецЦикла;  
	КонецЕсли;
	
	Возврат СписокВыбора; 
КонецФункции

&НаКлиенте
Процедура СоздатьПлательщика(Команда)  
	ТекСтрока = Элементы.Залогодатели.ТекущиеДанные;
	СписокВыбора = ПолучитьСписокВыбораПлательщиков();  
	Если СписокВыбора.Количество() = 0 Тогда 
		ПараметрыФормы = новый структура;
		ПараметрыФормы.Вставить("БезДокументов", Истина);
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДругогоПлательщика",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	Иначе	
		СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.ЛБ_Залогодатели.ПустаяСсылка"), "Новый плательщик");
		ВыбранноеЗначение = ВыбратьИзМеню(СписокВыбора, Элементы.Плательщики); 
		Если ВыбранноеЗначение.Значение = ПредопределенноеЗначение("Справочник.ЛБ_Залогодатели.ПустаяСсылка") Тогда	
			ПараметрыФормы = новый структура;
		    ПараметрыФормы.Вставить("БезДокументов", Истина);
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДругогоПлательщика",ЭтаФорма);
			ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);   
		Иначе
			НоваяСтр = Плательщики.Добавить();   
			НоваяСтр.Плательщик = ВыбранноеЗначение.Значение;
			НоваяСтр.Статус = "Третье лицо";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВыбораДругогоПлательщика(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	НоваяСтр = Плательщики.Добавить();   
	НоваяСтр.Плательщик = Результат.Залогодатель;
	НоваяСтр.Статус = "Третье лицо";
КонецПроцедуры	

//+Мельников 25.04.24 Отмена операции
&НаСервере
Процедура ЗаполитьОперации(Идентификатор)
	
	Стр = Залогодатели.НайтиПоИдентификатору(Идентификатор);
	Операции.Очистить();
	
	ПоследняяОперация = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(Стр.Номер, ТекущаяДата(), Истина);
	
	//+Мельников 06.05.24 Сделано на время тестирования. Убрать при запуске ломбардов.
	Если ПоследняяОперация = Неопределено Тогда
		ДатаПроверки = ТекущаяДата() + 94608000; // + три года к дате проверки документа
		ПоследняяОперация = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(Стр.Номер, ДатаПроверки, Истина);
	КонецЕсли;
	//-Мельников

	//+Мельников 19.06.24
	Если ПоследняяОперация <> Неопределено Тогда
		НоваяСтр = Операции.Добавить();
		НоваяСтр.ДатаИНомерДокумента = "От " + ПоследняяОперация.Регистратор.Дата + ", № " + ПоследняяОперация.Регистратор.Номер;
		НоваяСтр.ДокументОперации = ПоследняяОперация.Регистратор;
		НоваяСтр.ВидОперации = ПоследняяОперация.Регистратор.ВидОперации;
		НоваяСтр.СтатусЗБ = ПоследняяОперация.СтатусЗалоговогоБилета;
	КонецЕсли;
	//-Мельников
	
КонецПроцедуры

