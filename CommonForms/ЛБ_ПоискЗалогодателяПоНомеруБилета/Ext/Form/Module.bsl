    	Если НЕ ТекущаяСтрока = Неопределено Тогда
			
			ПоследняяОперация = ПолучитьПоследнююОперацию(ТекущаяСтрока.ПолучитьИдентификатор());
			Если ТекущийЛомбард = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис") Тогда 
				ЛомбардПользователя = ТекущийЛомбард; 
			Иначе	
			    ЛомбардПользователя = ПолучитьЛомбардПольвателя(); 
			КонецЕсли;	
			//+Мельников 19.06.24
			Если ПоследняяОперация <> Неопределено Тогда
				ЛомбардВДокументе = ПолучитьЛомбардВдокументе(ПоследняяОперация.ДокументОперации);
			Иначе
				Залогодатели.Очистить();
				Операции.Очистить();
				Возврат;
			КонецЕсли;
			//-Мельников
			
			Если ПоследняяОперация <> Неопределено Тогда
				
				Если ЛомбардПользователя <> ЛомбардВДокументе Тогда
					Предупреждение("Операция оформлена в другом ломбарде.
					|Действия с документом запрещены!");
					Возврат
				КонецЕсли;

				Если Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") <> Формат(ПоследняяОперация.Дата, "ДФ=dd.MM.yyyy") Тогда
					Предупреждение("Отмена операции возможна только в текущем дне.");
					Возврат
				КонецЕсли;
				
				Если НЕ ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога") И
					 НЕ ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога") Тогда
					Если ТекущаяДата() - ПоследняяОперация.Дата >= 3600 Тогда
						Предупреждение("Прошло больше часа со времени оформления операции. Отмена невозможна.");
						Возврат
					КонецЕсли; 
				КонецЕсли;	

				Если ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВозвратаИзъятого") ИЛИ
					ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога") ИЛИ
					ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия") ИЛИ
					ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты") ИЛИ
					ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОстановкиНачисленияПроцентов") ИЛИ
					ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления") ИЛИ
					ПоследняяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВыдачиСОХ") Тогда

					Предупреждение("Выбран документ с видом операции " + Строка(ПоследняяОперация.ВидОперации) + ". Отмена операции невозможна.", 60);
					ЭтаФорма.Закрыть(); 
					Возврат;
				КонецЕсли;
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("ЗалоговыйБилет", ТекущаяСтрока.ДокументЗалога);
				СтруктураВозврата.Вставить("ВидОперации", ПоследняяОперация.ВидОперации); //ВидОперации
				СтруктураВозврата.Вставить("НомерЗалоговогоБилета", Номер);
				//СтруктураВозврата.Вставить("СтатусЗалоговогоБилета", ТекущаяСтрока.СтатусЗалоговогоБилета);
				ЭтаФорма.Закрыть(СтруктураВозврата);
			КонецЕсли;
		КонецЕсли; 
		//-Мельников
	КонецЕсли;	
	////+МАН 27.10.25
	//Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") //Выдача займа
	//	ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") //Оплата процентов
	//	ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") //Переоформление
	//	ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда //Выдача залога
	//	
	//	ЕстьСовпадение = ПроверитьКлиента(ТекущаяСтрока.Залогодатель);
	//	
	//	Если ЕстьСовпадение Тогда
	//		Возврат;
	//	КонецЕсли;
	//	
	//КонецЕсли;
	////-МАН
КонецПроцедуры 

&НаСервере
Функция ПроверитьВремяОтВыдачиЗБ(Идентификатор) 
	Часы = 0 ;
	СтрЗБ = Залогодатели.НайтиПоИдентификатору(Идентификатор);
	Если НЕ СтрЗБ = неопределено Тогда
	    ЗалоговыйБилет = СтрЗБ.ДокументЗалога;  
	    Часы = (ТекущаяДата() - ЗалоговыйБилет.Дата)/3600;
    КонецЕсли;
    Возврат Часы;
КонецФункции	

&НаСервере
Функция ПроверитьОперацииПоЗалоговомуБилету(Идентификатор)
	СтрЗБ = Залогодатели.НайтиПоИдентификатору(Идентификатор);
	Если НЕ СтрЗБ = неопределено Тогда  
		ЗалоговыйБилет = СтрЗБ.ДокументЗалога; 
		Возврат ЛБ_УправлениеЛомбардом.ПроверитьЕстьОперацииПоЗалоговомуБилету(ТекущаяДата(), ЗалоговыйБилет);
	КонецЕсли;
	Возврат Ложь;
КонецФункции	

&НаКлиенте
Процедура ПослеОтветаНаВопросОткрытиеКарточки(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда  
		ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеИзмененияКлиента",ЭтаФорма);
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", ТекущаяСтрока.Залогодатель);
		ПараметрыФормы.Вставить("ПричинаИзменения", ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИсправлениеДанныхКонтактнаяИнформация")); 
		ПараметрыФормы.Вставить("ЗакрыватьПриСохранении", Истина);  
		Если ЭтаФорма.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда   
			ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе	
		    ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры  

