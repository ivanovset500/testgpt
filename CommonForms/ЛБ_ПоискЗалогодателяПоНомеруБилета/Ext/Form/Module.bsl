Функция ПроверитьИзделияВЦО(ЗалоговыйБилет) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);  
	Запрос.УстановитьПараметр("Ломбард", ТекущийЛомбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаОстатки.Склад КАК Склад,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
	               |			,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Ломбард = &Ломбард) КАК ЛБ_ОбъектыЗалогаОстатки
	               |ГДЕ
	               |	НЕ ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток = 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.Склад,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард,
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОбъектЗалога";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Истина;
	КонецЕсли;	
    Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ВыбратьКлиента()                                                                                           
	ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
	Если ТекущаяСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если ЭтоКасса Тогда
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ЗалоговыйБилет", ТекущаяСтрока.ДокументЗалога);
		СтруктураВозврата.Вставить("Залогодатель", ТекущаяСтрока.Залогодатель);
		ЭтаФорма.Закрыть(СтруктураВозврата);
	КонецЕсли;	
	
	//+МАН 02.12.24 Передвинул выполнение проверок для корректного отробатывания предупреждений. Заявка 2904
	СтруктураНакладной = ПроверитьСтатусНакладной(ТекущаяСтрока.ДокументЗалога); 
	Если СтруктураНакладной = неопределено Тогда
		ЕстьВНакладной = Ложь;
	Иначе	         
		ЕстьВНакладной = Истина;
	    НакладнаяНаОтгрузку = СтруктураНакладной.НакладнаяНаОтгрузку; 
		СтатусНакладной = СтруктураНакладной.СтатусНакладной;
	КонецЕсли;
	//-МАН
	
	Если ТекущаяСтрока.НельзяВыбрать Тогда //+МАН 02.12.24 Добавлено условие на наличие в накладной. Заявка 2904  
		СтрокаСтатус = ?(ЗначениеЗаполнено(ТекущаяСтрока.СтатусЗалоговогоБилета), Строка(ТекущаяСтрока.СтатусЗалоговогоБилета), "не определен");
		//Если НЕ ЕстьВНакладной Тогда
		//	Предупреждение("Статус выбранного залогового билета """ + СтрокаСтатус + """. Выполнение операции невозможно!", 60); //lion 14.08.2025 
		//Иначе	
			Если ТекущаяСтрока.СтатусЗалоговогоБилета = предопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Отгружен") Тогда
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда
				    ТекстПредупреждения = "Внимание! ЗБ № " + СокрЛП(Номер)
					     + " в статусе «Отгружен»." + Символы.ПС + "Для согласования возможности приема оплаты/выкупа обратитесь в ЦО.";
					Предупреждение(ТекстПредупреждения, 60);
		        Иначе
					Предупреждение("Внимание! ЗБ № " + СокрЛП(Номер) + " в статусе «Отгружен». Проведение операции невозможно!", 60);  
				КонецЕсли;	  
			Иначе 			
				Предупреждение("Статус выбранного залогового билета """ + СтрокаСтатус + """. Выполнение операции невозможно!", 60); //lion 14.08.2025
			КонецЕсли;
		//КонецЕсли;	
		Возврат;
	КонецЕсли;	     
	
	//+МАН 02.12.24 Закомментировал и перенес выше. Заявка 2904
	//СтруктураНакладной = ПроверитьСтатусНакладной(ТекущаяСтрока.ДокументЗалога); 
	//Если СтруктураНакладной = неопределено Тогда
	//	ЕстьВНакладной = Ложь;
	//Иначе	         
	//	ЕстьВНакладной = Истина;
	//    НакладнаяНаОтгрузку = СтруктураНакладной.НакладнаяНаОтгрузку; 
	//	СтатусНакладной = СтруктураНакладной.СтатусНакладной;
	//КонецЕсли;
	//-МАН    
	
	//+МАН 27.10.25
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") //Выдача займа
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") //Оплата процентов
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") //Переоформление
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда //Выдача залога
		
		ЕстьСовпадение = ПроверитьКлиента(ТекущаяСтрока.Залогодатель);
		
		Если ЕстьСовпадение Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	//-МАН

	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда
