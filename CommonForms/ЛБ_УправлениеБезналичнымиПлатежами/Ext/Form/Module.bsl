&НаКлиенте
Процедура ПослеВыбораЗБ(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	Элементы.РеестрыПлатежейПоискПоНомеруЗБ.Заголовок = "Поиск по залоговому билету № " + Результат; 
	
	РеестрыПлатежей.Отбор.Элементы.Очистить();   
	
	ГруппаОтбора = РеестрыПлатежей.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
 
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РеестрПлатежей.ПлатежиБН.НомерЗБ");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
	ЭлементОтбора.ПравоеЗначение = Результат;
 
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РеестрПлатежей.ПлатежиЛК.НомерЗБ");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
	ЭлементОтбора.ПравоеЗначение = Результат;

	Элементы.РеестрыПлатежей.Обновить(); 
	Элементы.РеестрыПлатежей.ТекущаяСтрока = 1;
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда  
		ЗаполнитьРасшифровку(ТекСтрока.РеестрПлатежей);   
		Отбор = Новый Структура;
		Отбор.Вставить("НомерЗБ", Результат);
		Строки = РасшифровкаРеестра.НайтиСтроки(Отбор); 
		Если НЕ Строки.Количество() = 0 Тогда   
			Строка = Строки.Получить(0);
			ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
			Элементы.РасшифровкаРеестра.ТекущаяСтрока = ИдентификаторСтроки;   
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура ОтменитьПоискПоНомеруЗБ(Команда)
	РеестрыПлатежей.Отбор.Элементы.Очистить();
	//Элементы.ПоискПоНомеруЗБ.Видимость = Ложь; 
	Элементы.РеестрыПлатежейПоискПоНомеруЗБ.Заголовок = "Поиск по номеру залогового билета";
	Элементы.РеестрыПлатежей.Обновить();
КонецПроцедуры

&НаСервере
Функция ПроверитьОтменуРеестра(РеестрПлатежей)
	СообщенияПроверкиОтменыРеестра = "";
	СписокЗБВозврат = Новый СписокЗначений; 
	СписокЗБДоходы = Новый СписокЗначений;  
	СписокЗБЗачисление = Новый СписокЗначений;
	
	ТаблицаСтатусов = ЛБ_ОбщийМодуль.ПолучитьСтатусыБезналичныхПлатежей(, РеестрПлатежей);  
	ТаблицаСтатусовПереплата = ЛБ_ОбщийМодуль.ПолучитьСтатусыБезналичныхПлатежейПереплата(, РеестрПлатежей);
	Для каждого стр Из ТаблицаСтатусов Цикл 
		Если Стр.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью ИЛИ 
			 Стр.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично Тогда
		    СтруктураПлатежа = Новый Структура;	
			СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
			СтруктураПлатежа.Вставить("ИдентификаторПлатежа", Стр.ИдентификаторПлатежа);
			СтруктураПлатежа.Вставить("ДатаПлатежа", Стр.ДатаПлатежа);
			СтруктураПлатежа.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
			СтруктураПлатежа.Вставить("СуммаПлатежа", Стр.СуммаПлатежа);
			СтруктураПлатежа.Вставить("НомерЗБ", Стр.НомерЗБ); 
						
			СообщениеПроверки = ПроверитьПлатеж(СтруктураПлатежа, Истина); 
			Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда   
				Если СписокЗБЗачисление.НайтиПоЗначению(Стр.НомерЗБ) = неопределено Тогда 
				    СписокЗБЗачисление.Вставить(Стр.НомерЗБ, СообщениеПроверки); 
				КонецЕсли;	
				//СообщенияПроверкиОтменыРеестра = СообщенияПроверкиОтменыРеестра + ?(ПустаяСтрока(СообщенияПроверкиОтменыРеестра), "", символы.ПС) + СообщениеПроверки; 
			КонецЕсли;     
		ИначеЕсли Стр.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено Тогда 
			Если СписокЗБВозврат.НайтиПоЗначению(Стр.НомерЗБ) = неопределено Тогда 
			    СписокЗБВозврат.Добавить(Стр.НомерЗБ, Стр.НомерЗБ);  
			КонецЕсли;	
		ИначеЕсли Стр.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы Тогда 
			Если СписокЗБДоходы.НайтиПоЗначению(Стр.НомерЗБ) = неопределено Тогда 
			    СписокЗБДоходы.Добавить(Стр.НомерЗБ, Стр.НомерЗБ);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	Для каждого стрП Из ТаблицаСтатусовПереплата Цикл   
		Если СтрП.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью ИЛИ 
			 СтрП.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично Тогда
		    СтруктураПлатежа = Новый Структура;	
			СтруктураПлатежа.Вставить("РеестрПлатежей", РеестрПлатежей); 
			СтруктураПлатежа.Вставить("ИдентификаторПлатежа", СтрП.ИдентификаторПлатежа);
			СтруктураПлатежа.Вставить("ДатаПлатежа", СтрП.ДатаПлатежа);
			СтруктураПлатежа.Вставить("ЗалоговыйБилет", СтрП.ЗалоговыйБилет);
			СтруктураПлатежа.Вставить("СуммаПлатежа", СтрП.СуммаПлатежа);
			СтруктураПлатежа.Вставить("НомерЗБ", СтрП.НомерЗБ); 
						
			СообщениеПроверки = ПроверитьПлатеж(СтруктураПлатежа, Истина); 
			Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда  
				Если СписокЗБЗачисление.НайтиПоЗначению(СтрП.НомерЗБ) = неопределено Тогда 
				    СписокЗБЗачисление.Вставить(СтрП.НомерЗБ, СообщениеПроверки + " (обработка переплаты " + СокрЛП(СтрП.НомерЗБ) + ")."); 
				КонецЕсли;	
				//СообщенияПроверкиОтменыРеестра = СообщенияПроверкиОтменыРеестра + ?(ПустаяСтрока(СообщенияПроверкиОтменыРеестра), "", символы.ПС) + СообщениеПроверки + " (обработка переплаты " + СокрЛП(СтрП.НомерЗБ) + ")."; 
			КонецЕсли;     
		ИначеЕсли СтрП.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено Тогда 
			Если СписокЗБВозврат.НайтиПоЗначению(СтрП.НомерЗБ) = неопределено Тогда
			    СписокЗБВозврат.Добавить(СтрП.НомерЗБ, СокрЛП(СтрП.НомерЗБ) + " (обработка переплаты " + СокрЛП(СтрП.НомерЗБ) + ").");
			КонецЕсли;	
		ИначеЕсли СтрП.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы Тогда	
			Если СписокЗБДоходы.НайтиПоЗначению(СтрП.НомерЗБ) = неопределено Тогда
			    СписокЗБДоходы.Добавить(СтрП.НомерЗБ, СокрЛП(СтрП.НомерЗБ) + " (обработка переплаты " + СокрЛП(СтрП.НомерЗБ) + ").");
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;	      
	Для каждого Эл Из СписокЗБЗачисление Цикл
		СообщенияПроверкиОтменыРеестра = СообщенияПроверкиОтменыРеестра + ?(ПустаяСтрока(СообщенияПроверкиОтменыРеестра), "", символы.ПС) + СокрЛП(Эл.Представление);
	КонецЦикла;	

 	СтрокаЗБВозврат = "";  
	Для каждого Эл Из СписокЗБВозврат Цикл
		СтрокаЗБВозврат = СтрокаЗБВозврат + ?(ПустаяСтрока(СтрокаЗБВозврат), "", ", ") + СокрЛП(Эл.Представление);
	КонецЦикла;	  
	Если НЕ ПустаяСтрока(СтрокаЗБВозврат) Тогда   
		СообщенияПроверкиОтменыРеестра = СообщенияПроверкиОтменыРеестра + ?(ПустаяСтрока(СообщенияПроверкиОтменыРеестра), "", символы.ПС) + "Платежи по ЗБ " + СтрокаЗБВозврат + " возвращены.";
	КонецЕсли;	 

	СтрокаЗБДоходы = "";  
	Для каждого Эл Из СписокЗБДоходы Цикл
		СтрокаЗБДоходы = СтрокаЗБДоходы + ?(ПустаяСтрока(СтрокаЗБДоходы), "", ", ") + СокрЛП(Эл.Представление);
	КонецЦикла;	
	Если НЕ ПустаяСтрока(СтрокаЗБДоходы) Тогда    
		СообщенияПроверкиОтменыРеестра = СообщенияПроверкиОтменыРеестра + ?(ПустаяСтрока(СообщенияПроверкиОтменыРеестра), "", символы.ПС) + "Платежи по ЗБ " + СтрокаЗБВозврат + " отнесены в доходы.";
	КонецЕсли;		
	
	Возврат СообщенияПроверкиОтменыРеестра;    
КонецФункции

&НаСервере
Функция ОтменитьРеестрНаСервере(РеестрПлатежей) 
	НовыйДок = Документы.ЛБ_ОтменаРеестраПлатежей.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса();
	НовыйДок.РеестрПлатежей = РеестрПлатежей;
	НовыйДок.Ответственный = пользователи.ТекущийПользователь();
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	
	Попытка  
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Истина;
	Исключение  
		Возврат Ложь;
	КонецПопытки;	
КонецФункции

&НаКлиенте
Процедура ОтменитьРеестр(Команда) 
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные;  
	Если НЕ ТекСтрока = неопределено Тогда  
		СообщениеПроверки = ПроверитьОтменуРеестра(ТекСтрока.РеестрПлатежей);
		Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда   
			СообщениеПроверки = "ВНИМАНИЕ!" + Символы.ПС + СообщениеПроверки + Символы.ПС + "Отмена реестра запрещена.";
			Предупреждение(СообщениеПроверки, 60);
		Иначе	      
			Если ОтменитьПлатежи(ТекСтрока.РеестрПлатежей) Тогда
				Если ОтменитьРеестрНаСервере(ТекСтрока.РеестрПлатежей) Тогда
					Элементы.РеестрыПлатежей.Обновить();
				Иначе
					Предупреждение("Ошибка при отмене реестра платежей. Обратитесь к разработчикам.", 60);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗаписьВРегистреОтменаПлатежейЛК(РеестрПлатежей, ЗалоговыйБилет) 
	НаборЗаписей = РегистрыСведений.ЛБ_ОтменаПлатежейЛК.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.РеестрПлатежей.Установить(РеестрПлатежей); 
	НаборЗаписей.Отбор.ЗалоговыйБилетЛК.Установить(ЗалоговыйБилет);
    НаборЗаписей.Записать(); 
КонецПроцедуры	  

&НаСервере
Процедура ЗаписатьИнформациюОботмененныхПлатежах(РеестрПлатежей, СтруктураПлатежаЛК)
    МенеджерЗаписи = РегистрыСведений.ЛБ_ОтменаПлатежейЛК.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.РеестрПлатежей = РеестрПлатежей; 
	МенеджерЗаписи.РеестрПлатежейЛК = СтруктураПлатежаЛК.РеестрПлатежей; 
	МенеджерЗаписи.ИдентификаторПлатежаЛК = СтруктураПлатежаЛК.ИдентификаторПлатежа;
    МенеджерЗаписи.ДатаПлатежаЛК = СтруктураПлатежаЛК.ДатаПлатежа;
	МенеджерЗаписи.НомерЗБЛК = СтруктураПлатежаЛК.НомерЗБ;
	МенеджерЗаписи.ЗалоговыйБилетЛК = СтруктураПлатежаЛК.ЗалоговыйБилет;
	МенеджерЗаписи.СуммаПлатежаЛК = СтруктураПлатежаЛК.СуммаПлатежа;
				 
	МенеджерЗаписи.Записать();	  
КонецПроцедуры

&НаСервере
Функция ОтменаОплатыНаСервере(ДокументОплаты)
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.Дата = ДокументОплаты.Дата;
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты;  
	ЗалоговыйБилет = ДокументОплаты.ПредыдущаяОперация; 
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет;
	ДокументОбъект.Организация = ЗалоговыйБилет.Организация; 
	ДокументОбъект.Товары.Загрузить(ДокументОплаты.Товары.Выгрузить());
	ДокументОбъект.СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДокументОбъект.Дата, ЗалоговыйБилет.Залогодатель);
	
	ДокументОбъект.Ломбард = ДокументОплаты.Ломбард; 
	ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	ДокументОбъект.СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;  
	ДокументОбъект.СрокЗалога = ЗалоговыйБилет.СрокЗалога; 
	ДокументОбъект.Акция = ЗалоговыйБилет.Акция;
	ДокументОбъект.НомерЗалоговогоБилета = ЗалоговыйБилет.НомерЗалоговогоБилета;  
	ДокументОбъект.ОтмененныйДокумент = ДокументОплаты; 
	
	СостояниеЗБДоОплаты = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(ДокументОплаты, ЗалоговыйБилет);
	ДокументОбъект.НомерДопСоглашения = СостояниеЗБДоОплаты.НомерДопСоглашения; 
	ДокументОбъект.ДатаВыкупа = СостояниеЗБДоОплаты.ДатаВыкупа;
	ДокументОбъект.ДатаВыкупаЛьготная = СостояниеЗБДоОплаты.ДатаВыкупаЛьготныйСрок;
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ДокументОплаты.Дата-1); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаДолгаЗайма КАК Задолженность
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних";
    ТаблицаОЗ = Запрос.Выполнить().Выгрузить();
	
    ДокументОбъект.ТоварыОтмена.Очистить();
	Для каждого стр из ДокументОбъект.Товары Цикл 		
		СтрТОт = ДокументОбъект.ТоварыОтмена.Добавить();
		СтрТОт.ОбъектЗалога = стр.ОбъектЗалога;  
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", стр.ОбъектЗалога);
		СтрокиОЗ = ТаблицаОЗ.НайтиСтроки(Отбор);   
		Если НЕ СтрокиОЗ.Количество() = 0 Тогда 
			СтрОЗ = СтрокиОЗ.Получить(0);
			СтрТОт.Статус = СтрОЗ.СтатусОбъектаЗалога;
			СтрТОт.СуммаОценки = СтрОЗ.Задолженность;
		КонецЕсли;	
	Конеццикла;
			
	СостояниеДоОтменяемойОперации = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ДокументОбъект.НомерЗалоговогоБилета, ДокументОплаты.Дата-1,, Истина);
	
	Если СостояниеДоОтменяемойОперации <> Неопределено Тогда
		ДокументОбъект.СуммаОплаты = -ДокументОплаты.СуммаОплаты;
		ДокументОбъект.СуммаОплатыПроценты = -ДокументОплаты.СуммаОплатыПроценты;
		ДокументОбъект.СуммаОплатыСсуда = -ДокументОплаты.СуммаОплатыСсуда;
		ДокументОбъект.СуммаСсуды = СостояниеДоОтменяемойОперации.Регистратор.СуммаСсуды;
		ДокументОбъект.Выкуп = СостояниеДоОтменяемойОперации.Регистратор.Выкуп;
		ДокументОбъект.ВыдачаЗалога = СостояниеДоОтменяемойОперации.Регистратор.ВыдачаЗалога;
	КонецЕсли;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Попытка         		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		ДокументОтмены = ДокументОбъект.Ссылка;
		
		//Установка отментки об отмене документа в отменяемом документе
		ОтменяемыйДокумент = ДокументОплаты.ПолучитьОбъект();
		ОтменяемыйДокумент.ДокументОтмены = ДокументОтмены;
		
		ОтменяемыйДокумент.Записать(РежимЗаписиДокумента.Запись);	
		Попытка           
			ОтменяемыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			
			Возврат Истина;
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось установить отметку в отменяемом документе"); 
			Возврат ложь;
		КонецПопытки;
   	Исключение   
		Возврат ложь;
	КонецПопытки;  	
КонецФункции  

&НаСервере 
Функция ПроверитьОтменуПлатежаПереплата(СтруктураПлатежа)  	
	ТаблицаСтатусовПереплата = ЛБ_ОбщийМодуль.ПолучитьСтатусыБезналичныхПлатежейПереплата(, СтруктураПлатежа.РеестрПлатежей);
	Если НЕ ТаблицаСтатусовПереплата.Количество() = 0 Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторПлатежа", СтруктураПлатежа.ИдентификаторПлатежа); 
		Отбор.Вставить("ДатаПлатежа", СтруктураПлатежа.ДатаПлатежа);
        Отбор.Вставить("НомерЗБ", СтруктураПлатежа.НомерЗБ);
		
		СообщениеПроверкиПереплата = "";
        СтрокиП = ТаблицаСтатусовПереплата.НайтиСтроки(Отбор);
		Для каждого СтрП Из СтрокиП Цикл 
			Если СтрП.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью") ИЛИ 
		         СтрП.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично") Тогда
				СтруктураПлатежаП = Новый Структура;	
				СтруктураПлатежаП.Вставить("РеестрПлатежей", СтруктураПлатежа.РеестрПлатежей); 
				СтруктураПлатежаП.Вставить("ИдентификаторПлатежа", СтрП.ИдентификаторПлатежа);
				СтруктураПлатежаП.Вставить("ДатаПлатежа", СтрП.ДатаПлатежа);
				СтруктураПлатежаП.Вставить("ЗалоговыйБилет", СтрП.ЗалоговыйБилет);
				СтруктураПлатежаП.Вставить("СуммаПлатежа", СтрП.СуммаПлатежа);
				СтруктураПлатежаП.Вставить("НомерЗБ", СтрП.НомерЗБ); 
				СтруктураПлатежаП.Вставить("Переплата", Истина); 
				
				СообщениеПроверки = ПроверитьПлатеж(СтруктураПлатежаП, Истина); 
				Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда 
					СообщениеПроверкиПереплата = СообщениеПроверкиПереплата + ?(ПустаяСтрока(СообщениеПроверкиПереплата), "", Символы.ПС) + СообщениеПроверки + " (обработка переплаты " + СокрЛП(СтрП.НомерЗБ) + ")";
				КонецЕсли;
			ИначеЕсли СтрП.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") Тогда
				Возврат "Переплата платежа возвращена.";
			ИначеЕсли СтрП.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда	
				Возврат "Переплата платежа отнесена в доходы.";
		    КонецЕсли;
		КонецЦикла;	 
		Если НЕ ПустаяСтрока(СообщениеПроверкиПереплата) Тогда 
			Возврат СообщениеПроверкиПереплата;
		КонецЕсли;
	КонецЕсли;                                 
	Возврат "";
КонецФункции

&НаКлиенте
Процедура ОтменаПлатежа(Команда)
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	 
	
	СообщениеПроверки = "";   
	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
	СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ); 

	Если ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда 
		Предупреждение("Платеж уже отменен.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") Тогда 
		Если НЕ СотрудникЦО Тогда 
			Предупреждение("Платеж возвращен, для отмены операции возврата обратитесь к сотруднику ЦО.", 60);
		    Возврат; 
		Иначе  
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОтмена", ЭтаФорма); 
            ПоказатьВопрос(Оповещение, "Отменить операцию возврата платежа?",  РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Да,);
        КонецЕсли;	
    ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда 
		Если НЕ СотрудникЦО Тогда 
			Предупреждение("Платеж отнесен в доходы, для отмены операции обратитесь к сотруднику ЦО.", 60);
		    Возврат; 
		Иначе  
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОтмена", ЭтаФорма); 
            ПоказатьВопрос(Оповещение, "Отменить операцию отнесения платежа в доходы?",  РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Да,);
        КонецЕсли;	
	Иначе
		Если ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью") ИЛИ 
			 ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично") Тогда				
			СообщениеПроверки = ПроверитьПлатеж(СтруктураПлатежа, Истина); 
			Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда 
				СообщениеПроверки = СообщениеПроверки + Символы.ПС + "Отмена платежа запрещена.";
				Предупреждение(СообщениеПроверки, 60);
				Возврат; 
			КонецЕсли;   
		КонецЕсли;		  
	
		//проверим переплату     
		СообщениеПроверки = ПроверитьОтменуПлатежаПереплата(СтруктураПлатежа);
		Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда 
			Предупреждение(СообщениеПроверки + Символы.ПС + "Отмена платежа запрещена.", 60);
			Возврат; 
		КонецЕсли;
			
		Если ЗначениеЗаполнено(ТекСтрока.ДокументОплаты)  Тогда 
			Результат = ОтменаОплатыНаСервере(ТекСтрока.ДокументОплаты);
			Если НЕ Результат  Тогда    
				Предупреждение("Ошибка при отмене платежа. Обратитесь к разработчикам.", 60);
			Иначе							
				СтруктураПлатежа = Новый Структура;	
				СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
				СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
				СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
				СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
				СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
				СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа); 
				
			    РезультатОтменыСтатуса = СоздатьИзменениеСтатусаОтмена(СтруктураПлатежа, ТекСтрока.ДокументОплаты); 
				Если РезультатОтменыСтатуса = неопределено Тогда    
					Предупреждение("Ошибка при отмене платежа. Обратитесь к разработчикам.", 60);
				Иначе	        
					ВидРеестра = ПолучитьВидОперацииРеестраПлатежей(ТекСтрока.РеестрПлатежей);
					Если ВидРеестра = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет") Тогда
						РезультатП = ОтменитьПлатежиПоПереплате(СтруктураПлатежа);
						Если НЕ ПустаяСтрока(РезультатП) Тогда    
							Предупреждение(РезультатП, 60);
						КонецЕсли;	
				    КонецЕсли;

					ТекСтрока.ИтоговыйСтатус = РезультатОтменыСтатуса.статусПлатежа;  
					ТекСтрока.ДатаПеревода = РезультатОтменыСтатуса.ДатаПеревода; 
					ТекСтрока.ОплатаПроценты = 0; 
					ТекСтрока.ОплатаЗайм = 0;
					ТекСтрока.Переплата = 0; 
					ТекСтрока.ПереплатаРаспределено = 0;
					ТекСтрока.Ответственный = ТекущийПользователь();
					Элементы.РеестрыПлатежей.Обновить(); 
				КонецЕсли;	
	    	КонецЕсли;	  
		Иначе	            
		    СтруктураПлатежа = Новый Структура;	
			СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
			СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
			СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
			СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
			СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
			СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
			РезультатОтмены = СоздатьИзменениеСтатусаОтмена(СтруктураПлатежа);
			Если РезультатОтмены = неопределено Тогда    
				Предупреждение("Ошибка при отмене платежа. Обратитесь к разработчикам.", 60);
			Иначе	        
				ТекСтрока.ИтоговыйСтатус = РезультатОтмены.СтатусПлатежа; 
				ТекСтрока.Возврат = 0;
				ТекСтрока.ДатаПеревода = РезультатОтмены.ДатаПеревода; 
				ТекСтрока.Ответственный = ТекущийПользователь();
				Элементы.РеестрыПлатежей.Обновить(); 
			КонецЕсли;	
		КонецЕсли;  
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция РаспределениеПереплатыОтмена(СтруктураПлатежа, ДокументОплаты = неопределено)
	НовыйДок = Документы.ЛБ_РаспределениеПереплаты.СоздатьДокумент();
	НовыйДок.РеестрПлатежей = СтруктураПлатежа.РеестрПлатежей; 
	НовыйДок.ИдентификаторПлатежа =	СтруктураПлатежа.ИдентификаторПлатежа;
	НовыйДок.ДатаПлатежа =	СтруктураПлатежа.ДатаПлатежа;
	НовыйДок.НомерЗБ =	СтруктураПлатежа.НомерЗБ;
	НовыйДок.ЗалоговыйБилет =	СтруктураПлатежа.ЗалоговыйБилет;
	НовыйДок.СуммаПлатежа = СтруктураПлатежа.СуммаПлатежа; 
	НовыйДок.Переплата = СтруктураПлатежа.Переплата; 
	НовыйДок.Ответственный = Пользователи.ТекущийПользователь();
	НовыйДок.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен;
	НовыйДок.Дата = ТекущаяДатаСеанса();  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыИзмененийБезналичныхПлатежей.ОтменаИзменения;
	Если НЕ ДокументОплаты = неопределено Тогда
		НовыйДок.ДокументОплаты = ДокументОплаты;
	КонецЕсли;	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);   
		Возврат Истина;
	Исключение	              
		Возврат Ложь;
	КонецПопытки	
КонецФункции	

&НаСервере
Функция ОтменитьПлатежиПоПереплате(СтруктураПлатежаРеестра) 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("РеестрПлатежей", СтруктураПлатежаРеестра.РеестрПлатежей);
	Запрос.УстановитьПараметр("НомерЗБ", СтруктураПлатежаРеестра.НомерЗБ);  
	Запрос.УстановитьПараметр("ИдентификаторПлатежа", СтруктураПлатежаРеестра.ИдентификаторПлатежа);
    Запрос.УстановитьПараметр("ДатаПлатежа", СтруктураПлатежаРеестра.ДатаПлатежа);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ПереплатаНачальная КАК ПереплатаНачальная,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ДокументОплаты КАК ДокументОплаты,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.НомерЗБ КАК НомерЗБ,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ДатаПлатежа КАК ДатаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.СуммаПлатежа КАК СуммаПлатежа,
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.СтатусПлатежа КАК СтатусПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежейПереплаты КАК ЛБ_РеестрБезначныхПлатежейПереплаты
	               |ГДЕ
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.РеестрПлатежей = &РеестрПлатежей
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.НомерЗБ = &НомерЗБ
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.ДатаПлатежа = &ДатаПлатежа
	               |	И ЛБ_РеестрБезначныхПлатежейПереплаты.ИдентификаторПлатежа = &ИдентификаторПлатежа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейПереплаты.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		ТаблицаПереплатНач = ТаблицаЗапроса.Скопировать();
		ТаблицаПереплатНач.Свернуть("ПереплатаНачальная");
		Для каждого СтрН из ТаблицаПереплатНач Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ПереплатаНачальная", СтрН.ПереплатаНачальная);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 Тогда 
				Стр = Строки.Получить(0);
				Если Стр.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью ИЛИ
					 Стр.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично Тогда 
					Результат = ОтменаОплатыНаСервере(Стр.ДокументОплаты);
					Если НЕ Результат Тогда    
						Возврат "Ошибка при отмене учета переплаты (ЗБ № " + СокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.";
					КонецЕсли;
					СтруктураПлатежа = Новый Структура;	
					СтруктураПлатежа.Вставить("РеестрПлатежей", СтруктураПлатежаРеестра.РеестрПлатежей); 
					СтруктураПлатежа.Вставить("ИдентификаторПлатежа", Стр.ИдентификаторПлатежа);
					СтруктураПлатежа.Вставить("ДатаПлатежа", Стр.ДатаПлатежа);
					СтруктураПлатежа.Вставить("НомерЗБ", Стр.НомерЗБ);
					СтруктураПлатежа.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
					СтруктураПлатежа.Вставить("СуммаПлатежа", Стр.СуммаПлатежа);
				    СтруктураПлатежа.Вставить("Переплата", Стр.ПереплатаНачальная);
					РезультатОтмены = РаспределениеПереплатыОтмена(СтруктураПлатежа, Стр.ДокументОплаты);
					Если НЕ РезультатОтмены Тогда    
						Возврат "Ошибка при отмене изменения статуса переплаты (ЗБ № " + СокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.";
	                КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;		       
	Возврат "";
КонецФункции

&НаКлиенте
Функция ОтменитьПлатежи(РеестрПлатежей)  
		
	КоличествоОтменить = 0;
	Для каждого Стр Из РасшифровкаРеестра Цикл 
		Если НЕ Стр.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда 
			КоличествоОтменить = КоличествоОтменить + 1;
		КонецЕсли;	                                   
	КонецЦикла;
	
	Если КоличествоОтменить = 0 Тогда
		Возврат истина;
	КонецЕсли; 
	
	ВидРеестра = ПолучитьВидОперацииРеестраПлатежей(РеестрПлатежей);
	Шаг = Цел(100/КоличествоОтменить);
	Процесс = 0;    
	ВсеОК = Истина;
	Для каждого Стр Из РасшифровкаРеестра Цикл 
		Процесс = Процесс + Шаг; 
		Состояние("Внимание!", Процесс, "Отмена платежей может занять некоторое время", БиблиотекаКартинок.ДлительнаяОперация48); 
		
		Если Стр.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда
			Продолжить;
		КонецЕсли;	
		
		СтруктураПлатежа = Новый Структура;	
		СтруктураПлатежа.Вставить("РеестрПлатежей", Стр.РеестрПлатежей); 
		СтруктураПлатежа.Вставить("ИдентификаторПлатежа", Стр.ИдентификаторПлатежа);
		СтруктураПлатежа.Вставить("ДатаПлатежа", Стр.ДатаПлатежа);
		СтруктураПлатежа.Вставить("НомерЗБ", Стр.НомерЗБ);
		СтруктураПлатежа.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
		СтруктураПлатежа.Вставить("СуммаПлатежа", Стр.СуммаПлатежа); 

		Если Стр.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью") ИЛИ 
			 Стр.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично") Тогда 
		 		
			Результат = ОтменаОплатыНаСервере(Стр.ДокументОплаты);
			Если НЕ Результат  Тогда    
				Предупреждение("Ошибка при отмене платежа (№ ЗБ " + сокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.", 60); 
				ВсеОК = Ложь;
				Прервать;
			Иначе	     				
				Если ВидРеестра = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет") Тогда
					РезультатП = ОтменитьПлатежиПоПереплате(СтруктураПлатежа);
					Если НЕ ПустаяСтрока(РезультатП) Тогда    
						Предупреждение(РезультатП, 60);
					    ВсеОК = Ложь;
				        Прервать;
					КонецЕсли;	
				КонецЕсли;

				РезультатОтменыСтатуса = СоздатьИзменениеСтатусаОтмена(СтруктураПлатежа, Стр.ДокументОплаты); 
				Если РезультатОтменыСтатуса = неопределено Тогда    
					Предупреждение("Ошибка при изменении статуса платежа (№ ЗБ " + сокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.", 60);  
					ВсеОК = Ложь;
				    Прервать;
				КонецЕсли;
			КонецЕсли;	 
		Иначе   
			РезультатОтменыСтатуса = СоздатьИзменениеСтатусаОтмена(СтруктураПлатежа);
			Если РезультатОтменыСтатуса = неопределено Тогда    
				Предупреждение("Ошибка при изменении статуса платежа (№ ЗБ " + сокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.", 60);
			    ВсеОК = Ложь;
				Прервать;
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;     
		
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные; 
	ЗаполнитьРасшифровку(ТекСтрока.РеестрПлатежей);
	Элементы.РеестрыПлатежей.Обновить();   
	Возврат ВсеОК;
КонецФункции

&НаКлиенте
Процедура РасшифровкаРеестраВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	 
	
	ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	ОбработкаВыбора = Новый ОписаниеОповещения("ПересчитатьОстатокПереплаты",ЭтаФорма);
    ОткрытьФорму("ОбщаяФорма.ЛБ_УправлениеБезналичнымиПлатежамиПереплата", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Функция ПересчитатьОстатокПереплатыНаСервере(РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ);
	Возврат ЛБ_Общиймодуль.РассчитатьОстатокПереплатыБезналичногоПлатежа(ТекущаяДатаСеанса(), РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ);
КонецФункции

&НаКлиенте
Процедура ПересчитатьОстатокПереплаты(Результат, ДополнительныеПараметры) Экспорт   
	ТекСтрокаНач = Элементы.РасшифровкаРеестра.ТекущаяСтрока;
	Для каждого стр Из РасшифровкаРеестра цикл  
		Если Стр.Переплата = 0 Тогда
			Продолжить;
		КонецЕсли;	
		ПереплатаОстаток = ПересчитатьОстатокПереплатыНаСервере(Стр.РеестрПлатежей, Стр.ИдентификаторПлатежа, Стр.ДатаПлатежа, Стр.НомерЗБ); 
		ИдентификаторСтроки = Стр.ПолучитьИдентификатор();
        Элементы.РасшифровкаРеестра.ТекущаяСтрока = ИдентификаторСтроки;
        ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные; 
		ТекСтрока.ПереплатаРаспределено = ТекСтрока.Переплата - ПереплатаОстаток;
	КонецЦикла;	  
	Элементы.РеестрыПлатежей.Обновить();                                                                                        
	ОбновитьИтоги();
	Элементы.РасшифровкаРеестра.ТекущаяСтрока = РасшифровкаРеестра.НайтиПоИдентификатору(ТекСтрокаНач).ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПлатежа(Команда)
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
    ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей);
	ПараметрыФормы.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
	ПараметрыФормы.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа); 
	ПараметрыФормы.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа); 
	ПараметрыФормы.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа); 
   	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ИсторияБезналичногоПлатежа", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура Расчеты(Команда)  
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда 
		Результат = ПолучитьЗБИстория(ТекСтрока.ПолучитьИдентификатор()); 
		Если ЗначениеЗаполнено(Результат.ЗБ) Тогда 
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Клиент", Результат.Залогодатель);
			ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗБ);		
			ПараметрыФормы.Вставить("Дата", ТекСтрока.ДатаПлатежа);	 
			ПараметрыФормы.Вставить("Детально", Истина);
						
	        ОткрытьФорму("Отчет.ЛБ_НачисленныеПроцентыПоДоговоруЗайма.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежиЛККОтмене(Команда)   
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда 
		Возврат;
	КонецЕсли;	
	ВидОперации = ПолучитьВидОперацииРеестраПлатежей(ТекСтрока.РеестрПлатежей);
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет") Тогда
        Возврат;
	КонецЕсли;	  
	//ЗаполнитьОтменуЛК(ТекСтрока.РеестрПлатежей);
	Отбор = Новый Структура("РеестрПлатежей", ТекСтрока.РеестрПлатежей);  
    ОткрытьФорму("РегистрСведений.ЛБ_ОтменаПлатежейЛК.Форма.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.РеестрыПлатежей.Обновить();  
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда  
		ЗаполнитьРасшифровку(ТекСтрока.РеестрПлатежей); 
	Иначе
		РасшифровкаРеестра.Очистить();
	КонецЕсли;	            
КонецПроцедуры

&НаКлиенте
Процедура РеестрыПлатежейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  
		ПараметрыФормы = Новый Структура;
	    ПараметрыФормы.Вставить("Ключ", ТекСтрока.РеестрПлатежей); 
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
		
	    ОткрытьФорму("Документ.ЛБ_РеестрПлатежей.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

//+МАН 10.01.25 Установка доступности кнопок. Заявка 3043
&НаКлиенте
Процедура УстановитьДоступность(ТекСтрока)
	Если ПолучитьВидОперацииРеестраПлатежей(ТекСтрока.РеестрПлатежей) = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет") Тогда 
		Элементы.РасшифровкаРеестраУточнитьИЗачислить.Доступность = Ложь;
		Элементы.РасшифровкаРеестраДоВыяснения.Доступность = Ложь;
		Элементы.РасшифровкаРеестраКВозврату.Доступность = Ложь;
		Элементы.РасшифровкаРеестраОтнесеноВДоходы.Доступность = Ложь;
	Иначе
		Элементы.РасшифровкаРеестраУточнитьИЗачислить.Доступность = Истина;
		Элементы.РасшифровкаРеестраДоВыяснения.Доступность = Истина;
		Элементы.РасшифровкаРеестраКВозврату.Доступность = Истина;
		Элементы.РасшифровкаРеестраОтнесеноВДоходы.Доступность = Истина;
	КонецЕсли;	
КонецПроцедуры
//-МАН





