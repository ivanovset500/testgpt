	Возврат РеестрПлатежей.НомерРеестра;
КонецФункции

&НаСервере
Функция ПолучитьОстатокСуммыПлатежа(СтруктураПлатежа) 
	 Запрос = Новый Запрос;
КонецФункции

&НаСервере
Функция ПолучитьТекущийСтатусЗБ(ЗалоговыйБилет) 
	Возврат ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ПолучитьДатуСеанса(), ЗалоговыйБилет);
КонецФункции	  

&НаКлиенте
Функция ОтменитьОплатуЛК(СтруктураПлатежа, ДокументОплаты)  
	РезультатЛК = ОтменаОплатыНаСервере(ДокументОплаты);
	Если НЕ РезультатЛК Тогда    
		Возврат Ложь;
	Иначе							
		РезультатОтменыСтатуса = СоздатьИзменениеСтатусаОтмена(СтруктураПлатежа, ДокументОплаты); 
		Если РезультатОтменыСтатуса = неопределено Тогда    
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;	  
КонецФункции

&НаСервере
Функция ПолучитьНомерДатуРеестраПлатежей(РеестрПлатежей) 
	Возврат СокрЛП(РеестрПлатежей.НомерРеестра) + " от " + Формат(РеестрПлатежей.Дата, "ДФ=dd.MM.yyyy");
КонецФункции	

&НаКлиенте
Процедура Зачислить(Команда)
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;       
	
	Если ТекСтрока.НачальныйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ДляВозврата") ИЛИ
		 ТекСтрока.НачальныйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ДляРазбора") Тогда
		Возврат; 
	КонецЕсли;		
	
	Если ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью") ИЛИ
		 ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично") Тогда
		Предупреждение("Сумма платежа уже зачислена.", 60);
		Возврат;  
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") Тогда 
		Предупреждение("Сумма платежа возвращена, зачисление не возможно.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда  
		Предупреждение("Сумма платежа отнесена в доходы, зачисление не возможно.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда 
		Предупреждение("Платеж отменен, зачисление не возможно.", 60);
		Возврат;   
	КонецЕсли;	

	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
	СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ); 
	
	Если ПроверитьПлатежРаспределен(СтруктураПлатежа) Тогда
        Предупреждение("Сумма платежа распределена.", 60);
	    Возврат; 
	КонецЕсли;	
	
	СообщениеПроверки = ПроверитьПлатеж(СтруктураПлатежа); 
	Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда
		Предупреждение(СообщениеПроверки, 60);
		Возврат; 
	КонецЕсли;     
	
	ЗаполнитьОтменуЛК(ТекСтрока.РеестрПлатежей);
	Отбор = Новый Структура;
	Отбор.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
	СтрокиОтменитьЛК = ПлатежиЛКОтменить.НайтиСтроки(Отбор);   
	Если НЕ СтрокиОтменитьЛК.Количество() = 0 Тогда 
		Для каждого СтрЛК Из СтрокиОтменитьЛК Цикл 
			Если СтрЛК.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") ИЛИ
				 СтрЛК.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда
				СтрокаПредупреждение = "В реестре ЛК № " + ПолучитьНомерРеестра(СтрЛК.РеестрПлатежей) + " найдены более поздние зачисления по залоговому билету № " + СокрЛП(ТекСтрока.НомерЗБ) + 
				    " со статусом платежа """ + Строка(СтрЛК.СтатусПлатежа) + """. Платеж в реестре ЛК отменить нельзя."; 
				Предупреждение(СтрокаПредупреждение, 60);
			    Возврат;    
			ИначеЕсли СтрЛК.СтатусПереплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") ИЛИ
				 СтрЛК.СтатусПереплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда
				СтрокаПредупреждение = "В реестре ЛК № " + ПолучитьНомерРеестра(СтрЛК.РеестрПлатежей) + " найдены более поздние зачисления по залоговому билету № " + СокрЛП(ТекСтрока.НомерЗБ) + 
				    " со статусом переплаты """ + Строка(СтрЛК.СтатусПереплаты) + """. Платеж в реестре ЛК отменить нельзя."; 
				Предупреждение(СтрокаПредупреждение, 60);
			    Возврат; 	
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрЛК.ДокументОплаты) Тогда
				Предупреждение("Не определен документ оплаты для отмены платежа в реестре ЛК." + Символы.ПС + "Обратитесь к разработчикам.", 60); 
				Возврат;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	СтрокаСообщение = "";
	Результат = ЗачислитьПлатеж(СтруктураПлатежа);
	Если Результат = неопределено Тогда    
		Предупреждение("Ошибка при зачислении платежа. Обратитесь к разработчикам.", 60);
	Иначе	     
		СтрокаСообщение = Результат.Сообщение; 
		Если НЕ СтрокиОтменитьЛК.Количество() = 0 Тогда
			Для каждого СтрЛК Из СтрокиОтменитьЛК Цикл  
				СтруктураПлатежаЛК = Новый Структура;	
				СтруктураПлатежаЛК.Вставить("РеестрПлатежей", СтрЛК.РеестрПлатежей); 
				СтруктураПлатежаЛК.Вставить("ИдентификаторПлатежа", СтрЛК.ИдентификаторПлатежа);
				СтруктураПлатежаЛК.Вставить("ДатаПлатежа", СтрЛК.ДатаПлатежа);
				СтруктураПлатежаЛК.Вставить("НомерЗБ", СтрЛК.НомерЗБ);
				СтруктураПлатежаЛК.Вставить("ЗалоговыйБилет", СтрЛК.ЗалоговыйБилет);
				СтруктураПлатежаЛК.Вставить("СуммаПлатежа", СтрЛК.СуммаПлатежа);  
				
				УдалитьЗаписьВРегистреОтменаПлатежейЛК(Текстрока.РеестрПлатежей, СтрЛК.ЗалоговыйБилет);
				
				РезультатЛК = ОтменитьОплатуЛК(СтруктураПлатежаЛК, СтрЛК.ДокументОплаты);
				Если НЕ РезультатЛК Тогда    
		             Предупреждение("Ошибка при отмене платежа по реестру ЛК. Обратитесь к разработчикам.", 60);
		             Возврат;
				 КонецЕсли;	     
				 
				 ЗаписатьИнформациюОбОтмененныхПлатежах(ТекСтрока.РеестрПлатежей, СтруктураПлатежаЛК);			 
				 СтрокаСообщение = СтрокаСообщение + ?(ПустаяСтрока(СтрокаСообщение), "", Символы.ПС) + "В реестре платежей № " + ПолучитьНомерДатуРеестраПлатежей(СтрЛК.РеестрПлатежей) + " отменена оплата по ЗБ № " + СокрЛП(СтрЛК.НомерЗБ); 
			КонецЦикла;	
		КонецЕсли;	 

		ТекСтрока.ИтоговыйСтатус = Результат.СтатусПлатежа;
		ТекСтрока.ОплатаПроценты = Результат.ОплатаПроценты; 
		ТекСтрока.ОплатаЗайм = Результат.ОплатаЗайм; 
		ТекСтрока.Переплата = Результат.Переплата; 
		ТекСтрока.СтатусЗБ = ПолучитьТекущийстатусЗБ(ТекСтрока.ЗалоговыйБилет); 
		ТекСтрока.Ответственный = ТекущийПользователь();   
		ТекСтрока.ДокументОплаты = Результат.ДокументОплаты;
			
		ДатаПеревода = СоздатьИзменениеСтатуса(Результат.СтатусПлатежа, СтруктураПлатежа, Результат.ДокументОплаты); 
		Если ДатаПеревода = неопределено Тогда    
			Предупреждение("Ошибка при изменении статуса платежа. Обратитесь к разработчикам.", 60);
		Иначе	               
			Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
				Предупреждение(СтрокаСообщение, 60);
			КонецЕсли;	
			ТекСтрока.ДатаПеревода = ДатаПеревода;
			Элементы.РеестрыПлатежей.Обновить(); 
			ОбновитьИтоги();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗачислитьВсе(Команда)
	КоличествоЗачислить = 0;
	Для каждого Стр Из РасшифровкаРеестра Цикл 
		Если Стр.НачальныйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.КЗачислению") И
			 Стр.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка") Тогда 
			КоличествоЗачислить = КоличествоЗачислить + 1;
		КонецЕсли;	                                   
	КонецЦикла;    
	
	Если КоличествоЗачислить = 0 Тогда 
		Предупреждение("Нет платежей с начальным статусом ""К зачислению"".", 60);
		Возврат;
	КонецЕсли;  
	
	ЗаполнитьОтменуЛК(РасшифровкаРеестра.Получить(0).РеестрПлатежей);
	
	СтрокаСообщение = "";
	Шаг = Цел(100/КоличествоЗачислить);
	Процесс = 0;			
	Для каждого Стр Из РасшифровкаРеестра Цикл  
		Если Стр.НачальныйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.КЗачислению") И
			 Стр.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка") Тогда  
			 
			Процесс = Процесс + Шаг; 
			Состояние("Внимание!", Процесс, "Зачисление платежей может занять некоторое время", БиблиотекаКартинок.ДлительнаяОперация48);
			
			СтруктураПлатежа = Новый Структура;	
			СтруктураПлатежа.Вставить("РеестрПлатежей", Стр.РеестрПлатежей); 
			СтруктураПлатежа.Вставить("ИдентификаторПлатежа", Стр.ИдентификаторПлатежа);
			СтруктураПлатежа.Вставить("ДатаПлатежа", Стр.ДатаПлатежа);
			СтруктураПлатежа.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
			СтруктураПлатежа.Вставить("СуммаПлатежа", Стр.СуммаПлатежа);
			СтруктураПлатежа.Вставить("НомерЗБ", Стр.НомерЗБ);
			Результат = ЗачислитьПлатеж(СтруктураПлатежа);
			Если Результат = неопределено Тогда    
				Предупреждение("Ошибка при зачислении платежа (№ ЗБ " + сокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.", 60);  
				Прервать; 
			Иначе      
				Если НЕ ПустаяСтрока(Результат.Сообщение) Тогда
					СтрокаСообщение = СтрокаСообщение + ?(ПустаяСтрока(СтрокаСообщение), "", Символы.ПС) + Результат.Сообщение;
				КонецЕсли;	   
				Отбор = Новый Структура;
				Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
				СтрокиОтменитьЛК = ПлатежиЛКОтменить.НайтиСтроки(Отбор);   
				Если НЕ СтрокиОтменитьЛК.Количество() = 0 Тогда 
					Для каждого СтрЛК Из СтрокиОтменитьЛК Цикл  
						Если СтрЛК.НеПроверять Тогда
							Продолжить;
						КонецЕсли;	
						СтруктураПлатежаЛК = Новый Структура;	
						СтруктураПлатежаЛК.Вставить("РеестрПлатежей", СтрЛК.РеестрПлатежей); 
						СтруктураПлатежаЛК.Вставить("ИдентификаторПлатежа", СтрЛК.ИдентификаторПлатежа);
						СтруктураПлатежаЛК.Вставить("ДатаПлатежа", СтрЛК.ДатаПлатежа);
						СтруктураПлатежаЛК.Вставить("НомерЗБ", СтрЛК.НомерЗБ);
						СтруктураПлатежаЛК.Вставить("ЗалоговыйБилет", СтрЛК.ЗалоговыйБилет);
						СтруктураПлатежаЛК.Вставить("СуммаПлатежа", СтрЛК.СуммаПлатежа); 
						
						УдалитьЗаписьВРегистреОтменаПлатежейЛК(Стр.РеестрПлатежей, СтрЛК.ЗалоговыйБилет);
				
						РезультатЛК = ОтменитьОплатуЛК(СтруктураПлатежаЛК, СтрЛК.ДокументОплаты);
						Если НЕ РезультатЛК Тогда    
				             Предупреждение("Ошибка при отмене платежа по реестру ЛК (№ ЗБ " + сокрЛП(СтрЛК.НомерЗБ) + "). Обратитесь к разработчикам.", 60);
				             Возврат;
						КонецЕсли;	  
			
				        ЗаписатьИнформациюОбОтмененныхПлатежах(Стр.РеестрПлатежей, СтруктураПлатежаЛК);
						СтрокаСообщение = СтрокаСообщение + ?(ПустаяСтрока(СтрокаСообщение), "", Символы.ПС) + "В реестре платежей № " + ПолучитьНомерДатуРеестраПлатежей(СтрЛК.РеестрПлатежей) + " отменена оплата по ЗБ № " + СокрЛП(СтрЛК.НомерЗБ); 
						СтрЛК.НеПроверять = Истина;
					КонецЦикла;	
				КонецЕсли;	 

				ДатаПеревода = СоздатьИзменениеСтатуса(Результат.СтатусПлатежа, СтруктураПлатежа, Результат.ДокументОплаты); 
				Если ДатаПеревода = неопределено Тогда    
					Предупреждение("Ошибка при изменении статуса платежа (№ ЗБ " + сокрЛП(Стр.НомерЗБ) + "). Обратитесь к разработчикам.", 60);  
					Прервать;
				КонецЕсли;  
			КонецЕсли;	 
		КонецЕсли;	 
	Конеццикла;	       
	Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда 
		Предупреждение(СтрокаСообщение, 60); 
	КонецЕсли;	
	ТекСтрока = Элементы.РеестрыПлатежей.ТекущиеДанные;
	ЗаполнитьРасшифровку(ТекСтрока.РеестрПлатежей);   
	Элементы.РеестрыПлатежей.Обновить();    
	ОбновитьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура УточнитьИЗачислить(Команда) 
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	     
	
	Если ПолучитьВидОперацииРеестраПлатежей(ТекСтрока.РеестрПлатежей) = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет") Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоПолностью") ИЛИ
		 ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ЗачисленоЧастично") Тогда
		Предупреждение("Сумма платежа уже зачислена.", 60);
		Возврат;  
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") Тогда 
		Предупреждение("Сумма платежа возвращена, зачисление не возможно.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда  
		Предупреждение("Сумма платежа отнесена в доходы, зачисление не возможно.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда 
		Предупреждение("Платеж отменен, зачисление не возможно.", 60);
		Возврат; 
	КонецЕсли;	 
	
	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
	СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ); 
	
	Если ПроверитьПлатежРаспределен(СтруктураПлатежа) Тогда
        Предупреждение("Сумма платежа распределена.", 60);
	    Возврат; 
	КонецЕсли;	
	
	ПараметрыФормы = Новый структура;   
	ПараметрыФормы.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	ПараметрыФормы.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	ПараметрыФормы.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	ПараметрыФормы.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	ПараметрыФормы.Вставить("НомерЗБ", ТекСтрока.НомерЗБ); 	
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ЗачислитьПослеУточнения",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_УточнениеБезналичногоПлатежа", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаформы.БлокироватьОкноВладельца);  
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьФактическиеДанныеЗаемщика(ЗалоговыйБилет)  
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ФИОЗаемщика", "");
	СтруктураВ.Вставить("НомерТелефона", "");  
	СтруктураВ.Вставить("НомерЛомбарда", ЗалоговыйБилет.Ломбард.НомерЛомбарда);
    СтруктураВ.Вставить("Отделение", ЛБ_ОбщийМодуль.ПолучитьОтделениеЛомбарда(ТекущаяДатаСеанса(), ЗалоговыйБилет.Ломбард));
	
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("Залогодатель", ЗалоговыйБилет.Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия + "" "" + ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя + "" "" + ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК ФИОЗаемщика,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК НомерТелефона
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";   
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураВ.Вставить("ФИОЗаемщика", Выборка.ФИОЗаемщика);
		СтруктураВ.Вставить("НомерТелефона", Выборка.НомерТелефона);  
	КонецЕсли;
	Возврат СтруктураВ;
КонецФункции

&НаКлиенте
Процедура ЗачислитьПослеУточнения(Результат, ДополнительныеПараметры) Экспорт 
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные; 
		
	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	СтруктураПлатежа.Вставить("ЗалоговыйБилет", Результат.ЗалоговыйБилет);
	СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);  
	
	//СообщениеПроверки = ПроверитьПлатеж(СтруктураПлатежа); 
	//Если НЕ ПустаяСтрока(СообщениеПроверки) Тогда
	//	Предупреждение(СообщениеПроверки, 60);
	//	Возврат; 
	//КонецЕсли;     
	
	ЗаполнитьОтменуЛКУточнениеПлатежа(Результат.ЗалоговыйБилет, ТекСтрока.ДатаПлатежа);
	Отбор = Новый Структура;
	Отбор.Вставить("ЗалоговыйБилет", Результат.ЗалоговыйБилет);
	СтрокиОтменитьЛК = ПлатежиЛКОтменить.НайтиСтроки(Отбор);   
	Если НЕ СтрокиОтменитьЛК.Количество() = 0 Тогда 
		Для каждого СтрЛК Из СтрокиОтменитьЛК Цикл 
			Если СтрЛК.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") ИЛИ
				 СтрЛК.СтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда
				СтрокаПредупреждение = "В реестре ЛК № " + ПолучитьНомерРеестра(СтрЛК.РеестрПлатежей) + " найдены более поздние зачисления по залоговому билету № " + СокрЛП(Результат.НомерЗБ) + 
				    " со статусом платежа """ + Строка(СтрЛК.СтатусПлатежа) + """. Платеж в реестре ЛК отменить нельзя."; 
				Предупреждение(СтрокаПредупреждение, 60);
			    Возврат;    
			ИначеЕсли СтрЛК.СтатусПереплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") ИЛИ
				 СтрЛК.СтатусПереплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда
				СтрокаПредупреждение = "В реестре ЛК № " + ПолучитьНомерРеестра(СтрЛК.РеестрПлатежей) + " найдены более поздние зачисления по залоговому билету № " + СокрЛП(Результат.НомерЗБ) + 
				    " со статусом переплаты """ + Строка(СтрЛК.СтатусПереплаты) + """. Платеж в реестре ЛК отменить нельзя."; 
				Предупреждение(СтрокаПредупреждение, 60);
			    Возврат; 	
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрЛК.ДокументОплаты) Тогда
				Предупреждение("Не определен документ оплаты для отмены платежа в реестре ЛК." + Символы.ПС + "Обратитесь к разработчикам.", 60); 
				Возврат;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	

	ТекСтрока.ЗалоговыйБилет = Результат.ЗалоговыйБилет;
	ТекСтрока.НомерЗБФакт = Результат.НомерЗБ;  
   	Результат = ЗачислитьПлатеж(СтруктураПлатежа);
	Если Результат = неопределено Тогда    
		Предупреждение("Ошибка при зачислении платежа. Обратитесь к разработчикам.", 60);
	Иначе	     		
		СтрокаСообщение = Результат.Сообщение;
		Если НЕ СтрокиОтменитьЛК.Количество() = 0 Тогда 			
			Для каждого СтрЛК Из СтрокиОтменитьЛК Цикл  
				СтруктураПлатежаЛК = Новый Структура;	
				СтруктураПлатежаЛК.Вставить("РеестрПлатежей", СтрЛК.РеестрПлатежей); 
				СтруктураПлатежаЛК.Вставить("ИдентификаторПлатежа", СтрЛК.ИдентификаторПлатежа);
				СтруктураПлатежаЛК.Вставить("ДатаПлатежа", СтрЛК.ДатаПлатежа);
				СтруктураПлатежаЛК.Вставить("НомерЗБ", СтрЛК.НомерЗБ);
				СтруктураПлатежаЛК.Вставить("ЗалоговыйБилет", СтрЛК.ЗалоговыйБилет);
				СтруктураПлатежаЛК.Вставить("СуммаПлатежа", СтрЛК.СуммаПлатежа);  
				
				УдалитьЗаписьВРегистреОтменаПлатежейЛК(Текстрока.РеестрПлатежей, СтрЛК.ЗалоговыйБилет);
				
				РезультатЛК = ОтменитьОплатуЛК(СтруктураПлатежаЛК, СтрЛК.ДокументОплаты);
				Если НЕ РезультатЛК Тогда    
		             Предупреждение("Ошибка при отмене платежа по реестру ЛК. Обратитесь к разработчикам.", 60);
		             Возврат;
				 КонецЕсли;	     
				 
				 ЗаписатьИнформациюОбОтмененныхПлатежах(ТекСтрока.РеестрПлатежей, СтруктураПлатежаЛК);			 
				 СтрокаСообщение = СтрокаСообщение + ?(ПустаяСтрока(СтрокаСообщение), "", Символы.ПС) + "В реестре платежей № " + ПолучитьНомерДатуРеестраПлатежей(СтрЛК.РеестрПлатежей) + " отменена оплата по ЗБ № " + СокрЛП(СтрЛК.НомерЗБ); 				 
			 КонецЦикла;	  
		КонецЕсли;	 

		ТекСтрока.ИтоговыйСтатус = Результат.СтатусПлатежа;
		ТекСтрока.ОплатаПроценты = Результат.ОплатаПроценты; 
		ТекСтрока.ОплатаЗайм = Результат.ОплатаЗайм; 
		ТекСтрока.Переплата = Результат.Переплата; 
		ТекСтрока.СтатусЗБ = ПолучитьТекущийстатусЗБ(ТекСтрока.ЗалоговыйБилет); 
		ТекСтрока.Ответственный = ТекущийПользователь();   
		ТекСтрока.ДокументОплаты = Результат.ДокументОплаты;
			
		ДатаПеревода = СоздатьИзменениеСтатуса(Результат.СтатусПлатежа, СтруктураПлатежа, Результат.ДокументОплаты); 
		Если ДатаПеревода = неопределено Тогда    
			Предупреждение("Ошибка при зачислении платежа. Обратитесь к разработчикам.", 60);
		Иначе	    
			Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
				Предупреждение(СтрокаСообщение, 60);
			КонецЕсли;	

			ТекСтрока.ДатаПеревода = ДатаПеревода;
			Элементы.РеестрыПлатежей.Обновить();
			ОбновитьИтоги();
		КонецЕсли;	 
	КонецЕсли;	 
КонецПроцедуры


&НаСервере
Функция ПроверитьПлатежРаспределен(СтруктураПлатежа)
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("РеестрПлатежей", СтруктураПлатежа.РеестрПлатежей); 
	Запрос.УстановитьПараметр("НомерЗБ", СтруктураПлатежа.НомерЗБ); 
	Запрос.УстановитьПараметр("ДатаПлатежа", СтруктураПлатежа.ДатаПлатежа); 
	Запрос.УстановитьПараметр("ИдентификаторПлатежа", СтруктураПлатежа.ИдентификаторПлатежа); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.РеестрПлатежей КАК РеестрПлатежей,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.НомерЗБ КАК НомерЗБ,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ДатаПлатежа КАК ДатаПлатежа,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	               |	СУММА(ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаОстаток) КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛБ_БезналичныеПлатежиКРаспределению.Остатки(
	               |			,
	               |			РеестрПлатежей = &РеестрПлатежей
	               |				И НомерЗБ = &НомерЗБ
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа) КАК ЛБ_БезналичныеПлатежиКРаспределениюОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.РеестрПлатежей,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ИдентификаторПлатежа,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ДатаПлатежа,
	               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.НомерЗБ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ?(НЕ Выборка.СуммаОстаток = 0, ложь, Истина);
	КонецЕсли;	                                             
	Возврат Истина;
КонецФункции	

&НаСервере
Функция СоздатьИзменениеСтатуса(НовыйСтатусПлатежа, СтруктураПлатежа, ДокументОплаты = неопределено)
	НовыйДок = Документы.ЛБ_ИзменениеСтатусаБезналичногоПлатежа.СоздатьДокумент();
	НовыйДок.РеестрПлатежей = СтруктураПлатежа.РеестрПлатежей; 
	НовыйДок.ИдентификаторПлатежа =	СтруктураПлатежа.ИдентификаторПлатежа;
	НовыйДок.ДатаПлатежа =	СтруктураПлатежа.ДатаПлатежа;
	НовыйДок.НомерЗБ =	СтруктураПлатежа.НомерЗБ;
	НовыйДок.ЗалоговыйБилет =	СтруктураПлатежа.ЗалоговыйБилет;
	НовыйДок.СуммаПлатежа = СтруктураПлатежа.СуммаПлатежа; 
	НовыйДок.Ответственный = Пользователи.ТекущийПользователь();
    НовыйДок.НовыйСтатусПлатежа = НовыйСтатусПлатежа;
	НовыйДок.Дата = ТекущаяДатаСеанса();  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыИзмененийБезналичныхПлатежей.Изменение;
	Если НЕ ДокументОплаты = неопределено Тогда
		НовыйДок.ДокументОплаты = ДокументОплаты;
	КонецЕсли;	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
		Возврат НовыйДок.Дата;
	Исключение	              
		Возврат Неопределено;
	КонецПопытки	
КонецФункции	  

&НаСервере
Функция СоздатьИзменениеСтатусаОтмена(СтруктураПлатежа, ДокументОплаты = неопределено)
	НовыйДок = Документы.ЛБ_ИзменениеСтатусаБезналичногоПлатежа.СоздатьДокумент();
	НовыйДок.РеестрПлатежей = СтруктураПлатежа.РеестрПлатежей; 
	НовыйДок.ИдентификаторПлатежа =	СтруктураПлатежа.ИдентификаторПлатежа;
	НовыйДок.ДатаПлатежа =	СтруктураПлатежа.ДатаПлатежа;
	НовыйДок.НомерЗБ =	СтруктураПлатежа.НомерЗБ;
	НовыйДок.ЗалоговыйБилет =	СтруктураПлатежа.ЗалоговыйБилет;
	НовыйДок.СуммаПлатежа = СтруктураПлатежа.СуммаПлатежа; 
	НовыйДок.Ответственный = Пользователи.ТекущийПользователь();
	ТекущийСтатусПлатежа = ЛБ_ОбщийМодуль.ПолучитьИтоговыйСтатусБезналичногоПлатежа(ТекущаяДатаСеанса(), СтруктураПлатежа.РеестрПлатежей, СтруктураПлатежа.ИдентификаторПлатежа, СтруктураПлатежа.ДатаПлатежа, СтруктураПлатежа.НомерЗБ); 
	Если ТекущийСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено ИЛИ
		 ТекущийСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы Тогда  
		НовыйДок.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка(); 
	Иначе			 
	    НовыйДок.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен;
	КонецЕсли;	
	НовыйДок.Дата = ТекущаяДатаСеанса();  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыИзмененийБезналичныхПлатежей.ОтменаИзменения;
	Если НЕ ДокументОплаты = неопределено Тогда
		НовыйДок.ДокументОплаты = ДокументОплаты;
	КонецЕсли;	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
			
		ЗапросИтог = Новый Запрос; 
		ЗапросИтог.УстановитьПараметр("Регистратор", НовыйДок.Ссылка);
		ЗапросИтог.Текст = "ВЫБРАТЬ
		                   |	ЛБ_РеестрБезначныхПлатежей.СтатусПлатежа КАК СтатусПлатежа,
		                   |	ЛБ_РеестрБезначныхПлатежей.Период КАК ДатаПеревода
		                   |ИЗ
		                   |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей КАК ЛБ_РеестрБезначныхПлатежей
		                   |ГДЕ
		                   |	ЛБ_РеестрБезначныхПлатежей.Регистратор = &Регистратор";  
		Выборка = Запроситог.Выполнить().Выбрать(); 
		Если Выборка.Следующий() тогда    
			Результат = новый Структура;
		    Результат.Вставить("ДатаПеревода", Выборка.ДатаПеревода);
			Результат.Вставить("СтатусПлатежа", Выборка.СтатусПлатежа); 
		КонецЕсли;                                      
		Возврат Результат;
	Исключение	              
		Возврат Неопределено;
	КонецПопытки	
КонецФункции	


&НаСервере
Функция ТекущийПользователь() 
	Возврат Пользователи.ТекущийПользователь();
КонецФункции

&НаКлиенте
Процедура КВозврату(Команда)
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные; 
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	    
	
	Если ПолучитьВидОперацииРеестраПлатежей(ТекСтрока.РеестрПлатежей) = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет") Тогда 
		Возврат;
	КонецЕсли;	

	НовыйСтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.КВозврату");
	Если ТекСтрока.ИтоговыйСтатус = НовыйСтатусПлатежа Тогда
		Возврат;
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ПустаяСсылка")  ИЛИ
		      ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ДоВыяснения") Тогда
		СтруктураПлатежа = Новый Структура;	
		СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
		СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
		СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
		СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
		СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
		СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);  
		Если НЕ ПроверитьПлатежРаспределен(СтруктураПлатежа) Тогда
			ДатаПеревода = СоздатьИзменениеСтатуса(НовыйСтатусПлатежа, СтруктураПлатежа);
			Если ДатаПеревода = неопределено Тогда    
				Предупреждение("Ошибка при изменении статуса платежа. Обратитесь к разработчикам.", 60);
			Иначе	
				ТекСтрока.ИтоговыйСтатус = НовыйСтатусПлатежа;  
				ТекСтрока.ДатаПеревода = ДатаПеревода;  
				ТекСтрока.Ответственный = ТекущийПользователь();
				Элементы.РеестрыПлатежей.Обновить(); 
			КонецЕсли;
		Иначе     
			Предупреждение("Сумма платежа распределена.", 60);
		КонецЕсли;	
	Иначе  
		Предупреждение("Изменение статуса платежа невозможно.", 60);	  
	КонецЕсли;		  
КонецПроцедуры


&НаКлиенте
Процедура ВозвратПлатежа(Команда)
	ТекСтрока = Элементы.РасшифровкаРеестра.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	  
	
	Если ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Отменен") Тогда 
		Предупреждение("Платеж отменен, возврат не возможен.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено") Тогда  
		Предупреждение("Платеж уже возвращен.", 60);
		Возврат; 
	ИначеЕсли ТекСтрока.ИтоговыйСтатус = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы") Тогда  
		Предупреждение("Сумма платежа отнесена в доходы, возврат не возможен.", 60);
		Возврат; 
	ИначеЕсли НЕ (ТекСтрока.ОплатаПроценты + ТекСтрока.ОплатаЗайм) = 0  Тогда
		Предупреждение("Сумма платежа зачислена, возврат не возможен.", 60);
		Возврат;  
	КонецЕсли;	

	НовыйСтатусПлатежа = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыБезналичныхПлатежей.Возвращено");
	СтруктураПлатежа = Новый Структура;	
	СтруктураПлатежа.Вставить("РеестрПлатежей", ТекСтрока.РеестрПлатежей); 
	СтруктураПлатежа.Вставить("ИдентификаторПлатежа", ТекСтрока.ИдентификаторПлатежа);
	СтруктураПлатежа.Вставить("ДатаПлатежа", ТекСтрока.ДатаПлатежа);
	СтруктураПлатежа.Вставить("НомерЗБ", ТекСтрока.НомерЗБ);
	СтруктураПлатежа.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
	СтруктураПлатежа.Вставить("СуммаПлатежа", ТекСтрока.СуммаПлатежа);
	Если НЕ ПроверитьПлатежРаспределен(СтруктураПлатежа) Тогда
		ДатаПеревода = СоздатьИзменениеСтатуса(НовыйСтатусПлатежа, СтруктураПлатежа);
		Если ДатаПеревода = неопределено Тогда    
			Предупреждение("Ошибка при возврате платежа. Обратитесь к разработчикам.", 60);
		Иначе	
			ТекСтрока.ИтоговыйСтатус = НовыйСтатусПлатежа;  
			ТекСтрока.ДатаПеревода = ДатаПеревода;     
			ТекСтрока.Возврат = ТекСтрока.СуммаПлатежа;
			ТекСтрока.Ответственный = ТекущийПользователь();
			Элементы.РеестрыПлатежей.Обновить();
			ОбновитьИтоги();
		КонецЕсли;
	Иначе
		Предупреждение("Сумма платежа распределена.", 60);
	КонецЕсли;	
КонецПроцедуры     

