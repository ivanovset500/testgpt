&НаСервере
Процедура ЗаполнитьСписокЛомбардов(ДокументОбъект)
	Результат = "";
	Для каждого Стр Из ДокументОбъект.Ломбарды Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + ?(НЕ ПустаяСтрока(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.Наименование));
	КонецЦикла;	
	ДокументОбъект.СтрокаЛомбарды = Результат; 
КонецПроцедуры	

&НаСервере
Процедура СохранитьЛомбарды(Результат)
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");  
	ДокументОбъект.Ломбарды.Очистить();  
	КоличествоВыбрано = Результат.Количество;
	Для сч = 1 По КоличествоВыбрано Цикл
		НоваяСтр = ДокументОбъект.Ломбарды.Добавить();
		НоваяСтр.Ломбард = Результат["Значение" + Строка(сч)];
	КонецЦикла;	
	
	ЗаполнитьСписокЛомбардов(ДокументОбъект);
	ДокументОбъект.Записать();
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);	
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор); 
	СтрокаПриказа.СтрокаЛомбарды = ДокументОбъект.СтрокаЛомбарды; 
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры

