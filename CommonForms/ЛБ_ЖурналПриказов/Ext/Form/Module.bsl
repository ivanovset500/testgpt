&НаКлиенте
Процедура ПроставитьГалочкиВГруппе() 
    ЭлементыДерева = Дерево.ПолучитьЭлементы();
	Для каждого Элемент Из ЭлементыДерева Цикл		
		ВлЭлементы = Элемент.ПолучитьЭлементы();
		Если ВлЭлементы.Количество()  > 0 Тогда
			Пометка = Истина;  
			ЕстьОтмеченные = ложь;
			Для каждого ВлЭлемент Из ВлЭлементы Цикл
				Если НЕ ВлЭлемент.Пометка Тогда
					Пометка = Ложь;
					//Прервать;					
				Иначе
					ЕстьОтмеченные = Истина;
				КонецЕсли;
			КонецЦикла;
			Элемент.Пометка = Пометка;  
			Если ЕстьОтмеченные Тогда
			    Элементы.СписокЛомбардов.Развернуть(Элемент.ПолучитьИдентификатор(), Истина); 
			КонецЕсли;	
		КонецЕсли;		
	КонецЦикла;	

КонецПроцедуры	

