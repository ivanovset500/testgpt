	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ТекущийШаблонПриказаВставки.Вставка КАК Вставка,
	               |	ЛБ_ТекущийШаблонПриказаВставки.ФормаОгранки КАК ФормаОгранки,
	               |	ЛБ_ТекущийШаблонПриказаВставки.ВидОгранки КАК ВидОгранки,
	               |	ЛБ_ТекущийШаблонПриказаВставки.КачествоОгранки КАК КачествоОгранки,
	               |	ЛБ_ТекущийШаблонПриказаВставки.ВесоваяГруппа КАК ВесоваяГруппа
	               |ИЗ
	               |	РегистрСведений.ЛБ_ТекущийШаблонПриказаВставки КАК ЛБ_ТекущийШаблонПриказаВставки
	               |ГДЕ
	               |	ЛБ_ТекущийШаблонПриказаВставки.Регистратор = &Регистратор
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Вставка,
	               |	ФормаОгранки,
	               |	ВидОгранки,
	               |	КачествоОгранки,
	               |	ВесоваяГруппа";
	ШаблонВставок = Запрос.Выполнить().Выгрузить();
	
	СписокЛ = Новый СписокЗначений;
	Для каждого СтрЛ из ТекущийПриказ.Ломбарды Цикл
		СписокЛ.Добавить(СтрЛ.Ломбард);
	КонецЦикла;	 
	Если СписокЛ.Количество() = 0 Тогда
		ОтборЛ = "";
	Иначе
		ОтборЛ = "Ломбард В (&Ломбарды)";
	КонецЕсли;	
	Запрос.УстановитьПараметр("Ломбарды", СписокЛ); 
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВидВставки КАК ВидВставки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВесоваяГруппа КАК ВесоваяГруппа,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ФормаОгранки КАК ФормаОгранки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВидОгранки КАК ВидОгранки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.КачествоОгранки КАК КачествоОгранки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Цена КАК Цена,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СрезПоследних(&Дата, " + ОтборЛ + ") КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВидВставки,
	               |	ФормаОгранки,
	               |	ВидОгранки,
	               |	КачествоОгранки,
	               |	ВесоваяГруппа";
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
	ДокументОбъект.ЦеныВставки.Очистить();
	
	Для каждого Стр Из ШаблонВставок Цикл
	     НоваяСтр = ДокументОбъект.ЦеныВставки.Добавить();
		 НоваяСтр.ВидВставки = Стр.Вставка;
		 НоваяСтр.ВесоваяГруппа = Стр.ВесоваяГруппа;
		 НоваяСтр.КачествоОгранки = Стр.КачествоОгранки;
		 НоваяСтр.ФормаОгранки = Стр.ФормаОгранки; 
		 НоваяСтр.ВидОгранки = Стр.ВидОгранки;
		 
		 Отбор = новый Структура;
		 Отбор.Вставить("ВидВставки", Стр.Вставка);
		 Отбор.Вставить("ВесоваяГруппа", Стр.ВесоваяГруппа);
		 Отбор.Вставить("КачествоОгранки", Стр.КачествоОгранки);
		 Отбор.Вставить("ФормаОгранки", Стр.ФормаОгранки); 
		 Отбор.Вставить("ВидОгранки", Стр.ВидОгранки);
		 
		 СтрокиЦен = ТаблицаЦен.НайтиСтроки(Отбор);
		 Если СтрокиЦен.Количество() = 0 Тогда
			 НоваяСтр.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмеренияВставки;
		 Иначе
			 СтрЦ = СтрокиЦен.Получить(0);
			 НоваяСтр.Цена = СтрЦ.Цена;
			 НоваяСтр.ЕдиницаИзмерения = СтрЦ.ЕдиницаИзмерения;
		 КонецЕсли;	 
	КонецЦикла;	                                    
	ДокументОбъект.ЦеныВставки.Сортировать("ВидВставки, ФормаОгранки, ВидОгранки, КачествоОгранки, ВесоваяГруппа"); 
	ДокументОбъект.ШаблонВставки = ТекРегистратор;  
	ДокументОбъект.Записать();
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);	
КонецПроцедуры

