		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	КонецЕсли;	  
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеРедактированияСтавокАкция",ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ЗаполнениеПроцентныхСтавокАкцияИзПриказа", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
