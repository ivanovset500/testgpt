&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	Если Параметры.Свойство("ЗалоговыйБилет") Тогда  
		ЗБ = Параметры.ЗалоговыйБилет;
	    ЭтаФорма.Заголовок = "Приказы по процентым ставкам в залогововом билете № " + ЗБ.НомерЗалоговогоБилета;  

		ОтборПриказа = ЛБ_ОбщийМодуль.ПолучитьПриказыПоПроценымСтавкамВЗБ(ЗБ);
		Если ОтборПриказа.Количество() = 0 Тогда
			Если Параметры.Свойство("Приказ") Тогда  
				ЭтаФорма.Заголовок = "Приказы по процентым ставкам на дату залоговового билета № " + ЗБ.НомерЗалоговогоБилета;
				ОтборПриказа = Новый СписокЗначений;
				ОтборПриказа.Добавить(Параметры.Приказ); 
			КонецЕсли;	 
		КонецЕсли;	
				
		ЭтаФорма.Элементы.ТаблицаПриказов.КоманднаяПанель.Видимость = ложь; 
		ЭтаФорма.Элементы.ЦеныМеталлыКнопкиДоп.Видимость = Ложь;
		ЭтаФорма.Элементы.ТекущийПриказЦеныВставкиГруппаЗаполнить.Видимость = Ложь; 
		ЭтаФорма.Элементы.ТаблицаСтавокАкцииЗаполнитьАкцииСтавкиПоШаблону.Видимость = Ложь; 
		ЭтаФорма.Элементы.ТаблицаСтавокАкцииЗаполнитьПроцентныеСтавкиАкция.Видимость = Ложь;  
		ЭтаФорма.Элементы.ГруппаПараметрыПечати.Видимость = Ложь;
	ИначеЕсли Параметры.Свойство("Действующие") Тогда
		ЭтаФорма.Заголовок = "Действующие приказы"; 
		Если Параметры.Свойство("Ломбард") Тогда
			ТекЛомбард = Параметры.Ломбард;
			ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " в ломбарде № " + СокрЛП(ТекЛомбард.НомерЛомбарда);
		КонецЕсли;	   
		ОтборПриказа = ЛБ_ОбщийМодуль.ПолучитьДействующиеПриказы(ТекЛомбард); 		
		ЭтаФорма.Элементы.ТаблицаПриказов.КоманднаяПанель.Видимость = ложь;  
		ЭтаФорма.Элементы.ЦеныМеталлыКнопкиДоп.Видимость = Ложь; 
		ЭтаФорма.Элементы.ТекущийПриказЦеныВставкиГруппаЗаполнить.Видимость = Ложь; 
		ЭтаФорма.Элементы.ТаблицаСтавокАкцииЗаполнитьАкцииСтавкиПоШаблону.Видимость = Ложь; 
		ЭтаФорма.Элементы.ТаблицаСтавокАкцииЗаполнитьПроцентныеСтавкиАкция.Видимость = Ложь;  
		ЭтаФорма.Элементы.ГруппаПараметрыПечати.Видимость = Ложь;
	Иначе	
		ОсновнаяЕдиницаИзмерения = Константы.ЛБ_ОсновнаяЕдиницаМеталлы.Получить();
		ЗаполнитьВыборЕдиницИзмерения(); 
		
		ОсновнаяЕдиницаИзмеренияВставки = Константы.ЛБ_ОсновнаяЕдиницаКамни.Получить();
		ЗаполнитьВыборЕдиницИзмеренияВставки();  
		
		ЗапросБазовыеЦены = Новый Запрос;
		ЗапросБазовыеЦены.Текст = "ВЫБРАТЬ
		                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.Период КАК Период,
		                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.Проба КАК Проба,
		                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.КатегорияОбъектаЗалога КАК Категория
		                          |ИЗ
		                          |	РегистрСведений.ЛБ_БазовыеЦеныНаДрагоценныеМеталлы КАК ЛБ_БазовыеЦеныНаДрагоценныеМеталлы
		                          |
		                          |УПОРЯДОЧИТЬ ПО
		                          |	Период";
		ТаблицаБазовыеЦены.Загрузить(ЗапросБазовыеЦены.Выполнить().Выгрузить());
		
		//Запрос = Новый Запрос;
		//Запрос.Текст = "ВЫБРАТЬ
		//               |	ЛБ_ДиапазоныСуммЗайма.Ссылка КАК Ссылка
		//               |ИЗ
		//               |	Справочник.ЛБ_ДиапазоныСуммЗайма КАК ЛБ_ДиапазоныСуммЗайма
		//               |ГДЕ
		//               |	ЛБ_ДиапазоныСуммЗайма.ЭтоГруппа = ЛОЖЬ
		//               |	И ЛБ_ДиапазоныСуммЗайма.ПометкаУдаления = ЛОЖЬ
		//               |
		//               |УПОРЯДОЧИТЬ ПО
		//               |	ЛБ_ДиапазоныСуммЗайма.ПорядокСортировки";
		//Выборка = Запрос.Выполнить().Выбрать();
		//Пока Выборка.Следующий() Цикл
		//    Элементы.ТаблицаСтавокДиапазонСумм.СписокВыбора.Добавить(Выборка.Ссылка); 
		//	Элементы.ТаблицаСтавокАкцииДиапазонСумм.СписокВыбора.Добавить(Выборка.Ссылка);
		//КонецЦикла;	

		КонПериода = ТекущаяДата(); 
		НачПериода = НачалоДня(ДобавитьМесяц(КонПериода, -2));  
		Период = Новый СтандартныйПериод(НачПериода, КонПериода);
		ЭтаФорма.Заголовок = "Журнал приказов " + ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания);
    КонецЕсли;
	ЗаполнитьТаблицуПриказов();
    ЗаполнитьДеревоЛомбардов(); 
	
	Элементы.СпособВыводаЛомбардовНаПечать.СписокВыбора.Очистить();  
	Элементы.СпособВыводаЛомбардовНаПечать.СписокВыбора.Добавить(0, "по ломбардам"); 
	Элементы.СпособВыводаЛомбардовНаПечать.СписокВыбора.Добавить(1, "по отделениям ломбардов");
	
	СпособВыводаЛомбардовНаПечать = ТекущийПриказ.ВыводитьЛомбарды; 
	ЕстьПолныеПрава = ?(РольДоступна("Администрирование"), истина, ложь);   
	
	Если ЗначениеЗаполнено(ОтборПриказа) Тогда 
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаСтавки;
	КонецЕсли;	
КонецПроцедуры 


&НаСервере
Процедура ЗаполнитьДеревоЛомбардов()

    Запрос = Новый Запрос; 
    Если ВидОтбораЛомбардов = 0 Тогда
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	ЛБ_Ломбарды.Ссылка КАК Ломбард,
	                   |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	                   |ИЗ
	                   |	Справочник.ЛБ_Ломбарды КАК ЛБ_Ломбарды
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	                   |		ПО (ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард = ЛБ_Ломбарды.Ссылка)
	                   |ГДЕ
	                   |	ЛБ_Ломбарды.Закрыт = ЛОЖЬ";
    Иначе	
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	ЛБ_Ломбарды.Ссылка КАК Ломбард,
	                   |	ЛБ_ГруппыЛомбардовСрезПоследних.Группа КАК Отделение
	                   |ИЗ
	                   |	Справочник.ЛБ_Ломбарды КАК ЛБ_Ломбарды
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыЛомбардов.СрезПоследних КАК ЛБ_ГруппыЛомбардовСрезПоследних
	                   |		ПО (ЛБ_ГруппыЛомбардовСрезПоследних.Ломбард = ЛБ_Ломбарды.Ссылка)
	                   |ГДЕ
	                   |	ЛБ_Ломбарды.Закрыт = ЛОЖЬ";
    КонецЕсли;	   
    ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
    Отделения = ТаблицаЗапроса.Скопировать(); 
    Отделения.Свернуть("Отделение");
	 	
	ДанныеДерево =  Новый ДеревоЗначений;  
	ДанныеДерево.Колонки.Добавить("Ломбард"); 
	ДанныеДерево.Колонки.Добавить("Предопределенный", Новый ОписаниеТипов("Булево"));
	ДанныеДерево.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	ДанныеДерево.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	ДанныеДерево.Колонки.Добавить("ОтделениеРодитель");
	Для каждого СтрО Из Отделения Цикл 
		СтрокаВерхнего = ДанныеДерево.Строки.Добавить();
		Если СтрО.Отделение = null Тогда
		    СтрокаВерхнего.Ломбард = ?(ВидОтбораЛомбардов = 0, Справочники.ЛБ_ОтделенияЛомбардов.ЛомбардыВнеОтделений, Справочники.ЛБ_ГруппыЛомбардов.ЛомбардыВнеГрупп);
			СтрокаВерхнего.Предопределенный = Истина;
		Иначе    
			СтрокаВерхнего.Ломбард = СтрО.Отделение;
		КонецЕсли;
		СтрокаВерхнего.ЭтоГруппа = Истина;
		
		Отбор = Новый Структура; 
		Отбор.Вставить("Отделение", СтрО.Отделение);          
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Для каждого стр Из Строки Цикл		
		   СтрокаВторого = СтрокаВерхнего.Строки.Добавить();
		   СтрокаВторого.Ломбард = Стр.Ломбард;
		   СтрокаВторого.ОтделениеРодитель = СтрокаВерхнего.Ломбард; 
		КонецЦикла;
	Конеццикла;	 
	ДанныеДерево.Строки.Сортировать("Предопределенный Убыв, Ломбард", Истина);
		
	ЗначениеВРеквизитФормы(ДанныеДерево, "Дерево");  
	Если НЕ СписокЛомбардыОтбор.Количество() = 0 Тогда                        
		ДеревоНаСервере = РеквизитФормыВЗначение("Дерево");
		ПроставитьГалочки(ДеревоНаСервере);
		ЗначениеВРеквизитФормы(ДеревоНаСервере, "Дерево");	
	КонецЕсли;
КонецПроцедуры  

&НаСервере
Процедура ПроставитьГалочки(ДеревоНаСервере)
	Для каждого Строка Из ДеревоНаСервере.Строки Цикл		
		Если НЕ СписокЛомбардыОтбор.НайтиПоЗначению(Строка.Ломбард) = неопределено  Тогда
			Строка.Пометка = Истина; 
		КонецЕсли;		

		Если НЕ Строка.Строки.Количество() = 0 Тогда
			ПроставитьГалочки(Строка);
		КонецЕсли;	
	
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимость()
	Если ТекущийПриказ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.Базовый") Тогда 		
		Элементы.ГруппаЦеныМеталлы.Видимость = Истина;  
		Элементы.ГруппаЦеныВставки.Видимость = Истина;
		Элементы.ГруппаСтавки.Видимость = Истина; 
		Элементы.ГруппаАкцииМеталлы.Видимость = ложь; 
		Элементы.ГруппаАкцииСтавки.Видимость = ложь; 
		Элементы.ГруппаАкция.Видимость = ложь;
		Элементы.ГруппаСК.Видимость = Истина; 
		Элементы.ТекущийПриказНачальникОДО.Видимость = Истина;
		Элементы.ТекущийПриказНачальникОРБ.Видимость = Истина;
		Элементы.ТекущийПриказОтветственноеЛицоОРБ.Видимость = Ложь;
		Элементы.ТекущийПриказОтветственноеЛицоРеклама.Видимость = Ложь;
		Элементы.ТекущийПриказПодписантДолжность.Видимость = Ложь;
		Элементы.ТекущийПриказПодписантФИО.Видимость = Ложь;
		Элементы.СпособВыводаЛомбардовНаПечать.Видимость = Ложь; 
		Элементы.ТекущийПриказНеВыводитьНаПечатьПричиныПрименения.Видимость = Истина;
	Иначе 
		Элементы.ГруппаЦеныМеталлы.Видимость = ложь;  
		Элементы.ГруппаЦеныВставки.Видимость = ложь;
		Элементы.ГруппаСтавки.Видимость = ложь; 
		Элементы.ГруппаАкцииМеталлы.Видимость = Истина; 
		Элементы.ГруппаАкцииСтавки.Видимость = Истина;  
		Элементы.ГруппаАкция.Видимость = Истина;
		Элементы.ГруппаСК.Видимость = ложь;  
		Элементы.ТекущийПриказНачальникОДО.Видимость = Ложь;
		Элементы.ТекущийПриказНачальникОРБ.Видимость = Истина; 
		Элементы.ТекущийПриказОтветственноеЛицоОРБ.Видимость = Истина;
		Элементы.ТекущийПриказОтветственноеЛицоРеклама.Видимость = Истина;
		Элементы.ТекущийПриказПодписантДолжность.Видимость = Истина;
		Элементы.ТекущийПриказПодписантФИО.Видимость = Истина;
		Элементы.СпособВыводаЛомбардовНаПечать.Видимость = Истина;  
		Элементы.ТекущийПриказНеВыводитьНаПечатьПричиныПрименения.Видимость = Ложь;
	КонецЕсли;
	Если ТекущийПриказ.Проведен тогда
		Элементы.ТаблицаПриказовКнопкаОтменитьПроведение.Доступность = Истина; 
		Элементы.ТекущийПриказНачальникОДО.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказНачальникОРБ.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказОтветственноеЛицоОРБ.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказОтветственноеЛицоРеклама.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказПодписантДолжность.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказПодписантФИО.ТолькоПросмотр = Истина;
		Элементы.СпособВыводаЛомбардовНаПечать.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказНеВыводитьНаПечатьПричиныПрименения.ТолькоПросмотр = Истина;
		//+МАН 17.12.24 Заявка 2934       
		Элементы.ГруппаСтавки.ТолькоПросмотр = Истина;
		Элементы.ГруппаЦеныМеталлы.ТолькоПросмотр = Истина;
		Элементы.ГруппаЦеныВставки.ТолькоПросмотр = Истина;   
		Элементы.ГруппаАкцииСтавки.ТолькоПросмотр = Истина;
		Элементы.ГруппаПараметрыПечати.ТолькоПросмотр = Истина;
		Элементы.ТекущийПриказЦеныВставкиГруппаЗаполнить.Доступность = Ложь;
		Элементы.ЦеныМеталлыКнопкиДоп.Доступность = Ложь; 
		Элементы.ТаблицаОтклоненийОтБазовыхЦенМеталлы.КоманднаяПанель.Доступность =ложь;
		Элементы.ТаблицаСтавокАкции.КоманднаяПанель.Доступность = Ложь;  
		Элементы.ТаблицаСтавок.КоманднаяПанель.Доступность = Ложь;
		//-МАН
	Иначе
		Элементы.ТаблицаПриказовКнопкаОтменитьПроведение.Доступность = ложь; 
		Элементы.ТекущийПриказНачальникОДО.ТолькоПросмотр = Ложь;
		Элементы.ТекущийПриказНачальникОРБ.ТолькоПросмотр = Ложь;
		Элементы.ТекущийПриказОтветственноеЛицоОРБ.ТолькоПросмотр = Ложь;
		Элементы.ТекущийПриказОтветственноеЛицоРеклама.ТолькоПросмотр = Ложь;
		Элементы.ТекущийПриказПодписантДолжность.ТолькоПросмотр = Ложь;
		Элементы.ТекущийПриказПодписантФИО.ТолькоПросмотр = Ложь;
		Элементы.СпособВыводаЛомбардовНаПечать.ТолькоПросмотр = Ложь;
        Элементы.ТекущийПриказНеВыводитьНаПечатьПричиныПрименения.ТолькоПросмотр = Ложь;
		//+МАН 17.12.24 Заявка 2934   
		Элементы.ГруппаСтавки.ТолькоПросмотр = Ложь;
		Элементы.ГруппаЦеныМеталлы.ТолькоПросмотр = Ложь;
		Элементы.ГруппаЦеныВставки.ТолькоПросмотр = Ложь;  
		Элементы.ГруппаАкцииСтавки.ТолькоПросмотр = Ложь;
		Элементы.ГруппаПараметрыПечати.ТолькоПросмотр = Ложь;
		Элементы.ТекущийПриказЦеныВставкиГруппаЗаполнить.Доступность = Истина;
		Элементы.ЦеныМеталлыКнопкиДоп.Доступность = Истина;
		Элементы.ТаблицаОтклоненийОтБазовыхЦенМеталлы.КоманднаяПанель.Доступность = истина; 
		Элементы.ТаблицаСтавокАкции.КоманднаяПанель.Доступность = Истина; 
		Элементы.ТаблицаСтавок.КоманднаяПанель.Доступность = Истина;
		//-МАН
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Процедура ПолучитьДополнительныеРеквизиты(СтрокаПриказа) 
	ДокументОбъект = СтрокаПриказа.Ссылка.ПолучитьОбъект();
	ЛБ_УправлениеЛомбардом.ЗаполнитьДополнительныеРеквизитыПриказа(ДокументОбъект); 
	ДокументОбъект.Записать();    
	
	СтрокаПриказа.Металлы = ДокументОбъект.ЕстьМеталлы;
	//+МАН 24.01.25 Добавление отметки наличия отклонений металлов. Заявка 2792.
	СтрокаПриказа.ОтклМеталлы = ДокументОбъект.ЕстьОтклМеталлы;
	//-МАН
	СтрокаПриказа.Вставки = ДокументОбъект.ЕстьВставки;
	СтрокаПриказа.ПроцентныеСтавки = ДокументОбъект.ЕстьПроцентныеСтавки;
	СтрокаПриказа.АкцияСтавки = ДокументОбъект.ЕстьАкцииПроцентныеСтавки; 
	СтрокаПриказа.АкцияМеталлы = ДокументОбъект.ЕстьАкцииМеталлы;
	СтрокаПриказа.КоличествоЛомбардов = ДокументОбъект.КоличествоЛомбардов; 
	СтрокаПриказа.БазоваяЦенаМеталлы = ДокументОбъект.БазоваяЦенаМеталлы;
	СтрокаПриказа.МаксимальнаяПроцентнаяСтавка = ДокументОбъект.МаксимальнаяПроцентнаяСтавка; 
 КонецПроцедуры	
	
&НаСервере
Процедура ЗаполнитьТаблицуПриказов(ИдентификаторСтроки = неопределено)    
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата1", ?(НачПериода = Дата(1,1,1), НачПериода, НачалоДня(НачПериода))); 
	Запрос.УстановитьПараметр("Дата2", ?(КонПериода = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(КонПериода)));
	Запрос.УстановитьПараметр("СписокЛомбардов", ВыборСписокЛомбардов);
	Запрос.УстановитьПараметр("НомерПриказа", СокрЛП(ВыборНомерПриказа) + "%"); 
	Запрос.УстановитьПараметр("ОтборПриказа", ОтборПриказа);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка КАК Ссылка,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.Номер КАК Номер,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.Дата КАК Дата,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.Ответственный КАК Ответственный,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.Комментарий КАК Комментарий,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.СтрокаЛомбарды КАК СтрокаЛомбарды,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ДатаОкончанияДействияПриказа КАК ДатаОкончанияДействияПриказа,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ВидОперации КАК ВидОперации,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ВидПриказа КАК ВидПриказа,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ДатаНачалаДействияПриказа КАК ДатаНачалаДействияПриказа,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.НомерПриказа КАК НомерПриказа,
	              |	ВЫБОР
	              |		КОГДА ЛБ_ПриказУсловияПредоставленияЗаймов.ПометкаУдаления
	              |			ТОГДА 2
	              |		ИНАЧЕ ВЫБОР
	              |				КОГДА ЛБ_ПриказУсловияПредоставленияЗаймов.Проведен
	              |					ТОГДА 1
	              |				ИНАЧЕ 0
	              |			КОНЕЦ
	              |	КОНЕЦ КАК СостояниеДокумента,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ЕстьМеталлы КАК Металлы,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ЕстьВставки КАК Вставки,
				//+МАН 24.01.25 Добавление отметки наличия отклонений металлов. Заявка 2792.
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ЕстьОтклМеталлы КАК ОтклМеталлы,
				//-МАН
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ЕстьПроцентныеСтавки КАК ПроцентныеСтавки,
				  //+МАН 22.01.25 Исправил наименование колонок в запросе для дальнейшего, корректного, заполнения списка. Заявка 2581
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ЕстьАкцииПроцентныеСтавки КАК АкцияСтавки,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.ЕстьАкцииМеталлы КАК АкцияМеталлы,
				  //-МАН
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.КоличествоЛомбардов КАК КоличествоЛомбардов,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.БазоваяЦенаМеталлы КАК БазоваяЦенаМеталлы,
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.МаксимальнаяПроцентнаяСтавка КАК МаксимальнаяПроцентнаяСтавка,
				  //+МАН 15.11.24 Вывод наименования акции в ТЧ приказов. Заявка 2581.
				  |	ЛБ_ПриказУсловияПредоставленияЗаймов.Акция КАК Акция
				  //-МАН
	              |ИЗ
	              |	Документ.ЛБ_ПриказУсловияПредоставленияЗаймов КАК ЛБ_ПриказУсловияПредоставленияЗаймов
	              |ГДЕ
	              |	ЛБ_ПриказУсловияПредоставленияЗаймов.Дата МЕЖДУ &Дата1 И &Дата2";
	Если НЕ ВыборСписокЛомбардов.Количество() = 0 Тогда
		Запрос.Текст = Запрос.Текст + "
	              |	И ЛБ_ПриказУсловияПредоставленияЗаймов.Ломбарды.Ломбард В(&СписокЛомбардов)";
	КонецЕсли;  
	Если НЕ ПустаяСтрока(ВыборНомерПриказа) Тогда
		Запрос.Текст = Запрос.Текст + "
	              |	И ЛБ_ПриказУсловияПредоставленияЗаймов.НомерПриказа ПОДОБНО &НомерПриказа";
	КонецЕсли; 
	Если ЗначениеЗаполнено(ОтборПриказа) Тогда
		Запрос.Текст = Запрос.Текст + "
	              |	И ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка В (&ОтборПриказа)";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Дата УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаПриказов.Загрузить(ТаблицаЗапроса); 
	
	Если НЕ ТаблицаПриказов.Количество() = 0 Тогда
		Если ИдентификаторСтроки = неопределено Тогда
			//КолСтр = ТаблицаПриказов.Количество();
			СтрокаТЗ = ТаблицаПриказов[0];
			ИдентификаторСтроки = СтрокаТЗ.ПолучитьИдентификатор();
		КонецЕсли;	
		Элементы.ТаблицаПриказов.ТекущаяСтрока = ИдентификаторСтроки;
		ДокументОбъект = ТаблицаПриказов[0].Ссылка.ПолучитьОбъект();
		ЗначениеВРеквизитФормы(ДокументОбъект, "ТекущийПриказ");
		Если ДокументОбъект.Проведен Тогда 
			Элементы.СтрокаЛомбарды.ТолькоПросмотр = Истина;
			Элементы.СтрокаСК.ТолькоПросмотр = Истина;
	        Элементы.Акция.ТолькоПросмотр = Истина;
		Иначе
			Элементы.СтрокаЛомбарды.ТолькоПросмотр = Ложь;
			Элементы.СтрокаСК.ТолькоПросмотр = Ложь;
	        Элементы.Акция.ТолькоПросмотр = Ложь; 
		КонецЕсли;	
  	Иначе
		ДокументОбъект = Документы.ЛБ_ПриказУсловияПредоставленияЗаймов.СоздатьДокумент();   
		ЗначениеВРеквизитФормы(ДокументОбъект, "ТекущийПриказ");
	КонецЕсли;	
		
КонецПроцедуры  

&НаСервере 
