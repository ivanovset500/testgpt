КонецПроцедуры  
		
&НаСервере
Процедура ЗаполнитьАкциСтавкиПоНастройкамНаСервере(ВыборАкции = Ложь) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ"); 
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Акция) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбрана акция!");
		Возврат;
	КонецЕсли;	

		
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата); 
	Запрос.УстановитьПараметр("Акция", ДокументОбъект.Акция);
	Запрос.УстановитьПараметр("ВидШаблона", Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавкиАкция);
	МассивЛ = ДокументОбъект.Ломбарды.ВыгрузитьКолонку("Ломбард");  
	МассивЛ.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка());
	Запрос.УстановитьПараметр("Ломбарды", МассивЛ); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.ШаблонПриказа КАК ШаблонПриказа,
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.Отменен КАК Отменен,
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_УстановкаОтменаШаблонаПриказа.СрезПоследних(
	               |			&Дата,
	               |			ВидШаблона = &ВидШаблона
	               |				И Акция = &Акция
	               |				И Ломбард В (&Ломбарды)) КАК ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних"; 
	ТЗ = Запрос.Выполнить().Выгрузить();   
	ТаблицаРегистраторов = Новый ТаблицаЗначений; 
	ТаблицаРегистраторов.Колонки.Добавить("Ломбард"); 
	ТаблицаРегистраторов.Колонки.Добавить("Регистратор");
	Отбор = Новый Структура;
	Для каждого СтрЛ Из ДокументОбъект.Ломбарды Цикл			
		Отбор.Вставить("Ломбард", СтрЛ.Ломбард); 
		Строки = ТЗ.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.Получить(0); 
			Если НЕ Стр.Отменен Тогда
				стрР = ТаблицаРегистраторов.Добавить(); 
				СтрР.Ломбард = СтрЛ.Ломбард;
				СтрР.Регистратор = Стр.ШаблонПриказа;			                                        
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		Отбор.Вставить("Ломбард", Справочники.ЛБ_Ломбарды.ПустаяСсылка());  
		Строки = ТЗ.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.Получить(0);
			стрР = ТаблицаРегистраторов.Добавить(); 
			СтрР.Ломбард = СтрЛ.Ломбард;
			СтрР.Регистратор = Стр.ШаблонПриказа; 
		Иначе
			стрР = ТаблицаРегистраторов.Добавить(); 
			СтрР.Ломбард = СтрЛ.Ломбард;
		КонецЕсли;	
	КонецЦикла;	   
	
	СписокРегистраторов = Новый СписокЗначений;
	СписокЛомбардовБезШаблона = "";
	Для каждого СтрР Из ТаблицаРегистраторов Цикл  
		Если НЕ ЗначениеЗаполнено(СтрР.Регистратор) Тогда
			СписокЛомбардовБезШаблона = СписокЛомбардовБезШаблона + ?(ПустаяСтрока(СписокЛомбардовБезШаблона), "", ", ") + СокрЛП(СтрР.Ломбард);
		Иначе 
			Если СписокРегистраторов.НайтиПоЗначению(СтрР.Регистратор) = неопределено  Тогда  
				СписокРегистраторов.Добавить(СтрР.Регистратор);
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;
	
	Если НЕ ПустаяСтрока(СписокЛомбардовБезШаблона) Тогда  
		Если НЕ ВыборАкции Тогда
		    ОбщегоНазначения.СообщитьПользователю("Для ломбардов " + СписокЛомбардовБезШаблона +  " не найдено установленного шаблона по процентым ставкам акции " + СокрЛП(ДокументОбъект.Акция) + ".");  
		КонецЕсли;	
		Возврат; 
	КонецЕсли;
	
	Если СписокРегистраторов.Количество() = 0 Тогда 
		Если НЕ ВыборАкции Тогда
		    ОбщегоНазначения.СообщитьПользователю("Для выбранных ломбардов не найдено установленного шаблона по процентым ставкам акции " + СокрЛП(ДокументОбъект.Акция) + "."); 
		КонецЕсли;	
		Возврат;   
	ИначеЕсли СписокРегистраторов.Количество() > 1 Тогда  
		Если НЕ ВыборАкции Тогда
			ОбщегоНазначения.СообщитьПользователю("Для  выбранных ломбардов найдено " + Строка(СписокРегистраторов.Количество()) + " установленных шаблона по процентым ставкамакции " + СокрЛП(ДокументОбъект.Акция) + ".");
		КонецЕсли;
	Возврат;   	
	КонецЕсли;	

	ТекРегистратор = СписокРегистраторов.Получить(0).Значение;
    Запрос.УстановитьПараметр("Регистратор", ТекРегистратор);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция.СтатусЗалогодателя КАК СтатусЗалогодателя,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция.ДиапазонСумм КАК ДиапазонСумм,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция.ДиапазонСумм.ПорядокСортировки КАК ДиапазонСуммПорядокСортировки
	               |ИЗ
	               |	РегистрСведений.ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция КАК ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция
	               |ГДЕ
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавкиАкция.Регистратор = &Регистратор
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СхемаКредитования,
	               |	ПричинаПрименения УБЫВ,
	               |	СтатусЗалогодателя,
	               |	ДиапазонСуммПорядокСортировки";
	ТаблицаШаблона = Запрос.Выполнить().Выгрузить();
   	ДокументОбъект.УсловияАкцииСтавки.Очистить(); 
	ТаблицаСтавок = ПолучитьАкцияПроцентныеСтавкиСрезПоследних(ДокументОбъект);

	Для каждого СтрШ Из ТаблицаШаблона Цикл 
		НоваяСтрП = ДокументОбъект.УсловияАкцииСтавки.Добавить();
		НоваяСтрП.СхемаКредитования = СтрШ.СхемаКредитования;
		НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
		НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
		НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм; 
		
		Если НЕ ТаблицаСтавок.Количество() = 0 Тогда
			Запрос = Новый Запрос; 
			Запрос.УстановитьПараметр("ТЗ", ТаблицаСтавок);
			Запрос.УстановитьПараметр("ПричинаПрименения", НоваяСтрП.ПричинаПрименения); 
			Запрос.УстановитьПараметр("ДиапазонСумм", НоваяСтрП.ДиапазонСумм);  
			СК = Новый СписокЗначений;
			СК.Добавить(НоваяСтрП.СхемаКредитования);
			СК.Добавить(Справочники.ЛБ_СхемыКредитования.ПустаяСсылка());
			Запрос.УстановитьПараметр("СхемыКредитования", СК); 
			Статусы = Новый СписокЗначений;
			Статусы.Добавить(НоваяСтрП.СтатусЗалогодателя);
			Статусы.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
			Запрос.УстановитьПараметр("Статусы", Статусы);
			Запрос.Текст = "ВЫБРАТЬ
			               |	ТЗ.ПричинаПрименения КАК ПричинаПрименения,
			               |	ТЗ.СхемаКредитования КАК СхемаКредитования,
			               |	ТЗ.СтатусЗалогодателя КАК СтатусЗалогодателя,
			               |	ТЗ.ДиапазонСумм КАК ДиапазонСумм,
			               |	ТЗ.Ставка КАК Ставка,
			               |	ТЗ.Отклонение КАК Отклонение,
			               |	ТЗ.ЗначениеОтклонения КАК ЗначениеОтклонения
			               |ПОМЕСТИТЬ Таблица
			               |ИЗ
			               |	&ТЗ КАК ТЗ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	Таблица.Ставка КАК Ставка,
			               |	Таблица.Отклонение КАК Отклонение,
			               |	Таблица.ЗначениеОтклонения КАК ЗначениеОтклонения
			               |ИЗ
			               |	Таблица КАК Таблица
			               |ГДЕ
			               |	Таблица.ПричинаПрименения = &ПричинаПрименения
			               |	И Таблица.ДиапазонСумм = &ДиапазонСумм
			               |	И Таблица.СхемаКредитования В(&СхемыКредитования)
			               |	И Таблица.СтатусЗалогодателя В(&Статусы)
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	Таблица.СхемаКредитования УБЫВ,
			               |	Таблица.СтатусЗалогодателя УБЫВ"; 
            Выборка = Запрос.Выполнить().Выбрать(); 
			Если Выборка.Следующий() Тогда
				Если НЕ Выборка.ставка = 0 Тогда
				    НоваяСтрП.Ставка = Выборка.ставка;
					НоваяСтрП.УстановитьЗначениеИлиОтклонение = Перечисления.ЛБ_УстановкаЗначенияИлиОтклонения.Значение; 
				Иначе 
					НоваяСтрП.Отклонение = Выборка.Отклонение;  
					НоваяСтрП.ЗначениеОтклонения = Выборка.ЗначениеОтклонения;
					НоваяСтрП.УстановитьЗначениеИлиОтклонение = Перечисления.ЛБ_УстановкаЗначенияИлиОтклонения.Отклонение; 
				КонецЕсли;	
			Иначе   
				НоваяСтрП.УстановитьЗначениеИлиОтклонение = Перечисления.ЛБ_УстановкаЗначенияИлиОтклонения.Значение;
			    НоваяСтрП.Ставка = 0;
			КонецЕсли;
		Иначе  
			НоваяСтрП.УстановитьЗначениеИлиОтклонение = Перечисления.ЛБ_УстановкаЗначенияИлиОтклонения.Значение;
		    НоваяСтрП.Ставка = 0;
		КонецЕсли;	
    Конеццикла;	

	ДокументОбъект.ШаблонАкцииПроцентныеСтавки = ТекРегистратор;
	ДокументОбъект.Записать();     
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);  
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры    

&НаСервере
Процедура ОчиститьСхемуКредитованияНаСервере(СхемаКредитования) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");  
	
    ОтборК = Новый Структура;
	ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
	
	Строки = ДокументОбъект.СтавкиПроцентов.НайтиСтроки(ОтборК);
	Для каждого Стр из Строки цикл   
		ДокументОбъект.СтавкиПроцентов.Удалить(Стр);
	КонецЦикла;	

	Строки = ДокументОбъект.СхемыКредитования.НайтиСтроки(ОтборК);
	Для каждого Стр из Строки цикл   
		ДокументОбъект.СхемыКредитования.Удалить(Стр);
	КонецЦикла;	
	ДокументОбъект.Записать(); 
	ЗаполнитьСписокСК(ДокументОбъект);
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор); 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры	

&НаКлиенте
Процедура СтрокаСКОчистка(Элемент, СтандартнаяОбработка)
	СписокК = Новый списокЗначений;
	Для каждого СтрК Из ТекущийПриказ.СхемыКредитования Цикл
		СписокК.Добавить(СтрК.СхемаКредитования);
	КонецЦикла;                                
	Если СписокК.ОтметитьЭлементы("Выберите для удаления") Тогда 
		Для каждого СК Из СписокК Цикл  
			Если СК.Пометка Тогда 
				ОчиститьСхемуКредитованияНаСервере(СК.Значение);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроцентныеСтавкиПоШаблону(Команда)
	Для каждого СтрК Из ТекущийПриказ.СхемыКредитования Цикл 
		ОбработкаВыбораСК(СтрК.СхемаКредитования, Ложь);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьПроцентныеСтавкиПоПриказу(Команда)  
	Если НЕ ТекущийПриказ.СтавкиПроцентов.Количество() = 0 Тогда
		ТекЛомбард = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка");
		Если ВвестиЗначение(ТекЛомбард, "Выберите ломбард", Тип("СправочникСсылка.ЛБ_Ломбарды")) Тогда 
			Для каждого СтрК Из ТекущийПриказ.СхемыКредитования Цикл
		        ПроставитьПроцентныеСтавкиПоТекущимНастройкам(СтрК.СхемаКредитования, ТекЛомбард); 
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЦенуВставкиНаСервере(НомерСтроки, Цена) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
    ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ"); 
	СтрВ = ДокументОбъект["ЦеныВставки"].Получить(НомерСтроки); 
	СтрВ.Цена = Цена;
	ДокументОбъект.Записать();
КонецПроцедуры	
	
&НаКлиенте
Процедура ЦеныВставкиЦенаПриИзменении(Элемент)
	ТекСтрока = Элементы.ТекущийПриказЦеныВставки.ТекущиеДанные;
	ИзменитьЦенуВставкиНаСервере(ТекСтрока.НомерСтроки-1, ТекСтрока.Цена);    
КонецПроцедуры

&НаСервере
Процедура ИзменитьЦенуМеталлаНаСервере(НомерСтроки, Цена) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
    ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ"); 
	СтрМ = ДокументОбъект["ЦеныМеталлы"].Получить(НомерСтроки); 
	СтрМ.Цена = Цена;   
	ДокументОбъект.БазоваяЦенаМеталлы = Цена;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.ШаблонМеталлы);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.Металл КАК Металл,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.Проба КАК Проба,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.Категория КАК Категория,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.БазоваяНастройка КАК БазоваяНастройка,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.БазоваяЦена КАК БазоваяЦена,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.ОклонениеОтБазовой КАК ОклонениеОтБазовой,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.ЗначениеОтклонения КАК ЗначениеОтклонения,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.ПорядокОкругления КАК ПорядокОкругления,
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.ОкруглятьВБольшуюСторону КАК ОкруглятьВБольшуюСторону
	               |ИЗ
	               |	РегистрСведений.ЛБ_ТекущийШаблонПриказаМеталлы КАК ЛБ_ТекущийШаблонПриказаМеталлы
	               |ГДЕ
	               |	ЛБ_ТекущийШаблонПриказаМеталлы.Регистратор = &Регистратор";
	ШаблонМеталлов = Запрос.Выполнить().Выгрузить(); 
	
	ЦенаБазовая = Цена;			
	Для каждого Стр Из ШаблонМеталлов Цикл 
		Отбор = Новый Структура;
		Отбор.Вставить("Металл", Стр.Металл); 
		Отбор.Вставить("Проба", Стр.Проба);
		Отбор.Вставить("КатегорияОбъектаЗалога", Стр.Категория);
		СтрокиМ = ДокументОбъект.ЦеныМеталлы.НайтиСтроки(Отбор); 
		Если НЕ СтрокиМ.Количество() = 0 Тогда
			СтрМ = СтрокиМ.Получить(0);
		  	Если Стр.БазоваяНастройка Тогда 
				 СтрМ.Цена = ЦенаБазовая;
			 Иначе
				 Если Стр.ОклонениеОтБазовой = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное Тогда  
					 СтрМ.Цена = ЦенаБазовая + стр.ЗначениеОтклонения;
				 ИначеЕсли Стр.ОклонениеОтБазовой = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
					 СтрМ.Цена = ЦенаБазовая + ЦенаБазовая*стр.ЗначениеОтклонения/100;
				 КонецЕсли;	  
				 Если ЗначениеЗаполнено(Стр.ПорядокОкругления) Тогда     
					 СтрМ.Цена = ЛБ_ОбщийМодуль.ОкруглитьЦену(СтрМ.Цена, Стр.ПорядокОкругления, Стр.ОкруглятьВБольшуюСторону);
				 КонецЕсли;	 
			 КонецЕсли;	 
		КонецЕсли;	 
	КонецЦикла;

	ДокументОбъект.Записать(); 
		
    ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);  
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры	

&НаКлиенте
Процедура ЦеныМеталлыЦенаПриИзменении(Элемент)
	ТекСтрока = Элементы.ЦеныМеталлы.ТекущиеДанные;
	ИзменитьЦенуМеталлаНаСервере(ТекСтрока.НомерСтроки-1, ТекСтрока.Цена);  

КонецПроцедуры

&НаКлиенте
Процедура ПросмотрШаблона(Команда) 
	ИмяАктивнойСтраницы = Элементы.Страницы.ТекущаяСтраница.Имя;
	
	Если ИмяАктивнойСтраницы = "ГруппаЦеныМеталлы" Тогда
		Если ЗначениеЗаполнено(ТекущийПриказ.ШаблонМеталлы) Тогда 
			ПараметрыФормы = Новый Структура("Ключ", ТекущийПриказ.ШаблонМеталлы);
			ОткрытьФорму("Документ.ЛБ_УстановитьШаблонПриказа.ФормаОбъекта", ПараметрыФормы); 
		Иначе
			Предупреждение("Шаблон не выбран в приказ", 60);
		КонецЕсли;	   
	ИначеЕсли ИмяАктивнойСтраницы = "ГруппаЦеныВставки" Тогда
		Если ЗначениеЗаполнено(ТекущийПриказ.ШаблонВставки) Тогда 
			ПараметрыФормы = Новый Структура("Ключ", ТекущийПриказ.ШаблонВставки);
			ОткрытьФорму("Документ.ЛБ_УстановитьШаблонПриказа.ФормаОбъекта", ПараметрыФормы);   
		Иначе
			Предупреждение("Шаблон не выбран в приказ", 60);	
		КонецЕсли;	
	ИначеЕсли ИмяАктивнойСтраницы = "ГруппаАкцииСтавки" Тогда 
		Если ЗначениеЗаполнено(ТекущийПриказ.ШаблонАкцииПроцентныеСтавки) Тогда 
			ПараметрыФормы = Новый Структура("Ключ", ТекущийПриказ.ШаблонАкцииПроцентныеСтавки);
			ОткрытьФорму("Документ.ЛБ_УстановитьШаблонПриказа.ФормаОбъекта", ПараметрыФормы);  
		Иначе
			Предупреждение("Шаблон не выбран в приказ", 60);	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныМеталлаПоПриказуВЛомбарде(Команда)
	Если НЕ ТекущийПриказ.ЦеныМеталлы.Количество() = 0 Тогда
		ТекЛомбард = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка");
		Если ВвестиЗначение(ТекЛомбард, "Выберите ломбард", Тип("СправочникСсылка.ЛБ_Ломбарды")) Тогда 
		    ПроставитьМеталлыПоТекущимНастройкам(ТекЛомбард); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПроставитьМеталлыПоТекущимНастройкам(Ломбард) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба.Владелец КАК Металл,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба КАК Проба,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Категория КАК КатегорияОбъектаЗалога,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Цена КАК Цена,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(
	               |			&Дата,
	               |			Ломбард = &Ломбард
	               |				И ДатаНачалаДействия < &Дата) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Металл,
	               |	Проба,
	               |	КатегорияОбъектаЗалога";
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();   
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.Металл КАК Металл,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.ПроцентОтклонения КАК ПроцентОтклонения,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.УстанавливатьОтклонение КАК УстанавливатьОтклонение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлы.СрезПоследних(&Дата, ) КАК ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних";
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСК = ТаблицаНастроек.Скопировать(); 
	ТаблицаСК.Свернуть("СхемаКредитования");

	Если НЕ ТаблицаЦен.Количество() = 0 тогда     
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
		ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
		ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
		
		Для каждого Стр Из ДокументОбъект.ЦеныМеталлы Цикл
			Отбор = новый Структура;
			Отбор.Вставить("Металл", Стр.Металл);
			Отбор.Вставить("Проба", Стр.Проба);
			Отбор.Вставить("КатегорияОбъектаЗалога", Стр.КатегорияОбъектаЗалога);
			 
			СтрокиЦен = ТаблицаЦен.НайтиСтроки(Отбор);
			Если НЕ СтрокиЦен.Количество() = 0 Тогда
				СтрЦ = СтрокиЦен.Получить(0);
				Стр.Цена = СтрЦ.Цена;
			КонецЕсли;	 
			
			Если НЕ ТаблицаСК.Количество() = 0 тогда
				Для каждого СтрК Из ТаблицаСК Цикл
					ОтборН = новый Структура;
					ОтборН.Вставить("СхемаКредитования", СтрК.СхемаКредитования);	
					ОтборН.Вставить("Металл", Стр.Металл);
					СтрокиН = ТаблицаНастроек.НайтиСтроки(ОтборН); 
					Если СтрокиН.Количество() = 0 Тогда 
						ОтборН.Вставить("Металл", Справочники.ЛБ_ДрагоценныеМеталлы.ПустаяСсылка()); 
						СтрокиН = ТаблицаНастроек.НайтиСтроки(ОтборН); 
					КонецЕсли;	
					Если СтрокиН.Количество() = 0 Тогда
						НоваяСтрН = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Добавить();
						НоваяСтрН.СхемаКредитования = СтрК.СхемаКредитования; 
						НоваяСтрН.Металл = Стр.Металл;
		                НоваяСтрН.Проба = Стр.Проба;
		                НоваяСтрН.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога;
                    Иначе 
						Для каждого СтрН Из СтрокиН Цикл  
							НоваяСтрН = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Добавить();
							НоваяСтрН.СхемаКредитования = СтрК.СхемаКредитования; 
							НоваяСтрН.Металл = Стр.Металл;
			                НоваяСтрН.Проба = Стр.Проба;
			                НоваяСтрН.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога;
					        НоваяСтрН.ОтклонениеОтБазовойЦены = СтрН.УстанавливатьОтклонение; 
							Если НоваяСтрН.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
	                            НоваяСтрН.ЗначениеОтклонения = СтрН.ПроцентОтклонения;  
							Иначе 
								НоваяСтрН.ЗначениеОтклонения = Стр.Цена*СтрН.ПроцентОтклонения/100 - Стр.Цена;
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;	
				Конеццикла;
			КонецЕсли;   
		КонецЦикла;	
		
		ДокументОбъект.Записать();     
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор); 
		СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
		ПолучитьДополнительныеРеквизиты(СтрокаПриказа); 
	КонецЕсли;	
		 
КонецПроцедуры	 

&НаСервере
Процедура СохранитьШаблонВДокументе(ВидШаблона)
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");  
	
	Если ВидШаблона = "Металлы" Тогда 
		ДокументОбъект.ШаблонМеталлы = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка"); 
		ДокументОбъект.ЦеныМеталлы.Очистить(); 
	    ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();	
	ИначеЕсли ВидШаблона = "Вставки" Тогда
		ДокументОбъект.ШаблонВставки = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка");
		ДокументОбъект.ЦеныВставки.Очистить(); 
	ИначеЕсли ВидШаблона = "АкцииСтавки" Тогда
		ДокументОбъект.ШаблонАкцииПроцентныеСтавки = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка");  
		ДокументОбъект.УсловияАкцииСтавки.Очистить(); 
	КонецЕсли;
	ДокументОбъект.Записать(); 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьШаблон(Команда)
	ИмяАктивнойСтраницы = Элементы.Страницы.ТекущаяСтраница.Имя;
	
	Если ИмяАктивнойСтраницы = "ГруппаЦеныМеталлы" Тогда
		Если ЗначениеЗаполнено(ТекущийПриказ.ШаблонМеталлы) Тогда
			ТекущийПриказ.ШаблонМеталлы = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка"); 
			СохранитьШаблонВДокументе("Металлы");
		КонецЕсли;	   
	ИначеЕсли ИмяАктивнойСтраницы = "ГруппаЦеныВставки" Тогда
		ТекущийПриказ.ШаблонВставки = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка");  
		СохранитьШаблонВДокументе("Вставки");
	ИначеЕсли ИмяАктивнойСтраницы = "ГруппаАкцииСтавки" Тогда 
		ТекущийПриказ.ШаблонАкцииПроцентныеСтавки = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка"); 
		СохранитьШаблонВДокументе("АкцииСтавки");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрШаблонаПоТекущейСК(Команда)
	ТекСтрока = Элементы.ТаблицаСтавок.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("СхемаКредитования", ТекСтрока.СхемаКредитования); 
	Строки = ТекущийПриказ.СхемыКредитования.НайтиСтроки(Отбор);
	Если НЕ Строки.Количество() = 0 Тогда 
		ПриказСтавки = Строки.Получить(0).ШаблонПроцентныеСтавки;
		Если ЗначениеЗаполнено(ПриказСтавки) Тогда 
			ПараметрыФормы = Новый Структура("Ключ", ПриказСтавки);
			ОткрытьФорму("Документ.ЛБ_УстановитьШаблонПриказа.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры











 
 




