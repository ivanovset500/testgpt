		    ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		    ПолучитьОбъектПриказа(ИдентификаторСтроки); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийПриказЦеныВставкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	ТекСтрока = Элементы.ТекущийПриказЦеныВставки.ТекущиеДанные;
	Если ТекСтрока.ВидВставки = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") Тогда
		ПараметрыФормы = Новый Структура;    
		ПараметрыФормы.Вставить("Документ", ТекущийПриказ); 
		Если ТекущийПриказ.Проведен Тогда
			ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
		КонецЕсли;	  
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеРедактированияВставок",ЭтаФорма);
		
		ОткрытьФорму("ОбщаяФорма.ЛБ_ЗаполнениеЦенВставокИзПриказа", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеРедактированияВставок(Результат, ДопПараметры) Экспорт 
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
	ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
	ПолучитьОбъектПриказа(ИдентификаторСтроки);  
	ОбработатьИзменениеТабличныхЧастейПриказа();
КонецПроцедуры

