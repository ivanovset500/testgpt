&НаКлиенте
Процедура ПечатьПриказа(Команда)
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда   
		Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.Базовый") Тогда		
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "Приказ"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриказУсловияПредоставленияЗаймов");
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекСтрока.Ссылка);
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
		Иначе     
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "Акция"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриказУсловияПредоставленияЗаймов");
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекСтрока.Ссылка);
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
		КонецЕсли;	
    КонецЕсли;
КонецПроцедуры  

&НаСервере 
Функция ПолучитьСписокСК() 
	СК = Новый СписокЗначений;
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СхемыКредитования.Ссылка КАК СхемаКредитования
	               |ИЗ
	               |	Справочник.ЛБ_СхемыКредитования КАК ЛБ_СхемыКредитования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, ) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних
	               |		ПО (ЛБ_УсловияПредоставленияКредитаСрезПоследних.СхемаКредитования = ЛБ_СхемыКредитования.Ссылка)
	               |ГДЕ
	               |	ЛБ_СхемыКредитования.ПометкаУдаления = ЛОЖЬ";
	ТЗ = Запрос.Выполнить().Выгрузить();     
	Массив = ТЗ.ВыгрузитьКолонку("СхемаКредитования");//выгружаем таблицу значений в массив
    СК.ЗагрузитьЗначения(Массив);//загружаем массив в список значений  
	
	Возврат СК;
КонецФункции	

&НаСервере
Функция ПолучитьМассивВыбранныхСхемКредитования()  	
	СК = ТекущийПриказ.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить();
	СК.Свернуть("СхемаКредитования");
	Возврат ЛБ_УправлениеЛомбардом.ПреобразованиеТаблицыЗначенийВМассив(СК);
КонецФункции	

&НаКлиенте
Процедура РедактироватьЦеныМеталлы(Команда)
    ПараметрыФормы = Новый Структура;    
	ПараметрыФормы.Вставить("Документ", ТекущийПриказ); 
	Если ТекущийПриказ.Проведен Тогда
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	КонецЕсли;	  
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеРедактированияМеталлов",ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ЗаполнениеЦенМеталловИзПриказа", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
КонецПроцедуры  

&НаКлиенте
Процедура ПроверитьВыборСК(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
	ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
	ПолучитьОбъектПриказа(ИдентификаторСтроки);  
	ОбработатьИзменениеТабличныхЧастейПриказа();
КонецПроцедуры	

