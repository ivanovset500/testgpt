&НаКлиенте
Процедура ТаблицаСтавокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура;    
	ПараметрыФормы.Вставить("Документ", ТекущийПриказ); 
	Если ТекущийПриказ.Проведен Тогда
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	КонецЕсли;	  
	ТекСтрока = Элементы.ТаблицаСтавок.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		ПараметрыФормы.Вставить("СхемаКредитования", ТекСтрока.СхемаКредитования);
	КонецЕсли;	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеРедактированияСтавок",ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ЗаполнениеПроцентныхСтавокИзПриказа", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры 

&НаКлиенте
Процедура ПослеРедактированияСтавок(Результат, ДопПараметры) Экспорт 
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
	ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
	ПолучитьОбъектПриказа(ИдентификаторСтроки); 
	ОбработатьИзменениеТабличныхЧастейПриказа();
КонецПроцедуры   

&НаСервере 
Процедура ОбработатьИзменениеТабличныхЧастейПриказа() 
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры	

&НаСервере 
Функция ВыбратьСК()   
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");

	СК = Новый СписокЗначений;
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СхемыКредитования.Ссылка КАК СхемаКредитования
	               |ИЗ
	               |	Справочник.ЛБ_СхемыКредитования КАК ЛБ_СхемыКредитования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, ) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних
	               |		ПО (ЛБ_УсловияПредоставленияКредитаСрезПоследних.СхемаКредитования = ЛБ_СхемыКредитования.Ссылка)
	               |ГДЕ
	               |	ЛБ_СхемыКредитования.ПометкаУдаления = ЛОЖЬ";
	ТЗ = Запрос.Выполнить().Выгрузить();     
	Массив = ТЗ.ВыгрузитьКолонку("СхемаКредитования");//выгружаем таблицу значений в массив
    СК.ЗагрузитьЗначения(Массив);//загружаем массив в список значений  
	
	Для каждого Стр Из ДокументОбъект.СхемыКредитования Цикл 
		Эл = СК.НайтиПоЗначению(Стр.СхемаКредитования);
		Если НЕ Эл = неопределено Тогда
	        Эл.Пометка = Истина; 
		КонецЕсли;
	Конеццикла;
	Возврат СК;
КонецФункции

&НаКлиенте
Процедура СтрокаСКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если ТекущийПриказ.Ломбарды.Количество() = 0 Тогда 
		Предупреждение("Выберите ломбарды в приказе!", 60);
		Возврат;
	КонецЕсли;	
	ОповещениеПослеВыборка = Новый ОписаниеОповещения("ПослеВыбораСК", ЭтаФорма); 
	ОткрытьФорму("Справочник.ЛБ_СхемыКредитования.ФормаВыбора", , Этаформа,,,,ОповещениеПослеВыборка,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры 

&НаСервере
Процедура ОбработкаВыбораСК(СхемаКредитования, ЗаполнятьСК = Истина) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");  
		
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата); 
	Запрос.УстановитьПараметр("ВидШаблона", Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавки);
	МассивЛ = ДокументОбъект.Ломбарды.ВыгрузитьКолонку("Ломбард");  
	МассивЛ.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка());
	Запрос.УстановитьПараметр("Ломбарды", МассивЛ); 
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования); 	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.ШаблонПриказа КАК ШаблонПриказа,
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.Отменен КАК Отменен,
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_УстановкаОтменаШаблонаПриказа.СрезПоследних(
	               |			&Дата,
	               |			ВидШаблона = &ВидШаблона
	               |				И СхемаКредитования = &СхемаКредитования
	               |				И Ломбард В (&Ломбарды)) КАК ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних"; 
	ТЗ = Запрос.Выполнить().Выгрузить();   
	ТаблицаРегистраторов = Новый ТаблицаЗначений; 
	ТаблицаРегистраторов.Колонки.Добавить("Ломбард"); 
	ТаблицаРегистраторов.Колонки.Добавить("Регистратор");
	Отбор = Новый Структура;
	Для каждого СтрЛ Из ДокументОбъект.Ломбарды Цикл			
		Отбор.Вставить("Ломбард", СтрЛ.Ломбард); 
		Строки = ТЗ.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.Получить(0); 
			Если НЕ Стр.Отменен Тогда
				стрР = ТаблицаРегистраторов.Добавить(); 
				СтрР.Ломбард = СтрЛ.Ломбард;
				СтрР.Регистратор = Стр.ШаблонПриказа;			                                        
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		Отбор.Вставить("Ломбард", Справочники.ЛБ_Ломбарды.ПустаяСсылка());  
		Строки = ТЗ.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.Получить(0);
			стрР = ТаблицаРегистраторов.Добавить(); 
			СтрР.Ломбард = СтрЛ.Ломбард;
			СтрР.Регистратор = Стр.ШаблонПриказа; 
		Иначе
			стрР = ТаблицаРегистраторов.Добавить(); 
			СтрР.Ломбард = СтрЛ.Ломбард;
		КонецЕсли;	
	КонецЦикла;	   
	
	СписокРегистраторов = Новый СписокЗначений;
	СписокЛомбардовБезШаблона = "";
	Для каждого СтрР Из ТаблицаРегистраторов Цикл  
		Если НЕ ЗначениеЗаполнено(СтрР.Регистратор) Тогда
			СписокЛомбардовБезШаблона = СписокЛомбардовБезШаблона + ?(ПустаяСтрока(СписокЛомбардовБезШаблона), "", ", ") + СокрЛП(СтрР.Ломбард);
		Иначе 
			Если СписокРегистраторов.НайтиПоЗначению(СтрР.Регистратор) = неопределено  Тогда  
				СписокРегистраторов.Добавить(СтрР.Регистратор);
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;
	
	Если НЕ ПустаяСтрока(СписокЛомбардовБезШаблона) Тогда
		ОбщегоНазначения.СообщитьПользователю("Для ломбардов " + СписокЛомбардовБезШаблона +  " не найдено установленного шаблона по процентым ставкам для схемы кредитования " + СокрЛП(СхемаКредитования));
		Возврат; 
	КонецЕсли;
	
	Если СписокРегистраторов.Количество() = 0 Тогда  
		ОбщегоНазначения.СообщитьПользователю("Для выбранной схемы кредитования " + СокрЛП(СхемаКредитования) + " и выбранных ломбардов не найдено установленного шаблона по процентым ставкам.");
		Возврат;   
	ИначеЕсли СписокРегистраторов.Количество() > 1 Тогда  
		ОбщегоНазначения.СообщитьПользователю("Для выбранной схемы кредитования " + СокрЛП(СхемаКредитования) + " и выбранных ломбардов найдено " + Строка(СписокРегистраторов.Количество()) + " установленных шаблона по процентым ставкам.");
		ОбщегоНазначения.СообщитьПользователю("");
		Возврат;   	
	КонецЕсли;	

	ТекРегистратор = СписокРегистраторов.Получить(0).Значение;
    Запрос.УстановитьПараметр("Регистратор", ТекРегистратор);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.ПричинаПрименения КАК ПричинаПрименения,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.СтатусЗалогодателя КАК СтатусЗалогодателя,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.ДиапазонСумм КАК ДиапазонСумм,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.ДиапазонСумм.ПорядокСортировки КАК ДиапазонСуммПорядокСортировки
	               |ИЗ
	               |	РегистрСведений.ЛБ_ТекущийШаблонПриказаПроцентныеСтавки КАК ЛБ_ТекущийШаблонПриказаПроцентныеСтавки
	               |ГДЕ
	               |	ЛБ_ТекущийШаблонПриказаПроцентныеСтавки.Регистратор = &Регистратор
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СхемаКредитования,
	               |	ПричинаПрименения УБЫВ,
	               |	СтатусЗалогодателя,
	               |	ДеньНачалаПрименения,
	               |	ДиапазонСуммПорядокСортировки";
	ТаблицаШаблона = Запрос.Выполнить().Выгрузить();
	
	Если ЗаполнятьСК Тогда
		НоваяСтр = ДокументОбъект.СхемыКредитования.Добавить();
	    НоваяСтр.СхемаКредитования = СхемаКредитования; 
		НоваяСтр.ШаблонПроцентныеСтавки = ТекРегистратор; 
		
		ЗаполнитьСписокСК(ДокументОбъект);
	КонецЕсли;	
				
	Для каждого Стр Из ТаблицаШаблона Цикл
		НоваяСтрП = ДокументОбъект.СтавкиПроцентов.Добавить();
		НоваяСтрП.СхемаКредитования = Стр.СхемаКредитования;
		НоваяСтрП.ПричинаПрименения = Стр.ПричинаПрименения;
		НоваяСтрП.СтатусЗалогодателя = Стр.СтатусЗалогодателя;
		НоваяСтрП.ДиапазонСумм = Стр.ДиапазонСумм;
		НоваяСтрП.ДеньНачалаПрименения = Стр.ДеньНачалаПрименения;
		НоваяСтрП.Ставка = 0;
	КонецЦикла;	
		
    ДокументОбъект.Записать();          
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
    ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
	СхемыКредитования.Загрузить(ТекущийПриказ.СхемыКредитования.Выгрузить());
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор); 		   
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВыбораСК(Результат, ДопПараметры) Экспорт   
	Если НЕ Результат = неопределено Тогда 
		ОтборК = Новый Структура;
	    ОтборК.Вставить("СхемаКредитования", Результат);
		СтрокиК = ТекущийПриказ.СхемыКредитования.НайтиСтроки(ОтборК); 
		Если СтрокиК.Количество() = 0 Тогда
		    ОбработкаВыбораСК(Результат);   
		Иначе     
			Предупреждение("Схема кредитования " + СокрЛП(Результат) + " уже выбрана в приказе.", 60);
		КонецЕсли;	
		//ПроставитьПроцентныеСтавкиПоТекущимНастройкам(Результат, ТекущийПриказ.Ломбарды.Получить(0).Ломбард); 	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСК(ДокументОбъект)  
	Результат = "";
	Для каждого Стр Из ДокументОбъект.СхемыКредитования Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + СокрЛП(Стр.СхемаКредитования.Наименование);
	КонецЦикла;	
	ДокументОбъект.СтрокаСхемыКредитования = Результат;
КонецПроцедуры	

