        Если ТипЗнч(НастройкаСписка) = ТипЗнч(НакладныеНаОтгрузку.КомпоновщикНастроек.Настройки.Порядок) Тогда

            НастройкаСписка.Элементы.Очистить();
            // Первая сортировка - по дате документа
            УсловиеСортировкиДС = НастройкаСписка.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
            УсловиеСортировкиДС.Поле = Новый ПолеКомпоновкиДанных("ДатаНакладной");
            УсловиеСортировкиДС.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
            УсловиеСортировкиДС.Использование = Истина;
            // Вторая сортировка - по номеру документа
			//УсловиеСортировкиДС = НастройкаСписка.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			//УсловиеСортировкиДС.Поле = Новый ПолеКомпоновкиДанных("НомерНакладной");
			//УсловиеСортировкиДС.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
			//УсловиеСортировкиДС.Использование = Истина;
         КонецЕсли;
	КонецЦикла;
	
	ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда  
		ЗаполнитьТаблицуИзделий(ТекСтрока.НакладнаяНаОтгрузку);
	Иначе
		ТаблицаОбъектовЗалога.Очистить();	
	КонецЕсли;	 
	ИнформацияНакладные(); 
	Если НЕ СотрудникЦО Тогда
		Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
КонецПроцедуры

