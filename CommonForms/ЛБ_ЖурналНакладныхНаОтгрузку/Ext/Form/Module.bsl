&НаСервере
Процедура РазрешитьОплатуОтгруженныхЗБНаСервере(РезультатВыбора)
	СписокЗБ = РезультатВыбора.СписокЗБ; 
	СписокДаты = РезультатВыбора.СписокДаты; 
	СписокОснования = РезультатВыбора.СписокОснования;
	
	НовыйДок = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса(); 
	НовыйДок.Организация = Организация;  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОплатаОтгруженногоЗБ; 
	НовыйДок.Ответственный = Ответственный; 
	
	Для каждого Эл Из СписокЗБ Цикл
		НоваяСтр = НовыйДок.ЗалоговыеБилеты.Добавить(); 
		НоваяСтр.ЗалоговыйБилет = Эл.Значение;
		НоваяСтр.Ломбард = НоваяСтр.ЗалоговыйБилет.Ломбард;
		Эл = СписокЗБ.НайтиПоЗначению(НоваяСтр.ЗалоговыйБилет);
		ЭлДата = СписокДаты.НайтиПоИдентификатору(Эл.ПолучитьИдентификатор());
		Если НЕ ЭлДата = неопределено Тогда
			НоваяСтр.ДатаОплаты = ЭлДата.Значение;
		КонецЕсли; 
		ЭлОснование = СписокОснования.НайтиПоИдентификатору(Эл.ПолучитьИдентификатор());
		Если НЕ ЭлОснование = неопределено Тогда
			НоваяСтр.ОснованиеОплаты = ЭлОснование.Значение;
		КонецЕсли;
     КонецЦикла;	  
	 
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение  
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
	КонецПопытки;	 
КонецПроцедуры    

 //+МАН 19.03.26 Заявка 3750
&НаСервере
Процедура УстановитьДоступность()
	
	Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		Элементы.Организация.ТолькоПросмотр = Истина;
		Элементы.Ломбард.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Организация.ТолькоПросмотр = Ложь;
		Элементы.Ломбард.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры
