
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	ДатаКон = ТекущаяДатаСеанса();
	Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
	Ломбард = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь); 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
	   	Ответственный = ТекПользователь; 
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
			СотрудникЦО = Истина;
		КонецЕсли;	 
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;
	Ответственный = ПараметрыСеанса.ТекущийСотрудник;

	//+МАН 16.12.24 Изменена дата начала. Было с первого созданного документа. Будет - 2 месяца от текущей даты. Заявка 2904
	//ДатаНач = ПолучитьДатуНачалаВЛомбарде();
	ДатаНач = ТекущаяДата() - 5270400;
	//-МАН

	НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)));
    НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Организация", Организация); 
	НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Ломбард", Ломбард);  
		
	СписокСтатусовНакладных.Добавить(Перечисления.ЛБ_СтатусыНакладнойНаОтгрузку.Факт); 
	СписокСтатусовНакладных.Добавить(Перечисления.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаОткрыта);
	СписокСтатусовНакладных.Добавить(Перечисления.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаЗакрыта);
	СписокСтатусовНакладных.Добавить(Перечисления.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена);
	
	Если СотрудникЦО Тогда
		ДатаКоррКон = ТекущаяДатаСеанса();
		//+МАН 16.12.24 Изменена дата начала. Было с первого созданного документа. Будет - начало месяца от текущей даты. Заявка 2904
		//ДатаКоррНач = ПолучитьДатуНачалаКорректировок();
		ДатаКоррНач = НачалоМесяца(ТекущаяДата());
		//-МАН
		
		ЗаполнитьТаблицуКорректировок(); 
	КонецЕсли;	

	//+МАН 15.11.24 Ограничение по добавленному полю.
	Поле = Новый Массив;
	Поле.Добавить("ДатаОтгрузки");
	
	НакладныеНаОтгрузку.УстановитьОграниченияИспользованияВГруппировке(Поле);
	НакладныеНаОтгрузку.УстановитьОграниченияИспользованияВОтборе(Поле);
	НакладныеНаОтгрузку.УстановитьОграниченияИспользованияВПорядке(Поле);
	
	//НакладныеНаОтгрузкуУсловноеОформление = НакладныеНаОтгрузку.КомпоновщикНастроек.Настройки.УсловноеОформление;
	//НакладныеНаОтгрузкуУсловноеОформление.Элементы.Очистить();
	//-МАН

	//+МАН 19.03.26 Заявка 3750
	УстановитьДоступность();
	//-МАН
КонецПроцедуры  

&НаСервере
Функция ЗаполнитьДопИнформациюТаблицыКорректировок(Документ) 
	
	СписокЛ = Новый СписокЗначений; 
	СписокН = Новый СписокЗначений;
	СписокЗБ = Новый СписокЗначений;
	Для каждого Стр из Документ.ЗалоговыеБилеты Цикл
		Если СписокЛ.НайтиПоЗначению(Стр.Ломбард) = неопределено Тогда
			СписокЛ.Добавить(Стр.Ломбард);
		КонецЕсли;
		Если СписокН.НайтиПоЗначению(Стр.НакладнаяНаОтгрузку) = неопределено Тогда
			СписокН.Добавить(Стр.НакладнаяНаОтгрузку);
		КонецЕсли;	
        Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;
	КонецЦикла;	
		
	СтрокаЛомбард = ""; 
	СтрокаНакладные = "";
	СтрокаНомераЗБ = ""; 
	Для каждого Эл Из СписокЛ Цикл
		СтрокаЛомбард = СтрокаЛомбард + ?(ПустаяСтрока(СтрокаЛомбард), "", ", ") + СокрЛП(Эл.Значение);
	КонецЦикла; 
	Для каждого Эл Из СписокН Цикл
		СтрокаНакладные = СтрокаНакладные + ?(ПустаяСтрока(СтрокаНакладные), "", ", ") + СокрЛП(Эл.Значение.ПредставлениеНомераНакладной);
	КонецЦикла;
    Для каждого Эл Из СписокЗБ Цикл
		СтрокаНомераЗБ = СтрокаНомераЗБ + ?(ПустаяСтрока(СтрокаНомераЗБ), "", ", ") + СокрЛП(Эл.Значение.НомерЗалоговогоБилета);
	КонецЦикла;
	
	СтруктураВозврата = Новый структура;
	СтруктураВозврата.Вставить("Ломбард", ?(Документ.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтгрузкаНакладных, Документ.Ломбард, СтрокаЛомбард)); 
	СтруктураВозврата.Вставить("Накладные", СтрокаНакладные);
	СтруктураВозврата.Вставить("НомераЗБ", СтрокаНомераЗБ);
	Возврат СтруктураВозврата;
КонецФункции	
	
&НаСервере
Процедура ЗаполнитьТаблицуКорректировок()
	КорректировкиНакладных.Очистить();
	
	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("Дата1", ?(ДатаКоррНач = Дата(1,1,1), ДатаКоррНач, НачалоДня(ДатаКоррНач))); 
	Запрос.УстановитьПараметр("Дата2", ?(ДатаКоррКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКоррКон))); 	
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыКорректировкиНакладной.ВключитьЗБВНакладную) КАК ВидКорректировки,
	               |	ЛБ_НакладнаяНаОтгрузку.Ссылка КАК Ссылка,
	               |	ЛБ_НакладнаяНаОтгрузку.Дата КАК Дата,
	               |	ЛБ_НакладнаяНаОтгрузку.ПредставлениеНомераНакладной КАК НомерНакладной,
	               |	ЛБ_НакладнаяНаОтгрузку.Ломбард КАК Ломбард,
	               |	ЛБ_НакладнаяНаОтгрузку.Ответственный КАК Ответственный,
	               |	ВЫБОР
	               |		КОГДА ЛБ_НакладнаяНаОтгрузку.ПометкаУдаления
	               |			ТОГДА 2
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ЛБ_НакладнаяНаОтгрузку.Проведен
	               |					ТОГДА 1
	               |				ИНАЧЕ 0
	               |			КОНЕЦ
	               |	КОНЕЦ КАК СостояниеДокумента
	               |ИЗ
	               |	Документ.ЛБ_НакладнаяНаОтгрузку КАК ЛБ_НакладнаяНаОтгрузку
	               |ГДЕ
	               |	ЛБ_НакладнаяНаОтгрузку.Организация = &Организация
	               |	И ЛБ_НакладнаяНаОтгрузку.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И ЛБ_НакладнаяНаОтгрузку.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыНакладнойНаОтгрузку.Вручную)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛБ_КорректировкаНакладной.ВидОперации,
	               |	ЛБ_КорректировкаНакладной.Ссылка,
	               |	ЛБ_КорректировкаНакладной.Дата,
	               |	"""",
	               |	"""",
	               |	ЛБ_КорректировкаНакладной.Ответственный,
	               |	ВЫБОР
	               |		КОГДА ЛБ_КорректировкаНакладной.ПометкаУдаления
	               |			ТОГДА 2
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ЛБ_КорректировкаНакладной.Проведен
	               |					ТОГДА 1
	               |				ИНАЧЕ 0
	               |			КОНЕЦ
	               |	КОНЕЦ
	               |ИЗ
	               |	Документ.ЛБ_КорректировкаНакладной КАК ЛБ_КорректировкаНакладной
	               |ГДЕ
	               |	ЛБ_КорректировкаНакладной.Организация = &Организация
	               |	И ЛБ_КорректировкаНакладной.Дата МЕЖДУ &Дата1 И &Дата2
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";  
	Выборка  = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		НоваяСтр = КорректировкиНакладных.Добавить(); 
		НоваяСтр.ВидКорректировки = Выборка.ВидКорректировки; 
		НоваяСтр.Ссылка = Выборка.Ссылка;
		НоваяСтр.Дата = Выборка.Дата;   
		НоваяСтр.СостояниеДокумента = Выборка.СостояниеДокумента;
		НоваяСтр.Ответственный = Выборка.Ответственный;

		Если НоваяСтр.ВидКорректировки = Перечисления.ЛБ_ВидыКорректировкиНакладной.ВключитьЗБВНакладную Тогда  
			НоваяСтр.Ломбард = Выборка.Ломбард;
			НоваяСтр.НомераНакладных = Выборка.НомерНакладной;
			ТаблицаЗБ = Выборка.Ссылка.Залоги.Выгрузить(); 
			ТаблицаЗБ.Свернуть("ЗалоговыйБилет"); 
			НомераЗБ = "";
			Для каждого Стр из ТаблицаЗБ Цикл 
				НомераЗБ = НомераЗБ + ?(ПустаяСтрока(НомераЗБ), "", ", ") + СокрЛП(Стр.ЗалоговыйБилет.НомерЗалоговогоБилета);
			КонецЦикла;	
			НоваяСтр.НомераЗБ  = НомераЗБ;	  
		Иначе
			Результат = ЗаполнитьДопИнформациюТаблицыКорректировок(НоваяСтр.Ссылка);
			НоваяСтр.Ломбард = Результат.Ломбард;
			НоваяСтр.НомераНакладных = Результат.Накладные;
            НоваяСтр.НомераЗБ  = Результат.НомераЗБ; 
			Если НоваяСтр.ВидКорректировки = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОплатаОтгруженногоЗБ Тогда	
				Если НЕ НоваяСтр.Ссылка.ЗалоговыеБилеты.Количество() = 0 Тогда
					Если НачалоДня(НоваяСтр.Ссылка.ЗалоговыеБилеты.Получить(0).ДатаОплаты) < НачалоДня(ТекущаяДатаСеанса()) Тогда 
						НоваяСтр.Архив = Истина;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Функция ПолучитьДниДостунаОтгрузка(Дата) 
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Организация", Организация);  
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.КоличествоДнейДоступнаОтгрузка КАК КоличествоДней
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.СрезПоследних(&Дата, Организация = &Организация) КАК ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоДней;
	КонецЕсли;  
	Возврат 0;
КонецФункции	

&НаСервере
Функция ПолучитьДатуНачалаВЛомбарде() 
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛБ_СтатусыНакладнойНаОтгрузку.Период КАК ДатаНачала
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыНакладнойНаОтгрузку КАК ЛБ_СтатусыНакладнойНаОтгрузку
	               |ГДЕ
	               |	ЛБ_СтатусыНакладнойНаОтгрузку.НакладнаяНаОтгрузку.Организация = &Организация
	               |	И ЛБ_СтатусыНакладнойНаОтгрузку.НакладнаяНаОтгрузку.Ломбард = &Ломбард
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНачала";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаНачала;
	КонецЕсли;
	Возврат ТекущаяДатаСеанса();
КонецФункции	

&НаСервере
Функция ПолучитьДатуНачалаКорректировок() 
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛБ_КорректировкаНакладной.Дата КАК ДатаНачала
	               |ИЗ
	               |	Документ.ЛБ_КорректировкаНакладной КАК ЛБ_КорректировкаНакладной";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаНачала;
	КонецЕсли;
	Возврат ТекущаяДатаСеанса();
КонецФункции	


&НаСервере
Функция СменаСтатусаНаСервере(НакладнаяНаОтгрузку, ДатаОтгрузки = неопределено, Инкассатор = неопределено, Получатель = Неопределено, СкладПолучатель = неопределено)
	НовыйДок = Документы.ЛБ_ИзменениеСтатусаНакладной.СоздатьДокумент();
	НовыйДок.Дата = ?(ДатаОтгрузки = неопределено, ТекущаяДатаСеанса(), ДатаОтгрузки); 
	НовыйДок.НакладнаяНаОтгрузку = НакладнаяНаОтгрузку;
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыОперацийИзменениеСтатусаНакладнойНаОтгрузку.СменаСтатуса; 
	НовыйДок.Ответственный = Ответственный;  
	НовыйДок.ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;

	НовыйДок.Инкассатор = Инкассатор;  
	НовыйДок.Получатель = Получатель; 
	НовыйДок.СкладПолучатель = СкладПолучатель;
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	
	Попытка 
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение); 
		Возврат Истина;
	Исключение   
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
		Возврат Ложь; 
	КонецПопытки;	
КонецФункции

&НаКлиенте
Функция ПроверитьДниДоОгрузки(ДатаНакладной, НомерНакладной, СтатусНакладной)
	Строкасписка = СписокСтатусовНакладных.НайтиПоЗначению(СтатусНакладной); 
    Инд = Строкасписка.ПолучитьИдентификатор();                              
	СтрокаПоиска = СписокСтатусовНакладных.НайтиПоИдентификатору(Инд+1);   
	Если СтрокаПоиска = неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	НовыйСтатус = СтрокаПоиска.Значение; 
	
	КоличествоДнейДоступнаОтгрузка = ПолучитьДниДостунаОтгрузка(ДатаНакладной);

	Если КоличествоДнейДоступнаОтгрузка = 0 Тогда
		СтрокаВопроса = "Внимание! Накладная № " + СокрЛП(НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " переводится в статус «" + Строка(НовыйСтатус) + "». Продолжаем?";
        Режим = РежимДиалогаВопрос.ДаНет;
        Ответ = Вопрос(СтрокаВопроса, Режим, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда
		    Возврат Истина;
		ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
			 Возврат Ложь;
		КонецЕсли;		
	Иначе   
		ДатаОтгрузкиВозможна = КонецДня(ДатаНакладной) + 1 + КоличествоДнейДоступнаОтгрузка*86400; 
		ДатаСеанса = НачалоДня(ПолучитьДатуСеанса()); 
		Если  ДатаСеанса < ДатаОтгрузкиВозможна Тогда 
			СтрокаПредупреждения = "Внимание! Накладная на внутреннее перемещение сформирована " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " и не подлежит инкассации по сроку." +
				                       "Срок возможной инкассации " + Формат(ДатаОтгрузкиВозможна, "ДФ=dd.MM.yyyy")+ "."; 
			Если СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаЗакрыта") Тогда  
                Предупреждение(СтрокаПредупреждения, 60);
				Возврат Ложь;
			Иначе                  
                Режим = РежимДиалогаВопрос.ДаНет;
                Ответ = Вопрос(СтрокаПредупреждения + " Переводим накладную № " + СокрЛП(НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " в статус «" + Строка(НовыйСтатус) + "»?", Режим, 0);
				Если Ответ = КодВозвратаДиалога.Да Тогда
				    Возврат Истина;
				ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
					 Возврат Ложь;
				КонецЕсли;			
			КонецЕсли;	
		Иначе  
			СтрокаВопроса = "Внимание! Накладная № " + СокрЛП(НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " переводится в статус «" + Строка(НовыйСтатус) + "». Продолжаем?";
            Режим = РежимДиалогаВопрос.ДаНет;
            Ответ = Вопрос(СтрокаВопроса, Режим, 0);
			Если Ответ = КодВозвратаДиалога.Да Тогда
			    Возврат Истина;
			ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
				 Возврат Ложь;
			КонецЕсли;			
		КонецЕсли;	
	КонецЕсли;	
КонецФункции 

&НаСервере
Функция ПроверятьДниДоОтгрузки(НакладнаяНаОтгрузку)
	Возврат ?(НакладнаяНаОтгрузку.ВидОперации = Перечисления.ЛБ_ВидыНакладнойНаОтгрузку.Автоматически, Истина, Ложь);
КонецФункции

&НаСервере
Функция ПолучитьДатуНакладной(Накладная)  
	Возврат Накладная.Дата;
КонецФункции	

&НаКлиенте
Процедура СменаСтатуса(Команда)
	ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	   
	ДатаНакладной = ПолучитьДатуНакладной(Текстрока.НакладнаяНаОтгрузку);
	Если ТекСтрока.Пустой Тогда
		Предупреждение("Внимание! Накладная № " + сокрЛП(Текстрока.НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + 
		        " не содержит доступных к отгрузке предметов залога. Смена статусов запрещена.", 60);
		Возврат;
	КонецЕсли;	         
	Если ТекСтрока.СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена") Тогда
		Предупреждение("Накладная № " + сокрЛП(Текстрока.НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + "находится в статусе «Отгружена». Больше нет статусов доступных для изменения.", 60);
	Иначе       
		Если ПроверятьДниДоОтгрузки(ТекСтрока.НакладнаяНаОтгрузку) И НЕ ПроверитьДниДоОгрузки(ДатаНакладной, ТекСтрока.НомерНакладной, ТекСтрока.СтатусНакладной) Тогда
			Возврат;
		КонецЕсли;
		Если ТекСтрока.СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаЗакрыта") Тогда  
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("НакладнаяНаОтгрузку", ТекСтрока.НакладнаяНаОтгрузку);
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОтгрузка",ЭтаФорма); 
			ОткрытьФорму("ОбщаяФорма.ЛБ_ОтгрузкаПоНакладной", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе	    
			Если СменаСтатусаНаСервере(ТекСтрока.НакладнаяНаОтгрузку) Тогда  
				Элементы.НакладныеНаОтгрузку.Обновить(); 
				ЗаполнитьТаблицуИзделий(ТекСтрока.НакладнаяНаОтгрузку);
				ИнформацияНакладные();  
			Иначе
				Сообщить("Ошибка проведения документа изменения статуса накладной. Обратитесь к разработчикам.", статусСообщения.Важное);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры   

&НаКлиенте
Процедура ПослеВыбораОтгрузка(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  	

	Если СменаСтатусаНаСервере(Результат.НакладнаяНаОтгрузку, Результат.ДатаОтгрузки, Результат.Инкассатор, Результат.Получатель, Результат.СкладПолучатель) Тогда 
		Элементы.НакладныеНаОтгрузку.Обновить(); 
		ЗаполнитьТаблицуИзделий(Результат.НакладнаяНаОтгрузку);
		ИнформацияНакладные();  
	Иначе
		Сообщить("Ошибка проведения документа изменения статуса накладной. Обратитесь к разработчикам.", статусСообщения.Важное);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОтменаСтатусаНаСервере(НакладнаяНаОтгрузку)
	НовыйДок = Документы.ЛБ_ИзменениеСтатусаНакладной.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса(); 
	НовыйДок.НакладнаяНаОтгрузку = НакладнаяНаОтгрузку;
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыОперацийИзменениеСтатусаНакладнойНаОтгрузку.ОтменаСтатуса;  
	НовыйДок.Ответственный = Ответственный; 
	НовыйДок.ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;

	НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	
	Попытка 
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение); 
		Возврат Истина;
	Исключение   
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
		Возврат Ложь;
	КонецПопытки;	
КонецФункции

&НаКлиенте
Процедура ОтменаСтатуса(Команда)
	ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	     
	ДатаНакладной = ПолучитьДатуНакладной(Текстрока.НакладнаяНаОтгрузку);
	Если ТекСтрока.Пустой Тогда 
		Предупреждение("Внимание! Накладная № " + сокрЛП(Текстрока.НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + 
		        " не содержит доступных к отгрузке предметов залога. Смена статусов запрещена.", 60);
		Возврат;
	КонецЕсли;	             
	Если ТекСтрока.СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.Факт") Тогда
		Предупреждение("Накладная № " + сокрЛП(Текстрока.НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " находится в статусе «Факт». Больше нет статусов доступных для отмены.", 60); 
	ИначеЕсли ТекСтрока.СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена") Тогда		
		Предупреждение("Для отмены отгрузки накладной  № " + СокрЛП(ТекСтрока.НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " необходимо обратиться в ЦО.", 60); 
	Иначе      
		Строкасписка = СписокСтатусовНакладных.НайтиПоЗначению(ТекСтрока.СтатусНакладной); 
	    Инд = Строкасписка.ПолучитьИдентификатор();                              
		СтрокаПоиска = СписокСтатусовНакладных.НайтиПоИдентификатору(Инд-1);   
		Если СтрокаПоиска = неопределено Тогда
			Возврат;
		КонецЕсли;	
		НовыйСтатус = СтрокаПоиска.Значение; 

		СтрокаВопроса = "Внимание! Накладная № " + СокрЛП(ТекСтрока.НомерНакладной) + " от " + Формат(ДатаНакладной, "ДФ=dd.MM.yyyy") + " переводится в статус «" + Строка(НовыйСтатус) + "». Продолжаем?";
        Режим = РежимДиалогаВопрос.ДаНет;
        Ответ = Вопрос(СтрокаВопроса, Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			 Возврат;
		КонецЕсли;			

		Если ОтменаСтатусаНаСервере(ТекСтрока.НакладнаяНаОтгрузку) Тогда 
			Элементы.НакладныеНаОтгрузку.Обновить(); 
			ЗаполнитьТаблицуИзделий(ТекСтрока.НакладнаяНаОтгрузку);
			ИнформацияНакладные();  
		Иначе
			Сообщить("Ошибка проведения документа изменения статуса накладной. Обратитесь к разработчикам.", статусСообщения.Важное);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИсторияСменыСтатусов(Команда) 
	ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;  
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
    ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НакладнаяНаОтгрузку", ТекСтрока.НакладнаяНаОтгрузку); 	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ИсторияНакладной", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ИнформацияНакладные()
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач))); 
	Запрос.УстановитьПараметр("Дата2", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)));  
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);            
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус,
	               |	СУММА(1) КАК Количество,
	               |	СУММА(ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес) КАК Вес,
	               |	СУММА(ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс) КАК Сумма
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&Дата2, ) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата2, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |ГДЕ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку.Организация = &Организация
	               |	И ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку.Ломбард = &Ломбард
	               |	И НЕ ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Если ТаблицаЗапроса.Количество() = 0 Тогда 
		Элементы.ДекорацияИзделияВНакладных.Заголовок = "";
	Иначе	                                               
		ИнформацияН = "Всего включено в накладные изделий " + Строка(ТаблицаЗапроса.Итог("Количество")) + " весом " + Сокрлп(Формат(ТаблицаЗапроса.Итог("Вес"), "ЧЦ=10; ЧДЦ=3")) + 
		              " г. на сумму оценки " + Сокрлп(Формат(ТаблицаЗапроса.Итог("Сумма"), "ЧЦ=15; ЧДЦ=2")) + " руб. "; 
		
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.Отгружено);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если строки.Количество() = 0 Тогда  
			ИнформацияН = ИнформацияН + "Отгружено изделий 0.";
		Иначе    
			Стр = Строки.Получить(0);
			ИнформацияН = ИнформацияН + "Отгружено изделий " + Строка(Стр.Количество) + " весом " + Сокрлп(Формат(Стр.Вес, "ЧЦ=10; ЧДЦ=3")) + 
		              " г. на сумму оценки " + Сокрлп(Формат(Стр.Сумма, "ЧЦ=15; ЧДЦ=2")) + " руб. ";
		КонецЕсли;	 
		Элементы.ДекорацияИзделияВНакладных.Заголовок = ИнформацияН; 
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИзделий(Накладная)
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)));  
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку.ПредставлениеНомераНакладной КАК НомерНакладной,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	1 КАК Количество,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОписаниеИзделия КАК ОписаниеИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни КАК СуммаОценкиВставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды КАК СуммаСсуды,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога";  
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаОбъектовЗалога.Загрузить(ТаблицаЗапроса);
	ТаблицаЗБ = ТаблицаОбъектовЗалога.Выгрузить();
	ТаблицаЗБ.Свернуть("ЗалоговыйБилет");       
	МассивЗБ = ТаблицаЗБ.ВыгрузитьКолонку("ЗалоговыйБилет");
	
	Запрос.УстановитьПараметр("ЗБ", МассивЗБ);  
	Запрос.УстановитьПараметр("ДатаОплатыПустая", Дата(1,1,1)); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаОплатыБезПродления КАК ДатаОплаты,
	               |	ЛБ_СостояниеЗалоговогоБилета.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор ССЫЛКА Документ.ЛБ_ОперацияПоЗалогу
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)
	               |	И ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет В(&ЗБ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	ТаблицаОплатБезПродления  = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЗБ Из МассивЗБ Цикл  
		Отбор = Новый структура;
		Отбор.Вставить("ЗалоговыйБилет", ЗБ);
        СтрокиО = ТаблицаОплатБезПродления.НайтиСтроки(Отбор);
		Если СтрокиО.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрО = СтрокиО.Получить(0);
		Если СтрО.ДатаОплаты = Дата(1,1,1) Тогда
			Продолжить;
		КонецЕсли;	
		Строки = ТаблицаОбъектовЗалога.НайтиСтроки(Отбор);  
		Для каждого Стр Из строки Цикл 
			Стр.ДатаОплаты = СтрО.ДатаОплаты;
		КонецЦикла;	
	КонецЦикла;	
		
	//Для каждого Стр Из ТаблицаЗапроса Цикл
	//	Если стр.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной Тогда
	//		стр.Количество = 0;
	//		стр.ВесИзделия = 0; 
	//		стр.ВесМеталла = 0;
	//		стр.СуммаОценки = 0;
	//		стр.СуммаОценкиМакс = 0;
	//		стр.СуммаОценкиМеталлы = 0;
	//		стр.СуммаОценкиВставки = 0;
	//		стр.СуммаСсуды = 0;
	//	КонецЕсли;	
	//КонецЦикла;	
	
	ИтогКоличество = ТаблицаЗапроса.Итог("Количество");
	ИтогВесИзделия = ТаблицаЗапроса.Итог("ВесИзделия"); 
	ИтогВесМеталла = ТаблицаЗапроса.Итог("ВесМеталла");
	ИтогСуммаОценки = ТаблицаЗапроса.Итог("СуммаОценки");
	ИтогСуммаОценкиМакс = ТаблицаЗапроса.Итог("СуммаОценкиМакс");
	ИтогСуммаОценкиМеталлы = ТаблицаЗапроса.Итог("СуммаОценкиМеталлы");
	ИтогСуммаОценкиВставки = ТаблицаЗапроса.Итог("СуммаОценкиВставки");
	ИтогСуммаСсуды = ТаблицаЗапроса.Итог("СуммаСсуды");
		
КонецПроцедуры	
	
