&НаСервере
Процедура ВключитьЗБВНакладнуюНаСервере(РезультатВыбора)
	СписокЗБ = РезультатВыбора.СписокЗБ;
	ВыбранныйЛомбард = РезультатВыбора.Ломбард;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса()); 
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.ЕстьОграничениеОценки КАК ЕстьОграничениеОценки,
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.СуммаОценки КАК СуммаОценки
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.СрезПоследних(&Дата, Организация = &Организация) КАК ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();  
	Если Выборка.Следующий() тогда
		ЕстьОграничениеОценки = Выборка.ЕстьОграничениеОценки;
		СуммаОценкиДляОтбора = Выборка.СуммаОценки;  
	КонецЕсли;	 
	
	СтатусыОЗ = новый СписокЗначений; 
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Возвращен); 
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Принят);
    СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Продлен);
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Наследство);
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение);
	
	ЗапросЗБ = Новый Запрос;  
	ЗапросЗБ.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	ЗапросЗБ.УстановитьПараметр("СписокЗБ", СписокЗБ); 
	ЗапросЗБ.УстановитьПараметр("СтатусыОбъектаЗалога", СтатусыОЗ);
	ЗапросЗБ.УстановитьПараметр("Ломбард", ВыбранныйЛомбард);
	ЗапросЗБ.Текст = "ВЫБРАТЬ
	                 |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	                 |	ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток КАК Количество,
	                 |	ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток КАК СуммаОценки,
	                 |	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет.ОтказОтВыкупа КАК ОтказОтВыкупа,
	                 |	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                 |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
	                 |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК Вес
	                 |ИЗ
	                 |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
	                 |			&Дата,
	                 |			ЗалоговыйБилет В (&СписокЗБ)
	                 |				И Ломбард = &Ломбард) КАК ЛБ_ОбъектыЗалогаОстатки
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
	                 |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	                 |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	                 |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	                 |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	                 |ГДЕ
	                 |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога В(&СтатусыОбъектаЗалога)";         
	ТаблицаЗапроса = ЗапросЗБ.Выполнить().Выгрузить();
	ТаблицаФормированияНакладных = ТаблицаЗапроса.СкопироватьКолонки("ЗалоговыйБилет, ОтказОтВыкупа, ОбъектЗалога, Количество, Вес, СуммаОценки");
	ТаблицаФормированияНакладных.Колонки.Добавить("ПовышеннаяОценка");
	
	Для каждого Стр из ТаблицаЗапроса Цикл 		
		НоваяСтр = ТаблицаФормированияНакладных.Добавить();  
		НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
		НоваяСтр.ОтказОтВыкупа = Стр.ОтказОтВыкупа;
		НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
		НоваяСтр.Количество = Стр.Количество;  
		НоваяСтр.Вес = Стр.Вес;
		НоваяСтр.СуммаОценки = Стр.СуммаОценки;
		НоваяСтр.ПовышеннаяОценка = Ложь;
		Если Стр.СуммаОценки > СуммаОценкиДляОтбора тогда  
			НоваяСтр.ПовышеннаяОценка = Истина;
		КонецЕсли;	
	КонецЦикла;

	Отбор = Новый Структура; 
  	
	Отбор.Вставить("ОтказОтВыкупа", Истина);
	Отбор.Вставить("ПовышеннаяОценка", Ложь);
	
	Строки = ТаблицаФормированияНакладных.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0  Тогда
		СформироватьНакладную(ВыбранныйЛомбард, Строки, Истина, Ложь);
	КонецЕсли;  
		
	Отбор.Вставить("ПовышеннаяОценка", Истина);
	Строки = ТаблицаФормированияНакладных.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0  Тогда
		СформироватьНакладную(ВыбранныйЛомбард, Строки, Истина, Истина);
	КонецЕсли;
		
	Отбор.Вставить("ОтказОтВыкупа", Ложь); 
	Отбор.Вставить("ПовышеннаяОценка", Ложь);
	
	Строки = ТаблицаФормированияНакладных.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0  Тогда
		СформироватьНакладную(ВыбранныйЛомбард, Строки, Ложь, Ложь); 
	КонецЕсли;
	
	Отбор.Вставить("ПовышеннаяОценка", Истина);
	
	Строки = ТаблицаФормированияНакладных.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0  Тогда  
		СформироватьНакладную(ВыбранныйЛомбард, Строки, Ложь, Истина);  
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Процедура СформироватьНакладную(ВыбранныйЛомбард, СтрокиТаблицы, ОтказОтВыкупа, ПовышеннаяОценка)  		
	НовыйДок = Документы.ЛБ_НакладнаяНаОтгрузку.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса(); 
	НовыйДок.Организация = Организация;
	НовыйДок.Ломбард = ВыбранныйЛомбард;  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыНакладнойНаОтгрузку.Вручную;  
	НовыйДок.ОтказОтВыкупа = ОтказОтВыкупа;
	НовыйДок.ПовышеннаяОценка = ПовышеннаяОценка;
	НовыйДок.Ответственный = Ответственный;
	//НовыйДок.ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;
	НовыйДок.Комментарий = "Создание накладной сотрудником ЦО";

	Для каждого Стр Из СтрокиТаблицы Цикл 
		НоваяСтр = НовыйДок.Залоги.Добавить();
		НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
		НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
		НоваяСтр.Количество = Стр.Количество;
		НоваяСтр.Вес = Стр.Вес;
		НоваяСтр.СуммаОценки = Стр.СуммаОценки;
	КонецЦикла;		
	
	НовыйДок.НомерНакладной = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерНакладнойНаОтгрузку(НовыйДок.Дата, НовыйДок.Организация, НовыйДок.Ломбард);   
	НовыйДок.ПредставлениеНомераНакладной = СокрЛП(НовыйДок.Ломбард.НомерЛомбарда) + "/" +  СокрЛП(НовыйДок.НомерНакладной);
	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение     
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
	КонецПопытки;	
КонецПроцедуры	

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница) 
	Если ТекущаяСтраница = Элементы.Страница1 Тогда 
		Элементы.НакладныеНаОтгрузку.Обновить();    
		ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;
		Если НЕ ТекСтрока = неопределено Тогда  
			ЗаполнитьТаблицуИзделий(ТекСтрока.НакладнаяНаОтгрузку);
		Иначе
			ТаблицаОбъектовЗалога.Очистить();	
		КонецЕсли;	 
		ИнформацияНакладные();    
	КонецЕсли;	
КонецПроцедуры

