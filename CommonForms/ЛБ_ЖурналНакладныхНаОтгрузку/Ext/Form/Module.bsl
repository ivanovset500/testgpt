Процедура ОтгрузкаНакладныхНаСервере(Результат) 
	СписокНакладных = Результат.СписокНакладных; 
	Ломбард = Результат.Ломбард;
	Инкассатор = Результат.Инкассатор;
	Получатель = Результат.Получатель; 
