&НаСервере
Процедура ИсключитьЗБИзНакладнойНаСервере(Результат) 
	СписокЗБ = Результат.СписокЗБВключить; 
	СписокЗББлокировать = Результат.СписокБлокировать;   
	СписокДатыБлокировки = Результат.СписокДатыБлокировки;    
	
	НовыйДок = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса(); 
	НовыйДок.Организация = Организация;  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ИсключениеЗБИзНакладной; 
	НовыйДок.Ответственный = Ответственный; 
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("СписокЗБ", СписокЗБ);  
	Запрос.Текст = 
	//++ООВ 30.04.2026 Заявка 3757 добавлено условие выбора залога (в статусе недостача не должен попадать в корректировку накладной)
	// старый запрос закомментирован ниже
	 				"ВЫБРАТЬ
	 				|	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	 				|	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	 				|	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет
	 				|ИЗ
	 				|	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(, ЗалоговыйБилет В (&СписокЗБ)) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	 				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(, ЗалоговыйБилет В (&СписокЗБ)) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
	 				|		ПО ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога
	 				|ГДЕ
	 				|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога <> ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалога.Недостача)
	 				|
	 				|УПОРЯДОЧИТЬ ПО
	 				|	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Период УБЫВ";
	//--ООВ 30.04.2026 Заявка 3757
	
	//"ВЫБРАТЬ
	//               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Период КАК Период,
	//               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	//               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	//               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет
	//               |ИЗ
	//               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(, ЗалоговыйБилет В (&СписокЗБ)) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	Период УБЫВ";
	ТаблицаН = Запрос.Выполнить().Выгрузить();

	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	1 КАК Количество,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК Вес,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценки
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(
	               |			,
	               |			ЗалоговыйБилет В (&СписокЗБ)
	               |				И Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.Факт)) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога";  
	Выборка = Запрос.Выполнить().выбрать();
	Пока Выборка.Следующий() Цикл  
		ОтборН = Новый Структура;
		ОтборН.Вставить("ЗалоговыйБилет", Выборка.ЗалоговыйБилет);
		ОтборН.Вставить("ОбъектЗалога", Выборка.ОбъектЗалога);
		СтрокиН = ТаблицаН.НайтиСтроки(ОтборН);
		Если НЕ СтрокиН.Количество() = 0 Тогда
			СтрН = строкиН.Получить(0);
			Если НЕ Выборка.НакладнаяНаОтгрузку = СтрН.НакладнаяНаОтгрузку Тогда 
			    Продолжить;
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;	

		НоваяСтр = НовыйДок.ЗалоговыеБилеты.Добавить(); 
		НоваяСтр.НакладнаяНаОтгрузку = Выборка.НакладнаяНаОтгрузку;
		НоваяСтр.ЗалоговыйБилет = Выборка.ЗалоговыйБилет;
		НоваяСтр.Ломбард = Выборка.ЗалоговыйБилет.Ломбард;
		НоваяСтр.ОбъектЗалога = Выборка.ОбъектЗалога;
		НоваяСтр.Количество = Выборка.Количество;
		НоваяСтр.Вес = Выборка.Вес; 
		НоваяСтр.СуммаОценки = Выборка.СуммаОценки;     
		
		ЭлБлокировать = СписокЗББлокировать.НайтиПоЗначению(НоваяСтр.ЗалоговыйБилет);
		Если НЕ ЭлБлокировать = неопределено Тогда
			НоваяСтр.Заблокировать = Истина;   
			ЭлДатаБлокировать = СписокДатыБлокировки.НайтиПоИдентификатору(ЭлБлокировать.ПолучитьИдентификатор());
			Если НЕ ЭлДатаБлокировать = неопределено Тогда
				НоваяСтр.ДатаБлокировки = ЭлДатаБлокировать.Значение;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	    
	 
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение   
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
	КонецПопытки;	 
КонецПроцедуры	

&НаСервере
Процедура УдалитьКорректировкуНаСервере(Идентификатор)
	Стр = КорректировкиНакладных.НайтиПоИдентификатору(Идентификатор);
	Если НЕ Стр = неопределено Тогда
		ДокОбъект = Стр.Ссылка.ПолучитьОбъект();
		Если НЕ ДокОбъект.ПометкаУдаления Тогда
		    ДокОбъект.УстановитьПометкуУдаления(Истина);  
			
			Если ДокОбъект.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтменаОтгрузкиНакладных Тогда  
				//зафиксируем удаление отмены отгрузки в документе изменение статуса (отгрузка)
				ЗапросН = Новый Запрос;   
				ЗапросН.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
				ЗапросН.Текст ="ВЫБРАТЬ
				               |	ЛБ_ОтгруженныеНакладныеСрезПоследних.Регистратор КАК Регистратор
				               |ИЗ
				               |	РегистрСведений.ЛБ_ОтгруженныеНакладные.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_ОтгруженныеНакладныеСрезПоследних"; 
				ТаблицаН = ДокОбъект.ЗалоговыеБилеты.Выгрузить(); 
				ТаблицаН.Свернуть("НакладнаяНаОтгрузку");
				Для каждого СтрН Из ТаблицаН Цикл    
					 ЗапросН.УстановитьПараметр("Накладная", СтрН.НакладнаяНаОтгрузку); 
					 ВыборкаН  = ЗапросН.Выполнить().Выбрать();
					 Если ВыборкаН.Следующий() Тогда  
						 ДокОтгрузка = ВыборкаН.Регистратор.ПолучитьОбъект(); 
						 ДокОтгрузка.ОтгрузкаОтменена = Ложь;
						 ДокОтгрузка.Записать(РежимЗаписиДокумента.Проведение);
					 КонецЕсли;	 
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКорректировку(Команда)
	ТекСтрока = Элементы.КорректировкиНакладных.ТекущиеДанные;  
	Если НЕ ТекСтрока = неопределено Тогда  
		Если ТекСтрока.СостояниеДокумента = 2 Тогда
			Предупреждение("Документ уже помечен на удаление.", 60);
		Иначе
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("Пометить документ на удаление?", Режим, 0);
			Если Ответ = КодВозвратаДиалога.Нет Тогда
			    Возврат;
			КонецЕсли;		
	        УдалитьКорректировкуНаСервере(ТекСтрока.ПолучитьИдентификатор());
			ТекСтрока.СостояниеДокумента = 2; 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ТипКорректировки(Идентификатор)
	Стр = КорректировкиНакладных.НайтиПоИдентификатору(Идентификатор);
    Если НЕ Стр = неопределено Тогда
		Если ТипЗнч(Стр.Ссылка) = Тип("ДокументСсылка.ЛБ_НакладнаяНаОтгрузку") Тогда
			Возврат 1; 
		ИначеЕсли ТипЗнч(Стр.Ссылка) = Тип("ДокументСсылка.ЛБ_КорректировкаНакладной") Тогда
			Возврат 2;
	    КонецЕсли;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаСервере
Функция ПолучитьИмяФормыКорректировки(Ссылка)  
	Возврат ЛБ_ОбщийМодуль.ПолучитьИмяФормыКорректировкиНакладных(Ссылка);
КонецФункции	
	
&НаКлиенте
Процедура КорректировкиНакладныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекСтрока = Элементы.КорректировкиНакладных.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда 
		ПараметрыФормы = Новый Структура;
	    ПараметрыФормы.Вставить("Ключ", ТекСтрока.Ссылка); 
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);  
		
		Если ТипКорректировки(ТекСтрока.ПолучитьИдентификатор()) = 1 Тогда  
			ОткрытьФорму("Документ.ЛБ_НакладнаяНаОтгрузку.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ТипКорректировки(ТекСтрока.ПолучитьИдентификатор()) = 2 Тогда     
			ИмяФормыК = ПолучитьИмяФормыКорректировки(ТекСтрока.Ссылка); 
			Если ИмяФормыК = неопределено Тогда
	            ОткрытьФорму("Документ.ЛБ_КорректировкаНакладной.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
			Иначе
				ПараметрыФормыДоп = Новый Структура; 
				ПараметрыФормыДоп.Вставить("Документ", ТекСтрока.Ссылка);  
				ОткрытьФорму("ОбщаяФорма." + ИмяФормыК, ПараметрыФормыДоп, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗБ(Идентификатор) 
	Стр = ТаблицаОбъектовЗалога.НайтиПоИдентификатору(Идентификатор); 
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ЗБ", Стр.ЗалоговыйБилет);
	СтруктураВ.Вставить("Залогодатель", Стр.ЗалоговыйБилет.Залогодатель);
	Возврат СтруктураВ;
КонецФункции	

&НаКлиенте
Процедура ИсторияЗалоговогоБилета(Команда)
	ТекСтрока = Элементы.ТаблицаОбъектовЗалога.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда
		Результат = ПолучитьЗБ(ТекСтрока.ПолучитьИдентификатор());
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Результат.Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗБ);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаблокироватьЗБ(Команда)
	ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Организация", Организация); 
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗаблокироватьЗБ",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаБлокировкиЗалоговыхБилетов", ПараметрыФормы ,,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры   

&НаКлиенте
Процедура ПослеВыбораЗаблокироватьЗБ(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;                      
	
	ЗаблокироватьЗБНаСервере(Результат);
	ЗаполнитьТаблицуКорректировок(); 
	//СтрокаТЗ = КорректировкиНакладных.Получить(КорректировкиНакладных.Количество()-1);
	//ИдентификаторСтроки = СтрокаТЗ.ПолучитьИдентификатор();
	//Элементы.КорректировкиНакладных.ТекущаяСтрока = ИдентификаторСтроки;
КонецПроцедуры    

&НаСервере
Процедура ЗаблокироватьЗБНаСервере(Результат) 
	СписокЗББлокировать = Результат.СписокБлокировать;   
	СписокДатыБлокировки = Результат.СписокДатыБлокировки;  
	СписокОснованияБлокировки = Результат.СписокОснованияБлокировки;
	
	Если НЕ СписокЗББлокировать.Количество() = 0 Тогда
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("СписокЗБ", СписокЗББлокировать);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
		               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
		               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
		               |	1 КАК Количество,
		               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК Вес,
		               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценки
		               |ИЗ
		               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
		               |		ПО (ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет)
		               |			И (ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога)";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		
		НовыйДок = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДатаСеанса(); 
		НовыйДок.Организация = Организация;  
		НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.БлокировкаВключенияЗБВНакладные; 
		НовыйДок.Ответственный = Ответственный; 

		Для каждого Эл Из СписокЗББлокировать Цикл
			ЗБ = Эл.Значение;
			Отбор = Новый Структура;
			Отбор.Вставить("ЗалоговыйБилет", ЗБ);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			
			Для каждого Выборка Из Строки цикл
				НоваяСтр = НовыйДок.ЗалоговыеБилеты.Добавить(); 
				НоваяСтр.ЗалоговыйБилет = ЗБ;
				НоваяСтр.Ломбард = ЗБ.Ломбард;
				НоваяСтр.ОбъектЗалога = Выборка.ОбъектЗалога;
				НоваяСтр.Количество = Выборка.Количество;
				НоваяСтр.Вес = Выборка.Вес; 
				НоваяСтр.СуммаОценки = Выборка.СуммаОценки;     
				НоваяСтр.Заблокировать = Истина; 
				ЭлБлокировать = СписокЗББлокировать.НайтиПоЗначению(НоваяСтр.ЗалоговыйБилет);
				ЭлДатаБлокировать = СписокДатыБлокировки.НайтиПоИдентификатору(ЭлБлокировать.ПолучитьИдентификатор());
				Если НЕ ЭлДатаБлокировать = неопределено Тогда
					НоваяСтр.ДатаБлокировки = ЭлДатаБлокировать.Значение;
				КонецЕсли;
				ЭлОснованиеБлокировать = СписокОснованияБлокировки.НайтиПоИдентификатору(ЭлБлокировать.ПолучитьИдентификатор());
				Если НЕ ЭлОснованиеБлокировать = неопределено Тогда   
					Основание = ЭлОснованиеБлокировать.Значение;
					НоваяСтр.ОснованиеБлокировки = ?(Основание = "без основания", "", Основание);
				КонецЕсли;	
			КонецЦикла;
		КонецЦикла;	  
	КонецЕсли;	
	
	СписокЗБОтменитьБлокировку = Результат.СписокОтменить;   
	СписокОснованияОтменить = Результат.СписокОснованияОтменить;

	Если НЕ СписокЗБОтменитьБлокировку.Количество() = 0 Тогда
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("СписокЗБ", СписокЗБОтменитьБлокировку);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
		               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
		               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
		               |	1 КАК Количество,
		               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК Вес,
		               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценки
		               |ИЗ
		               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
		               |		ПО (ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет)
		               |			И (ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога)";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		
		НовыйДок = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДатаСеанса(); 
		НовыйДок.Организация = Организация;  
		НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.БлокировкаВключенияЗБВНакладные; 
		НовыйДок.Ответственный = Ответственный; 

		Для каждого Эл Из СписокЗБОтменитьБлокировку Цикл
			ЗБ = Эл.Значение;
			Отбор = Новый Структура;
			Отбор.Вставить("ЗалоговыйБилет", ЗБ);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			
			Для каждого Выборка Из Строки цикл
				НоваяСтр = НовыйДок.ЗалоговыеБилеты.Добавить(); 
				НоваяСтр.ЗалоговыйБилет = ЗБ;
				НоваяСтр.Ломбард = ЗБ.Ломбард;
				НоваяСтр.ОбъектЗалога = Выборка.ОбъектЗалога;
				НоваяСтр.Количество = Выборка.Количество;
				НоваяСтр.Вес = Выборка.Вес; 
				НоваяСтр.СуммаОценки = Выборка.СуммаОценки;     
				НоваяСтр.ОтменитьБлокировку = Истина;    
				ЭлОтменить = СписокЗБОтменитьБлокировку.НайтиПоЗначению(НоваяСтр.ЗалоговыйБилет);
				ЭлОснованиеОтменить = СписокОснованияОтменить.НайтиПоИдентификатору(ЭлОтменить.ПолучитьИдентификатор());
				Если НЕ ЭлОснованиеОтменить = неопределено Тогда   
					Основание = ЭлОснованиеОтменить.Значение;
					НоваяСтр.ОснованиеБлокировки = ?(Основание = "без основания", "", Основание);
				КонецЕсли;	
			КонецЦикла;
		КонецЦикла;	  
	КонецЕсли;	

	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение  
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
	КонецПопытки;	 
КонецПроцедуры	

