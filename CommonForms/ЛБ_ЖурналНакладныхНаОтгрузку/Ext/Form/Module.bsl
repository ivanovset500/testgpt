&НаКлиенте
Процедура ВыборПериодаЗавершение(Период, ДополнительныеПараметры) Экспорт 
	Если Период = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ДатаНач = Период.ДатаНачала;
    ДатаКон = Период.ДатаОкончания;
	Если НЕ ДатаКон = Дата(1,1,1) И НЕ ДатаНач = Дата(1,1,1) Тогда
		Если  ДатаКон < ДатаНач Тогда
			Предупреждение("Конечная дата выбранного периода не может быть больше начальной даты периода.", 60);
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ПолучитьДатуСеанса(), КонецДня(ДатаКон)));
	Элементы.НакладныеНаОтгрузку.Обновить(); 
	ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда  
		ЗаполнитьТаблицуИзделий(ТекСтрока.НакладнаяНаОтгрузку);
	Иначе
		ТаблицаОбъектовЗалога.Очистить();	
	КонецЕсли;	 
	ИнформацияНакладные();
КонецПроцедуры

