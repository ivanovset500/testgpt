&НаСервере
Функция НайтиНакладнуюНаОтгрузку(ЗалоговыйБилет)
	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладной.Период КАК Период,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладной.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной КАК ЛБ_СтатусыОбъектовЗалогаВНакладной
	               |ГДЕ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладной.ЗалоговыйБилет = &ЗалоговыйБилет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 	
		СтруктураВ = Новый Структура;  
		СтруктураВ.Вставить("НакладнаяНаОтгрузку", Выборка.НакладнаяНаОтгрузку); 
		СтруктураВ.Вставить("ДатаНакладной", Выборка.НакладнаяНаОтгрузку.Дата);
		Возврат СтруктураВ; 		
	КонецЕсли;	
    Возврат неопределено;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораЗБ(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	ЗалоговыйБилет = Результат.ЗалоговыйБилет; 
	Результат = НайтиНакладнуюНаОтгрузку(ЗалоговыйБилет);
	Если НЕ Результат = неопределено Тогда 
		Накладная = Результат.НакладнаяНаОтгрузку; 
		ДатаНакладной = Результат.ДатаНакладной; 
		Дата1 = ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач));  
		Дата2 = ?(ДатаКон = Дата(1,1,1), ПолучитьДатуСеанса(), КонецДня(ДатаКон));
		Если ДатаНакладной < Дата1 ИЛИ ДатаНакладной > Дата2 Тогда 
			Если ДатаНакладной < Дата1 Тогда
				ДатаНач = ДатаНакладной;
				НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Дата1", ДатаНач);
	            Элементы.НакладныеНаОтгрузку.Обновить();
			ИначеЕсли ДатаНакладной > Дата2 Тогда
				ДатаКон = ДатаНакладной;
				НакладныеНаОтгрузку.Параметры.УстановитьЗначениеПараметра("Дата2", ДатаКон);
	            Элементы.НакладныеНаОтгрузку.Обновить();
			КонецЕсли;	
		КонецЕсли;	
		Элементы.НакладныеНаОтгрузку.ТекущаяСтрока = Накладная; 
		ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные;
		Если НЕ ТекСтрока = неопределено Тогда  
			ЗаполнитьТаблицуИзделий(ТекСтрока.НакладнаяНаОтгрузку);
		Иначе
		    ТаблицаОбъектовЗалога.Очистить();	
		КонецЕсли;	 
		ИнформацияНакладные();
	Иначе  
		Предупреждение("Выбранный залоговый билет в накладных ломбарда не найден.", 60);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НакладныеНаОтгрузкуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекСтрока = Элементы.НакладныеНаОтгрузку.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  
		ПараметрыФормы = Новый Структура;
	    ПараметрыФормы.Вставить("Ключ", ТекСтрока.НакладнаяНаОтгрузку); 
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
		
	    ОткрытьФорму("Документ.ЛБ_НакладнаяНаОтгрузку.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

