	НовыйДок = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса(); 
	НовыйДок.Организация = Организация;  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтгрузкаНакладных; 
	НовыйДок.Ломбард = Ломбард;
	НовыйДок.Инкассатор = Инкассатор;
	НовыйДок.Получатель = Получатель;
	НовыйДок.СкладПолучатель = СкладПолучатель;
	НовыйДок.Ответственный = Ответственный; 
	
    Запрос = новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	СУММА(ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.КоличествоОстаток) КАК Количество,
	               |	СУММА(ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ВесОстаток) КАК Вес,
	               |	СУММА(ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.СуммаОценкиОстаток) КАК СуммаОценки,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Остатки(, НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку) КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Ломбард,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку";

	Для каждого Эл Из СписокНакладных Цикл   
		Запрос.УстановитьПараметр("НакладнаяНаОтгрузку", Эл.Значение);
		Выборка = Запрос.Выполнить().выбрать();
		Пока Выборка.Следующий() Цикл  
			НоваяСтр = НовыйДок.ЗалоговыеБилеты.Добавить(); 
			НоваяСтр.НакладнаяНаОтгрузку = Выборка.НакладнаяНаОтгрузку;
			НоваяСтр.ЗалоговыйБилет = Выборка.ЗалоговыйБилет;
			НоваяСтр.Ломбард = Выборка.Ломбард;
			НоваяСтр.ОбъектЗалога = Выборка.ОбъектЗалога;
			НоваяСтр.Количество = Выборка.Количество;
			НоваяСтр.Вес = Выборка.Вес; 
			НоваяСтр.СуммаОценки = Выборка.СуммаОценки;     
		КонецЦикла;	 
	КонецЦикла;	
	 
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение    
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
	КонецПопытки;	 
КонецПроцедуры	

