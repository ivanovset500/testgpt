&НаСервере
Процедура ОтменаОтгрузкиНакладныхНаСервере(Результат) 
	СписокНакладных = Результат;       
	
	//зафиксируем отмену отгрузки в документе изменение статуса (отгрузка)
	ЗапросН = Новый Запрос;   
	ЗапросН.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	ЗапросН.Текст ="ВЫБРАТЬ
	               |	ЛБ_ОтгруженныеНакладныеСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтгруженныеНакладные.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_ОтгруженныеНакладныеСрезПоследних"; 
	Для каждого Эл Из СписокНакладных Цикл    
		 ЗапросН.УстановитьПараметр("Накладная", Эл.Значение); 
		 ВыборкаН  = ЗапросН.Выполнить().Выбрать();
		 Если ВыборкаН.Следующий() Тогда  
			 ДокОтгрузка = ВыборкаН.Регистратор.ПолучитьОбъект(); 
			 ДокОтгрузка.ОтгрузкаОтменена = Истина;
			 ДокОтгрузка.Записать(РежимЗаписиДокумента.Проведение);
		 КонецЕсли;	 
	КонецЦикла;	
	
	НовыйДок = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса(); 
	НовыйДок.Организация = Организация;  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтменаОтгрузкиНакладных; 
	НовыйДок.Ответственный = Ответственный; 
	
	Запрос = новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Количество КАК Количество,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Вес КАК Вес,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.СуммаОценки КАК СуммаОценки
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Регистратор = &Регистратор
	               |	И ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку";

	ЗапросДок = новый Запрос;
	ЗапросДок.УстановитьПараметр("СписокНакладных", СписокНакладных); 
	ЗапросДок.Текст = "ВЫБРАТЬ
	                  |	ЛБ_ОтгруженныеНакладныеСрезПоследних.Регистратор КАК Регистратор,
	                  |	ЛБ_ОтгруженныеНакладныеСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку
	                  |ИЗ
	                  |	РегистрСведений.ЛБ_ОтгруженныеНакладные.СрезПоследних(, НакладнаяНаОтгрузку В (&СписокНакладных)) КАК ЛБ_ОтгруженныеНакладныеСрезПоследних";
	ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
	Пока ВыборкаДок.Следующий() Цикл   
		Запрос.УстановитьПараметр("Регистратор", ВыборкаДок.Регистратор);
		Запрос.УстановитьПараметр("НакладнаяНаОтгрузку", ВыборкаДок.НакладнаяНаОтгрузку);
		Выборка = Запрос.Выполнить().выбрать();
		Пока Выборка.Следующий() Цикл  
			НоваяСтр = НовыйДок.ЗалоговыеБилеты.Добавить(); 
			НоваяСтр.НакладнаяНаОтгрузку = Выборка.НакладнаяНаОтгрузку;
			НоваяСтр.ЗалоговыйБилет = Выборка.ЗалоговыйБилет;
			НоваяСтр.Ломбард = Выборка.Ломбард;
			НоваяСтр.ОбъектЗалога = Выборка.ОбъектЗалога;
			НоваяСтр.Количество = Выборка.Количество;
			НоваяСтр.Вес = Выборка.Вес; 
			НоваяСтр.СуммаОценки = Выборка.СуммаОценки;     
		КонецЦикла;	 
	КонецЦикла;	
	 
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение   
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(НовыйДок.Ссылка) + ". Обратитесь к разработчикам.");
	КонецПопытки;	 
КонецПроцедуры	

