//+МАН 15.11.24 Добавил расчет даты накладной на отгрузку. Заявка 2904
&НаСервереБезКонтекста
Процедура НакладныеНаОтгрузкуПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.КоличествоДнейДоступнаОтгрузка КАК КоличествоДней
		|ИЗ
		|	РегистрСведений.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.СрезПоследних(&Дата, Организация = &Организация) КАК ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Настройки.ПараметрыДанных.Элементы.найти("Организация").Значение);
	
	Для каждого Стр Из Строки.ПолучитьКлючи() Цикл
	
		Запрос.УстановитьПараметр("Дата", Стр.Дата);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Пока Результат.Следующий() Цикл
			
			СтрокаСписка = Строки[Стр];
			СтрокаСписка.Данные.ДатаОтгрузки = Стр.Дата + 86400 + Результат.КоличествоДней*86400;
			
			Если СтрокаСписка.Данные.ДатаОтгрузки <= НачалоДня(ТекущаяДата())
				И СтрокаСписка.Данные.СтатусНакладной <> Перечисления.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена
				И СтрокаСписка.Данные.КоличествоИзделий > 0 Тогда
				
				Для каждого СтрОформления Из СтрокаСписка.Оформление Цикл
					СтрокаСписка.Оформление[СтрОформления.Ключ].УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый);
				КонецЦикла;
			//Иначе
			//	Для каждого СтрОформления Из СтрокаСписка.Оформление Цикл
			//		СтрокаСписка.Оформление[СтрОформления.Ключ].УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Белый);
			//	КонецЦикла;
			КонецЕсли;
			
			СтрокаСписка.Оформление["ДатаОтгрузки"].УстановитьЗначениеПараметра("Формат", "ДФ=dd.MM.yyyy");
			
		КонецЦикла;
	
	КонецЦикла;
КонецПроцедуры
