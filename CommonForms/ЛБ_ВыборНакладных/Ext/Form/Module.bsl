&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация; 
	КонецЕсли;	
	Если Параметры.Свойство("Ломбард") Тогда
		Ломбард = Параметры.Ломбард;  
		НоваяСтр = Ломбарды.Добавить();
	    НоваяСтр.Ломбард = Ломбард;
	КонецЕсли;
	Если Параметры.Свойство("ВидОперации") Тогда
		ВидОперации = Параметры.ВидОперации; 
	КонецЕсли;	                           
	ЭтаФорма.Заголовок = ?(ВидОперации = 0, "Выбор накладных для отгрузки", "Выбор накладных для отмены отгрузки");  
	Если ВидОперации = 0 Тогда
		Элементы.СтрокаЛомбарды.Видимость = Ложь; 
		Элементы.Ломбард.Видимость = Истина;
	Иначе    
		Элементы.СтрокаЛомбарды.Видимость = Истина; 
		Элементы.Ломбард.Видимость = Ложь;
		ЗаполнитьСписокЛомбардов(); 
	КонецЕсли;	
	ПолучитьНакладные();
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокЛомбардов()
	Результат = "";
	Для каждого Стр Из Ломбарды Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + ?(НЕ ПустаяСтрока(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.Наименование));
	КонецЦикла;	
	СтрокаЛомбарды = Результат; 
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокРезультат()  
	СписокРезультат.Очистить(); 
	
	Для каждого Эл из СписокНакладных Цикл 
		Если Эл.Пометка Тогда 
			СписокРезультат.Добавить(Эл.Значение);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда) 
	ЗаполнитьСписокРезультат();
	
	Если СписокРезультат.Количество() = 0 Тогда
		Предупреждение("Не выбраны накладные на отгрузку", 60);   
	Иначе
		ЭтаФорма.Закрыть(СписокРезультат);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.закрыть();
КонецПроцедуры

