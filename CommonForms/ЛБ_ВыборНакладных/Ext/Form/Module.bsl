&НаКлиенте
Процедура СтрокаЛомбардыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	ПараметрыФормы = Новый Структура;    
	ПараметрыФормы.Вставить("Ломбарды", Ломбарды); 
	ПараметрыФормы.Вставить("ДатаДок", ТекущаяДата());
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЛомбардов",ЭтаФорма);
	
	ОткрытьФорму("Обработка.ЛБ_ВыборЛомбардовИзСписка.Форма", ПараметрыФормы, Элементы.СтрокаЛомбарды,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры     

&НаСервере
Процедура СохранитьЛомбарды(Результат)
	Ломбарды.Очистить();  
	КоличествоВыбрано = Результат.Количество;
	Для сч = 1 По КоличествоВыбрано Цикл
		НоваяСтр = Ломбарды.Добавить();
		НоваяСтр.Ломбард = Результат["Значение" + Строка(сч)];
	КонецЦикла;	
	
	ЗаполнитьСписокЛомбардов();
	ПолучитьНакладные();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЛомбардов(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
	    Возврат;
	КонецЕсли;
		
	СохранитьЛомбарды(Результат);	
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	Ломбарды.Очистить();  
	НоваяСтр = Ломбарды.Добавить();
	НоваяСтр.Ломбард = Ломбард;
	ПолучитьНакладные();
КонецПроцедуры

&НаКлиенте
Процедура СписокНакладныхПометкаПриИзменении(Элемент)
	ТекСтр = Элементы.СписокНакладных.ТекущиеДанные;
	
	Если ТекСтр <> Неопределено Тогда
		Если ВидОперации = 1 Тогда
			Если ТекСтр.Пометка Тогда
				ЕстьДвижение = ПроверитьДвижениеЗБВНакладной(ТекСтр.Значение);
				
				Если ЕстьДвижение Тогда
					НайденаяСтр = СписокНакладных.НайтиПоЗначению(ТекСтр.Значение);
					НайденаяСтр.Пометка = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьДвижениеЗБВНакладной(НакладнаяСсылка)
	
	БылиДвиженияПоЗБДаннойНакладнойДляОтмены = Ложь;
	
	ЗапросДатыОтгрузкиНакладной = Новый Запрос;
	
	ЗапросДатыОтгрузкиНакладной.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                              |	ЛБ_ОтгруженныеНакладныеСрезПоследних.Период КАК Период
	                              |ИЗ
	                              |	РегистрСведений.ЛБ_ОтгруженныеНакладные.СрезПоследних КАК ЛБ_ОтгруженныеНакладныеСрезПоследних
	                              |ГДЕ
	                              |	ЛБ_ОтгруженныеНакладныеСрезПоследних.НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку
	                              |
	                              |УПОРЯДОЧИТЬ ПО
	                              |	Период УБЫВ";
	
	ЗапросДатыОтгрузкиНакладной.УстановитьПараметр("НакладнаяНаОтгрузку", НакладнаяСсылка);
	
	РезультатЗапроса = ЗапросДатыОтгрузкиНакладной.Выполнить().Выгрузить();
	 
	Если РезультатЗапроса.Количество() > 0 Тогда
		ДатаОтгрузкиНакладной = РезультатЗапроса[0].Период;
	КонецЕсли;
	
	//Здесь, возможно, нужна установка другой даты если РезультатЗапроса.Количество() <= 0.
	 
	ЗБпоНакладной = Новый Запрос;
	
	ЗБпоНакладной.Текст=" 
	|SELECT РАЗЛИЧНЫЕ
	|ЗалоговыйБилет
	|FROM Документ.ЛБ_НакладнаяНаОтгрузку.Залоги
	|WHERE ССЫЛКА=&НакладнаяНаОтгрузку
	|"; //левое соединение для отсева накладных у которых были документы выписины
	ЗБпоНакладной.Параметры.Вставить("НакладнаяНаОтгрузку", НакладнаяСсылка);
	
	ВыборкаЗБпоНакладной=ЗБпоНакладной.Выполнить().Выбрать();
	
	Пока ВыборкаЗБпоНакладной.Следующий() Цикл
		ДвиженияПоЗБПослеНакладной = Новый Запрос;
		ДвиженияПоЗБПослеНакладной.Текст = 
		"
		|SELECT 
		|Ссылка, ЗалоговыйБилет
		|FROM Документ.ЛБ_Реализация.Товары
		|WHERE ЗалоговыйБилет=&ЗалоговыйБилет и ССЫЛКА.Проведен И ССЫЛКА.Дата>&ЗалоговыйБилетДата
		
		|ОБЪЕДИНИТЬ
		
		|SELECT 
		|Ссылка, ЗалоговыйБилет
		|FROM Документ.ЛБ_ПеремещениеОбъектовЗалога.Товары
		|WHERE ЗалоговыйБилет=&ЗалоговыйБилет и ССЫЛКА.Проведен И ССЫЛКА.Дата>&ЗалоговыйБилетДата
		
		|ОБЪЕДИНИТЬ
		
		|SELECT 
		|Ссылка, ЗалоговыйБилет
		|FROM Документ.ЛБ_ОприходованиеОбъектовЗалога.Товары
		|WHERE ЗалоговыйБилет=&ЗалоговыйБилет и ССЫЛКА.Проведен И ССЫЛКА.Дата>&ЗалоговыйБилетДата
		
		|ОБЪЕДИНИТЬ
		
		|SELECT 
		|Ссылка, ЗалоговыйБилет
		|FROM Документ.ЛБ_КорректировкаНакладной.ЗалоговыеБилеты
		|WHERE ЗалоговыйБилет=&ЗалоговыйБилет и ССЫЛКА.Проведен И ССЫЛКА.Дата>&ЗалоговыйБилетДата";
		
		ДвиженияПоЗБПослеНакладной.Параметры.Вставить("ЗалоговыйБилет",ВыборкаЗБпоНакладной.ЗалоговыйБилет);
		//+МАН 25.08.25
		ДвиженияПоЗБПослеНакладной.Параметры.Вставить("ЗалоговыйБилетДата",ДатаОтгрузкиНакладной);
		//ДвиженияПоЗБПослеНакладной.Параметры.Вставить("ЗалоговыйБилетДата",ВыборкаЗБпоНакладной.ЗалоговыйБилет.Дата);
		//-МАН
		
		РезультатЗапросаДвиженияПоЗБПослеНакладной = ДвиженияПоЗБПослеНакладной.Выполнить();
		Если не РезультатЗапросаДвиженияПоЗБПослеНакладной.Пустой() тогда
			БылиДвиженияПоЗБДаннойНакладнойДляОтмены = Истина;
			Сообщить("Внимание! По ЗБ №"+ВыборкаЗБпоНакладной.ЗалоговыйБилет.НомерЗалоговогоБилета+" из накладной №"+СокрЛП(НакладнаяСсылка.ПредставлениеНомераНакладной)+" есть операция после отгрузки. Отмена отгрузки накладной невозможна");
		КонецЕсли;
		
		//Для отладки, документы попавшие в список злодеев
		//ВыборкаДетальныеЗаписиДвиженияПоЗБПослеНакладной = РезультатЗапросаДвиженияПоЗБПослеНакладной.Выбрать();
		//Пока ВыборкаДетальныеЗаписиДвиженияПоЗБПослеНакладной.Следующий() Цикл
		//	Сообщить("    "+ВыборкаДетальныеЗаписиДвиженияПоЗБПослеНакладной.Ссылка+" по накладной "+СокрЛП(Выборка.НакладнаяНаОтгрузку.ПредставлениеНомераНакладной));
		//КонецЦикла;
	КонецЦикла;
	
	Возврат БылиДвиженияПоЗБДаннойНакладнойДляОтмены;
КонецФункции
