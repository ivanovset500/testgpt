		СообщениеТекст = СтрШаблон("Клиенту %1 %2?! Проверьте правильность ввода даты рождения.", Строка(ВозрастЗалогодателя), ОписаниеВ);
		ОбщегоНазначения.СообщитьПользователю(СообщениеТекст, , , "ДатаРождения");
		Результат = Ложь;
	ИначеЕсли ВозрастЗалогодателя < 18 Тогда
		//Сообщить("Внимание! Клиенту " + Строка(ВозрастЗалогодателя) + " " + ОписаниеВ + ". Выдача займов и прием оплаты по договору займа от лиц, не достигших 18 лет, не осуществляется!", СтатусСообщения.Важное);
		СообщениеТекст = СтрШаблон("Внимание! Клиенту %1 %2. Выдача займов и прием оплаты по договору займа от лиц, не достигших 18 лет, не осуществляется!", Строка(ВозрастЗалогодателя), ОписаниеВ);
		//ОбщегоНазначения.СообщитьПользователю(СообщениеТекст, , , "ДатаРождения");
		ОбщегоНазначения.СообщитьПользователю(СообщениеТекст, , , );
		//Результат = Ложь;
	КонецЕсли;	
	Возврат Результат;
КонецФункции

