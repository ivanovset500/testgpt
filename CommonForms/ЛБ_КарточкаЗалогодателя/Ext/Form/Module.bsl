	//заполняем конт. информацию и документы
	ЭтоНовыйКлиент = Ложь;
	ЗаполнитьКонтактнуюИнформацию();
	ЗаполнитьДокументы();  
	ЗаполнитьАнкету();	 
	ЗаполнитьТаблицуДоверенностей();
	
	Элементы.ФормаКнопкаЗаписать.Доступность = Истина;
