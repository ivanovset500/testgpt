Функция ПолучитьДУЛ() 
	ДУЛы = ДокументыЗалогодателя.Выгрузить();
	ДУЛы.Сортировать("Основной Убыв, Период Убыв"); 
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокументаЗалогодателя", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность"));  
	//Отбор.Вставить("Гражданство", Гражданство);
	Отбор.Вставить("ДокументНеДействителен", Ложь); 
	Отбор.Вставить("ПроверкаНеДействителен", Ложь);
	СтрокиД = Дулы.НайтиСтроки(Отбор);   
	Если НЕ СтрокиД.Количество() = 0 Тогда
		Для каждого СтрД Из СтрокиД Цикл
			ДУЛ = "";
			//ДУЛ = ДУЛ + ?(ПустаяСтрока(ДУЛ), "", Символ(94) + Символ(112)) + СокрЛП(СтрД.ВидДокумента);
			ДУЛ = ДУЛ + ?(ПустаяСтрока(ДУЛ), "", Символы.ПС) + СокрЛП(СтрД.ВидДокумента);
			ДУЛ = ДУЛ + ?(ПустаяСтрока(СтрД.ДокументСерия), "", " " + СокрЛП(СтрД.ДокументСерия));
			ДУЛ = ДУЛ + ?(ПустаяСтрока(СтрД.ДокументНомер), "", " № " + СокрЛП(СтрД.ДокументНомер));
			ДУЛ = ДУЛ + ?(СтрД.ДокументДатаВыдачи = Дата(1,1,1), "", " выдан " + Формат(СтрД.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")); 
			ДУЛ = ДУЛ + ?(ПустаяСтрока(СтрД.ДокументКемВыдан), "", " " + СокрЛП(СтрД.ДокументКемВыдан));
			ДУЛ = ДУЛ + ?(ПустаяСтрока(СтрД.ДокументКодПодразделения), "", " к/п " + СокрЛП(СтрД.ДокументКодПодразделения));
			ДУЛ = ДУЛ + ?(СтрД.ДокументСрокДействия = Дата(1,1,1), "", " действует до " + Формат(СтрД.ДокументСрокДействия, "ДФ=dd.MM.yyyy"));
		КонецЦикла;
		Возврат ДУЛ;
	КонецЕсли;
	Возврат неопределено;
КонецФункции

