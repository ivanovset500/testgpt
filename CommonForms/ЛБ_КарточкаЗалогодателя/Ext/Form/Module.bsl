КонецПроцедуры

&НаСервере 
Процедура ОчиститьСотрудниковВРегистреСоответствия()
	НаборЗаписей = РегистрыСведений.ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Клиент.Установить(Залогодатель);
	НаборЗаписей.Записать(); 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДопСтатусовФлВклПриИзменении(Элемент)
	ТекСтрокаДоп = Элементы.ТаблицаДопСтатусов.ТекущиеДанные;
	Если НЕ ТекСтрокаДоп.Используется Тогда 
		ТекСтрокаДоп.СрокДействия = Дата(1,1,1); 
		ТекСтрокаДоп.Комментарий = ""; 
		
		Если ТекСтрокаДоп.Статус = ПредопределенноеЗначение("Справочник.ЛБ_СтатусыЗалогодателей.Сотрудник") Тогда 
			ОчиститьСотрудниковВРегистреСоответствия();
		КонецЕсли;	
	ИначеЕсли ТекСтрокаДоп.Статус = ПредопределенноеЗначение("Справочник.ЛБ_СтатусыЗалогодателей.Сотрудник") Тогда	
		Если НЕ ЭтоНовыйКлиент Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Клиент", Залогодатель); 
			ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораСотрудников", ЭтаФорма);
			ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборСтрудниковДляСтатусаСотрудник", ПараметрыФормы,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		Иначе   
			Предупреждение("Выбор сотрудников возможен только после сохранения карточки клиента.", 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Функция ПолучитьСписокСотрудников() 
	ТекстСотрудники = "";
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Клиент", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.ЛБ_СоответствиеКлиентовИСотрудниковОрганизации КАК ЛБ_СоответствиеКлиентовИСотрудниковОрганизации
	|ГДЕ
	|	ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.Клиент = &Клиент";
	Выборка = Запрос.Выполнить().Выбрать();  
	Пока Выборка.Следующий() Цикл
		ТекстСотрудники = ТекстСотрудники + ?(ПустаяСтрока(ТекстСотрудники), "", "; ") + СокрЛП(Выборка.Сотрудник);
	КонецЦикла;                                                                          
	Возврат ТекстСотрудники;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСотрудников(Результат, ДопПараметры) Экспорт  
	ТекСтрокаДоп = Элементы.ТаблицаДопСтатусов.ТекущиеДанные;
	ТекСтрокаДоп.Комментарий = ПолучитьСписокСотрудников();	
КонецПроцедуры

&НаКлиенте
Процедура СтатистикаПоКлиенту(Команда) 
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Залогодатель) Тогда
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Клиент", Залогодатель);
	ПараметрыФормы.Вставить("Дата", Дата);	 
	
	ОткрытьФорму("Отчет.ЛБ_СтатистикаОбращенийКлиента.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
КонецПроцедуры

&НаКлиенте
Процедура ПрисоединитьСкан(Команда)
	ТекСтрока = Элементы.Документы.ТекущиеДанные;  
	Если ЗначениеЗаполнено(ТекСтрока.ДокументСсылка) тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВладелецФайла",  ТекСтрока.ДокументСсылка);
		ПараметрыФормы.Вставить("ТолькоПросмотр", ложь);
		
		ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.Независимый);
	Иначе
		Сообщить("Документ не сохранен!", СтатусСообщения.Информация);
	КонецЕсли;	
КонецПроцедуры

//+Мельников 14.10.24 ВИП. Заявка 2792
&НаКлиенте
Процедура ТаблицаДопСтатусовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные.Статус = ПредопределенноеЗначение("Справочник.ЛБ_СтатусыЗалогодателей.VIP") Тогда
		//+МАН 11.11.24 Убрал проверку есть статус ВИП или нет, чтобы можно было смотреть историю. Заявка 2792
		//Элемент.ТекущиеДанные.Используется
		//-МАН
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
		
		ОткрытьФорму("ОбщаяФорма.ЛБ_ИнформацияВИП", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Элемент.ТекущиеДанные.Статус = ПредопределенноеЗначение("Справочник.ЛБ_СтатусыЗалогодателей.Сотрудник") Тогда
		Если Элемент.ТекущиеДанные.Используется Тогда 
			
			Если ЗначениеЗаполнено(Залогодатель) Тогда
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Клиент", Залогодатель); 				
				
				Если Элементы.ТаблицаДопСтатусов.ТолькоПросмотр ИЛИ НЕ СотрудникЦО Тогда  
					ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
					ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборСтрудниковДляСтатусаСотрудник", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
				Иначе                    
					ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
					Оповещение = Новый ОписаниеОповещения("ПослеВыбораСотрудников", ЭтаФорма);
					ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборСтрудниковДляСтатусаСотрудник", ПараметрыФормы,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
				КонецЕсли;	 
			Иначе 
				Предупреждение("Выбор сотрудников возможен только после сохранения карточки клиента.", 60);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

