&НаСервере
Функция ПроверитьФИОЗалогодателя()
	СтруктураВозврата = ЛБ_ОбщийМодуль.ПроверитьФИОЗалогодателя(Фамилия, Имя, Отчество);
	Если НЕ СтруктураВозврата.Результат Тогда
		Сообщить(СтруктураВозврата.Сообщение, СтатусСообщения.Важное);
	КонецЕсли;
	Возврат СтруктураВозврата.Результат;
КонецФункции

&НаСервере
Функция ПроверитьФИОЗалогодателя_А()
	Если НЕ ПустаяСтрока(Фамилия_А) ИЛИ НЕ ПустаяСтрока(Имя_А) ИЛИ НЕ ПустаяСтрока(Отчество_А) Тогда
		СтруктураВозврата = ЛБ_ОбщийМодуль.ПроверитьФИОЗалогодателя(Фамилия_А, Имя_А, Отчество_А, Ложь);
		Если НЕ СтруктураВозврата.Результат Тогда
			Сообщить(СтруктураВозврата.Сообщение, СтатусСообщения.Важное);
		КонецЕсли;
		Возврат СтруктураВозврата.Результат;
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

