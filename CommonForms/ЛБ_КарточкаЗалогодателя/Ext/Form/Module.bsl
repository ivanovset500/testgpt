&НаКлиенте
Процедура УстановитьДоступностьЭлементовПриСозданииКлиента(ПризнакДоступности)
	
	Если Не ПризнакДоступности Тогда
		Элементы.Отчество.Доступность          = Истина;
		Элементы.СтраницаКИ.Доступность        = Истина;
		//Иванов 06.2025 видимость кнопки ЭДО, согласия, контактные данные		
		Элементы.ЭДО.Доступность               = Ложь;
		Элементы.ЭДО.ТолькоПросмотр            = Истина;
		
		Элементы.Согласие.Доступность = Ложь;
		Элементы.Согласие.ТолькоПросмотр = Истина;
		
		Элементы.КонтактныеДанные.Доступность = Ложь;
		Элементы.КонтактныеДанные.ТолькоПросмотр = Истина;
		//
		Элементы.Группа1.Доступность           = Ложь;
		Элементы.Группа10.Доступность          = Ложь;
		Элементы.ГруппаГражданство.Доступность = Ложь;
		Элементы.ГруппаФИО_Англ.Доступность    = Ложь;
		Элементы.ГруппаДокументы.Доступность   = Ложь;
		Элементы.Группа4.Доступность           = Ложь;
		Элементы.Пол.Доступность               = Ложь;
		Элементы.МестоРождения.Доступность     = Ложь;
		Элементы.Телефон.Доступность           = Ложь;
		Элементы.Email.Доступность             = Ложь;
	Иначе 
		Элементы.СтраницаДопСтатусы.Доступность = Истина;
		Элементы.СтраницаАнкета.Доступность     = Истина; 
		Элементы.СтраницаЗБ.Доступность         = Истина;
		Элементы.Группа1.Доступность            = Истина;
		Элементы.Группа10.Доступность           = Истина;
		Элементы.ГруппаГражданство.Доступность  = Истина;
		Элементы.ГруппаФИО_Англ.Доступность     = Истина;
		Элементы.ГруппаДокументы.Доступность    = Истина;
		Элементы.Группа4.Доступность            = Истина;
		Элементы.Пол.Доступность                = Истина;
		Элементы.МестоРождения.Доступность      = Истина;
		Элементы.Телефон.Доступность            = Истина;
		Элементы.Email.Доступность              = Истина;
	КонецЕсли; 
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьОднофамильцев(МассивСсылок, МассивДанных)
	
	ТекстРезультат = "";
	Для каждого Данные Из МассивДанных Цикл
		
		ТекстРезультат = ТекстРезультат + Символы.ПС + СтрШаблон("%1 %2 %3, дата рождения %4 г.", Данные.Фамилия, Данные.Имя, Данные.Отчество, Формат(Данные.ДатаРождения, "ДФ=dd.MM.yyyy"));
		
	КонецЦикла;
	
	ТекстОповещения = "" + СтрШаблон("В базе %1 с идентичными данными.", ?(МассивДанных.Количество() > 1, "обнаружены клиенты", "обнаружен клиент")) + " 
	| " + ТекстРезультат + "
	|
	|Создать нового клиента? 
	|
	|Да - создать нового клиента,
	|Нет - перейти в карточку клиента, не создавая нового клиента.";
	
	Оповещение = Новый ОписаниеОповещения("ВопросСоздатьНовогоКлиента", ЭтаФорма, МассивСсылок);
	ПоказатьВопрос(Оповещение, ТекстОповещения, РежимДиалогаВопрос.ДаНет, 0)
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросСоздатьНовогоКлиента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		Отбор = Новый Структура("Ссылка", ДополнительныеПараметры);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Отбор",        Отбор);
		ПараметрыОткрытия.Вставить("ДатаРождения", ДатаРождения);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораОднофамильца", ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПросмотрСписокаОднофамильцев", ПараметрыОткрытия, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.Независимый);
		
		ЭтаФорма.Модифицированность = Ложь;
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры 

