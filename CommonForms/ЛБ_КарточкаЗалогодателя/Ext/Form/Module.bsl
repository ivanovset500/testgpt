&НаСервере
Функция ПроверитьЗаполнениеДокументов() 
	Результат = Истина;	
	
	Если Гражданство = Справочники.СтраныМира.Россия Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ГражданинРФ;
	ИначеЕсли Гражданство = Справочники.СтраныМира.БезГражданства Тогда
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ЛицоБезГражданства;
	Иначе
		ВидГражданства = Перечисления.ЛБ_ВидыГражданства.ИностранныйГражданин;
	КонецЕсли;	
	
	
	ЗапросДок = Новый Запрос;
	ЗапросДок.Текст = "ВЫБРАТЬ
	|	ЛБ_ПереченьДокументовЗалогодателя.Гражданство КАК Гражданство,
	|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокумента КАК ВидДокумента,
	|	ЛБ_ПереченьДокументовЗалогодателя.ТребуетсяДополнительныйДокумент КАК ТребуетсяДополнительныйДокумент
	|ИЗ
	|	РегистрСведений.ЛБ_ПереченьДокументовЗалогодателя КАК ЛБ_ПереченьДокументовЗалогодателя
	|ГДЕ
	|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
	|	И ЛБ_ПереченьДокументовЗалогодателя.Гражданство В(&Гражданство)
	|	И ЛБ_ПереченьДокументовЗалогодателя.ВидГражданства = &ВидГражданства
	|
	|УПОРЯДОЧИТЬ ПО
	|	Гражданство УБЫВ";
	
	//проверим есть ДУЛ
	ЕстьДУЛ = ложь;	 
	ТребуетсяДополнительныйДокумент = Ложь;
	Для каждого Стр Из ДокументыЗалогодателя Цикл
		Если Стр.ДокументНЕДействителен ИЛИ Стр.ПроверкаНЕДействителен Тогда
			Продолжить;
		КонецЕсли;	
		Если (Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность) И Стр.ОсновнойДУЛ  Тогда
			Если НЕ Стр.Гражданство = Гражданство Тогда
				Продолжить;
			КонецЕсли;	
			Если (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
				(Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность) Тогда
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, Стр.ДокументДатаВыдачи) Тогда
					Продолжить;
				КонецЕсли;	    
				Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
					Если ПроверитьПаспортВСпискеНеДействительных(Стр.ДокументСерия, Стр.ДокументНомер) И НЕ Стр.ДокументДействителен  Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли; 
				// ++ Сербаев 08.06.2023  (Проверка документа Вид на жительство на действительность)
				Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда
					Если Не ЛБ_ОбщийМодуль.ПроверитьДействительностьВидаНаЖительство(Стр, ДатаРождения, Дата) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				// -- Сербаев 08.06.2023
			ИначеЕсли ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, Стр.ВидДокументаЗалогодателя, Стр.ВидДокумента) Тогда
				Если Стр.ДокументСрокДействия < НачалоДня(Дата) Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
			ЕстьДУЛ = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если НЕ ЕстьДУЛ Тогда
		Сообщить("У клиента не найден действующий основной документ удостоверяющего личность для установленного гражданства. Необходимо выбрать основной или завести новый ДУЛ.");
		Результат = Ложь; 
	КонецЕсли;	
	
	////проверим недействительность свидетельства о рождении если есть паспорт
	//ЕстьПаспорт = ложь;
	//ЕстьСвидетельствоОРождении = ложь;
	//Для каждого Стр Из ДокументыЗалогодателя Цикл
	//	Если (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) И НЕ Стр.ДокументНЕДействителен Тогда
	//	    ЕстьПаспорт = Истина;
	//	ИначеЕсли (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) И НЕ Стр.Стр.ДокументНЕДействителен Тогда
	//		ЕстьСвидетельствоОРождении = Истина;
	//    КонецЕсли;
	//КонецЦикла;	
	//Если ЕстьПаспорт И ЕстьСвидетельствоОРождении Тогда
	//	ОтборД = Новый структура;
	//	ОтборД.Вставить("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении);
	//	ОтборД.Вставить("ДокументНеДействителен", Ложь);
	//	СтрокиД = ДокументыЗалогодателя.НайтиСтроки(ОтборД);
	//	Для каждого СтрД Из СтрокиД цикл
	//		СтрД.ДокументНеДействителен = Истина;
	//	Конеццикла;	
	//КонецЕсли;	
	
	ЗапросДок.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	ЗапросДок.УстановитьПараметр("ВидГражданства", ВидГражданства);
	
	МассивГ = Новый Массив;
	МассивГ.Добавить(Справочники.СтраныМира.ПустаяСсылка());
	//+МАН 22.04.25 
	//Было: МассивГ.Добавить(Стр.Гражданство);
	Если Стр <> Неопределено Тогда
		МассивГ.Добавить(Стр.Гражданство);
	КонецЕсли;
	//-МАН
	ЗапросДок.УстановитьПараметр("Гражданство", МассивГ);
	ТаблицаДок = ЗапросДок.Выполнить().Выгрузить();
	Отбор = Новый Структура;
	//+МАН 22.04.25 
	//Было: Отбор.Вставить("ВидДокумента", Стр.ВидДокумента);
	Если Стр <> Неопределено Тогда
		Отбор.Вставить("ВидДокумента", Стр.ВидДокумента);
	КонецЕсли;
	//-МАН
	СтрокиДок = ТаблицаДок.НайтиСтроки(Отбор);
	Если НЕ СтрокиДок.Количество() = 0 Тогда				 
		ТребуетсяДополнительныйДокумент = СтрокиДок.Получить(0).ТребуетсяДополнительныйДокумент;
	КонецЕсли;	 
	
	Если ТребуетсяДополнительныйДокумент Тогда
		ЕстьДопДокумент = ложь;
		ЗапросДок.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ);
		ЗапросДок.УстановитьПараметр("ВидГражданства", ВидГражданства);
		МассивГ = Новый Массив;
		МассивГ.Добавить(Справочники.СтраныМира.ПустаяСсылка());
		МассивГ.Добавить(Гражданство);
		ЗапросДок.УстановитьПараметр("Гражданство", МассивГ);
		ТаблицаДок = ЗапросДок.Выполнить().Выгрузить();
		
		Для каждого Стр Из ДокументыЗалогодателя Цикл
			Если (Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ) И Стр.Основной  Тогда
				Если НЕ Стр.Гражданство = Гражданство Тогда
					Продолжить;
				КонецЕсли;	
				Если Стр.ДокументНЕДействителен ИЛИ Стр.ПроверкаНЕДействителен Тогда
					Продолжить;
				КонецЕсли;	
				Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, Стр.ВидДокументаЗалогодателя, Стр.ВидДокумента) Тогда
					Если Стр.ДокументСрокДействия < НачалоДня(Дата) Тогда
						Продолжить;
					КонецЕсли;	
					ЕстьДопДокумент = Истина;
					Прервать;
				Иначе	
					ЕстьДопДокумент = Истина;
					Прервать;
				КонецЕсли;	  
				Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда
					Если Не ЛБ_ОбщийМодуль.ПроверитьДействительностьВидаНаЖительство(Стр, ДатаРождения, Дата) Тогда
						Продолжить;  
					Иначе
						ЕстьДопДокумент = Истина; 
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		Если НЕ ЕстьДопДокумент Тогда
			Сообщить("У клиента не найдены действующие основные документы, удостоверяющие право на пребывание в РФ. Необходимо выбрать документы или завести новые.");
			Результат = Ложь; 
		КонецЕсли;	
	КонецЕсли;	   
	
	//проверим одинаковые по виду документа (совпадение серии, номера)
	ВидыДокументов = ДокументыЗалогодателя.Выгрузить();
	ВидыДокументов.Свернуть("ВидДокументаЗалогодателя, ВидДокумента");
	
	Для каждого СтрВ из ВидыДокументов Цикл 
		Отбор = новый Структура;
		Отбор.Вставить("ВидДокументаЗалогодателя", СтрВ.ВидДокументаЗалогодателя); 
		Отбор.Вставить("ВидДокумента", СтрВ.ВидДокумента);   
		
		Строки = ДокументыЗалогодателя.НайтиСтроки(Отбор);
		Если Строки.Количество() > 1 Тогда
			Для каждого стр Из Строки Цикл   
				Если ЗначениеЗаполнено(Стр.ДокументСерия) ИЛИ ЗначениеЗаполнено(Стр.ДокументНомер) Тогда 
					Отбор.Вставить("ДокументСерия", Стр.ДокументСерия);
					Отбор.Вставить("ДокументНомер", Стр.ДокументНомер);
					
					СтрокиДок = ДокументыЗалогодателя.НайтиСтроки(Отбор); 
					Если СтрокиДок.Количество() > 1 Тогда
						Кол = СтрокиДок.Количество();
						Сообщить("У клиента найдены " + Строка(Кол) + " документа " + СокрЛП(Стр.ВидДокумента) + " с одинаковыми серией и номером!");
						Результат = Ложь;                                                                                                               
						Прервать;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	Конеццикла;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПроверитьАнкету()  
	Результат = Истина;
	Если НЕ ПустаяСтрока(ИНН) Тогда
		Если СтрДлина(СокрЛП(ИНН)) < 12 Тогда
			Сообщить("Длина ИНН клиента должна быть 12 символов!"); 
			Результат = ложь;
		КонецЕсли; 
		ТолькоНули = Истина;
		Для сч = 1 по СтрДлина(СокрЛП(ИНН)) Цикл 
			Если Сред(СокрЛП(ИНН), сч, 1) = "0" Тогда
				Продолжить;
			КонецЕсли;
			ТолькоНули = Ложь;
			Прервать;
		Конеццикла;	 
		Если ТолькоНули Тогда  
			Сообщить("ИНН клиента не может содержать только нули!"); 
			Результат = ложь;
		КонецЕсли;	
	КонецЕсли;	
	Если НЕ ПустаяСтрока(СНИЛС) Тогда  
		ПроверкаСНИЛС = СтрЗаменить(СНИЛС, "-", "");
		Если СтрДлина(СокрЛП(ПроверкаСНИЛС)) < 10 Тогда
			Сообщить("Длина СНИЛС клиента должна быть 10 символов!"); 
			Результат = ложь;
		КонецЕсли; 
		ТолькоНули = Истина;                       
		СНИЛСПроверка = СтрЗаменить(СокрЛП(СНИЛС), "-", "");
		Для сч = 1 по СтрДлина(СокрЛП(СНИЛСПроверка)) Цикл 
			Если Сред(СНИЛСПроверка, сч, 1) = "0" Тогда
				Продолжить;
			КонецЕсли;
			ТолькоНули = Ложь;
			Прервать;
		Конеццикла;	 
		Если ТолькоНули Тогда  
			Сообщить("СНИЛС клиента не может содержать только нули!"); 
			Результат = ложь;
		КонецЕсли;	
	КонецЕсли;	   
	Если ЯвляетсяИПДЛ Тогда 
		Если КатегорияКлиентаИПДЛ = ПредопределенноеЗначение("Перечисление.ЛБ_КатегорииИПДЛ.ИПДЛ") ИЛИ
			КатегорияКлиентаИПДЛ = ПредопределенноеЗначение("Перечисление.ЛБ_КатегорииИПДЛ.СупругИПДЛ") Тогда  
			Если НЕ ЗначениеЗаполнено(КатегорияКлиентаИПДЛ) ИЛИ ПустаяСтрока(ДолжностьИПДЛ) ИЛИ ПустаяСтрока(РаботодательИПДЛ) Тогда
				Сообщить("Для клиента ИПДЛ необходимо заполнить все поля в группе ИПДЛ кроме уточняющей информации!"); 
				Результат = ложь;
			КонецЕсли;
		Иначе 
			Если НЕ ЗначениеЗаполнено(КатегорияКлиентаИПДЛ) ИЛИ ПустаяСтрока(ДопИнформацияИПДЛ) ИЛИ ПустаяСтрока(ДолжностьИПДЛ) ИЛИ ПустаяСтрока(РаботодательИПДЛ) Тогда
				Сообщить("Для клиента ИПДЛ необходимо заполнить все поля в группе ИПДЛ!"); 
				Результат = ложь;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	Если ЯвляетсяДЛПМО_РДПЛ Тогда 
		Если НЕ ЗначениеЗаполнено(КатегорияДЛПМО_РДПЛ) ИЛИ ПустаяСтрока(ДопИнформацияДЛПМО_РДПЛ) ИЛИ ПустаяСтрока(ДолжностьДЛПМО_РДПЛ) ИЛИ ПустаяСтрока(РаботодательДЛПМО_РДПЛ) Тогда
			Сообщить("Для клиента ДЛПМО_РДПЛ необходимо заполнить все поля в группе ДЛПМО_РДПЛ!"); 
			Результат = ложь;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИсточникПроисхожденияИмущества) И ПустаяСтрока(ИсточникПроисхожденияИмуществаИной) Тогда
		//Сообщить("Не заполнена информация об источнике происхождения имущества клиента!");
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнена информация об источнике происхождения имущества клиента!'"), , ,"ИсточникПроисхожденияИмущества");
		Результат = ложь;
	КонецЕсли; 
	Если НЕ ЗначениеЗаполнено(ИсточникПроисхожденияДенежныхСредств) И ПустаяСтрока(ИсточникПроисхожденияДенежныхСредствИной) Тогда
		//Сообщить("Не заполнена информация об источнике происхождения денежных средств клиента!");
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнена информация об источнике происхождения денежных средств клиента!'"), , ,"ИсточникПроисхожденияДенежныхСредств");
		Результат = ложь;
	КонецЕсли;
	Если НЕ ЗалогодательБенефициарныйВладелец Тогда
		Если Бенефициары.Количество() = 0 Тогда  
			Сообщить("Клиент не является бенефициарным владельцем. Необходимо установить бенефициарных владельцев!"); 
			Результат = ложь;  
		Иначе
			Для каждого Стр Из Бенефициары Цикл  
				Если НЕ ЗначениеЗаполнено(Стр.Бенефициар) ИЛИ  НЕ ЗначениеЗаполнено(Стр.ВидПолученияИнформации) Тогда 
					Сообщить("Для бенефициарных владельцев необходимо заполнить бенефициара и вид получения информации!"); 
					Результат = ложь;  
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ПроверитьСотрудников()          
	Отбор = Новый Структура;
	Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник);
	СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);   
	Если СтрокиС.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	СтрС = строкиС.Получить(0);
	Если СтрС.Используется Тогда
		Если ПустаяСтрока(ПолучитьСписокСотрудников()) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Клиент является сотрудником организации, нужно определить соответствие клиента и сотрудника.'"), , ,);     
			Возврат Ложь; 
		КонецЕсли;	
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПроверитьИЗаписать(Сохранять = Истина)  	
	Если ДатаСмерти = Дата(1,1,1) Тогда
		Если НЕ ПроверитьЗаполнение() Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПроверитьФИОЗалогодателя() Тогда
			Возврат Ложь;
		КонецЕсли;	
		Если НЕ ПроверитьФИОЗалогодателя_А() Тогда
			Возврат Ложь;
		КонецЕсли;	
		Если НЕ ПроверитьДатуРождения()  Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПроверитьEmail()  Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПроверитьТелефоны()  Тогда
			Возврат Ложь;
		КонецЕсли;	
		Если НЕ ПроверитьЗаполнениеДокументов() Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПроверитьЗаполнениеАдресов() Тогда
			Возврат Ложь;
		КонецЕсли; 
		Если НЕ ПроверитьИсточникиИнформации() Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПроверитьАнкету() Тогда
			Возврат Ложь;
		КонецЕсли; 
		Если НЕ ПроверитьСотрудников() Тогда
			Возврат Ложь;
		КонецЕсли;  
	КонецЕсли;	
	
	//++ИвановВВ, проверка без сохранения
	Если Сохранять Тогда
		Если НЕ ЗначениеЗаполнено(Залогодатель) Тогда		
			Залогодатель = СоздатьЗалогодателя();
			СохранитьКарточкуЗалогодателя(Ложь);
		Иначе	
			ИзменитьЗалогодателя();
			СохранитьКарточкуЗалогодателя(); 
		КонецЕсли;
	КонецЕсли;
	//--ИвановВВ
	
	
	//проверим включение клиента в перечни
	Если ДатаСмерти = Дата(1,1,1) Тогда  
		//Если ПричинаИзменения = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.НоваяКарточка Тогда
		Дата = ТекущаяДатаСеанса();
		//+МАН 18.11.25
		СтруктураПроверки = ПроверитьСовпадениеСПеречнями();
		//-МАН
		//ЛБ_УправлениеЛомбардом.ПроверкаКлиентаПоПеречням(Дата, Залогодатель); //Выполняется проверка по всем перечням и ДУЛ
		Дата = ТекущаяДатаСеанса();
		ПроверитьПоПеречням()
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Процедура ПроверитьНаСотрудника(ДокКарточка)
	Если ЭтотОбъект.ДокументыЗалогодателя.Количество() > 0 Тогда
		Для каждого БСтрока из ЭтотОбъект.ДокументыЗалогодателя Цикл
			
			
			Запрос0 = Новый Запрос;
			Запрос0.Текст = "ВЫБРАТЬ
			|	ЛБ_Сотрудники.Ссылка КАК Сотрудник,
			|	ЛБ_Сотрудники.ФизическоеЛицо.СерияДокумента КАК ФизическоеЛицоСерияДокумента,
			|	ЛБ_Сотрудники.ФизическоеЛицо.НомерДокумента КАК ФизическоеЛицоНомерДокумента
			|ИЗ
			|	Справочник.ЛБ_Сотрудники КАК ЛБ_Сотрудники
			|ГДЕ
			|	ЛБ_Сотрудники.ФизическоеЛицо.СерияДокумента = &СерияДокумента
			|	И ЛБ_Сотрудники.ФизическоеЛицо.НомерДокумента = &НомерДокумента";
			Запрос0.УстановитьПараметр("СерияДокумента", БСтрока.ДокументСерия);
			Запрос0.УстановитьПараметр("НомерДокумента", БСтрока.ДокументНомер); 
			
			Выборка = Запрос0.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
					Для каждого строчка из ЭтотОбъект.ТаблицаДопСтатусов Цикл
						Если строчка.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник Тогда
							строчка.Используется = Истина;   
						КонецЕсли;
					КонецЦикла; 
				КонецЕсли;
			КонецЕсли;  
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя.Владелец КАК Клиент,
	|	ЛБ_ДокументыЗалогодателей.ДокументСерия КАК ДокументСерия,
	|	ЛБ_ДокументыЗалогодателей.ДокументНомер КАК ДокументНомер,
	|	ВложенныйЗапрос.СерияДокумента КАК СерияДокумента,
	|	ВложенныйЗапрос.НомерДокумента КАК НомерДокумента,
	|	ВложенныйЗапрос.Ссылка КАК Сотрудник
	|ИЗ
	|	РегистрСведений.ЛБ_ДокументыЗалогодателей КАК ЛБ_ДокументыЗалогодателей
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЛБ_Сотрудники.ФизическоеЛицо.СерияДокумента КАК СерияДокумента,
	|			ЛБ_Сотрудники.ФизическоеЛицо.НомерДокумента КАК НомерДокумента,
	|			ЛБ_Сотрудники.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.ЛБ_Сотрудники КАК ЛБ_Сотрудники) КАК ВложенныйЗапрос
	|		ПО ЛБ_ДокументыЗалогодателей.ДокументСерия = ВложенныйЗапрос.СерияДокумента
	|			И ЛБ_ДокументыЗалогодателей.ДокументНомер = ВложенныйЗапрос.НомерДокумента
	|ГДЕ
	|	ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", ДокКарточка.Залогодатель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Сотрудник) Тогда 
			ЕстьСтатус = Ложь;
			Для каждого строчка из ДокКарточка.ДополнительныеСтатусы Цикл
				Если строчка.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник Тогда
					ЕстьСтатус = Истина;   
				КонецЕсли;
			КонецЦикла;
			Если НЕ ЕстьСтатус Тогда
				НовСтрока = ДокКарточка.ДополнительныеСтатусы.Добавить();
				НовСтрока.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник;
				НовСтрока.Используется = Истина;
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


