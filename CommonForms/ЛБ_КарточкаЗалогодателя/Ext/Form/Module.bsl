	НовыйДок.МестоРождения = МестоРождения;
	НовыйДок.МестоРожденияСтрана = МестоРожденияСтрана;
	НовыйДок.МестоРожденияОбласть = МестоРожденияОбласть;
	НовыйДок.МестоРожденияРайон = МестоРожденияРайон;
	НовыйДок.МестоРожденияНаселенныйПункт = МестоРожденияНаселенныйПункт;
	НовыйДок.Пол = Пол;
	НовыйДок.ПочтовыйАдрес = ПочтовыйАдрес;
