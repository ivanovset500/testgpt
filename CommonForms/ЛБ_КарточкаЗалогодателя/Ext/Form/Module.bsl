Процедура СохранитьКарточкуЗалогодателя(Проверять = Истина)
	
	ЕстьИзменения = Ложь;
	НовыйДок = Документы.ЛБ_КарточкаЗалогодателя.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДата();
