&НаКлиенте
Процедура ДатаРожденияПриИзменении(Элемент)
	ВозрастЗалогодателя = ВычислитьВозвратЗалогодателя();
	ОписаниеВ = ЛБ_ОбщегоНазначения.ОписаниеВозраста(ВозрастЗалогодателя);
	Элементы.ДекорацияВозраст.Заголовок = "Возраст " + Строка(ВозрастЗалогодателя) + " " + ОписаниеВ;
	
	ПроверитьДатуРождения(ВозрастЗалогодателя);
	ПроверитьСтатусПочетный();
	ПроверитьДействительностьДокументов(); 
	ЭтаФорма.ОбновитьОтображениеДанных();
	
	// ++ Сербаев 15.05.2023 
	Модифицированность = Истина;
	
	Если Не ПустаяСтрока(Фамилия) И Не ПустаяСтрока(Имя) Тогда
		СтруктураПоиска = ПроверитьОднофамильцев();
		
		Если СтруктураПоиска.ЕстьСовпадения Тогда 
			ПоказатьОднофамильцев(СтруктураПоиска.СписокЗалогодателей, СтруктураПоиска.ДанныеЗалогодателей);
		КонецЕсли;
		
		Если Не ОшибкаВОтчестве Тогда
			УстановитьДоступностьЭлементовПриСозданииКлиента(Истина);
		КонецЕсли;
		
	КонецЕсли;
	// -- Сербаев 15.05.2023
	
КонецПроцедуры

