&НаКлиенте
Перем ЗначенияРеквизитовКонтактныеДанные; 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	Дата = ТекущаяДата();
	//+МАН 18.09.25 Закомментировал по проьбе Марии
	//Если Параметры.Свойство("ЗакрыватьПриСохранении") Тогда
	//	ЗакрыватьПриСохранении = Истина; 
	//	Элементы.ФормаКнопкаЗаписать.Видимость = Ложь;
	//Иначе
	//	ЗакрыватьПриСохранении = Ложь; 
	//	Элементы.ФормаКнопкаЗаписать.Видимость = Истина;
	//КонецЕсли;
	//
	Если Параметры.Свойство("ТолькоПечатьАнкеты") Тогда
		ТолькоПечатьАнкеты = Истина;
	КонецЕсли;	
	Если Параметры.Свойство("Залогодатель") Тогда
		Залогодатель = Параметры.Залогодатель;
		Если Параметры.Свойство("Дата") Тогда 
			Дата = Параметры.Дата;
		КонецЕсли;	 
		//заполняем конт. информацию и документы
		ЗаполнитьКонтактнуюИнформацию();
		ЗаполнитьДокументы();  
		ЗаполнитьАнкету();  	
		ЗаполнитьТаблицуДоверенностей();
		ДатаГражданство = ОпределитьДатуГражданство(); 
		Если НЕ ПустаяСтрока(ИсточникПроисхожденияИмуществаИной) Тогда
			ИнойИсточникИмущества = Истина;
		КонецЕсли;	
		Если НЕ ПустаяСтрока(ИсточникПроисхожденияДенежныхСредствИной) Тогда
			ИнойИсточникДС = Истина;
		КонецЕсли;  
		ПроверкаКарточкаЗагружена();
		ПолучитьДатыНачалаОкончанияРаботыСКлиентом();
		ПолучитьДатуПоследнегоОбновленияАнкеты();
		Если АнкетаОбновлена = Дата(1,1,1) Тогда
			Элементы.ДекорацияИзменениеАнкеты.Видимость = Ложь;
		Иначе
			Элементы.ДекорацияИзменениеАнкеты.Заголовок = "Последнее обновление анкеты " + Формат(АнкетаОбновлена, "ДФ=dd.MM.yyyy");
		КонецЕсли;	
		Если Параметры.Свойство("ТолькоПросмотр") Тогда
			Элементы.ФормаКнопкаЗаписатьИЗакрыть.Доступность = ложь; 
			Элементы.ФормаКнопкаЗаписать.Доступность = ложь;
			Элементы.ГруппаФИО.Доступность = ложь;  
			Элементы.ГруппаКомментарий.Доступность = Ложь;
			Элементы.ГруппаКонтактнаяИнформация.Доступность = ложь;
			Элементы.ГруппаАдреса.Доступность = ложь;
			Элементы.ГруппаФИО_Англ.Доступность = ложь;
			Элементы.Гражданство.Доступность = ложь;
			Элементы.ДокументыГруппаДобавить.ТолькоПросмотр = Истина; 
			Элементы.ДокументыГруппаДобавить.Доступность = Ложь;
			Элементы.ГруппаФЛ.Доступность = ложь;  
			Элементы.ГруппаФЛ1.Доступность = ложь;
			Элементы.ГруппаАнкетаДоп.Доступность = ложь;
			//Элементы.ЗалогодательБенефициарныйВладелец.Доступность = Ложь;   
			Элементы.ГруппаВладельцы.Доступность = Ложь; 
			Элементы.ГруппаИПДЛ.Доступность = ложь;
			Элементы.ГруппаДЛПМО_РДПЛ.Доступность = ложь; 
			Элементы.ГруппаОтказ.Доступность = ложь; 
			Элементы.ТаблицаДопСтатусов.ТолькоПросмотр = Истина; 
			Элементы.ТаблицаСлужебныхСтатусов.ТолькоПросмотр = Истина;
			Элементы.ФормаКнопкаРедактировать.Видимость = Истина; 
			Если Параметры.Свойство("НеРедактировать") Тогда
				Элементы.ФормаКнопкаРедактировать.Доступность = Ложь;
				Элементы.ФормаКнопкаИстория.Доступность = Ложь;
			КонецЕсли;     
		КонецЕсли;	
		//+МАН 18.11.25
		СтруктураПроверки = ПроверитьСовпадениеСПеречнями();
		//-МАН
		ПроверитьПоПеречням(); 
		ЗаполнитьДатыПроверкиПеречней();
		ЗаполнитьТаблицуОтказов();  
		СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(Дата, Залогодатель);
		СогласиеНаСМСРассылку = ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(Дата, Залогодатель);
		//Иванов 06.2025 видимость кнопки ЭДО, согласия, контактные данные 
		Элементы.ЭДО.Доступность = Истина;
		Элементы.ЭДО.ТолькоПросмотр = Ложь;
		
		Элементы.Согласие.Доступность = Истина;
		Элементы.Согласие.ТолькоПросмотр = Ложь;
		
		Элементы.КонтактныеДанные.Доступность = Истина;
		Элементы.КонтактныеДанные.ТолькоПросмотр = Ложь;
		//
	Иначе
		ПричинаИзменения = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.НоваяКарточка;
		ТипФизЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		КатегорииФизЛица = СокрЛП(Перечисления.ЛБ_КатегорииФизЛица.Клиент);
		ХарактерОтношений = "Получение краткосрочного займа под залог ювелирных изделий на потребительские нужды";
		ФинансовоеПоложениеСтабильное = Истина;
		ДеловаяРепутацияПоложительная = Истина;  
		УровеньРиска = "Низкий, отсутствуют критерии повышенного риска"; 
		ЗалогодательБенефициарныйВладелец = Истина; 
		ДатаОформленияАнкеты = ТекущаяДата();   		
		ДатаГражданство = ТекущаяДата(); 
		Элементы.ИсточникПроисхожденияИмуществаИной.РедактированиеТекста = ложь; 
		Элементы.ИсточникПроисхожденияДенежныхСредствИной.РедактированиеТекста = ложь;  
		Элементы.ДекорацияИзменениеАнкеты.Видимость = Ложь;  
		Элементы.ДекорацияОбновленияАнкеты.Видимость = Ложь; 
		ЭтоНовыйКлиент = Истина; 
		СтатусЗалогодателя = Справочники.ЛБ_СтатусыЗалогодателей.Сверхновый;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Гражданство) Тогда
		Гражданство = Справочники.СтраныМира.Россия;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ТипФизЛица) Тогда
		ТипФизЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	КонецЕсли;	
	Если НЕ ДатаРождения = Дата(1,1,1)  Тогда
		ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
		ОписаниеВ = ЛБ_ОбщегоНазначения.ОписаниеВозраста(ВозрастЗалогодателя);
		Элементы.ДекорацияВозраст.Заголовок = "Возраст " + Строка(ВозрастЗалогодателя) + " " + ОписаниеВ;
	КонецЕсли;		
	Если НЕ ТаблицаДоверенностейПредставитель.Количество() = 0 Тогда
		Элементы.ГруппаЯвляетсяПредставителемКлиентов.Показать();
	КонецЕсли;  
	Если НЕ ТаблицаДоверенностей.Количество() = 0 Тогда
		Элементы.ГруппаДанныеПредставителя.Показать();
	КонецЕсли;
	Если ЯвляетсяИПДЛ Тогда
		Элементы.ГруппаИПДЛРасшифровка.Видимость = Истина;
	КонецЕсли;	
	Если ЯвляетсяДЛПМО_РДПЛ Тогда
		Элементы.ГруппаДЛПМО_РДПЛРасшифровка.Видимость = Истина;
	КонецЕсли;  
	Если НЕ РазрешениеИПДЛ Тогда
		Элементы.ОтветственноеЛицоИПДЛ.Видимость =ложь;
	КонецЕсли;	
	Если НЕ РазрешениеДЛПМО_РДПЛ Тогда
		Элементы.ОтветственноеЛицоДЛПМО_РДПЛ.Видимость =ложь;
	КонецЕсли;	
	Если ЗалогодательБенефициарныйВладелец Тогда
		Элементы.ГруппаБенефициары.Скрыть();
		Элементы.ГруппаБенефициары.Доступность = ложь;
	Иначе	
		Элементы.ГруппаБенефициары.Показать(); 
		Элементы.ГруппаБенефициары.Доступность = Истина;
	КонецЕсли;	    
	Если ОтказОпераций Тогда 
		ОтказОпераций = Ложь;
		ПричинаОтказа = "";
		ДатаОтказа = Дата(1,1,1);
		Элементы.ГруппаПричинаОтказа.Видимость = Ложь;
	КонецЕсли;	
	ПроверитьДействительностьДокументов();
	
	СписокВыбораСтран = ЗаполнитьСписокВыбораСтран();
	Для каждого Эл Из СписокВыбораСтран Цикл
		Элементы.Гражданство.СписокВыбора.Добавить(Эл.Значение);
	КонецЦикла;	
	Элементы.ДекорацияГражданство.Заголовок = " Действует с " + Формат(ДатаГражданство, "ДФ=dd.MM.yyyy");  
	ГражданствоТекущее = Гражданство; 
	ЗаполнитьТаблицуВыбораДопСтатусовКлиента();  
	ЗаполнитьТаблицуВыбораСлужебныхСтатусовКлиента();  
	
	// ++ Сербаев 11.05.2023
	Если Фамилия = "" Тогда
		//Элементы.Имя.РедактированиеТекста       = Ложь;
		//Элементы.Отчество.РедактированиеТекста  = Ложь;
		Элементы.Имя.Доступность                = Ложь;
		Элементы.Отчество.Доступность           = Ложь;
		Элементы.СтраницаКИ.Доступность         = Ложь;
		Элементы.СтраницаАнкета.Доступность     = Ложь;
		Элементы.СтраницаДопСтатусы.Доступность = Ложь;  
		Элементы.СтраницаЗБ.Доступность         = Ложь;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Гражданство) Тогда
		ПоказатьРезиденство();
	КонецЕсли;    
	
	Если НЕ ДатаСмерти = Дата(1,1,1) тогда
		Элементы.ДекорацияИнформацияОСмерти.Заголовок = "Клиент умер. Дата смерти " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy"); 
		Элементы.ГруппаСтатус.Видимость = Истина;
	Иначе 
		Элементы.ДекорацияИнформацияОСмерти.Заголовок = ""; 
		Элементы.ГруппаСтатус.Видимость = Ложь;
	КонецЕсли;	
	
	Элементы.ТелефонКонтактногоЛица.КнопкаВыбора = Ложь;
	Элементы.ТелефонДополнительный.КнопкаВыбора  = Ложь;
	Элементы.Телефон.КнопкаВыбора                = Ложь; 
	
	//Если Гражданство <> Справочники.СтраныМира.Россия Тогда
	//    Если ПустаяСтрока(Элементы.Фамилия_А) Тогда
	//	    Элементы.Имя_А.Доступность      = Ложь;
	//		Элементы.Отчество_А.Доступность = Ложь;
	//	КонецЕсли;
	//КонецЕсли;
	// -- Сербаев 11.05.2023 
	
	УстановитьСписокПечатныхФорм();  
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	//+МАН 12.03.26 Убрал. Заявка 3654
	////+МАН 17.11.25 Ответственный ломбард изменялся на тот кто отредактировал карточку. Этого не должно быть т.к. это поле фиксирует, то где карточка была создана.
	//ЛомбардСозданияКарточки = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
	//
	//Если ЗначениеЗаполнено(Залогодатель) Тогда
	//	ЛомбардСозданияКарточки = ПроверитьЛомбардСоздания(Залогодатель);
	//КонецЕсли;
	////-МАН
	//-МАН
	
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Ответственный = ТекПользователь;
		//+МАН 12.03.26 Убрал. Заявка 3654
		////+МАН 17.11.25 Добавил проверку
		//Если НЕ ЗначениеЗаполнено(ЛомбардСозданияКарточки) Тогда
			ОтветственныйЛомбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		//Иначе
		//	ОтветственныйЛомбард = ЛомбардСозданияКарточки;
		//КонецЕсли;
		////-МАН
		//-МАН
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник; 
		//+МАН 12.03.26 Убрал. Заявка 3654
		////+МАН 17.11.25 Добавил проверку
		//Если НЕ ЗначениеЗаполнено(ЛомбардСозданияКарточки) Тогда
			ОтветственныйЛомбард = ПараметрыСеанса.ТекущийЛомбард;	//+++ МоисеевЕС 20250526
		//Иначе
		//	ОтветственныйЛомбард = ЛомбардСозданияКарточки;
		//КонецЕсли;
		////-МАН
		//-МАН
	КонецЕсли;  
	
	Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
		СотрудникЦО = Истина;
	КонецЕсли;
	
	//++ИВВ 04.2026, ТЗ отзыв на обработку ПДн сотрудником ЦО
	Если СотрудникЦО Тогда
		Элементы.ФормаОтзывСогласияНаОбработкуПД_ЦО.Видимость = Истина;
	КонецЕсли;	
	//--ИВВ
КонецПроцедуры  

&НаСервере
Процедура ПроверкаКарточкаЗагружена()  
	ЗапросК = новый Запрос;  
	ЗапросК.УстановитьПараметр("Залогодатель", Залогодатель);
	ЗапросК.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛБ_КонтактнаяИнформацияЗалогодателей.ПричинаИзменения КАК ПричинаИзменения
	|ИЗ
	|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей КАК ЛБ_КонтактнаяИнформацияЗалогодателей
	|ГДЕ
	|	ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель = &Залогодатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КонтактнаяИнформацияЗалогодателей.Период";
	ВыборкаК = ЗапросК.Выполнить().Выбрать();
	Если ВыборкаК.Следующий() Тогда  
		Если ВыборкаК.ПричинаИзменения = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ЗагрузкаИзДругойБазы тогда 
			КарточкаЗагружена = Истина;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуВыбораДопСтатусовКлиента() 		
	Запрос = Новый Запрос;  
	//+Мельников 25.09.24 Отдельная проверка и отметка ВИПа. ВИП. Заявка 2792.
	//Было: Запрос.УстановитьПараметр("Почетный", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
	МассивСтатусов = Новый Массив;
	//+МАН 20.11.25 Изменил т.к. ни как больше не проверялся статус "Почетный" кроме как по возрасту
	//МассивСтатусов.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
	//-МАН
	МассивСтатусов.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.VIP);
	
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	//-Мельников
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СтатусыЗалогодателей.Ссылка КАК Статус
	|ИЗ
	|	Справочник.ЛБ_СтатусыЗалогодателей КАК ЛБ_СтатусыЗалогодателей
	|ГДЕ
	|	ЛБ_СтатусыЗалогодателей.ПометкаУдаления = ЛОЖЬ
	|	И ЛБ_СтатусыЗалогодателей.ЭтоГруппа = ЛОЖЬ
	|	И ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную = ИСТИНА
	//+Мельников 25.09.24 Убрал ВИПов из результата запроса. ВИП. Заявка 2792.
	//Было: |	И НЕ ЛБ_СтатусыЗалогодателей.Ссылка = &Почетный
	|	И НЕ ЛБ_СтатусыЗалогодателей.Ссылка В (&Статусы)
	//-Мельников
	|АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаДопСтатусов.Загрузить(ТаблицаЗапроса);   

	//+МАН 20.11.25 Изменил т.к. ни как больше не проверялся статус "Почетный" кроме как по возрасту.
	//Если установить  ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную в положение ИСТИНА тогда отображется двумя строками в истории изменения.
	Новаястр = ТаблицаДопСтатусов.Добавить();
	НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
	НоваяСтр.Используется = Ложь;
	НоваяСтр.ТолькоПросмотр = Истина;
	//-МАН

	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется,
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.СрокДействия КАК СрокДействия,
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	|			&Дата,
	|			Залогодатель = &Залогодатель
	|				И Статус = &Статус) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Период УБЫВ";
	Для каждого Стр Из ТаблицаДопСтатусов Цикл 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется;
			Если Выборка.Используется Тогда  
				Если ЗначениеЗаполнено(Выборка.СрокДействия) Тогда
					Если Выборка.СрокДействия >= НачалоДня(Этаформа.Дата) Тогда
						Стр.СрокДействия = Выборка.СрокДействия; 
						Стр.Комментарий = Выборка.Комментарий; 
					Иначе
						Стр.Используется = Ложь;
					КонецЕсли;    
				Иначе   
					Если Выборка.статус = ПредопределенноеЗначение("Справочник.ЛБ_СтатусыЗалогодателей.Сотрудник") Тогда
						Стр.Комментарий = ПолучитьСписокСотрудников();
					Иначе	
						Стр.Комментарий = Выборка.Комментарий;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);  
		Если СтрокиС.Количество() = 0 Тогда
			Новаястр = ТаблицаДопСтатусов.Добавить();
			НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
			НоваяСтр.Используется = Истина;   
			НоваяСтр.ТолькоПросмотр = Истина; 
		Иначе    
			СтрС = строкиС.Получить(0); 
			СтрС.Используется = Истина;
		КонецЕсли;	
	//+МАН 20.11.25 Убрал. Проверка на "Почетный" будет выше
	//	//+Мельников 25.09.24 Для красоты отобразим статус без галки "Используется". ВИП. Заявка 2792.
	//	//Было: КонецЕсли;
	//Иначе
	//	Новаястр = ТаблицаДопСтатусов.Добавить();
	//	НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
	//	НоваяСтр.Используется = Ложь;
	//	НоваяСтр.ТолькоПросмотр = Истина;
	//КонецЕсли;
	////-Мельников
	КонецЕсли;
	//-МАН
	
	//+Мельников 25.09.24 Добавляем и проверяем статус ВИП. ВИП. Заявка 2792.
	СтатусВИП = ПроверитьСтатусКлиентаВИП(Дата, Залогодатель); //, Справочники.ЛБ_СтатусыЗалогодателей.VIP);
	Если СтатусВИП.Используется Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.VIP);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если СтрокиС.Количество() = 0 Тогда
			Новаястр = ТаблицаДопСтатусов.Добавить();
			НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.VIP;
			НоваяСтр.Используется = СтатусВИП.Используется;
			НоваяСтр.СрокДействия = СтатусВИП.СрокДействия;
			НоваяСтр.Комментарий = СтатусВИП.Комментарий;
			НоваяСтр.ТолькоПросмотр = Истина;
		Иначе
			СтрС = строкиС.Получить(0);
			СтрС.Используется = СтатусВИП.Используется;
			СтрС.СрокДействия = СтатусВИП.СрокДействия;
			СтрС.Комментарий = СтатусВИП.Комментарий;
			СтрС.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе
		Новаястр = ТаблицаДопСтатусов.Добавить();
		НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.VIP;
		НоваяСтр.Используется = СтатусВИП.Используется;
		НоваяСтр.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ТаблицаДопСтатусов.Сортировать("Статус Возр");
	//-Мельников
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	|	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		
		СтрокиД = ДокументыЗалогодателя.НайтиСтроки(Отбор); 
		Если НЕ СтрокиД.Количество() = 0 тогда			
			СтрД = строкиД.Получить(0);  
			Если СтрД.ДокументНеДействителен Тогда
				Продолжить;				
			ИначеЕсли НЕ (СтрД.ДокументСрокДействия = Дата(1,1,1)) Тогда
				Если СтрД.ДокументСрокДействия < НачалоДня(Дата) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтатусЛояльности = ЛБ_УправлениеЛомбардом.ПолучитьСтатусПоСистемеЛояльности(Дата, Выборка.статус);
			Если НЕ СтатусЛояльности = неопределено Тогда 
				Отбор = Новый Структура;
				Отбор.Вставить("Статус", СтатусЛояльности);
				Если ТаблицаДопСтатусов.НайтиСтроки(Отбор).Количество() = 0 Тогда
					Новаястр = ТаблицаДопСтатусов.Добавить();
					НоваяСтр.Статус = СтатусЛояльности;
					НоваяСтр.Используется = Истина; 
					НоваяСтр.ТолькоПросмотр = Истина;
					НоваяСтр.СрокДействия = СтрД.ДокументСрокДействия; 
				Иначе
					//+МАН 31.01.25 Закомментировал. Ранее выставляется статус. Заявка 2792
					//ТаблицаДопСтатусов.Получить(0).Используется = Истина; 
					//-МАН
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	Конеццикла;	
КонецПроцедуры        

&НаСервере
Процедура ЗаполнитьТаблицуВыбораСлужебныхСтатусовКлиента() 		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СлужебныеСтатусы.Ссылка КАК Статус
	|ИЗ
	|	Справочник.ЛБ_СлужебныеСтатусыКлиентов КАК СлужебныеСтатусы
	|ГДЕ
	|	СлужебныеСтатусы.ПометкаУдаления = ЛОЖЬ
	|АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаСлужебныхСтатусов.Загрузить(ТаблицаЗапроса); 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Статус КАК Статус,
	|	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется,
	|	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(
	|			&Дата,
	|			Залогодатель = &Залогодатель
	|				И Статус = &Статус) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
	Для каждого Стр Из ТаблицаСлужебныхСтатусов Цикл 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется;
			Стр.Комментарий = Выборка.Комментарий;
		КонецЕсли;	
	КонецЦикла;	   
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьСтатусПочетный() 
	ЕстьПочетный = Ложь;
	Отбор = Новый Структура;
	Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
	СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
	Если НЕ СтрокиС.Количество() = 0 Тогда
		Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда 
			СтрокиС.Получить(0).Используется = Истина;
			ЕстьПочетный = Истина;
		Иначе
			СтрокиС.Получить(0).Используется = Ложь;
		КонецЕсли; 
	ИначеЕсли ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		Если ТаблицаДопСтатусов.НайтиСтроки(Отбор).Количество() = 0 Тогда
			Новаястр = ТаблицаДопСтатусов.Добавить();
			НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
			НоваяСтр.Используется = Истина;  
		Иначе       
			НоваяСтр = ТаблицаДопСтатусов.Получить(0);
			НоваяСтр.Используется = Истина; 
			НоваяСтр.СрокДействия = Дата(1,1,1);
		КонецЕсли;	
		ЕстьПочетный = Истина;
	КонецЕсли;  
	
	Если ЕстьПочетный Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	|	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		
		СтрокиД = ДокументыЗалогодателя.НайтиСтроки(Отбор); 
		Для сч = 0 По СтрокиД.Количество()- 1 Цикл			
			СтрД = строкиД.Получить(сч);   
			Если СтрД.ДокументНеДействителен Тогда
				Продолжить;	
			ИначеЕсли НЕ (СтрД.ДокументСрокДействия = Дата(1,1,1)) Тогда
				Если СтрД.ДокументСрокДействия < НачалоДня(Дата) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтатусЛояльности = ЛБ_УправлениеЛомбардом.ПолучитьСтатусПоСистемеЛояльности(Дата, Выборка.статус);
			Если НЕ СтатусЛояльности = неопределено Тогда 
				Отбор = Новый Структура;
				Отбор.Вставить("Статус", СтатусЛояльности);
				СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
				Если СтрокиС.Количество() = 0 Тогда
					Новаястр = ТаблицаДопСтатусов.Добавить();
					НоваяСтр.Статус = СтатусЛояльности;
					НоваяСтр.Используется = Истина; 
					НоваяСтр.ТолькоПросмотр = Истина;
					НоваяСтр.СрокДействия = СтрД.ДокументСрокДействия;				
				Иначе
					СтрС = СтрокиС.Получить(0);  
					СтрС.СрокДействия = ?(СтрД.ДокументСрокДействия = Дата(1,1,1) Или СтрС.СрокДействия < СтрД.ДокументСрокДействия, СтрД.ДокументСрокДействия, СтрС.СрокДействия);
					СтрС.Используется = Истина;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
	Конеццикла;	
	
КонецПроцедуры 	

&НаСервере
Процедура ПроверитьПоПеречням()   
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
	Запрос.УстановитьПараметр("Дата", Дата); 	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	|	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК Статус
	|ИЗ
	|	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КлиентыВПеречняхСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаКомплаенсСтатусов.Очистить();
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.Террористы);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);  
	СтрК = ТаблицаКомплаенсСтатусов.Добавить();  
	СтрК.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы;
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			ПроверкаПереченьТеррористов = Истина;  
			Элементы.ПроверкаПереченьТеррористов.ЦветТекстаЗаголовка = WebЦвета.Красный;  
			Элементы.ПроверкаПереченьТеррористов.ЦветРамки = WebЦвета.Красный; 
			Элементы.КнопкаТеррористы.Доступность = Истина; 
			СтрК.Статус = "Террорист"; 
			СтрК.Включен = Истина;
			ПроверкаПереченьТеррористов = Истина;
		ИначеЕсли Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
			СтрК.Статус = "Исключен из перечня террористов"; 
			ПроверкаПереченьТеррористов = ложь;   
			//+МАН 21.10.25 Изменил т.к. с момента добавления кода, 02.09.24, на форме небыло элемента ПереченьТеррористов.
			//Элементы.ПереченьТеррористов.ЦветТекстаЗаголовка = WebЦвета.Черный; 
			//Элементы.ПереченьТеррористов.ЦветРамки = WebЦвета.СветлоСерый; 
			Элементы.ПроверкаПереченьТеррористов.ЦветТекстаЗаголовка = WebЦвета.Черный; 
			Элементы.ПроверкаПереченьТеррористов.ЦветРамки = WebЦвета.СветлоСерый; 
			//-МАН
		КонецЕсли;   
	Иначе
		СтрК.Статус = "Отсутствует в перечне террористов";
		ПроверкаПереченьТеррористов = ложь;
	КонецЕсли;
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.МВК);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	СтрК = ТаблицаКомплаенсСтатусов.Добавить();  
	СтрК.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК;
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			ПроверкаСписокМВК = Истина;  
			Элементы.ПроверкаСписокМВК.ЦветТекстаЗаголовка = WebЦвета.Красный; 
			Элементы.ПроверкаСписокМВК.ЦветРамки = WebЦвета.Красный; 
			Элементы.КнопкаМВК.Доступность = Истина; 
			СтрК.Статус = "Замороженный"; 
			СтрК.Включен = Истина;
			ПроверкаСписокМВК = Истина;
		ИначеЕсли Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
			СтрК.Статус = "Размороженный";	
			ПроверкаСписокМВК = Ложь; 
			Элементы.ПроверкаСписокМВК.ЦветТекстаЗаголовка = WebЦвета.Черный; 
			Элементы.ПроверкаСписокМВК.ЦветРамки = WebЦвета.СветлоСерый; 
		КонецЕсли;                        
	Иначе
		СтрК.Статус = "Отсутствует в перечне МВК";
		ПроверкаСписокМВК = Ложь;
	КонецЕсли;	
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	СтрК = ТаблицаКомплаенсСтатусов.Добавить();  
	СтрК.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ;
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			ПроверкаПереченьФРОМУ = Истина;    
			Элементы.ПроверкаПереченьФРОМУ.ЦветТекстаЗаголовка = WebЦвета.Красный; 
			Элементы.ПроверкаПереченьФРОМУ.ЦветРамки = WebЦвета.Красный; 
			Элементы.КнопкаФРОМУ.Доступность = Истина; 
			СтрК.Статус = "В перечне ФРОМУ"; 
			СтрК.Включен = Истина;
			ПроверкаПереченьФРОМУ = Истина;
		Иначе     
			СтрК.Статус = "Отсутствует в перечне ФРОМУ";
			ПроверкаПереченьФРОМУ = Ложь;
		КонецЕсли;  
	Иначе
		СтрК.Статус = "Отсутствует в перечне ФРОМУ"; 
		ПроверкаПереченьФРОМУ = Ложь; 
	КонецЕсли;     
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ООН);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	СтрК = ТаблицаКомплаенсСтатусов.Добавить();  
	СтрК.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН;
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			ПроверкаПереченьООН = Истина;    
			Элементы.ПроверкаПереченьООН.ЦветТекстаЗаголовка = WebЦвета.Красный; 
			Элементы.ПроверкаПереченьООН.ЦветРамки = WebЦвета.Красный; 
			Элементы.КнопкаООН.Доступность = Истина; 
			СтрК.Статус = "В перечне ООН";
			СтрК.Включен = Истина;
			ПроверкаПереченьООН = Истина;
		Иначе
			СтрК.Статус = "Отсутствует в перечне ООН";
			ПроверкаПереченьООН = Ложь;
		КонецЕсли;  
	Иначе
		СтрК.Статус = "Отсутствует в перечне ООН";
		ПроверкаПереченьООН = Ложь;
	КонецЕсли;
	
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ЦБ);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	СтрК = ТаблицаКомплаенсСтатусов.Добавить();  
	СтрК.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ЦБ;
	Если НЕ Строки.Количество() = 0 Тогда
		СтрК.Статус = "Присутствует в перечне ЦБ"; 
		СтрК.Включен = Истина;
	Иначе  
		СтрК.Статус = "Отсутствует в перечне ЦБ";
	КонецЕсли;	
КонецПроцедуры	    

&НаСервере
Процедура ЗаполнитьДатыПроверкиПеречней()   
	ДатаАнкеты = Дата(1,1,1);
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
	ВидыОперации = Новый СписокЗначений; 
	ВидыОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
	ВидыОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление);
	ВидыОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов);
	ВидыОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога);
	Запрос.УстановитьПараметр("ВидыОперации", ВидыОперации);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	НАЧАЛОПЕРИОДА(ЛБ_КарточкаЗалогодателя.Дата, ДЕНЬ) КАК Период
	|ИЗ
	|	Документ.ЛБ_КарточкаЗалогодателя КАК ЛБ_КарточкаЗалогодателя
	|ГДЕ
	|	ЛБ_КарточкаЗалогодателя.Проведен = ИСТИНА
	|	И ЛБ_КарточкаЗалогодателя.Залогодатель = &Залогодатель
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ЛБ_ОперацияПоЗалогу.Дата, ДЕНЬ)
	|ИЗ
	|	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	|ГДЕ
	|	ЛБ_ОперацияПоЗалогу.ВидОперации В(&ВидыОперации)
	|	И ЛБ_ОперацияПоЗалогу.Залогодатель = &Залогодатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();   
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда	
		ДатаАнкеты = ТаблицаЗапроса.Получить(0).Период;  
	КонецЕсли;   
	
	Запрос.Текст = "ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ЛБ_ДатыЗагрузкиПеречнейСрезПоследних.Период, ДЕНЬ) КАК Период,
	|	ЛБ_ДатыЗагрузкиПеречнейСрезПоследних.ВидПеречня КАК ВидПеречня
	|ИЗ
	|	РегистрСведений.ЛБ_ДатыЗагрузкиПеречней.СрезПоследних(&Дата, ) КАК ЛБ_ДатыЗагрузкиПеречнейСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидПеречня,
	|	Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.Террористы);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда 
		Элементы.ДекорацияТеррористы.Заголовок = ?(ДатаАнкеты = Дата(1,1,1), "", Формат(ДатаАнкеты, "ДФ=dd/MM/yyyy"));
	Иначе          
		Стр = Строки.Получить(0);
		ДатаПеречня = Стр.Период;
		ДатаПеречня = ?(ДатаАнкеты > ДатаПеречня, ДатаАнкеты, ДатаПеречня); 
		Элементы.ДекорацияТеррористы.Заголовок = Формат(ДатаПеречня, "ДФ=dd/MM/yyyy");
	КонецЕсли;	 
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.МВК);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда 
		Элементы.ДекорацияМВК.Заголовок = ?(ДатаАнкеты = Дата(1,1,1), "", Формат(ДатаАнкеты, "ДФ=dd/MM/yyyy"));
	Иначе                                 
		Стр = Строки.Получить(0);
		ДатаПеречня = Стр.Период;
		ДатаПеречня = ?(ДатаАнкеты > ДатаПеречня, ДатаАнкеты, ДатаПеречня); 
		Элементы.ДекорацияМВК.Заголовок = Формат(ДатаПеречня, "ДФ=dd/MM/yyyy");
	КонецЕсли;	
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда 
		Элементы.ДекорацияФРОМУ.Заголовок = ?(ДатаАнкеты = Дата(1,1,1), "", Формат(ДатаАнкеты, "ДФ=dd/MM/yyyy"));
	Иначе
		Стр = Строки.Получить(0);
		ДатаПеречня = Стр.Период;
		ДатаПеречня = ?(ДатаАнкеты > ДатаПеречня, ДатаАнкеты, ДатаПеречня); 
		Элементы.ДекорацияФРОМУ.Заголовок = Формат(ДатаПеречня, "ДФ=dd/MM/yyyy");
	КонецЕсли;	  
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ООН);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда 
		Элементы.ДекорацияООН.Заголовок = ?(ДатаАнкеты = Дата(1,1,1), "", Формат(ДатаАнкеты, "ДФ=dd/MM/yyyy"));
	Иначе          
		Стр = Строки.Получить(0);
		ДатаПеречня = Стр.Период;
		ДатаПеречня = ?(ДатаАнкеты > ДатаПеречня, ДатаАнкеты, ДатаПеречня); 
		Элементы.ДекорацияООН.Заголовок = Формат(ДатаПеречня, "ДФ=dd/MM/yyyy");
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуДоверенностей() 
	ЗапросД = Новый Запрос;
	ЗапросД.УстановитьПараметр("Клиент", Залогодатель); 
	ЗапросД.УстановитьПараметр("Дата", Дата);
	ЗапросД.УстановитьПараметр("СтатусДоверенности", Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	ЗапросД.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛБ_ДоверенностиСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.ВидДоверенности КАК ВидДоверенности,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.ПредставительКлиента КАК ПредставительКлиента,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.СерияДоверенности КАК СерияДоверенности,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.НомерДоверенности КАК НомерДоверенности,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.ДатаДоверенности КАК ДатаНачала,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.СрокДействияДоверенности КАК ДатаОкончания,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	|	ЛБ_ДоверенностиСрезПоследних.Период КАК Период,
	|	ИСТИНА КАК Действует,  
	|	ЛОЖЬ КАК Наследство,
	|	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	|ИЗ
	|	РегистрСведений.ЛБ_Доверенности.СрезПоследних(&Дата, Клиент = &Клиент) КАК ЛБ_ДоверенностиСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	ТаблицаД = ЗапросД.Выполнить().Выгрузить();
	Для каждого стрД из ТаблицаД цикл   
		Если СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			Если  СтрД.Доверенность.СрокДействияДоверенности >= НачалоДня(Дата) Тогда 
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.Клиент, Дата) = неопределено Тогда  
					СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверителя; 
					СтрД.Действует = Ложь;
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, Дата) = неопределено Тогда  
					СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверенногоЛица;
					СтрД.Действует = Ложь;					
				Иначе	
					СтрД.Действует = Истина;  
				КонецЕсли;	              
			ИначеЕсли СтрД.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
				СтрД.Наследство = Истина;
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, Дата) = неопределено Тогда  
					СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверенногоЛица;
					СтрД.Действует = Ложь;	
				Иначе   
					СтрД.Действует = Истина;
				КонецЕсли;	
			Иначе                         	
				СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДействиеПрекращено;
				СтрД.Действует = Ложь;
			КонецЕсли;  
		Иначе
			СтрД.Действует = Ложь;
			Если СтрД.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
				СтрД.Наследство = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
	ТаблицаД.Сортировать("Действует Убыв, Период Убыв");
	
	ТаблицаДоверенностей.Загрузить(ТаблицаД);  
	
	ЗапросД.УстановитьПараметр("Клиент", Залогодатель); 
	ЗапросД.УстановитьПараметр("Дата", Дата);
	ЗапросД.УстановитьПараметр("СтатусДоверенности", Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	ЗапросД.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛБ_ДоверенностиСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.ВидДоверенности КАК ВидДоверенности,
	|	ЛБ_ДоверенностиСрезПоследних.Клиент КАК Клиент,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.ДатаДоверенности КАК ДатаНачала,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.СрокДействияДоверенности КАК ДатаОкончания,
	|	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	|	ЛБ_ДоверенностиСрезПоследних.Период КАК Период,
	|	ИСТИНА КАК Действует,
	|	ЛОЖЬ КАК Наследство,
	|	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	|ИЗ
	|	РегистрСведений.ЛБ_Доверенности.СрезПоследних(&Дата, Доверенность.ПредставительКлиента = &Клиент) КАК ЛБ_ДоверенностиСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	|		ПО ЛБ_ДоверенностиСрезПоследних.Клиент = ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель"; 
	ТаблицаДП = ЗапросД.Выполнить().Выгрузить();  
	Для каждого стрД из ТаблицаДП цикл
		Если СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			Если  СтрД.Доверенность.СрокДействияДоверенности >= НачалоДня(Дата) Тогда 
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.Клиент, Дата) = неопределено Тогда  
					СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверителя; 
					СтрД.Действует = Ложь;
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, Дата) = неопределено Тогда  
					СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверенногоЛица;
					СтрД.Действует = Ложь;
				Иначе	
					СтрД.Действует = Истина;  
				КонецЕсли;	  
			ИначеЕсли СтрД.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда 
				СтрД.Наследство = Истина;
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, Дата) = неопределено Тогда  
					СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверенногоЛица;
					СтрД.Действует = Ложь;	
				Иначе   
					СтрД.Действует = Истина;
				КонецЕсли;		
			Иначе
				СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДействиеПрекращено;
				СтрД.Действует = Ложь;
			КонецЕсли;  
		Иначе
			СтрД.Действует = Ложь;  
			Если СтрД.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
				СтрД.Наследство = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
	ТаблицаДП.Сортировать("Действует Убыв, Период Убыв");
	ТаблицаДоверенностейПредставитель.Загрузить(ТаблицаДП);
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуОтказов()
	ЗапросА = Новый Запрос;
	ЗапросА.УстановитьПараметр("Залогодатель", Залогодатель); 
	ЗапросА.УстановитьПараметр("Дата", Дата);
	ЗапросА.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""Анкета"" КАК Вид,
	|	ОтказыКлиента.ДатаОтказа КАК ДатаОтказа,
	|	ОтказыКлиента.ПричинаОтказа КАК ПричинаОтказа,
	|	ОтказыКлиента.СуммаЗаймаОтказ КАК СуммаЗаймаОтказ,
	|	ОтказыКлиента.Ответственный КАК Ответственный
	|ИЗ
	|	РегистрСведений.ЛБ_ОтказыКлиентамВОбслуживании КАК ОтказыКлиента
	|ГДЕ
	|	ОтказыКлиента.Залогодатель = &Залогодатель
	|	И ОтказыКлиента.Период <= &Дата";
	ТаблицаЗапроса = ЗапросА.Выполнить().Выгрузить();  
	ТаблицаОтказов.Загрузить(ТаблицаЗапроса); 
	
	ЗапросА.Текст = "ВЫБРАТЬ
	|	""ЦБ"" КАК Вид,
	|	ЛБ_КлиентыВПеречнях.ДатаПеречня КАК ДатаПеречня,
	|	ЛБ_КлиентыВПеречнях.ДатаВключенияВПеречень КАК ДатаОтказа,
	|	ЛБ_КлиентыВПеречнях.КодОтказа КАК КодОтказа,
	|	ЛБ_КлиентыВПеречнях.Ответственный КАК Ответственный
	|ИЗ
	|	РегистрСведений.ЛБ_КлиентыВПеречнях КАК ЛБ_КлиентыВПеречнях
	|ГДЕ
	|	ЛБ_КлиентыВПеречнях.Залогодатель = &Залогодатель
	|	И ЛБ_КлиентыВПеречнях.ВидПеречня = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПеречней.ЦБ)
	|	И ЛБ_КлиентыВПеречнях.Период <= &Дата";
	ВыборкаА = ЗапросА.Выполнить().Выбрать();
	Пока ВыборкаА.Следующий() Цикл 
		СтрОтказ = ТаблицаОтказов.Добавить(); 
		СтрОтказ.Вид = ВыборкаА.Вид;   
		СтрОтказ.ДатаПеречня = ВыборкаА.ДатаПеречня;
		СтрОтказ.ДатаОтказа = ВыборкаА.ДатаОтказа; 
		СтрОтказ.КодОтказа = ВыборкаА.КодОтказа;           
		СтрОтказ.ПричинаОтказа  = "Код отказа " + СокрЛП(ВыборкаА.КодОтказа) + ", Дата списка " + Формат(ВыборкаА.ДатаПеречня, "ДФ=dd.MM.yyyy");
		СтрОтказ.Ответственный = ВыборкаА.Ответственный;
	КонецЦикла;	
	Если НЕ ТаблицаОтказов.Количество() = 0 Тогда  
		ТаблицаОтказов.Сортировать("ДатаПеречня, ДатаОтказа");
		Элементы.ГруппаОтказИстория.Показать();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокуПредставитель(Представитель)
	ЗапросП = Новый Запрос; 
	ЗапросП.УстановитьПараметр("Дата", Дата); 
	ЗапросП.УстановитьПараметр("Залогодатель", Представитель);
	ЗапросП.Текст = "ВЫБРАТЬ
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних"; 
	ВыборкаП = ЗапросП.Выполнить().Выбрать();
	Если ВыборкаП.Следующий() Тогда
		Возврат сокрЛП(Представитель) + ", дата рождения " + Формат(ВыборкаП.ДатаРождения, "ДФ=dd.MM.yyyy"); 
	КонецЕсли;
	Возврат сокрЛП(Представитель);	
КонецФункции

&НаСервере
Процедура ПолучитьДатыНачалаОкончанияРаботыСКлиентом() 
	РаботаНачата = Истина;
	ЭтоПредставитель = Ложь;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
	Запрос.УстановитьПараметр("Дата", Дата);
	Если КарточкаЗагружена Тогда
		ДатаНачалаРаботыСКлиентом = Формат(ДатаОформленияАнкеты, "ДФ=dd.MM.yyyy");
	Иначе 
		ДатаНачала = Дата(1,1,1);
		ВидыОпераций = новый СписокЗначений; 
		ВидыОпераций.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
		ВидыОпераций.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов);
		Запрос.УстановитьПараметр("ВидыОпераций", ВидыОпераций);
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_ОборотыПоОперациямЗайма.Период КАК Период,
		|	ЛБ_ОборотыПоОперациямЗайма.Регистратор КАК Регистратор,
		|	0 КАК Вид
		|ИЗ
		|	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
		|ГДЕ
		|	ЛБ_ОборотыПоОперациямЗайма.Регистратор.Залогодатель = &Залогодатель
		|	И ЛБ_ОборотыПоОперациямЗайма.ВидОперации В(&ВидыОпераций)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛБ_Доверенности.Период,
		|	ЛБ_Доверенности.Регистратор,
		|	1
		|ИЗ
		|	РегистрСведений.ЛБ_Доверенности КАК ЛБ_Доверенности
		|ГДЕ
		|	ЛБ_Доверенности.Доверенность.ПредставительКлиента = &Залогодатель
		|	И ЛБ_Доверенности.Период <= &Дата
		|	И ЛБ_Доверенности.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийДоверенность.Оформление)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Вид,
		|	Период";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда 
			Выборка = ТаблицаЗапроса.Получить(0);  
			Если Выборка.Вид = 1 Тогда
				ЭтоПредставитель = Истина;
			КонецЕсли;	
			ДатаНачалаРаботыСКлиентом = Формат(Выборка.Период, "ДФ=dd.MM.yyyy"); 
			Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") Тогда
				ДатаНачалаРаботыСКлиентом = ДатаНачалаРаботыСКлиентом + " (" + Строка(Выборка.Регистратор.ВидОперации) + ")";
			ИначеЕсли ЭтоПредставитель Тогда
				ДатаНачалаРаботыСКлиентом = ДатаНачалаРаботыСКлиентом + " (Оформление доверенности)";
			КонецЕсли;	
		Иначе	
			ДатаНачалаРаботыСКлиентом = "Работа не начата"; 
			РаботаНачата = Ложь;
		КонецЕсли;
	КонецЕсли;	  
	
	ДатаОкончанияРаботыСКлиентом = "";
	Если НЕ РаботаНачата Тогда		
		Возврат;
	КонецЕсли;	    
	
	Если НЕ ДатаСмерти = Дата(1,1,1) Тогда 
		ДатаОкончанияРаботыСКлиентом = "Работа прекращена " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy");
		Возврат;
	КонецЕсли;	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет.Залогодатель = &Залогодатель) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";   	
	Выборка = Запрос.Выполнить().Выбрать();
	ВсеОпреацииЗакрыты = Истина;    
	ДатаОкончания = Дата(1,1,1);
	Если НЕ Выборка.Количество()= 0 Тогда 			
		Пока Выборка.Следующий() Цикл  
			Если НЕ Выборка.СтатусЗалоговогоБилета = перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт И НЕ Выборка.СтатусЗалоговогоБилета = перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления Тогда 
				ВсеОпреацииЗакрыты = ложь; 
				Прервать;
			КонецЕсли;	 
			ДатаОкончания = Выборка.Период;			
		КонецЦикла;	              
		Если НЕ ВсеОпреацииЗакрыты Тогда  
			ДатаОкончанияРаботыСКлиентом = "Работа не прекращена";
			Возврат;
		КонецЕсли;	
	КонецЕсли;  
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛБ_ОборотыПоОперациямЗайма.Период КАК Период
	|ИЗ
	|	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	|ГДЕ
	|	ЛБ_ОборотыПоОперациямЗайма.Регистратор.Залогодатель = &Залогодатель
	|	И ЛБ_ОборотыПоОперациямЗайма.ВидОперации = Значение(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 	
		ДатаОкончания =?(ДатаОкончания < Выборка.Период, Выборка.Период, ДатаОкончания); 
	КонецЕсли;
	
	Если ЭтоПредставитель Тогда
		ДатаОкончанияДоверенностей = ЛБ_УправлениеЛомбардом.ПолучитьДатуОкончанияДоверенностейКлиента(Дата, Залогодатель); 
		Если НЕ ДатаОкончанияДоверенностей = неопределено Тогда  
			ДатаОкончания = ?(ДатаОкончания < ДатаОкончанияДоверенностей, ДатаОкончанияДоверенностей, ДатаОкончания);
		Иначе
			ДатаОкончанияРаботыСКлиентом = "Работа не прекращена";
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ДатаОкончания = Дата(1,1,1) Тогда	
		ДатаОкончанияРаботыСКлиентом = "Работа прекращена " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДатуПоследнегоОбновленияАнкеты()
	ЗапросА = Новый Запрос; 
	ЗапросА.УстановитьПараметр("Дата", Дата); 
	ЗапросА.УстановитьПараметр("Залогодатель", Залогодатель);
	ЗапросА.Текст = "ВЫБРАТЬ
	|	ЛБ_ДатыОбновленияАнкеты.ДатаАктуальности КАК ДатаАктуальности
	|ИЗ
	|	РегистрСведений.ЛБ_ДатыОбновленияАнкеты КАК ЛБ_ДатыОбновленияАнкеты
	|ГДЕ
	|	ЛБ_ДатыОбновленияАнкеты.Период <= &Дата
	|	И ЛБ_ДатыОбновленияАнкеты.Залогодатель = &Залогодатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_ДатыОбновленияАнкеты.Период УБЫВ";
	ТаблицаЗапроса = ЗапросА.Выполнить().Выгрузить();
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда 
		АнкетаОбновлена = ТаблицаЗапроса.Получить(0).ДатаАктуальности;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ОпределитьДатуГражданство()
	ДатаГ = ТекущаяДата();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КонтактнаяИнформацияЗалогодателей.Период КАК Период,
	|	ЛБ_КонтактнаяИнформацияЗалогодателей.Гражданство КАК Гражданство
	|ИЗ
	|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей КАК ЛБ_КонтактнаяИнформацияЗалогодателей
	|ГДЕ
	|	ЛБ_КонтактнаяИнформацияЗалогодателей.Период <= &Дата
	|	И ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель = &Залогодатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл            			
		Если Выборка.Гражданство = Гражданство Тогда
			ДатаГ = Выборка.Период;
		Иначе
			Прервать;
		КонецЕсли;	
	Конеццикла;
	Возврат ДатаГ;
КонецФункции

