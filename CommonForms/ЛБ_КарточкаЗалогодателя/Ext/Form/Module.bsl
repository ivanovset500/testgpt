Функция ПолучитьИсториюОбновленийАнкеты()
	Результат = Новый Структура;
	Результат.Вставить("ДатыОбновлений"); 
	Результат.Вставить("ОтветсвенныйАнкета");
	Результат.Вставить("ОтветсвенныйОбновление");
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	// ++ Сербаев 11.07.2023
	//Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Дата", Дата);
	//Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	//              |	ЛБ_ДатыОбновленияАнкеты.Период КАК Период,
	//              |	ЛБ_ДатыОбновленияАнкеты.Регистратор.Ответственный КАК Ответственный
	//              |ИЗ
	//              |	РегистрСведений.ЛБ_ДатыОбновленияАнкеты КАК ЛБ_ДатыОбновленияАнкеты
	//              |ГДЕ
	//              |	ЛБ_ДатыОбновленияАнкеты.Залогодатель = &Залогодатель
	//              |	И ЛБ_ДатыОбновленияАнкеты.Период <= &Дата
	//              |
	//              |УПОРЯДОЧИТЬ ПО 
	//              |	Период УБЫВ"; 
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(ЛБ_ДатыОбновленияАнкеты.Период) КАК Период,
	|	НАЧАЛОПЕРИОДА(ЛБ_ДатыОбновленияАнкеты.Период, ДЕНЬ) КАК НачалоДня
	|ПОМЕСТИТЬ ВТ_ВремяПоследнегоИзмененияВДень
	|ИЗ
	|	РегистрСведений.ЛБ_ДатыОбновленияАнкеты КАК ЛБ_ДатыОбновленияАнкеты
	|ГДЕ
	|	ЛБ_ДатыОбновленияАнкеты.Залогодатель = &Залогодатель
	|	И ЛБ_ДатыОбновленияАнкеты.Период <= &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ЛБ_ДатыОбновленияАнкеты.Период, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВремяПоследнегоИзмененияВДень.Период КАК Период,
	|	ВТ_ВремяПоследнегоИзмененияВДень.НачалоДня КАК НачалоДня,
	|	ЛБ_ДатыОбновленияАнкеты.Регистратор.Ответственный КАК РегистраторОтветственный
	|ПОМЕСТИТЬ ВТ_ДанныеДляГруппировки
	|ИЗ
	|	ВТ_ВремяПоследнегоИзмененияВДень КАК ВТ_ВремяПоследнегоИзмененияВДень
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДатыОбновленияАнкеты КАК ЛБ_ДатыОбновленияАнкеты
	|		ПО ВТ_ВремяПоследнегоИзмененияВДень.Период = ЛБ_ДатыОбновленияАнкеты.Период
	|ГДЕ
	|	ЛБ_ДатыОбновленияАнкеты.Период <= &Дата
	|	И ЛБ_ДатыОбновленияАнкеты.Залогодатель = &Залогодатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДляГруппировки.Период КАК Период,
	|	ВТ_ДанныеДляГруппировки.РегистраторОтветственный КАК Ответственный
	|ИЗ
	|	ВТ_ДанныеДляГруппировки КАК ВТ_ДанныеДляГруппировки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеДляГруппировки.Период,
	|	ВТ_ДанныеДляГруппировки.РегистраторОтветственный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	// -- Сербаев 11.07.2023
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();  
	ДатыОбновлений = "";
	Ном = 0; 
	СписокДат = новый СписокЗначений;
	Для каждого Стр Из ТаблицаЗапроса Цикл 
		Если Ном = 0 Тогда
			Ном = Ном + 1;
			Результат.ОтветсвенныйАнкета = стр.Ответственный; 
		Иначе
			Результат.ОтветсвенныйОбновление = стр.Ответственный;
		КонецЕсли;	   
		ДатаО = Формат(Стр.Период, "ДФ=dd.MM.yyyy");
		Если СписокДат.НайтиПоЗначению(ДатаО) = неопределено Тогда
			СписокДат.Добавить(ДатаО); 
		КонецЕсли;	
		//ДатыОбновлений = ДатыОбновлений + ?(ПустаяСтрока(ДатыОбновлений), "", ", ") + Формат(Стр.Период, "ДФ=dd.MM.yyyy");
	Конеццикла;	 
	Для каждого Элемент Из списокДат Цикл  
		ДатыОбновлений = ДатыОбновлений + ?(ПустаяСтрока(ДатыОбновлений), "", ", ") + Элемент.Значение;
	Конеццикла;	
	Результат.ДатыОбновлений = ДатыОбновлений;
	
	Возврат Результат;
КонецФункции 

