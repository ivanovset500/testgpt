&НаКлиенте
Процедура ФамилияПриИзменении(Элемент)
	
	Фамилия = СокрЛП(ТРег(Фамилия));
	Если СтрДлина(Фамилия) > 0 Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Фамилия, "Фамилия");
		Если ТекстОшибки <> "" Тогда
			ЛБ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Фамилия");
			Возврат;
		КонецЕсли; 
		
		// ++ Сербаев 07.06.2023
		//ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Фамилия);
		ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСерверРФ.ТолькоКириллицаВСтроке(Фамилия, , " -");
		// -- Сербаев 07.06.2023
		Если Не ТолькоКирилицаВСтроке Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Строка ""Фамилия"" должна содержать только символы кириллицы!'"), , , "Фамилия");
			Возврат;
		КонецЕсли;  
		
		Если Не ПустаяСтрока(Фамилия) Тогда	
			Элементы.Имя.Доступность = Истина;
		КонецЕсли; 
		
		Если Не ПустаяСтрока(Имя) И Не ДатаРождения = Дата(1, 1, 1) Тогда
			СтруктураПоиска = ПроверитьОднофамильцев();
			Если СтруктураПоиска.ЕстьСовпадения Тогда 
				ПоказатьОднофамильцев(СтруктураПоиска.СписокЗалогодателей, СтруктураПоиска.ДанныеЗалогодателей);
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли Фамилия = "" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Поле ""Фамилия"" не заполнено.'"), , , "Фамилия");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяПриИзменении(Элемент)
	
	Имя = СокрЛП(ТРег(Имя));
	Если СтрДлина(Имя) > 0 Тогда
		
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Имя, "Имя");
		Если ТекстОшибки <> "" Тогда
			ЛБ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Имя");
			Возврат;
		КонецЕсли;
		
		// ++ Сербаев 07.06.2023
		//ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Имя,," -");
		ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСерверРФ.ТолькоКириллицаВСтроке(Имя, , " -");
		// -- Сербаев 07.06.2023
		Если Не ТолькоКирилицаВСтроке Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Строка ""Имя"" должно содержать только символы кириллицы!'"), , , "Имя");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Имя = "" Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Поле ""Имя"" не заполнено.'"), , , "Имя");
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Имя) Тогда	
		
		Фамилия = ТРег(Фамилия);
		Если СтрДлина(Фамилия) > 0 Тогда
			
			ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Фамилия, "Фамилия");
			Если ТекстОшибки <> "" Тогда
				ЛБ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Фамилия");
				Возврат;
			КонецЕсли;
			
			// ++ Сербаев 07.06.2023
			//ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Фамилия);
			ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСерверРФ.ТолькоКириллицаВСтроке(Фамилия, , " -");
			// -- Сербаев 07.06.2023
			Если Не ТолькоКирилицаВСтроке Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Строка ""Фамилия"" должна содержать только символы кириллицы!'"), , , "Фамилия");
				Возврат;
			КонецЕсли;
			
			Если ДатаРождения = Дата(1, 1, 1) Тогда
				УстановитьДоступностьЭлементовПриСозданииКлиента(Ложь);
			КонецЕсли;
		ИначеЕсли Фамилия = "" Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Поле ""Фамилия"" не заполнено.'"), , , "Фамилия");
			Возврат; 	
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Не ПустаяСтрока(Имя) И Не ПустаяСтрока(Фамилия) И Не ДатаРождения = Дата(1, 1, 1) Тогда
		СтруктураПоиска = ПроверитьОднофамильцев();
		Если СтруктураПоиска.ЕстьСовпадения Тогда 
			ПоказатьОднофамильцев(СтруктураПоиска.СписокЗалогодателей, СтруктураПоиска.ДанныеЗалогодателей);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчествоПриИзменении(Элемент)
	Отчество = СокрЛП(ТРег(Отчество)); 
	
	ОшибкаВОтчестве = Ложь;
	Если СтрДлина(Отчество) > 0 Тогда
		
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Отчество, "Отчество");
		Если ТекстОшибки <> "" Тогда
			ЛБ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Отчество");
			ОшибкаВОтчестве = Истина;
			Возврат;
		КонецЕсли;    
		
		// ++ Сербаев 07.06.2023
		//ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Отчество);
		ТолькоКирилицаВСтроке = СтроковыеФункцииКлиентСерверРФ.ТолькоКириллицаВСтроке(Отчество, , " -");
		// -- Сербаев 07.06.2023
		Если Не ТолькоКирилицаВСтроке Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Строка ""Отчество"" должна содержать только символы кириллицы!'"), , , "Отчество"); 
			ОшибкаВОтчестве = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Не ОшибкаВОтчестве И ДатаРождения <> Дата(1, 1, 1) Тогда
		УстановитьДоступностьЭлементовПриСозданииКлиента(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьЗалогодателя()		
	НовыйОбъектСпр = Справочники.ЛБ_Залогодатели.СоздатьЭлемент();
	НовыйОбъектСпр.Фамилия = Фамилия;
	НовыйОбъектСпр.Имя = Имя;
	НовыйОбъектСпр.Отчество = Отчество;
	НовыйОбъектСпр.Наименование = СокрЛП(Фамилия) + " " + СокрЛП(Имя) + " " + СокрЛП(Отчество);
	//+МАН 10.10.25 Заполнить техническое наименование
	НовыйОбъектСпр.ТехническоеНаименование = ЛБ_ОбщийМодуль.СформироватьТехническоеНаименование(НовыйОбъектСпр.Наименование);
	//-МАН
	НовыйОбъектСпр.Записать();
	
	Возврат НовыйОбъектСпр.Ссылка; 
КонецФункции

&НаСервере
Процедура ИзменитьЗалогодателя()
	ОбъектСпр = Залогодатель.ПолучитьОбъект();
	Если НЕ (ОбъектСпр.Фамилия = Фамилия) ИЛИ НЕ (ОбъектСпр.Имя = Имя) ИЛИ НЕ (ОбъектСпр.Отчество = Отчество) Тогда
		ОбъектСпр.Фамилия = Фамилия;
		ОбъектСпр.Имя = Имя;
		ОбъектСпр.Отчество = Отчество;
		ОбъектСпр.Наименование = СокрЛП(Фамилия) + " " + СокрЛП(Имя) + " " + СокрЛП(Отчество);
		//+МАН 10.10.25 Заполнить техническое наименование
		ОбъектСпр.ТехническоеНаименование = ЛБ_ОбщийМодуль.СформироватьТехническоеНаименование(ОбъектСпр.Наименование);
		//-МАН
		ОбъектСпр.Записать();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораАдресаПоПрописке(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	АдресПоПропискеСтруктура = Результат.Значение;
	АдресПоПрописке = Результат.Представление;
	
	Если ФактическийСовпадает Тогда
		ФактическийАдрес = АдресПоПрописке;
		ФактическийАдресСтруктура = АдресПоПропискеСтруктура;
		ФактическийАдресВручную = АдресПоПропискеВручную;
	КонецЕсли;	
	Если ПочтовыйСовпадает Тогда
		ПочтовыйАдрес = АдресПоПрописке;
		ПочтовыйАдресСтруктура = АдресПоПропискеСтруктура;
		ПочтовыйАдресВручную = АдресПоПропискеВручную;
	КонецЕсли;
	УстановитьДоступность();
	
	Если ЗначениеЗаполнено(Залогодатель) тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВидАдреса", 0);
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораПричиныИзмененияАдресаПоПрописке",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПричинаИзмененияАдреса", ПараметрыФормы, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВыбораПричиныИзмененияАдресаПоПрописке(Результат, ДопПараметры) Экспорт 
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	СменилсяАдресПрописки = Истина;
	ПричинаИзмененияАдресаПоПрописке = Результат.ПричинаИзменения;
	
	Если ФактическийСовпадает Тогда 
		СменилсяФактическийАдрес = СменилсяАдресПрописки; 
		ПричинаИзмененияФактическогоАдреса = Результат.ПричинаИзменения;
	КонецЕсли;
	
	Если ПочтовыйСовпадает Тогда
		СменилсяПочтовыйАдрес = СменилсяАдресПрописки;   
		ПричинаИзмененияПочтовогоАдреса = Результат.ПричинаИзменения;
	КонецЕсли;	
КонецПроцедуры	


