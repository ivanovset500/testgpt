		СписокСтран.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	Возврат СписокСтран;
КонецФункции	

&НаСервере
Процедура ЗаполнитьКонтактнуюИнформацию()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
