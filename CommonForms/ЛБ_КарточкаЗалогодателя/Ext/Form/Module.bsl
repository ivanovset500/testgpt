&НаСервере
Функция ПолучитьИДКлиентаВПеречне(ВидПеречня)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
	Запрос.УстановитьПараметр("ВидПеречня", ВидПеречня);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КлиентыВПеречнях.ИД КАК ИД
	|ИЗ
	|	РегистрСведений.ЛБ_КлиентыВПеречнях КАК ЛБ_КлиентыВПеречнях
	|ГДЕ
	|	ЛБ_КлиентыВПеречнях.Залогодатель = &Залогодатель
	|	И ЛБ_КлиентыВПеречнях.ВидПеречня = &ВидПеречня
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КлиентыВПеречнях.Период УБЫВ";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда    
		Возврат Выборка.ИД;
	КонецЕсли;	           
	Возврат "";
КонецФункции	

