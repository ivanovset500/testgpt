			КонецЕсли;
			ТолькоНули = Ложь;
			Прервать;
		Конеццикла;	 
		Если ТолькоНули Тогда  
			Сообщить("Телефон клиента не может содержать только нули!"); 
			ТелефоныОК = ложь;
		КонецЕсли;	
	КонецЕсли;   
	Если НЕ ПустаяСтрока(ТелефонДополнительный) Тогда
		ТелефонДляПроверки = СокрЛП(ТелефонДополнительный);
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, " ", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "+", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "(", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, ")", "");
		Если НЕ СтрДлина(ТелефонДляПроверки) = 11 Тогда
			ТелефоныОК = ложь;
			Сообщить("Неверная длина дополнительного телефона клиента!");
		КонецЕсли;   
		ТолькоНули = Истина; 
		ТелефонДляПроверки = Прав(ТелефонДляПроверки, СтрДлина(ТелефонДляПроверки)-1);
		Для сч = 1 по СтрДлина(СокрЛП(ТелефонДляПроверки)) Цикл 
			Если Сред(СокрЛП(ТелефонДляПроверки), сч, 1) = "0" Тогда
				Продолжить;
			КонецЕсли;
			ТолькоНули = Ложь;
			Прервать;
		Конеццикла;	 
		Если ТолькоНули Тогда  
			Сообщить("Дополнительный телефон клиента не может содержать только нули!"); 
			ТелефоныОК = ложь;
		КонецЕсли;	
	КонецЕсли;   
	Если НЕ ПустаяСтрока(ТелефонКонтактногоЛица) Тогда
		ТелефонДляПроверки = СокрЛП(ТелефонКонтактногоЛица);
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, " ", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "+", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "(", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, ")", "");
		Если НЕ СтрДлина(ТелефонДляПроверки) = 11 Тогда
			ТелефоныОК = ложь;
			Сообщить("Не верная длина телефона контактного лица клиента!");
		КонецЕсли;  
		ТолькоНули = Истина;   
		ТелефонДляПроверки = Прав(ТелефонДляПроверки, СтрДлина(ТелефонДляПроверки)-1);
		Для сч = 1 по СтрДлина(СокрЛП(ТелефонДляПроверки)) Цикл 
			Если Сред(СокрЛП(ТелефонДляПроверки), сч, 1) = "0" Тогда
				Продолжить;
			КонецЕсли;
			ТолькоНули = Ложь;
			Прервать;
		Конеццикла;	 
		Если ТолькоНули Тогда  
			Сообщить("Телефон контактного лица клиента не может содержать только нули!"); 
			ТелефоныОК = ложь;
		КонецЕсли;	
	КонецЕсли;  
	Возврат ТелефоныОК;
КонецФункции

