Функция ПолучитьКатегорииФизическогоЛица(МассивВыбора)
	Результат = Новый Структура;
	Результат.Вставить("Клиент");
	Результат.Вставить("ПредставительКлиента");
	Результат.Вставить("Выгодоприобретатель");
	Результат.Вставить("БенифициарныйВладелец");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КатегорииФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Перечисление.ЛБ_КатегорииФизЛица КАК ЛБ_КатегорииФизЛица";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Синоним = СокрЛП(Выборка.Ссылка);
		Если МассивВыбора.Найти(Синоним) = неопределено Тогда
			Пометка = ложь;
		Иначе	
			Пометка = Истина;
		КонецЕсли;
		Если Выборка.Ссылка = Перечисления.ЛБ_КатегорииФизЛица.Клиент Тогда
			Результат.Клиент = ?(Пометка, Символ(10004), " ");
		ИначеЕсли Выборка.Ссылка = Перечисления.ЛБ_КатегорииФизЛица.ПредставительКлиента Тогда
			Результат.ПредставительКлиента = ?(Пометка, Символ(10004), " ");
		ИначеЕсли Выборка.Ссылка = Перечисления.ЛБ_КатегорииФизЛица.Выгодоприобретатель Тогда
			Результат.Выгодоприобретатель = ?(Пометка, Символ(10004), " ");
		ИначеЕсли Выборка.Ссылка = Перечисления.ЛБ_КатегорииФизЛица.БенифициарныйВладелец Тогда
			Результат.БенифициарныйВладелец = ?(Пометка, Символ(10004), " ");
		КонецЕсли;	
	КонецЦикла;	 
	
	Возврат Результат;
КонецФункции

