&НаСервере
Функция ПолучитьВидОкругленияСуммыПроцентов(Дата)
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Организация", Константы.ЛБ_ОсновнаяОрганизация.Получить());
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.ВидОкругленияСуммыПроцентов КАК ВидОкругленияСуммыПроцентов
				   |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
	    Возврат Выборка.ВидОкругленияСуммыПроцентов;
	КонецЕсли;  
	Возврат Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеДоУмноженияНаКоличествоДней;
КонецФункции	

