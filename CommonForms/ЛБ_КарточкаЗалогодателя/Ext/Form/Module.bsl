	НовыйДок.ИсточникПроисхожденияДенежныхСредствИной = ИсточникПроисхожденияДенежныхСредствИной;
	НовыйДок.УровеньРиска = УровеньРиска;
	НовыйДок.ЗалогодательБенефициарныйВладелец = ЗалогодательБенефициарныйВладелец;
	НовыйДок.ЯвляетсяИПДЛ = ЯвляетсяИПДЛ;
	НовыйДок.КатегорияКлиентаИПДЛ = КатегорияКлиентаИПДЛ;
	НовыйДок.ДопИнформацияИПДЛ = ДопИнформацияИПДЛ;
	НовыйДок.ДолжностьИПДЛ = ДолжностьИПДЛ;
	НовыйДок.РаботодательИПДЛ = РаботодательИПДЛ;
	НовыйДок.РазрешениеИПДЛ = РазрешениеИПДЛ; 
	НовыйДок.ОтветственноеЛицоИПДЛ =ОтветственноеЛицоИПДЛ; 
	НовыйДок.ЯвляетсяДЛПМО_РДПЛ = ЯвляетсяДЛПМО_РДПЛ;
	НовыйДок.КатегорияДЛПМО_РДПЛ = КатегорияДЛПМО_РДПЛ;
	НовыйДок.ДопИнформацияДЛПМО_РДПЛ = ДопИнформацияДЛПМО_РДПЛ;
	НовыйДок.ДолжностьДЛПМО_РДПЛ = ДолжностьДЛПМО_РДПЛ;
	НовыйДок.РаботодательДЛПМО_РДПЛ = РаботодательДЛПМО_РДПЛ;
	НовыйДок.РазрешениеДЛПМО_РДПЛ = РазрешениеДЛПМО_РДПЛ;
	НовыйДок.ОтветственноеЛицоДЛПМО_РДПЛ = ОтветственноеЛицоДЛПМО_РДПЛ;	
	НовыйДок.СменилсяАдресПрописки = СменилсяАдресПрописки;  
