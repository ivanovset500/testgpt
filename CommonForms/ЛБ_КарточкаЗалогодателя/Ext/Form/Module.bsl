			Модифицированность = Ложь;	  
			ЭтоНовыйКлиент = Ложь;
			
			//++ИвановВВ, сравнение значений реквизитов контактных данных после сохранения
			Если ЗначенияРеквизитовКонтактныеДанные <> Неопределено Тогда
				СравнитьЗначенияРеквизитовКонтактныеДанные();
			КонецЕсли;
			//--ИвановВВ
	
		КонецЕсли;	
		//+МАН 04.12.25 Установка доступности после сохранения
		УстановитьДоступностьПослеСохранения();
		//-МАН
	КонецЕсли;	
КонецПроцедуры    

&НаКлиенте
Процедура ПослеОтветаНаВопросПроверкаПоПеречням(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		Результат = Новый Структура;
		Результат.Вставить("Залогодатель", Залогодатель);
		Результат.Вставить("Гражданство", Гражданство);
		Результат.Вставить("ДатаРождения", ДатаРождения);
		Результат.Вставить("НомерТелефона", Телефон);
		// ++ Сербаев 01.06.2023
		Модифицированность = Ложь;
		// -- Сербаев 01.06.2023
		
		//++ИвановВВ, сравнение значений реквизитов контактных данных после сохранения
			Если ЗначенияРеквизитовКонтактныеДанные <> Неопределено И Не ЗаявлениеОбИзмененииРаспечатано Тогда
				СравнитьЗначенияРеквизитовКонтактныеДанные();
			КонецЕсли;
		//--ИвановВВ
		
		ЭтаФорма.Закрыть(Результат); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПричиныИзменеияФИО(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда 
		Сообщить("Не выбрана причина изменения фамилии, имени или отчества клиента!");
		Возврат	    
	КонецЕсли;	
	ПричинаИзмененияФИО = Результат.ПричинаИзмененияФИО;
	ОснованиеИзмененияФИО = Результат.ОснованиеИзмененияФИО;  
	Если ПроверитьИЗаписать() Тогда
		СообщениеПоПеречням = "";
		ПроверитьПоПеречням(); 
		Если ПроверкаПереченьТеррористов ИЛИ ПроверкаСписокМВК ИЛИ ПроверкаПереченьФРОМУ ИЛИ ПроверкаПереченьООН Тогда 			
			Если ПроверкаПереченьТеррористов Тогда
				Сообщить("Клиент найден в перечне террористов.");
				СообщениеПоПеречням = СообщениеПоПеречням + ?(ПустаяСтрока(СообщениеПоПеречням), "Клиент найден в", ",") + " перечне террористов";
			КонецЕсли; 
			Если ПроверкаСписокМВК Тогда
				Сообщить("Клиент найден в списке МВК."); 
				СообщениеПоПеречням = СообщениеПоПеречням + ?(ПустаяСтрока(СообщениеПоПеречням), "Клиент найден в", ",") + " списке МВК";
			КонецЕсли; 
			Если ПроверкаПереченьФРОМУ Тогда
				Сообщить("Клиент найден в перечне ФРОМУ.");
				СообщениеПоПеречням = СообщениеПоПеречням + ?(ПустаяСтрока(СообщениеПоПеречням), "Клиент найден в", ",") + " перечне ФРОМУ";
			КонецЕсли; 
			Если ПроверкаПереченьООН Тогда
				Сообщить("Клиент найден в перечне ООН.");
				СообщениеПоПеречням = СообщениеПоПеречням + ?(ПустаяСтрока(СообщениеПоПеречням), "Клиент найден в", ",") + " перечне ООН";
			КонецЕсли;
		КонецЕсли;	
		Если ЗакрыватьФормуПриСохранении Тогда
			Если ПроверкаПереченьТеррористов ИЛИ ПроверкаСписокМВК ИЛИ ПроверкаПереченьФРОМУ ИЛИ ПроверкаПереченьООН Тогда 
				Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросПроверкаПоПеречням", ЭтотОбъект); 
				ПоказатьВопрос(Оповещение, СообщениеПоПеречням + ". Продолжить сохранение?", РежимДиалогаВопрос.ДаНетОтмена, 0,,);
			Иначе          
				Результат = Новый Структура;
				Результат.Вставить("Залогодатель", Залогодатель);
				Результат.Вставить("Гражданство", Гражданство);
				Результат.Вставить("ДатаРождения", ДатаРождения);
				Результат.Вставить("НомерТелефона", Телефон);
				Модифицированность = Ложь;
				ЭтаФорма.Закрыть(Результат); 
			КонецЕсли;	 
		Иначе
			Модифицированность = Ложь;
			Дата = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПричинуИзмененияФИО()
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПричиныИзменеияФИО", ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
