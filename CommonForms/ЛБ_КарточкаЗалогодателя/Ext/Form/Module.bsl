&НаСервере
Процедура ЗаполнитьТаблицуЗБ(ТаблицаЗапроса)
	ТаблицаЗБ.Очистить();
	Для каждого Стр Из ТаблицаЗапроса Цикл
		НоваяСтр = ТаблицаЗБ.Добавить();   
		ЗаполнитьСтрокуТаблицыЗБ(Стр, НоваяСтр);
	КонецЦикла;	
	ТаблицаЗБ.Сортировать("ДатаЗБ Убыв");
КонецПроцедуры	

&НаКлиенте
Процедура ТекущееСостояниеЗБ(Команда)  
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		Параметрыформы = Новый структура;
		Параметрыформы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет); 
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораТекущееСостояниеЗБ",ЭтотОбъект, );
		ОткрытьФорму("ОбщаяФорма.ЛБ_ТекущееСостояниеЗалога", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВыбораТекущееСостояниеЗБ(Результат,Параметры) Экспорт
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
    ПерезаполнитьСтрокуПоЗБ(ТекСтрока.ПолучитьИдентификатор());
КонецПроцедуры	

&НаСервере
Процедура ПерезаполнитьСтрокуПоЗБ(Идентификатор)
	СтрТаб = ТаблицаЗБ.НайтиПоИдентификатору(Идентификатор);
	ТаблицаЗапроса = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель, СтрТаб.ЗалоговыйБилет);
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		Стр = ТаблицаЗапроса.Получить(0);
	    ЗаполнитьСтрокуТаблицыЗБ(Стр, СтрТаб); 
	КонецЕсли;
	
	//проверим создание нового ЗБ 
	ТаблицаЗапроса = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель);
	Для каждого Стр из ТаблицаЗапроса Цикл  
		Отбор = Новый Структура;
		Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
		Строки = ТаблицаЗБ.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда  
			НоваяСтр = ТаблицаЗБ.Добавить();   
		    ЗаполнитьСтрокуТаблицыЗБ(Стр, НоваяСтр); 
			Элементы.ТаблицаЗБ.ТекущаяСтрока = НоваяСтр.ПолучитьИдентификатор();
		КонецЕсли;	
	КонецЦикла;	
	ТаблицаЗБ.Сортировать("ДатаЗБ Убыв");	
КонецПроцедуры	

&НаКлиенте
Процедура ИсторияЗБ(Команда)  
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	УстановитьОтборНаСервере();
