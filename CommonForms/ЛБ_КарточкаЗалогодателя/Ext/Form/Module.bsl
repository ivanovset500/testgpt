&НаСервере 
Процедура ЗаполнитьСписокКатегорийФизическогоЛица(КатегорииФЛ, МассивВыбора)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КатегорииФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Перечисление.ЛБ_КатегорииФизЛица КАК ЛБ_КатегорииФизЛица";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Синоним = СокрЛП(Выборка.Ссылка);
		Если МассивВыбора.Найти(Синоним) = неопределено Тогда
			Пометка = ложь;
		Иначе	
			Пометка = Истина;
		КонецЕсли;	
		КатегорииФЛ.Добавить(Синоним, Синоним, Пометка);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииФизЛицаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	КатегорииФЛ = Новый СписокЗначений;
	МассивВыбора = СтрРазделить(КатегорииФизЛица, ";", ложь);
	ЗаполнитьСписокКатегорийФизическогоЛица(КатегорииФЛ, МассивВыбора);	
	
	ОповещениеПослеОтметкиЭлементов = Новый ОписаниеОповещения("ПослеОтметкиЭлементовКФЛ", ЭтотОбъект);	
	
	КатегорииФЛ.ПоказатьОтметкуЭлементов(
	ОповещениеПослеОтметкиЭлементов,
	"Выберите категории физического лица"
	);
КонецПроцедуры  

&НаКлиенте
Процедура ПослеОтметкиЭлементовКФЛ(Элементы, Параметры) Экспорт
	КатегорииФизЛица = "";
	Если Элементы <> Неопределено Тогда
		Для Каждого Эл Из Элементы Цикл
			Если Эл.Пометка Тогда
				КатегорииФизЛица = КатегорииФизЛица + ?(ПустаяСтрока(КатегорииФизЛица), "", ";") + Эл.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

