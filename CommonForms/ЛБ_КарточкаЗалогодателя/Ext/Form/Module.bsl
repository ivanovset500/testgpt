		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "+", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "(", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, ")", "");
		Если НЕ СтрДлина(ТелефонДляПроверки) = 11 Тогда
			ТелефоныОК = ложь;
			Сообщить("Неверная длина сотового телефона клиента!"); 
			// ++ Сербаев 07.06.2023 (снять запрет с указания одного номера сотового телефона в карточках разных клиентов)
			//ИначеЕсли НЕ ЗначениеЗаполнено(Залогодатель) Тогда
			//	Запрос = Новый Запрос; 
			//	Запрос.УстановитьПараметр("Телефон", СокрЛП(Телефон));
			//    Запрос.Текст = "ВЫБРАТЬ
			//           |	ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель КАК Залогодатель
			//           |ИЗ
			//           |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей КАК ЛБ_КонтактнаяИнформацияЗалогодателей
			//           |ГДЕ
			//           |	ЛБ_КонтактнаяИнформацияЗалогодателей.Телефон = &Телефон"; 
			//	Выборка = Запрос.Выполнить().Выбрать();
			//	Если Выборка.Следующий() Тогда 
			//		ТелефоныОК = ложь;
			//        Сообщить("В базе уже есть клиент " + СокрЛП(Выборка.Залогодатель) + " с тем же номером сотового телефона!"); 
			//	КонецЕсли;
			// -- Сербаев 07.06.2023
		КонецЕсли;  
		ТолькоНули = Истина;   
		ТелефонДляПроверки = Прав(ТелефонДляПроверки, СтрДлина(ТелефонДляПроверки)-2);
		Для сч = 1 по СтрДлина(СокрЛП(ТелефонДляПроверки)) Цикл 
			Если Сред(СокрЛП(ТелефонДляПроверки), сч, 1) = "0" Тогда
