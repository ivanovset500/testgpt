&НаСервере
Процедура ПослеВыбораБенефициара(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	Отбор = Новый Структура;
	Отбор.Вставить("Бенефициар", Результат.Залогодатель);     
	
	Строки = Бенефициары.НайтиСтроки(Отбор); 
	Если Строки.Количество() = 0 Тогда
		НоваяСтр = Бенефициары.Добавить();
		НоваяСтр.Бенефициар = Результат.Залогодатель;
		НоваяСтр.ДатаРождения = Результат.ДатаРождения;
		НоваяСтр.ВидПолученияИнформации = Перечисления.ЛБ_ВидыПолученияИнформацииОБенефициарномВладельце.ПредоставленКлиентомУстановленОрганизацией;
	КонецЕсли;	
КонецПроцедуры

