&НаКлиенте
Процедура ПечатьАнкеты(Команда) 
	Если ЗначениеЗаполнено(Залогодатель) Тогда 
		НапечататьАнкету();
	Иначе
		Сообщить("Сохраните карточку клиента!");
	КонецЕсли;	
КонецПроцедуры	   

&НаКлиенте
Процедура ПечатьАнкетыНаДату(Команда) 
	Если НЕ ЗначениеЗаполнено(Залогодатель) Тогда
		Сообщить("Сохраните карточку клиента!");
		Возврат;
	КонецЕсли;	
	ДатаАнкеты = ТекущаяДата();
	Если НЕ ВвестиДату(ДатаАнкеты, "Дата анкеты") Тогда
		Возврат;
	КонецЕсли;     
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
	ПараметрыФормы.Вставить("Дата", ДатаАнкеты);
	ПараметрыФормы.Вставить("ТолькоПечатьАнкеты", истина);
	
	ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы);
КонецПроцедуры 

&НаСервере 
Функция ПолучитьДанныеГлобальныхПроверок()
	Если НЕ ПроверкаПереченьТеррористов И НЕ ПроверкаПереченьФРОМУ И НЕ ПроверкаСписокМВК И НЕ ПроверкаПереченьООН Тогда 
		СтрокаРезультат = "Проверка проведена по Перечню террористов, Списку МВК, Перечню ФРОМУ - информация о причастности отсутствует даты проверки: ";
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.УстановитьПараметр("ДатаОформленияАнкеты", ДатаОформленияАнкеты);
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_ДатыЗагрузкиПеречней.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЛБ_ДатыЗагрузкиПеречней КАК ЛБ_ДатыЗагрузкиПеречней
		|ГДЕ
		|	ЛБ_ДатыЗагрузкиПеречней.ВидПроверки = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка)
		|	И ЛБ_ДатыЗагрузкиПеречней.Период <= &Дата
		|	И ЛБ_ДатыЗагрузкиПеречней.Период >= &ДатаОформленияАнкеты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";  
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();  
		Для каждого стр из ТаблицаЗапроса Цикл 
			Стр.Период = НачалоДня(Стр.Период);
		КонецЦикла;	 
		ТаблицаЗапроса.Свернуть("Период");
		
		Ном = 0;
		Для каждого Стр из ТаблицаЗапроса Цикл 
			СтрокаРезультат = СтрокаРезультат + ?(Ном = 0, "", ", ") + Формат(Стр.Период, "ДФ=dd.MM.yyyy");
			Ном = Ном + 1;
			Если Ном = 14 Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;	  
		КолСтр = ТаблицаЗапроса.Количество();
		Если КолСтр >= 15 Тогда
			СтрокаРезультат = СтрокаРезультат + "... " +  Формат(ТаблицаЗапроса.Получить(КолСтр-1).Период, "ДФ=dd.MM.yyyy");
		КонецЕсли;	
		
		Возврат СтрокаРезультат; 
	Иначе      
		СтрокаРезультат = "";
		Если ПроверкаПереченьТеррористов Тогда
			СтрокаРезультат = "Присутствует в перечнях террористов. Даты проверки: "; 
			Запрос = Новый Запрос;   			
			Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.Текст = "ВЫБРАТЬ
			|	ЛБ_КлиентыВПеречнях.ДатаПеречня КАК ДатаПеречня,
			|	ЛБ_КлиентыВПеречнях.Период КАК Период
			|ИЗ
			|	РегистрСведений.ЛБ_КлиентыВПеречнях КАК ЛБ_КлиентыВПеречнях
			|ГДЕ
			|	ЛБ_КлиентыВПеречнях.Залогодатель = &Залогодатель
			|	И ЛБ_КлиентыВПеречнях.ВидПеречня = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПеречней.Террористы)
			|	И ЛБ_КлиентыВПеречнях.ВидПроверки = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка)
			|	И ЛБ_КлиентыВПеречнях.Период <= &Дата
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период УБЫВ";
			ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
			Для каждого стр из ТаблицаЗапроса Цикл 
				Стр.Период = НачалоДня(Стр.Период);
			КонецЦикла;	 
			ТаблицаЗапроса.Свернуть("Период, ДатаПеречня");
			
			Ном = 0;
			Для каждого Стр из ТаблицаЗапроса Цикл 
				СтрокаРезультат = СтрокаРезультат + ?(Ном = 0, "", ", ") + Формат(Стр.Период, "ДФ=dd.MM.yyyy") + " перечень от " + Формат(Стр.ДатаПеречня, "ДФ=dd.MM.yyyy");
				Ном = Ном + 1;
				Если Ном = 14 Тогда
					Прервать;
				КонецЕсли;	
			КонецЦикла;	  
			КолСтр = ТаблицаЗапроса.Количество();
			Если КолСтр >= 15 Тогда
				СтрокаРезультат = СтрокаРезультат + "... " + Формат(ТаблицаЗапроса.Получить(КолСтр-1).Период, "ДФ=dd.MM.yyyy") + " перечень от " +  Формат(ТаблицаЗапроса.Получить(КолСтр-1).ДатаПеречня, "ДФ=dd.MM.yyyy");
			КонецЕсли;	
		КонецЕсли;  
		
		Если ПроверкаСписокМВК Тогда
			//СтрокаРезультат = ?(ПустаяСтрока(СтрокаРезультат), "", Символ(94) + Символ(112)) + "Присутствует в списках МВК. Даты проверки: ";
			СтрокаРезультат = ?(ПустаяСтрока(СтрокаРезультат), "", Символы.ПС) + "Присутствует в списках МВК. Даты проверки: ";
			Запрос = Новый Запрос;   			
			Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.Текст = "ВЫБРАТЬ
			|	ЛБ_КлиентыВПеречнях.ДатаПеречня КАК ДатаПеречня,
			|	ЛБ_КлиентыВПеречнях.Период КАК Период
			|ИЗ
			|	РегистрСведений.ЛБ_КлиентыВПеречнях КАК ЛБ_КлиентыВПеречнях
			|ГДЕ
			|	ЛБ_КлиентыВПеречнях.Залогодатель = &Залогодатель
			|	И ЛБ_КлиентыВПеречнях.ВидПеречня = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПеречней.МВК)
			|	И ЛБ_КлиентыВПеречнях.ВидПроверки = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка)
			|	И ЛБ_КлиентыВПеречнях.Период <= &Дата
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период УБЫВ";
			ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
			Для каждого стр из ТаблицаЗапроса Цикл 
				Стр.Период = НачалоДня(Стр.Период);
			КонецЦикла;	 
			ТаблицаЗапроса.Свернуть("Период, ДатаПеречня");
			
			Ном = 0;
			Для каждого Стр из ТаблицаЗапроса Цикл 
				СтрокаРезультат = СтрокаРезультат + ?(Ном = 0, "", ", ") + Формат(Стр.Период, "ДФ=dd.MM.yyyy") + " список от " + Формат(Стр.ДатаПеречня, "ДФ=dd.MM.yyyy");
				Ном = Ном + 1;
				Если Ном = 14 Тогда
					Прервать;
				КонецЕсли;	
			КонецЦикла;	  
