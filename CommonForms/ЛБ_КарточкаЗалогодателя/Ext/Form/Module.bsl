&НаСервере
Функция ПолучитьКлючСтроки()
	
	ТаблицаКлючей = ДокументыЗалогодателя.Выгрузить(, "КлючСтроки");
	Если ТаблицаКлючей.Количество() = 1 Тогда
		Возврат 1;
	Иначе	
		ТаблицаКлючей.Сортировать("КлючСтроки Убыв");
		
		Возврат ТаблицаКлючей[0].КлючСтроки + 1;
	КонецЕсли;	
	
КонецФункции

&НаСервере
Функция ПроверитьЕстьСвидетельствоОСмерти()
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти); 
	Отбор.Вставить("ДокументНеДействителен", Ложь);
	СтрокиДок = ДокументыЗалогодателя.НайтиСтроки(Отбор); 
	Если НЕ СтрокиДок.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;	
	Возврат Ложь;
КонецФункции	

&НаКлиенте
