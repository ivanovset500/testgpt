	НовыйДок.СогласиеНаСМСРассылку = СогласиеНаСМСРассылку;
	
	ИзмененияКИ = "";  
	ИзмененияАнкета = ""; 
	ИзмененияСтатусов = ПроверитьИзмененияСтатусовКлиента();
	Если Проверять Тогда
