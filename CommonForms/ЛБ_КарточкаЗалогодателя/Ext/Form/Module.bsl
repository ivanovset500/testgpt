&НаСервере
Процедура УстановитьСписокПечатныхФорм()
	
	СписокПечатныхФорм = ПланыВидовХарактеристик.ЛБ_НастройкиЛомбард.ПолучитьЗначениеНастройки(ПланыВидовХарактеристик.ЛБ_НастройкиЛомбард.СписокПечатныхФормКарточкиКлиента);
	
	ПечатныеФормы = Элементы.ФормаГруппаПечать.ПодчиненныеЭлементы;
	
	ПечатныеФормы.ФормаСогласиеНаОпробование.Видимость                     = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.СогласиеНаОпробование)                     = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаЗаявлениеОбИзмененииКонтактныхДанных.Видимость      = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ЗаявлениеОбИзмененииКонтактныхДанных)      = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаЗаявлениеНаВозвратБезналичнойОплаты.Видимость       = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ЗаявлениеНаВозвратБезналичнойОплаты)       = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаШаблонЗаявленияНаВозвратБезналичнойОплаты.Видимость = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ШаблонЗаявленияНаВозвратБезналичнойОплаты) = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаЗаявлениеОПредоставленииСведенийОНаличииОбязательствИмущественногоХарактера.Видимость = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ЗаявлениеОПредоставленииСведенийОНаличииОбязательствИмущественногоХарактера) = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаАктОПолученииИзделийНаследниками.Видимость            = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.АктОПолученииИзделийНаследниками)            = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаЗаявлениеВСвободнойФорме.Видимость                    = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ЗаявлениеВСвободнойФорме)                    = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаРаспоряжениеОбОтказеНедействительныйПаспорт.Видимость = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.РаспоряжениеОбОтказеНедействительныйПаспорт) = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаКнопкаПечатьАнкеты.Видимость       = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ПечатьАнкеты)       = Неопределено, Ложь, Истина);
	ПечатныеФормы.ФормаКнопкаПечатьАнкетыНаДату.Видимость = ?(СписокПечатныхФорм.Найти(Перечисления.ЛБ_ПечатныеФормыКарточкиКлиента.ПечатьАнкетыНаДату) = Неопределено, Ложь, Истина);
	
КонецПроцедуры	

&НаСервере
Функция НаименованиеОрганизации()
	
	Результат = Новый Структура("НаименованиеПолное, НаименованиеСокращенное", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛБ_ОсновнаяОрганизация.Значение.НаименованиеПолное КАК НаименованиеПолное,
	|	ЛБ_ОсновнаяОрганизация.Значение.НаименованиеСокращенное КАК НаименованиеСокращенное
	|ИЗ
	|	Константа.ЛБ_ОсновнаяОрганизация КАК ЛБ_ОсновнаяОрганизация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ЛБ_ОсновнаяОрганизация.Значение = Организации.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат.НаименованиеПолное      = Выборка.НаименованиеПолное;
		Результат.НаименованиеСокращенное = Выборка.НаименованиеСокращенное;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
