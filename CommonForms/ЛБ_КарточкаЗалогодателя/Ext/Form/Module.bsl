&НаСервере
Функция ПроверитьОднофамильцев()
	
	СписокЗалогодателей = Новый Массив;
	ДанныеЗалогодателей = Новый Массив;
	
	Результат = Новый Структура("ЕстьСовпадения, СписокЗалогодателей, ДанныеЗалогодателей", Ложь, СписокЗалогодателей, ДанныеЗалогодателей);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛБ_Залогодатели.Ссылка КАК Ссылка,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&ДатаСреза, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	|		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
	|ГДЕ
	|	ЛБ_Залогодатели.Фамилия = &Фамилия
	|	И ЛБ_Залогодатели.Имя = &Имя
	|	И ЛБ_Залогодатели.Отчество = &Отчество
	|	И ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения = &ДатаРождения
	|	И НЕ ЛБ_Залогодатели.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Отчество", Отчество);
	Запрос.УстановитьПараметр("Фамилия", Фамилия); 
	Запрос.УстановитьПараметр("Ссылка", ЭтаФорма.Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат.ЕстьСовпадения = Истина;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл 
			Результат.СписокЗалогодателей.Добавить(Выборка.Ссылка); 
			
			СтруктураДанных = Новый Структура("Фамилия, Имя, Отчество, ДатаРождения");
			ЗаполнитьЗначенияСвойств(СтруктураДанных,Выборка);
			Результат.ДанныеЗалогодателей.Добавить(СтруктураДанных);
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьНаРезиденство()  
	//проверим есть действительный документ вид на жительство 
	ОтборДок = Новый структура;
	ОтборДок.Вставить("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство);  
	ОтборДок.Вставить("Гражданство", Гражданство);
	СтрокиДок = ДокументыЗалогодателя.НайтиСтроки(ОтборДок);
	Если СтрокиДок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;	                
	ЕстьВидНаЖительство = Ложь;
	Для каждого СтрДок из СтрокиДок Цикл 
		Если СтрДок.ДокументНеДействителен ИЛИ СтрДок.ПроверкаНеДействителен Тогда
			Продолжить; 	
		КонецЕсли;
		ЕстьВидНаЖительство = Истина;
		Прервать;
	КонецЦикла;	                
	Возврат ЕстьВидНаЖительство;
КонецФункции

