	|	ЛБ_АнкетаЗалогодателяСрезПоследних.РаботодательДЛПМО_РДПЛ КАК РаботодательДЛПМО_РДПЛ,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.РазрешениеДЛПМО_РДПЛ КАК РазрешениеДЛПМО_РДПЛ,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ОтветственноеЛицоИПДЛ КАК ОтветственноеЛицоИПДЛ,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ОтветственноеЛицоДЛПМО_РДПЛ КАК ОтветственноеЛицоДЛПМО_РДПЛ,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.Регистратор КАК Регистратор,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ПричинаИзменения КАК ПричинаИзменения
	|ИЗ
	|	РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_АнкетаЗалогодателяСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка); 
		
		Если НЕ ЗалогодательБенефициарныйВладелец Тогда 
			ЗапросБ.УстановитьПараметр("Регистратор", Выборка.Регистратор);
			ТаблицаБенефициаров = ЗапросБ.Выполнить().Выгрузить();
			Бенефициары.Загрузить(ТаблицаБенефициаров);
			Элементы.ГруппаБенефициары.Показать();
			Элементы.ГруппаБенефициары.Доступность = истина;
		КонецЕсли;
		ЕстьАнкета = Истина;
	Иначе
		ТипФизЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		КатегорииФизЛица = СокрЛП(Перечисления.ЛБ_КатегорииФизЛица.Клиент);
		ХарактерОтношений = "Получение краткосрочного займа под залог ювелирных изделий на потребительские нужды";
		ФинансовоеПоложениеСтабильное = Истина;
		ДеловаяРепутацияПоложительная = Истина;  
		УровеньРиска = "Низкий, отсутствуют критерии повышенного риска"; 
		ЗалогодательБенефициарныйВладелец = Истина; 
		ДатаОформленияАнкеты = ТекущаяДата();   
		ЕстьАнкета = Ложь;  
		Элементы.ГруппаБенефициары.Доступность = ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	Если ТолькоПечатьАнкеты Тогда 
		НапечататьАнкету();
		ЭтаФорма.Закрыть();
	КонецЕсли;	
	Если АдресПоПрописке = ФактическийАдрес Тогда
		ФактическийСовпадает = Истина;
	Иначе	
		ФактическийСовпадает = Ложь;
	КонецЕсли;	
	
	Если АдресПоПрописке = ПочтовыйАдрес Тогда
		ПочтовыйСовпадает = Истина;
	Иначе	
		ПочтовыйСовпадает = Ложь;
	КонецЕсли;	
	УстановитьДоступность();
	ПоказатьФИО_А();
	ДокументыЗалогодателя.Сортировать("Основной УБЫВ, ДокументНачалоДействия УБЫВ, ВидДокументаЗалогодателя");
	
	//Иванов ВВ, сохр. значения реквизитов для сравнения при сохранении, права на расторжение
	Если ЛБ_СоглашенияЭДОСервер.ПроверкаРоли_ЛБ_СотрудникЦО() Тогда 
		Элементы.РасторгнутьЭДО_ЦО.Доступность = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Залогодатель) Тогда
		ЗапомнитьЗначенияРеквизитовКонтактныеДанные();
		НаличиеЭДО = ЛБ_СоглашенияЭДОСервер.НаличиеДействующегоСоглашения(Залогодатель);
		НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
		
		Если НаличиеЭДО Тогда
			Элементы.СтатусЭДО.Заголовок = "есть";
		Иначе
			Элементы.СтатусЭДО.Заголовок = "нет";
		КонецЕсли;
		
		Если НаличиеСогласия Тогда
			Элементы.СтатусСогласия.Заголовок = "есть";
		Иначе
			Элементы.СтатусСогласия.Заголовок = "нет";
		КонецЕсли;
		ОтмененыИзменения = Ложь;
	КонецЕсли;
	//
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьЗначенияРеквизитовКонтактныеДанные()
	ЗначенияРеквизитовКонтактныеДанные = Новый Структура;
	ЗначенияРеквизитовКонтактныеДанные.Вставить("Телефон",                Телефон);
	ЗначенияРеквизитовКонтактныеДанные.Вставить("ТелефонДополнительный",  ТелефонДополнительный);
	ЗначенияРеквизитовКонтактныеДанные.Вставить("Email",                  Email);
	ЗначенияРеквизитовКонтактныеДанные.Вставить("КонтактноеЛицо",         КонтактноеЛицо);
	ЗначенияРеквизитовКонтактныеДанные.Вставить("ТелефонКонтактногоЛица", ТелефонКонтактногоЛица);
	ЗначенияРеквизитовКонтактныеДанные.Вставить("ФактическийАдрес",       ФактическийАдрес);
	ЗначенияРеквизитовКонтактныеДанные.Вставить("ПочтовыйАдрес",          ПочтовыйАдрес);
КонецПроцедуры // ЗапомнитьЗначенияРеквизитовКонтактныхДанных()

&НаСервере 
Функция ПроверитьИзмененияДок(СтрДок, Изменения)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ДокументЗалогодателя", СтрДок.ДокументСсылка);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	// ++ Сербаев 25.05.2023 TODO: Сербаев
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСтранаЭмитент КАК ДокументСтранаЭмитент,
	// -- Сербаев 25.05.2023
	// ++ Сербаев 14.06.2023 (иной документ)
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНаименованиеИногоДокумента КАК ДокументНаименованиеИногоДокумента,
	// -- Сербаев 14.06.2023
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ДокументНеДействителен, 
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДействителен КАК ДокументДействителен,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ КАК ОсновнойДУЛ,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДоп КАК ОсновнойДоп
	|ИЗ
	|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ СтрДок.ВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен вид документа с " + ПолучитьПредставление(Строка(Выборка.ВидДокументаЗалогодателя)) + " на " + ПолучитьПредставление(Строка(СтрДок.ВидДокументаЗалогодателя));
		КонецЕсли;
		Если НЕ СтрДок.ВидДокумента = Выборка.ВидДокумента Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено наименование документа с " + ПолучитьПредставление(СокрЛП(Выборка.ВидДокумента)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ВидДокумента));
		КонецЕсли;
		Если НЕ СтрДок.Гражданство = Выборка.Гражданство Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено гражданство с " + ПолучитьПредставление(СокрЛП(Выборка.Гражданство)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.Гражданство));
		КонецЕсли;
		Если НЕ СтрДок.ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменена дата выдачи документа с " + ПолучитьПредставление(Формат(Выборка.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")) + " на " + ПолучитьПредставление(Формат(СтрДок.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если НЕ СтрДок.ДокументКемВыдан = Выборка.ДокументКемВыдан Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено кем выдан документ с " + ПолучитьПредставление(СокрЛП(Выборка.ДокументКемВыдан)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ДокументКемВыдан));
		КонецЕсли;
		Если НЕ СтрДок.ДокументКодПодразделения = Выборка.ДокументКодПодразделения Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен код подразделения с " + ПолучитьПредставление(СокрЛП(Выборка.ДокументКодПодразделения)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ДокументКодПодразделения));
		КонецЕсли;
		Если НЕ СтрДок.ДокументСерия = Выборка.ДокументСерия Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменена серия документа с " + ПолучитьПредставление(СокрЛП(Выборка.ДокументСерия)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ДокументСерия));
		КонецЕсли;
		Если НЕ СтрДок.ДокументНомер = Выборка.ДокументНомер Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен номер документа с " + ПолучитьПредставление(СокрЛП(Выборка.ДокументНомер)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ДокументНомер));
		КонецЕсли;
		Если НЕ СтрДок.ДокументСрокДействия = Выборка.ДокументСрокДействия Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен срок действия документа с " + ПолучитьПредставление(Формат(Выборка.ДокументСрокДействия, "ДФ=dd.MM.yyyy")) + " на " + ПолучитьПредставление(Формат(СтрДок.ДокументСрокДействия, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если НЕ СтрДок.ДокументНеДействителен = Выборка.ДокументНеДействителен Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен документ не действитен с " + ?(СтрДок.ДокументНеДействителен, "не установлена на установлена", "установлена на не установлена");
		КонецЕсли;  
		Если НЕ СтрДок.ДокументДействителен = Выборка.ДокументДействителен Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен документ действитен с " + ?(СтрДок.ДокументДействителен, "не установлена на установлена", "установлена на не установлена");
		КонецЕсли;
		Если НЕ СтрДок.ОсновнойДУЛ = Выборка.ОсновнойДУЛ Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен признак Основной ДУЛ с " + ?(Выборка.ОсновнойДУЛ, "основной", "не основной") + " на " + ?(СтрДок.ОсновнойДУЛ, "основной", "не основной");
		КонецЕсли;     
		Если НЕ СтрДок.ОсновнойДоп = Выборка.ОсновнойДоп Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен признак Основной документ на право пребывания в РФ с " + ?(Выборка.ОсновнойДоп, "основной", "не основной") + " на " + ?(СтрДок.ОсновнойДоп, "основной", "не основной");
		КонецЕсли;
		// ++ Сербаев 25.05.2023 TODO: Сербаев
		Если НЕ СтрДок.ДокументСтранаЭмитент = Выборка.ДокументСтранаЭмитент Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено гражданство с " + ПолучитьПредставление(СокрЛП(Выборка.ДокументСтранаЭмитент)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ДокументСтранаЭмитент));
		КонецЕсли;
		// -- Сербаев 25.05.2023
		// ++ Сербаев 14.06.2023 (иной документ)
		Если НЕ СтрДок.ДокументНаименованиеИногоДокумента = Выборка.ДокументНаименованиеИногоДокумента Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено наименование иного документа с " + ПолучитьПредставление(СокрЛП(Выборка.ДокументНаименованиеИногоДокумента)) + " на " + ПолучитьПредставление(СокрЛП(СтрДок.ДокументНаименованиеИногоДокумента));
		КонецЕсли;
		// -- Сербаев 14.06.2023
	КонецЦикла;	
	Возврат Изменения;
КонецФункции

&НаСервере 
Функция СохранитьДокументы(НовыйДок)
	Результат = Ложь;
	Для каждого Стр Из ДокументыЗалогодателя Цикл
		Если Стр.ДокументИзменен Тогда
			ЗаписатьДокумент = ложь;
			Изменения = "";
			Если НЕ ЗначениеЗаполнено(Стр.ДокументСсылка) Тогда //новый документ
				СпрОбъект = Справочники.ЛБ_ДокументыЗалогодателя.СоздатьЭлемент();
				СпрОбъект.Владелец = Залогодатель;
				СпрОбъект.Гражданство = Стр.Гражданство;
				СпрОбъект.ВидДокументаЗалогодателя = Стр.ВидДокументаЗалогодателя;
				СпрОбъект.ВидДокумента = Стр.ВидДокумента;
				
				СпрОбъект.Наименование = ЛБ_ОбщийМодуль.СформироватьНаименованиеДокументаЗалогодателя(Стр);
				СпрОбъект.НаименованиеПолное = ЛБ_ОбщийМодуль.СформироватьПолноеНаименованиеДокументаЗалогодателя(Стр);
				СпрОбъект.Записать();
				Стр.ДокументСсылка = СпрОбъект.Ссылка;
				Изменения = "Создан новый документ";
				ЗаписатьДокумент = Истина;
			Иначе			
				Изменения = ПроверитьИзмененияДок(Стр, Изменения);  
				Если НЕ ПустаяСтрока(Изменения) Тогда 
					СпрОбъект = Стр.ДокументСсылка.ПолучитьОбъект();
					СпрОбъект.Наименование = ЛБ_ОбщийМодуль.СформироватьНаименованиеДокументаЗалогодателя(Стр);
					СпрОбъект.НаименованиеПолное = ЛБ_ОбщийМодуль.СформироватьПолноеНаименованиеДокументаЗалогодателя(Стр);
					СпрОбъект.Записать();
					ЗаписатьДокумент = Истина;
				КонецЕсли;	
			КонецЕсли;		
			
			Если ЗаписатьДокумент Тогда			
				НоваяСтр = НовыйДок.ДокументыЗалогодателя.Добавить();
				НоваяСтр.ДокументЗалогодателя     = Стр.ДокументСсылка;
				НоваяСтр.ВидДокумента             = Стр.ВидДокумента;
				НоваяСтр.ВидДокументаЗалогодателя = Стр.ВидДокументаЗалогодателя;
				НоваяСтр.Гражданство              = Стр.Гражданство;
				// ++ Сербаев 25.05.2023 TODO: Сербаев
				НоваяСтр.ДокументСтранаЭмитент    = Стр.ДокументСтранаЭмитент;        
				// -- Сербаев 25.05.2023
				// ++ Сербаев 14.06.2023 (иной документ)
				НоваяСтр.ДокументНаименованиеИногоДокумента = Стр.ДокументНаименованиеИногоДокумента;
				// -- Сербаев 14.06.2023
				НоваяСтр.ДокументДатаВыдачи       = Стр.ДокументДатаВыдачи;
				НоваяСтр.ДокументКемВыдан         = Стр.ДокументКемВыдан;
				НоваяСтр.ДокументКодПодразделения = Стр.ДокументКодПодразделения;
				НоваяСтр.ДокументНачалоДействия   = Стр.ДокументНачалоДействия;
				НоваяСтр.ДокументСерия            = Стр.ДокументСерия;
				НоваяСтр.ДокументНомер            = Стр.ДокументНомер;
				НоваяСтр.ДокументСрокДействия     = Стр.ДокументСрокДействия;
				НоваяСтр.ДокументНеДействителен   = Стр.ДокументНеДействителен; 
				НоваяСтр.ДокументДействителен     = Стр.ДокументДействителен;
				НоваяСтр.ПричинаИзменения         = Стр.ПричинаИзменения;
				НоваяСтр.ДатаСмерти               = Стр.ДатаСмерти;
				НоваяСтр.ОсновнойДУЛ              = Стр.ОсновнойДУЛ; 
				НоваяСтр.ОсновнойДоп              = Стр.ОсновнойДоп;
				НоваяСтр.ИзмененияДок             = Изменения;
				Результат                         = Истина;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьПредставление(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "<Пустое значение>";
	Иначе
		Возврат "<" + Значение + ">";
	КонецЕсли;	
КонецФункции

&НаСервере 
Функция ПроверитьИзмененияКИ(Изменения)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияСтрана КАК МестоРожденияСтрана,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияОбласть КАК МестоРожденияОбласть,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияРайон КАК МестоРожденияРайон,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияНаселенныйПункт КАК МестоРожденияНаселенныйПункт,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонСтруктура КАК ТелефонСтруктура,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПропискеСтруктура КАК АдресПоПропискеСтруктура,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдресСтруктура КАК ФактическийАдресСтруктура,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдресСтруктура КАК ПочтовыйАдресСтруктура,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонДополнительный КАК ТелефонДополнительный,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонДополнительныйСтруктура КАК ТелефонДополнительныйСтруктура,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.КонтактноеЛицо КАК КонтактноеЛицо,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонКонтактногоЛицаСтруктура КАК ТелефонКонтактногоЛицаСтруктура,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ИсточникИнформации КАК ИсточникИнформации,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ИсточникИнформацииДругое КАК ИсточникИнформацииДругое,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Комментарий КАК Комментарий,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия_А КАК Фамилия_А,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя_А КАК Имя_А,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество_А КАК Отчество_А
	|ИЗ
	|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если НЕ СокрЛП(Фамилия) = СокрЛП(Выборка.Фамилия) Тогда
			Изменения = Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменена фамилия с " + ПолучитьПредставление(СокрЛП(Выборка.Фамилия)) + " на " + ПолучитьПредставление(СокрЛП(Фамилия));			
		КонецЕсли;	
		Если НЕ СокрЛП(Имя) = СокрЛП(Выборка.Имя) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено имя с " + ПолучитьПредставление(СокрЛП(Выборка.Имя)) + " на " + ПолучитьПредставление((Имя));			
		КонецЕсли;
		Если НЕ СокрЛП(Отчество) = СокрЛП(Выборка.Отчество) Тогда 
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено отчество с " + ПолучитьПредставление(СокрЛП(Выборка.Отчество)) + " на " + ПолучитьПредставление(СокрЛП(Отчество));			 
		КонецЕсли;
		Если НЕ Гражданство = Выборка.Гражданство Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено гражданство с " + ПолучитьПредставление(Строка(Выборка.Гражданство)) + " на " + ПолучитьПредставление(Строка(Гражданство));
		КонецЕсли;
		Если НЕ СокрЛП(Фамилия_А) = СокрЛП(Выборка.Фамилия_А) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменена фамилия иностранного гражданина с " + ПолучитьПредставление(СокрЛП(Выборка.Фамилия_А)) + " на " + ПолучитьПредставление(СокрЛП(Фамилия_А));
		КонецЕсли;	
		Если НЕ СокрЛП(Имя_А) = СокрЛП(Выборка.Имя_А) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено имя иностранного гражданина с " + ПолучитьПредставление(СокрЛП(Выборка.Имя_А)) + " на " + ПолучитьПредставление((Имя_А));
		КонецЕсли;
		Если НЕ СокрЛП(Отчество_А) = СокрЛП(Выборка.Отчество_А) Тогда 
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено отчество иностранного гражданина с " + ПолучитьПредставление(СокрЛП(Выборка.Отчество_А)) + " на " + ПолучитьПредставление(СокрЛП(Отчество_А));
		КонецЕсли;
		Если НЕ Пол = Выборка.Пол Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен пол с " + ПолучитьПредставление(Строка(Выборка.Пол)) + " на " + ПолучитьПредставление(Строка(Пол));
		КонецЕсли; 
		Если НЕ ДатаРождения = Выборка.ДатаРождения Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменена дата рождения с " + ПолучитьПредставление(Формат(Выборка.ДатаРождения, "ДФ=dd.MM.yyyy")) + " на " + ПолучитьПредставление(Формат(ДатаРождения, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если НЕ СокрЛП(МестоРождения) = СокрЛП(Выборка.МестоРождения) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено место рождения с " + ПолучитьПредставление(СокрЛП(Выборка.МестоРождения)) + " на " + ПолучитьПредставление(СокрЛП(МестоРождения));
		КонецЕсли;
		Если НЕ СокрЛП(Телефон) = СокрЛП(Выборка.Телефон) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен осн. телефон с " + ПолучитьПредставление(СокрЛП(Выборка.Телефон)) + " на " + ПолучитьПредставление(СокрЛП(Телефон));
		КонецЕсли;
		Если НЕ СокрЛП(ТелефонДополнительный) = СокрЛП(Выборка.ТелефонДополнительный) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен доп. телефон с " + ПолучитьПредставление(СокрЛП(Выборка.ТелефонДополнительный)) + " на " + ПолучитьПредставление(СокрЛП(ТелефонДополнительный));
		КонецЕсли;
		Если НЕ СокрЛП(Email) = СокрЛП(Выборка.Email) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен Email с " + ПолучитьПредставление(СокрЛП(Выборка.Email)) + " на " + ПолучитьПредставление(СокрЛП(Email));
		КонецЕсли;
		Если НЕ СокрЛП(АдресПоПрописке) = СокрЛП(Выборка.АдресПоПрописке) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен адрес по прописке с " + ПолучитьПредставление(СокрЛП(Выборка.АдресПоПрописке)) + " на " + ПолучитьПредставление(СокрЛП(АдресПоПрописке));
		КонецЕсли;
		Если НЕ СокрЛП(ФактическийАдрес) = СокрЛП(Выборка.ФактическийАдрес) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен факт. адрес с " + ПолучитьПредставление(СокрЛП(Выборка.ФактическийАдрес)) + " на " + ПолучитьПредставление(СокрЛП(ФактическийАдрес));
		КонецЕсли;
		Если НЕ СокрЛП(ПочтовыйАдрес) = СокрЛП(Выборка.ПочтовыйАдрес) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен почтовый адрес с " + ПолучитьПредставление(СокрЛП(Выборка.ПочтовыйАдрес)) + " на " + ПолучитьПредставление(СокрЛП(ПочтовыйАдрес));
		КонецЕсли;
		Если НЕ СокрЛП(КонтактноеЛицо) = СокрЛП(Выборка.КонтактноеЛицо) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменено контактное лицо с " + ПолучитьПредставление(СокрЛП(Выборка.КонтактноеЛицо)) + " на " + ПолучитьПредставление(СокрЛП(КонтактноеЛицо));
		КонецЕсли;
		Если НЕ СокрЛП(ТелефонКонтактногоЛица) = СокрЛП(Выборка.ТелефонКонтактногоЛица) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен осн. телефон конт. лица с " + ПолучитьПредставление(СокрЛП(Выборка.ТелефонКонтактногоЛица)) + " на " + ПолучитьПредставление(СокрЛП(ТелефонКонтактногоЛица));
		КонецЕсли;
		Если НЕ СокрЛП(ИсточникИнформации) = СокрЛП(Выборка.ИсточникИнформации) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменены источники информации с " + ПолучитьПредставление(СокрЛП(Выборка.ИсточникИнформации)) + " на " + ПолучитьПредставление(СокрЛП(ИсточникИнформации));
		КонецЕсли;
		Если НЕ СокрЛП(ИсточникИнформацииДругое) = СокрЛП(Выборка.ИсточникИнформацииДругое) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменены доп. источники информации с " + ПолучитьПредставление(СокрЛП(Выборка.ИсточникИнформацииДругое)) + " на " + ПолучитьПредставление(СокрЛП(ИсточникИнформацииДругое));
		КонецЕсли;
		Если НЕ СокрЛП(Комментарий) = СокрЛП(Выборка.Комментарий) Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменен комментарий с " + ПолучитьПредставление(СокрЛП(Выборка.Комментарий)) + " на " + ПолучитьПредставление(СокрЛП(Комментарий));
		КонецЕсли;
		Если НЕ ДатаСмерти = Выборка.ДатаСмерти Тогда
			Изменения =  Изменения + ?(ПустаяСтрока(Изменения), "", Символы.ПС) + "Изменена дата смерти с " + ПолучитьПредставление(Формат(Выборка.ДатаСмерти, "ДФ=dd.MM.yyyy")) + " на " + ПолучитьПредставление(Формат(ДатаСмерти, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
	КонецЕсли;
	Возврат Изменения;
КонецФункции

&НаСервере 
Функция ПроверитьИзмененияАнкеты(Изменения)
	
	ЗапросБ = Новый Запрос;
	ЗапросБ.УстановитьПараметр("Залогодатель", Залогодатель);  	
	ЗапросБ.Текст = "ВЫБРАТЬ
	|	ЛБ_БенефициарныеВладельцы.Бенефициар КАК Бенефициар,
	|	ЛБ_БенефициарныеВладельцы.ВидПолученияИнформации КАК ВидПолученияИнформации
	|ИЗ
	|	РегистрСведений.ЛБ_БенефициарныеВладельцы КАК ЛБ_БенефициарныеВладельцы
	|ГДЕ
	|	ЛБ_БенефициарныеВладельцы.Залогодатель = &Залогодатель
	|	И ЛБ_БенефициарныеВладельцы.Регистратор = &Регистратор
	|АВТОУПОРЯДОЧИВАНИЕ"; 
	
	ЗапросО = Новый Запрос;
	ЗапросО.УстановитьПараметр("Залогодатель", Залогодатель);
	ЗапросО.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтказыКлиентамВОбслуживании.ПричинаОтказа КАК ПричинаОтказа,
	|	ЛБ_ОтказыКлиентамВОбслуживании.ДатаОтказа КАК ДатаОтказа,
	|	ЛБ_ОтказыКлиентамВОбслуживании.СуммаЗаймаОтказ КАК СуммаЗаймаОтказ
	|ИЗ
	|	РегистрСведений.ЛБ_ОтказыКлиентамВОбслуживании КАК ЛБ_ОтказыКлиентамВОбслуживании
	|ГДЕ
	|	ЛБ_ОтказыКлиентамВОбслуживании.Регистратор = &Регистратор
	|	И ЛБ_ОтказыКлиентамВОбслуживании.Залогодатель = &Залогодатель";
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ДатаОформленияАнкеты КАК ДатаОформленияАнкеты,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ИНН КАК ИНН,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.СНИЛС КАК СНИЛС,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ТипФизЛица КАК ТипФизЛица,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.КатегорииФизЛица КАК КатегорииФизЛица,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ФинансовоеПоложениеСтабильное КАК ФинансовоеПоложениеСтабильное,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ДеловаяРепутацияПоложительная КАК ДеловаяРепутацияПоложительная,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмущества КАК ИсточникПроисхожденияИмущества,
	|	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмуществаИной КАК ИсточникПроисхожденияИмуществаИной,
