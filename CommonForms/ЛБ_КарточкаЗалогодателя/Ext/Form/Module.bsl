&НаСервере
Процедура ОчиститьОсновнойДок()  
	Для каждого стр из ДокументыЗалогодателя Цикл
		Если НЕ Стр.Основной Тогда
			Продолжить;
		КонецЕсли;	
		Если НЕ стр.Гражданство = Гражданство Тогда
			Стр.Основной = Ложь;
			Стр.ОсновнойДУЛ = ?(Стр.ОсновнойДУЛ, Ложь, Стр.ОсновнойДУЛ);
			Стр.ОсновнойДоп = ?(Стр.ОсновнойДоп, Ложь, Стр.ОсновнойДоп);
			Стр.ДокументИзменен = Истина;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура ГражданствоПриИзменении(Элемент)
	Если Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		Если НЕ ПустаяСтрока(Фамилия_А) Тогда
			Фамилия_А = "";
		ИначеЕсли НЕ ПустаяСтрока(Имя_А) Тогда
			Имя_А = "";
		ИначеЕсли НЕ ПустаяСтрока(Отчество_А) Тогда
			Отчество_А = "";
		КонецЕсли;	
	КонецЕсли;	
	ПоказатьФИО_А();  
	Если НЕ ГражданствоТекущее = Гражданство Тогда   
		ОчиститьОсновнойДок();
		Элементы.ДекорацияГражданство.Заголовок = " Действует с " + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=dd.MM.yyyy"); 
	Иначе
		Элементы.ДекорацияГражданство.Заголовок = " Действует с " + Формат(ДатаГражданство, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	// ++ Сербаев 16.05.2023
	ПоказатьРезиденство();
	// -- Сербаев 16.05.2023
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФИО_А()
	Если Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда		
		Элементы.ГруппаФИО_Англ.Видимость = ложь;
	Иначе
		Элементы.ГруппаФИО_Англ.Видимость = Истина;
		Если НЕ ПустаяСтрока(Фамилия_А) ИЛИ НЕ ПустаяСтрока(Имя_А) ИЛИ НЕ ПустаяСтрока(Отчество_А) Тогда
			Элементы.ГруппаФИО_Англ.Показать();
		КонецЕсли;
		Если ПустаяСтрока(Фамилия_А) Тогда
			Элементы.Имя_А.Доступность      = Ложь;
			Элементы.Отчество_А.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура Фамилия_АПриИзменении(Элемент)
	
	Фамилия_А = ТРег(Фамилия_А); 
	Если СтрДлина(Фамилия_А) > 0 Тогда 
		
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Фамилия_А, "Фамилия");
		Если ТекстОшибки <> "" Тогда
			ЛБ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Фамилия_А");
			Возврат;
		КонецЕсли;
		
		// ++ Сербаев 07.06.2023
		ТолькоЛатиницаВСтроке = СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Фамилия_А, , " -");
		//ТолькоЛатиницаВСтроке = СтроковыеФункцииКлиентКлиентСерверРФ.ТолькоЛатиницаВСтроке(Фамилия_А, , " -");
		// -- Сербаев 07.06.2023
		Если Не ТолькоЛатиницаВСтроке Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Строка ""Фамилия"" должна содержать только символы кириллицы!'"), , ,"Фамилия_А");
			Возврат;
		КонецЕсли;
		
		Элементы.Имя_А.Доступность = Истина;
		
	ИначеЕсли Фамилия_А = "" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Поле ""Фамилия"" не заполнено.'"), , , "Фамилия_А");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Имя_АПриИзменении(Элемент) 
	
	Имя_А = ТРег(Имя_А);
	Если СтрДлина(Имя_А) > 0 Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Имя_А, "Имя");
		Если ТекстОшибки <> "" Тогда
			ЛБ_ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Имя_А");
			Возврат;
		КонецЕсли; 
		
		// ++ Сербаев 07.06.2023
		ТолькоЛатиницаВСтроке = СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Имя_А, , " -");
		//ТолькоЛатиницаВСтроке = СтроковыеФункцииКлиентСерверРФ.ТолькоЛатиницаВСтроке(Имя_А, , " -");
		// -- Сербаев 07.06.2023
		Если Не ТолькоЛатиницаВСтроке Тогда
