&НаКлиенте
Процедура ЗапуститьФоновоеЗадание()
    ИдентификаторЗадания = ЗапуститьФоновоеЗаданиеНаСервере();
    ОжиданиеВыполнения = Новый ОписаниеОповещения("ПроверитьВыполнениеЗадания", ЭтаФорма);
    ПодключитьОбработчикОжидания("ПроверитьВыполнениеЗадания", 1, Ложь);
КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗаданиеНаСервере()
    ПараметрыЗадания = Новый Массив;
	СписокЗБ = Новый СписокЗначений;
	Для Каждого Стр Из ТаблицаЗБ Цикл
	    СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
	КонецЦикла;    
	ПараметрыЗадания.Добавить(СписокЗБ);   
	ПараметрыЗадания.Добавить(ДатаСмерти);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("ЛБ_УправлениеЛомбардом.ВыполнитьОбработкуДанныхТаблицыЗБ", ПараметрыЗадания);
    Возврат ФоновоеЗадание.УникальныйИдентификатор;
КонецФункции

&НаКлиенте
Процедура ПроверитьВыполнениеЗадания() Экспорт
    Результат = ПроверитьВыполнениеЗаданияНаСервере();
    
    Если Результат.Выполнено Тогда
        ОтключитьОбработчикОжидания("ПроверитьВыполнениеЗадания");
        //ПоказатьОповещениеПользователя("Результат обработки", , Результат.ТекстРезультата);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьВыполнениеЗаданияНаСервере()
    Результат = Новый Структура("Выполнено, ТекстРезультата", Ложь, "");
    
    ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания); 
	СообщенияИзФона = ФоновоеЗадание.ПолучитьСообщенияПользователю(Истина);
	Для Каждого Сообщ Из СообщенияИзФона Цикл
		ОбработатьСообщениеФЗ(Сообщ.Текст);
	КонецЦикла;
    
    Если ФоновоеЗадание <> Неопределено И ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
        Результат.Выполнено = Истина;
       // Результат.ТекстРезультата = ФоновоеЗадание.ПолучитьРезультат();
	   ФоновоеЗадание.Отменить();
    КонецЕсли;
    
    Возврат Результат;
КонецФункции     

&НаСервере
Процедура ОбработатьСообщениеФЗ(Сообщ)
	Поз = Найти(Сообщ, ";");
	НомерЗБ = Лев(Сообщ, Поз-1);
	Сообщ = Сред(Сообщ, Поз+1);
	
	Поз = Найти(Сообщ, ";"); 
	ПроцентнаяСтавка = СокрЛП(Лев(Сообщ, Поз-1));
	Сообщ = Сред(Сообщ, Поз+1);

	Поз = Найти(Сообщ, ";"); 
	СуммаПроцентовВДень = СокрЛП(Лев(Сообщ, Поз-1));
	Сообщ = Сред(Сообщ, Поз+1);
	
	Поз = Найти(Сообщ, ";");   
	//Попытка
	    Долг = Число(СокрЛП(Лев(Сообщ, Поз-1))); 
	//Исключение   
	//	Долг = 0;
	//КонецПопытки;   
	Сообщ = Сред(Сообщ, Поз+1);
	
	ЕстьДоверенность = СокрЛП(Сообщ);
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерЗБ", НомерЗБ);
	СтрокиЗБ = ТаблицаЗБ.НайтиСтроки(Отбор);
	Если НЕ СтрокиЗБ.Количество() = 0 Тогда 
		 СтрЗБ = СтрокиЗБ.Получить(0); 
		 СтрЗБ.ПроцентнаяСтавка = ПроцентнаяСтавка;
		 СтрЗБ.СуммаПроцентовВДень = СуммаПроцентовВДень; 
		 СтрЗБ.Долг = Долг;  
		 СтрЗБ.Доверенность = ?(ЕстьДоверенность = "да", истина, ложь);  
		 
		 Элементы.ТаблицаЗБ.Обновить();
    КонецЕсли;
КонецПроцедуры 


&НаКлиенте
Процедура ВыборЗБПриИзменении(Элемент)
	Если ВыборЗБ = 3 Тогда 
		Параметрыформы = Новый структура;
		Параметрыформы.Вставить("НомерЗБ", НомерЗБ);  
		ОбработкаВвода = Новый ОписаниеОповещения("ПослеВводаНомераЗБ", ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВводаНомераЗБ", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВвода, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе            
		//ЗаполнитьСписокЛомбардов();
		УстановитьОтборНаСервере();  
		Элементы.НомерЗБ.Видимость = Ложь; 
		ТекущийВыборЗБ = ВыборЗБ;
	КонецЕсли;	
	
КонецПроцедуры    

&НаКлиенте
Процедура ПослеВводаНомераЗБ(Результат, ДопПараметры) Экспорт  
	Если Результат = Неопределено Тогда
		ВыборЗБ = ТекущийВыборЗБ;
		Возврат;
	КонецЕсли;
	
	НомерЗБ = Результат;
	СообщениеЗБ = ПолучитьЗБОдин();  
	Если Пустаястрока(СообщениеЗБ) Тогда
		Элементы.НомерЗБ.Видимость = Истина;   
		СтрокаНомерЗБ = "№ ЗБ " + СокрЛП(НомерЗБ); 			
		ТекущийВыборЗБ = 3; 
	Иначе      
		Предупреждение(СообщениеЗБ, 60);
		ОбработкаВвода = Новый ОписаниеОповещения("ПослеВводаНомераЗБ", ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВводаНомераЗБ", , ЭтаФорма,,,,ОбработкаВвода, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьЗБОдин() 
	ЗБ = ЛБ_ОбщийМодуль.ПолучитьЗБПоНомеру(СокрЛП(НомерЗБ), Ложь);  
	Если ЗначениеЗаполнено(ЗБ) Тогда
		Если ЗБ.Залогодатель = Залогодатель Тогда
			Элементы.Ломбард.СписокВыбора.Очистить();
			Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
		   	УстановитьОтборНаСервере(ЗБ);
	        Возврат "";  
		Иначе
			Возврат "Залоговый билет клиента № " + СокрЛП(НомерЗБ) + " не найден!";
		КонецЕсли;
	Иначе 
		Возврат "Залоговый билет клиента № " + СокрЛП(НомерЗБ) + " не найден!";
	КонецЕсли;	
КонецФункции

&НаСервере
Процедура УстановитьОтборНаСервере(ЗБ = неопределено)
	Отбор = Новый Структура;
	Если НЕ ЗБ = неопределено Тогда
		Отбор.Вставить("ЗалоговыйБилет", ЗБ);
	Иначе
		Если ЗначениеЗаполнено(Ломбард) Тогда
			Отбор.Вставить("Ломбард", Ломбард);
		КонецЕсли;	
		Если ВыборЗБ = 2 Тогда 
			Отбор.Вставить("Действующий", Истина);
		КонецЕсли;	   
		//+МАН 17.02.26
		ЗаполнитьСписокЛомбардов();
		//-МАН
	КонецЕсли;	   
	
	Элементы.ТаблицаЗБ.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	Элементы.ТаблицаЗБ.Обновить();
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокЗБ() 	
	ТаблицаЗапроса = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель);   
	ЗаполнитьТаблицуЗБ(ТаблицаЗапроса)
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСписокЛомбардов()
	Элементы.Ломбард.СписокВыбора.Очистить(); 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если ТекПользователь.ЭтоЛомбард Тогда
		ТекЛомбард = ПараметрыСеанса.ТекущийЛомбард;  
		//+МАН 28.01.26 Заявка 3649
		ТЗЛомбардыОтделения = ПолучитьЛомбардыОтделения(ТекЛомбард);
		//-МАН
	Иначе
		ТекЛомбард = неопределено;
	КонецЕсли;  

	//+МАН 28.01.26 Изменение порядка ломбардов в списке выбора. Заявка 3649
	ТЗЛомбарды = ТаблицаЗБ.Выгрузить(, "Ломбард");
	ТЗЛомбарды.Свернуть("Ломбард");
			
	Если ТекЛомбард <> Неопределено Тогда
		Если ТЗЛомбардыОтделения <> Неопределено Тогда
			
			МассивУдалениИзСпискаЛомбардов = Новый Массив;
			МассивУдалениИзСпискаОтделения = Новый Массив;
			
			Для каждого СтрЛомб Из ТЗЛомбардыОтделения Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Ломбард", СтрЛомб.Ломбард);
				
				НайденныйЛомбард = ТЗЛомбарды.НайтиСтроки(Отбор);
				
				Если СтрЛомб.Ломбард = ТекЛомбард И НайденныйЛомбард.Количество() > 0 Тогда
					МассивУдалениИзСпискаЛомбардов.Добавить(НайденныйЛомбард[0]);
					МассивУдалениИзСпискаОтделения.Добавить(СтрЛомб);
				ИначеЕсли НайденныйЛомбард.Количество() > 0 Тогда
					МассивУдалениИзСпискаЛомбардов.Добавить(НайденныйЛомбард[0]);
				Иначе
					МассивУдалениИзСпискаОтделения.Добавить(СтрЛомб);
				КонецЕсли;
			КонецЦикла;
			
			Для каждого СтрМ Из МассивУдалениИзСпискаЛомбардов Цикл
				ТЗЛомбарды.Удалить(СтрМ);
			КонецЦикла;
			
			Для каждого СтрМ Из МассивУдалениИзСпискаОтделения Цикл
				ТЗЛомбардыОтделения.Удалить(СтрМ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//+МАН 28.01.26 Закомментировал, то что было ранее.
	//Для каждого Стр Из ТаблицаЗБ цикл  
	//	Если Элементы.Ломбард.СписокВыбора.НайтиПоЗначению(стр.Ломбард) = неопределено Тогда 
	//		Если НЕ стр.Ломбард = ТекЛомбард Тогда
	//		    Элементы.Ломбард.СписокВыбора.Добавить(стр.Ломбард, стр.Ломбард.НаименованиеПолное);  
	//		КонецЕсли;	
	//	КонецЕсли;	
	//Конеццикла;      	
	//Элементы.Ломбард.СписокВыбора.СортироватьПоПредставлению();

	ТЗЛомбарды = СортироватьТЗЛомбарды(ТЗЛомбарды);

	Для каждого Стр Из ТЗЛомбарды Цикл
		Если Элементы.Ломбард.СписокВыбора.НайтиПоЗначению(стр.Ломбард) = Неопределено Тогда
		    Элементы.Ломбард.СписокВыбора.Добавить(стр.Ломбард, стр.Ломбард.НаименованиеПолное);
		КонецЕсли;
	Конеццикла;
	
	//Элементы.Ломбард.СписокВыбора.СортироватьПоПредставлению();
	
	Если ТекЛомбард <> Неопределено Тогда
		Для каждого Стр Из ТЗЛомбардыОтделения Цикл
			Если Элементы.Ломбард.СписокВыбора.НайтиПоЗначению(стр.Ломбард) = Неопределено Тогда
				Элементы.Ломбард.СписокВыбора.Вставить(0, стр.Ломбард, стр.Ломбард.НаименованиеПолное); 
			КонецЕсли;
		Конеццикла;
	КонецЕсли;
	//-МАН
	
	Если НЕ ТекЛомбард = неопределено Тогда
		Элементы.Ломбард.СписокВыбора.Вставить(0, ТекЛомбард, ТекЛомбард.НаименованиеПолное); 
	КонецЕсли;	
	Если Элементы.Ломбард.СписокВыбора.Количество() > 1 Тогда 
		Элементы.Ломбард.СписокВыбора.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка(), "Все ломбарды");
	КонецЕсли;    
	Если НЕ ЗначениеЗаполнено(Ломбард) Тогда
		Если Элементы.Ломбард.СписокВыбора.Количество() > 0 Тогда 
			Если НЕ ТекЛомбард = неопределено Тогда
		         Ломбард = Элементы.Ломбард.СписокВыбора.Получить(0).Значение;
			Иначе
				 Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция СоздатьНовуюОплатуПроцентов(Дата, ЗалоговыйБилет)
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет; 
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	ДокументОбъект.Дата = Дата; 
	ДокументОбъект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	ДокументОбъект.ПроцентнаяСхема = ЗалоговыйБилет.ПроцентнаяСхема;  
	Возврат ДокументОбъект; 
КонецФункции

&НаСервере
Функция РасчитатьДолгПоПроцентам(Дата, ЗалоговыйБилет, СуммаЗайма, ПричинаПримененияПроцентнойСхемы, ДатаНачалаРасчета) 
	ДокументОбъект = СоздатьНовуюОплатуПроцентов(Дата, ЗалоговыйБилет); 	    
		   
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
	Если НЕ СтруктураП = неопределено Тогда
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
	Иначе
		ПредельноеЗначениеПроцентов = 0;
	КонецЕсли;   
	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр); 
			
	Возврат Результат.СуммаПроцентов;
КонецФункции

&НаСервере
Функция ЕстьДоверенности(ЗБ)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);  
	Запрос.УстановитьПараметр("СтатусДоверенности", Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ДоверенностиСрезПоследних
	               |ГДЕ
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности = &СтатусДоверенности";
	ТаблицаД = Запрос.Выполнить().Выгрузить();
	ДатаПроверки = ТекущаяДатаСеанса();
	Для каждого стрД из ТаблицаД цикл   
		Если СтрД.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			ДоверенностьДействует = Истина;
			Если СтрД.Доверенность.СрокДействияДоверенности >= НачалоДня(ДатаПроверки) Тогда 
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.Клиент, ДатаПроверки) = неопределено Тогда   
					ДоверенностьДействует = Ложь;
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, ДатаПроверки) = неопределено Тогда  
                    ДоверенностьДействует = Ложь;					
				КонецЕсли;	              
			ИначеЕсли СтрД.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(СтрД.Доверенность.ПредставительКлиента, ДатаПроверки) = неопределено Тогда  
					ДоверенностьДействует = Ложь;	
				КонецЕсли;	
			Иначе                         	
				ДоверенностьДействует = Ложь;
			КонецЕсли;  
		Иначе
			ДоверенностьДействует = Ложь;
		КонецЕсли; 
		Если ДоверенностьДействует Тогда  
			Возврат Истина;
        КонецЕсли;
	КонецЦикла;  
  	Возврат Ложь;
КонецФункции

&НаСервере
Функция ПолучитьТекущуюПроцентнуюСтавку(ЗалоговыйБилет, ПричинаПрименения)
	СтавкаП = 0;
	ДатаКонРезультат = ТекущаяДатаСеанса();
	
	ТаблицаСтавок = ЗалоговыйБилет.ПроцентныеСтавкиПоПериодам.Выгрузить();
	УдСтроки = новый СписокЗначений;
	Для каждого стр Из ТаблицаСтавок Цикл 
		Если Стр.ПричинаПрименения =  ПричинаПрименения Тогда
			Продолжить;
		КонецЕсли;
		УдСтроки.Добавить(Стр);
	Конеццикла;	               
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаСтавок.Удалить(Эл.Значение);
	Конеццикла;	  
	
	Если ТаблицаСтавок.Количество() > 0 Тогда
		СтрС = ТаблицаСтавок.Получить(0);  
		СтавкаП = СтрС.ПроцентнаяСтавка; 
		Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
			Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
				СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
				СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
				СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
		    КонецЕсли; 
		КонецЕсли;	
	КонецЕсли;	
  
   	Возврат СтавкаП;
КонецФункции

