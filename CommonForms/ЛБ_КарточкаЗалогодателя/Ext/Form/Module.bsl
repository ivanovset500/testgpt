&НаКлиенте 
Процедура НапечататьСогласиеНаОпробование_Word()
	
	Shell   = Новый COMОбъект("WScript.Shell");
	temp    = Shell.ExpandEnvironmentStrings("%temp%");
	Каталог = temp + "\";
	Если ПустаяСтрока(Каталог) Тогда
		Сообщить("Не выбрана каталог временных файлов");
		Возврат;
	КонецЕсли;
	//ИмяФайла           = СокрЛП(Залогодатель) + "_" + Формат(ТекущаяДата(), "ДФ=dd-MM-yyyy");
	ИмяФайла           = СтрШаблон("%1_%2_%3", СокрЛП(Залогодатель), Формат(ТекущаяДата(), "ДФ=dd-MM-yyyy"), Элементы.ФормаСогласиеНаОпробование.Заголовок);
	ИмяФайла           = СтрЗаменить(ИмяФайла, " ", "_");
	ИмяВременногоФайла = Каталог + ИмяФайла + ".doc";
	
	ШаблонДокумента = ПредопределенноеЗначение("Справочник.ЛБ_ШаблоныПечатиДокументов.СогласиеНаОпробование");
	ДвоичныеДанные = МакетПечатнойФормы(ШаблонДокумента);	
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		Word = Новый COMОбъект("Word.Application");
		ВордДокумент = Word.Documents.Open(ИмяВременногоФайла); 
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось создать документ Word. " + ОписаниеОшибки());							
		Word = Неопределено;
		Возврат;
	КонецПопытки;
	
	ПаспортныеДанныеСтруктура = ПаспортныеДанныеКлиента();
	
	ActiveDocument = Word.ActiveDocument;
	ВывестиПараметрНаПечать(ActiveDocument, "ТекДата",              Формат(ОбщегоНазначенияКлиент.ДатаСеанса(),"ДФ=dd.MM.yyyy"));
	ВывестиПараметрНаПечать(ActiveDocument, "ФИО",                  СокрЛП(Фамилия) + " " + СокрЛП(Имя) + ?(НЕ ПустаяСтрока(Отчество), " " + СокрЛП(Отчество), ""));
	ВывестиПараметрНаПечать(ActiveDocument, "ДатаРождения",         Формат(ДатаРождения, "ДФ=dd.MM.yyyy"));
	ВывестиПараметрНаПечать(ActiveDocument, "ПаспортныеДанные",     ПаспортныеДанныеСтруктура.ПаспортныеДанные);
	ВывестиПараметрНаПечать(ActiveDocument, "АдресМестаЖительства", ?(Не ПустаяСтрока(АдресПоПрописке), АдресПоПрописке, ФактическийАдрес)); 
	ВывестиПараметрНаПечать(ActiveDocument, "Согласен",             ?(Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский"), "согласна", "согласен"));
	
	ВордДокумент.Application.ActiveDocument.Protect(1, ИСТИНА, Строка(Этаформа.КлючУникальности), Ложь, ИСТИНА);
	ВордДокумент.SaveAs(ИмяВременногоФайла);
	ВордДокумент.Close(Истина); 
	
	ЗапуститьПриложение(ИмяВременногоФайла); 
	
КонецПроцедуры

