&НаКлиенте
Процедура ТелефонОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	Если СокрЛП(Текст) = "+7 (   )" Тогда
		Возврат;
	КонецЕсли;

	СтруктураПроверки = ПроверитьМобильныйТелефон(Текст);
	
	Если СтруктураПроверки.ТолькоНули Тогда
		Предупреждение("Телефон клиента не может содержать только нули!");
		ПодключитьОбработчикОжидания("ВернутьКурсорНаПолеВвода", 0.1, Истина);
	КонецЕсли;
	
	Если НЕ СтруктураПроверки.ТелефонОК Тогда
		Предупреждение("Телефон должен начинаться с 9 и содержать 10 цифр. Введите корректное значение или очистите поле.");
		ПодключитьОбработчикОжидания("ВернутьКурсорНаПолеВвода", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

