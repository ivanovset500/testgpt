		НоваяСтр.ДокументНаименованиеИногоДокумента = Результат.НаименованиеИногоДокумента;
		// -- Сербаев 14.06.2023
		НоваяСтр.ДокументДатаВыдачи = Результат.ДатаВыдачи;
		НоваяСтр.ДокументКемВыдан = Результат.КемВыдан;
		НоваяСтр.ДокументКодПодразделения = Результат.КодПодразделения;
		НоваяСтр.ДокументСерия = Результат.Серия;
		НоваяСтр.ДокументНомер = Результат.Номер;
		НоваяСтр.ДокументСрокДействия = Результат.СрокДействия;
		НоваяСтр.ПричинаИзменения = ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.НовыйДокумент");

		//+МАН 04.12.25
		НоваяСтр.ДокументНачалоДействия = Результат.НачалоДействия;
		//-МАН
		
		Если НоваяСтр.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти") Тогда
			НоваяСтр.ДатаСмерти = Результат.ДатаСмерти;
			ДатаСмерти = Результат.ДатаСмерти; 
			Элементы.ДекорацияИнформацияОСмерти.Заголовок = "Клиент умер. Дата смерти " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy"); 
			Элементы.ГруппаСтатус.Видимость = Истина;
		КонецЕсли;		   
		НоваяСтр.ДокументИзменен = Истина;
		
		//проверим недействительность свидетельства о рождении если есть паспорт
		//Если Результат.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ") Тогда
		// 	ОтборД = Новый структура;
		// 	ОтборД.Вставить("ВидДокумента", ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОРождении"));
		// 	ОтборД.Вставить("ДокументНеДействителен", Ложь);
		// 	СтрокиД = ДокументыЗалогодателя.НайтиСтроки(ОтборД);
		// 	Для каждого СтрД Из СтрокиД цикл
		// 		СтрД.ДокументНеДействителен = Истина;
		// 	Конеццикла;	
		// КонецЕсли;
		ДокументыЗалогодателя.Сортировать("Основной УБЫВ, ДокументНачалоДействия УБЫВ, ВидДокументаЗалогодателя");
		
		// ++ Сербаев 16.05.2023
		ПоказатьРезиденство();
		// -- Сербаев 16.05.2023
		ПроверитьСтатусПочетный();
	КонецЕсли;
	
КонецПроцедуры	

