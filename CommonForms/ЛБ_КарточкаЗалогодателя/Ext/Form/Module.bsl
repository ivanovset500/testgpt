#Область ЭДО 

&НаКлиенте
Процедура ЗаключитьЭДО(Команда)
	Проверка = ПроверитьИЗаписать(Ложь);
	Если Проверка Тогда
		Если ДатаСмерти = Дата(1,1,1) Тогда
			Если ЗначениеЗаполнено(Телефон) Тогда
				ЛБ_СоглашенияЭДОКлиент.ОбработкаКоманд(Команда.Имя, Залогодатель,,,ЭтаФорма);
				НаличиеЭДО = ЛБ_СоглашенияЭДОСервер.НаличиеДействующегоСоглашения(Залогодатель);
				
				Если НаличиеЭДО Тогда
					Элементы.СтатусЭДО.Заголовок = "есть";
				Иначе
					Элементы.СтатусЭДО.Заголовок = "нет";
				КонецЕсли;
			Иначе
				Предупреждение("Для заключения ЭДО заполните номер телефона",, "Номер телефона не заполнен");
			КонецЕсли;
		Иначе
			Предупреждение("Клиент умер. Дата смерти " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

