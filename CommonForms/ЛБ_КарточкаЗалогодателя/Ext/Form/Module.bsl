	Иначе
		Элементы.ГруппаДЛПМО_РДПЛРасшифровка.Видимость = Ложь;
		КатегорияДЛПМО_РДПЛ = ПредопределенноеЗначение("Перечисление.ЛБ_КатегорииДЛПМО_РДПЛ.ПустаяСсылка");
		ДопИнформацияДЛПМО_РДПЛ = "";
