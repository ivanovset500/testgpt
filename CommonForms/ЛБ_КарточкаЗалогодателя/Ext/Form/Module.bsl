//+МАН 15.12.25 Обрезанная версия функции ПроверитьТелефоны.
&НаСервере
Функция ПроверитьМобильныйТелефон(ВводимыйТелефон)
	ТелефонОК = Истина;
	Если НЕ ПустаяСтрока(ВводимыйТелефон) Тогда
		ТелефонДляПроверки = СокрЛП(ВводимыйТелефон);
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, " ", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "+", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, "(", "");
		ТелефонДляПроверки = СтрЗаменить(ТелефонДляПроверки, ")", "");
		Если НЕ СтрДлина(ТелефонДляПроверки) = 11 Тогда
			ТелефонОК = Ложь;
		КонецЕсли;
		ТолькоНули = Истина;
		ТелефонДляПроверки = Прав(ТелефонДляПроверки, СтрДлина(ТелефонДляПроверки)-2);
		Для сч = 1 по СтрДлина(СокрЛП(ТелефонДляПроверки)) Цикл
			Если Сред(СокрЛП(ТелефонДляПроверки), сч, 1) = "0" Тогда
				Продолжить;
			КонецЕсли;
			ТолькоНули = Ложь;
			Прервать;
		Конеццикла;
		Если ТолькоНули Тогда  
			ТелефоныОК = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТелефонОК", ТелефонОК);
	СтруктураВозврата.Вставить("ТолькоНули", ТолькоНули);
	
	Возврат СтруктураВозврата;
КонецФункции

&НаКлиенте
Процедура СогласиеНаСМСРассылкуПриИзменении(Элемент)
	
	Если СокрЛП(Телефон) = "" Тогда
		Предупреждение("Номер телефона не заполнен.");
		СогласиеНаСМСРассылку = Ложь;
		Возврат;
	КонецЕсли;
	
	СтруктураПроверки = ПроверитьМобильныйТелефон(Телефон);
	
	Если НЕ СтруктураПроверки.ТелефонОК ИЛИ СтруктураПроверки.ТолькоНули Тогда
		Предупреждение("Телефон должен начинаться с 9 и содержать 10 цифр. Введите корректное значение или очистите поле.");
		СогласиеНаСМСРассылку = Ложь;
		Возврат;
	КонецЕсли;
	
	Если СтруктураПроверки.ТелефонОК И СогласиеНаСМСРассылку Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросСМСРассылки", ЭтаФорма); 
		ПоказатьВопрос(Оповещение, "На указанный номер будут приходить СМС оповещения об окончании льготного срока",
		РежимДиалогаВопрос.ОК, 0,,"Проинформируйте клиента:");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗБПриАктивизацииСтроки(Элемент)
	ЭтоЛомбард = ПользовательЛомбард();
	
	ТекСтр = Элементы.ТаблицаЗБ.ТекущиеДанные;
	
	Если ТекСтр <> Неопределено Тогда
		Если ТекСтр.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Реализован") И ЭтоЛомбард  Тогда
			Элементы.ТекущееСостояниеЗБ.Доступность = Ложь;
		Иначе
			Элементы.ТекущееСостояниеЗБ.Доступность = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

