&НаКлиенте
Процедура ПослеИзмененияДокумента(Результат, Параметры) Экспорт
	Если НЕ Результат = неопределено Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", Результат.КлючСтроки);
		Строки = ДокументыЗалогодателя.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			НоваяСтр = Строки.Получить(0);
			ЕстьИзменения = ложь;
			Если НЕ НоваяСтр.Гражданство = Результат.Гражданство Тогда
				НоваяСтр.Гражданство = Результат.Гражданство;
				ЕстьИзменения = Истина;
			КонецЕсли;
			// ++ Сербаев 25.05.2023 TODO: Сербаев
			Если НЕ НоваяСтр.ДокументСтранаЭмитент = Результат.СтранаЭмитент Тогда
				НоваяСтр.ДокументСтранаЭмитент = Результат.СтранаЭмитент;
				ЕстьИзменения = Истина;
			КонецЕсли;
			// -- Сербаев 25.05.2023 
			// ++ Сербаев 14.06.2023 (иной документ)
			Если НЕ НоваяСтр.ДокументНаименованиеИногоДокумента = Результат.НаименованиеИногоДокумента Тогда
				НоваяСтр.ДокументНаименованиеИногоДокумента = Результат.НаименованиеИногоДокумента;
				ЕстьИзменения = Истина;
			КонецЕсли;
			// -- Сербаев 14.06.2023
			Если НЕ НоваяСтр.ДокументДатаВыдачи = Результат.ДатаВыдачи Тогда
				НоваяСтр.ДокументДатаВыдачи = Результат.ДатаВыдачи;
				ЕстьИзменения = Истина;
			КонецЕсли;
			Если НЕ НоваяСтр.ДокументКемВыдан = Результат.КемВыдан Тогда
				НоваяСтр.ДокументКемВыдан = Результат.КемВыдан;                 
				ЕстьИзменения = Истина;
			КонецЕсли;	
			Если НЕ НоваяСтр.ДокументКодПодразделения = Результат.КодПодразделения Тогда
				НоваяСтр.ДокументКодПодразделения = Результат.КодПодразделения;
				ЕстьИзменения = Истина;
			КонецЕсли;	
			Если НЕ НоваяСтр.ДокументСерия = Результат.Серия Тогда
				НоваяСтр.ДокументСерия = Результат.Серия;
				ЕстьИзменения = Истина;
			КонецЕсли;	
			Если НЕ НоваяСтр.ДокументНомер = Результат.Номер Тогда
				НоваяСтр.ДокументНомер = Результат.Номер;
				ЕстьИзменения = Истина;
			КонецЕсли;	
			Если НЕ НоваяСтр.ДокументСрокДействия = Результат.СрокДействия Тогда
				НоваяСтр.ДокументСрокДействия = Результат.СрокДействия;
				ЕстьИзменения = Истина;
			КонецЕсли;	
			Если НЕ НоваяСтр.ДокументНеДействителен = Результат.НеДействителен Тогда
				НоваяСтр.ДокументНеДействителен = Результат.НеДействителен;
				ЕстьИзменения = Истина;
				Если Результат.НеДействителен И НоваяСтр.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти") Тогда
					ДатаСмерти = Дата(1,1,1);
				КонецЕсли;	
			КонецЕсли;	 
			Если НЕ НоваяСтр.ДокументДействителен = Результат.Действителен Тогда
				НоваяСтр.ДокументДействителен = Результат.Действителен;
				ЕстьИзменения = Истина;
			КонецЕсли;	
			ЕстьИзмененияДатыСмерти = Ложь;
			Если НоваяСтр.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти") Тогда
				Если НЕ НоваяСтр.ДатаСмерти = Результат.ДатаСмерти Тогда
					НоваяСтр.ДатаСмерти = Результат.ДатаСмерти;
					ЕстьИзменения = Истина;    
					ЕстьИзмененияДатыСмерти = Истина;
					Если НЕ Результат.НеДействителен Тогда
						ДатаСмерти = Результат.ДатаСмерти;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			НоваяСтр.ДокументИзменен = ?(ЕстьИзменения, Истина, НоваяСтр.ДокументИзменен);
			Если ЕстьИзменения Тогда
				//+МАН 04.12.25 Закомментировал. Начало действия есть и его не нужно обнулять.
				//НоваяСтр.ДокументНачалоДействия = Дата(1,1,1);
				//-МАН
				// ++ Сербаев 25.05.2023 TODO: Сербаев
				НоваяСтр.ПричинаИзменения = ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИсправлениеДанныхДокумент");
				// -- Сербаев 25.05.2023
			КонецЕсли;	
		КонецЕсли;	
		ПроверитьДействительностьДокументов();   
		ПроверитьСтатусПочетный();
		ПоказатьРезиденство();     
		Если ЕстьИзмененияДатыСмерти Тогда
			Если НЕ ДатаСмерти = Дата(1,1,1) тогда
				Элементы.ДекорацияИнформацияОСмерти.Заголовок = "Клиент умер. Дата смерти " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy"); 
				Элементы.ГруппаСтатус.Видимость = Истина;
			Иначе 
				Элементы.ДекорацияИнформацияОСмерти.Заголовок = ""; 
				Элементы.ГруппаСтатус.Видимость = Ложь;
			КонецЕсли;	
		КонецЕсли;
		ДокументыЗалогодателя.Сортировать("Основной УБЫВ, ДокументНачалоДействия УБЫВ, ВидДокументаЗалогодателя"); 
	КонецЕсли;
КонецПроцедуры	

