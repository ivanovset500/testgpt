&НаСервере
Функция МакетПечатнойФормы(ШаблонДокумента)
	
	Если НЕ ТипЗнч(ШаблонДокумента.ХранилищеШаблона.Получить()) = Тип("ДвоичныеДанные") Тогда
		Сообщить("Шаблон печати анкеты не загружен!");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ШаблонДокумента.ХранилищеШаблона.Получить();
	
КонецФункции 

&НаКлиенте
Процедура ВывестиПараметрНаПечать(ОбъектДокумент, ИмяПараметра, ЗначениеПараметра) 
	
	ЗначениеДляПодстановки = "" + ЗначениеПараметра;
	
	Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		ЗначениеДляПодстановки = "                    ";
	КонецЕсли;	
	
	СтрокаПоиска 	= "[" + ИмяПараметра + "]";
	ВесьДок			= ОбъектДокумент.Content;			// Присвоить переменной содержимое документа
	Поиск 			= Весьдок.Find;
	Поиск.Text 		= СтрокаПоиска;
	Поиск.Execute();		
	
	Пока Поиск.Found Цикл
		
		ВесьДок.Text 	= ЗначениеДляПодстановки;
		
		ВесьДок			= ОбъектДокумент.Content;			// Присвоить переменной содержимое документа
		Поиск 			= Весьдок.Find;
		Поиск.Text 		= СтрокаПоиска;
		Поиск.Execute();
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПаспортныеДанныеКлиента(ДокументСПрописнойБуквы = Ложь)
	
	Результат = Новый Структура("ПаспортныеДанные, ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения", "", "", "", "", "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента.Представление КАК ВидДокумента,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК КемВыдан,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА """"
	|		ИНАЧЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи
	|	КОНЕЦ КАК ДатаВыдачи,
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК КодПодразделения
	|ИЗ
	|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	|ГДЕ
	|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя = &ДУЛ
	|	И НЕ ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен
	|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ";
	
	Запрос.УстановитьПараметр("ДУЛ", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		
		ВидДокументаВыборка = ?(ДокументСПрописнойБуквы, СтрШаблон("%1%2", НРег(Лев(Выборка.ВидДокумента, 1)), Сред(Выборка.ВидДокумента, 2)), Выборка.ВидДокумента);
		
		ВидДокумента     = ?(ПустаяСтрока(ВидДокументаВыборка),      "", СтрШаблон(" %1:",                    ВидДокументаВыборка));
		Серия            = ?(ПустаяСтрока(Выборка.Серия),            "", СтрШаблон(" серия %1",              Выборка.Серия));
		Номер            = ?(ПустаяСтрока(Выборка.Номер),            "", СтрШаблон(" номер %1,",              Выборка.Номер));
		КемВыдан         = ?(ПустаяСтрока(Выборка.КемВыдан),         "", СтрШаблон(" выдан: %1,",             Выборка.КемВыдан));
		ДатаВыдачи       = ?(ПустаяСтрока(Выборка.ДатаВыдачи),       "", СтрШаблон(" дата выдачи: %1,",       Формат(Выборка.ДатаВыдачи,"ДФ=dd.MM.yyyy")));
		КодПодразделения = ?(ПустаяСтрока(Выборка.КодПодразделения), "", СтрШаблон(" код подразделения: %1,", Выборка.КодПодразделения)); 
		
		Результат.Вставить("ПаспортныеДанные", СтрШаблон("%1%2%3%4%5%6", ВидДокумента, Серия, Номер, КемВыдан, ДатаВыдачи, КодПодразделения));
		Результат.Вставить("ВидДокумента",     Выборка.ВидДокумента);
		Результат.Вставить("Серия",            Выборка.Серия);
		Результат.Вставить("Номер",            Выборка.Номер);
		Результат.Вставить("КемВыдан",         Выборка.КемВыдан);
		Результат.Вставить("ДатаВыдачи",       Выборка.ДатаВыдачи);
		Результат.Вставить("КодПодразделения", Выборка.КодПодразделения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ПолучитьДанныеДляПечатиЗаявлениеНаВозвратБезналичнойОплаты(ФИО) 
	
	ДанныеДляПечати = Новый Структура;
	
	ПаспортныеДанныеСтруктура = ПаспортныеДанныеКлиента(); 
	
	ДанныеДляПечати.Вставить("Директор",         ПолучитьСклоненияСтроки(ФИОДиректора(), , "ПД=Дательный")[0]);
	ДанныеДляПечати.Вставить("ФИОСклон",         ПолучитьСклоненияСтроки(ФИО, , "ПД=Родительный")[0]);
	ДанныеДляПечати.Вставить("ПаспортныеДанные", ПаспортныеДанныеСтруктура.ПаспортныеДанные);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеДляПечатиЗаявленияОПредоставленииСведенийОНаличииОбязательствИмущественногоХарактера(ФИО)
	
	ДанныеДляПечати = Новый Структура;
	
	ПаспортныеДанныеСтруктура = ПаспортныеДанныеКлиента();
	
	ДанныеДляПечати.Вставить("ПаспортСерияНомер", СтрШаблон("серия %1 № %2", ПаспортныеДанныеСтруктура.Серия, ПаспортныеДанныеСтруктура.Номер));
	ДанныеДляПечати.Вставить("КогдаВыдан",        СтрШаблон("выдан %1 г.", Формат(ПаспортныеДанныеСтруктура.ДатаВыдачи, "ДФ=dd.MM.yyyy")));
	ДанныеДляПечати.Вставить("КемВыдан",          ПаспортныеДанныеСтруктура.КемВыдан);
	ДанныеДляПечати.Вставить("КодПодразделения",  ПаспортныеДанныеСтруктура.КодПодразделения); 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Сотрудник = ТекПользователь.Сотрудник;
	Иначе
		Сотрудник = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	ДанныеДляПечати.Вставить("ФиоРаботника",      Сотрудник);
	ДанныеДляПечати.Вставить("Фио",               ПолучитьСклоненияСтроки(ФИО, , "ПД=Родительный")[0]);
	
	Возврат ДанныеДляПечати;
	
КонецФункции	

&НаСервере
Функция ПолучитьДанныеДляПечатиЗаявлениеВСвободнойФорме(ФИО)
	
	ДанныеДляПечати = Новый Структура;
	
	ПаспортныеДанныеСтруктура = ПаспортныеДанныеКлиента();
	
	ДанныеДляПечати.Вставить("ПаспортСерияНомер", СтрШаблон("серия %1 № %2", ПаспортныеДанныеСтруктура.Серия, ПаспортныеДанныеСтруктура.Номер));
	ДанныеДляПечати.Вставить("Директор",          ПолучитьСклоненияСтроки(ФИОДиректора(), , "ПД=Дательный")[0]);
	ДанныеДляПечати.Вставить("ФИОСклон",         ПолучитьСклоненияСтроки(ФИО, , "ПД=Родительный")[0]);
	ДанныеДляПечати.Вставить("КогдаВыдан",        СтрШаблон("выдан %1 г.", Формат(ПаспортныеДанныеСтруктура.ДатаВыдачи, "ДФ=dd.MM.yyyy")));
	ДанныеДляПечати.Вставить("КемВыдан",          ПаспортныеДанныеСтруктура.КемВыдан);
	
	Возврат ДанныеДляПечати;
	
КонецФункции	

&НаСервере
Функция ФИОДиректора()
	
	Результат = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Организации.Директор.Представление КАК Директор
	|ИЗ
	|	Константа.ЛБ_ОсновнаяОрганизация КАК ЛБ_ОсновнаяОрганизация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ЛБ_ОсновнаяОрганизация.Значение = Организации.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Директор;	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура НапечататьАнкетуВариант()
	
	Shell   = Новый COMОбъект("WScript.Shell");
	temp    = Shell.ExpandEnvironmentStrings("%temp%");
	Каталог = temp + "\";
	Если ПустаяСтрока(Каталог) Тогда
		Сообщить("Не выбран каталог временных файлов");
		Возврат;
	КонецЕсли;
	ИмяФайла           = СтрШаблон("%1_%2_%3", СокрЛП(Залогодатель), Формат(ТекущаяДата(), "ДФ=dd-MM-yyyy"), Элементы.ФормаКнопкаПечатьАнкеты.Заголовок);
	ИмяФайла           = СтрЗаменить(ИмяФайла, " ", "_");
	ИмяВременногоФайла = Каталог + ИмяФайла + ".doc";
	
	ШаблонДокумента = ПредопределенноеЗначение("Справочник.ЛБ_ШаблоныПечатиДокументов.Анкета");
	ДвоичныеДанные = МакетПечатнойФормы(ШаблонДокумента);	
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		Word = Новый COMОбъект("Word.Application");
		ВордДокумент = Word.Documents.Open(ИмяВременногоФайла); 
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось создать документ Word. " + ОписаниеОшибки());							
		Word = Неопределено;
		Возврат;
	КонецПопытки; 
	
	МассивВыбора = СтрРазделить(КатегорииФизЛица, ";", ложь);
	
	ДанныеДляПечати = ПолучитьДанныеДляПечатиАнкеты(МассивВыбора, Гражданство);
	
	Телефоны = "";
	Телефоны = ?(ПустаяСтрока(Телефон), "", Телефон); 
	Телефоны = Телефоны + ?(ПустаяСтрока(ТелефонДополнительный), "", ?(ПустаяСтрока(Телефоны), "", Символы.ПС) + ТелефонДополнительный);
	Контакты = КонтактноеЛицо + ?(ПустаяСтрока(ТелефонКонтактногоЛица), "", " тел. " +  ТелефонКонтактногоЛица);
	
	КлиентФИО = СокрЛП(Фамилия) + " " + СокрЛП(Имя) + ?(НЕ ПустаяСтрока(Отчество), " " + СокрЛП(Отчество), "");
	
	Если НЕ ЯвляетсяИПДЛ Тогда
		ИПДЛСтрокой = "Не является"; 
	Иначе   
		СтрокаИПДЛ = ""; 
		СтрокаИПДЛ = ?(ПустаяСтрока(СтрокаИПДЛ), "", Символы.ПС) + Строка(КатегорияКлиентаИПДЛ) +
		?(ПустаяСтрока(ДопИнформацияИПДЛ), "", " " + СокрЛП(ДопИнформацияИПДЛ));  
		Если НЕ ПустаяСтрока(ДолжностьИПДЛ) Тогда	   
			СтрокаИПДЛ = ?(ПустаяСтрока(СтрокаИПДЛ), "", Символы.ПС) + "Должность: " + СокрЛП(ДолжностьИПДЛ);
		КонецЕсли;
		Если НЕ ПустаяСтрока(РаботодательИПДЛ) Тогда	   
			СтрокаИПДЛ = ?(ПустаяСтрока(СтрокаИПДЛ), "", Символы.ПС) + "Работодатель: " + СокрЛП(РаботодательИПДЛ);
		КонецЕсли;	
		ИПДЛСтрокой = СтрокаИПДЛ; 
	КонецЕсли;  
	
	Если НЕ ЯвляетсяДЛПМО_РДПЛ Тогда
		ДЛПМО_РДПЛСтрокой = "Не является"; 
	Иначе   
		СтрокаДЛПМО_РДПЛ = ""; 
		СтрокаДЛПМО_РДПЛ = ?(ПустаяСтрока(СтрокаДЛПМО_РДПЛ), "", Символы.ПС) + Строка(КатегорияДЛПМО_РДПЛ) +
		?(ПустаяСтрока(ДопИнформацияИПДЛ), "", " " + СокрЛП(ДопИнформацияИПДЛ));  
		Если НЕ ПустаяСтрока(ДолжностьДЛПМО_РДПЛ) Тогда	   
			СтрокаДЛПМО_РДПЛ= ?(ПустаяСтрока(СтрокаДЛПМО_РДПЛ), "", Символы.ПС) + "Должность: " + СокрЛП(ДолжностьДЛПМО_РДПЛ);
		КонецЕсли;
		Если НЕ ПустаяСтрока(РаботодательДЛПМО_РДПЛ) Тогда	   
			СтрокаДЛПМО_РДПЛ = ?(ПустаяСтрока(СтрокаДЛПМО_РДПЛ), "", Символы.ПС) + "Работодатель: " + СокрЛП(РаботодательДЛПМО_РДПЛ);
		КонецЕсли;	
		ДЛПМО_РДПЛСтрокой = СтрокаДЛПМО_РДПЛ; 
	КонецЕсли;
	
	ИсточникиПроисхождения = "";  
	Если ЗначениеЗаполнено(ИсточникПроисхожденияДенежныхСредств) Тогда
		ИсточникиПроисхождения = ИсточникиПроисхождения + "Источник происхождения денежных средств: " + СокрЛП(ИсточникПроисхожденияДенежныхСредств);
	Иначе
		ИсточникиПроисхождения = ИсточникиПроисхождения + "Источник происхождения денежных средств: " + СокрЛП(ИсточникПроисхожденияДенежныхСредствИной); 
	КонецЕсли;	  	                  
	ИсточникиПроисхождения = ИсточникиПроисхождения + Символы.ПС;
	Если ЗначениеЗаполнено(ИсточникПроисхожденияИмущества) Тогда
		ИсточникиПроисхождения = ИсточникиПроисхождения + "Источник происхождения имущества: " + СокрЛП(ИсточникПроисхожденияИмущества);
	Иначе
		ИсточникиПроисхождения = ИсточникиПроисхождения + "Источник происхождения имущества: " + СокрЛП(ИсточникПроисхожденияИмуществаИной); 
	КонецЕсли;
	
	СтрокаБенефициарыОрг = "";
	Для каждого СтрБ из Бенефициары Цикл 
		Если СтрБ.ВидПолученияИнформации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПолученияИнформацииОБенефициарномВладельце.УстановленОрганизацией") ИЛИ 
			СтрБ.ВидПолученияИнформации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПолученияИнформацииОБенефициарномВладельце.ПредоставленКлиентомУстановленОрганизацией") Тогда
			СтрокаБенефициарыОрг = ?(Пустаястрока(СтрокаБенефициарыОрг), "", Символы.ПС) + сокрЛП(СтрБ.Бенефициар);
		КонецЕсли;	   
	Конеццикла;
	ОтстутствуютБенефициарыОрг = СтрШаблон("Иных лиц влияющих на принятие решений клиента не выявлено. Бенефициарным владельцем считается %1", КлиентФИО); 
	СтрокаБенефициарыОрг = ?(ПустаяСтрока(СтрокаБенефициарыОрг), ОтстутствуютБенефициарыОрг, СтрокаБенефициарыОрг); 
	
	СтрокаБенефициарыКл = "";
	Для каждого СтрБ из Бенефициары Цикл  
		Если СтрБ.ВидПолученияИнформации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПолученияИнформацииОБенефициарномВладельце.ПредоставленКлиентом") ИЛИ 
			СтрБ.ВидПолученияИнформации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПолученияИнформацииОБенефициарномВладельце.ПредоставленКлиентомУстановленОрганизацией") Тогда
			СтрокаБенефициарыКл = ?(Пустаястрока(СтрокаБенефициарыКл), "", Символы.ПС) + сокрЛП(СтрБ.Бенефициар);
		КонецЕсли;	   
	Конеццикла;
	ОтсутствуютБенефициарыКл = СтрШаблон("Бенефициарным владельцем является сам клиент %1", КлиентФИО);
	СтрокаБенефициарыКл = ?(ПустаяСтрока(СтрокаБенефициарыКл), ОтсутствуютБенефициарыКл, СтрокаБенефициарыКл);
	
	СведенияЦБСтрока = "";
	Для каждого СтрО Из ТаблицаОтказов Цикл
		Если СтрО.Вид = "ЦБ" Тогда
			СведенияЦБСтрока = СведенияЦБСтрока + ?(Пустаястрока(СведенияЦБСтрока), "", Символы.ПС) + "Дата отказа " + Формат(СтрО.ДатаОтказа, "ДФ=dd.MM.yyyy") + " " + СокрЛП(СтрО.ПричинаОтказа);// + " отв." + СокрЛП(СтрО.Ответственный);
		КонецЕсли;	   
	КонецЦикла;
	СведенияЦБ = ?(Пустаястрока(СведенияЦБСтрока), "Отсутствуют", СокрЛП(СведенияЦБСтрока));
	
	ОтказыСтрока = "";
	Для каждого СтрО Из ТаблицаОтказов Цикл
		Если СтрО.Вид = "Анкета" Тогда
			ОтказыСтрока = ОтказыСтрока + ?(Пустаястрока(ОтказыСтрока), "", Символы.ПС) + "Дата отказа " + Формат(СтрО.ДатаОтказа, "ДФ=dd.MM.yyyy") + " " + СокрЛП(СтрО.ПричинаОтказа) + " отв." + СокрЛП(СтрО.Ответственный);
		КонецЕсли;	   
	КонецЦикла;
	ОтказыСтрока = ?(Пустаястрока(ОтказыСтрока), "Отсутствуют", СокрЛП(ОтказыСтрока));             
	
	ActiveDocument = Word.ActiveDocument;
	ВывестиПараметрНаПечать(ActiveDocument, "Кл",                              ДанныеДляПечати.Клиент);
	ВывестиПараметрНаПечать(ActiveDocument, "ПКл",                             ДанныеДляПечати.ПредставительКлиента);
	ВывестиПараметрНаПечать(ActiveDocument, "Вп",                              ДанныеДляПечати.Выгодоприобретатель);
	ВывестиПараметрНаПечать(ActiveDocument, "Бен",                             ДанныеДляПечати.БенифициарныйВладелец);
	ВывестиПараметрНаПечать(ActiveDocument, "ФИО",                             КлиентФИО);
	ВывестиПараметрНаПечать(ActiveDocument, "ДатаМестоРождения",               Формат(ДатаРождения,"ДЛФ=DD") + ", " + СокрЛП(МестоРождения));
	ВывестиПараметрНаПечать(ActiveDocument, "Гражданство",                     СокрЛП(Гражданство));
	ВывестиПараметрНаПечать(ActiveDocument, "ДУЛ",                             ?(ДанныеДляПечати.ДУЛ = Неопределено, "", ДанныеДляПечати.ДУЛ));
	ВывестиПараметрНаПечать(ActiveDocument, "ДопДокумент",                     ДанныеДляПечати.ДопДокумент);
	ВывестиПараметрНаПечать(ActiveDocument, "АдресРегистрации",                ?(ПустаяСтрока(АдресПоПрописке), "Данные не предоставлены", СокрЛП(АдресПоПрописке)));
	ВывестиПараметрНаПечать(ActiveDocument, "ФактическийАдрес",                ?(ФактическийСовпадает, "Совпадает с адресом места жительства (регистрации)", СокрЛП(ФактическийАдрес)));
	ВывестиПараметрНаПечать(ActiveDocument, "ПочтовыйАдрес",                   ?(ПочтовыйСовпадает, "Совпадает с адресом места жительства (регистрации)",СокрЛП(ПочтовыйАдрес)));
	ВывестиПараметрНаПечать(ActiveDocument, "ИНН",                             ?(ПустаяСтрока(ИНН), "Данные не предоставлены", ИНН));
	ВывестиПараметрНаПечать(ActiveDocument, "СНИЛС",                           ?(ПустаяСтрока(СНИЛС), "Данные не предоставлены", СНИЛС));
	ВывестиПараметрНаПечать(ActiveDocument, "Телефоны",                        Телефоны);
	ВывестиПараметрНаПечать(ActiveDocument, "Контакты",                        ?(ПустаяСтрока(Контакты), "Данные не предоставлены", СокрЛП(Контакты)));
	ВывестиПараметрНаПечать(ActiveDocument, "ИПДЛ",                            ИПДЛСтрокой);
	ВывестиПараметрНаПечать(ActiveDocument, "ДЛПМО_РДПЛ",                      ДЛПМО_РДПЛСтрокой);
	ВывестиПараметрНаПечать(ActiveDocument, "ХарактерОтношений",               СокрЛП(ХарактерОтношений));
	ВывестиПараметрНаПечать(ActiveDocument, "Финансы",                         ?(ФинансовоеПоложениеСтабильное, "Стабильное", "Не стабильное"));
	ВывестиПараметрНаПечать(ActiveDocument, "ДеловаяРепутация",                ?(ДеловаяРепутацияПоложительная, "Положительная", "Негативная"));
	ВывестиПараметрНаПечать(ActiveDocument, "ИсточникиПроисхожденияИмущества", СокрЛП(ИсточникиПроисхождения));              //
	ВывестиПараметрНаПечать(ActiveDocument, "Представитель",                   ?(ТаблицаДоверенностей.Количество() = 0, "Отсутствует", ДанныеДляПечати.ПредставителиСтрока));
	ВывестиПараметрНаПечать(ActiveDocument, "БенефициарыОрганизация",          СтрокаБенефициарыОрг);
	ВывестиПараметрНаПечать(ActiveDocument, "БенефициарыКлиент",               СтрокаБенефициарыКл);
	ВывестиПараметрНаПечать(ActiveDocument, "СведенияЦБ",                      СведенияЦБ);
	ВывестиПараметрНаПечать(ActiveDocument, "Отказы",                          ОтказыСтрока);
	ВывестиПараметрНаПечать(ActiveDocument, "УровеньРиска",                    СокрЛП(УровеньРиска));
	ВывестиПараметрНаПечать(ActiveDocument, "ДатаОформления",                  Формат(ДатаОформленияАнкеты, "ДЛФ=DD"));
	ВывестиПараметрНаПечать(ActiveDocument, "ДатаНачалаОтношений",             СокрЛП(ДатаНачалаРаботыСКлиентом));
	ВывестиПараметрНаПечать(ActiveDocument, "ДатаОкончанияОтношений",          СокрЛП(ДатаОкончанияРаботыСКлиентом));
	ВывестиПараметрНаПечать(ActiveDocument, "ДатыОбновлений",                  ДанныеДляПечати.ДатыОбновлений);
	ВывестиПараметрНаПечать(ActiveDocument, "ОтветственныйАнкета",             ?(ДанныеДляПечати.ОтветсвенныйАнкета = Неопределено, "", СокрЛП(ДанныеДляПечати.ОтветсвенныйАнкета)));
	ВывестиПараметрНаПечать(ActiveDocument, "ОтветственныйОбновление",         ?(ДанныеДляПечати.ОтветсвенныйОбновление = Неопределено, "", СокрЛП(ДанныеДляПечати.ОтветсвенныйОбновление)));
	ВывестиПараметрНаПечать(ActiveDocument, "ПроверкаПоПеречням",              ДанныеДляПечати.ПроверкаПоПеречням);
	ВывестиПараметрНаПечать(ActiveDocument, "СверкаПоПеречням",                ДанныеДляПечати.СверкаПоПеречням);         
	
	//+Мельников 25.04.24 По просьбе КРО, до запуска в ломбардах, убрана блокировка вордовского файла.
	//ВордДокумент.Application.ActiveDocument.Protect(2,Истина,Строка(Этаформа.КлючУникальности),Ложь,Истина);
	//-Мельников
	ВордДокумент.SaveAs(ИмяВременногоФайла);
	ВордДокумент.Close(Истина); 
	
	ЗапуститьПриложение(ИмяВременногоФайла);
	
КонецПроцедуры

&НаСервере 
Функция ПолучитьДанныеДляПечатиАнкеты(МассивВыбора, Гражданство)
	
	ДанныеДляПечати = Новый Структура;
	
	РезультатК = ПолучитьКатегорииФизическогоЛица(МассивВыбора);
	РезультатО = ПолучитьИсториюОбновленийАнкеты();
	Если Гражданство = Справочники.СтраныМира.Россия Тогда 
		ДопДокумент = "Не требуется";
	Иначе	   
		ДопДокумент = ПолучитьДопДокумент();
		ДопДокумент = ?(ДопДокумент = Неопределено, "", ДопДокумент); 
	КонецЕсли;
	
	ДанныеДляПечати.Вставить("Клиент",                 РезультатК.Клиент);
	ДанныеДляПечати.Вставить("ПредставительКлиента",   РезультатК.ПредставительКлиента);
	ДанныеДляПечати.Вставить("Выгодоприобретатель",    РезультатК.Выгодоприобретатель);
	ДанныеДляПечати.Вставить("БенифициарныйВладелец",  РезультатК.БенифициарныйВладелец);               
	ДанныеДляПечати.Вставить("ДопДокумент",            ДопДокумент);
	ДанныеДляПечати.Вставить("ПредставителиСтрока",    ЗаполнитьПредставителей());
	ДанныеДляПечати.Вставить("ДатыОбновлений",         РезультатО.ДатыОбновлений);
	ДанныеДляПечати.Вставить("ОтветсвенныйАнкета",     РезультатО.ОтветсвенныйАнкета);
	ДанныеДляПечати.Вставить("ОтветсвенныйОбновление", РезультатО.ОтветсвенныйОбновление );
	ДанныеДляПечати.Вставить("ПроверкаПоПеречням",     ПолучитьДанныеГлобальныхПроверок());
