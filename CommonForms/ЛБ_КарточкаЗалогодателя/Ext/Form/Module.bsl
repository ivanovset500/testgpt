&НаКлиенте
Процедура ДокументыОсновнойПриИзменении(Элемент)
	ТекСтрока = Элементы.Документы.ТекущиеДанные;
	ТекСтрока.ОсновнойДУЛ = ложь;  
	ТекСтрока.ОсновнойДоп = ложь;
	
	Если ТекСтрока.Основной И НЕ Гражданство = ТекСтрока.Гражданство Тогда
		ТекСтрока.Основной = ложь; 
		Сообщить("Гражданство документа не совпадает с гражданством клиента, выбранным в карточке!");
		Возврат;
	КонецЕсли; 
	
	Если ТекСтрока.Основной И (ТекСтрока.ДокументНеДействителен ИЛИ ТекСтрока.ПроверкаНеДействителен) Тогда
		ТекСтрока.Основной = Ложь; 
		Сообщить("Документ не действителен, он не может быть основным!");
		Возврат;   
	КонецЕсли;	
	
	Если ТекСтрока.ВидДокументаЗалогодателя = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность") Тогда 
		ТекСтрока.ОсновнойДУЛ = ТекСтрока.Основной;   
		ТекСтрока.ДокументИзменен = Истина;
	ИначеЕсли ТекСтрока.ВидДокументаЗалогодателя = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ") Тогда 
		ТекСтрока.ОсновнойДоп = ТекСтрока.Основной; 
		ТекСтрока.ДокументИзменен = Истина;
	КонецЕсли;	      
	
	Стр0 = ДокументыЗалогодателя.НайтиПоИдентификатору(ТекСтрока.ПолучитьИдентификатор());
	Если ТекСтрока.ОсновнойДУЛ Тогда
		Если НЕ ТекСтрока.ДокументДействителен Тогда   
			ДокНеОК = ложь;
			Если ТекСтрока.ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ") Тогда
				Если ПроверитьПаспортВСпискеНеДействительных(ТекСтрока.ДокументСерия, ТекСтрока.ДокументНомер) Тогда
					ДокНеОК = Истина;
					ТекСтрока.ОсновнойДУЛ = Ложь; 
					ТекСтрока.Основной = Ложь;
					Сообщить("Документ найден в списке недействительных паспортов и не может быть основным документом удостоверяющим личность!");
				КонецЕсли;
			КонецЕсли;	
			Если НЕ ДокНеОК Тогда
				Для каждого Стр Из ДокументыЗалогодателя Цикл
					Если Стр.ОсновнойДУЛ И НЕ (Стр = Стр0) Тогда
						Стр.ОсновнойДУЛ = Ложь; 
						Стр.Основной = Ложь; 
						Стр.ДокументИзменен = Истина;
					КонецЕсли;	
				КонецЦикла;  
				//ТекСтрока.ДокументИзменен = Истина;
			КонецЕсли;	
		КонецЕсли;    	
	Иначе
		//ТекСтрока.ДокументИзменен = Истина;
	КонецЕсли;	      
	
	Если ТекСтрока.ОсновнойДоп Тогда
		Для каждого Стр Из ДокументыЗалогодателя Цикл
			Если Стр.ОсновнойДоп И НЕ (Стр = Стр0) Тогда
				Стр.ОсновнойДоп = Ложь; 
				Стр.Основной = Ложь; 
				Стр.ДокументИзменен = Истина;
			КонецЕсли;	
		КонецЦикла;  
		//ТекСтрока.ДокументИзменен = Истина;   	
	Иначе
		//ТекСтрока.ДокументИзменен = Истина;
	КонецЕсли;	
	
КонецПроцедуры

