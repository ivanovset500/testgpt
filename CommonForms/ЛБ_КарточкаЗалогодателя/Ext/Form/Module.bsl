Процедура СортироватьУ(Команда)
	ТекущийЭлемент = Элементы.ТаблицаЗБ; 
	ТЭ_имя_объект=ТекущийЭлемент.Имя;
	ТЭ_поле = ТекущийЭлемент.ТекущийЭлемент.имя;

    имяКолонки = СтрЗаменить(ТЭ_поле,ТЭ_имя_объект,"");
    СортироватьНасервере(имяКолонки,"Убыв");
КонецПроцедуры

&НаСервере
Процедура сортироватьНасервере(имяКолонки,ВидСортировки) 
	тз= ТаблицаЗБ.Выгрузить();
    КолонкаСортировки = тз.Колонки.Найти(имяКолонки);
	Если КолонкаСортировки <> Неопределено тогда   
		Если ИмяКолонки = "Ломбард" Тогда
			 тз.Колонки.Добавить("НомерЛ");
			 Для каждого Стр Из тз Цикл   
				 Попытка 
				     Стр.НомерЛ = Число(Стр.Ломбард.НомерЛомбарда); 
				 Исключение	 
					 Стр.НомерЛ = 0;
				 КонецПопытки;	 
			 Конеццикла;
			 тз.Сортировать("НомерЛ" + " " + ВидСортировки); 
			 ТаблицаЗБ.Загрузить(тз);
		Иначе	
            ТаблицаЗБ.Сортировать(имяКолонки + " " + ВидСортировки);
		КонецЕсли;	
     КонецЕсли;
конецпроцедуры

&НаСервере
Функция ПроверитьЛомбардСоздания(Залогодатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых.ОтветственныйЛомбард КАК ОтветственныйЛомбард
		|ИЗ
		|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПервых(, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых.Период";
	
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ОтветственныйЛомбард;
	КонецЕсли;
	
	Возврат Справочники.ЛБ_Ломбарды.ПустаяСсылка();
	
КонецФункции

