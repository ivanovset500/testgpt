&НаКлиенте
Процедура ТаблицаСлужебныхСтатусовИспользуетсяПриИзменении(Элемент) 
	ТекСтрока = Элементы.ТаблицаСлужебныхСтатусов.ТекущиеДанные;
	Если  ТекСтрока.Используется Тогда
		Для каждого Стр Из ТаблицаСлужебныхСтатусов цикл 
			Если Стр.Используется И НЕ (Стр.Статус = ТекСтрока.Статус) Тогда
				Стр.Используется = Ложь;
			КонецЕсли;	
		КонецЦикла; 
	Иначе
		ТекСтрока.Комментарий = "";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТелефонИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	Если СокрЛП(Текст) = "+7 (   )" Тогда
		Возврат;
	КонецЕсли;	
	СтандартнаяОбработка = ложь; 
	ПерваяЦифра = Сред(Текст, 5, 1);
	Если НЕ Перваяцифра = "9" Тогда 
		Телефон = Сред(Текст, 1, 4) + "9" + Сред(Текст, 6);
		ТекстСообщения = "Телефон должен начинаться с 9 и содержать 10 цифр"; 
		Предупреждение(ТекстСообщения, 10);
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ТелефонПриИзменении(Элемент)  	  
	//+МАН 15.12.25 Добавлены условия
	Если СтрДлина(Элемент.Маска) = СтрДлина(СокрЛП(Элемент.ТекстРедактирования))
		И СокрЛП(Элемент.ТекстРедактирования) <> "+7 (   )" Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросСМСРассылки", ЭтаФорма); 
		ПоказатьВопрос(Оповещение, "На указанный номер будут приходить СМС оповещения об окончании льготного срока",
		РежимДиалогаВопрос.ОК, 0,,"Проинформируйте клиента:");
	ИначеЕсли СокрЛП(Элемент.ТекстРедактирования) = "+7 (   )" Тогда
		СогласиеНаСМСРассылку = Ложь;
	КонецЕсли;
	
	//Было:
	//Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросСМСРассылки", ЭтаФорма); 
	//ПоказатьВопрос(Оповещение, "На указанный номер будут приходить СМС оповещения об окончании льготного срока",
	//РежимДиалогаВопрос.ОК, 0,,"Проинформируйте клиента:");
	//-МАН
