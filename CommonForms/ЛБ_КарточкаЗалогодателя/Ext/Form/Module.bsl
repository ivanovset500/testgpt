	Элементы.ГруппаФИО.Доступность = Истина;  
	Элементы.ГруппаКомментарий.Доступность = Истина;
	Элементы.ГруппаКонтактнаяИнформация.Доступность = Истина; 
	Элементы.ГруппаАдреса.Доступность = Истина;
	Элементы.ГруппаФИО_Англ.Доступность = Истина;
	Элементы.Гражданство.Доступность = Истина;
	Элементы.ДокументыГруппаДобавить.ТолькоПросмотр = ложь; 
	Элементы.ДокументыГруппаДобавить.Доступность = Истина;
	Элементы.ГруппаФЛ.Доступность = Истина; 
	Элементы.ГруппаФЛ1.Доступность = Истина;
	Элементы.ГруппаАнкетаДоп.Доступность = Истина;
	//Элементы.ЗалогодательБенефициарныйВладелец.Доступность = Истина;
	Элементы.ГруппаВладельцы.Доступность = Истина;
	Элементы.ГруппаИПДЛ.Доступность = Истина;
	Элементы.ГруппаДЛПМО_РДПЛ.Доступность = Истина; 
	Элементы.ГруппаОтказ.Доступность = Истина;   
	Элементы.ТаблицаДопСтатусов.ТолькоПросмотр = Ложь; 
	Элементы.ТаблицаСлужебныхСтатусов.ТолькоПросмотр = ложь;
	Элементы.ФормаКнопкаРедактировать.Видимость = Истина;
	//Иванов 06.2025 видимость кнопки ЭДО, согласия, контактные данные		
	Элементы.ЭДО.Доступность = Ложь;
	Элементы.ЭДО.ТолькоПросмотр = Истина;
	
	Элементы.Согласие.Доступность = Ложь;
	Элементы.Согласие.ТолькоПросмотр = Истина;
	
	Элементы.КонтактныеДанные.Доступность = Ложь;
	Элементы.КонтактныеДанные.ТолькоПросмотр = Истина;
	//
	Если ИнойИсточникИмущества Тогда
		Элементы.ИсточникПроисхожденияИмущества.Доступность = Ложь; 
	Иначе
		Элементы.ИсточникПроисхожденияИмуществаИной.РедактированиеТекста = Ложь;
	КонецЕсли;	
	Если ИнойИсточникДС Тогда
		Элементы.ИсточникПроисхожденияДенежныхСредств.Доступность = Ложь; 
	Иначе
		Элементы.ИсточникПроисхожденияДенежныхСредствИной.РедактированиеТекста = Ложь;
	КонецЕсли;	 
	
	ПричинаИзменения = ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИсправлениеДанныхКонтактнаяИнформация");  
	Если АдресПоПрописке = ФактическийАдрес Тогда
		ФактическийСовпадает = Истина;
	Иначе	
		ФактическийСовпадает = Ложь;
	КонецЕсли;	
	
	Если АдресПоПрописке = ПочтовыйАдрес Тогда
		ПочтовыйСовпадает = Истина;
	Иначе	
		ПочтовыйСовпадает = Ложь;
	КонецЕсли;	
	ДокументыЗалогодателя.Сортировать("Основной УБЫВ, ДокументНачалоДействия УБЫВ, ВидДокументаЗалогодателя");
	ПроверитьПоПеречням(); 
	ЗаполнитьДатыПроверкиПеречней();
	ЗаполнитьТаблицуОтказов();  
	ПроверитьДействительностьДокументов();
	
	Если ОтказОпераций Тогда 
		ОтказОпераций = Ложь;
		ПричинаОтказа = "";
		ДатаОтказа = Дата(1,1,1); 
		СуммаЗаймаОтказ = 0;
		Элементы.ГруппаПричинаОтказа.Видимость = Ложь;
	КонецЕсли;	
	//ЭтаФорма.ОбновитьОтображениеДанных(); 
КонецПроцедуры

