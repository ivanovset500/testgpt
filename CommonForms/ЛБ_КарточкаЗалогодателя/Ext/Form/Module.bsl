&НаСервере 
Процедура ЗаполнитьСписокИсточниковИнформации(ИсточникиИнф, МассивВыбора)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ИсточникиИнформации.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЛБ_ИсточникиИнформации КАК ЛБ_ИсточникиИнформации";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СпрЗначение = СокрЛП(Выборка.Наименование);
		Если МассивВыбора.Найти(СпрЗначение) = неопределено Тогда
			Пометка = ложь;
		Иначе	
			Пометка = Истина;
		КонецЕсли;	
		ИсточникиИнф.Добавить(СпрЗначение, СпрЗначение, Пометка);
	КонецЦикла;	
КонецПроцедуры

