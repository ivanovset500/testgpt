&НаКлиенте
Процедура СравнитьЗначенияРеквизитовКонтактныеДанные(Результат = Неопределено)
	
	Если Не ОтмененыИзменения Тогда
		
		МассивЗначенийРеквизитовКонтактныеДанные = Новый Массив;
		СтруктураРеквизитовКонтактныеДанныеДляПечати = Новый Структура;
		
		Выборка = ПолучитьСтруктуруИзмененныхКонтактныхДанных();
		
		Если Выборка.Количество() > 0 Тогда		
			
			Если ЗначенияРеквизитовКонтактныеДанные.Телефон <> Выборка.Телефон Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Телефон сотовый");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Телефон", "Телефон сотовый: " + Выборка.Телефон);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			Если ЗначенияРеквизитовКонтактныеДанные.ТелефонДополнительный <> Выборка.ТелефонДополнительный Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Телефон дополнительный");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ТелефонДополнительный", "Телефон дополнительный: " + Выборка.ТелефонДополнительный);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			Если ЗначенияРеквизитовКонтактныеДанные.Email <> Выборка.Email Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Email");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Email", "Email: " + Выборка.Email);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			Если ЗначенияРеквизитовКонтактныеДанные.КонтактноеЛицо <> Выборка.КонтактноеЛицо Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Контактное лицо");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("КонтактноеЛицо", "Контактное лицо: " + Выборка.КонтактноеЛицо);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			Если ЗначенияРеквизитовКонтактныеДанные.ТелефонКонтактногоЛица <> Выборка.ТелефонКонтактногоЛица Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Телефон контактного лица");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ТелефонКонтактногоЛица", "Телефон контактного лица: " + Выборка.ТелефонКонтактногоЛица);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			Если ЗначенияРеквизитовКонтактныеДанные.ФактическийАдрес <> Выборка.ФактическийАдрес Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Фактический адрес");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ФактическийАдрес", "Фактический адрес: " + Выборка.ФактическийАдрес);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			Если ЗначенияРеквизитовКонтактныеДанные.ПочтовыйАдрес <> Выборка.ПочтовыйАдрес Тогда
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить(Символы.ПС + "- Почтовый адрес");
				СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("ПочтовыйАдрес", "Почтовый адрес: " + Выборка.ПочтовыйАдрес);
			Иначе
				МассивЗначенийРеквизитовКонтактныеДанные.Добавить("");
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтруктураРеквизитовКонтактныеДанныеДляПечати.Количество() > 0 Тогда
			
			СтруктураРеквизитовКонтактныеДанныеДляПечати.Вставить("Период", Выборка.Период);
			
			ТекстВопросаЗаявление = СтрШаблон("В следующие контактные данные были внесены изменения: %1%2%3%4%5%6%7" + Символы.ПС +
			"Будет распечатано одно заявление о смене контактных данных", 
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(0),
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(1),
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(2),
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(3),
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(4),
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(5),
			МассивЗначенийРеквизитовКонтактныеДанные.Получить(6));
			Вопрос(ТекстВопросаЗаявление, РежимДиалогаВопрос.ОК, 0, КодВозвратаДиалога.ОК);
			
			//+МАН 08.12.25 Вернул как было
			//+МАН 27.11.25 Т.к. сравнение производится уже после записи карточки, то необходимо записывать данные и в регистр изменений
			//Было:
			ПечатьЗаявленияНаСменуКонтактныхДанных(,СтруктураРеквизитовКонтактныеДанныеДляПечати, Результат);
			//ЗаявлениеОбИзмененииРаспечатано = Истина;
			ЗапомнитьЗначенияРеквизитовКонтактныеДанные();
			
			//ЛБ_СоглашенияЭДОСервер.ЗаписатьИзмененияКонтактныхДанных(Залогодатель, СтруктураРеквизитовКонтактныеДанныеДляПечати, ЗначенияРеквизитовКонтактныеДанные);
			//ЗапомнитьЗначенияРеквизитовКонтактныеДанные();
			//
			//Если ОтветЗаявление = КодВозвратаДиалога.Да Тогда
			//	ПечатьЗаявленияНаСменуКонтактныхДанных(,СтруктураРеквизитовКонтактныеДанныеДляПечати);
			//	//ЗаявлениеОбИзмененииРаспечатано = Истина;
			//КонецЕсли;
			//-МАН
		Иначе
			//++ИвановВВ, убрал закрытие тут, оно будет после проверки наличия согласия на инф.
			//Если ЗакрыватьФормуПриСохранении Тогда
			//	ЭтаФорма.Закрыть(Результат);
			//КонецЕсли;
			//--ИвановВВ
		КонецЕсли;
	Иначе
		//++ИвановВВ, убрал закрытие тут, оно будет после проверки наличия согласия на инф.
		//Если ЗакрыватьФормуПриСохранении Тогда
		//	ЭтаФорма.Закрыть(Результат);
		//КонецЕсли;
		//--ИвановВВ
	КонецЕсли;
		
КонецПроцедуры // СравнитьЗначенияРеквизитовКонтактныеДанные()

&НаСервере
Функция ПолучитьСтруктуруИзмененныхКонтактныхДанных()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонДополнительный КАК ТелефонДополнительный,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.КонтактноеЛицо КАК КонтактноеЛицо,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&ТекущаяДата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	
	Запрос.УстановитьПараметр("Клиент", Залогодатель);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураИзмененныхДанных = Новый Структура;
	Если Выборка.Следующий() Тогда
		СтруктураИзмененныхДанных.Вставить("Телефон",                Выборка.Телефон);
		СтруктураИзмененныхДанных.Вставить("ТелефонДополнительный",  Выборка.ТелефонДополнительный);
		СтруктураИзмененныхДанных.Вставить("Email",                  Выборка.Email);
		СтруктураИзмененныхДанных.Вставить("КонтактноеЛицо",         Выборка.КонтактноеЛицо);
		СтруктураИзмененныхДанных.Вставить("ТелефонКонтактногоЛица", Выборка.ТелефонКонтактногоЛица);
		СтруктураИзмененныхДанных.Вставить("ФактическийАдрес",       Выборка.ФактическийАдрес);
		СтруктураИзмененныхДанных.Вставить("ПочтовыйАдрес",          Выборка.ПочтовыйАдрес);
		СтруктураИзмененныхДанных.Вставить("Период",                 Выборка.Период);
	КонецЕсли;
	Возврат СтруктураИзмененныхДанных;
КонецФункции

&НаКлиенте
Процедура ПечатьИзменениеКонтактныхДанных(Команда)
	ПараметрыФормы = Новый Структура("Клиент, Печать", Залогодатель, Истина);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ЗаявленияОбИзмененииКонтактныхДанных", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗаявленияНаСменуКонтактныхДанных(ИзФормыПечати = Ложь, СтруктураРеквизитовКонтактныеДанныеДляПечати = Неопределено, Результат)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СтруктураРеквизитовКонтактныеДанныеДляПечати", СтруктураРеквизитовКонтактныеДанныеДляПечати);
	ДополнительныеПараметры.Вставить("Результат", Результат);
	
	ОписаниеОповещенияПродолжитьИзменение = Новый ОписаниеОповещения("ИзменениеКонтактныхДанныхПродолжить", ЭтотОбъект, ДополнительныеПараметры);
	
	ТабличныйДокумент = ЛБ_СоглашенияЭДОСервер.ПечатьЗаявлениеИзменениеКонтактныхДанных(Залогодатель, Неопределено, ИзФормыПечати, СтруктураРеквизитовКонтактныеДанныеДляПечати);
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ЛБ_ИзменениеКонтактныхДанных");    
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
	КоллекцияПечатныхФорм[0].СинонимМакета = "Заявление об изменении контактных данных"; 
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,Неопределено, ЭтаФорма, ОписаниеОповещенияПродолжитьИзменение);
	
КонецПроцедуры // ПечатьЗаявленияНаСменуКонтактныхДанных()

&НаКлиенте
Процедура ИзменениеКонтактныхДанныхПродолжить(Результат, ДополнительныеПараметры) Экспорт
	ОтветПодпись = Вопрос("Заявление об изменении контактных данных подписано клиентом?", РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
	Если ОтветПодпись = КодВозвратаДиалога.Да Тогда
		ЛБ_СоглашенияЭДОСервер.ЗаписатьИзмененияКонтактныхДанных(Залогодатель, ДополнительныеПараметры.СтруктураРеквизитовКонтактныеДанныеДляПечати, ЗначенияРеквизитовКонтактныеДанные);
		Вопрос("Факт подписания клиентом заявления об изменении контактных данных зафиксирован.", РежимДиалогаВопрос.ОК, 0, КодВозвратаДиалога.ОК);
	КонецЕсли;
	
	Если Не ЗакрыватьФормуПриСохранении Тогда
		//++ИвановВВ 2025_11, согласия на информирование	
		Элементы.КонтактныеДанные.Доступность = Истина;
		Элементы.КонтактныеДанные.ТолькоПросмотр = Ложь;
		Если ДатаСмерти = Дата(1,1,1) Тогда
			НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);	
			Если Не НаличиеСогласия Тогда
				ОтветУдалить = Вопрос("При согласии клиенту будет поступать информация о ремонтах/переездах/изменении режима работы ломбардов и проводимых акциях"
				+ Символы.ПС + "Создаем согласие на информирование?"
				,РежимДиалогаВопрос.ДаНет, 0,КодВозвратаДиалога.Да, "У клиента не оформлено согласие на информирование.");
				Если ОтветУдалить = КодВозвратаДиалога.Да Тогда
					Если ЗначениеЗаполнено(Телефон) Тогда	
						ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд("ЗаключитьСогласие", Залогодатель,,,ЭтаФорма);		
					Иначе
						Предупреждение("Для заключения согласия на информирование заполните номер телефона",, "Номер телефона не заполнен");
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;	
		//--ИвановВВ 2025_11
		
	Иначе	
		//++ИвановВВ 2025_11, согласия на информирование
		Элементы.КонтактныеДанные.Доступность = Истина;
		Элементы.КонтактныеДанные.ТолькоПросмотр = Ложь;
		Если ДатаСмерти = Дата(1,1,1) Тогда
			НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);	
			Если Не НаличиеСогласия Тогда
				ОтветСогласие = Вопрос("При согласии клиенту будет поступать информация о ремонтах/переездах/изменении режима работы ломбардов и проводимых акциях" + Символы.ПС + "Создаем согласие на информирование?"
				,РежимДиалогаВопрос.ДаНет, 0,КодВозвратаДиалога.Да, "У клиента не оформлено согласие на информирование.");
				Если ОтветСогласие = КодВозвратаДиалога.Да Тогда
					Если ЗначениеЗаполнено(Телефон) Тогда
						ОписаниеОповещенияЗаключитьСогласиеПродолжить = Новый ОписаниеОповещения("ЗаключитьСогласиеПродолжить", ЭтотОбъект, ДополнительныеПараметры.Результат);
						ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд("ЗаключитьСогласие", Залогодатель,ОписаниеОповещенияЗаключитьСогласиеПродолжить,,ЭтаФорма);
					Иначе
						Предупреждение("Для заключения согласия на информирование заполните номер телефона",, "Номер телефона не заполнен");
					КонецЕсли;
				Иначе
					ЭтаФорма.Закрыть(ДополнительныеПараметры.Результат);
				КонецЕсли;
			Иначе	
				ЭтаФорма.Закрыть(ДополнительныеПараметры.Результат);
			КонецЕсли;
		КонецЕсли;	
		//--ИвановВВ 2025_11
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаПД

&НаКлиенте
Процедура ПечатьСогласиеНаОбработкуПД(Команда)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИмяКоманды",   Команда.Имя);
	СтруктураПараметров.Вставить("Залогодатель", Залогодатель);
	СтруктураПараметров.Вставить("Форма",     ЭтаФорма);
	ЛБ_СогласияНаОбработкуПД_Клиент.ОбработкаКоманд(СтруктураПараметров);
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтзывСогласияНаОбработкуПД(Команда)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИмяКоманды",   Команда.Имя);
	СтруктураПараметров.Вставить("Залогодатель", Залогодатель);
	СтруктураПараметров.Вставить("Форма",     ЭтаФорма);
	ЛБ_СогласияНаОбработкуПД_Клиент.ОбработкаКоманд(СтруктураПараметров);
	
	НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
	
	Если НаличиеСогласия Тогда
		Элементы.СтатусСогласия.Заголовок = "есть";
	Иначе
		Элементы.СтатусСогласия.Заголовок = "нет";
	КонецЕсли;
КонецПроцедуры

