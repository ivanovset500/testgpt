
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокПроб()
	СписокПроба = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Пробы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_Пробы КАК ЛБ_Пробы
	               |ГДЕ
	               |	ЛБ_Пробы.ПометкаУдаления = ЛОЖЬ
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		
		Если НЕ ПробыМеталла.НайтиПоЗначению(Выборка.Ссылка) = неопределено Тогда
			Пометка = Истина; 
		Иначе
			Пометка = Ложь;
		КонецЕсли;
		СписокПроба.Добавить(Выборка.Ссылка, Выборка.Ссылка, Пометка);
	Конеццикла;   	    
    Возврат СписокПроба;
КонецФункции	

&НаКлиенте
Процедура СтрокаПробыМеталлаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	СтандартнаяОбработка = Ложь;
	
	СписокПроба = ЗаполнитьСписокПроб();	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Выберите пробы металлов"); 
	ПараметрыФормы.Вставить("Список", СписокПроба); 
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПроб", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыбораИзСписка", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПроб(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	СтрокаПробыМеталла = "";
	ПробыМеталла.Очистить(); 
    Для Каждого Проба Из Результат Цикл
		Если Проба.Пометка Тогда   
			ПробыМеталла.Добавить(Проба.Значение);
            СтрокаПробыМеталла = СтрокаПробыМеталла + ?(ПустаяСтрока(СтрокаПробыМеталла), "", "; ") + СокрЛП(Проба.Значение);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ИзделияСБриллиантамиПриИзменении(Элемент)
	Если ИзделияСБриллиантами Тогда
		ИзделияБезВставок = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИзделияБезВставокПриИзменении(Элемент)
	Если ИзделияБезВставок Тогда
		ИзделияСБриллиантами = Ложь;
	КонецЕсли;	
КонецПроцедуры

