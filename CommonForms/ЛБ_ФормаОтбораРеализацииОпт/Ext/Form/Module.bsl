&НаКлиенте
Процедура ОК(Команда)
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ПробыМеталла", ПробыМеталла);
	СтруктураОтбора.Вставить("Категории", Категории);
    СтруктураОтбора.Вставить("Группы", Группы);
	СтруктураОтбора.Вставить("ИзделияБезВставок", ИзделияБезВставок);
	СтруктураОтбора.Вставить("ИзделияСБриллиантами", ИзделияСБриллиантами);
	СтруктураОтбора.Вставить("ИзделияСНесколькимиМеталлами", ИзделияСНесколькимиМеталлами);

	ЭтаФорма.Закрыть(СтруктураОтбора);
КонецПроцедуры


&НаКлиенте
Процедура Отмена(Команда)
