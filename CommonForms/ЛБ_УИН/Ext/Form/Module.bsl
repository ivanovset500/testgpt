Процедура Записать(Команда)
	Записать_УИН();
КонецПроцедуры //--од_ 20260422 (0003798)

//++од_ 20260422 (0003798)
&НаКлиенте
Процедура Записать_УИН(ЗапрытьПосле = Ложь)
	Для Каждого Стр Из ЭтотОбъект.ТЗ_УИН Цикл
		Если Стр.НеСохранять Тогда
			Сообщить("Введено некорректное значение УИН, которое содержит символы/пробелы. УИН должен содержать 16 цифр!");
			ЗапрытьПосле = Ложь;
			Прервать;
		КонецЕсли;
		Строка = ЭтотОбъект.ВладелецФормы.Товары[Стр.НомерСтроки - 1];
		Строка.УИН = Стр.УИН;
	КонецЦикла;
	Если ЗапрытьПосле Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры //--од_ 20260422 (0003798)

//++од_ 20260422 (0003798)
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	Записать_УИН(Истина);
КонецПроцедуры //--од_ 20260422 (0003798)

//++од_ 20260422 (0003798)
&НаКлиенте
Процедура ОчиститьВсе(Команда)
	Счетчик = 0;
	Для Каждого Стр Из ЭтотОбъект.ТЗ_УИН Цикл
		Если Стр.УИН <> "" Тогда
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;	
	
	Если Счетчик > 0 Тогда

		ТекстВопроса = СтрШаблон("Данные УИН %1 шт. будут удалены. Вы уверены?", Счетчик);
		Ответ = Вопрос(ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		0, // таймаут в секундах
		КодВозвратаДиалога.Да, // (необ.) кнопка по умолчанию
		"Внимание!" // (необ.) заголовок
		);
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Для Каждого Стр Из ЭтотОбъект.ТЗ_УИН Цикл
			Стр.УИН = "";
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры //--од_ 20260422 (0003798)

