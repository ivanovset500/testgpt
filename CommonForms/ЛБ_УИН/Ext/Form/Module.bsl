&НаКлиенте
Процедура ОчиститьСтроку(Команда)
	ТекущийЭлемент.ТекущиеДанные.УИН = "";
КонецПроцедуры //--од_ 20260422 (0003798)

//++од_ 20260422 (0003798)
&НаКлиенте
Процедура УИН_ИзделийУИНПриИзменении(Элемент)
	Если Элементы.УИН_Изделий.ТекущиеДанные.УИН <> "" Тогда
		ПроверкаЗаполненияУИН(Элементы.УИН_Изделий.ТекущиеДанные.УИН, Элементы.УИН_Изделий.ТекущиеДанные.НомерСтроки - 1, Элементы.УИН_Изделий.ТекущиеДанные.Дубль);
	КонецЕсли;
	Если Элементы.УИН_Изделий.ТекущиеДанные.УИН <> "" Тогда
		ПроверитьУникальность(Элементы.УИН_Изделий.ТекущиеДанные.УИН, Элементы.УИН_Изделий.ТекущиеДанные.НомерСтроки - 1, Элементы.УИН_Изделий.ТекущиеДанные.НеКорректно);
	КонецЕсли;
	Если Элементы.УИН_Изделий.ТекущиеДанные.Дубль Или Элементы.УИН_Изделий.ТекущиеДанные.НеКорректно Тогда
		Элементы.УИН_Изделий.ТекущиеДанные.НеСохранять = Истина;
	Иначе
		Элементы.УИН_Изделий.ТекущиеДанные.НеСохранять = Ложь;
	КонецЕсли;
	
КонецПроцедуры //--од_ 20260422 (0003798)

//++од_ 20260422 (0003798)
&НаСервере
Процедура ПроверитьУникальность(Текст, ИндексСтроки, НеКорректно)
	Отбор = Новый Структура;
	Отбор.Вставить("УИН", Текст);
	МассивСтрок = ТЗ_УИН.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 1 Тогда
		//ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Данный УИН уже заведен по другой строке!"),,СтрШаблон("ЭтаФорма.ТЗ_УИН[%1].УИН", ИндексСтроки),,);
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Данный УИН уже заведен по другой строке!"));
		НеКорректно = Истина;
	ИначеЕсли НеКорректно Тогда	
		НеКорректно = Ложь;
	КонецЕсли;
КонецПроцедуры //--од_ 20260422 (0003798)