&НаСервере
Функция ПолучитьСтруктуруПараметров_ТЗ_УИН()
	ТЗ_УИН = ЭтаФорма.ВладелецФормы.Товары.Выгрузить(,"НомерСтроки, УИН, ВыделитьВЗалоговыйБилет");
	Возврат ТЗ_УИН;
КонецФункции //--од_ 20260422 (0003798)

