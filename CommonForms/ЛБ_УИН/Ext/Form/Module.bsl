&НаСервере
Процедура ПроверкаЗаполненияУИН(Текст, ИндексСтроки, Дубль)
	
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "\D", "");
	
	Результат = СтрПодобнаПоРегулярномуВыражению(Текст, "^\d{16}$");
	Если Не Результат Тогда
		//ОбщегоНазначения.СообщитьПользователю(СтрШаблон("УИН должен содержать 16 цифр!"),,СтрШаблон("ЭтаФорма.ТЗ_УИН[%1].УИН", ИндексСтроки),,);
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Введено некорректное значение УИН, которое содержит символы/пробелы. УИН должен содержать 16 цифр!"));
		Дубль = Истина;
	ИначеЕсли Дубль Тогда	
		Дубль = Ложь;
	КонецЕсли;
	
КонецПроцедуры //--од_ 20260422 (0003798)

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//++од_ 20260422 (0003798)
	Если Параметры.ТЗ_УИН.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Данные залога не введены!"),,,,Отказ);
		Возврат;
	КонецЕсли;
	Если Параметры.Свойство("ТолькоПросмотр") Тогда
		Если ЗначениеЗаполнено(Параметры.ТолькоПросмотр) Тогда
			Элементы.УИН_Изделий.ТолькоПросмотр = Параметры.ТолькоПросмотр;
			Элементы.ЗаписатьИЗакрыть.Доступность = Не Параметры.ТолькоПросмотр;
			Элементы.УИН_ИзделийЗаписать.Доступность = Не Параметры.ТолькоПросмотр;
			Элементы.УИН_ИзделийОчиститьСтроку.Доступность = Не Параметры.ТолькоПросмотр;
			Элементы.УИН_ИзделийОчиститьВсе.Доступность = Не Параметры.ТолькоПросмотр;
			Элементы.ЗаписатьИЗакрыть.Видимость = Не Параметры.ТолькоПросмотр;
			Элементы.УИН_ИзделийЗаписать.Видимость = Не Параметры.ТолькоПросмотр;
			Элементы.УИН_ИзделийОчиститьСтроку.Видимость = Не Параметры.ТолькоПросмотр;
			Элементы.УИН_ИзделийОчиститьВсе.Видимость = Не Параметры.ТолькоПросмотр;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("ИмяФормыВладельца") Тогда
		Если Параметры.ИмяФормыВладельца = "ЛБ_ФормаВыдачиЗайма" Тогда
		ИначеЕсли Параметры.ИмяФормыВладельца = "ЛБ_ФормаПереоформленияЗайма" Тогда
			Элементы.УИН_ИзделийЗБ.Видимость = Ложь;
		ИначеЕсли Параметры.ИмяФормыВладельца = "ЛБ_ТекущееСостояниеЗалога" Тогда
			Элементы.НомерСтроки.Видимость = Ложь;
			Элементы.УИН_ИзделийАртикул.Видимость = Истина;
			Элементы.УИН_ИзделийУИН.Видимость = Истина;
			Элементы.УИН_ИзделийЗБ.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Стр Из Параметры.ТЗ_УИН Цикл
		НоваяСтрока = ТЗ_УИН.Добавить();
		Если Стр.Свойство("НомерСтроки") Тогда
			НоваяСтрока.НомерСтроки = Стр.НомерСтроки;
		КонецЕсли;
		Если Стр.Свойство("Артикул") Тогда
			Элементы.УИН_ИзделийАртикул.Видимость = Истина;
			НоваяСтрока.Артикул = Стр.Артикул;
		КонецЕсли;
		Если Стр.Свойство("УИН") Тогда
			НоваяСтрока.УИН = Стр.УИН;
		КонецЕсли;
		Если Стр.Свойство("ВыделитьВЗалоговыйБилет") Тогда
			НоваяСтрока.ВыделитьВЗалоговыйБилет = Стр.ВыделитьВЗалоговыйБилет;
		КонецЕсли;
	КонецЦикла;
	//--од_ 20260422 (0003798)
КонецПроцедуры

