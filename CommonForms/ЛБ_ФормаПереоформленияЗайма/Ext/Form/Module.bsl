&НаКлиенте
Процедура ВставкиНеОцениватьПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Вставки.ТекущиеДанные;
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти.НеОценивать Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;		
	Иначе
		Если СтрокаТабличнойЧасти.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
			
			СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
			ЦенаДрагоценногоКамня(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
			
			Если СтрокаТабличнойЧасти.ЭтоВесовой Тогда
			    СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Вес, 2);
			Иначе
				СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество, 2);
			КонецЕсли;
        КонецЕсли;
	КонецЕсли;	   
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда	
		Если СтрокаТабличнойЧасти.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда 
			СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
			СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
			ПересчитатьСуммТовары(); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьОписаниеИзделия(Стр)  
	МассивСлов = СтрРазделить(СокрЛП(Стр.Описание), " ", ложь);
    Рез = истина;
	ВыборкаСпр = Справочники.ЛБ_НеДопустимыеЗначенияВОписанииИзделия.Выбрать();
	Пока ВыборкаСпр.Следующий() цикл
		Если ВыборкаСпр.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	
		Для каждого Слово из МассивСлов Цикл  
			Если СокрЛП(нрег(Слово)) = СокрЛП(нрег(ВыборкаСпр.Наименование)) Тогда
				Сообщить("В описании изделия найдены недопустимые символы """ + СокрЛП(ВыборкаСпр.Наименование) + """"); 
				Рез = Ложь;
			КонецЕсли;	
		КонецЦикла;	
	Конеццикла;	 
	Возврат Рез;
КонецФункции 

&НаСервере
// Проверяет заполнение полей залогового билета
//
// Параметры
//  Нет
//
// Возвращаемое значение
//  Булево - результат проверки
//
Функция ПроверкаЗаполненияДокумента()
	
	Результат = Истина;       
	Если НЕ ЗначениеЗаполнено(Ломбард) тогда
		Результат = Ложь;
		Сообщить("Не выбран ломбард!",СтатусСообщения.Внимание);
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Залогодатель) тогда
		Результат = Ложь;
		Сообщить("Не выбран заемщик!",СтатусСообщения.Внимание);
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(ДокументЗалогодателя) тогда
		Результат = Ложь;
		Сообщить("Не выбран документ заемщика!",СтатусСообщения.Внимание);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Фамилия) тогда
		Результат = Ложь;
		Сообщить("Не заполнена фамилия заемщика!",СтатусСообщения.Внимание);
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Имя) тогда
		Результат = Ложь;
		Сообщить("Не заполнено имя заемщика!",СтатусСообщения.Внимание);
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(ДатаРождения) тогда
		Результат = Ложь;
		Сообщить("Не заполнена дата рождения заемщика!",СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Гражданство) тогда
		Результат = Ложь;
		Сообщить("Не выбрано гражданство заемщика!",СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СхемаКредитования) тогда
		Результат = Ложь;
		Сообщить("Не выбрана схема кредитования!",СтатусСообщения.Внимание);
	КонецЕсли;    
	
	Если ПроцентныеСтавкиПоПериодам.Количество() = 0 Тогда
		Результат = Ложь;
		Сообщить("Не определены процентные ставки!",СтатусСообщения.Внимание);
	КонецЕсли;  

	Если НЕ Товары.Количество() Тогда		
		Результат = Ложь;
		Сообщить("Состав залога нового билета не указан!",СтатусСообщения.Внимание);
	Иначе    
		ЕстьПереоформляемыеОЗ = Ложь;
		Для каждого стр Из Товары Цикл 
			Если Стр.Переоформить Тогда
				ЕстьПереоформляемыеОЗ = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	     
		Если НЕ ЕстьПереоформляемыеОЗ Тогда 
			Результат = Ложь;
		    Сообщить("Состав залога нового билета не указан!",СтатусСообщения.Внимание);
		КонецЕсли;	
	КонецЕсли;    
	
	СообщениеПроверкиПоЛомбарду = ЛБ_УправлениеЛомбардом.ПроверитьИзделияЗБВЛомбарде(ДатаДок, ПредыдущаяОперация, Ломбард); 
	Если НЕ ПустаяСтрока(СообщениеПроверкиПоЛомбарду) Тогда 
		Результат = Ложь;
		ОбщегоНазначения.СообщитьПользователю(СообщениеПроверкиПоЛомбарду + ". Переоформление запрещено.");
	КонецЕсли;   
		
	Если Не Результат Тогда
		возврат Результат;
	КонецЕсли;	
	
	Если Результат Тогда
		Если ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
			Если ПустаяСтрока(ДокументКодПодразделения) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить код подразделения!");
				Результат = ложь;
			КонецЕсли;	
			Если ПустаяСтрока(ДокументКемВыдан) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить кем выдан!");
				Результат = ложь;
			КонецЕсли;	
		КонецЕсли;
		Если ((ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
		(ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) Тогда
		    Если ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда 			    
				Парам = Новый Структура("Серия, Номер", СокрЛП(ДокументСерия), СокрЛП(ДокументНомер));
				Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
					Если ЗначениеЗаполнено(ДокументЗайма) Тогда
						Сообщить("Документ найден в списке недействительных паспортов!");
					    Результат = ложь; 
					КонецЕсли;	
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, ДокументДатаВыдачи) Тогда
					Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
				    Результат = ложь;	
				КонецЕсли;	
			ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, ДокументДатаВыдачи) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
			    Результат = ложь;   
			КонецЕсли;	
		ИначеЕсли (ДокументВид = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) И НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(ДатаРождения, ДатаДок) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		    Результат = ложь;
		КонецЕсли;	
		Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, ДокументВидДокументаЗалогодателя, ДокументВид) тогда
			Если НЕ ЗначениеЗаполнено(ДокументСрокДействия) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить срок действия!");
		        Результат = ложь;
			ИначеЕсли ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		        Результат = ложь;
			КонецЕсли;	  
		ИначеЕсли ЗначениеЗаполнено(ДокументСрокДействия) И (ДокументСрокДействия < НачалоДня(ДатаДок)) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		    Результат = ложь;
		КонецЕсли;	      
		Если НЕ Гражданство = Справочники.СтраныМира.Россия Тогда
			Отбор = Новый Структура; 
			Отбор.Вставить("Клиент", Залогодатель);
			Строки = ДопДокументы.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда 
				Сообщить("Не выбран документ удостоверяющий право пребывания клиента на территории РФ!");
		        Результат = ложь;
			Иначе                  
				ЕстьДокументГражданствоНЕРФ = ложь;
				Для каждого Стр Из Строки Цикл
					//Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, Стр.ДокументЗалогодателя, Стр.ВидДокумента) тогда 
					//	Если НЕ ЗначениеЗаполнено(Стр.ДокументСрокДействия) Тогда
					//		Продолжить;
					//	ИначеЕсли Стр.ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
					//		Продолжить;
					//	КонецЕсли;	
					//    ЕстьДокументГражданствоНЕРФ = Истина;
					//	Прервать; 
					//ИначеЕсли ЗначениеЗаполнено(Стр.ДокументСрокДействия) Тогда
					//    Если Стр.ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
					//		Продолжить;
					//	КонецЕсли;	
					//    ЕстьДокументГражданствоНЕРФ = Истина;
					//	Прервать; 
					//Иначе
					//	ЕстьДокументГражданствоНЕРФ = Истина;
					//	Прервать; 
					//КонецЕсли;      	
					Если Стр.ДокументГражданство = Гражданство Тогда
						ЕстьДокументГражданствоНЕРФ = Истина;     
						Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда 
						    Если НЕ ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Стр.ДокументГражданство, Стр.ВидДокументаЗалогодателя, Стр.ВидДокумента) тогда
						        ТекстСообщения1 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоВозраст(ДатаРождения, Стр.ДокументДатаВыдачи); 
								Если НЕ Пустаястрока(ТекстСообщения1) тогда 
								    Сообщить(ТекстСообщения1); 
									Результат = ложь;
								КонецЕсли;	  
							КонецЕсли; 
							ТекстСообщения2 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоКонтактнаяИнформация(Залогодатель, Стр.ДокументДатаВыдачи, ДатаДок); 
							Если НЕ Пустаястрока(ТекстСообщения2) тогда 
								Сообщить(ТекстСообщения2); 
								Результат = ложь;
							КонецЕсли;	 
						КонецЕсли;	 
					КонецЕсли;		
				КонецЦикла;	
				Если НЕ ЕстьДокументГражданствоНЕРФ Тогда
					Сообщить("У клиента нет действующего документа, удостоверяющего право пребывания на территории РФ!");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	  
	КонецЕсли;    
	
	Если ЗначениеЗаполнено(Представитель) Тогда  
		Если НЕ ЗначениеЗаполнено(ДокументПредставителя) тогда
			Результат = Ложь;
			Сообщить("Не выбран документ представителя заемщика!",СтатусСообщения.Внимание);
		Иначе
			РезультатПроверки = ЛБ_УправлениеЛомбардом.ПроверитьОсновныеДокументыЗалогодателя(Представитель, ДатаДок);
			Если НЕ ПустаяСтрока(РезультатПроверки.ОшибкаДУЛ) Тогда
				Сообщить("Проверка основного ДУЛ представителя заемщика: " + РезультатПроверки.ОшибкаДУЛ);
			    Результат = Ложь;
			КонецЕсли; 
			Если НЕ ПустаяСтрока(РезультатПроверки.ОшибкаДоп) Тогда
				Сообщить("Проверка основного документа на право пребывания РФ представителя заемщика: " + РезультатПроверки.ОшибкаДоп);
			    Результат = Ложь;
			КонецЕсли;   

		КонецЕсли;     
		Если НЕ ЗначениеЗаполнено(ДоверенностьПереоформление) тогда
			Результат = Ложь;
			Сообщить("Не заполнена доверенность представителя заемщика!",СтатусСообщения.Внимание);
		КонецЕсли; 
	Иначе
		Если НЕ Залогодатель = ПредыдущаяОперация.Залогодатель Тогда
			Если НЕ ЗначениеЗаполнено(ДоверенностьПереоформление) тогда
				Результат = Ложь;
				Сообщить("Не заполнена доверенность!",СтатусСообщения.Внимание);
			КонецЕсли; 
		КонецЕсли;	
    КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПроцентнаяСхема) Тогда
		Сообщить("Не выбрана схема расчета процентов!");
		Результат = ложь;
	ИначеЕсли НЕ ПСК = 0 Тогда  
		Если ПСКГод > ПСК Тогда 
			Сообщить("ВНИМАНИЕ! Значение ПСК (полной стоимости потребительского займа) превышает максимально допустимое. Займ не может быть выдан.");
			Результат = ложь;
		КонецЕсли;	
	КонецЕсли;   

	Если Результат Тогда  
						
		Если ПредельныйСрокЗайма = Дата(1,1,1) Тогда
			Сообщить("На дату операции не определен предельный срок займа для схемы кредитования " + СокрЛП(СхемаКредитования) + "!", СтатусСообщения.Внимание);
        КонецЕсли;
		
		Ном = 0;
		Для каждого СтрокаТабличнойЧасти Из Товары Цикл 
			Ном = Ном + 1;                              
			Если НЕ СтрокаТабличнойЧасти.Переоформить Тогда
				Продолжить;
			КонецЕсли;	
			
			Результат = Результат 
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВидИзделия)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Проба)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Описание)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Клеймо)  
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Категория)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Количество)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаОценки)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаСсуды); 
			
			Если НЕ Результат Тогда
			    Сообщить("В строке № " + Строка(Ном) +  " не заполнены обязательные поля", СтатусСообщения.Внимание);
                Результат = ложь;
				Прервать;
			КонецЕсли;	   
			
				
			Если СтрокаТабличнойЧасти.ЕстьДопМеталлы И НЕ (СтрокаТабличнойЧасти.ЕстьЭтикетка ИЛИ СтрокаТабличнойЧасти.ЕстьФайл) Тогда   
				Сообщить("В строке № " + Строка(Ном) + " у изделия нет этикетки или скриншота этикетки с сайта!");
		        Результат = ложь;		
			КонецЕсли;
						
			Если СтрокаТабличнойЧасти.Именник = Перечисления.ЛБ_Именник.Да тогда
				Если ПустаяСтрока(СтрокаТабличнойЧасти.ДанныеИменника) Тогда
					Сообщить("Строка № " + Строка(Ном) + ": Если именник РФ, то необходимо заполнить данные именника.");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;  
			
			Если СтрокаТабличнойЧасти.ЕстьДеффекты тогда
				Если ПустаяСтрока(СтрокаТабличнойЧасти.Дефекты) Тогда
					Сообщить("Строка № " + Строка(Ном) + ": Если в изделии есть дефекты, то необходимо их описать.");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;  
			
			Если НЕ ПроверитьОписаниеИзделия(СтрокаТабличнойЧасти) Тогда
				Результат = ложь;
			КонецЕсли;	
			
			//++ИВВ 03.2026, вычеты для часов ч.2
			//было:
			//ВесЧистыйРасчет = ПолучитьВесМеталлаРасчет(СтрокаТабличнойЧасти);
			//Если СтрокаТабличнойЧасти.ВесЧистый < ВесЧистыйРасчет Тогда 
			//	Сообщить("Строка № " + Строка(Ном) + ": Вес металла в изделии " + СокрЛП(Формат(СтрокаТабличнойЧасти.ВесЧистый, "ЧЦ=10; ЧДЦ=2")) + " г. не совпадает с расчетным весом металла " + СокрЛП(Формат(ВесЧистыйРасчет, "ЧЦ=10; ЧДЦ=2")) + " г.");
			//ИначеЕсли СтрокаТабличнойЧасти.ВесЧистый > ВесЧистыйРасчет Тогда
			//	Сообщить("Строка № " + Строка(Ном) + ": Вес металла в изделии " + СокрЛП(Формат(СтрокаТабличнойЧасти.ВесЧистый, "ЧЦ=10; ЧДЦ=2")) + " г. превышает расчетный вес металла " + СокрЛП(Формат(ВесЧистыйРасчет, "ЧЦ=10; ЧДЦ=2")) + " г.");
			//	Результат = ложь;
			//КонецЕсли;    
			//--ИВВ
			
			Если СтрокаТабличнойЧасти.ЕстьВставки Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);   
				СтрокиВ = Вставки.НайтиСтроки(Отбор);
				Если СтрокиВ.Количество() = 0 Тогда  
					Сообщить("Строка № " + Строка(Ном) + ": По изделию не заполнена табличная часть ""Вставки"""); 
					Результат = ложь;
				КонецЕсли;
			КонецЕсли;	 
			
			Если СтрокаТабличнойЧасти.ЕстьДопМеталлы Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);   
				СтрокиМ = ДополнительныеМеталлы.НайтиСтроки(Отбор);
				Если СтрокиМ.Количество() = 0 Тогда  
					Сообщить("Строка № " + Строка(Ном) + ": По изделию не заполнена табличная часть ""Дополнительные металлы"""); 
					Результат = ложь;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла; 
		
	КонецЕсли;
				
	Возврат Результат;
	
КонецФункции // ПроверкаЗаполненияДокумента()   

&НаСервере
Функция ПолучитьВесМеталлаРасчет(СтрокаТабличнойЧасти)
	ВесМ = СтрокаТабличнойЧасти.Вес;    	
	СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧасти.КлючСтроки);
	ВесМ = Цел((ВесМ - СтруктураР.Вес)*100)/100;
	
	ОтборДоп = Новый Структура;
	ОтборДоп.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки); 
	
	ВесДоп = 0;
	СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);    
	Для каждого СтрДоп Из СтрокиДоп Цикл
		ВесДоп = ВесДоп + СтрДоп.ВесЧистый;
	Конеццикла;   
	//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
	//Было: ВесМ = ВесМ - ВесДоп;
	//++ИВВ 02.2026, вычеты для часов
	//было:
	//ВесМ = ?(СтрокаТабличнойЧасти.Вес30, Цел(((ВесМ - ВесДоп) * 0.7)*100)/100, ВесМ - ВесДоп);
	//-Мельников
	//стало:
	Если СтрокаТабличнойЧасти.Вес30 Тогда
		ВесМ = Цел(((ВесМ - ВесДоп) * 0.7)*100)/100;
	ИначеЕсли СтрокаТабличнойЧасти.СкидкаМеханизм И Не СтрокаТабличнойЧасти.СкидкаНика Тогда
		ВесМ = (ВесМ - ВесДоп) * (СтрокаТабличнойЧасти.РазмерСкидкиМеханизм / 100);
	ИначеЕсли СтрокаТабличнойЧасти.СкидкаМеханизм И СтрокаТабличнойЧасти.СкидкаНика Тогда
		ВесМ = (((ВесМ - ВесДоп) * (СтрокаТабличнойЧасти.РазмерСкидкиМеханизм / 100))*(100-СтрокаТабличнойЧасти.РазмерСкидкиНика)) / 100;
	Иначе
		ВесМ = ВесМ - ВесДоп;
	КонецЕсли;
	//--ИВВ

	Возврат ВесМ;	
КонецФункции

&НаСервере
Функция ПроверкаОценкиИзделий() 
	Если  Константы.ЛБ_ОграничениеОценкиВерхняяГраница.Получить() Тогда 		
		ОценкаВерхняя = Константы.ЛБ_ОценкаВерхняяГраница.Получить();
		Для каждого Стр Из Товары цикл 
			Если НЕ Стр.Переоформить Тогда
				Продолжить;
			КонецЕсли;	
			Если стр.СуммаОценки >= ОценкаВерхняя тогда  
				СообщениеОценкаЗБ = Константы.ЛБ_СообщениеОграничениеЗаймаЗБ.Получить(); 
				Если Пустаястрока(СообщениеОценкаЗБ) Тогда 
				    СообщениеОценкаЗБ = "Проведение договора займа с оценкой предмета залога от " + СокрЛП(Формат(ОценкаВерхняя, "ЧЦ=15; ЧДЦ=2")) + " руб. и выше, временно приостановлено.";
				КонецЕсли;
				ОбщегоНазначения.СообщитьПользователю(СокрЛП(СообщениеОценкаЗБ)); 
				Возврат Ложь;  
			КонецЕсли;	
		Конеццикла;	
		
		ЕстьОграничениеОценки = Ложь;
		ЗапросО = Новый Запрос; 
		ЗапросО.УстановитьПараметр("Дата", ДатаДок); 
		ЗапросО.УстановитьПараметр("Организация", Константы.ЛБ_ОсновнаяОрганизация.Получить());
		ЗапросО.Текст = "ВЫБРАТЬ
		                |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.ЕстьОграничениеОценки КАК ЕстьОграничениеОценки,
		                |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.СуммаОценки КАК СуммаОценки,
		                |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.СообщениеВключениеЗБ КАК СообщениеВключениеЗБ
		                |ИЗ
		                |	РегистрСведений.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.СрезПоследних(&Дата, Организация = &Организация) КАК ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних";
		ВыборкаО = ЗапросО.Выполнить().Выбрать();
		Если ВыборкаО.Следующий() Тогда 
			ЕстьОграничениеОценки = ВыборкаО.ЕстьОграничениеОценки;
			ОценкаВерхняя = ВыборкаО.СуммаОценки; 
			СообщениеВключениеЗБ = ВыборкаО.СообщениеВключениеЗБ;
		КонецЕсли;	     

		//СообщениеВключениеЗБ = Константы.ЛБ_СообщениеВключениеЗБ.Получить();   
		Если ЕстьОграничениеОценки Тогда
			ЕстьОценкаВыше = Ложь;
			ЕстьОценкаНиже = Ложь; 
			Для каждого Стр Из Товары Цикл   
				Если НЕ Стр.Переоформить Тогда
					Продолжить;
				КонецЕсли;	
				Если стр.СуммаОценкиМаксимальная > ОценкаВерхняя тогда
					ЕстьОценкаВыше = Истина;
				Иначе  
					ЕстьОценкаНиже = Истина;
				КонецЕсли;	
			Конеццикла;
			Если ЕстьОценкаВыше И ЕстьОценкаНиже Тогда                       
				Если Пустаястрока(СообщениеВключениеЗБ) Тогда 
					СообщениеВключениеЗБ = "Не заполнено сообщение об ограничении на оформление в один договор займа изделий с разной величиной суммы оценки в настройках управления ломбардом!";
				КонецЕсли;	
				ОбщегоНазначения.СообщитьПользователю(СокрЛП(СообщениеВключениеЗБ));
				Возврат Ложь;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;

	Возврат Истина;
КонецФункции	  

&НаСервере
Функция  ПолучитьНовыйНомерЗБ(ДокументОбъект)
	НомерЗБ = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерЗалоговогоБилета(Ломбард);
	Если НЕ Пустаястрока(НомерЗБ) Тогда 
		КолДублей = ЛБ_УправлениеЛомбардом.ПроверитьЕстьНомерЗалоговогоБилета(НомерЗБ);
		Если НЕ КолДублей = 0 Тогда 
			ОбщегоНазначения.СообщитьПользователю("В базе уже есть " + ?(КолДублей = 1, "залоговый билет ", "залоговые билеты ") + "с номером " + НомерЗБ);
		КонецЕсли;	
	КонецЕсли;   
    Возврат НомерЗБ; 
КонецФункции	     

&НаСервере
Функция СоздатьДокументНаСервере()  
	Если ЗначениеЗаполнено(ДокументЗайма) Тогда
		ДокументОбъект = ДокументЗайма.ПолучитьОбъект(); 
		Если ДокументОбъект.ПометкаУдаления Тогда
		    ДокументОбъект.УстановитьПометкуУдаления(Ложь); 
		КонецЕсли;	
	Иначе	
	    ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
		ДокументОбъект.Дата = ДатаДок;  
		ДокументОбъект.Ломбард = Ломбард;
		ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление;  
	    ДокументОбъект.Организация = Организация;  
    КонецЕсли;	
	ДокументОбъект.Дата = ДатаДок;
	ДокументОбъект.ПредыдущаяОперация = ПредыдущаяОперация;
	ДокументОбъект.Ломбард = Ломбард;
	ДокументОбъект.ОтветственныйПользователь = ОтветственныйПользователь; 
	ДокументОбъект.ОтветственныйСотрудник = ОтветственныйСотрудник;

    ДокументОбъект.Комментарий = Комментарий;
	ДокументОбъект.Залогодатель = Залогодатель;  
	ДокументОбъект.ДокументЗалогодателя = ДокументЗалогодателя; 
	ДокументОбъект.Представитель = Представитель; 
	ДокументОбъект.ДокументПредставителя = ДокументПредставителя;  
	ДокументОбъект.ДоверенностьПредставителя = ДоверенностьПереоформление;
    ДокументОбъект.СхемаКредитования = СхемаКредитования;  
	ДокументОбъект.СрокЗалога = СрокЗалога;                                                                  
	ДокументОбъект.Акция = Акция;
	ДокументОбъект.ОтказОтВыкупа = ОтказОтВыкупа;
	ДокументОбъект.ДатаВыкупа = ДатаВыкупа;
	ДокументОбъект.ДатаВыкупаЛьготная = ДатаВыкупаЛьготная; 
	ДокументОбъект.СтатусЗалогодателя = СтатусЗалогодателя;
	ДокументОбъект.ПроцентнаяСхема = ПроцентнаяСхема; 
	ДокументОбъект.ПредельныйСрокЗайма = ПредельныйСрокЗайма;
	ДокументОбъект.ПредельныйСрокЗаймаДни = ПредельныйСрокЗаймаДни;
	ДокументОбъект.Промокод = Промокод;
	ДокументОбъект.Предъявитель = Предъявитель; 
	ДокументОбъект.СогласиеНаСМСРассылку = СогласиеНаСМСРассылку;  
	ДокументОбъект.ТекущаяУстановкаУсловийПоСхемеКредитования = ТекущаяУстановкаУсловийПоСхемеКредитования;  
	ДокументОбъект.ПриказСтавки = ПриказСтавки;
	ДокументОбъект.ПриказАкцияСтавки = ПриказАкцияСтавки;   
	ДокументОбъект.ОтклонениеПоАкции = ОтклонениеПоАкции;

	//+МАН 08.08.25 Для отчетов нужен ПСК на момент выдачи займа и чтобы его не считать записываем
	//в документ. Как и нужно было сделать сразу. Заявка 3348.
	ДокументОбъект.ПСКГод = ПСКГод;
	//
	//+МАН 10.12.25
	ДокументОбъект.ПриказВИПСтавки = ПриказВИПСтавки;
	//-МАН
	
	Если ПустаяСтрока(ДокументОбъект.НомерЗалоговогоБилета) тогда  
	    ДокументОбъект.НомерЗалоговогоБилета = ПолучитьновыйНомерЗБ(ДокументОбъект);
		Если ПустаяСтрока(ДокументОбъект.НомерЗалоговогоБилета) тогда 
		   ВызватьИсключение("Не определен номер залогового билета");
		КонецЕсли;   
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", ДокументОбъект.Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументОбъект.Фамилия = Выборка.Фамилия;
	    ДокументОбъект.Имя = Выборка.Имя;
	    ДокументОбъект.Отчество = Выборка.Отчество;		
		ДокументОбъект.ДатаРождения = Выборка.ДатаРождения;		
		ДокументОбъект.Гражданство = Выборка.Гражданство;
		ДокументОбъект.Пол = Выборка.Пол;  
		ДокументОбъект.ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДокументОбъект.ДатаРождения);
	КонецЕсли;

	Запрос.УстановитьПараметр("ДокументЗалогодателя", ДокументОбъект.ДокументЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя = &ДокументЗалогодателя
	               |				И ОсновнойДул = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументОбъект.ДокументВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя;
		ДокументОбъект.ДокументВид = Выборка.ВидДокумента;
		ДокументОбъект.ДокументГражданство = Выборка.Гражданство;
		ДокументОбъект.ДокументСерия = Выборка.ДокументСерия;
		ДокументОбъект.ДокументНомер = Выборка.ДокументНомер;
		ДокументОбъект.ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи;
		ДокументОбъект.ДокументКемВыдан = Выборка.ДокументКемВыдан;
		ДокументОбъект.ДокументКодПодразделения = Выборка.ДокументКодПодразделения;
		ДокументОбъект.ДокументНачалоДействия = Выборка.ДокументНачалоДействия;
		ДокументОбъект.ДокументСрокДействия = Выборка.ДокументСрокДействия;
	КонецЕсли;
	
	ДокументОбъект.ДополнительныеДокументыПравоПребыванияРФ.Загрузить(ДопДокументы.Выгрузить());
	ПроцентныеСтавкиПоПериодам.Сортировать("ПричинаПрименения, ДеньНачалаПрименения");
	ДокументОбъект.ПроцентныеСтавкиПоПериодам.Загрузить(ПроцентныеСтавкиПоПериодам.Выгрузить()); 
	ДокументОбъект.ГрафикПлатежей.Загрузить(ГрафикПлатежей.Выгрузить());
	
	СтрСостояние = ТаблицаСостояний.Получить(1);
	ДокументОбъект.СуммаОплаты = СтрСостояние.СуммаЗайма+СтрСостояние.СуммаПроцентовДолг;
	ДокументОбъект.СуммаОплатыПроценты = СтрСостояние.СуммаПроцентовДолг;
	ДокументОбъект.СуммаОплатыСсуда = СтрСостояние.СуммаЗайма;
		
	ДокументОбъект.НачислениеПроцентовДетально.Очистить();
	Для каждого стр из ТаблицаОплатДетально Цикл 
	    НоваяСтр = ДокументОбъект.НачислениеПроцентовДетально.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);  
	КонецЦиклА;    

	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.Дефекты.Очистить(); 
	ДокументОбъект.Вставки.Очистить();
	ДокументОбъект.ДополнительныеМеталлы.Очистить();
	
	СуммаЗаймаДок = 0;
	Для каждого стр из Товары Цикл  
		//Если НЕ Стр.Переоформить Тогда
		//	Продолжить;
		//КонецЕсли;	
		НоваяСтр = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);  
		Если НЕ ЗначениеЗаполнено(Стр.ОбъектЗалога) Тогда
		    ЛБ_УправлениеЛомбардом.СоздатьОбъектЗалога(ДокументОбъект, НоваяСтр); 
			стр.ОбъектЗалога = НоваяСтр.ОбъектЗалога;
		Иначе
			ОбъектЗалогаНаименование = СокрЛП(Стр.ВидИзделия.Наименование) + ?(Стр.ЕстьВставки, " с/в", " б/в"); 
			Если НЕ СокрЛП(Стр.ОбъектЗалога.Наименование) = ОбъектЗалогаНаименование Тогда 
				ОбъектОЗ = Стр.ОбъектЗалога.ПолучитьОбъект();  
				ОбъектОЗ.Наименование = ОбъектЗалогаНаименование; 
	            ОбъектОЗ.Записать();
            КонецЕсли;
		КонецЕсли;
		СуммаЗаймаДок = СуммаЗаймаДок + ?(Стр.Переоформить, Стр.СуммаСсуды, 0);
		
		Отбор = новый структура;
		Отбор.Вставить("КлючСтроки", стр.КлючСтроки);
		
		СтрокиД = Дефекты.НайтиСтроки(Отбор);
		Для каждого стрД из строкиД Цикл
			НоваяСтрД = ДокументОбъект.Дефекты.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрД, стрД);
		Конеццикла;	
		
		СтрокиВ = Вставки.НайтиСтроки(Отбор);
		Для каждого стрВ из строкиВ Цикл
			НоваяСтрВ = ДокументОбъект.Вставки.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрВ, стрВ);
		Конеццикла;	
		
		СтрокиМ = ДополнительныеМеталлы.НайтиСтроки(Отбор);
		Для каждого стрМ из строкиМ Цикл
			НоваяСтрМ = ДокументОбъект.ДополнительныеМеталлы.Добавить();
		    ЗаполнитьЗначенияСвойств(НоваяСтрМ, стрМ);
		Конеццикла;	
	Конеццикла;	
	ДокументОбъект.СуммаСсуды = СуммаЗаймаДок;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Попытка           			 
	    ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение   
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(ДокументОбъект.Ссылка));
	КонецПопытки; 
	Возврат ДокументОбъект.Ссылка;	
КонецФункции	

&НаСервере
Функция ВыдатьЗаймНаСервере()  
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ТекущаяДата()) Тогда
	    ДатаДок = ТекущаяДата();
	КонецЕсли;	  
	
	ЕстьНеПроведенные = Ложь;   
	СсылкаНаДокумент = СоздатьДокументНаСервере(); 
	ДокументЗайма = СсылкаНаДокумент; 
	НомерЗБ = ДокументЗайма.НомерЗалоговогоБилета;
   	Если НЕ СсылкаНаДокумент.проведен Тогда 
		ЕстьНеПроведенные = истина;
	КонецЕсли;		
	Возврат ЕстьНеПроведенные;
КонецФункции

&НаСервере
Функция ПолучитьСписокВыкуп()
	СписокВыкуп = Новый СписокЗначений;
	
	Для каждого Стр Из Товары Цикл
		Если Стр.Переоформить Тогда
			Продолжить;
		КонецЕсли;           
		
		ИнформацияВыкуп = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ПредыдущаяОперация, Стр.НомерСтроки) + " " + СокрЛП(Стр.ОбъектЗалога) + ", " + СокрЛП(Стр.Проба) + 
		    ", вес " + СокрЛП(Формат(Стр.Вес, "ЧЦ=10; ЧДЦ=2")) + " г. (вес металла " + СокрЛП(Формат(Стр.ВесЧистый, "ЧЦ=10; ЧДЦ=2")) + " г.)";  
		СписокВыкуп.Добавить(ИнформацияВыкуп);
	КонецЦикла;
	
	Возврат СписокВыкуп;
КонецФункции

&НаСервере
Процедура ОбновитьРеквизитыТовары() 
	Ном = 0;
	Для каждого стр из Товары Цикл 
		Если Стр.Переоформить Тогда
			Ном = Ном + 1;
		КонецЕсли;	
		Стр.Статус = ?(НеРедактировать, ?(Стр.Переоформить, "Принят", "Выкуп"), "Проект");   
		Стр.СтатусДоп = ?(Стр.Новый, " Добавлен", "");
		Стр.Артикул = ?(НеРедактировать, ?(НЕ Стр.Переоформить, "", ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ДокументЗайма, Ном)), "");
	КонецЦикла;		
КонецПроцедуры

&НаСервере
Функция ПроверитьКассовуюСмену(ДатаПроверки = неопределено) 	            
	Возврат ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(?(ДатаПроверки = неопределено, ТекущаяДатаСеанса(), ДатаПроверки), Организация, Ломбард);
КонецФункции   

&НаСервере
Функция ПроверитьКассовыйДеньЗакрыт(ДатаПроверки = неопределено) 	             
	Результат = ЛБ_ОбщийМодуль.ПолучитьЗакрытыйКассовыйДень(?(ДатаПроверки = неопределено, ТекущаяДатаСеанса(), ДатаПроверки), Организация, Ломбард);
	Если НЕ Результат = неопределено Тогда 
		Если (НачалоДня(Результат.Дата) = НачалоДня(ДатаПроверки)) Тогда    
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Ложь;
КонецФункции


&НаСервере
Функция ПроверитьДС(ДатаПроверки)
    Возврат ЛБ_ОбщийМодуль.ПроверитьНаличиеСуммыВКассеЛомбарда(ДатаПроверки, Организация, Ломбард);
КонецФункции

&НаСервере
Функция ПроверитьЕстьВНакладной()
	Возврат  ЛБ_УправлениеЛомбардом.ПолучитьСтатусНакладнойПоЗБ(ДатаДок, ПредыдущаяОперация); 
КонецФункции 

&НаСервере
Функция ПолучитьНомерЗБ() 
	Возврат ПредыдущаяОперация.НомерЗалоговогоБилета;
КонецФункции

&НаСервере
Функция ПолучитьРеквизитыНакладной(НакладнаяНаОтгрузку)  
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("Номер", НакладнаяНаОтгрузку.ПредставлениеНомераНакладной); 
	СтруктураВ.Вставить("Дата", НакладнаяНаОтгрузку.Дата);
	Возврат СтруктураВ; 
КонецФункции

&НаКлиенте
Процедура ВыдатьЗайм(Команда)
	Если НеРедактировать Тогда
		Возврат;
	КонецЕсли;    
	
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ТекущаяДата()) Тогда
	    ДатаПроверки = ТекущаяДата();
	Иначе
		ДатаПроверки = ДатаДок;
	КонецЕсли;	 
	
	Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) Тогда
		Предупреждение("Не определены условия по выбранной схеме кредитования!", 60);
		Возврат;
	КонецЕсли;
	
	ОстатокДС = ПроверитьДС(ДатаПроверки); 
	СтрСостояние = ТаблицаСостояний.Получить(1);
	СуммаВыкупаЗБ = СтрСостояние.СуммаЗайма+СтрСостояние.СуммаПроцентовДолг;  
	ОстатокДС = ОстатокДС + СуммаВыкупаЗБ; 
	
	Если ОстатокДС < СуммаЗайма Тогда
		Предупреждение("Остаток денежных средств в кассе ломбарда с учетом выкупа переоформляемого билета " + СокрЛП(Формат(ОстатокДС, "ЧЦ=15; ЧДЦ=2; ЧН=0,00")) + " руб." +
		   Символы.ПС + "Этого недостаточно для переоформления займа.", 60);
		Возврат;
	КонецЕсли;	

	СтруктураКС = ПроверитьКассовуюСмену(ДатаПроверки);
	Если СтруктураКС = неопределено Тогда   
		Предупреждение("Не открыта кассовая смена в ломбарде. Выдача займа запрещена.", 60); 
		Возврат;
	КонецЕсли;	

	Если СуммаЗайма < МинСуммаЗайма Тогда
		Сообщить("Сумма займа не может быть меньше минимальной суммы займа " + СокрЛП(Формат(МинСуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " руб.!");  
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = ложь;
	Если НЕ ПроверкаКлиента() Тогда  
		ЕстьОшибки = Истина;
	КонецЕсли;  
	
	Если НЕ ПроверкаЗаполненияДокумента() Тогда  
		ЕстьОшибки = Истина;
	КонецЕсли;  
	
	Если НЕ ПроверкаОценкиИзделий() Тогда  
		ЕстьОшибки = Истина;
	КонецЕсли;           
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;  
	
	СтруктураВ = ПроверитьЕстьВНакладной();
	Если СтруктураВ = неопределено Тогда
		ЕстьВНакладной = Ложь;
	Иначе
		ЕстьВНакладной = Истина;
		НакладнаяНаОтгрузку = СтруктураВ.НакладнаяНаОтгрузку; 
		СтатусНакладной = СтруктураВ.СтатусНакладной;
	КонецЕсли;  
	
	Если ЕстьВНакладной Тогда   
		СтруктураН = ПолучитьРеквизитыНакладной(НакладнаяНаОтгрузку); 
	    ТекстПредупреждения = "Предметы залога ЗБ № " + СокрЛП(ПолучитьНомерЗБ()) + " в накладной № " + СокрЛП(СтруктураН.Номер)+ " от " + Формат(СтруктураН.Дата, "ДЛФ=DT");
		Если СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена") Тогда 
			ТекстПредупреждения = ТекстПредупреждения + " уже отгружены.";
		    ТекстПредупреждения = ТекстПредупреждения + " Проведение операции невозможно!";   			
			Предупреждение(ТекстПредупреждения, 60);
			Возврат;
	    ИначеЕсли СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаОткрыта") ИЛИ  
			      СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаЗакрыта") Тогда  
		   ТекстПредупреждения = ТекстПредупреждения + " в сумке.";	
		   ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + "Для переоформления ЗБ измените статус накладной и вскройте сумку."; 
		   
	   	   Предупреждение(ТекстПредупреждения, 60);  
		   Возврат;
	    КонецЕсли;	   
	КонецЕсли;		  

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
	ПараметрыФормы.Вставить("Представитель", Представитель);
	ПараметрыФормы.Вставить("ПредыдущаяОперация", ПредыдущаяОперация);
	ПараметрыФормы.Вставить("СхемаКредитования", СхемаКредитования);
	ПараметрыФормы.Вставить("СрокЗалога", СрокЗалога);
	ПараметрыФормы.Вставить("СуммаЗайма", СуммаЗайма);
	ПараметрыФормы.Вставить("СуммаКВыдаче", СуммаКВыдаче);
	ПараметрыФормы.Вставить("СуммаКВнесению", СуммаКВнесению); 
	ПараметрыФормы.Вставить("СписокОбъектовВыкуп", ПолучитьСписокВыкуп()); 
	ПараметрыФормы.Вставить("ЕстьВНакладной", ЕстьВНакладной);
	
	СтрСостояние = ТаблицаСостояний.Получить(1);
	ИнфВыкуп = "Сумма выкупа ";  
	ИнфВыкуп = ИнфВыкуп + Формат(СтрСостояние.СуммаЗайма+СтрСостояние.СуммаПроцентовДолг, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧРГ=; ЧН=0,00") + " руб."; 
	ИнфВыкуп = ИнфВыкуп + Символы.ПС + " (в том числе займ " + Формат(СтрСостояние.СуммаЗайма, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧРГ=; ЧН=0,00") + " руб.";
	ИнфВыкуп = ИнфВыкуп + ", проценты " + Формат(СтрСостояние.СуммаПроцентовДолг, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧРГ=; ЧН=0,00") + " руб.)";
	//Элементы.ДекорацияВыкупРасшифровка.Заголовок = ИнфВыкуп;    
	
	ПараметрыФормы.Вставить("ИнформацияВыкуп", ИнфВыкуп); 

			
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПереоформить",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ИнформацияПереоформленияЗайма", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
КонецПроцедуры

&НаСервере
Функция ПолучитьПредыдущегоЗалогодателя()
	Возврат ПредыдущаяОперация.Залогодатель;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПереоформить(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	ЕстьНеПроведенные = ВыдатьЗаймНаСервере();
		
	Если НЕ ЕстьНеПроведенные Тогда
		НеРедактировать = Истина;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
        Элементы.Редактировать.Видимость = Истина; 
		Элементы.КнопкаИстория.Видимость = Истина; 
		Элементы.ВыдатьЗайм.Доступность = Ложь;
	    Элементы.ТоварыГруппаЭ.Доступность = Ложь;  
		Элементы.ПовышеннаяОценка.Доступность = ложь; 
		Элементы.Округление.Доступность = ложь;
	    Элементы.Отмена.Заголовок = "Закрыть"; 
		Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;   
		ОбновитьРеквизитыТовары();
		
		Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
   	        ФормаРМП = ВладелецФормы;   
			Если ФормаРМП.Залогодатель = ПолучитьПредыдущегоЗалогодателя() Тогда
                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
			ИначеЕсли ФормаРМП.Залогодатель = Залогодатель Тогда
                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено);	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
Функция СнятьСПроведения(Документ)  
	ДокОбъект = Документ.ПолучитьОбъект(); 
	Если ДокОбъект.Проведен Тогда 
		ЗапросП = Новый Запрос; 
		ЗапросП.УстановитьПараметр("ЗБ", Документ);
		ЗапросП.Текст = "ВЫБРАТЬ
		                |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
		                |ИЗ
		                |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
		                |ГДЕ
		                |	ЛБ_ОперацияПоЗалогу.ПредыдущаяОперация = &ЗБ
		                |	И ЛБ_ОперацияПоЗалогу.Проведен = ИСТИНА";
		ВыборкаП = ЗапросП.Выполнить().Выбрать();
		Если ВыборкаП.Следующий() тогда 
			Сообщить("У залогового билета " + СокрЛП(Документ.НомерЗалоговогоБилета) + " есть более поздние операции. Редактирование запрещено.");
			Возврат Ложь;
		КонецЕсли;                                               
		Попытка
		    ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);  
			Возврат Истина;
		Исключение   
			Сообщить("Не удалось снять с проведения залоговый билет " + СокрЛП(Документ.НомерЗалоговогоБилета) + ". Редактирование запрещено.");
			Возврат Ложь;
		КонецПопытки;	
	Иначе
		возврат Истина;
	КонецЕсли;
КонецФункции	

&НаКлиенте
Процедура Редактировать(Команда)   
	ПроверкаМожноРедактировать = Истина;
	Если ЭтаФорма.НеРедактировать Тогда 
		Если ЗначениеЗаполнено(ДокументЗайма) тогда 
			Результат = СнятьСПроведения(ДокументЗайма);
			Если НЕ Результат тогда  
				ПроверкаМожноРедактировать = Ложь;
			КонецЕсли;	
		КонецЕсли;	
		Если ПроверкаМожноРедактировать Тогда  
			НеРедактировать = Ложь;
			Этаформа.ТолькоПросмотр = Ложь;
			Этаформа.Открыть();
		КонецЕсли;
	//Иначе
	//	Для каждого стр из Товары Цикл
	//		Стр.статус = "Проект"; 
	//		Стр.СтатусДоп = ?(Стр.Новый, " Добавлен", "");
	//	КонецЦикла;
    КонецЕсли;	
    ОбновитьРеквизитыТовары();
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;  
	Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
	Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
	Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
	Элементы.Редактировать.Видимость = Ложь; 
	Элементы.КнопкаИстория.Видимость = Ложь; 
	Элементы.ВыдатьЗайм.Доступность = Истина;
	Элементы.ТоварыГруппаЭ.Доступность = ?(НеРедактировать, Элементы.ТоварыГруппаЭ.Доступность, Истина); 
	Если НеРедактировать Тогда
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		Элементы.Округление.Доступность = Ложь;
	Иначе	
	    ПроверитьДоступностьДопКнопок();
	КонецЕсли;
	Элементы.Отмена.Заголовок = "Отмена"; 
	РассчитатьПредельныСрокЗайма();  
	ОбновитьРеквизитыТовары();                       
	ЗаполнитьСостояниеЗалоговогоБилета(); 
	ЗаполнитьКВыдачеВнесению();
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
Функция МакетПечатнойФормы(ШаблонДокумента)
	
	Если НЕ ТипЗнч(ШаблонДокумента.ХранилищеШаблона.Получить()) = Тип("ДвоичныеДанные") Тогда
		Сообщить("Шаблон печати анкеты не загружен!");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ШаблонДокумента.ХранилищеШаблона.Получить();
	 
КонецФункции 

&НаСервере
Функция ДокументЗаймаПроведен()  
	Возврат ДокументЗайма.Проведен;
КонецФункции

&НаКлиенте
Процедура ПечатьЗалоговыйБилет(Команда)    
	Если ЗначениеЗаполнено(ДокументЗайма) Тогда	
		Если ДокументЗаймаПроведен() Тогда 
			ПараметрыФормы = Новый Структура;    
			ПараметрыФормы.Вставить("ИменаМакетов", "Переоформление");  	
