&НаКлиенте
Процедура ПрисоединитьЭтикетку(СтрокаТабличнойЧастиТовары)
	
	Если НЕ СтрокаТабличнойЧастиТовары.ЕстьЭтикетка Тогда 
		СсылкаНаЭтикетку = СтрокаТабличнойЧастиТовары.Этикетка; 
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЭтикетки",ЭтаФорма);
		Если ЗначениеЗаполнено(СсылкаНаЭтикетку) Тогда
			ПараметрыФормы = Новый Структура("Ключ", СсылкаНаЭтикетку);
		Иначе					
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Дата", ДатаДок);
			ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
		КонецЕсли;	
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЭтикетки",ЭтаФорма);  
		ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	Иначе
		Сообщить("У изделия есть этикетка. Скриншот сайта не нужен.");
	КонецЕсли;	
КонецПроцедуры	

