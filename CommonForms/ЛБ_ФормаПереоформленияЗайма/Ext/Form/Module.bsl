	ДополнительныеМеталлыИтогОценка = ДополнительныеМеталлы.Итог("СуммаОценкиМеталлы");
КонецПроцедуры

&НаСервере
Функция ПроверитьЕстьЗалогиДень() 
	Отбор = Новый структура;
	Отбор.Вставить("Настройка", Перечисления.ЛБ_ТипыНастроекЗайма.СуммироватьЗаймыЗаДень);
	СтрокиН = НастройкиЗайма.НайтиСтроки(Отбор);
	Если СтрокиН.Количество() = 0 Тогда
		Возврат 0;
	ИначеЕсли НЕ СтрокиН.Получить(0).Значение Тогда 
	    Возврат 0;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(Залогодатель) тогда
		Запрос = новый Запрос; 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
		Запрос.УстановитьПараметр("Дата1", НачалоДня(ДатаДок)); 
		Запрос.УстановитьПараметр("Дата2", ДатаДок);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор,
		               |	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаСсудыОборот) КАК СуммаСсуды
		               |ИЗ
		               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(
		               |			&Дата1,
		               |			&Дата2,
		               |			Регистратор,
		               |			ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
		               |				И Залогодатель = &Залогодатель) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор";  
		Выборка = Запрос.Выполнить().Выбрать();
		СуммаСсуды = 0;
		Пока Выборка.Следующий() Цикл 
			Если ЗначениеЗаполнено(ДокументЗайма) тогда
				Если Выборка.Регистратор = ДокументЗайма Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;	 
			СуммаСсуды = СуммаСсуды + Выборка.СуммаСсуды;
		КонецЦикла;
		Возврат СуммаСсуды;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаСервере
Процедура ЗаполнитьТабличныеЧасти(НачальноеЗаполнение = Ложь)    
	Если НЕ НачальноеЗаполнение Тогда
		Документ = ДокументЗайма;
	Иначе 
		Документ = ПредыдущаяОперация;
	КонецЕсли;	  
	Если НЕ НачальноеЗаполнение Тогда 
		Для каждого стр Из ДокументЗайма.ДополнительныеДокументыПравоПребыванияРФ Цикл
			НоваяСтр = ДопДокументы.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла;	    
		Для каждого стр Из ДокументЗайма.ПроцентныеСтавкиПоПериодам Цикл
			НоваяСтр = ПроцентныеСтавкиПоПериодам.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла; 
		Для каждого стр Из ДокументЗайма.ГрафикПлатежей Цикл
			НоваяСтр = ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла;
	КонецЕсли;
	
	Ном = 0;
	Для каждого стр Из Документ.Товары Цикл 
		Если НачальноеЗаполнение И ПредыдущаяОперация.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
			Если НЕ Стр.Переоформить Тогда
			    Продолжить;
			КонецЕсли;	 
		КонецЕсли;	
		НоваяСтр = Товары.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр); 
		НоваяСтр.Переоформить = ?(НачальноеЗаполнение, Истина, Стр.Переоформить); 
		НоваяСтр.Новый = ?(НачальноеЗаполнение, Ложь, Стр.Новый);
		Если НоваяСтр.Переоформить Тогда
		    НоваяСтр.Статус = ?(НеРедактировать, "Принят", "Проект"); 
			НоваяСтр.СтатусДоп = ?(НачальноеЗаполнение, "", ?(НоваяСтр.Новый, " Добавлен", "")); 
			Ном = Ном + 1;
		Иначе   
			НоваяСтр.Статус = "Выкуп";
		КонецЕсли;	 		
		НоваяСтр.Артикул = ?(НеРедактировать, ?(НЕ Стр.Переоформить, "", ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(Документ, Ном)), "");
	Конеццикла;	 
	Для каждого стр Из Документ.Вставки Цикл
		НоваяСтр = Вставки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;	
    Для каждого стр Из Документ.ДополнительныеМеталлы Цикл
		НоваяСтр = ДополнительныеМеталлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;
	Для каждого стр Из Документ.Дефекты Цикл
		НоваяСтр = Дефекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;	 
	
	Если НачальноеЗаполнение Тогда 
		ОбработатьИзменениеСуммыЗайма(НачальноеЗаполнение);
	КонецЕсли;	

КонецПроцедуры	

&НаСервере
Процедура ЦенаДрагоценногоКамня(Идентификатор, ИдентификаторТовары) 
	СтрокаТабличнойЧасти 				  = Вставки.НайтиПоИдентификатору(Идентификатор);
	СтрокаТабличнойЧастиТовары 			  = Товары.НайтиПоИдентификатору(ИдентификаторТовары);
	
	Если СтрокаТабличнойЧасти.НеОценивать Тогда
        СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;
	Иначе           
		СтруктураВставки = новый Структура; 
		СтруктураВставки.Вставить("Дата", ДатаДок); 
		СтруктураВставки.Вставить("Ломбард", Ломбард);
		СтруктураВставки.Вставить("ВидВставки", СтрокаТабличнойЧасти.ВидВставки);
		СтруктураВставки.Вставить("ФормаОгранки", СтрокаТабличнойЧасти.ФормаОгранки);
        СтруктураВставки.Вставить("ВидОгранки", СтрокаТабличнойЧасти.ВидОгранки);
        СтруктураВставки.Вставить("КачествоОгранки", СтрокаТабличнойЧасти.КачествоОгранки);
        СтруктураВставки.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧасти.ЕдиницаИзмерения);
 		//+Мельников 24.09.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
        СтруктураВставки.Вставить("Залогодатель", Залогодатель);
        СтруктураВставки.Вставить("СхемаКредитования", СхемаКредитования);

		//+Мельников 24.07.24 Для расчета суммы от единицы, а не общего веса
		//СтруктураВставки.Вставить("Вес", ?(СтрокаТабличнойЧасти.ЕдиницаИзмерения.Код = "162", СтрокаТабличнойЧасти.вес, СтрокаТабличнойЧасти.ВесГраммы));
        СтруктураВставки.Вставить("Вес", ?(СтрокаТабличнойЧасти.ЕдиницаИзмерения.Код = "162", СтрокаТабличнойЧасти.ВесШтКар, СтрокаТабличнойЧасти.ВесГраммыШт));
		//-Мельников
        Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуДрагоценногоКамняИзПрейскуранта(СтруктураВставки);
	    СтрокаТабличнойЧасти.Цена = Результат.Цена; 
		СтрокаТабличнойЧасти.Приказ = Результат.Приказ;
		//+МАН 10.12.25
		СтрокаТабличнойЧасти.ПриказВИПВставки = Результат.ПриказВИПВставки;
		//-МАН
	    СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * ?(НЕ СтрокаТабличнойЧасти.ЭтоВесовой, СтрокаТабличнойЧасти.Количество, СтрокаТабличнойЧасти.Вес), 2);
	КонецЕсли;	
КонецПроцедуры   

&НаСервере 
Функция ОкруглитьСуммуСсуды(Сумма)
	Если ЭтаФорма.Округление Тогда
	    Возврат ЛБ_УправлениеЛомбардом.ОкруглитьСуммуСсудыПоНастройкам(ДатаДок, Организация, Сумма);
	Иначе
		Возврат Сумма;
	КонецЕсли;	
КонецФункции	

&НаСервере
Процедура РасчетСуммыОценкиИтоговой(НачальноеЗаполнение = Ложь)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата", ДатаДок);
	СтруктураПараметров.Вставить("Ломбард", Ломбард);
	СтруктураПараметров.Вставить("СхемаКредитования", СхемаКредитования);  
	//+Мельников 24.09.24 ВИП. Заявка 2792
	СтруктураПараметров.Вставить("Залогодатель", Залогодатель);
	//-Мельников
	СуммаЗайма = 0;
	Для каждого Стр Из Товары Цикл
		Если НЕ стр.Переоформить Тогда 
			Продолжить;
		КонецЕсли;	
		СтруктураПараметров.Вставить("Проба", Стр.Проба);
		СтруктураПараметров.Вставить("Категория", Стр.Категория);
		СтруктураПараметров.Вставить("ЕдиницаИзмерения", Стр.ЕдиницаИзмерения);
    	Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуМеталлаИзПрейскуранта(СтруктураПараметров);
		Стр.Цена = Результат.Цена;  
		Стр.Приказ = Результат.Приказ;
		//+МАН 10.12.25
		Стр.ПриказВИПМеталлы = Результат.ПриказВИПМеталлы;
		//-МАН
	    Стр.СуммаОценкиМеталлы = Стр.ВесЧистый*Стр.Цена; 
		ОтборВ = Новый Структура;
		ОтборВ.Вставить("КлючСтроки", Стр.КлючСтроки);
		Строки = Вставки.НайтиСтроки(ОтборВ);
	    СуммаОценкиКамни = 0;		
		Для каждого СтрВ Из Строки Цикл	
	        ЦенаДрагоценногоКамня(СтрВ.ПолучитьИдентификатор(), Стр.ПолучитьИдентификатор());
		    СуммаОценкиКамни = СуммаОценкиКамни + СтрВ.Сумма; 
		КонецЦикла;		
	    Стр.СуммаОценкиКамни = СуммаОценкиКамни;
	    
		ОтборДоп = Новый Структура;
		ОтборДоп.Вставить("КлючСтроки", Стр.КлючСтроки);
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);
		Для каждого СтрДоп Из СтрокиДоп Цикл  
			СтруктураПараметров.Вставить("Проба", СтрДоп.Проба);
		    СтруктураПараметров.Вставить("Категория", СтрДоп.Категория);
		    СтруктураПараметров.Вставить("ЕдиницаИзмерения", СтрДоп.ЕдиницаИзмерения);
			Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуМеталлаИзПрейскуранта(СтруктураПараметров);
			СтрДоп.Цена = Результат.Цена;  
			СтрДоп.Приказ = Результат.Приказ;
			//+МАН 10.12.25
			СтрДоп.ПриказВИПМеталлы = Результат.ПриказВИПМеталлы;
			//-МАН
        	СтрДоп.СуммаОценкиМеталлы = СтрДоп.Цена*СтрДоп.ВесЧистый;
			Стр.СуммаОценкиМеталлы = Стр.СуммаОценкиМеталлы + СтрДоп.СуммаОценкиМеталлы;
		Конеццикла;	
		Стр.СуммаОценки = Стр.СуммаОценкиМеталлы + Стр.СуммаОценкиКамни;
		
		РасчетМаксимальнойСуммыОценки(Стр.ПолучитьИдентификатор());  
		//Если НачальноеЗаполнение ИЛИ Стр.Новый Тогда  
			Стр.СуммаСсуды = Стр.СуммаОценкиМаксимальная;
		//Иначе	
		//	Если Стр.СуммаСсуды > Стр.СуммаОценкиМаксимальная Тогда
		//		Стр.СуммаСсуды = Стр.СуммаОценкиМаксимальная;
		//	КонецЕсли;
		//КонецЕсли;	
		СуммаЗайма = СуммаЗайма + Стр.СуммаСсуды;
	КонецЦикла;	
	СуммаЗайма = ОкруглитьСуммуСсуды(СуммаЗайма); 
	РаспределитьСуммуЗайма();                                                 
	ТоварыИтоги();
	УстановитьТекстСуммаЗаймаДень();
КонецПроцедуры  

&НаСервере
Процедура РаспределитьСуммуЗайма()
    СуммаДляРаспределения = СуммаЗайма;
	Если СуммаДляРаспределения = 0 Тогда
		Возврат;
	КонецЕсли;	 
	//МаксимальнаяОценкаИтог = Товары.Итог("СуммаОценкиМаксимальная");  
	//Если МаксимальнаяОценкаИтог = 0 Тогда  
	ОценкаИтог = 0; 
	Для каждого Стр Из Товары Цикл 
		Если Стр.Переоформить Тогда
			ОценкаИтог = ОценкаИтог + Стр.СуммаОценки;   
		КонецЕсли;	
	КонецЦикла;	
	Если ОценкаИтог = 0 Тогда 
        Возврат;  
	КонецЕсли;	  
	НомСтрМакс = 0; 
	МаксОценка = 0;  
	Коэфф = СуммаЗайма/ОценкаИтог;
	
	НомСтр = 0;
	Для каждого Стр Из Товары Цикл 
		Если НЕ Стр.Переоформить Тогда  
			Продолжить;
		КонецЕсли;	
		НомСтр = НомСтр + 1;
		//Коэфф = Стр.СуммаОценкиМаксимальная/МаксимальнаяОценкаИтог;
		//Стр.СуммаСсуды = СуммаЗайма*Коэфф; 
		Стр.СуммаСсуды = Стр.СуммаОценки*Коэфф;
		Стр.СуммаОценкиМаксимальная = Стр.СуммаСсуды;
		Если Стр.СуммаОценкиМаксимальная < Стр.СуммаОценки Тогда
			Стр.СуммаОценкиМаксимальная = Стр.СуммаОценки;
		КонецЕсли;	  
		СуммаДляРаспределения = СуммаДляРаспределения - Стр.СуммаСсуды; 
		Если Стр.СуммаОценкиМаксимальная > МаксОценка Тогда
			МаксОценка = Стр.СуммаОценкиМаксимальная;  
			НомСтрМакс = НомСтр-1;
		КонецЕсли;	
	КонецЦикла;    
	
	Если НЕ СуммаДляРаспределения = 0 Тогда
		Стр = Товары.Получить(НомСтрМакс);
		Стр.СуммаСсуды = Стр.СуммаСсуды + СуммаДляРаспределения;   
		Стр.СуммаОценкиМаксимальная = Стр.СуммаСсуды;
		Если Стр.СуммаОценкиМаксимальная < Стр.СуммаОценки Тогда
			Стр.СуммаОценкиМаксимальная = Стр.СуммаОценки;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры
             
&НаСервере
Процедура ЗаполнитьТаблицуСтавок() 
	ПроцентныеСтавкиПоПериодам.Очистить();
	ТаблицаСтавок.Очистить();       
	СуммаЗаймаРасчеты = СуммаЗайма + СуммаЗаймаДень;    
	Если ЭтоСотрудник И РасчетСотрудникаДоп Тогда
		//+Мельников 24.09.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
		ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(ДатаДок, Ломбард, СхемаКредитования, Акция, ДопСтатусСотрудник, СписокДопСтатусов, СуммаЗаймаРасчеты, Залогодатель);
	Иначе	
		//+Мельников 24.09.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
	    ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(ДатаДок, Ломбард, СхемаКредитования, Акция, СтатусЗалогодателя, СписокДопСтатусов, СуммаЗаймаРасчеты, Залогодатель);
	КонецЕсли;
	Если НЕ ТаблицаС.Количество() = 0 Тогда  
		СтрС = ТаблицаС.Получить(0);
		ПриказСтавки = СтрС.Приказ;
		ПриказАкцияСтавки = СтрС.ПриказАкция;
		//+МАН 10.12.25
		ПриказВИПСтавки = СтрС.ПриказВИП;
		//-МАН

		ПроцентныеСтавкиПоПериодам.Загрузить(ТаблицаС);
		
		Отбор = Новый структура;
		Отбор.Вставить("ПричинаПрименения", ПричинаПримененияПроцентнойСхемы); 
		СтрокиП = ПроцентныеСтавкиПоПериодам.НайтиСтроки(Отбор); 
		Для каждого СтрП из строкиП цикл 
			НоваяСтр = ТаблицаСтавок.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрП);
		КонецЦикла;	
		
		ОтборС = Новый Структура;
		ОтборС.Вставить("ДеньНачалаПрименения", 1);
		СтрокиС = ТаблицаСтавок.НайтиСтроки(ОтборС); 
		Если НЕ СтрокиС.Количество() = 0 Тогда 
			СтрС = СтрокиС.Получить(0);	 
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая Тогда 
				ПроцентнаяСхема = СтрС.ПроцентнаяСтавка;
			ИначеЕсли СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда	
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда 
					ПроцентнаяСхема = СтрС.ПроцентнаяСтавкаАкция; 
					ОтклонениеПоАкции = Ложь;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					ПроцентнаяСхема = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
					ОтклонениеПоАкции = Истина;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда
					ПроцентнаяСхема = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
					ОтклонениеПоАкции = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры	  

&НаСервере
Функция РассчитатьСуммуПроцентов()   
	ГрафикПлатежей.Очистить();
	Если НЕ ПроцентнаяСхема = 0 Тогда   		
		СтруктураОкругления = новый Структура;
		СтруктураОкругления.Вставить("ОкруглятьЦены", ОкруглятьПроценты);  
		СтруктураОкругления.Вставить("ВидОкругленияСуммыПроцентов", ВидОкругленияСуммыПроцентов);
		СтруктураОкругления.Вставить("ПорядокОкругления", ПорядокОкругления);  
		СтруктураОкругления.Вставить("ОкруглятьВБольшуюСторону", ОкруглятьВБольшуюСторону);  
		
		//ДатаНачала = НачалоДня(ДатаДок);  
		//Если НачислятьПроцентыЗаДеньЗалога Тогда  
		//	ДатаНачала = НачалоДня(ДатаНачала);
		//Иначе	
		//	ДатаНачала = НачалоДня(ДатаНачала + (60 * 60 * 24));
		//КонецЕсли;              
		ДатаНачала = ЛБ_УправлениеЛомбардом.ПолучитьДатуНачалаРасчетаПроцентов(ДатаДок, Константы.ЛБ_ОсновнаяОрганизация.Получить());
		
		Для сч = 0 По ТаблицаСтавок.Количество()-1 Цикл 
			СтрС = ТаблицаСтавок.Получить(сч); 
			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачала;
			Иначе 
				ДатаНач = НачалоДня(ДатаНачала-1) + СтрС.ДеньНачалаПрименения*(60 * 60 * 24);
			КонецЕсли;	
			Если ДатаНач > ДатаВыкупа Тогда 
		 		Прервать;
			КонецЕсли;	
			
			сч1 = сч + 1;
			Если сч1 >= ТаблицаСтавок.Количество() Тогда
				ДатаКон = ДатаВыкупа; 
				ДеньКон = СрокЗалога;
			Иначе   
				СтрС1 = ТаблицаСтавок.Получить(сч1);
				ДатаКонца = НачалоДня(ДатаНачала-1) + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24); 
				Если ДатаКонца > ДатаВыкупа Тогда
					ДатаКон = ДатаВыкупа;
					ДеньКон = СрокЗалога;
				Иначе
					ДатаКон = ДатаКонца; 
					ДеньКон = СтрС1.ДеньНачалаПрименения-1;
				КонецЕсли;	
			КонецЕсли;	
			
			Если НЕ (НачалоДня(ДатаКон) < НачалоДня(ДатаНач)) тогда
				СтавкаП = СтрС.ПроцентнаяСтавка; 
				Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
					Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
				    КонецЕсли; 
				КонецЕсли;	              
			    Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗайма, СтруктураОкругления);
				СуммаПроцентов = Результат.СуммаПроцентов; 
				Если СтрС.ДеньНачалаПрименения = 1 Тогда
		            СуммаПроцентовДень = Результат.СуммаПроцентовДень;				
				КонецЕсли;	
				СтрП = ГрафикПлатежей.Добавить();  
				СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
				СтрП.ДатаНач = ДатаНач;
				СтрП.ДатаКон = ДатаКон;
				СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
				СтрП.ДеньКон = ДеньКон; 
				СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
				СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
				СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
				СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
                СтрП.СуммаПроцентов = Результат.СуммаПроцентов;
				СтрП.СуммаПроцентовДень = СуммаПроцентовДень;  					
			КонецЕсли;	
		Конеццикла;	 
	Иначе
		СуммаПроцентов = 0;
		СуммаПроцентовДень = 0;
	КонецЕсли;
	Возврат СуммаПроцентов;
КонецФункции	

&НаСервере
Процедура ЗаполнитьИнфорациюОЗалогодателе(Параметры, ПроверитьДоверенность = Истина)
	Если Параметры.Свойство("ДокументЗалогодателя") Тогда
		ДокументЗалогодателя = Параметры.ДокументЗалогодателя; 
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();
	КонецЕсли;	
	ЗаполнитьКонтакнуюИнформациюЗалогодателя();
	КонтактнаяИнформацияВСтроку();     
	Если ПроверитьДоверенность Тогда
		Если ЗначениеЗаполнено(Представитель) Тогда
			Плательщик = Представитель;
		Иначе	
		    Плательщик = Залогодатель;
		КонецЕсли;	
		Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда 
			ЗаполнитьСписокВыбораДоверенностейПлательщика();  
			Если НЕ Элементы.Доверенность.СписокВыбора.Количество() = 0 Тогда
				Если НЕ ДоверенностьПереоформление = Элементы.Доверенность.СписокВыбора.Получить(0).Значение Тогда
				    ДоверенностьПереоформление = Элементы.Доверенность.СписокВыбора.Получить(0).Значение;
					ЗаполнитьТекстДоверенности();
				КонецЕсли; 
			Иначе    
				ДоверенностьПереоформление = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
				Доверенность = "";
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьИнфорациюОПредставителе(Параметры, ПроверитьДоверенность = Истина)
	Если Параметры.Свойство("ДокументЗалогодателя") Тогда
		ДокументПредставителя = Параметры.ДокументЗалогодателя; 
		ЗаполнитьИнформациюОДокументеПредставителя();
		ИнформацияОДокументеПредставителяВСтроку();
	КонецЕсли;
	ЗаполнитьКонтакнуюИнформациюПредставителя();
	КонтактнаяИнформацияПредставителяВСтроку(); 
	Если ПроверитьДоверенность Тогда
		Если ЗначениеЗаполнено(Представитель) Тогда
			Плательщик = Представитель;
		Иначе	
		    Плательщик = Залогодатель;
		КонецЕсли;	
		Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда 
			ЗаполнитьСписокВыбораДоверенностейПлательщика();  
			Если НЕ Элементы.Доверенность.СписокВыбора.Количество() = 0 Тогда
				Если НЕ ДоверенностьПереоформление = Элементы.Доверенность.СписокВыбора.Получить(0).Значение Тогда
				    ДоверенностьПереоформление = Элементы.Доверенность.СписокВыбора.Получить(0).Значение;
					ЗаполнитьТекстДоверенности();
				КонецЕсли; 
			Иначе    
				ДоверенностьПереоформление = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
				Доверенность = "";
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	

КонецПроцедуры 


&НаСервере
Процедура ИнформацияОДокументеВСтроку()
	Информация = "";
	Информация = СокрЛП(ДокументВид);
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументСерия), " " + СокрЛП(ДокументСерия), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументНомер), " " + СокрЛП(ДокументНомер), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументКемВыдан), " выдан " + СокрЛП(ДокументКемВыдан), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументДатаВыдачи), " " + Формат(ДокументДатаВыдачи,"ДФ=dd.MM.yyyy"), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументКодПодразделения), " код подр. " + СокрЛП(ДокументКодПодразделения), "");
