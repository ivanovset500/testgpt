&НаКлиенте
Процедура ПослеУдаленияЧМ(СтрокаТабличнойЧасти)
	
	СтруктураОтбора = Новый Структура("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);
	РезультатОтбораВставки = Вставки.НайтиСтроки(СтруктураОтбора);
	МассивКУдалению = Новый Массив;
	Для Каждого ТекущаяСтрока Из РезультатОтбораВставки Цикл
		Если ПроверкаВидаКомплектующегоНика(ТекущаяСтрока.ВидВставки) Тогда
			МассивКУдалению.Добавить(ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из МассивКУдалению Цикл
		Вставки.Удалить(Вставки.Индекс(ТекущаяСтрока));
	КонецЦикла;
	
КонецПроцедуры




