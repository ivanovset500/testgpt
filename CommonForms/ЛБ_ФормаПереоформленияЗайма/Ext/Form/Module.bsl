&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
        ДокументЗайма = Параметры.Документ; 
		Если ДокументЗайма.Проведен тогда
			НеРедактировать = Истина;    
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		Иначе
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		КонецЕсли;	
		ДатаДок = ДокументЗайма.Дата; 
		Ломбард = ДокументЗайма.Ломбард;  
		Организация = ДокументЗайма.Организация;
		ОтветственныйСотрудник = ДокументЗайма.ОтветственныйСотрудник;
		ОтветственныйПользователь = ДокументЗайма.ОтветственныйПользователь;
		Комментарий = ДокументЗайма.Комментарий;  
		ПредыдущаяОперация = ДокументЗайма.ПредыдущаяОперация;
		Залогодатель = ДокументЗайма.Залогодатель; 
		ДокументЗалогодателя = ДокументЗайма.ДокументЗалогодателя;  
		Представитель = ДокументЗайма.Представитель; 
		ДокументПредставителя = ДокументЗайма.ДокументПредставителя; 
		НомерЗБ = ДокументЗайма.НомерЗалоговогоБилета;
		СхемаКредитования = ДокументЗайма.СхемаКредитования;
		СрокЗалога = ДокументЗайма.СрокЗалога; 
		СуммаЗайма = ДокументЗайма.СуммаСсуды;
		Акция = ДокументЗайма.Акция;  
		ПСК_LX = ДокументЗайма.ПСК_LX;
		СуммаСсуды = ДокументЗайма.СуммаСсуды;
		Промокод = ДокументЗайма.Промокод; 
		Предъявитель = ДокументЗайма.Предъявитель;
		ОтказОтВыкупа = ДокументЗайма.ОтказОтВыкупа;  
		ПроцентнаяСхема = ДокументЗайма.ПроцентнаяСхема; 
		ПредельныйСрокЗайма = ДокументЗайма.ПредельныйСрокЗайма; 
		ПредельныйСрокЗаймаДни = ДокументЗайма.ПредельныйСрокЗаймаДни;                                        
		ДатаВыкупа = ДокументЗайма.ДатаВыкупа;
		ДатаВыкупаЛьготная = ДокументЗайма.ДатаВыкупаЛьготная; 
		СогласиеНаСМСРассылку = ДокументЗайма.СогласиеНаСМСРассылку; 
		ТекущаяУстановкаУсловийПоСхемеКредитования = ДокументЗайма.ТекущаяУстановкаУсловийПоСхемеКредитования; 
		ПриказСтавки = ДокументЗайма.ПриказСтавки; 
		ПриказАкцияСтавки = ДокументЗайма.ПриказАкцияСтавки; 
		ОтклонениеПоАкции = ДокументЗайма.ОтклонениеПоАкции;

		ЗаполнитьКонтакнуюИнформациюЗалогодателя();
	    КонтактнаяИнформацияВСтроку();
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();   
		ЗаполнитьКонтакнуюИнформациюПредставителя();
	    КонтактнаяИнформацияПредставителяВСтроку();
		ЗаполнитьИнформациюОДокументеПредставителя();
		ИнформацияОДокументеПредставителяВСтроку();
		СтатусЗалогодателя = ДокументЗайма.СтатусЗалогодателя; 
		Если ЗначениеЗаполнено(Представитель) Тогда
			Плательщик = Представитель;
		Иначе	
		    Плательщик = Залогодатель;
		КонецЕсли;	
		Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда			
			Элементы.ГруппаДоверенность.Видимость = Истина; 
			ЗаполнитьСписокВыбораДоверенностейПлательщика();
			ДоверенностьПереоформление = ДокументЗайма.ДоверенностьПредставителя;
			ЗаполнитьТекстДоверенности();
		КонецЕсли;	  
		//ЗаполнитьТовары(); 		
		//ЗаполнитьТабличныеЧасти();
		//Мельников 25.04.24 Отмена операции
		//+МАН 17.06.25 Изменил на запрос
		//Мельников 25.04.24 Отмена операции
		ДокументОтмены = ПолучитьДокументОтмены(ДокументЗайма); //Было: ДокументЗайма.ДокументОтмены;
		//-МАН
		//+МАН 10.12.25
		ПриказВИПСтавки = ДокументЗайма.ПриказВИПСтавки;
		//-МАН
		Если Параметры.ТолькоПросмотр = Истина Тогда	
			Этаформа.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе              		
		Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();   
		Если Параметры.Свойство("Дата") Тогда 
			ДатаДок = Параметры.Дата;
		Иначе	
		    ДатаДок = ТекущаяДата(); 
		КонецЕсли;	
		Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		//Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		//  	ОтветственныйПользователь = ТекПользователь;
		//Иначе
		//	ОтветственныйПользователь = ПараметрыСеанса.ТекущийСотрудник;
		//КонецЕсли;
		ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;
		ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;

		ПредыдущаяОперация = Параметры.ПредыдущаяОперация;
		Если Параметры.Свойство("Залогодатель") Тогда 
			Залогодатель = Параметры.Залогодатель;
			ЗаполнитьИнфорациюОЗалогодателе(Параметры, Ложь); 
			ЗаполнитьДопДокументы();
			СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДатаДок, Залогодатель); 
			СогласиеНаСМСРассылку = ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ДатаДок, Залогодатель); 
			
			СотрудникПользователь = ПроверитьКлиентСотрудник(Залогодатель);
			Если НЕ СотрудникПользователь = неопределено Тогда  
				//Если СотрудникПользователь = ОтветственныйПользователь Тогда
				Если СотрудникПользователь = ОтветственныйСотрудник Тогда
					ОбщегоНазначения.СообщитьПользователю("Выбранный заемщик является сотрудником оформляющим займ. Это запрещено!"); 
					Отказ = Истина;
					Возврат;  				
				КонецЕсли;	
			КонецЕсли;	     			
		КонецЕсли;  
		Если Параметры.Свойство("ОтказОтВыкупа") Тогда
			ОтказОтВыкупа = Параметры.ОтказОтВыкупа;
		КонецЕсли;   
		Если Параметры.Свойство("Представитель") Тогда   
			Представитель = Параметры.Представитель;
			ЗаполнитьИнфорациюОПредставителе(Параметры, ложь); 
			ЗаполнитьДопДокументыПредставителя();
		КонецЕсли;	   
	
		Если ЗначениеЗаполнено(Представитель) Тогда
			Плательщик = Представитель;
		Иначе	
		    Плательщик = Залогодатель;
		КонецЕсли;	
		Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда			
			Элементы.ГруппаДоверенность.Видимость = Истина; 
			ЗаполнитьСписокВыбораДоверенностейПлательщика();
			Если Параметры.Свойство("ДоверенностьПредставителя") Тогда
				Для Сч = 0 По Элементы.Доверенность.СписокВыбора.Количество()-1 Цикл 
					Если Элементы.Доверенность.СписокВыбора.Получить(сч).Значение = Параметры.ДоверенностьПредставителя Тогда
					    ДоверенностьПереоформление = Элементы.Доверенность.СписокВыбора.Получить(сч).Значение;
					    ЗаполнитьТекстДоверенности();
						Прервать;
					КонецЕсли;	
				КонецЦикла;  
			КонецЕсли;
		КонецЕсли;	 
	КонецЕсли;        
	
	Если НЕ ЗначениеЗаполнено(ПредыдущаяОперация) Тогда 
		ОбщегоНазначения.СообщитьПользователю("Не выбран переоформляемый залоговый билет!"); 
		Отказ = Истина;
		Возврат;  				
	КонецЕсли;	  
	
	СообщениеПроверкиПоЛомбарду = ЛБ_УправлениеЛомбардом.ПроверитьИзделияЗБВЛомбарде(ДатаДок, ПредыдущаяОперация, Ломбард); 
	Если НЕ ПустаяСтрока(СообщениеПроверкиПоЛомбарду) Тогда
		ОбщегоНазначения.СообщитьПользователю(СообщениеПроверкиПоЛомбарду + ". Переоформление запрещено."); 
    КонецЕсли;
	
	Элементы.ДекорацияЗБПереоформление.Заголовок = "Залоговый билет № " + сокрЛП(ЭтаФорма.ПредыдущаяОперация.НомерЗалоговогоБилета) +
	           " от " + Формат(ЭтаФорма.ПредыдущаяОперация.Дата, "ДЛФ=") +
	           ", заемщик " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Фамилия) + " " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Имя) + 
	           ?(ЗначениеЗаполнено(ЭтаФорма.ПредыдущаяОперация.Отчество), " " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Отчество), "") + 
	           ", " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.СхемаКредитования) + " на " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.СрокЗалога) + " дней, " + 
			   ?(ЗначениеЗаполнено(ЭтаФорма.ПредыдущаяОперация.Ломбард.НомерЛомбарда), "ломбард № " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Ломбард.НомерЛомбарда), СокрЛП(ЭтаФорма.ПредыдущаяОперация.Ломбард)); 
	ЗаполнитьСостояниеЗалоговогоБилета();		   
	ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;	
	ОсновнаяЕдиницаИзмеренияКамни = Константы.ЛБ_ОсновнаяЕдиницаКамни.Получить();
	ОсновнаяЕдиницаИзмеренияМеталлы = Константы.ЛБ_ОсновнаяЕдиницаМеталлы.Получить();
	ЗаполнитьТаблицуДопСтатусовКлиента();	
	ПолучитьДопСтатусыКлиента();         
	ЗаполнитьСписокЛьготныхСтатусов(); 
	ПолучитьНастройкиЗайма(); 
				
	ПолучитьДоступныеПроцентныеСхемыАкции();  
	Если ЭтоСотрудник Тогда
	    ЕстьЛьготыСотрудника = ПроверитьЕстьЛьготыСотрудника(); 
		ЗаполнитьЛьготныеСтатусыСотрудника();
		СуммаЗаймаПоЛьготамСотрудника = ЛБ_УправлениеЛомбардом.ПолучитьЛьготнуюСуммуЗаймаСотрудника(ДатаДок, Залогодатель);  
		УстановитьТекстСуммаЗаймаСотрудник();  
		Элементы.ДекорацияСотрудник.Видимость = ?(НЕ НеРедактировать, Истина, ложь);
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) Тогда
		Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
			СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			СхемаКредитования = СтрокаСК.СхемаКредитования;  
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;   			
			ЗаполнитьТаблицуСтавок();
		КонецЕсли; 
		РассчитатьПредельныСрокЗайма();	        
	КонецЕсли;	
	
	ОбработатьСхемуКредитованияНаСервере();
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ДатаДок, Организация);
	Если НЕ СтруктураП = неопределено Тогда
        ПСК = СтруктураП.ПСКГод;  
	Иначе
		ПСК = 0;
	КонецЕсли; 

	Если НЕ ЗначениеЗаполнено(ДокументЗайма) Тогда
		ЗаполнитьТабличныеЧасти(Истина); 
		СуммаЗайма = Товары.Итог("СуммаСсуды");
		ОбработатьПСКНасервере();
	Иначе    
		ЗаполнитьТабличныеЧасти(); 
		Отбор = Новый Структура;
		Отбор.Вставить("ДеньНач", 1);
		Строки = ГрафикПлатежей.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			СуммаПроцентовДень = Строки.Получить(0).СуммаПроцентовДень;
		КонецЕсли;	

		СуммаПроцентов = ДокументЗайма.ГрафикПлатежей.Итог("СуммаПроцентов");
		СуммаПроцентовЗБ = СуммаПроцентов;		
	    ПСКГод = РасчетПСКГод(СуммаЗайма, СуммаПроцентовЗБ);
	КонецЕсли; 		
	СуммаЗаймаДень = ПроверитьЕстьЗалогиДень();	

	ПроверитьДоступностьДопКнопок();
	Если НЕ ЗначениеЗаполнено(ПроцентнаяСхема) Тогда
        Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	
    СтатусыКлиентаВСтроку();	                              
	ТоварыИтоги();
	ВставкиИтоги(); 
	ЗаполнитьКВыдачеВнесению();
	УстановитьВидимость(); 
	ДополнительныеМеталлыИтоги(); 	
	Если ЗначениеЗаполнено(ДокументЗайма) тогда
	    Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаОбъектыЗалога;  
	КонецЕсли;	
	Элементы.ДекорацияСуммаЗаймаДень.Видимость = ?(Этаформа.СуммаЗаймаДень = 0, Ложь, Истина);  	
	ДатаДокТекущая = ДатаДок;   
	МинСуммаЗайма = ЛБ_ОбщийМодуль.ПолучитьМинимальнуюСуммуЗайма(ДатаДок);
	//+Мельников 25.04.24 Отмена операции
	УстановитьВидимость();
	//+Мельников 13.08.24 Формирование списка проб по прейскуранту. Заявка 2677.
	ЗаполнитьСписокПроб();
	//-Мельников
	
	//++ИВВ 02.2026, вычеты для часов
	ПроверкаВставокПриОткрытииНика();
	ПроверкаВставокПриОткрытииМеханизм();
	//--ИВВ
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьСписокВыбораДоверенностейПлательщика() 
	Элементы.Доверенность.СписокВыбора.Очистить();
	Если Плательщик = ПредыдущаяОперация.Залогодатель Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ПредыдущаяОперация);
	Запрос.УстановитьПараметр("Клиент", ПредыдущаяОперация.Залогодатель);
	Запрос.УстановитьПараметр("Представитель", Плательщик);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Клиент = &Клиент
	               |				И Доверенность.ПредставительКлиента = &Представитель
	               |				И СтатусДоверенности = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена)) КАК ЛБ_ДоверенностиСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать(); 	
	Пока Выборка.Следующий() Цикл  
		Если Выборка.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда   
			ОписаниеДоверенности = "Свидетельство о праве на наследство № " + СокрЛП(Выборка.Доверенность.НомерДоверенности) + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy");
		Иначе	
			Если Выборка.Доверенность.СрокДействияДоверенности  < НачалоДня(ДатаДок) Тогда
				Продолжить;
			КонецЕсли;	      
			ОписаниеДоверенности = "Доверенность " + НРег(строка(Выборка.Доверенность.ВидДоверенности)) + " № " +
					   ?(НЕ ПустаяСтрока(Выборка.Доверенность.НомерДоверенности), СокрЛП(Выборка.Доверенность.НомерДоверенности), "б/н") + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
					   " действует до " + Формат(Выборка.Доверенность.СрокДействияДоверенности, "ДФ=dd.MM.yyyy");   
		КонецЕсли;			   
		Элементы.Доверенность.СписокВыбора.Добавить(Выборка.Доверенность, ОписаниеДоверенности);
	Конеццикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстДоверенности()   
	Если ЗначениеЗаполнено(ДоверенностьПереоформление) Тогда  
		Если ДоверенностьПереоформление.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда   
			Доверенность = "Свидетельство о праве на наследство № " + СокрЛП(ДоверенностьПереоформление.НомерДоверенности) + " от " + Формат(ДоверенностьПереоформление.ДатаДоверенности, "ДФ=dd.MM.yyyy"); 
		Иначе	
		    Доверенность = "Доверенность " + НРег(строка(ДоверенностьПереоформление.ВидДоверенности)) + " № " +                                                                                               		
				   ?(НЕ ПустаяСтрока(ДоверенностьПереоформление.НомерДоверенности), СокрЛП(ДоверенностьПереоформление.НомерДоверенности), "б/н") + " от " + Формат(ДоверенностьПереоформление.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
				   " действует до " + Формат(ДоверенностьПереоформление.СрокДействияДоверенности, "ДФ=dd.MM.yyyy"); 
		КонецЕсли;		   
	Иначе
		Доверенность = "";
	КонецЕсли;	
КонецПроцедуры


&НаСервере
Функция СоздатьНовуюОплатуПроцентов()
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.ПредыдущаяОперация = ПредыдущаяОперация; 
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ЭтаФорма.ДокументЗайма), ДатаДок-1, ДатаДок); 
	ДокументОбъект.Организация = Организация;
	ДокументОбъект.ПроцентнаяСхема = ПредыдущаяОперация.ПроцентнаяСхема;  
	ДокументОбъект.Выкуп = Истина;
	Возврат ДокументОбъект; 
КонецФункции

&НаСервере
Функция РасчитатьДолгПоПроцентам(ЗалоговыйБилет, СтатусЗБ, СуммаЗайма, ПроцентнаяСтавка, ДатаНачалаРасчета) 
	Если  СуммаЗайма = 0 Тогда  
		НачисленоПроцентов = 0;
	    Возврат 0;
	КонецЕсли;
	
	ТаблицаОплатДетально.Очистить();
	ДокументОбъект = СоздатьНовуюОплатуПроцентов(); 	    
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
	Если НЕ СтруктураП = неопределено Тогда
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
	Иначе
		ПредельноеЗначениеПроцентов = 0;
	КонецЕсли;   
	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
	ПричинаПримененияПроцентнойСхемыОплата = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(ДокументОбъект, ЗалоговыйБилет);
	//ПричинаПримененияПроцентнойСхемыОплата = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ОплатаПроцентов;
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемыОплата, Установки, СтруктураОкр); 
			
	Для каждого стр из ДокументОбъект.НачислениеПроцентовДетально Цикл 
	    НоваяСтр = ТаблицаОплатДетально.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	КонецЦиклА;
	
	НачисленоПроцентов = Результат.СуммаПроцентовНачислено;
	
	Возврат Результат.СуммаПроцентов;
КонецФункции
	
&НаСервере
Процедура ЗаполнитьСостояниеЗалоговогоБилета() 
	ЗалоговыйБилет = ПредыдущаяОперация; 
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Если ЗначениеЗаполнено(ЭтаФорма.ДокументЗайма) Тогда
		Запрос.УстановитьПараметр("Период", ДатаДок-1); 
	Иначе	
	    Запрос.УстановитьПараметр("Период", ДатаДок);  		
	КонецЕсли;	                                       
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения КАК НомерДопСоглашения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСостояний.Очистить();
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрСостояние = ТаблицаЗапроса.Получить(0);
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		НоваяСтр.Статус = СтрСостояние.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
		НоваяСтр.ПредельныйСрокЗайма = СтрСостояние.ПредельныйСрокЗайма;
		НоваяСтр.ПредельныйСрокЗаймаДни = СтрСостояние.ПредельныйСрокЗаймаДни;  
		//НоваяСтр.СуммаИтог = СтрСостояние.СуммаЗайма; 
				
		КолСтр = ТаблицаЗапроса.Количество()-1;  		
		СтрСостояние = ТаблицаЗапроса.Получить(КолСтр);   
		Если ТипЗнч(СтрСостояние.Регистратор) = Тип("ДокументСсылка.ЛБ_КарточкаЗалогодателя") Тогда
			ТекущийСтатусЗБ = СтрСостояние.СтатусЗалоговогоБилета; 
			СтрСостояние = ТаблицаЗапроса.Получить(КолСтр-1); 
		Иначе
			ТекущийСтатусЗБ = неопределено;
		КонецЕсли;	
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета до переоформления";
		НоваяСтр.КлючСтроки = 2;
		НоваяСтр.Статус = ?(ТекущийСтатусЗБ = неопределено, СтрСостояние.СтатусЗалоговогоБилета, ТекущийСтатусЗБ); 
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;  
		НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;  
	    НоваяСтр.СуммаПроцентовДолг = РасчитатьДолгПоПроцентам(ЗалоговыйБилет, НоваяСтр.Статус, НоваяСтр.СуммаЗайма, НоваяСтр.ПроцентнаяСтавка, НоваяСтр.ДатаНачалаРасчета);		 
		НоваяСтр.НомерДС = СтрСостояние.НомерДопСоглашения; 
		НоваяСтр.СуммаИтог = СтрСостояние.СуммаЗайма + НоваяСтр.СуммаПроцентовДолг;
			  
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета после переоформления";
		НоваяСтр.КлючСтроки = 3;
		НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт; 
   	Иначе
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета до переоформления";
		НоваяСтр.КлючСтроки = 2;     
		
		БезПродленияДоговора = ложь;
	КонецЕсли;	  
	
	СтрСостояние = ТаблицаСостояний.Получить(1);
	ИнформацияВыкуп = "Сумма выкупа: ";  
	ИнформацияВыкуп = ИнформацияВыкуп + Формат(СтрСостояние.СуммаЗайма+СтрСостояние.СуммаПроцентовДолг, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧРГ=; ЧН=0,00") + " руб."; 
	Элементы.ДекорацияВыкуп.Заголовок = ИнформацияВыкуп;   
	ИнформацияВыкупРасшифровка = "";
	ИнформацияВыкупРасшифровка = ИнформацияВыкупРасшифровка + "(в том числе, долг по займу " + Формат(СтрСостояние.СуммаЗайма, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧРГ=; ЧН=0,00") + " руб.";
	ИнформацияВыкупРасшифровка = ИнформацияВыкупРасшифровка + ", долг по процентам " + Формат(СтрСостояние.СуммаПроцентовДолг, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧРГ=; ЧН=0,00") + " руб.)";
	Элементы.ДекорацияВыкупРасшифровка.Заголовок = ИнформацияВыкупРасшифровка;
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьКВыдачеВнесению()  
	СтрСостояние = ТаблицаСостояний.Получить(1);  
	СуммаВыкупа = СтрСостояние.СуммаЗайма + СтрСостояние.СуммаПроцентовДолг;
	Если СуммаЗайма >= СуммаВыкупа Тогда
		СуммаКВнесению = 0;
		СуммаКВыдаче = СуммаЗайма - СуммаВыкупа;
	Иначе 
		СуммаКВнесению = СуммаВыкупа - СуммаЗайма;
		СуммаКВыдаче = 0;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ПроверитьКлиентСотрудник(Клиент)
    Возврат ЛБ_УправлениеЛомбардом.ПроверитьКлиентСотрудник(Клиент);
КонецФункции

&НаСервере
Процедура ЗаполнитьЛьготныеСтатусыСотрудника()  
	ДопСтатусСотрудник = Константы.ЛБ_ДопСтатусСотрудника.Получить();
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПромокодПредъявитель() 
	Если НЕ ПустаяСтрока(Промокод) Тогда
		Элементы.Предъявитель.Доступность = Ложь; 
	Иначе
		Элементы.Предъявитель.Доступность = Истина;
	КонецЕсли;   
	Если Предъявитель Тогда
		Элементы.Промокод.Доступность = Ложь; 
	Иначе
		Элементы.Промокод.Доступность = Истина;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопДокументы()  	
	УдСтроки = Новый СписокЗначений;
	Отбор = Новый Структура;
	Отбор.Вставить("Клиент", Залогодатель);    
	СтрокиДоп = ДопДокументы.НайтиСтроки(Отбор);
	Для каждого СтрДоп из СтрокиДоп Цикл
		УдСтроки.Добавить(СтрДоп);
	КонецЦикла;	                
	Для каждого Эл Из УдСтроки Цикл 
		ДопДокументы.Удалить(Эл.Значение);
	КонецЦикла;	
	Если  ЗначениеЗаполнено(Гражданство) И НЕ Гражданство = Справочники.СтраныМира.Россия тогда 
			ТаблицаДоп = ЛБ_УправлениеЛомбардом.ПолучитьДокументыПравоПребыванияРФ(ДатаДок, Залогодатель, Гражданство);   
		Для каждого СтрДоп из ТаблицаДоп Цикл
			НоваяСтрДоп = ДопДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрДоп, СтрДоп);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопДокументыПредставителя()  
	УдСтроки = Новый СписокЗначений;
	Отбор = Новый Структура;
	Отбор.Вставить("Клиент", Представитель);    
	СтрокиДоп = ДопДокументы.НайтиСтроки(Отбор);
	Для каждого СтрДоп из СтрокиДоп Цикл
		УдСтроки.Добавить(СтрДоп);
	КонецЦикла;	                
	Для каждого Эл Из УдСтроки Цикл 
		ДопДокументы.Удалить(Эл.Значение);
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(ГражданствоПредставителя) И НЕ ГражданствоПредставителя = Справочники.СтраныМира.Россия тогда
		ТаблицаДоп = ЛБ_УправлениеЛомбардом.ПолучитьДокументыПравоПребыванияРФ(ДатаДок, Представитель, ГражданствоПредставителя);  
		Для каждого СтрДоп из ТаблицаДоп Цикл
			НоваяСтрДоп = ДопДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрДоп, СтрДоп);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьПредельныСрокЗайма()
	ПредельныйСрокЗаймаДни = ЛБ_УправлениеЛомбардом.ПолучитьПредельныйСрокЗайма(ДатаДок, СхемаКредитования);
	Если НЕ ПредельныйСрокЗаймаДни = 0 Тогда  
		ПредельныйСрокЗайма = НачалоДня(ДатаДок) + ПредельныйСрокЗаймаДни*24*60*60;
	Иначе  
		ПредельныйСрокЗайма = Дата(1,1,1);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройкиЗайма()
	ЗапросН = Новый Запрос;
	ЗапросН.УстановитьПараметр("Дата", Этаформа.ДатаДок);
	ЗапросН.Текст = "ВЫБРАТЬ
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Настройка КАК Настройка,
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Значение КАК Значение
	                |ИЗ
	                |	РегистрСведений.ЛБ_НастройкаЗайма.СрезПоследних(&Дата, ) КАК ЛБ_НастройкаЗаймаСрезПоследних
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = ЗапросН.Выполнить().Выгрузить();
	НастройкиЗайма.Загрузить(ТаблицаЗапроса);
КонецПроцедуры 

&НаСервере
Функция ИнформацияПродукт()
	Если НЕ ЗначениеЗаполнено(СхемаКредитования) тогда
		Возврат "";
	КонецЕсли;
	Возврат  СокрЛП(СхемаКредитования) + ?(ЗначениеЗаполнено(Акция), ", " + СокрЛП(Акция), "");
КонецФункции	

&НаКлиенте
Процедура ПриОткрытии(Отказ)   
	СписокСС = ПолучитьСлужебныеСтатусыКлиента(Плательщик);
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение, 1);
			Если СтруктураВозврата.Запрет Тогда 
				ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов");
				//+МАН 03.04.26 Изменено сообщение. Заявка 3759
				//Предупреждение("Для клиента " + СокрЛП(Плательщик) + " определен запрет на операцию " + Строка(ВидОперации), 60, "Проверка служебных статусов клиента");
				Предупреждение("Клиенту " + СокрЛП(Плательщик) + " присвоен служебный статус """ + Строка(Элемент.Значение) + """, в связи с чем запрещена операция: """ + Строка(ВидОперации) + """", 60, "Проверка служебных статусов клиента");
				//-МАН
				Отказ = Истина;
				Возврат;  
			Иначе
				ПредупреждениеП = СтруктураВозврата.Предупредить;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
				Отказ = Истина;
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;      

	СписокСС = ПолучитьСлужебныеСтатусыКлиента(Залогодатель);
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение, 2);
			Если СтруктураВозврата.Запрет Тогда 
				ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление");
				//+МАН 03.04.26 Изменено сообщение. Заявка 3759
				//Предупреждение("Для клиента " + СокрЛП(Залогодатель) + " определен запрет на операцию " + Строка(ВидОперации), 60, "Проверка служебных статусов клиента");
				Предупреждение("Клиенту " + СокрЛП(Залогодатель) + " присвоен служебный статус """ + Строка(Элемент.Значение) + """, в связи с чем запрещена операция: """ + Строка(ВидОперации) + """", 60, "Проверка служебных статусов клиента");
				//-МАН
				Отказ = Истина;
				Возврат;  
			Иначе
				ПредупреждениеП = СтруктураВозврата.Предупредить;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
				Отказ = Истина;
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;      
		
	Если НЕ ДопДокументы.Количество() = 0 Тогда
		Элементы.ГруппаДопДокумент.Показать(); 
	КонецЕсли;	
	
	Если НеРедактировать Тогда  
		Элементы.Редактировать.Видимость = ?(Этаформа.ТолькоПросмотр, Ложь, Истина);
		Элементы.КнопкаИстория.Видимость = Истина;
		Элементы.ВыдатьЗайм.Доступность = ложь;
		Элементы.ТоварыГруппаЭ.Доступность = ложь; 
		Элементы.ПовышеннаяОценка.Доступность = ложь; 
		Элементы.Округление.Доступность = ложь;
		Элементы.Отмена.Заголовок = "Закрыть";  
	Иначе
		Если ПроцентУвеличенияОценкиЗалога = 0 Тогда  
			Элементы.ПовышеннаяОценка.Доступность = ложь; 
			ПовышеннаяОценка = Ложь;
		КонецЕсли;
	КонецЕсли;		
	ОбновитьДанныеТовары(); 
	ОбновитьДанныеВставки();			
	Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;
	ПриСменеСтраницы(Элементы.ОсновнаяПанель.ТекущаяСтраница); 
	
	Если ЗначениеЗаполнено(Залогодатель) И НЕ ЗначениеЗаполнено(ДокументЗайма) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", ?(ЗначениеЗаполнено(Представитель), Представитель, Залогодатель));	
			
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеПроверкиАктуальности",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПроверкаАктуальностиДанныхКлиента", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;  
КонецПроцедуры  

