&НаСервере
Процедура ОчиститьДокументыЗалогодателя()
	Отбор = Новый структура;
	Отбор.Вставить("Клиент", Залогодатель);
	СтрокиДоп = ДопДокументы.НайтиСтроки(Отбор);
	Для каждого СтрДоп Из строкиДоп Цикл
		ДопДокументы.Удалить(СтрДоп);
	Конеццикла;	
	
	ДокументЗалогодателя = Справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
	ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПустаяСсылка();
	ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ПустаяСсылка();
	ДокументГражданство = Справочники.СтраныМира.ПустаяСсылка();
	ДокументДатаВыдачи = Дата(1,1,1);
	ДокументКемВыдан = "";
	ДокументНомер = "";
	ДокументСерия = "";
	ДокументКодПодразделения = "";
	ДокументНачалоДействия = Дата(1,1,1);
	ДокументСрокДействия = Дата(1,1,1);
	ЭтаФорма.Паспорт = "";
КонецПроцедуры

