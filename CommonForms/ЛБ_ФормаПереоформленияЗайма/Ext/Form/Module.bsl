//+Мельников 13.08.24 Формирование списка проб по прейскуранту. Заявка 2677.
&НаСервере
Процедура ЗаполнитьСписокПроб()

	ЗапросДокумента = Новый Запрос;
	ЗапросДокумента.Текст = 
		//+Мельников 19.08.24 По каким то причинам показывал не срез последних, а все что были до указанной даты. Изменил запрос.
		//"ВЫБРАТЬ
		//|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба КАК Проба
		//|ИЗ
		//|	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
		//|
		//|СГРУППИРОВАТЬ ПО
		//|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба
		//|АВТОУПОРЯДОЧИВАНИЕ";
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Период УБЫВ";
	
	ЗапросДокумента.УстановитьПараметр("Дата", ЭтотОбъект.ДатаДок);
	ЗапросДокумента.УстановитьПараметр("Ломбард", ЭтотОбъект.Ломбард);
	
	РезультатДокумент = ЗапросДокумента.Выполнить().Выбрать();

	Если РезультатДокумент.Следующий() Тогда
		
		ЗапросПроб = Новый Запрос;
		ЗапросПроб.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы.Проба КАК Проба
		|ИЗ
		|	Документ.ЛБ_ПриказУсловияПредоставленияЗаймов.ЦеныМеталлы КАК ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЛБ_ПриказУсловияПредоставленияЗаймов КАК ЛБ_ПриказУсловияПредоставленияЗаймов
		|		ПО ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы.Ссылка = ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка
		|ГДЕ
		|	ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы.Проба
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		ЗапросПроб.УстановитьПараметр("Ссылка", РезультатДокумент.Регистратор);
		
		Элементы.ТоварыПроба.СписокВыбора.Очистить();
		Элементы.ТоварыПроба.РежимВыбораИзСписка = Истина;
		Элементы.ТоварыПроба.СписокВыбора.ЗагрузитьЗначения(ЗапросПроб.Выполнить().Выгрузить().ВыгрузитьКолонку("Проба"));

