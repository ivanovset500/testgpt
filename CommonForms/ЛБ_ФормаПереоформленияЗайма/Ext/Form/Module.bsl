&НаСервере
Процедура ТоварыИтоги()  
	ТоварыИтогКоличество = 0;
	ТоварыИтогВес = 0; 
	ТоварыИтогВесМеталл = 0;
	ТоварыИтогОценкаМеталл = 0;
	ТоварыИтогОценкаВставки = 0; 
	ТоварыИтогОценка = 0;
    ТоварыИтогМаксОценка = 0;
	ТоварыИтогСсуда = 0;

	Для каждого Стр из Товары Цикл
		Если НЕ Стр.Переоформить Тогда  
			Продолжить;
		КонецЕсли;	
		ТоварыИтогКоличество = ТоварыИтогКоличество + Стр.Количество;
		ТоварыИтогВес = ТоварыИтогВес  + Стр.Вес; 
		ТоварыИтогВесМеталл = ТоварыИтогВесМеталл + Стр.ВесЧистый;
		ТоварыИтогОценкаМеталл = ТоварыИтогОценкаМеталл + Стр.СуммаОценкиМеталлы;
		ТоварыИтогОценкаВставки = ТоварыИтогОценкаВставки + Стр.СуммаОценкиКамни; 
		ТоварыИтогОценка = ТоварыИтогОценка + Стр.СуммаОценки;
	    ТоварыИтогМаксОценка = ТоварыИтогМаксОценка + Стр.СуммаОценкиМаксимальная;
		ТоварыИтогСсуда = ТоварыИтогСсуда + Стр.СуммаСсуды;
	КонецЦикла;
КонецПроцедуры 

