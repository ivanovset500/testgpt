	ДокументСерияПредставителя = "";
	ДокументКодПодразделенияПредставителя = "";
	ДокументНачалоДействияПредставителя = Дата(1,1,1);
	ДокументСрокДействияПредставителя = Дата(1,1,1);
	ЭтаФорма.ПаспортПредставителя = "";
КонецПроцедуры

&НаСервере
Процедура ОчиститьПредставителя()   
	ОчиститьДокументыПредставителя();
