&НаСервере
Процедура ВыборЗалогодателяНаСервере(Результат) 
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;
	Залогодатель = Результат.Залогодатель;
	ОчиститьДокументыЗалогодателя();
	ЗаполнитьИнфорациюОЗалогодателе(Результат);  	 
	Если НЕ Залогодатель = ПредыдущаяОперация.Залогодатель И ЗначениеЗаполнено(Представитель) Тогда
		ОчиститьПредставителя();
		ДопДокументы.Очистить();
	КонецЕсли;	  
	ЗаполнитьДопДокументы(); 
	Если ЗначениеЗаполнено(Представитель) Тогда
		Плательщик = Представитель;
	Иначе
		Плательщик = Залогодатель;  
	КонецЕсли;	
	Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда
		Элементы.ГруппаДоверенность.Видимость = Истина;
		ЗаполнитьСписокВыбораДоверенностейПлательщика();
		Если НЕ Элементы.Доверенность.СписокВыбора.Количество() = 0 Тогда 
			ДоверенностьПереоформление = Элементы.Доверенность.СписокВыбора.Получить(0).Значение;
			ЗаполнитьТекстДоверенности();
		КонецЕсли;      
	иначе
		Элементы.ГруппаДоверенность.Видимость = ложь; 
		ДоверенностьПлательщика = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
	КонецЕсли;    
	Если ЭтоСотрудник Тогда
		ЗаполнитьЛьготныеСтатусыСотрудника();
	КонецЕсли;
	
	НеРезидент = ?(Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия"), ложь, истина);
	СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДатаДок, Залогодатель);
	СогласиеНаСМСРассылку = ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ДатаДок, Залогодатель);
	ПолучитьДопСтатусыКлиента();   
	СтатусыКлиентаВСтроку();    		
	СуммаЗаймаДень = ПроверитьЕстьЗалогиДень();
	ЗаполнитьСписокЛьготныхСтатусов();  
	//Элементы.ДекорацияСуммаЗаймаДень.Видимость = ?(Этаформа.СуммаЗаймаДень = 0, Ложь, Истина);   
	РасчетСуммыОценкиИтоговой();
	
	ПолучитьДоступныеПроцентныеСхемыАкции();
    Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
        Иначе
			СхемаКредитования = СтрокаСК.СхемаКредитования;  
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция; 
			ОбработатьСхемуКредитованияНаСервере(); 
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт(); 
			ПроверитьДоступностьДопКнопок();
			ЗаполнитьТаблицуСтавок();			
			ОбработатьДополнительныеКнопки();
			ЗаполнитьДатуВыкупа();
		    ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа(); 
		КонецЕсли;	
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка"); 
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1); 
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;      
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  
 	УстановитьВидимость();
	ОбработатьПСКНасервере(); 
	ЗаполнитьКВыдачеВнесению();
КонецПроцедуры

&НаСервере
Процедура ВыборПредставителяНаСервере(Результат)  
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Представитель = Результат.Залогодатель;
	ОчиститьДокументыПредставителя();
	ЗаполнитьИнфорациюОПредставителе(Результат);  
	ЗаполнитьДопДокументыПредставителя();
	
	Если ЗначениеЗаполнено(Представитель) Тогда
		Плательщик = Представитель;
	Иначе
		Плательщик = Залогодатель;  
	КонецЕсли;	
	Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда
		Элементы.ГруппаДоверенность.Видимость = Истина;
		ЗаполнитьСписокВыбораДоверенностейПлательщика();
		Если НЕ Элементы.Доверенность.СписокВыбора.Количество() = 0 Тогда 
			ДоверенностьПлательщика = Элементы.Доверенность.СписокВыбора.Получить(0).Значение;
			ЗаполнитьТекстДоверенности();
		КонецЕсли;      
	иначе
		Элементы.ГруппаДоверенность.Видимость = ложь; 
		ДоверенностьПлательщика = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
	КонецЕсли;    
 	УстановитьВидимость(); 
КонецПроцедуры

&НаКлиенте
Процедура ДоверенностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыбЭлемент = ЭтаФорма.ВыбратьИзСписка(Элемент.СписокВыбора, Элемент, 0);
