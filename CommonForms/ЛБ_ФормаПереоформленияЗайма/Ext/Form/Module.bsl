&НаКлиенте
Процедура ДатаДокПриИзменении(Элемент) 	
	ДатаДокТекущая = ДатаДок;  
	СогласиеНаСМСРассылку = ПолучитьСогласиеНаСМСРассылку();
	ЗаполнитьКонтакнуюИнформациюЗалогодателя();
    КонтактнаяИнформацияВСтроку();
	ЗаполнитьИнформациюОДокументеЗалогодателя();
	ИнформацияОДокументеВСтроку(); 
	ЗаполнитьДопДокументы(); 
	ЗаполнитьДопДокументыПредставителя();
	ЗаполнитьСостояниеЗалоговогоБилета();
	
	СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента();
	Если ЭтоСотрудник Тогда
		ЗаполнитьЛьготныеСтатусыСотрудника();
	КонецЕсли;	
	ПолучитьДопСтатусыКлиента();  
	ЗаполнитьСписокЛьготныхСтатусов();
	СтатусыКлиентаВСтроку(); 
	СуммаЗаймаДень = ПроверитьЕстьЗалогиДень();  	
	//Элементы.ДекорацияСуммаЗаймаДень.Видимость = ?(Этаформа.СуммаЗаймаДень = 0, Ложь, Истина);  
	РасчетСуммыОценкиИтоговой(); 

	ПолучитьДоступныеПроцентныеСхемыАкции();
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СхемаКредитования = СтрокаСК.СхемаКредитования;   
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;     
			ОбработатьСхемуКредитованияНаСервере();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт(); 
			ПроверитьДоступностьДопКнопок();	
			ЗаполнитьТаблицуСтавок();   			
			ОбработатьДополнительныеКнопки();
		КонецЕсли;	
   	    ЗаполнитьДатуВыкупа();
	    ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
		ЗаполнитьТаблицуСтавок();
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка"); 
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1); 
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;   
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		ПовышеннаяОценка = Ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  	
	УстановитьВидимость();  
	РассчитатьПредельныСрокЗайма();
	ОбработатьПСКНасервере();
	ЗаполнитьКВыдачеВнесению();
	МинСуммаЗайма = ПолучитьМинСуммуЗайма();
	//+Мельников 13.08.24 Формирование списка проб по прейскуранту. Заявка 2677.
	ЗаполнитьСписокПроб();
	//-Мельников
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть(?(ЗначениеЗаполнено(ДокументЗайма), Истина, неопределено));
КонецПроцедуры 


&НаСервере
Функция ПроверитьКлиентаПоПеречням()
	РезультатПроверки = Истина; 
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК СтатусКлиентаВПеречне,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И ВидПеречня = &ВидПеречня) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ"; 

	СписокПеречней = Новый СписокЗначений;
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);  
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	Для каждого Эл из СписокПеречней Цикл 
		Запрос.УстановитьПараметр("ВидПеречня", Эл.Значение);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда     
			Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
				Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
					Сообщить("Клиент найден в перечне террористов. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
					Сообщить("Клиент найден в перечне ФРОМУ. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
		        ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
					Сообщить("Клиент найден в списке МВК. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
					Сообщить("Клиент найден в перечне ООН. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;	
				КонецЕсли;	  
			КонецЕсли;	
		КонецЕсли;     
	Конеццикла;	
	Возврат РезультатПроверки;
КонецФункции	

&НаСервере
Функция ПроверкаКлиента() 
	ВсеОК = Истина;
	
	ВозрастКлиента = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
	Если ВозрастКлиента  < 18 Тогда
	    Сообщить("Клиенту " + Строка(ВозрастКлиента) + " лет, работа с несовершеннолетними клиентами не осуществляется!", СтатусСообщения.Важное);
		ВсеОК = ложь;
	КонецЕсли;	
	
	Если НЕ ПроверитьКлиентаПоПеречням() Тогда
		ВсеОК = ложь;
	КонецЕсли; 
			
	Возврат ВсеОК;
КонецФункции    

&НаКлиенте
Процедура ФИОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Залогодатель) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
	КонецЕсли;	  
	ПараметрыФормы.Вставить("Дата", ДатаДок); 
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ПараметрыФормы.Вставить("НаТекущуюДату", Истина);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог"));
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалогодателя",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры  

