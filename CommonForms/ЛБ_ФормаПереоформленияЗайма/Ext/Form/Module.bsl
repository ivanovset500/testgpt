	ВставкиИтогВесГ = Вставки.Итог("ВесГраммы"); 
	ВставкиИтогОценка = Вставки.Итог("Сумма");
КонецПроцедуры

&НаСервере
Процедура ДополнительныеМеталлыИтоги() 
