&НаСервере
Процедура КонтактнаяИнформацияВСтроку()
	Информация = "";
	Информация = Информация + ?(ЗначениеЗаполнено(Гражданство), СокрЛП(Гражданство), "");
	Информация = Информация + ?(ЗначениеЗаполнено(Пол), ?(ПустаяСтрока(Информация), "", "; ") + "пол.: " + Строка(Пол), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДатаРождения), ?(ПустаяСтрока(Информация), "", "; ") + "дата рожд.: " +  Формат(ДатаРождения, "ДФ=dd.MM.yyyy"), "");
	Информация = Информация + ?(ЗначениеЗаполнено(МестоРождения), ?(ПустаяСтрока(Информация), "", "; ") + "место рожд.: " +  СокрЛП(МестоРождения), "");
	Информация = Информация + ?(ЗначениеЗаполнено(Телефон), ?(ПустаяСтрока(Информация), "", "; ") + "тел.: " + СокрЛП(Телефон), "");
	Информация = Информация + ?(ЗначениеЗаполнено(Email), ?(ПустаяСтрока(Информация), "", "; ") + "email: " + СокрЛП(Email), "");  
	Если ЗначениеЗаполнено(АдресПоПрописке) Тогда
		АдресК = "адрес по прописке: " + СокрЛП(АдресПоПрописке);
	Иначе  
		АдресК = "фактический адрес: " + СокрЛП(ФактическийАдрес);
	КонецЕсли;	
	Информация = Информация + ?(ПустаяСтрока(Информация), "", "; ") + АдресК;

	КонтактнаяИнформация = Информация;
КонецПроцедуры

&НаСервере
Процедура КонтактнаяИнформацияПредставителяВСтроку()
	Информация = "";
	Информация = Информация + ?(ЗначениеЗаполнено(ГражданствоПредставителя), СокрЛП(ГражданствоПредставителя), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ПолПредставителя), ?(ПустаяСтрока(Информация), "", "; ") + "пол.: " + Строка(ПолПредставителя), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДатаРожденияПредставителя), ?(ПустаяСтрока(Информация), "", "; ") + "дата рожд.: " +  Формат(ДатаРожденияПредставителя, "ДФ=dd.MM.yyyy"), "");
	Информация = Информация + ?(ЗначениеЗаполнено(МестоРожденияПредставителя), ?(ПустаяСтрока(Информация), "", "; ") + "место рожд.: " +  СокрЛП(МестоРожденияПредставителя), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ТелефонПредставителя), ?(ПустаяСтрока(Информация), "", "; ") + "тел.: " + СокрЛП(ТелефонПредставителя), "");
	Информация = Информация + ?(ЗначениеЗаполнено(EmailПредставителя), ?(ПустаяСтрока(Информация), "", "; ") + "email: " + СокрЛП(EmailПредставителя), "");
	АдресК = "";
	Если ЗначениеЗаполнено(АдресПоПропискеПредставителя) Тогда
		АдресК = "адрес по прописке: " + СокрЛП(АдресПоПропискеПредставителя);
	ИначеЕсли ЗначениеЗаполнено(ФактическийАдресПредставителя) Тогда  
		АдресК = "фактический адрес: " + СокрЛП(ФактическийАдресПредставителя);
	КонецЕсли;	
	Информация = Информация + ?(ПустаяСтрока(Информация), "", "; ") + АдресК;

	КонтактПредставителя = Информация;
КонецПроцедуры

