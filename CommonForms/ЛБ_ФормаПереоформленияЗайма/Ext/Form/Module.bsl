		//Элементы.ТоварыПроба.СписокВыбора.Очистить();
		//Элементы.ТоварыПроба.РежимВыбораИзСписка = Истина;
		//Элементы.ТоварыПроба.СписокВыбора.ЗагрузитьЗначения(ЗапросДокумента.Выполнить().Выгрузить().ВыгрузитьКолонку("Проба"));
		
	КонецЕсли;
	
КонецПроцедуры

//+Мельников 23.08.24 Настройка работы с комплектующим. Заявка 2735.
&НаКлиенте
Процедура ПослеВыбораКомплектующего(Результат, ДопПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Если Не ЗначениеЗаполнено(Элементы.Вставки.ТекущиеДанные.ВидВставки) Тогда
			УдалитьСтрокуВставки(Элементы.Вставки.ТекущиеДанные.ПолучитьИдентификатор());
		КонецЕсли;
		Возврат;
	ИначеЕсли Результат = Ложь Тогда
		УдалитьСтрокуВставки(Элементы.Вставки.ТекущиеДанные.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти       = Элементы.Вставки.ТекущиеДанные;
	
	СтрокаТабличнойЧасти.ВидВставки = Результат.ВидВставки;
	//++ИВВ, 02.2026, вычеты для часов ч.2
	Если ПроверкаВидаКомплектующегоНика(Результат.ВидВставки) И Не ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, 0) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 
			|'Для применения вычета на капсулу (для часов «Ника») необходимо вначале выбрать комплектующее «Часовой механизм».'"));
		
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = 0;
		СтрокаТабличнойЧасти.РазмерСкидкиМеханизм = 0;
		ПроверкаПослеУдаленияМеханизм();
		
		УдалитьСтрокуВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	
	Если ПроверкаВидаКомплектующегоМеханизм(Результат.ВидВставки) И ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, 1) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 
			|'Комплектующее «Часовой механизм» уже добавлено на форму выдачи займа. Повторное добавление невозможно!'"));
		Если ПроверкаНаличияНика(СтрокаТабличнойЧасти, 0) Тогда
			СтрокаТабличнойЧастиТовары.СкидкаНика = Ложь;
			СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = 0;
			СтрокаТабличнойЧасти.РазмерСкидкиНика = 0;
			ПроверкаПослеУдаленияНика();
		КонецЕсли;
		УдалитьСтрокуВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	
	Если ПроверкаВидаКомплектующегоНика(Результат.ВидВставки) И ПроверкаНаличияНика(СтрокаТабличнойЧасти, 1) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 
			|'Комплектующее «Ника, капсула» уже добавлено на форму выдачи займа. Повторное добавление невозможно!'"));
		УдалитьСтрокуВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	//--ИВВ
	
	//++ИВВ, 02.2026, вычеты для часов
	Если ПроверкаВидаКомплектующегоМеханизм(Результат.ВидВставки) Тогда
		Элементы.ТоварыСкидкаМеханизм.Видимость = Истина;
		Элементы.ТоварыСкидкаМеханизм.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Истина;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = Результат.РазмерСкидки;
		СтрокаТабличнойЧасти.РазмерСкидкиМеханизм = Результат.РазмерСкидки;
		Элементы.ТоварыВес30.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.Вес30 = Ложь;
	ИначеЕсли ПроверкаВидаКомплектующегоНика(Результат.ВидВставки) Тогда
		Элементы.ТоварыСкидкаНика.Видимость = Истина;
		Элементы.ТоварыСкидкаНика.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.СкидкаНика = Истина;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = Результат.РазмерСкидки;
		СтрокаТабличнойЧасти.РазмерСкидкиНика = Результат.РазмерСкидки;
		Элементы.ТоварыВес30.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.Вес30 = Ложь;
	КонецЕсли;
	
	Если Не ПроверкаВидаКомплектующегоМеханизм(Результат.ВидВставки)
		И Не ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, 0) Тогда	
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = 0;
		СтрокаТабличнойЧасти.РазмерСкидкиМеханизм = 0;
		ПроверкаПослеУдаленияМеханизм();
	КонецЕсли;
	
	Если Не ПроверкаВидаКомплектующегоНика(Результат.ВидВставки)
		И Не ПроверкаНаличияНика(СтрокаТабличнойЧасти, 0) Тогда
		СтрокаТабличнойЧастиТовары.СкидкаНика = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = 0;
		СтрокаТабличнойЧасти.РазмерСкидкиНика = 0;
		ПроверкаПослеУдаленияНика();
	КонецЕсли;
	//--ИВВ

	Если СтрокаТабличнойЧасти.НеОценивать Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;
	КонецЕсли;
	
	Если СтрокаТабличнойЧастиТовары <> Неопределено Тогда
		ВесМ = СтрокаТабличнойЧастиТовары.Вес;
		Отбор = Новый структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(Отбор); 
		Для каждого Стр Из СтрокиДоп Цикл
		    ВесМ = ВесМ - Стр.ВесЧистый;
		Конеццикла;
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);

		//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
		//Было: СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((ВесМ - СтруктураР.Вес)*100)/100; 
		//++ИВВ 02.2026, вычеты для часов
		//было:
		//СтрокаТабличнойЧастиТовары.ВесЧистый = ?(СтрокаТабличнойЧастиТовары.Вес30, Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100, Цел((ВесМ - СтруктураР.Вес)*100)/100);
		//-Мельников
		//стало:
		Если СтрокаТабличнойЧастиТовары.Вес30 Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100;
		ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И Не СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = (ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100);
		ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = (((ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100))
				* (100 - СтрокаТабличнойЧастиТовары.РазмерСкидкиНика)) / 100;
		Иначе
			СтрокаТабличнойЧастиТовары.ВесЧистый = ВесМ - СтруктураР.Вес;
		КонецЕсли;
		//--ИВВ

		СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
		ПересчитатьСуммТовары();
	КонецЕсли;	                        
	ОбновитьДанныеВставки(); 
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	//Было: ВставкиИтоги();
	ВставкиИтогиНаКлиенте();
	//-МАН
	ОбновитьДанныеТовары();
	ЭтаФорма.ТекущийЭлемент = Элементы["ВставкиВидВставки"];
КонецПроцедуры 

