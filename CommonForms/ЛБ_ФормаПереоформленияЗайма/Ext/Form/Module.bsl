&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	Если НЕ СтрокаТабличнойЧастиТовары.Новый Тогда
		Отказ = Истина;
		возврат;
	КонецЕсли;	
	
	Если СтрокаТабличнойЧастиТовары <> Неопределено Тогда
		//Удалим объект залога
		Если ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.ОбъектЗалога) Тогда
			УдалитьОбъектЗалога(СтрокаТабличнойЧастиТовары.ОбъектЗалога);
		КонецЕсли;	

		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		
		НайденныеСтроки = Вставки.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Вставки.Удалить(Строка);	
		КонецЦикла; 
		
		НайденныеСтроки = ДополнительныеМеталлы.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			ДополнительныеМеталлы.Удалить(Строка);	
		КонецЦикла; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьКлючСтрокиТоваров()	
	ТаблицаКлючей = Товары.Выгрузить(, "КлючСтроки");
	Если  ТаблицаКлючей.Количество() = 1 Тогда
		Возврат 1;
	Иначе	
		ТаблицаКлючей.Сортировать("КлючСтроки Убыв");
		
		Возврат ТаблицаКлючей[0].КлючСтроки + 1;
	КонецЕсли;	  			 
КонецФункции

&НаСервере
Функция ПроверитьВесДопМеталлов(Идентификатор)
	СтрТовары = Товары.НайтиПоИдентификатору(Идентификатор);
	
	ВесОснМеталла = СтрТовары.Вес;
	
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", СтрТовары.КлючСтроки);
	Строки = ДополнительныеМеталлы.НайтиСтроки(Отбор);
	Для каждого Стр из Строки Цикл
		ВесОснМеталла = ВесОснМеталла - Стр.ВесЧистый;
	Конеццикла;	 
	
	ВсеОК = Истина;
	Для каждого Стр из Строки Цикл 
		Если Стр.ВесЧистый > ВесОснМеталла Тогда
			ВсеОК = Ложь;
		КонецЕсли;	
	Конеццикла;	                
	
	Возврат ВсеОК;
КонецФункции

&НаСервере
Процедура РасчетМаксимальнойСуммыОценки(Идентификатор) 
	СтрокаТабличнойЧасти = Товары.НайтиПоИдентификатору(Идентификатор); 
	Если ПовышеннаяОценка Тогда		
		МассивС = Новый Массив; 
		МассивС.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка());
		МассивС.Добавить(СтатусЗалогодателя);
		Для каждого Эл Из СписокДопСтатусов Цикл  
			МассивС.Добавить(Эл.Значение);
		Конеццикла;	
		СтрокаТабличнойЧасти.СуммаОценкиМаксимальная = ЛБ_УправлениеЛомбардом.РасчитатьМаксимальнуюСуммуЗалога(ДатаДок, СхемаКредитования, МассивС, СтрокаТабличнойЧасти);  
	Иначе   
		СтрокаТабличнойЧасти.СуммаОценкиМаксимальная = СтрокаТабличнойЧасти.СуммаОценки;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ПересчитатьСуммТовары(СтрокаТабличнойЧастиТовары = неопределено)
	Если СтрокаТабличнойЧастиТовары = неопределено Тогда
	    СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;	
    
	ОтборДоп = Новый Структура;
	ОтборДоп.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
	СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);
	//ОснМеталлВесЧистый = СтрокаТабличнойЧастиТовары.ВесЧистый;
	//Для каждого СтрДоп Из СтрокиДоп Цикл
	//	ОснМеталлВесЧистый = ОснМеталлВесЧистый - СтрДоп.ВесЧистый;
	//Конеццикла;	   
	//СтрокаТабличнойЧастиТовары.ВесВПробеЧистоты = ПолучитьВесВЧистоте(ОснМеталлВесЧистый, СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()); 
	//СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = ОснМеталлВесЧистый*СтрокаТабличнойЧастиТовары.Цена;
	СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = СтрокаТабличнойЧастиТовары.ВесЧистый*СтрокаТабличнойЧастиТовары.Цена;
	Для каждого СтрДоп Из СтрокиДоп Цикл
		СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы + СтрДоп.СуммаОценкиМеталлы;
		//СтрокаТабличнойЧастиТовары.ВесВПробеЧистоты = СтрокаТабличнойЧастиТовары.ВесВПробеЧистоты + СтрДоп.ВесВПробеЧистоты;
	Конеццикла;	
	СтрокаТабличнойЧастиТовары.СуммаОценки = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы + СтрокаТабличнойЧастиТовары.СуммаОценкиКамни;
	
	РасчетМаксимальнойСуммыОценки(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
	СтрокаТабличнойЧастиТовары.СуммаСсуды = СтрокаТабличнойЧастиТовары.СуммаОценкиМаксимальная;                                            	
	СуммаЗайма = ОкруглитьСуммуСсуды(ТоварыИтогМаксОценка);
	РаспределитьСуммуЗайма();   
	ТоварыИтоги();
	ПолучитьДоступныеПроцентныеСхемыАкции();				
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СхемаКредитования = СтрокаСК.СхемаКредитования;
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;    
			ОбработатьСхемуКредитованияНаСервере();
			ПроверитьДоступностьДопКнопок();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
			ЗаполнитьТаблицуСтавок();
			ОбработатьДополнительныеКнопки();
			ЗаполнитьДатуВыкупа();
			ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
		КонецЕсли;	
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1);  
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;  
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		ПовышеннаяОценка = Ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  
	УстановитьВидимость();
	УстановитьТекстСуммаЗаймаДень();
	ОбработатьПСКНасервере(); 
	ЗаполнитьКВыдачеВнесению();
 КонецПроцедуры	

