		МестоРожденияПредставителя = Выборка.МестоРождения;
		EmailПредставителя = Выборка.Email;
		ТелефонПредставителя = Выборка.Телефон;		
		АдресПоПропискеПредставителя = Выборка.АдресПоПрописке;  
		ФактическийАдресПредставителя = Выборка.ФактическийАдрес;
		ФИОПредставителя = ФамилияПредставителя + " " + ИмяПредставителя + ?(ПустаяСтрока(ОтчествоПредставителя), "", " " + ОтчествоПредставителя);  
	Иначе
		ФамилияПредставителя = "";
        ИмяПредставителя = "";
        ОтчествоПредставителя = "";		
		ДатаРожденияПредставителя = Дата(1,1,1);		
		ГражданствоПредставителя = Справочники.СтраныМира.ПустаяСсылка();
		ПолПредставителя = перечисления.ПолФизическогоЛица.ПустаяСсылка();
		МестоРожденияПредставителя = "";
		EmailПредставителя = "";
		ТелефонПредставителя = "";		
		АдресПоПропискеПредставителя = ""; 
		ФактическийАдресПредставителя = "";
		ФИОПредставителя = "";  
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуДопСтатусовКлиента() 		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателей.Ссылка КАК Статус
	               |ИЗ
	               |	Справочник.ЛБ_СтатусыЗалогодателей КАК ЛБ_СтатусыЗалогодателей
	               |ГДЕ
	               |	ЛБ_СтатусыЗалогодателей.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ЭтоГруппа = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную = ИСТИНА
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаДопСтатусов.Загрузить(ТаблицаЗапроса); 
	Новаястр = ТаблицаДопСтатусов.Добавить();
	НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
КонецПроцедуры	

&НаСервере
Процедура ПолучитьДопСтатусыКлиента()  
	//очистим таблицу доп. статусов
	Для каждого Стр Из ТаблицаДопСтатусов Цикл 
		Стр.Используется = ложь;	
	КонецЦикла;	  
	
	Клиент = Залогодатель;
	ДатаРождения = ДатаРождения;
	Пол = Пол;	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Залогодатель", Клиент);  
	Запрос.УстановитьПараметр("Дата", ДатаДок); 
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1)); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И Статус = &Статус
	               |				И ВЫБОР
	               |					КОГДА СрокДействия = &ПустаяДата
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ВЫБОР
				   //+МАН 15.08.25 Исправил, чтобы срок действия учитывался как крнец дня
	               //|							КОГДА СрокДействия < &Дата
	               |							КОГДА КОНЕЦПЕРИОДА(СрокДействия, ДЕНЬ) < &Дата
	               |								ТОГДА ЛОЖЬ
	               |							ИНАЧЕ ИСТИНА
	               |						КОНЕЦ
	               |				КОНЕЦ) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних";
	Для каждого Стр Из ТаблицаДопСтатусов Цикл  
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется; 
			Если Выборка.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник Тогда  
				Если стр.Используется Тогда 
					ЭтоСотрудник = Истина;
				Иначе
					ЭтоСотрудник = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;   
	
	Если ЭтоСотрудник Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл
		Если СтрС.Используется Тогда
		    СписокДопСтатусов.Добавить(СтрС.Статус);
		КонецЕсли;	
	Конеццикла;	 
	
КонецПроцедуры

&НаСервере
Процедура СтатусыКлиентаВСтроку()
	СтатусыЗалогодателя = сокрЛП(СтатусЗалогодателя);
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл 
		Если СтрС.Используется Тогда 
		    СтатусыЗалогодателя = СтатусыЗалогодателя + ?(ПустаяСтрока(СтатусыЗалогодателя), "", "; " + СокрЛП(СтрС.Статус));
		конецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ОбработатьСхемуКредитованияНаСервере()	
	БезПродленияДоговора = СхемаКредитования.БезПродленияДоговора;
    ПризнакПримененияГибкогоПроцента = СхемаКредитования.ПризнакПримененияГибкогоПроцента;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УсловияПредоставленияКредитаСрезПоследних.СрокЗалога КАК СрокЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		СрокЗалога = Выборка.СрокЗалога;
		ЗаполнитьДатуВыкупа();
		ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
	КонецЕсли;	  
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.НачислятьПроцентыЗаДеньЗалога КАК НачислятьПроцентыЗаДеньЗалога,
	               |	УсловияПредоставленияКредита.НеНачислятьПроцентыЗаПоследнийДень КАК НеНачислятьПроцентыЗаПоследнийДень,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуПроценты КАК ОкруглятьПроценты,
	               |	УсловияПредоставленияКредита.ПорядокОкругленияПроценты КАК ПорядокОкругления,
	               |	УсловияПредоставленияКредита.ОкруглятьВБольшуюСторонуПроценты КАК ОкруглятьВБольшуюСторону,
	               |	УсловияПредоставленияКредита.ВидОкругленияСуммыПроцентов КАК ВидОкругленияСуммыПроцентов,
	               |	УсловияПредоставленияКредита.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа КАК СчитатьПроцентыДеньВыдачиРавенДеньВыкупа,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуОценка КАК ОкруглятьОценка
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
		НачислятьПроцентыЗаДеньЗалога = Выборка.НачислятьПроцентыЗаДеньЗалога;
		НеНачислятьПроцентыЗаПоследнийДень = Выборка.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Выборка.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
		ОкруглятьПроценты = Выборка.ОкруглятьПроценты;
		ПорядокОкругления = Выборка.ПорядокОкругления;
        ОкруглятьВБольшуюСторону = Выборка.ОкруглятьВБольшуюСторону;
        ВидОкругленияСуммыПроцентов = Выборка.ВидОкругленияСуммыПроцентов;
		ОкруглятьЦены = Выборка.ОкруглятьОценка;
    КонецЕсли;
	
	ПроцентУвеличенияОценкиЗалога = 0;

	МассивС = Новый Массив;
	МассивС.Добавить(СтатусЗалогодателя); 
	МассивС.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка()); 
	Для каждого Эл Из СписокДопСтатусов Цикл  
		МассивС.Добавить(Эл.Значение);
	Конеццикла;
	Запрос.УстановитьПараметр("СтатусыЗалогодателя", МассивС); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних";
	ВыборкаДок = Запрос.Выполнить().Выбрать();
	Если ВыборкаДок.Следующий() Тогда   
		Запрос.УстановитьПараметр("Регистратор", ВыборкаДок.Регистратор);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.УвеличениеСтоимостиЗалога КАК УвеличениеСтоимостиЗалога
		               |ИЗ
		               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних(, СтатусЗалогодателя В (&СтатусыЗалогодателя)) КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних
		               |ГДЕ
		               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.Регистратор = &Регистратор";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПроцентУвеличенияОценкиЗалога = Выборка.УвеличениеСтоимостиЗалога;  
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьДатуВыкупа() 
	ДатаВыкупа = НачалоДня(ДатаДок) + 86401*СрокЗалога;  
	ДатаВыкупа = ЛБ_УправлениеЛомбардом.ИсключитьДатаВыкупаПразничныйДень(ДатаВыкупа);
КонецПроцедуры  

&НаСервере
Функция ПолучитьЛьготнуюДатуВыкупа()
    Возврат ЛБ_УправлениеЛомбардом.ПолучитьЛьготныйСрокЗалоговогоБилета(ДатаВыкупа); 
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокЛьготныхСтатусов() 
	СписокЛьготныхСтатусов.Очистить();
	
	//Проверим нового клиента
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(ДокументЗайма), Новый Граница(Новый МоментВремени(ДокументЗайма.Дата, ДокументЗайма), ВидГраницы.Исключая), ДатаДок));
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОперацииПоСистемеЛояльностиОбороты.КоличествоЗалоговОборот КАК КоличествоЗалогов
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОперацииПоСистемеЛояльности.Обороты(, &Дата, , Залогодатель = &Залогодатель) КАК ЛБ_ОперацииПоСистемеЛояльностиОбороты";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда   
		Если НЕ Выборка.КоличествоЗалогов = 0 Тогда
			СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.НовыйКлиент);
		КонецЕсли;	
	Иначе	
		СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.НовыйКлиент);
	КонецЕсли;
	
	//проверим пенсионер по возрасту 
	ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
	Если ЗначениеЗаполнено(ВозрастЗалогодателя) И ЗначениеЗаполнено(Пол) Тогда
		Если Пол = Перечисления.ПолФизическогоЛица.Женский Тогда 
			Если  ВозрастЗалогодателя  >= 55 Тогда  
				СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Пенсионер);
			КонецЕсли;	
		ИначеЕсли  Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
			Если  ВозрастЗалогодателя  >= 60 Тогда  
				СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Пенсионер);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	//проверим льготные документы   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ДокументыЗалогодателя.ВидДокумента КАК ВидДокумента,
	              |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК СрокДействия
	              |ИЗ
	              |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
	              |		ПО ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка
	              |ГДЕ
	              |	ЛБ_ДокументыЗалогодателя.ПометкаУдаления = ЛОЖЬ
	              |	И ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент)
	              |	И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен = ЛОЖЬ
	              |	И ЛБ_ДокументыЗалогодателя.Владелец = &Залогодатель";
	Выборка = Запрос.Выполнить().Выбрать();   
	ДатаПроверки = ДатаДок;
	Пока Выборка.Следующий() цикл
		Если НЕ (Выборка.СрокДействия = Дата(1,1,1)) Тогда
			Если Выборка.СрокДействия < ДатаПроверки Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		Строки = ТаблицаСоответствия.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;     
		Стр = Строки.Получить(0);
		Если СписокЛьготныхСтатусов.НайтиПоЗначению(Стр.Статус) = неопределено  Тогда
			СписокЛьготныхСтатусов.Добавить(Стр.Статус);
		КонецЕсли;	
	КонецЦикла;	  
	Если ЭтоСотрудник Тогда
	    СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Сотрудник);
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ПолучитьДоступныеПроцентныеСхемыАкции() 
	СуммаЗаймаРасчет = СуммаЗаймаДень + СуммаЗайма; 
	Если ЭтоСотрудник тогда 
		РасчетСотрудникаДоп = Ложь;
		Если ЕстьЛьготыСотрудника Тогда
			Если (СуммаЗаймаПоЛьготамСотрудника >= СуммаЗайма) тогда
				ИзменитьСписокЛьготныхСтатусовСотрудника();
				ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
			Иначе        
				ИзменитьСписокЛьготныхСтатусовСотрудника(Ложь);
				Если ЗначениеЗаполнено(ДопСтатусСотрудник) Тогда
					РасчетСотрудникаДоп = Истина;
					ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, ДопСтатусСотрудник, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
				Иначе      
			        ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
				КонецЕсли;	 
			КонецЕсли;	
		Иначе 
			Если ЗначениеЗаполнено(ДопСтатусСотрудник) Тогда
				РасчетСотрудникаДоп = Истина;
				ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, ДопСтатусСотрудник, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
			Иначе      
		        ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
			КонецЕсли;	
		КонецЕсли;	
	Иначе		
	    ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
	КонецЕсли;	
	НомерСтроки = 0;                                                                                                                                                   
	ТаблицаВыбораСхемыКредитованияАкции.Очистить();
	Если НЕ ТаблицаЗапроса = неопределено Тогда
		Для каждого стрЗ Из ТаблицаЗапроса Цикл
		    НоваяСтрСК = ТаблицаВыбораСхемыКредитованияАкции.Добавить();
			НоваяСтрСК.НомерСтроки = НомерСтроки; 
			НоваяСтрСК.СхемаКредитования = стрЗ.СхемаКредитования;
			НоваяСтрСК.Акция = стрЗ.Акция;  			
			НоваяСтрСК.Приоритет = стрЗ.Приоритет; 
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;	  
		ТаблицаВыбораСхемыКредитованияАкции.Сортировать("Приоритет Убыв"); 
	конецЕсли;	
КонецПроцедуры   

&НаСервере
Функция ПроверитьСлужебныйСтатус(Статус, Вид)  
	Если Вид = 1 Тогда 
	    Возврат ЛБ_ОбщийМодуль.ПроверитьСлужебныйСтатус(Статус, Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов); 
	Иначе
		Возврат ЛБ_ОбщийМодуль.ПроверитьСлужебныйСтатус(Статус, Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление);
	КонецЕсли;	
КонецФункции


&НаСервере
Процедура УстановитьВидимость()
	Если ЗначениеЗаполнено(Представитель) Тогда 
		ГражданствоДоп = ГражданствоПредставителя;
	Иначе	
		ГражданствоДоп = Справочники.СтраныМира.Россия
	КонецЕсли;	
	Если Гражданство = Справочники.СтраныМира.Россия И ГражданствоДоп = Справочники.СтраныМира.Россия Тогда
	    Элементы.ГруппаДопДокумент.Видимость = Ложь; 	
	Иначе 
		Элементы.ГруппаДопДокумент.Видимость = Истина;
	КонецЕсли;
	Если СуммаЗаймаДень = 0 тогда
		Элементы.ДекорацияСуммаЗаймаДень.Видимость = Ложь;
	Иначе
		Элементы.ДекорацияСуммаЗаймаДень.Видимость = Истина;
		УстановитьТекстСуммаЗаймаДень();
	КонецЕсли;  
	Если НЕ ЭтоСотрудник тогда
		Элементы.ДекорацияСотрудник.Видимость = Ложь;
	Иначе
		Если НЕ НеРедактировать Тогда 
			Элементы.ДекорацияСотрудник.Видимость = Истина;
			УстановитьТекстСуммаЗаймаСотрудник();  
		Иначе
			Элементы.ДекорацияСотрудник.Видимость = Ложь;
		КонецЕсли;	
	КонецЕсли;       
	//+Мельников 25.04.24 Отмена операции
	Если ЗначениеЗаполнено(ДокументЗайма) Тогда

		ПроверкаПоследующихОпереаций = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ДокументЗайма.НомерЗалоговогоБилета, ТекущаяДата(),,Истина);
		ЛомбардПользователя = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);

		Если ДокументЗайма.Проведен И НЕ ТекущаяДата() - ДатаДок >= 3600 И ЛомбардПользователя = ДокументЗайма.Ломбард И
			?(ЗначениеЗаполнено(ДокументЗайма), ?(ПроверкаПоследующихОпереаций = Неопределено, Истина, ?(ПроверкаПоследующихОпереаций.Регистратор = ДокументЗайма, Истина, Ложь)), Ложь) И
			НЕ ЗначениеЗаполнено(ДокументОтмены) Тогда //+Мельников 31.07.24

			Элементы.ОтменитьОперацию.Доступность = Истина;
		Иначе
			Элементы.ОтменитьОперацию.Доступность = Ложь;
		КонецЕсли;

		//+МАН 17.06.25 Изменил
		//Если ЗначениеЗаполнено(ДокументЗайма.ДокументОтмены) Тогда
		Если ЗначениеЗаполнено(ДокументОтмены) Тогда
		//-МАН
			Элементы.ГруппаОтмена.Видимость = Истина;
			//+Мельников 28.05.24
			Элементы.Расчеты.Доступность = Ложь;
			Элементы.Редактировать.Доступность = Ложь;
			//-Мельников
		КонецЕсли;
	КонецЕсли;

	РаскраситьСтрокуТовары();
	//-Мельников
КонецПроцедуры

&НаСервере
Процедура РаскраситьСтрокуТовары()
        
    МассивИменКолонокДляПодсветки = Новый Массив;
	Для каждого Стр из Элементы.Товары.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Стр.Вид) = Тип("ВидГруппыФормы") Тогда
			Для каждого СтрЭлем Из Стр.ПодчиненныеЭлементы Цикл
	        	МассивИменКолонокДляПодсветки.Добавить(СтрЭлем.Имя);
			КонецЦикла;
		Иначе
        	МассивИменКолонокДляПодсветки.Добавить(Стр.Имя);
		КонецЕсли;
    КонецЦикла;
        
    ЭлементОформления = УсловноеОформление.Элементы.Добавить();
    ЭлементОформления.Использование = Истина;
    ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Васильковый);
    
    ЭлементУсловия                = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Товары.Переоформить");
    ЭлементУсловия.ПравоеЗначение = Ложь;
    ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;   
    ЭлементУсловия.Использование  = Истина;
    
    Для каждого ТекЭлемент из МассивИменКолонокДляПодсветки Цикл
        ОформляемоеПоле      = ЭлементОформления.Поля.Элементы.Добавить();
        ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ТекЭлемент);
    КонецЦикла;
        
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстСуммаЗаймаДень() 
	Элементы.ДекорацияСуммаЗаймаДень.Заголовок = "Клиенту уже выдан займ " + СокрЛП(Формат(СуммаЗаймаДень, "ЧЦ=15; ЧДЦ=2")) + 
	    " руб. Итого сумма займа для расчета процентов " + СокрЛП(Формат(СуммаЗаймаДень + СуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " руб.";
КонецПроцедуры	

&НаСервере
Процедура УстановитьТекстСуммаЗаймаСотрудник()   
	Если ЕстьЛьготыСотрудника Тогда
		Если НЕ СуммаЗаймаПоЛьготамСотрудника = 0 Тогда
			Элементы.ДекорацияСотрудник.Заголовок = "Для сотрудника расчет процентов по льготной ставке при сумме займа не более " + СокрЛП(Формат(СуммаЗаймаПоЛьготамСотрудника, "ЧЦ=15; ЧДЦ=2")) + 
			         " руб." + ?(ЗначениеЗаполнено(ДопСтатусСотрудник), " В противном случае расчет как для клиента со статусом """ + сокрЛП(ДопСтатусСотрудник) + """.", ""); 
		Иначе 
			Элементы.ДекорацияСотрудник.Заголовок = ?(ЗначениеЗаполнено(ДопСтатусСотрудник), "Для сотрудника расчет процентов как для клиента со статусом """ + сокрЛП(ДопСтатусСотрудник) + """.", "Льготы по процентным ставкам для сотрудников не установлены");
		КонецЕсли;
	Иначе
		Элементы.ДекорацияСотрудник.Заголовок = "Льготы по процентным ставкам для сотрудников не установлены";
	КонецЕсли;	
КонецПроцедуры	

