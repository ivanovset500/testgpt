	//-Мельников
     КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверкаНеОценивать(ВидВставки, КатегорияЗалога)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ВидКамня", ВидВставки); 
	Запрос.УстановитьПараметр("Категория", КатегорияЗалога);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ПараметрыОценкиВставокВОбъектахЗалога.Оценивается КАК Оценивается
	              |ИЗ
	              |	РегистрСведений.ЛБ_ПараметрыОценкиВставокВОбъектахЗалога КАК ЛБ_ПараметрыОценкиВставокВОбъектахЗалога
	              |ГДЕ
	              |	ЛБ_ПараметрыОценкиВставокВОбъектахЗалога.ВидКамня = &ВидКамня
	              |	И ЛБ_ПараметрыОценкиВставокВОбъектахЗалога.КатегорияОбъектаЗалога = &Категория"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат НЕ Выборка.Оценивается;
	КонецЕсли;	
	Возврат Ложь;
КонецФункции	

&НаСервере
Процедура ОбновитьДанныеВставки() 
	Для Каждого СтрТовары Из Товары Цикл 
		Отбор = новый Структура;
		Отбор.Вставить("КлючСтроки", СтрТовары.КлючСтроки);
		Строки = Вставки.НайтиСтроки(Отбор);
		Для Каждого Стр Из Строки Цикл  
			Если Стр.Вид = Перечисления.ЛБ_ВидыКомплектующихИзделия.Вставка Тогда
				Если ЗначениеЗаполнено(Стр.ВидВставки) И Стр.ВидВставки.НеОценивается Тогда
					Стр.ПроверкаНеОценивать = Истина;
				ИначеЕсли ЗначениеЗаполнено(Стр.ВидОгранки) И Стр.ВидОгранки.НеОценивается Тогда
					Стр.ПроверкаНеОценивать = Истина;
				Иначе 
				    Стр.ПроверкаНеОценивать = ПроверкаНеОценивать(Стр.ВидВставки, СтрТовары.Категория);
				КонецЕсли;	
			КонецЕсли;	
		Конеццикла;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ПроверкаОценкиВставки(Идентификатор, ИдентификаторТовары) 
	Стр = Вставки.НайтиПоИдентификатору(Идентификатор); 
	СтрТовары = Товары.НайтиПоИдентификатору(ИдентификаторТовары);

	Если ЗначениеЗаполнено(Стр.ВидВставки) И Стр.ВидВставки.НеОценивается Тогда
		Стр.НеОценивать = Истина;
		Стр.ПроверкаНеОценивать = Истина;
	ИначеЕсли ЗначениеЗаполнено(Стр.ВидОгранки) И Стр.ВидОгранки.НеОценивается Тогда
		Стр.НеОценивать = Истина;
		Стр.ПроверкаНеОценивать = Истина;
	Иначе 
	    Стр.НеОценивать = ПроверкаНеОценивать(Стр.ВидВставки, СтрТовары.Категория);
		Стр.ПроверкаНеОценивать = Стр.НеОценивать;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УдалитьСтрокуВставки(Идентификатор) 
	Стр = Вставки.НайтиПоИдентификатору(Идентификатор);
	Вставки.Удалить(Стр);
КонецПроцедуры	

&НаСервере
Функция ПроверитьВесовой(ЕдиницаИзмерения) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ЕдиницыРасчетаДрагоценныхКамней.ЭтоВес КАК ЭтоВес
	               |ИЗ
	               |	РегистрСведений.ЛБ_ЕдиницыРасчетаДрагоценныхКамней КАК ЛБ_ЕдиницыРасчетаДрагоценныхКамней
	               |ГДЕ
	               |	ЛБ_ЕдиницыРасчетаДрагоценныхКамней.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЭтоВес;
	КонецЕсли;
	Возврат ложь;
КонецФункции	

&НаКлиенте
Процедура ПослеВыбораВставки(Результат, ДопПараметры) Экспорт  
	Если Результат = неопределено Тогда
		Возврат; 
	ИначеЕсли Результат = ложь Тогда  
		УдалитьСтрокуВставки(Элементы.Вставки.ТекущиеДанные.ПолучитьИдентификатор());
		Возврат; 
	КонецЕсли;
	
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти       = Элементы.Вставки.ТекущиеДанные; 
	
	СтрокаТабличнойЧасти.ВесВручную = Результат.ВесВручную;
	СтрокаТабличнойЧасти.Количество = Результат.Количество; 
	СтрокаТабличнойЧасти.ВидВставки = Результат.ВидВставки;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения;
	СтрокаТабличнойЧасти.ФормаОгранки = Результат.ФормаОгранки;
	СтрокаТабличнойЧасти.ВидОгранки = Результат.ВидОгранки;
	СтрокаТабличнойЧасти.КачествоОгранки = Результат.КачествоОгранки; 
	СтрокаТабличнойЧасти.Диаметр = Результат.Диаметр;
	СтрокаТабличнойЧасти.Диаметр1 = Результат.Диаметр1;
	СтрокаТабличнойЧасти.Диаметр2 = Результат.Диаметр2; 
	СтрокаТабличнойЧасти.Длина = Результат.Длина;  
	СтрокаТабличнойЧасти.Ширина = Результат.Ширина;
	СтрокаТабличнойЧасти.Высота = Результат.Высота;
	СтрокаТабличнойЧасти.Вес = Результат.Вес;      
    СтрокаТабличнойЧасти.ВесШтКар = Результат.ВесШтКар; //+Мельников 24.07.24 Для расчета суммы если количество больше 1. Заяка 2738
    СтрокаТабличнойЧасти.ВесГраммыШт = Результат.ВесГраммыШт; //+Мельников 24.07.24 Для расчета суммы если количество больше 1. Заяка 2738
	СтрокаТабличнойЧасти.Сторона = Результат.Сторона; 
	СтрокаТабличнойЧасти.ВесГраммы = Результат.ВесГраммы;
	СтрокаТабличнойЧасти.ОписаниеРазмера = Результат.ОписаниеРазмера;  
	СтрокаТабличнойЧасти.ЭтоВесовой = ПроверитьВесовой(СтрокаТабличнойЧасти.ЕдиницаИзмерения);

	ПроверкаОценкиВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()); 

	Если СтрокаТабличнойЧасти.НеОценивать Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0; 
		//+МАН 25.03.25 Не указывать вес в каратах если это не бриллиант. Заявка 2464
		Если СтрокаТабличнойЧасти.ВидВставки <> ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") Тогда
			СтрокаТабличнойЧасти.Вес = 0;
			СтрокаТабличнойЧасти.ВесШтКар = 0;
		КонецЕсли;
		//-МАН
	Иначе	
		ЦенаДрагоценногоКамня(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
			
		Если СтрокаТабличнойЧасти.ЭтоВесовой Тогда
		    СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Вес, 2);
		Иначе
			СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество, 2);
		КонецЕсли;
	КонецЕсли;  
	
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда	
		ВесМ = СтрокаТабличнойЧастиТовары.Вес;
		Отбор = Новый структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(Отбор); 
		Для каждого Стр Из СтрокиДоп Цикл
		    ВесМ = ВесМ - Стр.ВесЧистый;
		Конеццикла;
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
		//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
		//++ИВВ 02.2026, вычеты для часов
		//было:
		//СтрокаТабличнойЧастиТовары.ВесЧистый = ?(СтрокаТабличнойЧастиТовары.Вес30, Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100, Цел((ВесМ - СтруктураР.Вес)*100)/100);
		//-Мельников
		Если СтрокаТабличнойЧастиТовары.Вес30 Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100;
		ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И Не СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = (ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100);
		ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = (((ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100))
				* (100 - СтрокаТабличнойЧастиТовары.РазмерСкидкиНика)) / 100;
		Иначе
			СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((ВесМ - СтруктураР.Вес)*100)/100;
		КонецЕсли;
		//--ИВВ
		СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
		ПересчитатьСуммТовары();
	КонецЕсли;	                        
	ОбновитьДанныеВставки(); 
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	//Было: ВставкиИтоги();
	ВставкиИтогиНаКлиенте();
	//-МАН
	ОбновитьДанныеТовары();
	ЭтаФорма.ТекущийЭлемент =  Элементы["ВставкиВидВставки"];
КонецПроцедуры 

