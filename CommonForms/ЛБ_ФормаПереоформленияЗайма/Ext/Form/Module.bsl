&НаСервере
Процедура ПроверитьДоступностьДопКнопок()
	Если ПроцентУвеличенияОценкиЗалога = 0 Тогда  
		Элементы.ПовышеннаяОценка.Доступность = Ложь;
		ПовышеннаяОценка = Ложь;
	Иначе
		Элементы.ПовышеннаяОценка.Доступность = Истина;
	КонецЕсли;
    Если НЕ ОкруглятьЦены Тогда  
		Элементы.Округление.Доступность = Ложь;
		Округление = Ложь;
	Иначе
		Элементы.Округление.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработатьПСКНасервере() 
	Если СуммаЗайма = 0 Тогда
		ПСКГод = 0;
		СуммаПроцентов = 0;
		СуммаПроцентовДень = 0;
	Иначе	
		ПроцентыРасчет = РассчитатьСуммуПроцентов();
		ПСКГодРасчет = РасчетПСКГод(СуммаЗайма, ПроцентыРасчет);          
		Если НЕ ПСК = 0 Тогда      
			Если ПСКГодРасчет > ПСК Тогда  
				ОбщегоНазначения.СообщитьПользователю("Сумма процентов в год превышает предельную ставку кредитования!");
			КонецЕсли;	
		КонецЕсли; 
		ПСКГод = ПСКГодРасчет;
	КонецЕсли;	
КонецПроцедуры	 

&НаКлиенте
Процедура ТоварыПереоформитьПриИзменении(Элемент)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТекСтрока.Переоформить Тогда  
		ТекСтрока.Статус = "Проект"; 
	Иначе                 
		ТекСтрока.Статус = "Выкуп";
	КонецЕсли;    
	ТекСтрока.СтатусДоп = ?(ТекСтрока.Новый, " Добавлен", "");
	СуммаЗайма = 0;
	Для каждого стр Из Товары Цикл 
		Если Стр.Переоформить Тогда
		    СуммаЗайма = СуммаЗайма + Стр.СуммаОценкиМаксимальная;
		Иначе
			Стр.СуммаСсуды = 0;
		КонецЕсли;	
	Конеццикла;	
	СуммаЗайма = ОкруглитьСуммуСсуды(СуммаЗайма);
	РаспределитьСуммуЗайма();   
	ТоварыИтоги(); 
	ПолучитьДоступныеПроцентныеСхемыАкции();				
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СхемаКредитования = СтрокаСК.СхемаКредитования; 
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;    
			ОбработатьСхемуКредитованияНаСервере();
			ПроверитьДоступностьДопКнопок();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
			ЗаполнитьТаблицуСтавок();
			ОбработатьДополнительныеКнопки();
			ЗаполнитьДатуВыкупа();
			ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
		КонецЕсли;	
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1);  
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;  
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		ПовышеннаяОценка = Ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  
	УстановитьВидимость();
	УстановитьТекстСуммаЗаймаДень();
	ОбработатьПСКНасервере();
	ЗаполнитьКВыдачеВнесению();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЗБПереоформлениеНажатие(Элемент)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Клиент", ПолучитьНачальногоЗаемщика());
	ПараметрыФормы.Вставить("ЗалоговыйБилет", ПредыдущаяОперация);	 
							
	ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКатегории(Результат, Параметр) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ТекСтрока = Элементы.Товары.ТекущиеДанные; 
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);   
		СтрокиВ = Вставки.НайтиСтроки(Отбор);
		Для сч = 0 По СтрокиВ.Количество()-1 Цикл 
			СтрВ = СтрокиВ.Получить(сч);
			Вставки.Удалить(СтрВ);
		КонецЦикла;	
        ТекСтрока.Категория = Параметр;
	КонецЕсли;   
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыКатегорияОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);   
	СтрокиВ = Вставки.НайтиСтроки(Отбор);
	Если НЕ (СтрокиВ.Количество() = 0) И НЕ (ВыбранноеЗначение = ТекСтрока.Категория) Тогда	    	
	    СтандартнаяОбработка = Ложь;  
	    Оповещение = Новый ОписаниеОповещения("ПослеВыбораКатегории", ЭтотОбъект, ВыбранноеЗначение);
	    ПоказатьВопрос(Оповещение, "После изменения категории вставки изделия будут очищены. Продолжть?", РежимДиалогаВопрос.ДаНет);  
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;	
КонецПроцедуры

//+Мельников 25.04.24 Отмена операции
&НаКлиенте
Процедура ОтменитьОперацию(Команда)
	
	ПоследняяОперация = ПолучитьИнформациюОЗБ(ДокументЗайма, ТекущаяДата());
	ЛомбардПользователя = ПолучитьЛомбардПольвателя();
	ЛомбардВДокументе = ПолучитьЛомбардВдокументе(ПоследняяОперация.ДокументОперации);

	Если ЛомбардПользователя <> ЛомбардВДокументе Тогда
		Предупреждение("Операция оформлена в другом ломбарде.
		|Действия с документом запрещены!");
		Возврат
	ИначеЕсли Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") <> Формат(ПоследняяОперация.Дата, "ДФ=dd.MM.yyyy") Тогда
		Предупреждение("Отмена операции возможна только в текущем дне.");
		Возврат
	ИначеЕсли ТекущаяДата() - ДатаДок >= 3600 Тогда
		Предупреждение("Прошло больше часа от времени оформления текущей операции.");
		Возврат 
	ИначеЕсли ПроверитьКассовуюСмену() = неопределено Тогда 
		Предупреждение("Не открыта кассовая смена в ломбарде.");
	    Возврат;	
	Иначе
		
		Ответ = Вопрос("Выполнить отмену текущей операции?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ДокументЗайма); 

			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтаФорма); //+Мельников 31.07.24	
			
			Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда  
				ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма.ВладелецФормы, Истина,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			Иначе	
			    ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма, Истина,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			КонецЕсли;
			
			УстановитьВидимость();
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОЗБ(ЗалоговыйБилет, Дата)
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, Дата,, Истина);
	
	//+Мельников 06.05.24 Сделано на время тестирования. Убрать при запуске ломбардов.
	Если Результат = Неопределено Тогда
		ДатаПроверки = ТекущаяДата() + 94608000; // + три года к дате проверки документа
		Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, ДатаПроверки,, Истина);
	КонецЕсли;
	//-Мельников

	ПоследняяОперация = Новый Структура;
	ПоследняяОперация.Вставить("Дата", Результат.Регистратор.Дата);
	ПоследняяОперация.Вставить("ВидОперации", Результат.Регистратор.ВидОперации);
	ПоследняяОперация.Вставить("ДокументОперации", Результат.Регистратор);
	
	Возврат ПоследняяОперация;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛомбардПольвателя()
	Возврат ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛомбардВдокументе(Ссылка)
	Возврат Ссылка.Ломбард;
КонецФункции

