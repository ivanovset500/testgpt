&НаКлиенте
Процедура СуммаЗаймаПриИзменении(Элемент)    
	Если СуммаЗайма < МинСуммаЗайма Тогда  
		Предупреждение("Внимание! Минимальная сумма займа " + СокрЛП(Формат(МинСуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " руб.!", 60);
		Возврат;
	КонецЕсли;	
	
	СуммаМаксРасчет = 0;  
	СуммаОценкиРасчет = 0;
	Для каждого СтрокаТабличнойЧасти из Товары Цикл 
		Если СтрокаТабличнойЧасти.Переоформить Тогда
		    РасчетМаксимальнойСуммыОценки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		    СуммаМаксРасчет = СуммаМаксРасчет + СтрокаТабличнойЧасти.СуммаОценкиМаксимальная; 
			СуммаОценкиРасчет = СуммаОценкиРасчет + СтрокаТабличнойЧасти.СуммаОценки;
		КонецЕсли;	
	Конеццикла;	     
	МаксОценка = ОкруглитьСуммуСсуды(СуммаМаксРасчет);
	Если СуммаЗайма > МаксОценка Тогда
		СуммаЗайма = МаксОценка;  
 	ИначеЕсли СуммаЗайма <= СуммаОценкиРасчет Тогда //И НЕ (ПроцентУвеличенияОценкиЗалога = 0) Тогда   
		Округление = Ложь;
		ПовышеннаяОценка = ложь;                                            	
	КонецЕсли;       
	РаспределитьСуммуЗайма();
	ПолучитьДоступныеПроцентныеСхемыАкции();
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
