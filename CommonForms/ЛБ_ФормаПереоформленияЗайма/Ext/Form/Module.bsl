&НаКлиенте
Процедура ОткрытьВыборДефектов()
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;   
	ОтборД = Новый Структура;
	ОтборД.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	СтрокиД = Дефекты.НайтиСтроки(ОтборД);
	Если НЕ СтрокиД.Количество() = 0 Тогда
		СписокДефектов = новый списокЗначений;
		ДругиеДефекты = "";
		Для каждого СтрД из СтрокиД Цикл 
			Если ТипЗнч(СтрД.Дефект) = Тип("СправочникСсылка.ЛБ_Дефекты") Тогда 
				СписокДефектов.Добавить(СтрД.Дефект);
			ИначеЕсли ТипЗнч(СтрД.Дефект) = Тип("Строка") Тогда
				ПараметрыФормы.Вставить("ДругиеДефекты", СтрД.Дефект);
	        КонецЕсли;
		Конеццикла;	 
		Если НЕ СписокДефектов.Количество() = 0 Тогда
		    ПараметрыФормы.Вставить("Дефекты", СписокДефектов);
		КонецЕсли;	 
	КонецЕсли;	
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДефектов",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборДефектов", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыДефектыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьВыборДефектов();
КонецПроцедуры
  
 &НаКлиенте 
Процедура ПослеВыбораДефектов(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные; 
	ТекСтрока.Дефекты = "";
	ОтборД = Новый Структура;
	ОтборД.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	СтрокиД = Дефекты.НайтиСтроки(ОтборД);
	
	Для каждого стрД из СтрокиД Цикл 
		Дефекты.Удалить(СтрД);
	Конеццикла;	                   
	
	Для каждого Эл Из Результат.списокДефектов цикл 
		Если Эл.Пометка тогда 
			НоваяСтрД = Дефекты.Добавить();
			НоваяСтрД.Ключстроки = ТекСтрока.КлючСтроки; 
			НоваяСтрД.Дефект = Эл.Значение;
			
			ТекСтрока.Дефекты = ТекСтрока.Дефекты + ?(Пустаястрока(ТекСтрока.Дефекты), "", "; ") + сокрЛП(НоваяСтрД.Дефект);
		КонецЕсли;	
	Конеццикла;	 
	Если НЕ Пустаястрока(Результат.ДругиеДефекты) тогда 
		НоваяСтрД = Дефекты.Добавить();
		НоваяСтрД.Ключстроки = ТекСтрока.КлючСтроки; 
		НоваяСтрД.Дефект = Результат.ДругиеДефекты;
		
		ТекСтрока.Дефекты = ТекСтрока.Дефекты + ?(Пустаястрока(ТекСтрока.Дефекты), "", "; ") + сокрЛП(НоваяСтрД.Дефект);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьВесИСуммуВставокИзделия(КлючСтроки)
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", КлючСтроки);
	СтрокиВставки = Вставки.НайтиСтроки(Отбор);
	ВесВставок = 0;
	СуммаВставок = 0;
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	КоличествоВставок = 0;
	ВесКаратВставок = 0;
	ВесДопМеталлов = 0;
	СуммаДопМеталлов = 0;
	//-МАН
	
	Для каждого Стр Из СтрокиВставки Цикл
		Если Стр.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
	        ВесВставок = ВесВставок + Стр.ВесГраммы;
		    СуммаВставок = СуммаВставок + Стр.Сумма;
			//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
			КоличествоВставок = КоличествоВставок + Стр.Количество;
			ВесКаратВставок = ВесКаратВставок + Стр.Вес;
			//-МАН
		Иначе
			ВесВставок = ВесВставок + Стр.ВесГраммы;
			//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
			КоличествоВставок = КоличествоВставок + Стр.Количество;
			//-МАН
		КонецЕсли;	
	КонецЦикла;	

	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	СтрокиДопМеталлы = ДополнительныеМеталлы.НайтиСтроки(Отбор);

	Для каждого Стр Из СтрокиДопМеталлы Цикл
		ВесДопМеталлов = ВесДопМеталлов + Стр.ВесЧистый;
		СуммаДопМеталлов = СуммаДопМеталлов + Стр.СуммаОценкиМеталлы;
	КонецЦикла;	
	//-МАН
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Вес", ВесВставок);
	СтруктураРезультат.Вставить("Сумма", СуммаВставок);
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	СтруктураРезультат.Вставить("Количество", КоличествоВставок);
	СтруктураРезультат.Вставить("ВесКарат", ВесКаратВставок);
	СтруктураРезультат.Вставить("ВесДопМеталлов", ВесДопМеталлов);
	СтруктураРезультат.Вставить("СуммаДопМеталлов", СуммаДопМеталлов);
	//-МАН	
	
	Возврат СтруктураРезультат;
КонецФункции

&НаСервере
Функция ПолучитьВесВЧистоте(ВесЧистый, Идентификатор, ИмяТаблицы = "Товары")  
	Если ИмяТаблицы = "Товары" Тогда
	    СтрокаТабличнойЧасти = Товары.НайтиПоИдентификатору(Идентификатор);
	Иначе 
		СтрокаТабличнойЧасти = ДополнительныеМеталлы.НайтиПоИдентификатору(Идентификатор);
	КонецЕсли;
	
	Возврат ЛБ_ОбщийМодуль.ПеревестиВЧистоту(ВесЧистый, СтрокаТабличнойЧасти.Проба);
Конецфункции	

&НаКлиенте
Процедура ТоварыВесПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	
	ВесМ = СтрокаТабличнойЧасти.Вес;    	
	СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧасти.КлючСтроки);
	ВесМ = Цел((ВесМ - СтруктураР.Вес)*100)/100;
	
	ОтборДоп = Новый Структура;
	ОтборДоп.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки); 
	
	ВесДоп = 0;
	СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);    
	Для каждого СтрДоп Из СтрокиДоп Цикл
		ВесДоп = ВесДоп + СтрДоп.ВесЧистый;
	Конеццикла;   
	//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
	//Было: ВесМ = ВесМ - ВесДоп;
	
	//++ИВВ 02.2026, вычеты для часов
	//было:
	//ВесМ = ?(СтрокаТабличнойЧасти.Вес30, Цел(((ВесМ - ВесДоп) * 0.7)*100)/100, ВесМ - ВесДоп);
	//-Мельников
	//стало:
	Если СтрокаТабличнойЧасти.Вес30 Тогда
		ВесМ = Цел(((ВесМ - ВесДоп) * 0.7)*100)/100;
	ИначеЕсли СтрокаТабличнойЧасти.СкидкаМеханизм И Не СтрокаТабличнойЧасти.СкидкаНика Тогда
		ВесМ = (ВесМ - ВесДоп) * (СтрокаТабличнойЧасти.РазмерСкидкиМеханизм / 100);
	ИначеЕсли СтрокаТабличнойЧасти.СкидкаМеханизм И СтрокаТабличнойЧасти.СкидкаНика Тогда
		ВесМ = (((ВесМ - ВесДоп) * (СтрокаТабличнойЧасти.РазмерСкидкиМеханизм / 100))*(100-СтрокаТабличнойЧасти.РазмерСкидкиНика)) / 100;
	Иначе
		ВесМ = ВесМ - ВесДоп;
	КонецЕсли;
	//--ИВВ

	СтрокаТабличнойЧасти.ВесЧистый = ВесМ;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеМеталлыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	Отказ = (СтрокаТабличнойЧастиТовары = Неопределено) ИЛИ Копирование; 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.Проба) Тогда  
		Сообщить("Не выбран основной металл в изделии!"); 
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	СписокПроб = ПолучитьСписокДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()); 
	Если СписокПроб.Количество() = 0 Тогда  
		Сообщить("Не определены дополнительные металлы для металла " + сокрЛП(СтрокаТабличнойЧастиТовары.Проба) + "!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;	 
	Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Очистить();
	Для каждого Эл Из СписокПроб цикл
	    Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Добавить(Эл.Значение);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеМеталлыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока и НЕ Копирование Тогда
		СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	    СтрокаТабличнойЧасти       = Элементы.ДополнительныеМеталлы.ТекущиеДанные;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмеренияМеталлы;
        СтрокаТабличнойЧасти.Категория = СтрокаТабличнойЧастиТовары.Категория;			
	    СтрокаТабличнойЧасти.КлючСтроки = СтрокаТабличнойЧастиТовары.КлючСтроки;  		
	Иначе
		Если Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Количество() = 0 тогда
			СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
			СписокПроб = ПолучитьСписокДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
			Для каждого Эл Из СписокПроб цикл
			    Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Добавить(Эл.Значение);
			КонецЦикла;	
		КонецЕсли;	
   	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеМеталлыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;  
	СтрокаТабличнойЧасти = Элементы.ДополнительныеМеталлы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда

		Если НЕ ПроверитьВесДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()) Тогда
			Сообщить("В раздел ""Дополнительные металлы"" заносится информация о металле, масса которого, в общей массе изделия, является наименьшей.");
			Отказ = Истина;
		КонецЕсли;	       
		
		Если Отказ тогда
			Возврат;
		конецЕсли;	
		
		ВесМ = СтрокаТабличнойЧастиТовары.Вес;
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
		ВесМ = Цел((ВесМ - СтруктураР.Вес)*100)/100;
		
		Отбор = новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(Отбор);
		Для каждого Стр Из СтрокиДоп Цикл  
			ВесМ = ВесМ - Стр.ВесЧистый;		   
		Конеццикла;
		//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
		//Было: СтрокаТабличнойЧастиТовары.ВесЧистый = ВесМ;
		
		//++ИВВ 02.2026, вычеты для часов
		//было:
		//СтрокаТабличнойЧастиТовары.ВесЧистый = ?(СтрокаТабличнойЧастиТовары.Вес30, Цел((ВесМ * 0.7)*100)/100, ВесМ);
