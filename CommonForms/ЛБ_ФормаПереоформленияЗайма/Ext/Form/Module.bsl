&НаСервере
Процедура ЦенаДрагоценногоМеталла(Идентификатор, ИмяТабличнойЧасти = "Товары") 
	Если  ИмяТабличнойЧасти = "Товары" Тогда
	    СтрокаТабличнойЧасти 			  = Товары.НайтиПоИдентификатору(Идентификатор);
	Иначе   
		СтрокаТабличнойЧасти 			  = ДополнительныеМеталлы.НайтиПоИдентификатору(Идентификатор);
	КонецЕсли;	

	//+Мельников 29.07.24 Для Серебра как доп. металла не должны высчитываться цена и сумма. Добавлено условие. Заявка 2739.
	Если ИмяТабличнойЧасти = "ДополнительныеМеталлы" И СтрокаТабличнойЧасти.Проба.Владелец = Справочники.ЛБ_ДрагоценныеМеталлы.Серебро Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.СуммаОценкиМеталлы = 0;
	Иначе
	//-Мельников
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Дата", ДатаДок);
		СтруктураПараметров.Вставить("Ломбард", Ломбард);
		СтруктураПараметров.Вставить("СхемаКредитования", СхемаКредитования);
		СтруктураПараметров.Вставить("Проба", СтрокаТабличнойЧасти.Проба);
		СтруктураПараметров.Вставить("Категория", СтрокаТабличнойЧасти.Категория);
		СтруктураПараметров.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧасти.ЕдиницаИзмерения);
		//+Мельников 24.09.24 ВИП. Заявка 2792
		СтруктураПараметров.Вставить("Залогодатель", Залогодатель);
		//-Мельников
		
		Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуМеталлаИзПрейскуранта(СтруктураПараметров);
		СтрокаТабличнойЧасти.Цена = Результат.Цена;  
		СтрокаТабличнойЧасти.Приказ = Результат.Приказ;
		//+МАН 10.12.25
		СтрокаТабличнойЧасти.ПриказВИПМеталлы = Результат.ПриказВИПМеталлы;
		//-МАН
   		СтрокаТабличнойЧасти.СуммаОценкиМеталлы = СтрокаТабличнойЧасти.ВесЧистый*СтрокаТабличнойЧасти.Цена; 
	КонецЕсли;

КонецПроцедуры

