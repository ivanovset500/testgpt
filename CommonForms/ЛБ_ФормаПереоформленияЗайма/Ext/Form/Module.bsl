&НаКлиенте
Процедура СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары)
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		Если СтрокаТабличнойЧастиТовары.ЕстьВставки Тогда
			Элементы.ГруппаВставок.Показать();
			Элементы.ГруппаВставок.Доступность = Истина;
		Иначе
			Элементы.ГруппаВставок.Скрыть();
			Элементы.ГруппаВставок.Доступность = ложь;
		КонецЕсли;	
		
		Если СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы Тогда
			Элементы.ГруппаДопМеталлы.Показать(); 
			Элементы.ГруппаДопМеталлы.Доступность = Истина;
			Элементы.ТоварыГруппаЭтикетка.Видимость = Истина;
			Элементы.ТоварыГруппаЭ.Доступность = ?(НеРедактировать, Элементы.ТоварыГруппаЭ.Доступность, Истина);
		Иначе
			Элементы.ГруппаДопМеталлы.Скрыть();
			Элементы.ГруппаДопМеталлы.Доступность = ложь;
			Если СтрокаТабличнойЧастиТовары.ЕстьЭтикетка тогда
				СтрокаТабличнойЧастиТовары.ЕстьЭтикетка = ложь;
			КонецЕсли;	   
			Если ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.Этикетка) тогда 
				УдалитьСканЭтикетки(СтрокаТабличнойЧастиТовары.Этикетка);
				СтрокаТабличнойЧастиТовары.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка"); 
			КонецЕсли;	
			Элементы.ТоварыГруппаЭтикетка.Видимость = ложь;  
			Элементы.ТоварыГруппаЭ.Доступность = ложь;
		КонецЕсли;	
	Иначе
		Элементы.ГруппаВставок.Скрыть();
		Элементы.ГруппаДопМеталлы.Скрыть(); 
		Элементы.ТоварыГруппаЭ.Доступность = ложь;
	КонецЕсли;	
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
		
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
		
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
		СтрокиДопМеталлы = ДополнительныеМеталлы.НайтиСтроки(Отбор);
		
		ВставкиИтогиНаКлиенте();
		Если СтрокиДопМеталлы <> 0 Тогда
			ДопМеталлыИтогиНаКлиенте();
		КонецЕсли;
		//-МАН
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли; 
	
КонецПроцедуры


