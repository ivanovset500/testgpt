&НаСервере
Функция ПолучитьДокументЗалогодателя(Клиент) 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Залогодатель
	               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДокументЗалогодателя;
	КонецЕсли; 
	Возврат ДокументЗалогодателя;
КонецФункции

&НаКлиенте
Процедура ПослеИзмененияКарточки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	Если ЭтаФорма.НеРедактировать тогда
		Возврат;
	КонецЕсли;	
	
	//Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ТекущаяДата()) Тогда  
	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если НачалоДня(ДатаДок) = НачалоДня(ДатаСеанса) Тогда
		ДатаДок = ДатаСеанса;
	КонецЕсли;	
    ЗаполнитьКонтакнуюИнформациюЗалогодателя();
    КонтактнаяИнформацияВСтроку();       
	
	НовыйДокументЗалогодателя = ПолучитьДокументЗалогодателя(Залогодатель);
	Если НЕ ДокументЗалогодателя = НовыйДокументЗалогодателя Тогда
		ДокументЗалогодателя = НовыйДокументЗалогодателя;
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();  	
	КонецЕсли;	
	ЗаполнитьДопДокументы();
КонецПроцедуры       

&НаКлиенте
Процедура ПослеИзмененияКарточкиПредставителя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	Если ЭтаФорма.НеРедактировать тогда
		Возврат;
	КонецЕсли;	
	 
	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если НачалоДня(ДатаДок) = НачалоДня(ДатаСеанса) Тогда
		ДатаДок = ДатаСеанса;
	КонецЕсли;	
    ЗаполнитьКонтакнуюИнформациюПредставителя();
    КонтактнаяИнформацияПредставителяВСтроку();       
	
	НовыйДокументПредставителя = ПолучитьДокументЗалогодателя(Представитель);
	Если НЕ ДокументПредставителя = НовыйДокументПредставителя Тогда
		ДокументПредставителя = НовыйДокументПредставителя;
		ЗаполнитьИнформациюОДокументеПредставителя();
		ИнформацияОДокументеПредставителяВСтроку();  	
	КонецЕсли;	
	ЗаполнитьДопДокументыПредставителя();
КонецПроцедуры 


