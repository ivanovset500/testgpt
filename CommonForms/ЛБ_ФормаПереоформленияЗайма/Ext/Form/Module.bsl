			СтрокаТабличнойЧастиТовары.ВесЧистый = ((ВесМ*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм / 100))
				*(100-СтрокаТабличнойЧастиТовары.РазмерСкидкиНика)) / 100;	
		Иначе
			СтрокаТабличнойЧастиТовары.ВесЧистый = ВесМ;
		КонецЕсли;
		//--ИВВ
				 
		//+МАН 22.10.24 Исправление подвала вставок. Старое расчитывало по всем вставкам, без учета ОЗ. Заявка 2735
		//Было: ДополнительныеМеталлыИтоги();
