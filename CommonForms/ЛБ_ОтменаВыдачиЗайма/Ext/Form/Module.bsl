&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
        ДокументЗайма = Параметры.Документ;  
		ЗалоговыйБилет = ДокументЗайма.ПредыдущаяОперация;
		Если ДокументЗайма.Проведен тогда
			НеРедактировать = Истина;
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		Иначе
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		КонецЕсли;	   
		ДатаДок = ДокументЗайма.Дата; 
		Ломбард = ДокументЗайма.Ломбард;  
		ОтветственныйПользователь = ДокументЗайма.ОтветственныйПользователь;
		ОтветственныйСотрудник = ДокументЗайма.ОтветственныйСотрудник;
		Комментарий = ДокументЗайма.Комментарий;
		Залогодатель = ДокументЗайма.Залогодатель; 
		ДокументЗалогодателя = ДокументЗайма.ДокументЗалогодателя;
		СхемаКредитования = ДокументЗайма.СхемаКредитования; 
		СрокЗалога = ДокументЗайма.СрокЗалога;
		ОтказОтВыкупа = ДокументЗайма.ОтказОтВыкупа;  
		ПакетДоговоров = ДокументЗайма.ПакетДоговоров; 
		ДопДокументы.Загрузить(ДокументЗайма.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
		ЗаполнитьКонтакнуюИнформациюЗалогодателя();
	    ЗаполнитьИнформациюОДокументеЗалогодателя();
		СтатусЗалогодателя = ДокументЗайма.СтатусЗалогодателя; 		
		ЗаполнитьСостояниеЗалоговогоБилета();
		ЗаполнитьТовары(); 
		НомераЗБ = ПолучитьНомераЗБ(); 
		//+Мельников 25.04.24 Отмена операции
		ОтмененныйДокумент = ДокументЗайма.ОтмененныйДокумент;
		Элементы.ВидОтменненойОперации.Заголовок = "Отмененная операция: " + """" + ДокументЗайма.ОтмененныйДокумент.ВидОперации + """";
		//-Мельников      
		Если Параметры.ТолькоПросмотр = Истина Тогда	
			Этаформа.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе		
		ДатаДок = ТекущаяДата();   
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		//Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		//  	ОтветственныйПользователь = ТекПользователь;
		//Иначе
		//	ОтветственныйПользователь = ПараметрыСеанса.ТекущийСотрудник;
		//КонецЕсли; 
		ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
		ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;
		Если Параметры.Свойство("ЗалоговыйБилет") Тогда  
			ЗалоговыйБилет = Параметры.ЗалоговыйБилет;
			Ломбард = ЗалоговыйБилет.Ломбард;   
			Залогодатель = ЗалоговыйБилет.Залогодатель; 
			ДокументЗалогодателя = ЗалоговыйБилет.ДокументЗалогодателя;
			СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;
			СрокЗалога = ЗалоговыйБилет.СрокЗалога;
			ОтказОтВыкупа = ЗалоговыйБилет.ОтказОтВыкупа;  
			ПакетДоговоров = ЗалоговыйБилет.ПакетДоговоров;
			ДопДокументы.Загрузить(ЗалоговыйБилет.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
		    ЗаполнитьКонтакнуюИнформациюЗалогодателя();
		   	ЗаполнитьИнформациюОДокументеЗалогодателя();
			СтатусЗалогодателя = ЗалоговыйБилет.СтатусЗалогодателя; 
			ЗаполнитьСостояниеЗалоговогоБилета();
		    ЗаполнитьТовары(); 
			НомераЗБ = ПолучитьНомераЗБ(); 
		КонецЕсли;  
	КонецЕсли;  
	ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
	                              
	ТоварыИтоги();
	Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаЗаемщик;
	//+Мельников 28.05.24
	УстановитьВидимость()
	//-Мельников
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументОтменыЗайма(ЗБ)
	ЗапросОтмена = Новый Запрос;  
	ЗапросОтмена.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров);
	ЗапросОтмена.УстановитьПараметр("ЗалоговыйБилет", ЗБ);
	ЗапросОтмена.УстановитьПараметр("Период", ТекущаяДата());
	ЗапросОтмена.Текст =
	//+МАН 17.06.25 Старый запрос.
						//"ВЫБРАТЬ
						//|	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
						//|ИЗ
						//|	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
						//|ГДЕ
						//|	ЛБ_ОперацияПоЗалогу.ПакетДоговоров = &ПакетДоговоров
						//|	И ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога)
						//|	И ЛБ_ОперацияПоЗалогу.ПредыдущаяОперация = &ЗалоговыйБилет
						//|АВТОУПОРЯДОЧИВАНИЕ";

						"ВЫБРАТЬ
						|	ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор КАК Ссылка
						|ИЗ
						|	РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
						|ГДЕ
						|	ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент В(&ЗалоговыйБилет)";
	//-МАН
	ВыборкаОтмена = ЗапросОтмена.Выполнить().Выбрать(); 
	Если ВыборкаОтмена.Следующий() Тогда
		Возврат ВыборкаОтмена.Ссылка;
	КонецЕсли;
	Возврат ПредопределенноеЗначение("Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка");
КонецФункции

&НаСервере
Процедура ЗаполнитьТовары() 

	//+Мельников 25.04.24 Отмена операции. Добавлена отмена только некоторых ЗБ.
	//Если ЗначениеЗаполнено(ПакетДоговоров) Тогда  
	//	Запрос = Новый Запрос;  
	//	Запрос.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров); 
	//	Запрос.Текст ="ВЫБРАТЬ
	//	              |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	//	              |ИЗ
	//	              |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	//	              |ГДЕ
