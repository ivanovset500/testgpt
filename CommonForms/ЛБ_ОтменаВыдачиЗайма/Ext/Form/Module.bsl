	//	              |АВТОУПОРЯДОЧИВАНИЕ";
	//	Выборка = Запрос.Выполнить().Выбрать(); 
	//	Ном = 0;
	//	Пока Выборка.Следующий() Цикл
	//		НоваяСтрП = ПакетДокументов.Добавить();			 
	//		НоваяСтрП.ЗалоговыйБилет = Выборка.Ссылка; 
	//		НоваяСтрП.ДокументЗайма = ПолучитьДокументОтменыЗайма(Выборка.Ссылка);
	//		НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Получить(Ном); 
	//		 
	//		Ном = Ном + 1;
	//	КонецЦикла;	  		

	Если ЗначениеЗаполнено(ПакетДоговоров) И ?(Параметры.Свойство("МассивЗБ"), Параметры.МассивЗБ.Количество() > 0, Параметры.Свойство("МассивЗБ")) Тогда
		
		СписокЗБ = Новый СписокЗначений;

		Для каждого СтрЗБ Из Параметры.МассивЗБ Цикл
			СписокЗБ.Добавить(СтрЗБ);
        КонецЦикла;
		
		Запрос = Новый Запрос;  
		Запрос.Текст =
		//+МАН 17.06.25 Старый запрос.
					//"ВЫБРАТЬ
					//|	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
					//|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
					//|	ЛБ_СостояниеЗалоговогоБилета.Регистратор.ПакетДоговоров КАК РегистраторПакетДоговоров
					//|ИЗ
					//|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
					//|ГДЕ
					//|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета В (&СписокЗБ)
					//|	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
					//|	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ДокументОтмены = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
					//|	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ПакетДоговоров = &ПакетДоговоров";
					"ВЫБРАТЬ
					|	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
					|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
					|	ЛБ_СостояниеЗалоговогоБилета.Регистратор.ПакетДоговоров КАК РегистраторПакетДоговоров
					|ИЗ
					|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
					|ГДЕ
					|	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета В(&СписокЗБ)
					|	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
					|	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ПакетДоговоров = &ПакетДоговоров
					|	И НЕ ЛБ_СостояниеЗалоговогоБилета.Регистратор В
					|				(ВЫБРАТЬ
					|					ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
					|				ИЗ
					|					РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
					|				ГДЕ
					|					ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент = ЛБ_СостояниеЗалоговогоБилета.Регистратор)
					|	И НЕ ЛБ_СостояниеЗалоговогоБилета.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога)";
		//-МАН

		Запрос.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров);
		Запрос.УстановитьПараметр("Период", ТекущаяДата());
		Запрос.УстановитьПараметр("СписокЗБ", СписокЗБ);

		Выборка = Запрос.Выполнить().Выбрать();
	
		Ном = 0;

		Пока Выборка.Следующий() Цикл
			
			НоваяСтрП = ПакетДокументов.Добавить();
			НоваяСтрП.ЗалоговыйБилет = Выборка.Регистратор;
			НоваяСтрП.ДокументЗайма = ПолучитьДокументОтменыЗайма(Выборка.Регистратор);
			НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Получить(Ном);

			Ном = Ном + 1;
			
		КонецЦикла;
	//-Мельников
	Иначе  
		НоваяСтрП = ПакетДокументов.Добавить();
		НоваяСтрП.ДокументЗайма = ДокументЗайма; 
		НоваяСтрП.ЗалоговыйБилет = ЗалоговыйБилет;
		НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Билет1; 
	КонецЕсли;	  
	
	ТаблицаТоваров.Очистить();
	Для каждого СтрП Из ПакетДокументов Цикл    
		Для каждого стр Из СтрП.ЗалоговыйБилет.Товары Цикл
			НоваяСтр = ТаблицаТоваров.Добавить(); 
			НоваяСтр.Номерстроки = Стр.Номерстроки;    
			НоваяСтр.Артикул = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(СтрП.ЗалоговыйБилет, стр.НомерСтроки);
			НоваяСтр.ОбъектЗалога = стр.ОбъектЗалога; 
			//НоваяСтр.СтатусОбъекта = ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(ДатаДок, НоваяСтр.ОбъектЗалога, СтрП.ЗалоговыйБилет);
			//+Мельников 25.04.24 Устанавливается статус по итогу проведения операции отмены
			НоваяСтр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтказОтОформления;
			//-Мельников
			НоваяСтр.СуммаСсуды = стр.СуммаСсуды;
			НоваяСтр.СуммаОценки = стр.СуммаОценкиМаксимальная; 
			НоваяСтр.ВыделитьВЗалоговыйБилет = СтрП.ВыделитьВЗалоговыйБилет; 
			//НоваяСтр.НомерЗалоговогоБилета = СтрП.ДокументЗайма.НомерЗалоговогоБилета; 
			//+Мельников 25.04.24
			НоваяСтр.НомерЗалоговогоБилета = ?(ЗначениеЗаполнено(СтрП.ДокументЗайма), СтрП.ДокументЗайма.НомерЗалоговогоБилета, СтрП.ЗалоговыйБилет.НомерЗалоговогоБилета); 
			//-Мельников
		Конеццикла;	 
	Конеццикла;		
	ТоварыИтогОценка = ТаблицаТоваров.Итог("СуммаОценки");
	ТоварыИтогЗайи = ТаблицаТоваров.Итог("СуммаСсуды");
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСостояниеЗалоговогоБилета() 
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Если ЗначениеЗаполнено(ДокументЗайма) Тогда
		Запрос.УстановитьПараметр("Период", ДатаДок-1); 
	Иначе	
	    Запрос.УстановитьПараметр("Период", ДатаДок); 
	КонецЕсли;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСостояний.Очистить();
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрСостояние = ТаблицаЗапроса.Получить(0);
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		НоваяСтр.Статус = СтрСостояние.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
				
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета после отмены займа";
		НоваяСтр.КлючСтроки = 3;  	                                          
		НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления;
