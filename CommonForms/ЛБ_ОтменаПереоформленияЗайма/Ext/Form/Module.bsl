&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
        ДокументЗайма = Параметры.Документ;  
		ЗалоговыйБилет = ДокументЗайма.ПредыдущаяОперация;
		Если ДокументЗайма.Проведен тогда
			НеРедактировать = Истина;
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		Иначе
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		КонецЕсли;	   
		ДатаДок = ДокументЗайма.Дата; 
		Ломбард = ДокументЗайма.Ломбард;  
		ОтветственныйПользователь = ДокументЗайма.ОтветственныйПользователь;
		ОтветственныйСотрудник = ДокументЗайма.ОтветственныйСотрудник;
		Комментарий = ДокументЗайма.Комментарий;   
		ПредыдущаяОперация = ЗалоговыйБилет.ПредыдущаяОперация;
		Залогодатель = ЗалоговыйБилет.Залогодатель; 
		ДокументЗалогодателя = ЗалоговыйБилет.ДокументЗалогодателя;  
		Представитель = ЗалоговыйБилет.Представитель; 
		ДокументПредставителя = ЗалоговыйБилет.ДокументПредставителя; 
		СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;
		СрокЗалога = ЗалоговыйБилет.СрокЗалога;
		ОтказОтВыкупа = ЗалоговыйБилет.ОтказОтВыкупа;        
		СуммаЗайма = ЗалоговыйБилет.СуммаСсуды;
		НомерЗБ = ЗалоговыйБилет.НомерЗалоговогоБилета;
		ДопДокументы.Загрузить(ЗалоговыйБилет.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
		ЗаполнитьКонтакнуюИнформациюЗалогодателя(); 
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		Если ЗначениеЗаполнено(Представитель) тогда
		    ЗаполнитьКонтакнуюИнформациюПредставителя(); 
			ЗаполнитьИнформациюОДокументеПредставителя();
		КонецЕсли;  
		ДоверенностьПереоформление = ЗалоговыйБилет.ДоверенностьПредставителя;
		СтатусЗалогодателя = ЗалоговыйБилет.СтатусЗалогодателя; 
		ЗаполнитьСостояниеЗалоговогоБилетаПереоформление();
		ЗаполнитьСостояниеЗалоговогоБилета();
		Если ЗначениеЗаполнено(Представитель) Тогда
			Плательщик = Представитель;
		Иначе	
		    Плательщик = Залогодатель;
		КонецЕсли;	
		Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда			
			Элементы.ГруппаДоверенность.Видимость = Истина; 
			ЗаполнитьТекстДоверенности();
		КонецЕсли;	  
		ЗаполнитьТовары();
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаОбъектыЗалога; 
		//+Мельников 25.04.24 Отмена операции
		ОтмененныйДокумент = ДокументЗайма.ОтмененныйДокумент;
		Элементы.ВидОтменненойОперации.Заголовок = "Отмененная операция: " + """" + ДокументЗайма.ОтмененныйДокумент.ВидОперации + """";
		//-Мельников  
		Если Параметры.ТолькоПросмотр = Истина Тогда	
			Этаформа.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе		
		ДатаДок = ТекущаяДата();   
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		//Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		//  	ОтветственныйПользователь = ТекПользователь;
		//Иначе
		//	ОтветственныйПользователь = ПараметрыСеанса.ТекущийСотрудник;
		//КонецЕсли;   
		ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
        ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник; 		
		Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();		
		Если Параметры.Свойство("ЗалоговыйБилет") Тогда  
			ЗалоговыйБилет = Параметры.ЗалоговыйБилет;
			Залогодатель = ЗалоговыйБилет.Залогодатель; 
			ДокументЗалогодателя = ЗалоговыйБилет.ДокументЗалогодателя;
			Представитель = ЗалоговыйБилет.Представитель; 
		    ДокументПредставителя = ЗалоговыйБилет.ДокументПредставителя; 
            ПредыдущаяОперация = ЗалоговыйБилет.ПредыдущаяОперация;   
			НомерЗБ = ЗалоговыйБилет.НомерЗалоговогоБилета;
			СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;
			СрокЗалога = ЗалоговыйБилет.СрокЗалога;
			ОтказОтВыкупа = ЗалоговыйБилет.ОтказОтВыкупа;  
			ДопДокументы.Загрузить(ЗалоговыйБилет.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
		    ЗаполнитьКонтакнуюИнформациюЗалогодателя();
		   	ЗаполнитьИнформациюОДокументеЗалогодателя();
			Если ЗначениеЗаполнено(Представитель) тогда
			    ЗаполнитьКонтакнуюИнформациюПредставителя(); 
				ЗаполнитьИнформациюОДокументеПредставителя();
			КонецЕсли;  
			ДоверенностьПереоформление = ЗалоговыйБилет.ДоверенностьПредставителя;
			СтатусЗалогодателя = ЗалоговыйБилет.СтатусЗалогодателя; 
			ЗаполнитьСостояниеЗалоговогоБилетаПереоформление();
			ЗаполнитьСостояниеЗалоговогоБилета();
			Если ЗначениеЗаполнено(Представитель) Тогда
				Плательщик = Представитель;
			Иначе	
			    Плательщик = Залогодатель;
			КонецЕсли;	
			Если НЕ Плательщик = ПредыдущаяОперация.Залогодатель Тогда			
				Элементы.ГруппаДоверенность.Видимость = Истина; 
				ЗаполнитьТекстДоверенности();
			КонецЕсли;	  
			ЗаполнитьТовары();  
			Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаЗаемщик;  
			  
		КонецЕсли;  
	КонецЕсли;  
	ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
	                              
	ТоварыИтоги();	
	Элементы.ДекорацияЗБПереоформление.Заголовок = "Залоговый билет № " + сокрЛП(ЭтаФорма.ПредыдущаяОперация.НомерЗалоговогоБилета) +
	           " от " + Формат(ЭтаФорма.ПредыдущаяОперация.Дата, "ДЛФ=") +
	           ", заемщик " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Фамилия) + " " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Имя) + 
	           ?(ЗначениеЗаполнено(ЭтаФорма.ПредыдущаяОперация.Отчество), " " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Отчество), "") + 
	           ", " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.СхемаКредитования) + " на " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.СрокЗалога) + " дней, " + 
			   ?(ЗначениеЗаполнено(ЭтаФорма.ПредыдущаяОперация.Ломбард.НомерЛомбарда), "ломбард № " + СокрЛП(ЭтаФорма.ПредыдущаяОперация.Ломбард.НомерЛомбарда), СокрЛП(ЭтаФорма.ПредыдущаяОперация.Ломбард));   
			   
	Элементы.ДекорацияЗБ.Заголовок = "Залоговый билет № " + сокрЛП(ЭтаФорма.ЗалоговыйБилет.НомерЗалоговогоБилета) +
	           " от " + Формат(ЭтаФорма.ЗалоговыйБилет.Дата, "ДЛФ=") +
	           ", заемщик " + СокрЛП(ЭтаФорма.ФИО) + ", " + СокрЛП(ЭтаФорма.ЗалоговыйБилет.СхемаКредитования) + " на " + СокрЛП(ЭтаФорма.ЗалоговыйБилет.СрокЗалога) + " дней, " + 
			   ?(ЗначениеЗаполнено(ЭтаФорма.ЗалоговыйБилет.Ломбард.НомерЛомбарда), "ломбард № " + СокрЛП(ЭтаФорма.ЗалоговыйБилет.Ломбард.НомерЛомбарда), СокрЛП(ЭтаФорма.ЗалоговыйБилет.Ломбард)); 
			      
    СообщениеПроверкиПоЛомбарду = ЛБ_УправлениеЛомбардом.ПроверитьИзделияЗБВЛомбарде(ЗалоговыйБилет.Дата-1, ПредыдущаяОперация, Ломбард, ложь); 
	Если НЕ ПустаяСтрока(СообщениеПроверкиПоЛомбарду) Тогда 
		ОбщегоНазначения.СообщитьПользователю(СообщениеПроверкиПоЛомбарду+ ". Отмена переоформления запрещена.");
	КонецЕсли;
	//+Мельников 28.05.24
	УстановитьВидимость()
	//-Мельников
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстДоверенности()   
	Если ЗначениеЗаполнено(ДоверенностьПереоформление) Тогда  
		Если ДоверенностьПереоформление.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда   
			Доверенность = "Свидетельство о праве на наследство № " + СокрЛП(ДоверенностьПереоформление.НомерДоверенности) + " от " + Формат(ДоверенностьПереоформление.ДатаДоверенности, "ДФ=dd.MM.yyyy"); 
		Иначе	
		    Доверенность = "Доверенность " + НРег(строка(ДоверенностьПереоформление.ВидДоверенности)) + " № " +                                                                                               		
				   ?(НЕ ПустаяСтрока(ДоверенностьПереоформление.НомерДоверенности), СокрЛП(ДоверенностьПереоформление.НомерДоверенности), "б/н") + " от " + Формат(ДоверенностьПереоформление.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
				   " действует до " + Формат(ДоверенностьПереоформление.СрокДействияДоверенности, "ДФ=dd.MM.yyyy"); 
		КонецЕсли;		   
	Иначе
		Доверенность = "";
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТовары() 	
	ТаблицаТоваров.Очистить(); 
	Ном = 0;
	Для каждого стр Из ЗалоговыйБилет.Товары Цикл
		//+Мельников 28.05.24 Закомментировал. При отмене операции должны отменяться все операции по документу.
		//Если НЕ Стр.Переоформить Тогда
		//	Продолжить;
		//КонецЕсли;
		//-Мельников
		Ном = Ном + 1;
		НоваяСтр = ТаблицаТоваров.Добавить(); 
		НоваяСтр.Номерстроки = Стр.Номерстроки;
		//НоваяСтр.Артикул = ?(НЕ Стр.Переоформить, ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет.ПредыдущаяОперация, стр.ОбъектЗалога), ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет, стр.ОбъектЗалога));
		НоваяСтр.Артикул = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет, Ном);
		НоваяСтр.ОбъектЗалога = стр.ОбъектЗалога;  
		НоваяСтр.ОбъектЗалогаСтрока = Строка(стр.ОбъектЗалога) + ?(Стр.Переоформить, "", " (добавлен)");
		НоваяСтр.СтатусОбъекта = ?(Стр.Переоформить, ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(ДатаДок-1, НоваяСтр.ОбъектЗалога, ЗалоговыйБилет), Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен); 
		//НоваяСтр.СтатусОбъектаПослеОтмены = ?(Стр.Новый, Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтказОтОформления, ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(ЗалоговыйБилет.Дата-1, НоваяСтр.ОбъектЗалога, ПредыдущаяОперация));
		НоваяСтр.СтатусОбъектаПослеОтмены = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтказОтОформления;
		НоваяСтр.СуммаСсуды = стр.СуммаСсуды;
		НоваяСтр.СуммаОценки = стр.СуммаОценкиМаксимальная; 	 
	Конеццикла;		
	ТоварыИтогОценка = ТаблицаТоваров.Итог("СуммаОценки");
	ТоварыИтогЗайи = ТаблицаТоваров.Итог("СуммаСсуды");
КонецПроцедуры	

&НаСервере
Функция СоздатьНовуюОплатуПроцентов()
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.ПредыдущаяОперация = ПредыдущаяОперация; 
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ЭтаФорма.ДокументЗайма), ДатаДок-1, ДатаДок); 
	ДокументОбъект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	ДокументОбъект.ПроцентнаяСхема = ПредыдущаяОперация.ПроцентнаяСхема;  
	ДокументОбъект.Выкуп = Истина;
	Возврат ДокументОбъект; 
КонецФункции

&НаСервере
Функция РасчитатьДолгПоПроцентам(ЗБ, СтатусЗБ, СуммаЗайма, ПроцентнаяСтавка, ДатаНачалаРасчета) 
	//ТаблицаОплатДетально.Очистить();
	ДокументОбъект = СоздатьНовуюОплатуПроцентов(); 	    
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗБ.Дата, ЗБ.Организация);
	Если НЕ СтруктураП = неопределено Тогда
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		ПредельноеЗначениеПроцентов = ЗБ.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
	Иначе
		ПредельноеЗначениеПроцентов = 0;
	КонецЕсли;   
	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗБ);
	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗБ); 	   
	ПричинаПримененияПроцентнойСхемыОплата = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ОплатаПроцентов;
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемыОплата, Установки, СтруктураОкр); 
			
	//Для каждого стр из ДокументОбъект.НачислениеПроцентовДетально Цикл 
	//    НоваяСтр = ТаблицаОплатДетально.Добавить(); 
	//	ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	//КонецЦиклА;
	//
	//НачисленоПроцентов = Результат.СуммаПроцентовНачислено;
	//
	Возврат Результат.СуммаПроцентов;
КонецФункции	

&НаСервере
Процедура ЗаполнитьСостояниеЗалоговогоБилетаПереоформление()  
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ПредыдущаяОперация); 
	Если ЗначениеЗаполнено(ЭтаФорма.ДокументЗайма) Тогда
		Запрос.УстановитьПараметр("Период", ДатаДок-1); 
	Иначе	
	    Запрос.УстановитьПараметр("Период", ДатаДок);  		
	КонецЕсли;	                                       
	                                     
	ЗапросРасчеты = Новый Запрос;   
	ЗапросРасчеты.УстановитьПараметр("ЗалоговыйБилет", ПредыдущаяОперация);
	ЗапросРасчеты.Текст = "ВЫБРАТЬ
	                      |	СУММА(ЛБ_РасчетыСКлиентами.Сумма) КАК Сумма
	                      |ИЗ
	                      |	РегистрНакопления.ЛБ_РасчетыСКлиентами КАК ЛБ_РасчетыСКлиентами
	                      |ГДЕ
	                      |	ЛБ_РасчетыСКлиентами.Регистратор = &Регистратор
	                      |	И ЛБ_РасчетыСКлиентами.ЗалоговыйБилет = &ЗалоговыйБилет
	                      |	И ЛБ_РасчетыСКлиентами.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения КАК НомерДопСоглашения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСостоянийПереоформление.Очистить();
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрСостояние = ТаблицаЗапроса.Получить(0);
		НоваяСтр = ТаблицаСостоянийПереоформление.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		НоваяСтр.Статус = СтрСостояние.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ПредыдущаяОперация.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
		НоваяСтр.ПредельныйСрокЗайма = СтрСостояние.ПредельныйСрокЗайма;
		НоваяСтр.ПредельныйСрокЗаймаДни = СтрСостояние.ПредельныйСрокЗаймаДни;  
		//НоваяСтр.СуммаИтог = СтрСостояние.СуммаЗайма; 
				
		КолСтр = ТаблицаЗапроса.Количество()-1;  		
		СтрСостояние = ТаблицаЗапроса.Получить(КолСтр);   
		Если ТипЗнч(СтрСостояние.Регистратор) = Тип("ДокументСсылка.ЛБ_КарточкаЗалогодателя") Тогда
			ТекущийСтатусЗБ = СтрСостояние.СтатусЗалоговогоБилета; 
			СтрСостояние = ТаблицаЗапроса.Получить(КолСтр-1); 
		Иначе
			ТекущийСтатусЗБ = неопределено;
		КонецЕсли;	
		НоваяСтр = ТаблицаСостоянийПереоформление.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета до отмены переоформления";
		НоваяСтр.КлючСтроки = 2;
		НоваяСтр.Статус = ?(ТекущийСтатусЗБ = неопределено, СтрСостояние.СтатусЗалоговогоБилета, ТекущийСтатусЗБ);    
		ЗапросРасчеты.УстановитьПараметр("Регистратор", СтрСостояние.Регистратор); 
		ВыборкаР = ЗапросРасчеты.Выполнить().Выбрать();
		Если ВыборкаР.Следующий() Тогда
		    НоваяСтр.СуммаИтог = ВыборкаР.Сумма; 
		КонецЕсли;
		
		Если ТаблицаЗапроса.Количество() = 1 Тогда  
			СтрСостояние = ТаблицаЗапроса.Получить(0);
		Иначе  
			КолСтр = ТаблицаЗапроса.Количество()-2;  		
		    СтрСостояние = ТаблицаЗапроса.Получить(КолСтр);   
		КонецЕсли;	  
		Если ТипЗнч(СтрСостояние.Регистратор) = Тип("ДокументСсылка.ЛБ_КарточкаЗалогодателя") Тогда
			ТекущийСтатусЗБ = СтрСостояние.СтатусЗалоговогоБилета; 
			СтрСостояние = ТаблицаЗапроса.Получить(КолСтр-1); 
		Иначе
			ТекущийСтатусЗБ = неопределено;
		КонецЕсли;	
		НоваяСтр = ТаблицаСостоянийПереоформление.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета после отмены переоформления";
		НоваяСтр.КлючСтроки = 3;
		НоваяСтр.Статус = ?(ТекущийСтатусЗБ = неопределено, СтрСостояние.СтатусЗалоговогоБилета, ТекущийСтатусЗБ);    
        НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ПредыдущаяОперация.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
		НоваяСтр.ПредельныйСрокЗайма = СтрСостояние.ПредельныйСрокЗайма;
		НоваяСтр.ПредельныйСрокЗаймаДни = СтрСостояние.ПредельныйСрокЗаймаДни; 
		НоваяСтр.СуммаПроцентовДолг = РасчитатьДолгПоПроцентам(ПредыдущаяОперация, НоваяСтр.Статус, НоваяСтр.СуммаЗайма, НоваяСтр.ПроцентнаяСтавка, НоваяСтр.ДатаНачалаРасчета);
	 Иначе
		НоваяСтр = ТаблицаСостоянийПереоформление.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
	КонецЕсли;	  
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСостояниеЗалоговогоБилета() 
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Если ЗначениеЗаполнено(ДокументЗайма) Тогда
		Запрос.УстановитьПараметр("Период", ДатаДок-1); 
	Иначе	
	    Запрос.УстановитьПараметр("Период", ДатаДок); 
	КонецЕсли;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСостояний.Очистить();
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрСостояние = ТаблицаЗапроса.Получить(0);
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия переоформления займа";
		НоваяСтр.КлючСтроки = 1;
		НоваяСтр.Статус = СтрСостояние.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
				
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета после отмены переоформления займа";
		НоваяСтр.КлючСтроки = 3;  	                                          
		НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьНомераЗБ() 
	ИнфНомераЗБ = "";  
	ТоварыДоп = ТаблицаТоваров.Выгрузить();
	ТоварыДоп.Свернуть("НомерЗалоговогоБилета");
	Для каждого СтрДоп из ТоварыДоп Цикл 
		ИнфНомераЗБ = ИнфНомераЗБ + ?(Пустаястрока(ИнфНомераЗБ), "", ", ") + СокрЛП(стрДоп.НомерЗалоговогоБилета);
	Конеццикла;	  
	ИнфНомераЗБ = ИнфНомераЗБ + " от " + Формат(ДатаДок, "ДЛФ=DDT");
	Возврат ИнфНомераЗБ; 
КонецФункции	          

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ДопДокументы.Количество() = 0 Тогда
		Элементы.ГруппаДопДокумент.Показать(); 
	КонецЕсли;	 
	
	Если НЕ ЗначениеЗаполнено(Этаформа.ДоверенностьПереоформление) Тогда
		Элементы.ГруппаДоверенность.Видимость = Ложь; 
	КонецЕсли;	
	
	Если НеРедактировать Тогда  
		Элементы.Редактировать.Видимость = ?(ЭтаФорма.ТолькоПросмотр, Ложь, Истина);
		Элементы.ОтменитьЗайм.Доступность = ложь;
	    Элементы.ОсновнаяПанель.ТолькоПросмотр = Истина; 
	Иначе
		Элементы.СтраницаЗаемщик.ТолькоПросмотр = Истина;  
	КонецЕсли;	
		
	ПриСменеСтраницы(Элементы.ОсновнаяПанель.ТекущаяСтраница); 
КонецПроцедуры   

