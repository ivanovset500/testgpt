&НаСервере
Функция ОтменитьВыдачуЗаймаНаСервере() 
	СообщениеПроверкиПоЛомбарду = ЛБ_УправлениеЛомбардом.ПроверитьИзделияЗБВЛомбарде(ЗалоговыйБилет.Дата-1, ПредыдущаяОперация, Ломбард, ложь); 
	Если НЕ ПустаяСтрока(СообщениеПроверкиПоЛомбарду) Тогда 
		ОбщегоНазначения.СообщитьПользователю(СообщениеПроверкиПоЛомбарду + ". Отмена переоформления запрещена.");
		Возврат Ложь;
	КонецЕсли;   
    	
	ЕстьНеПроведенные = Ложь;   
	СсылкаНаДокумент = СоздатьДокументНаСервере();   
	Если НЕ СсылкаНаДокумент.проведен Тогда 
		ЕстьНеПроведенные = истина;
	//+Мельников 31.07.24 Правка для Отмены операции
	Иначе
		ДокументОтмены = СсылкаНаДокумент;
	//-Мельников
	КонецЕсли;	
	
	Возврат ЕстьНеПроведенные;
КонецФункции

&НаСервере
Функция ПолучитьПредыдущегоЗалогодателя()
	Возврат ПредыдущаяОперация.Залогодатель;
КонецФункции

&НаКлиенте
Процедура ОтменитьВыдачуЗайма(Команда)
	Если НеРедактировать Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьНеПроведенные = ОтменитьВыдачуЗаймаНаСервере();
		
	Если НЕ ЕстьНеПроведенные Тогда
		НеРедактировать = Истина;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
        Элементы.Редактировать.Видимость = Истина; 
		Элементы.ОтменитьЗайм.Доступность = Ложь;
	   	Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать; 
		
		Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
   	        ФормаРМП = ВладелецФормы;   
			Если ФормаРМП.Залогодатель = ПолучитьПредыдущегоЗалогодателя() Тогда
                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено);
			ИначеЕсли ФормаРМП.Залогодатель = Залогодатель Тогда
                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено);
			КонецЕсли;	
        КонецЕсли;
	КонецЕсли;	

	//+Мельников 28.05.24
	УстановитьВидимость()
	//-Мельников

КонецПроцедуры

&НаСервере
Функция СнятьСПроведения(Документ)  
	ДокОбъект = Документ.ПолучитьОбъект(); 
	Если ДокОбъект.Проведен Тогда                  
		Попытка
		    ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);  
			Возврат Истина;
		Исключение   
			Сообщить("Не удалось снять с проведения залоговый билет " + СокрЛП(Документ.НомерЗалоговогоБилета) + ". Редактирование запрещено.");
			Возврат Ложь;
		КонецПопытки;	
	Иначе
		возврат Истина;
	КонецЕсли;
КонецФункции	

&НаКлиенте
Процедура Редактировать(Команда)   
	ПроверкаМожноРедактировать = Истина;
	Если ЭтаФорма.НеРедактировать Тогда 
		Если ЗначениеЗаполнено(ДокументЗайма) тогда 
			Результат = СнятьСПроведения(ДокументЗайма);
			Если НЕ Результат тогда  
				ПроверкаМожноРедактировать = Ложь;
			КонецЕсли;	
		КонецЕсли;	
		Если ПроверкаМожноРедактировать Тогда  
			НеРедактировать = Ложь;
			Этаформа.ТолькоПросмотр = Ложь;
			Этаформа.Открыть();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать; 
	Элементы.СтраницаЗаемщик.ТолькоПросмотр = Истина;  
	Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
	Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
	Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
	Элементы.Редактировать.Видимость = Ложь; 
	Элементы.ОтменитьЗайм.Доступность = Истина;
КонецПроцедуры

