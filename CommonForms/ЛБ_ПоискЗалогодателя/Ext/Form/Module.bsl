	ОтборДР = '00010101';
	ОтборФамилия = "";
	ОтборИмя = "";
	ОтборОтчество = "";
	ОтборНомерТелефона = "+7 (   )        ";
	ОтборСерияДокумента = "";
	ОтборНомерДокумента = "";
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляОтбора()
	//пока непосредственно. Можно сделать через ПолучитьРеквизиты() и перебор, но это надо вызов сервера делать...
	//пока непосредственно. Можно сделать через ПолучитьРеквизиты() и перебор, но это надо вызов сервера делать...
	//СписокДляОбновленияОтображения = Новый СписокЗначений;
	ОчиститьПоляОтбораСервер();
