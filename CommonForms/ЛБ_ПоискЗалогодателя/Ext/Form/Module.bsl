	Элементы.ОтборИмя.ОбновитьТекстРедактирования();
	ЭтотОбъект.ОтборНомерДокумента = "";
	Элементы.ОтборНомерДокумента.ОбновитьТекстРедактирования();
	ЭтотОбъект.ОтборНомерЗБ = "";
	Элементы.ОтборНомерЗБ.ОбновитьТекстРедактирования();
	ЭтотОбъект.ОтборНомерТелефона = "+7 (   )        ";
	Элементы.ОтборНомерТелефона.ОбновитьТекстРедактирования();
	ЭтотОбъект.ОтборОтчество = "";
	Элементы.ОтборОтчество.ОбновитьТекстРедактирования();
	ЭтотОбъект.ОтборСерияДокумента = "";
	Элементы.ОтборСерияДокумента.ОбновитьТекстРедактирования();
	ЭтотОбъект.ОтборФамилия = "";
	Элементы.ОтборФамилия.ОбновитьТекстРедактирования();
	ОбновитьОтображениеДанных();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОтборНажатие(Элемент)
	//Элементы.ИмяВашейГруппы.Видимость = НЕ Элементы.ИмяВашейГруппы.Видимость
	//Элемент.Имя	"ДекорацияОтборНомерЗБ"	Строка	
	тГруппаОтбор = "Группа" + Сред(Элемент.Имя, 7);
	текВидимость = Элементы[тГруппаОтбор].Видимость;
	Если текВидимость = Истина Тогда 
		//эта группа уже "развернута", ничего не делаем
		Возврат;
	Иначе 
		ОчиститьПоляОтбора();
		//Залогодатели.ПолучитьЭлементы().Очистить();
		Залогодатели.Очистить();
		ДокументыЗалогодателей.Очистить();
		текущаяГруппаОтбора = Сред(Элемент.Имя, 7);	
	КонецЕсли;
	Для Каждого текЭлемент Из Элементы Цикл 
		Если (Не ТипЗнч(текЭлемент) = Тип("ДекорацияФормы")) И (Лев(текЭлемент.Имя, 11) = "ГруппаОтбор") Тогда
			Если текЭлемент.Имя = тГруппаОтбор Тогда 
				текЭлемент.Видимость = Истина;
			Иначе 	
				текЭлемент.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//Если тГруппаОтбор = "ГруппаОтборНомерЗБ" Тогда
	//	Элементы.ОтборНомерЗБ.ОтметкаНезаполненного = Истина;
	//ИначеЕсли тГруппаОтбор = "ГруппаОтборНомерТелефона" Тогда
	//	Элементы.ОтборНомерТелефона.ОтметкаНезаполненного = Истина;
	//КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеОтбораИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	//Залогодатели.ПолучитьЭлементы().Очистить();
	Залогодатели.Очистить();
	ДокументыЗалогодателей.Очистить();
	Если Элемент.Имя = "ОтборНомерЗБ" Тогда 
		Если СтрДлина(СокрЛП(Текст)) = 7 Тогда 
			ЭтаФорма[Элемент.Имя] = Текст;
			//Элементы.ОтборНомерЗБ.ОтметкаНезаполненного = Ложь;
			Элементы.ОтборНомерЗБ.ЦветФона = WebЦвета.БледноЗеленый;
			КомандаПоискНовыйНаСервере(Элемент.Имя, Текст);
		Иначе 
			//Элементы.ОтборНомерЗБ.ОтметкаНезаполненного = Истина;
			Элементы.ОтборНомерЗБ.ЦветФона = WebЦвета.СветлоРозовый;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЭтаФорма[Элемент.Имя]) = Тип("Дата") Тогда 
		Если Текст = "  .  .    " Тогда
			//пустая строка
			ЭтаФорма[Элемент.Имя] = '00010101';
			КомандаПоискНовыйНаСервере(Элемент.Имя, Текст);
			
		ИначеЕсли СтрДлина(СокрЛП(Текст)) < 10 Тогда
			//вводится дата, но введена ещё не полностью
			СтандартнаяОбработка = Ложь;
			//Возврат;
		Иначе
			ЭтаФорма[Элемент.Имя] = Дата(Текст + " 00:00:00");
			КомандаПоискНовыйНаСервере(Элемент.Имя, Текст);
		КонецЕсли;	
	Иначе
		ЭтаФорма[Элемент.Имя] = Текст;
		Если СтрДлина(Текст) > 2 Тогда 
			КомандаПоискНовыйНаСервере(Элемент.Имя, Текст);
		ИначеЕсли Элемент.Имя = "ОтборСерияДокумента" И СтрДлина(Текст) = 2 Тогда
			КомандаПоискНовыйНаСервере(Элемент.Имя, Текст);
		КонецЕсли;
	КонецЕсли;	
	//ИначеЕсли Элемент.Имя =	"ОтборНомерЗБ" И СтрДлина(Текст) = 7 Тогда 
	//		ЭтаФорма[Элемент.Имя] = Текст;
	//		КомандаПоискНовыйНаСервере(Элемент.Имя, Текст);
	//КонецЕсли;
КонецПроцедуры


