
&НаСервере
Процедура УстановитьТекщиеСтроки()
	Если НЕ Залогодатели.Количество() = 0  Тогда
	    СтрокаЗ = Залогодатели[0]; 
		ИдентификаторСтрокиЗ = СтрокаЗ.ПолучитьИдентификатор();
		Элементы.Залогодатели.ТекущаяСтрока = ИдентификаторСтрокиЗ;
		
		ОтборДок = Новый Структура;
		ОтборДок.Вставить("Залогодатель", СтрокаЗ.Залогодатель);
		Строки = ДокументыЗалогодателей.НайтиСтроки(ОтборДок);
		Если НЕ Строки.Количество() = 0 Тогда
			СтрокаД = ДокументыЗалогодателей[0]; 
			ИдентификаторСтрокиД = СтрокаД.ПолучитьИдентификатор();
			Элементы.ДокументыЗалогодателей.ТекущаяСтрока = ИдентификаторСтрокиД;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФамилияОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 2 Тогда
		ФИО = Текст;
        НайтиВозможныеВариантыЗалогодатели(); 
	ИначеЕсли СтрДлина(Текст) = 0 Тогда	 
		ФИО = Текст;
		Залогодатели.Очистить();
		ДокументыЗалогодателей.Очистить();	
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиПриАктивизацииСтроки(Элемент)
	//Возврат;	//+++ Моисеев пока что отключил.
	ТекСтрока = Элемент.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		ПерезаполнитьИнформациюПоДокументамЗалогодателя(ТекСтрока.Залогодатель);
		Элементы.ДокументыЗалогодателей.ОтборСтрок = Новый ФиксированнаяСтруктура("Залогодатель", ТекСтрока.Залогодатель);
		//Гражданство = ТекСтрока.Гражданство;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекущуюСтрокуЗалогодателей(Залогодатель)
	Для каждого СтрокаЗ Из Залогодатели Цикл
		Если СтрокаЗ.Залогодатель = Залогодатель Тогда
		    ИдентификаторСтроки = СтрокаЗ.ПолучитьИдентификатор();
		    Элементы.Залогодатели.ТекущаяСтрока = ИдентификаторСтроки;
			Элементы.ДокументыЗалогодателей.ОтборСтрок = Новый ФиксированнаяСтруктура("Залогодатель", Залогодатель);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Функция ПроверитьНачалоРаботыСКлиентом(Залогодатель)  
	Запрос = новый Запрос;  
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛБ_АнкетаЗалогодателя.Период КАК Период,
	               |	ЛБ_АнкетаЗалогодателя.ДатаОформленияАнкеты КАК ДатаОформленияАнкеты
	               |ИЗ
	               |	РегистрСведений.ЛБ_АнкетаЗалогодателя КАК ЛБ_АнкетаЗалогодателя
	               |ГДЕ
	               |	ЛБ_АнкетаЗалогодателя.Залогодатель = &Залогодатель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда  
		Если ДатаДок < Выборка.ДатаОформленияАнкеты тогда
			ОбщегоНазначения.СообщитьПользователю("Анкета клиента клиента оформлена " + Формат(Выборка.ДатаОформленияАнкеты, "ДФ=dd.MM.yyyy") + ". Подбор данных клиента на " + Формат(ДатаДок, "ДФ=dd.MM.yyyy; ДЛФ=DT") + " невозможен.");
			Возврат ложь;			
		КонецЕсли;	
	КонецЕсли;
	возврат Истина;
КонецФункции
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Дата") Тогда 
		ДатаДок = Параметры.Дата; 
		Если Параметры.Свойство("НаТекущуюДату") Тогда
			НаТекущуюДату = Параметры.НаТекущуюДату;
		КонецЕсли;	
	Иначе
		ДатаДок = ТекущаяДата(); 
		НаТекущуюДату = Истина;
	КонецЕсли;
	Если Параметры.Свойство("Залогодатель") Тогда  
		Если ПроверитьНачалоРаботыСКлиентом(Параметры.Залогодатель) Тогда			
			НоваяСтр = Залогодатели.Добавить();
			НоваяСтр.Залогодатель = Параметры.Залогодатель;
			Если Параметры.Свойство("НомерТелефона") Тогда
				НоваяСтр.НомерТелефона = Параметры.НомерТелефона;
			КонецЕсли;	
			Если Параметры.Свойство("Гражданство") Тогда
				Гражданство = Параметры.Гражданство;
			КонецЕсли;
			ФИО = СокрЛП(Параметры.Залогодатель); 
			НайтиВозможныеВариантыЗалогодатели();
			ЗаполнитьИнформациюПоДокументамЗалогодателя();	
			УстановитьТекущуюСтрокуЗалогодателей(Параметры.Залогодатель); 
			Элементы.КнопкаСоздать.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	//Если НЕ ЗначениеЗаполнено(Гражданство) Тогда
	//	Гражданство = Справочники.СтраныМира.Россия;
	//КонецЕсли;
	Если Параметры.Свойство("ЭтоПредставитель") Тогда
		ЭтаФорма.Заголовок = "Выбор представителя клиента";
	КонецЕсли;
	Если Параметры.Свойство("ТолькоДокументы") Тогда
		Если Параметры.ТолькоДокументы Тогда
		    Элементы.ГруппыОтборы.Видимость = Ложь;
		КонецЕсли;	
	КонецЕсли;
	// ++ Сербаев 20.06.2023
	Если Параметры.Свойство("ВидОперации") Тогда
		ВидОперации = Параметры.ВидОперации;
	КонецЕсли;	
    // -- Сербаев 20.06.2023 
	Если Параметры.Свойство("БезДокументов") Тогда
		БезДокументов = Параметры.БезДокументов;
	КонецЕсли;
	Если Параметры.Свойство("НеРедактировать") Тогда
		Элементы.КнопкаСоздать.Доступность = Ложь; 
		Элементы.ИзменитьЗалогодателя.Доступность = Ложь;
	КонецЕсли;
	
	текущаяГруппаОтбора = "ОтборФИО_ДР";	//"ОтборНомерЗБ";

    //lion
	Если Этаформа.параметры.свойство("ОткрытьКарточкуНеОбрабатыватьВыбор") тогда
		Этаформа.ЗакрыватьПриВыборе=Ложь;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Функция ПроверитьБлокировкуКлиента(Клиент) 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей КАК ЛБ_КонтактнаяИнформацияЗалогодателей
	               |ГДЕ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель = &Залогодатель";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораЗалогодателя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	Если НаТекущуюДату Тогда
	    ДатаДок = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;	
	Если Параметры.Свойство("Гражданство") Тогда
		Гражданство = Параметры.Гражданство;
	Иначе
		Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	КонецЕсли; 
	
	//проверим снятие блокировки с конт. информации клиента
	//Пока Истина Цикл
	//	Если НЕ ПроверитьБлокировкуКлиента(Результат.Залогодатель) Тогда    
	//		ДатаДок = ОбщегоНазначенияКлиент.ДатаСеанса();
	//		Прервать;
	//	КонецЕсли;	
	//Конеццикла;
	
    ФИО = СокрЛП(Результат.Залогодатель);
	НайтиВозможныеВариантыЗалогодатели();
	ЗаполнитьИнформациюПоДокументамЗалогодателя();
	УстановитьТекущуюСтрокуЗалогодателей(Результат.Залогодатель);
	ОчиститьПоляОтбора();
	//Этаформа.Закрыть(Результат);
КонецПроцедуры
                                                                                
&НаКлиенте
Процедура СоздатьЗалогодателя(Команда)
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалогодателя",ЭтаФорма);    
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриСохранении", Истина);
	ОчиститьПоляОтбора();
	Залогодатели.Очистить();
	ДокументыЗалогодателей.Очистить();
	ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура НайтиВозможныеВариантыЗалогодатели()
	Залогодатели.Очистить();
	ДокументыЗалогодателей.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Залогодатели.Ссылка КАК Залогодатель,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК НомерТелефона,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ВЫБОР
	               |		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА -1
	               |		КОГДА МЕСЯЦ(&Дата) < МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &Дата, ГОД) - 1
	               |		КОГДА МЕСЯЦ(&Дата) > МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &Дата, ГОД)
	               |		КОГДА МЕСЯЦ(&Дата) = МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ДЕНЬ(&Дата) < ДЕНЬ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |						ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &Дата, ГОД) - 1
	               |					КОГДА ДЕНЬ(&Дата) >= ДЕНЬ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |						ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &Дата, ГОД)
	               |				КОНЕЦ
	               |	КОНЕЦ КАК ЗалогодательВозраст,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
				   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых.ОтветственныйЛомбард.НомерЛомбарда КАК ЗалогодательНомерЛомбардаГдеСозданаКарточка
	               |ИЗ
	               |	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	               |		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПервых КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых
					|		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых.Залогодатель = ЛБ_Залогодатели.Ссылка)
	               |ГДЕ
	               |	(ЛБ_Залогодатели.Наименование ПОДОБНО &Фио
	               |			ИЛИ &Фио = """")
	               |	И НЕ ЛБ_Залогодатели.ПометкаУдаления";

	//Запрос.УстановитьПараметр("Фио", "%"+Фио+"%");
	Запрос.УстановитьПараметр("Фио", Фио+"%");  
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Залогодатели.Загрузить(Запрос.Выполнить().Выгрузить());

	Если Залогодатели.Количество() <> 0 Тогда
		ЗаполнитьИнформациюПоДокументамЗалогодателя();
		УстановитьТекщиеСтроки();
	Иначе
		
		Сообщить("Залогодатели не найдены!");
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюПоДокументамЗалогодателя()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец КАК Залогодатель,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ КАК ОсновнойДУЛ,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК НеДействителен
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец В (&Залогодатели)
	               |				И ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";	
	СписокЗалогодателей = Новый СписокЗначений;
	ТаблицаЗалогодателей = Залогодатели.Выгрузить(, "Залогодатель");
	Для каждого Стр Из ТаблицаЗалогодателей Цикл 
		СписокЗалогодателей.Добавить(Стр.Залогодатель);
	КонецЦикла;	     
	Запрос.УстановитьПараметр("Залогодатели", СписокЗалогодателей);
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	
	ДокументыЗалогодателей.Загрузить(Запрос.Выполнить().Выгрузить());
	ПроверитьДействительностьДокументов();
	ДокументыЗалогодателей.Сортировать("ОсновнойДУЛ УБЫВ"); 
КонецПроцедуры	  

&НаСервере
Процедура ПроверитьДействительностьДокументов() 
	ЕстьСвидетельствоОРождении = ложь;
	Для каждого Стр Из ДокументыЗалогодателей Цикл 
		Если Стр.ПроверкаНеДействителен Тогда  
			Продолжить;
		КонецЕсли;	
		Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
			Парам = Новый Структура("Серия, Номер", СокрЛП(Стр.Серия), СокрЛП(Стр.Номер));
			Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
				Стр.ПроверкаНеДействителен = Истина;
			КонецЕсли;	
		КонецЕсли;	

		Если (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) Тогда
			ЕстьСвидетельствоОРождении = Истина;	
		КонецЕсли;
		Отбор = Новый Структура;
	    Отбор.Вставить("Залогодатель", Стр.Залогодатель);
        СтрокиЗ = Залогодатели.НайтиСтроки(Отбор);
		Если НЕ СтрокиЗ.Количество() = 0 Тогда
			ДатаРождения = СтрокиЗ.Получить(0).ДатаРождения;
			Если НЕ ДатаРождения = Дата(1,1,1) Тогда
		        ЛБ_ОбщийМодуль.ПроверитьДействительностьДокумента(Стр, ДатаРождения, Ложь, ДатаДок);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Если ЕстьСвидетельствоОРождении Тогда
		//проверим недействительность свидетельства о рождении если есть паспорт
        ЛБ_ОбщийМодуль.ПроверитьДействительностьСвидетельствоОРождении(ДокументыЗалогодателей);
	КонецЕсли;	
	
	//УдСтроки = новый СписокЗначений;
	//Для каждого Стр Из ДокументыЗалогодателей Цикл
	//	Если Стр.ПроверкаНеДействителен тогда
	//		Удстроки.Добавить(Стр); 
	//	КонецЕсли;	
	//Конеццикла;	  
	//Для каждого Эл Из УдСтроки Цикл 
	//	ДокументыЗалогодателей.Удалить(Эл.Значение);
	//КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура НайтиВозможныеВариантыДокументы()
	ДокументыЗалогодателей.Очистить();
	ЗалогоДатели.Очистить();    

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец КАК Залогодатель,
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя,
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента, 
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ КАК ОсновнойДУЛ,
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ПроверкаНеДействителен
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,	               
	               |			 ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)
	               |				И (ДокументСерия ПОДОБНО &Серия
	               |					ИЛИ &Серия = """")
	               |				И (ДокументНомер ПОДОБНО &Номер
	               |					ИЛИ &Номер = """")";
	Если ЗначениеЗаполнено(Гражданство) Тогда
		Запрос.Текст = Запрос.Текст + "
	               |				И Гражданство = &Гражданство";
	КонецЕсли;	
	Запрос.Текст = Запрос.Текст + ") КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Запрос.УстановитьПараметр("Серия",Серия+"%");
	Запрос.УстановитьПараметр("Номер", Номер+"%");
	Запрос.УстановитьПараметр("Гражданство", Гражданство);  
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	
	ДокументыЗалогодателей.Загрузить(Запрос.Выполнить().Выгрузить()); 
	ПроверитьДействительностьДокументов();
	
	Если ДокументыЗалогодателей.Количество() > 0 Тогда
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	ЛБ_Залогодатели.Ссылка КАК Залогодатель,
	                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК НомерТелефона,
	                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти,
	                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
	                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	                   |ИЗ
	                   |	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	                   |		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
	                   |ГДЕ
	                   |	ЛБ_Залогодатели.Ссылка В(&Залогодатели)";
		СписокЗ = Новый СписокЗначений;
		Для сч = 0 По ДокументыЗалогодателей.Количество()-1 Цикл
			СписокЗ.Добавить(ДокументыЗалогодателей.Получить(сч).Залогодатель);
		КонецЦикла;	
		Запрос.УстановитьПараметр("Залогодатели", СписокЗ);

		Залогодатели.Загрузить(Запрос.Выполнить().Выгрузить());
		ДокументыЗалогодателей.Сортировать("ОсновнойДУЛ УБЫВ, ВидДокументаЗалогодателя");
		УстановитьТекщиеСтроки();	
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ФамилияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 2 Тогда
		ФИО = Текст;
        НайтиВозможныеВариантыЗалогодатели();  
	ИначеЕсли СтрДлина(Текст) = 0 Тогда	 
		ФИО = Текст;
		Залогодатели.Очистить();
		ДокументыЗалогодателей.Очистить();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ВыборЗалогодателя();
КонецПроцедуры


&НаКлиенте
Процедура НомерИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 5 Тогда
		Номер = Текст;
        НайтиВозможныеВариантыДокументы();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДокументыЗалогодателейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	ТекСтрока = Элементы.ДокументыЗалогодателей.ТекущиеДанные;
	Если ТекСтрока.ПроверкаНеДействителен тогда 
		Сообщить("Документ удостоверяющий личность клиента не действителен!", СтатусСообщения.Информация);
		Возврат;
	КонецЕсли;	
	ВыборЗалогодателя();
КонецПроцедуры

&НаКлиенте
Процедура Выбор(Команда)
	ВыборЗалогодателя();
КонецПроцедуры

&НаСервере
Функция ПроверитьПоПеречнюНедружественныхСтран(Гражданство)
	Возврат ЛБ_УправлениеЛомбардом.ПроверитьПоПеречнюНедружественныхСтран(Гражданство);
КонецФункции	

&НаКлиенте
Процедура ВыборЗалогодателя()
	ТекСтрока = Элементы.Залогодатели.ТекущиеДанные; 
	Если ТекСтрока = неопределено тогда
		Возврат;
	КонецЕсли;	
	Если НЕ ТекСтрока.ДатаСмерти = Дата(1,1,1) Тогда
		Сообщить("Дата смерти клиента " + Формат(ТекСтрока.ДатаСмерти, "ДФ=dd.MM.yyyy") + ". Выбор не возможен.");
		Возврат;
	КонецЕсли; 
	
    // ++ Сербаев 20.06.2023
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") Тогда
	    ДатаРожденияЗалогодателя = ВычислитьВозраст(ТекСтрока.ДатаРождения);
		Если ДатаРожденияЗалогодателя < 18 Тогда
		    ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Клиенту %1 %2, выдача займа несовершеннолетним клиентам не осуществляется.", 
			    ДатаРожденияЗалогодателя, ЛБ_ОбщегоНазначения.ОписаниеВозраста(ДатаРожденияЗалогодателя)));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда
	    ДатаРожденияЗалогодателя = ВычислитьВозраст(ТекСтрока.ДатаРождения);
		Если ДатаРожденияЗалогодателя < 18 Тогда
		    ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Клиенту %1 %2, оплата от несовершеннолетних клиентов не принимается.", 
			    ДатаРожденияЗалогодателя, ЛБ_ОбщегоНазначения.ОписаниеВозраста(ДатаРожденияЗалогодателя)));
			Возврат;
		КонецЕсли;
	КонецЕсли;
    // -- Сербаев 20.06.2023
	
	СтруктураВозврата = Новый Структура("Залогодатель, ДокументЗалогодателя");
	СтруктураВозврата.Вставить("Залогодатель", ТекСтрока.Залогодатель);
	СтруктураВозврата.Вставить("ДатаРождения", ТекСтрока.ДатаРождения);
	
	Если БезДокументов Тогда  
		Этаформа.Закрыть(СтруктураВозврата);
		Возврат;
	КонецЕсли;	
	
	//ТекСтрокаДокументы = Элементы.ДокументыЗалогодателей.ТекущиеДанные;
	//Если НЕ ТекСтрокаДокументы = неопределено Тогда 
	//	Если ТекСтрокаДокументы.ПроверкаНеДействителен тогда 
	//		Сообщить("Документ удостоверяющий личность клиента не действителен!", СтатусСообщения.Информация);
	//		Возврат;
	//	КонецЕсли;	
	//	
	//	Если НЕ ПроверитьПоПеречнюНедружественныхСтран(ТекСтрокаДокументы.Гражданство) Тогда
	//	    СтруктураВозврата.Вставить("ДокументЗалогодателя", ТекСтрокаДокументы.ДокументЗалогодателя);
	//	Иначе
	//		Сообщить("Клиент предъявил документ государства не дружественного по отношению к России. Выдача ссуды по этому документу не возможна.");
	//		Возврат;
	//	КонецЕсли;	 
	//Иначе               
		Отбор = Новый Структура; 
		Отбор.Вставить("Залогодатель", ТекСтрока.Залогодатель);
		Отбор.Вставить("ОсновнойДУЛ", Истина); 		
		Отбор.Вставить("Гражданство", ТекСтрока.Гражданство); 
		
		ВсеОК = Истина;
		СтрокиДУЛ = ДокументыЗалогодателей.НайтиСтроки(Отбор);
		Если НЕ СтрокиДУЛ.Количество() = 0 Тогда 
			ЕстьДокумент = ложь;
			СтрокаДУЛ = СтрокиДУЛ.Получить(0); 
			Если НЕ СтрокаДУЛ.ПроверкаНеДействителен тогда
				Если НЕ СтрокаДУЛ.Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
					Если НЕ ПроверитьПоПеречнюНедружественныхСтран(СтрокаДУЛ.Гражданство) Тогда
					    СтруктураВозврата.Вставить("ДокументЗалогодателя", СтрокаДУЛ.ДокументЗалогодателя); 
						ЕстьДокумент = Истина; 
					Иначе
						Сообщить("Клиент предъявил документ государства не дружественного по отношению к России. Выдача ссуды по этому документу не возможна.");						
					КонецЕсли;  
				Иначе     
					СтруктураВозврата.Вставить("ДокументЗалогодателя", СтрокаДУЛ.ДокументЗалогодателя); 
				    ЕстьДокумент = Истина;	
				КонецЕсли;    
			КонецЕсли;	
			Если НЕ ЕстьДокумент Тогда
				Сообщить("Основной документ удостоверяющий личность клиента по которому возможна выдача займа не найден!", СтатусСообщения.Информация);
		        ВсеОК = ложь;
			КонецЕсли;	
		Иначе
			Сообщить("Основной документ удостоверяющий личность клиента по которому возможна выдача займа не найден!", СтатусСообщения.Информация);
		    ВсеОК = ложь;
		КонецЕсли;
	//КонецЕсли;	
	
	Если ЗначениеЗаполнено(ВидОперации) И НЕ ТекСтрока.Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда 
		Если НЕ ПроверитьДокументыПравоПребыванияРФ(ТекСтрока.Залогодатель, ТекСтрока.Гражданство) Тогда
			Сообщить("Не найдены основные документы, подверждающие право клиента на пребывание В РФ!", СтатусСообщения.Информация);
			ВсеОК = ложь;
		КонецЕсли;	
	КонецЕсли;	        
	
	//Если ВсеОК Тогда
	//    Этаформа.Закрыть(СтруктураВозврата); 
	//Иначе     
	//	ЗадатьВопросОткрытьКарточку();
	//КонецЕсли;
	
	//+МАН 16.10.25 Добавлена проверка по перечням
	Если ЗначениеЗаполнено(ВидОперации) И ТекСтрока <> Неопределено Тогда
		ЕстьСовпадение = ПроверитьКлиента(ТекСтрока.Залогодатель);
		Если ЕстьСовпадение Тогда
			ВсеОК = Ложь;
		КонецЕсли;
	КонецЕсли;
	//-МАН
	
	//lion 12.08.2025
	//Доходим до этого момента, что б вышли все сообщения об ошибка для профилактики
	Если Не Этаформа.ЗакрыватьПриВыборе тогда
        ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
		Если ТекущаяСтрока<>Неопределено тогда
			//ОткрытьЗначение(ТекущаяСтрока.Залогодатель);
			ИзменитьЗалогодателя("");
		КонецЕсли;
	ИначеЕсли ВсеОК Тогда
	    Этаформа.Закрыть(СтруктураВозврата); 
	Иначе     
		ЗадатьВопросОткрытьКарточку();
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Функция ПроверитьКлиента(Залогодатель)
	СтруктураПроверки = ЛБ_ОбщегоНазначения.ПроверитьКлиентаПоПеречням(Залогодатель);

	Возврат СтруктураПроверки.Совпадение;
	
	//Возврат ЛБ_ОбщегоНазначения.ПроверитьКлиентаПоПеречням(Залогодатель);
КонецФункции

&НаКлиенте
Процедура ЗадатьВопросОткрытьКарточку()
    Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", Этаформа); 
    ПоказатьВопрос(Оповещение, "Открыть карточку клиента?", РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Да);
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Результат, Параметры) Экспорт 
	Если Результат = КодВозвратаДиалога.Да Тогда
        ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;  
		Если ТекущаяСтрока = неопределено Тогда
			Возврат;
		КонецЕсли;
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеИзмененияЗалогодателя",ЭтаФорма);
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", ТекущаяСтрока.Залогодатель);
		ПараметрыФормы.Вставить("ПричинаИзменения", ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИсправлениеДанныхКонтактнаяИнформация")); 
		ПараметрыФормы.Вставить("ЗакрыватьПриСохранении", Истина);
		ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьДокументыПравоПребыванияРФ(Клиент, ГражданствоКлиента)
	ЕстьДопДокумент = Ложь;
	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("Дата", ДатаДок); 
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Гражданство", ГражданствоКлиента);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ДокументНеДействителен,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Клиент
	               |				И Гражданство = &Гражданство
	               |				И ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ)
	               |				И ОсновнойДоп = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		Если Выборка.ДокументНЕДействителен Тогда
			Продолжить;
		КонецЕсли;	
		Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(ГражданствоКлиента, Выборка.ВидДокументаЗалогодателя, Выборка.ВидДокумента) Тогда
			Если Выборка.ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
				Продолжить;
			КонецЕсли;	
            ЕстьДопДокумент = Истина;
			Прервать;
		Иначе	
			ЕстьДопДокумент = Истина;
			Прервать;
		КонецЕсли;	
	Конеццикла;	  
	Возврат ЕстьДопДокумент;
КонецФункции

&НаКлиенте
Процедура ГражданствоПриИзменении(Элемент)
	//очистим документы с другим гражданством
	Если ЗначениеЗаполнено(Гражданство) Тогда
		УдСтроки = Новый СписокЗначений;
		Для каждого Стр Из ДокументыЗалогодателей Цикл
			Если НЕ Стр.Гражданство = Гражданство Тогда
				УдСтроки.Добавить(Стр);
			КонецЕсли;	
		КонецЦикла;	
		Для каждого Эл Из УдСтроки Цикл
			ДокументыЗалогодателей.Удалить(эл.Значение);
		КонецЦикла;	
		ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
		Если НЕ ТекущаяСтрока = неопределено Тогда
		    ПерезаполнитьИнформациюПоДокументамЗалогодателя(ТекущаяСтрока.Залогодатель);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьИнформациюПоДокументамЗалогодателя(Залогодатель)
	ДокументыЗалогодателей.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец КАК Залогодатель,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ КАК ОсновнойДУЛ,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ПроверкаНеДействителен
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Залогодатель
	               |				И ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Гражданство) И НЕ (Гражданство = Выборка.Гражданство) Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтр = ДокументыЗалогодателей.Добавить();
		НоваяСтр.Залогодатель = Выборка.Залогодатель;
		НоваяСтр.ВидДокумента = Выборка.ВидДокумента;
		НоваяСтр.ВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя;	//+++ Моисеев 20250603 почему этого не было?!
		НоваяСтр.ДокументЗалогодателя = Выборка.ДокументЗалогодателя;
		НоваяСтр.Серия = Выборка.Серия;
		НоваяСтр.Номер = Выборка.Номер;
		НоваяСтр.Гражданство = Выборка.Гражданство;
		НоваяСтр.ОсновнойДУЛ = Выборка.ОсновнойДУЛ; 
		НоваяСтр.ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи; 
		НоваяСтр.ДокументСрокДействия = Выборка.ДокументСрокДействия;
		НоваяСтр.ПроверкаНеДействителен = Выборка.ПроверкаНеДействителен;
	КонецЦикла;	   
	ПроверитьДействительностьДокументов();
	ДокументыЗалогодателей.Сортировать("ОсновнойДУЛ УБЫВ");
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеИзмененияЗалогодателя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	Если НаТекущуюДату Тогда
	    ДатаДок = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;	
	ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные; 
	Если ТекущаяСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	 
	
	//проверим снятие блокировки с конт. информации клиента
	Пока Истина Цикл
		Если НЕ ПроверитьБлокировкуКлиента(Результат.Залогодатель) Тогда    
			ДатаДок = ОбщегоНазначенияКлиент.ДатаСеанса();
			Прервать;
		КонецЕсли;	
	Конеццикла;

	ТекущаяСтрока.Залогодатель = Результат.Залогодатель;
	ТекущаяСтрока.НомерТелефона = Результат.НомерТелефона; 
	ТекущаяСтрока.ДатаРождения = Результат.ДатаРождения;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Залогодатель", ТекущаяСтрока.Залогодатель);
	
	Строки = ДокументыЗалогодателей.НайтиСтроки(Отбор);
	Для каждого Стр Из Строки Цикл
		ДокументыЗалогодателей.Удалить(Стр);
	КонецЦикла;	

	ПерезаполнитьИнформациюПоДокументамЗалогодателя(ТекущаяСтрока.Залогодатель);
	
	Элементы.ДокументыЗалогодателей.ОтборСтрок = Новый ФиксированнаяСтруктура("Залогодатель", ТекущаяСтрока.Залогодатель);	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗалогодателя(Команда)
	ТекущаяСтрока = Элементы.Залогодатели.ТекущиеДанные;
	Если ТекущаяСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеИзмененияЗалогодателя",ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Залогодатель", ТекущаяСтрока.Залогодатель);
	ПараметрыФормы.Вставить("ПричинаИзменения", ПредопределенноеЗначение("Справочник.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ИсправлениеДанныхКонтактнаяИнформация")); 
	ПараметрыФормы.Вставить("ЗакрыватьПриСохранении", Истина);
	ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

