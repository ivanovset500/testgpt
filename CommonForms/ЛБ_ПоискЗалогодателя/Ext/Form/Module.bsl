&НаСервереБезКонтекста
Функция ОбрезатьПробелыСпецсимволы(ИсходнаяСтрока)
	Результат = СтрЗаменить(ИсходнаяСтрока, " ", "");
	Результат = СтрЗаменить(Результат, ",", "");
	Результат = СтрЗаменить(Результат, ".", "");
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, "\", "");
	Возврат Результат;
КонецФункции
&НаСервере
//в случае заполнения при редактировании фамилии/имени/отчества/телефона новое значение ещё не успело быть помещено в переменную, поэтому передаём параметром...
Процедура КомандаПоискНовыйНаСервере(ИмяРедактируемогоРеквизита = Неопределено, ТекстРедактируемогоРеквизита = Неопределено)
	имяГруппаОтбора = "Группа" + текущаяГруппаОтбора;
	
	Если имяГруппаОтбора = "ГруппаОтборФИО_ДР" И Не ИмяРедактируемогоРеквизита = Неопределено Тогда
		//проверка заполнения при вводе текста в полях отбора
		Если (Не ЗначениеЗаполнено(ОтборФамилия)
				И Не (ЗначениеЗаполнено(ОтборИмя) И ЗначениеЗаполнено(ОтборОтчество) И ЗначениеЗаполнено(ОтборДР))) Тогда
			//недостаточно отборов для заполнения
			Возврат;
		КонецЕсли;
	КонецЕсли;	
		
	//Залогодатели.ПолучитьЭлементы().Очистить();
	Залогодатели.Очистить();
	ДокументыЗалогодателей.Очистить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЛБ_Залогодатели.Ссылка КАК Залогодатель,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ВЫБОР
	               |		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА -1
	               |		КОГДА МЕСЯЦ(&ДатаДокумента) < МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД) - 1
	               |		КОГДА МЕСЯЦ(&ДатаДокумента) > МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД)
	               |		КОГДА МЕСЯЦ(&ДатаДокумента) = МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ДЕНЬ(&ДатаДокумента) < ДЕНЬ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |						ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД) - 1
	               |					КОГДА ДЕНЬ(&ДатаДокумента) >= ДЕНЬ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |						ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД)
	               |				КОНЕЦ
	               |	КОНЕЦ КАК ЗалогодательВозраст,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ДокументЗалогодателяВид,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументЗалогодателяСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументЗалогодателяНомер,
				   |	(ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ
				   |		ИЛИ ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДоп) КАК ДУЛ_Основной,
				   |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ДокументНеДействителен,
				   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
				   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК НомерТелефона,
				   |	ЕСТЬNULL(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых.ОтветственныйЛомбард.НомерЛомбарда, """") КАК ОтветственныйЛомбард
	               |ИЗ
	               |	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&ДатаДокумента, ) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |		ПО (ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец = ЛБ_Залогодатели.Ссылка)
				   |				И ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&ДатаДокумента, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	               |		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПервых КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых
					|		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПервых.Залогодатель = ЛБ_Залогодатели.Ссылка)
	               |ГДЕ
                   |	Истина
				   |	//Отборы
				   |УПОРЯДОЧИТЬ ПО
				   |	ЛБ_Залогодатели.Наименование,
				   |	ДУЛ_Основной УБЫВ";
				   //|	(&флБезОтбораПоФИО
				   //|			ИЛИ ЛБ_Залогодатели.Имя ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Имя + &ДопСимволПоискаПоФИО
				   //|				И ЛБ_Залогодатели.Фамилия ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Фамилия + &ДопСимволПоискаПоФИО
				   //|				И ЛБ_Залогодатели.Отчество ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Отчество + &ДопСимволПоискаПоФИО)";
	Если имяГруппаОтбора = "ГруппаОтборНомерЗБ" Тогда 
		ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЛБ_ОперацияПоЗалогу.Залогодатель КАК Залогодатель
		               |ПОМЕСТИТЬ ВТ_Залогодатели
		               |ИЗ
		               |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
		               |ГДЕ
		               |	ЛБ_ОперацияПоЗалогу.НомерЗалоговогоБилета = &ОтборНомерЗалоговогоБилета
					   |	И (ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
					   |				ИЛИ ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление))
					   |;
					   |" + ТекстЗапроса;
		Запрос.УстановитьПараметр("ОтборНомерЗалоговогоБилета", ОбрезатьПробелыСпецсимволы(ОтборНомерЗБ));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//Отборы", "И ЛБ_Залогодатели.Ссылка В (выбрать ВТ_Залогодатели.Залогодатель ИЗ ВТ_Залогодатели)");
	ИначеЕсли имяГруппаОтбора = "ГруппаОтборФИО_ДР" Тогда
		дополнительныйТекстОтбора = "";

		Если ЗначениеЗаполнено(ОтборИмя) Тогда 
			дополнительныйТекстОтбора = дополнительныйТекстОтбора + "
			|			И (ЛБ_Залогодатели.Имя ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Имя + ""%"" + &ДопСимволПоискаПоФИО)";
			Запрос.УстановитьПараметр("Имя", ОбрезатьПробелыСпецсимволы(ОтборИмя));	//СтрЗаменить(ОтборИмя, "%", "ЫЫЫ"));
		КонецЕсли;

		Если ЗначениеЗаполнено(ОтборФамилия) Тогда 
			дополнительныйТекстОтбора = дополнительныйТекстОтбора + "
			|			И (ЛБ_Залогодатели.Фамилия ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Фамилия + ""%"" + &ДопСимволПоискаПоФИО)";
			Запрос.УстановитьПараметр("Фамилия", ОбрезатьПробелыСпецсимволы(ОтборФамилия));	//СтрЗаменить(ОтборФамилия, "%", "ЫЫЫ"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтборОтчество) Тогда 
			дополнительныйТекстОтбора = дополнительныйТекстОтбора + "
			|			И (ЛБ_Залогодатели.Отчество ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Отчество + ""%"" + &ДопСимволПоискаПоФИО)";
			Запрос.УстановитьПараметр("Отчество", ОбрезатьПробелыСпецсимволы(ОтборОтчество));	//СтрЗаменить(ОтборОтчество, "%", "ЫЫЫ"));
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборДР) Тогда 
			дополнительныйТекстОтбора = дополнительныйТекстОтбора + "
			|			И (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения = &ОтборДР)";
			Запрос.УстановитьПараметр("ОтборДР", ОтборДР);	//СтрЗаменить(ОтборИмя, "%", "ЫЫЫ"));
		КонецЕсли;
			
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//Отборы", дополнительныйТекстОтбора);
				   //|			И (ЛБ_Залогодатели.Имя ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Имя + &ДопСимволПоискаПоФИО
				   //|				И ЛБ_Залогодатели.Фамилия ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Фамилия + &ДопСимволПоискаПоФИО
				   //|				И ЛБ_Залогодатели.Отчество ПОДОБНО """" + &ДопСимволПоискаПоФИО + &Отчество + &ДопСимволПоискаПоФИО)");
		//Запрос.УстановитьПараметр("Фамилия", ЭтаФорма.ОтборФамилия);
		//Запрос.УстановитьПараметр("Отчество", ЭтаФорма.ОтборОтчество);
		Запрос.УстановитьПараметр("ДопСимволПоискаПоФИО", "");	//Там "" или "%"
		
	ИначеЕсли имяГруппаОтбора = "ГруппаОтборДокументУдостоверяющийЛичность" Тогда
		дополнительныйТекстОтбора = "И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер ПОДОБНО """" + &ОтборНомерДокумента + ""%""";
		Запрос.УстановитьПараметр("ОтборНомерДокумента", ОбрезатьПробелыСпецсимволы(ОтборНомерДокумента));
		Если ЗначениеЗаполнено(ОтборСерияДокумента) Тогда 
			дополнительныйТекстОтбора = дополнительныйТекстОтбора + "
			|	И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия ПОДОБНО """" + &ОтборДокументСерия + ""%""";
			Запрос.УстановитьПараметр("ОтборДокументСерия", ОбрезатьПробелыСпецсимволы(ОтборСерияДокумента));
		КонецЕсли;

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//Отборы", дополнительныйТекстОтбора);
	ИначеЕсли имяГруппаОтбора = "ГруппаОтборНомерТелефона" Тогда 
		дополнительныйТекстОтбора = "И ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон ПОДОБНО """" + &НомерТелефона + ""%""";
		Запрос.УстановитьПараметр("НомерТелефона", СокрЛП(ОтборНомерТелефона));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//Отборы", дополнительныйТекстОтбора);
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаДокумента", ТекущаяДата());
	
	//номер ломбарда, где была создана карточка, ищем запросом для каждого залогодателя
	//из-за необходимости получить первый по дате документ так проще и ненамного дольше... 
	ЗапросНомерЛомбардаГдеСозданаКарточкаЗалогодателя = Новый Запрос;
	ЗапросНомерЛомбардаГдеСозданаКарточкаЗалогодателя.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                                              |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка,
	                                              |	ЛБ_ОперацияПоЗалогу.Дата КАК Дата,
	                                              |	ЛБ_ОперацияПоЗалогу.Залогодатель КАК Залогодатель,
	                                              |	ЛБ_ОперацияПоЗалогу.Ломбард.НомерЛомбарда КАК НомерЛомбарда
	                                              |ИЗ
	                                              |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	                                              |ГДЕ
	                                              |	ЛБ_ОперацияПоЗалогу.Залогодатель = &Залогодатель
	                                              |
	                                              |УПОРЯДОЧИТЬ ПО
	                                              |	Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Запрос.Выполнить().Выгрузить();
	текПользователь = Пользователи.ТекущийПользователь();
	Если текПользователь.ЭтоЛомбард Тогда 
		номерТекущегоЛомбарда = текПользователь.Наименование;
	Иначе
		номерТекущегоЛомбарда = "6"; //как получать?.. (если вход не под ломбардом, а непосредственно)
	КонецЕсли;
	количествоКлиентовСвоегоЛомбарда = 0; //для сохранения порядка при вставке строк...
	Если Результат.Количество() = 0 Тогда 
		текстСообщения = "Клиент по ";
		Если имяГруппаОтбора = "ГруппаОтборНомерЗБ" Тогда
			текстСообщения = текстСообщения + "номеру залогового билета ";
		ИначеЕсли имяГруппаОтбора = "ГруппаОтборФИО_ДР" Тогда 
			текстСообщения = текстСообщения + "ФИО и дате рождения ";
		ИначеЕсли имяГруппаОтбора = "ГруппаОтборДокументУдостоверяющийЛичность" Тогда		
			текстСообщения = текстСообщения + "документу, удостоверяющему личность ";
		ИначеЕсли имяГруппаОтбора = "ГруппаОтборНомерТелефона" Тогда 
			текстСообщения = текстСообщения + "номеру телефона ";
		Иначе
			текстСообщения = текстСообщения + "неизвестным причинам ";
		КонецЕсли;
		текстСообщения = текстСообщения + "не найден.";
		ОбщегоНазначения.СообщитьПользователю(текстСообщения);
	КонецЕсли;
	
	флЭтоПерваяСтрокаДУЛ = Истина;
	текЗалогодатель = Неопределено;
	//Пока Выборка.Следующий() Цикл
	Для Каждого стрРезультат из Результат Цикл
		Если стрРезультат.Залогодатель = текЗалогодатель Тогда
			//это не первая строка ДУЛ для этого залогодателя, выводим подчиненной строкой...
			//пока не выводим, ДУЛ уже в отдельной таблице
			//новСтр = новСтр.ПолучитьЭлементы().Добавить(); 
		Иначе
			текОтветственныйЛомбард = "";
			Если ЗначениеЗаполнено(стрРезультат.ОтветственныйЛомбард) Тогда
				текОтветственныйЛомбард = стрРезультат.ОтветственныйЛомбард;
			Иначе
				ЗапросНомерЛомбардаГдеСозданаКарточкаЗалогодателя.УстановитьПараметр("Залогодатель", стрРезультат.Залогодатель);
				ВыборкаНомерЛомбардаГдеСозданаКарточкаЗалогодателя = ЗапросНомерЛомбардаГдеСозданаКарточкаЗалогодателя.Выполнить().Выбрать();
				Если ВыборкаНомерЛомбардаГдеСозданаКарточкаЗалогодателя.Следующий() Тогда 
					текОтветственныйЛомбард = ВыборкаНомерЛомбардаГдеСозданаКарточкаЗалогодателя.НомерЛомбарда;
				КонецЕсли;
			КонецЕсли;
			//Если ВыборкаНомерЛомбардаГдеСозданаКарточкаЗалогодателя.НомерЛомбарда = номерТекущегоЛомбарда Тогда 
			Если текОтветственныйЛомбард = номерТекущегоЛомбарда Тогда 
				новСтр = Залогодатели.Вставить(количествоКлиентовСвоегоЛомбарда); //добавляем новую строку в начало ТЗ
				количествоКлиентовСвоегоЛомбарда = количествоКлиентовСвоегоЛомбарда + 1;
			Иначе
				новСтр = Залогодатели.Добавить(); //добавляем новую строку в конец ТЗ
			КонецЕсли;
			новСтр.ЗалогодательНомерЛомбардаГдеСозданаКарточка = текОтветственныйЛомбард;	//ВыборкаНомерЛомбардаГдеСозданаКарточкаЗалогодателя.НомерЛомбарда;
			текЗалогодатель = стрРезультат.Залогодатель;
		    
			ЗаполнитьЗначенияСвойств(новСтр, стрРезультат);
		КонецЕсли;
	КонецЦикла;
	Если Залогодатели.Количество() > 0 Тогда 
		//ПерезаполнитьИнформациюПоДокументамЗалогодателя(Залогодатели[0].Залогодатель);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоискНовый(Команда)
	Если ТекущийЭлемент.Родитель.Имя = "ГруппаОтборНомерЗБ" Тогда
		Если Не ЗначениеЗаполнено(ОтборНомерЗБ) Или (Не СтрДлина(СокрЛП(ОтборНомерЗБ)) = 7) Тогда
			Сообщить("Номер ЗБ для отбора должен быть из 7 цифр.");
			Возврат;
		КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Родитель.Имя = "ГруппаОтборФИО_ДР" Тогда
		Если Не ЗначениеЗаполнено(ОтборФамилия) Тогда
			Если Не (ЗначениеЗаполнено(ОтборИмя)
					И ЗначениеЗаполнено(ОтборОтчество)
					И ЗначениеЗаполнено(ОтборДР)) Тогда
				Сообщить("Недостаточно данных отбора.");
				Возврат;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Родитель.Имя = "ГруппаОтборДокументУдостоверяющийЛичность"	Тогда
		Если Не ЗначениеЗаполнено(ОтборНомерДокумента) Тогда 
			Сообщить("Для отбора по документу, удостоверяющему личность, укажите, как минимум, номер документа.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	КомандаПоискНовыйНаСервере();//ЭтаФорма.ТекущийЭлемент.Родитель.Имя);
	
КонецПроцедуры

&НаСервере
