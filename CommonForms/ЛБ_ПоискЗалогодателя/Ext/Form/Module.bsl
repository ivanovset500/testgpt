&НаКлиенте
Процедура ОтборНомерТелефонаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	//Залогодатели.ПолучитьЭлементы().Очистить();
	Залогодатели.Очистить();
	ДокументыЗалогодателей.Очистить();
	Если СокрЛП(Текст) = "+7 (   )" Тогда
		Возврат;
	КонецЕсли;	
	СтандартнаяОбработка = ложь; 
	ПерваяЦифра = Сред(Текст, 5, 1);
	Если НЕ Перваяцифра = "9" Тогда 
		ЭтотОбъект.ОтборНомерТелефона = Сред(Текст, 1, 4) + "9" + Сред(Текст, 6);
//		Элемент.ТекстРедактирования = Сред(Элемент.ТекстРедактирования, 1, 4) + "9" + Сред(Элемент.ТекстРедактирования, 6);
		ТекстСообщения = "Телефон должен начинаться с 9 и содержать 10 цифр"; 
		Предупреждение(ТекстСообщения, 10);
		Возврат;
	КонецЕсли;
	Если СтрДлина(СокрЛП(Текст)) = 16 тогда
		ПолеОтбораИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка);
		Элементы.ОтборНомерТелефона.ЦветФона = WebЦвета.БледноЗеленый;
	Иначе 
		Элементы.ОтборНомерТелефона.ЦветФона = WebЦвета.СветлоРозовый;
	КонецЕсли;
КонецПроцедуры

