&НаКлиенте
Процедура ВесВручнуюПриИзменении(Элемент)
	ПолучитьСпособРасчетаВеса();
	УстановитьДоступность();
	Если НЕ ВесВручную Тогда  
		Если СпособРасчетаВеса = ПредопределенноеЗначение("Перечисление.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоТаблице") Тогда
			РассчитатьВесКамняПоТаблице();
		ИначеЕсли СпособРасчетаВеса = ПредопределенноеЗначение("Перечисление.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоФормуле") Тогда
			РассчитатьВесКамняПоФормуле();	
		КонецЕсли;	
	//+Мельников 25.07.24 Если вес вручную то размеры не видно. Заявка 2737
		Элементы.ГруппаРазмеры.Доступность = Истина;
	Иначе
		Элементы.ГруппаРазмеры.Доступность = Ложь;
	//-Мельников
	КонецЕсли;    	   

	//+Мельников 25.07.24 Если вес вручную и категория 3 или 4 то доступен ввод общего веса в каратах. Заявка 2737
	Если ВесВручную И ПолучитьКачество(КатегорияОбъектаЗалога) Тогда
		Элементы.Вес.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Вес.ТолькоПросмотр = Истина;
	КонецЕсли;
	//-Мельников
КонецПроцедуры

