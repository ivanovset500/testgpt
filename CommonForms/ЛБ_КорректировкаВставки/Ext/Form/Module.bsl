&НаСервере
Процедура ПроверитьФормуОгранки() 
	Элементы.ФормаОгранки.СписокВыбора.Очистить();
		
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ВидКамня", ВидВставки);     
	Элементы.ФормаОгранки.СписокВыбора.Очистить();
	Запрос.УстановитьПараметр("КатегорияОбъектаЗалога", КатегорияОбъектаЗалога);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаДопустимыхФормОгранки.ФормаОгранки КАК ФормаОгранки
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаДопустимыхФормОгранки КАК ЛБ_НастройкаДопустимыхФормОгранки
	               |ГДЕ
	               |	ЛБ_НастройкаДопустимыхФормОгранки.ВидКамня = &ВидКамня
	               |	И ЛБ_НастройкаДопустимыхФормОгранки.КатегорияОбъектаЗалога = &КатегорияОбъектаЗалога";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Количество() = 0 Тогда
		Пока Выборка.Следующий() Цикл    
			Элементы.ФормаОгранки.СписокВыбора.Добавить(Выборка.ФормаОгранки);
		КонецЦикла;	
	Иначе
		ВыборкаФО = Справочники.ЛБ_ФормыОгранки.Выбрать(,ВидВставки);   
		Пока ВыборкаФО.Следующий() Цикл
			Элементы.ФормаОгранки.СписокВыбора.Добавить(ВыборкаФО.Ссылка);
		КонеЦцикла;
	КонецЕсли;   
	Если НЕ Элементы.ФормаОгранки.СписокВыбора.Количество() = 0 Тогда 
		//+Мельников 18.06.24 При редактировании не верно отображаются данные редактируемой позиции
		//Было: ФормаОгранки = Элементы.ФормаОгранки.СписокВыбора.Получить(0).Значение;
		Если Параметры.Свойство("ФормаОгранки") И ЗначениеЗаполнено(Параметры.ФормаОгранки) Тогда
			ФормаОгранки = Параметры.ФормаОгранки;
		Иначе
			ФормаОгранки = Элементы.ФормаОгранки.СписокВыбора.Получить(0).Значение;
		КонецЕсли;
		//-Мельников
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьСписокВыбораКачестваОгранки() 
	Элементы.КачествоОгранки.СписокВыбора.Очистить();

	Если ВидВставки = Справочники.ЛБ_ДрагоценныеКамни.Бриллиант Тогда 
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("ВидКамня", ВидВставки); 
		Запрос.УстановитьПараметр("КатегорияОбъектаЗалога", КатегорияОбъектаЗалога);
		Запрос.УстановитьПараметр("Именник", Именник); 
		СписокФО = Новый СписокЗначений;
		СписокФО.Добавить(Справочники.ЛБ_ФормыОгранки.ПустаяСсылка());
		Если ЗначениеЗаполнено(ФормаОгранки) Тогда
			СписокФО.Добавить(ФормаОгранки);
		КонецЕсли;	
		Запрос.УстановитьПараметр("ФормыОгранки", СписокФО); 
		СписокВО = Новый СписокЗначений;
		СписокВО.Добавить(Справочники.ЛБ_ВидыОгранки.ПустаяСсылка());
		Если ЗначениеЗаполнено(ВидОгранки) Тогда
			СписокВО.Добавить(ВидОгранки);
		КонецЕсли;	
        Запрос.УстановитьПараметр("ВидыОгранки", СписокВО);
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	ЛБ_НастройкаДопустимыхКачествОгранки.КачествоОгранки КАК КачествоОгранки
	                   |ИЗ
	                   |	РегистрСведений.ЛБ_НастройкаДопустимыхКачествОгранки КАК ЛБ_НастройкаДопустимыхКачествОгранки
	                   |ГДЕ
	                   |	ЛБ_НастройкаДопустимыхКачествОгранки.ВидКамня = &ВидКамня
	                   |	И ЛБ_НастройкаДопустимыхКачествОгранки.КатегорияОбъектаЗалога = &КатегорияОбъектаЗалога
	                   |	И ЛБ_НастройкаДопустимыхКачествОгранки.ФормаОгранки В(&ФормыОгранки)
	                   |	И ЛБ_НастройкаДопустимыхКачествОгранки.ВидОгранки В(&ВидыОгранки)";
	                  // |	И ЛБ_НастройкаДопустимыхКачествОгранки.Именник = &Именник"; 
		 Выборка = Запрос.Выполнить().Выбрать();
		 Пока Выборка.Следующий() Цикл 
			 Элементы.КачествоОгранки.СписокВыбора.Добавить(Выборка.КачествоОгранки);
		 Конеццикла;
		 //+Мельников 18.06.24 При редактировании не верно отображаются данные редактируемой позиции
		 Если Параметры.Свойство("КачествоОгранки") И ЗначениеЗаполнено(Параметры.КачествоОгранки) Тогда
			 КачествоОгранки = Параметры.КачествоОгранки;
		 КонецЕсли;
		 //-Мельников
	 Иначе    
		 Запрос = Новый Запрос;
		 Запрос.УстановитьПараметр("Владелец", ВидВставки);
		 Запрос.Текст = "ВЫБРАТЬ
		                |	ЛБ_КачествоОгранки.Ссылка КАК КачествоОгранки
						|ИЗ
		                |	Справочник.ЛБ_КачествоОгранки КАК ЛБ_КачествоОгранки
		                |ГДЕ
		                |	ЛБ_КачествоОгранки.Владелец = &Владелец
		                |	И ЛБ_КачествоОгранки.ПометкаУдаления = ЛОЖЬ";
		 Выборка = Запрос.Выполнить().Выбрать();
		 Пока Выборка.Следующий() Цикл 
			 Элементы.КачествоОгранки.СписокВыбора.Добавить(Выборка.КачествоОгранки);
		 Конеццикла;
	 КонецЕсли;	 
КонецПроцедуры	                                                          

&НаСервере
Функция УдалитьНули(Текст)
	Текст = СокрЛП(Текст);
	Пока Прав(Текст, 1) = "0" цикл
		Текст = Лев(Текст, стрДлина(Текст) - 1);
	Конеццикла;	
	Возврат Текст;
КонецФункции	

&НаКлиенте
Функция СформироватьСтрокуРазмер() 
	ОписаниеРазмера = "";  
	ОписаниеРазмера = ОписаниеРазмера + ?(Диаметр = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "х") + УдалитьНули(Строка(Диаметр))); 
	ОписаниеРазмера = ОписаниеРазмера + ?(Диаметр1 = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "х") + УдалитьНули(Строка(Диаметр1)));
	ОписаниеРазмера = ОписаниеРазмера + ?(Диаметр2 = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "х") + УдалитьНули(Строка(Диаметр2)));
	ОписаниеРазмера = ОписаниеРазмера + ?(Длина = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "х") + УдалитьНули(Строка(Длина)));
	ОписаниеРазмера = ОписаниеРазмера + ?(Ширина1 = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "х") + УдалитьНули(Строка(Ширина1)));
	ОписаниеРазмера = ОписаниеРазмера + ?(Высота1 = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "хh") + УдалитьНули(Строка(Высота1))); 
	ОписаниеРазмера = ОписаниеРазмера + ?(Сторона = 0, "", ?(ПустаяСтрока(ОписаниеРазмера), "", "х") + УдалитьНули(Строка(Сторона)));
	Возврат ОписаниеРазмера; 
КонецФункции

Функция Проверить()
	ВсеОК = Истина;   
	Если НЕ ЗначениеЗаполнено(ВидВставки) тогда   
		Сообщить("Не выбран вид вставки");
		ВсеОК = ложь;
	КонецЕсли; 
	Если Количество = 0 тогда   
		Сообщить("Не задано количество");
		ВсеОК = ложь;
	КонецЕсли;  
	//+Мельников Отображение сообщения для вида огранки. Добавлена проверка на бриллиант. Заявка 2736
	//Если ВесГраммы = 0 И ВидВставки = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") тогда   
	//	Сообщить("Не задан вес в каратах");
	//	ВсеОК = ложь;
	//КонецЕсли; 
	//Если ВесГраммы = 0 И ВидВставки = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") тогда   
	//	Сообщить("Не задан вес в граммах");
	//	ВсеОК = ложь;
	//КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ВидОгранки) И ВидВставки <> ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") Тогда
		Сообщить("Для расчета веса необходимо выбрать ""Вид огранки"".");
		ВсеОК = Ложь;
	КонецЕсли;

	//+Мельников 21.08.24 Изменена проверка заполнения элементов и вывод соответствующего сообщения. Заявка 2736
	//+Мельников 07.10.24 Изменения. Заявка 2736
	Если (ВидВставки = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И ВесШт = 0)
		ИЛИ ВидВставки <> ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И ВесГраммыШт = 0 Тогда
		//Было: (НЕ ВесВручную И ((Элементы.ГруппаД0.Видимость И Диаметр = 0) ИЛИ (Элементы.ГруппаД1.Видимость И Диаметр1 = 0)
		//ИЛИ (Элементы.ГруппаД2.Видимость И Диаметр2 = 0) ИЛИ (Элементы.ГруппаД.Видимость И Длина = 0)
		//ИЛИ (Элементы.ГруппаШ.Видимость И Ширина1 = 0) ИЛИ (Элементы.ГруппаВ.Видимость И Высота1 = 0)
		//ИЛИ (Элементы.ГруппаС.Видимость И Сторона = 0))) 
		//ИЛИ (ВесВручную И ВидВставки = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И ВесШт = 0)
		//ИЛИ (ВесВручную И ВидВставки <> ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И ВесГраммыШт = 0) Тогда
		
		Сообщить("Необходимо внести размеры вставки или указать вес вручную.");
		ВсеОК = Ложь;
	КонецЕсли;
	//-Мельников
	Возврат ВсеОК;
КонецФункции

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	Если НЕ Проверить() Тогда
		Возврат;
	КонецЕсли;
	СтруктураВозврата = Новый структура;   
	СтруктураВозврата.Вставить("ВесВручную", ВесВручную);
	СтруктураВозврата.Вставить("Количество", Количество); 
	СтруктураВозврата.Вставить("ВидВставки", ВидВставки);
	СтруктураВозврата.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	СтруктураВозврата.Вставить("ФормаОгранки", ФормаОгранки);
	СтруктураВозврата.Вставить("ВидОгранки", ВидОгранки);
	СтруктураВозврата.Вставить("КачествоОгранки", КачествоОгранки); 
	СтруктураВозврата.Вставить("Диаметр", Диаметр);
	СтруктураВозврата.Вставить("Диаметр1", Диаметр1);
	СтруктураВозврата.Вставить("Диаметр2", Диаметр2); 
	СтруктураВозврата.Вставить("Длина", Длина);  
	СтруктураВозврата.Вставить("Ширина", Ширина1);
	СтруктураВозврата.Вставить("Высота", Высота1);
	СтруктураВозврата.Вставить("Сторона", Сторона);
	СтруктураВозврата.Вставить("Вес", Вес); 
	СтруктураВозврата.Вставить("ВесГраммы", ВесГраммы);
	СтруктураВозврата.Вставить("ОписаниеРазмера", СформироватьСтрокуРазмер());
	СтруктураВозврата.Вставить("ВесШтКар", ВесШт); //+Мельников 24.07.24 Для расчета суммы если количество больше 1. Заяка 2738
	СтруктураВозврата.Вставить("ВесГраммыШт", ВесГраммыШт); //+Мельников 24.07.24 Для расчета суммы если количество больше 1. Заяка 2738
	Этаформа.Закрыть(СтруктураВозврата);
КонецПроцедуры

