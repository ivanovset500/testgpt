&НаКлиенте
Процедура ВидВставкиПриИзменении(Элемент)	
	ЕдиницаИзмерения = ПолучитьЕдиницуРасчета();
	ВидОгранки = ПредопределенноеЗначение("Справочник.ЛБ_ВидыОгранки.ПустаяСсылка"); 
	ФормаОгранки = ПредопределенноеЗначение("Справочник.ЛБ_ФормыОгранки.ПустаяСсылка");
	КачествоОгранки = ПредопределенноеЗначение("Справочник.ЛБ_КачествоОгранки.ПустаяСсылка");
	ЗаполнитьСписокВыбораКачестваОгранки();
	ПроверитьФормуОгранки(); 
	ЗаполнитьСписокВыбораВидовОгранки();
	УстановитьВидимость(); 
	ПолучитьСпособРасчетаВеса();
	УстановитьДоступность(); 
	Если СпособРасчетаВеса = ПредопределенноеЗначение("Перечисление.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоТаблице") Тогда
		РассчитатьВесКамняПоТаблице();  
	ИначеЕсли СпособРасчетаВеса = ПредопределенноеЗначение("Перечисление.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоФормуле") Тогда
		РассчитатьВесКамняПоФормуле();	
	КонецЕсли;	
	ОчиститьДопПараметры(); //+Мельников 30.07.24 Заявка 2736
КонецПроцедуры


