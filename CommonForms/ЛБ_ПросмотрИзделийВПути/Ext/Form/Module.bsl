КонецПроцедуры

&НаСервере
Процедура УстановитьОтбиратьПоОткуда()
	Если ОтбиратьПоОткуда = 0 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_Ломбарды";	
		Элементы.СкладОтправитель.ТолькоПросмотр = Ложь;   
		//lion Если ЗначениеЗаполнено(ЛомбардОткуда) И ТипЗнч(ЛомбардОткуда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
		Если ЗначениеЗаполнено(ЛомбардОткуда) И ТипЗнч(ЛомбардОткуда) <> Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			ЛомбардОткуда = неопределено;
		КонецЕсли;	
	ИначеЕсли ОтбиратьПоОткуда = 1 Тогда
		ТипСтр = "СправочникСсылка._ДемоКонтрагенты";
		Элементы.СкладОтправитель.ТолькоПросмотр = Истина; 
		//lion Если ЗначениеЗаполнено(ЛомбардОткуда) И ТипЗнч(ЛомбардОткуда) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Если ЗначениеЗаполнено(ЛомбардОткуда) И ТипЗнч(ЛомбардОткуда) <> Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
			ЛомбардОткуда = неопределено;
		КонецЕсли;	
	//lion+++
	ИначеЕсли ОтбиратьПоОткуда = 2 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_ОтделенияЛомбардов";	
		Элементы.СкладОтправитель.ТолькоПросмотр = Ложь;   
		//lion Если ЗначениеЗаполнено(ЛомбардОткуда) И ТипЗнч(ЛомбардОткуда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
		Если ЗначениеЗаполнено(ЛомбардОткуда) И ТипЗнч(ЛомбардОткуда) <> Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			ЛомбардОткуда = неопределено;
		КонецЕсли;
	//lion---
	КонецЕсли;	 
	Элементы.ЛомбардОткуда.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);
	Элементы.ЛомбардОткуда.ВыбиратьТип = Ложь; 
	Элементы.СкладОтправитель.СписокВыбора.Очистить();
КонецПроцедуры

&НаСервере
Процедура УстановитьОтбиратьПоКуда()
	Если ОтбиратьПоКуда = 0 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_Ломбарды";	
		Элементы.СкладПолучатель.ТолькоПросмотр = Ложь;   
		Если ЗначениеЗаполнено(ЛомбардКуда) И ТипЗнч(ЛомбардКуда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
			ЛомбардКуда = неопределено;
		КонецЕсли;	
	ИначеЕсли ОтбиратьПоКуда = 1 Тогда
		ТипСтр = "СправочникСсылка._ДемоКонтрагенты";
		Элементы.СкладПолучатель.ТолькоПросмотр = Истина; 
		Если ЗначениеЗаполнено(ЛомбардКуда) И ТипЗнч(ЛомбардКуда) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			ЛомбардКуда = неопределено;;
		КонецЕсли;	
	КонецЕсли;	
	Элементы.ЛомбардКуда.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);
