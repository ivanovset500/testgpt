&НаСервере
Функция ПолучитьСписокПодразделений()  
	СписокПодразделений = Новый СписокЗначений;
	Если ТипЗнч(ЛомбардОткуда) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		СписокПодразделений.Добавить(ЛомбардОткуда);
	ИначеЕсли ТипЗнч(ЛомбардОткуда) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЛомбардыВОтделении(ТекущаяДатаСеанса(), ЛомбардОткуда);
	КонецЕсли;
	Возврат СписокПодразделений;
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("Организация", Организация);  
	Условие = "";
	Если ЗначениеЗаполнено(ЛомбардОткуда) Тогда
		//lion++
		//Запрос.УстановитьПараметр("Отправитель", ЛомбардОткуда);
		//Условие = Условие + " И Отправитель = &Отправитель";
		Если ТипЗнч(ЛомбардОткуда) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			ЛомбардыОткуда=ЛБ_ОбщийМодуль.ПолучитьЛомбардыВОтделении(Дата,ЛомбардОткуда);
			Запрос.УстановитьПараметр("ЛомбардыОткуда", ЛомбардыОткуда);
			Условие = Условие + " И Отправитель в (&ЛомбардыОткуда)";
		иначе
			Запрос.УстановитьПараметр("Отправитель", ЛомбардОткуда);
			Условие = Условие + " И Отправитель = &Отправитель";
		КонецЕсли;
		//lion--
	КонецЕсли;	  
	Если ЗначениеЗаполнено(СкладОтправитель) Тогда
		Запрос.УстановитьПараметр("СкладОтправитель", СкладОтправитель);
        Условие = Условие + " И СкладОтправитель = &СкладОтправитель"; 
	КонецЕсли;    
	Если ЗначениеЗаполнено(ЛомбардКуда) Тогда  
		Запрос.УстановитьПараметр("Получатель", ЛомбардКуда);
        Условие = Условие + " И Получатель = &Получатель";
	КонецЕсли;	  
	Если ЗначениеЗаполнено(СкладПолучатель) Тогда
		Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель);
        Условие = Условие + " И СкладПолучатель = &СкладПолучатель";    //" + Условие + "
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни КАК СуммаОценкиВставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды КАК СуммаСсуды,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_ОбъектыЗалогаВПутиОстатки.КоличествоОстаток КАК Количество,
	               |	ЛБ_ОбъектыЗалогаВПутиОстатки.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_ОбъектыЗалогаВПутиОстатки.Инкассатор КАК Инкассатор,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа,
	               |	ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Цена КАК Цена,
	               |	ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Период КАК ДатаЦены
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаВПути.Остатки(&Дата, Организация = &Организация" + Условие + ") КАК ЛБ_ОбъектыЗалогаВПутиОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаВПутиОстатки.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаВПутиОстатки.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаВПутиОстатки.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаВПутиОстатки.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ЦеныОбъектовЗалога.СрезПоследних КАК ЛБ_ЦеныОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаВПутиОстатки.ЗалоговыйБилет = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаВПутиОстатки.ОбъектЗалога = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаТоваров.Загрузить(ТаблицаЗапроса);  
	
	ИтогКоличество = ТаблицаТоваров.Итог("Количество");        
	ИтогВесИзделия = ТаблицаТоваров.Итог("ВесИзделия"); 
	ИтогВесМеталла = ТаблицаТоваров.Итог("ВесМеталла");
	ИтогСуммаОценки = ТаблицаТоваров.Итог("СуммаОценки");
	ИтогСуммаОценкиМакс = ТаблицаТоваров.Итог("СуммаОценкиМакс");
	ИтогСуммаОценкиМеталлы = ТаблицаТоваров.Итог("СуммаОценкиМеталлы");
	ИтогСуммаОценкиВставки = ТаблицаТоваров.Итог("СуммаОценкиВставки");      
	ИтогСуммаСсуды = ТаблицаТоваров.Итог("СуммаСсуды");  
	ИтогЦена = ТаблицаТоваров.Итог("Цена");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

