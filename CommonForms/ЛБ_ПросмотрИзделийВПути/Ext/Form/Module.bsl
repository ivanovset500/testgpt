
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Если НЕ УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда 
			Отказ = Истина;
		КонецЕсли;	
	Иначе
		Отказ = Истина;
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
	    Дата = ТекущаяДатаСеанса(); 
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
	    Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	КонецЕсли;
	УстановитьОтбиратьПоОткуда();
	УстановитьОтбиратьПоКуда();   
	Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов(ЛомбардОткуда));
	Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов(ЛомбардКуда));
КонецПроцедуры

&НаКлиенте
Процедура ПеремещениеЗалогов(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ОткрытьФорму("Документ.ЛБ_ПеремещениеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

