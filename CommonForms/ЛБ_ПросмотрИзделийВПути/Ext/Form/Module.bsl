КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораСкладов(Ломбард) 
	МассивСкладов = Новый Массив;
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Запрос = новый Запрос; 
		Запрос.УстановитьПараметр("Владелец", Ломбард);
		//+МАН 25.12.25 Изменил запрос. Заявка 3269
		//Запрос.Текст = "ВЫБРАТЬ
		//               |	ЛБ_Склады.Ссылка КАК Ссылка
		//               |ИЗ
		//               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
		//               |ГДЕ
		//               |	ЛБ_Склады.Владелец = &Владелец";
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_Склады.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
		               |ГДЕ
		               |	ЛБ_Склады.Владелец = &Владелец
		               |	И НЕ (ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМ)
		               |			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМЦО)
		               |			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМОбщий))";
		//-МАН
		Выборка = Запрос.Выполнить().Выбрать();     
		Пока Выборка.Следующий() Цикл 
			МассивСкладов.Добавить(Выборка.Ссылка);
		Конеццикла;	
	КонецЕсли;
	Возврат МассивСкладов;
КонецФункции

&НаКлиенте
Процедура ЛомбардОткудаПриИзменении(Элемент) 
	ТипОткуда = ПолучитьТипКудаОткуда(ЛомбардОткуда);
	Если (ОтбиратьПоОткуда = 0 И ТипОткуда = 1) ИЛИ  
		(ОтбиратьПоОткуда = 1 И ТипОткуда = 0) Тогда
        УстановитьОтбиратьПоОткуда();   
	Иначе	  
	    Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов(ЛомбардОткуда)); 
	КонецЕсли;	 
	ТаблицаТоваров.Очистить();
КонецПроцедуры   

&НаСервере
Функция ПолучитьТипКудаОткуда(Ломбард)
	Если ТипЗнч(Ломбард) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
		Возврат 1;
	Иначе
		Возврат 0;
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ЛомбардКудаПриИзменении(Элемент) 
	ТипКуда = ПолучитьТипКудаОткуда(ЛомбардКуда);
	Если (ОтбиратьПоКуда = 0 И ТипКуда = 1) ИЛИ  
		(ОтбиратьПоКуда = 1 И ТипКуда = 0) Тогда
        УстановитьОтбиратьПоКуда();   
	Иначе	  
	    Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов(ЛомбардКуда)); 
	КонецЕсли;	
	ТаблицаТоваров.Очистить();
КонецПроцедуры

&НаСервере
Функция ПолучитьЗБ(Идентификатор) 
	Стр = ТаблицаТоваров.НайтиПоИдентификатору(Идентификатор); 
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ЗБ", Стр.ЗалоговыйБилет);
	СтруктураВ.Вставить("Залогодатель", Стр.ЗалоговыйБилет.Залогодатель);
	Возврат СтруктураВ;
КонецФункции	

&НаКлиенте
Процедура ИсторияЗБ(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда
		Результат = ПолучитьЗБ(ТекСтрока.ПолучитьИдентификатор());
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Результат.Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗБ);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
	ТаблицаТоваров.Очистить();
КонецПроцедуры


&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
	ТаблицаТоваров.Очистить();
КонецПроцедуры

