//+МАН 12.02.26
&НаСервере
Процедура ОбновитьКассовыйЛимит()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КассовыеЛимитыСрезПоследних.ФактическийЛимит КАК ФактическийЛимит
		|ИЗ
		|	РегистрСведений.ЛБ_КассовыеЛимиты.СрезПоследних(&ДатаКон, Ломбард = &Ломбард) КАК ЛБ_КассовыеЛимитыСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаКон", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)));
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		КассовыйЛимит = РезультатЗапроса.ФактическийЛимит;
		Элементы.ТекстЛимит.Заголовок = "" + Формат(КассовыйЛимит, "ЧДЦ=2");
	Иначе
		КассовыйЛимит = 0;
		Элементы.ТекстЛимит.Заголовок = Формат(0, "ЧДЦ=2");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПревышениеЛимита(ЗакрытьДень = Ложь)
	Если ЗакрытьДень Тогда
		ВыходнойДень = ПроверитьНаПраздничныйИлиВыходной();
		
		Если ВыходнойДень = Неопределено Тогда
			Предупреждение("Не указан производственный календарь для лимитов.",, "Внимание!");
			Возврат Истина;
		КонецЕсли;

		Если ВыходнойДень = "Удаление" Тогда
			Предупреждение("Производственный календарь для лимитов помечен на удаление.
							| Выберите другой произвдственный каленрь или снимите отметку удаления.",, "Внимание!");
			Возврат Истина;
		КонецЕсли;
		
		Если НЕ ВыходнойДень И КассовыйЛимит - СуммаКон <= 0 Тогда
			Предупреждение("Кассовый лимит превышен на " + Формат((СуммаКон - КассовыйЛимит), "ЧДЦ=2") + " руб.",, "Внимание!");
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если КассовыйЛимит - СуммаКон <= 0 Тогда
			Предупреждение("Кассовый лимит превышен на " + Формат((СуммаКон - КассовыйЛимит), "ЧДЦ=2") + " руб.",, "Внимание!");
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ПроверитьНаПраздничныйИлиВыходной()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ПраздничныеСокращенныеДни.Дата КАК Дата,
		|	ЛБ_ПраздничныеСокращенныеДни.Выходной КАК Выходной,
		|	ЛБ_ПраздничныеСокращенныеДни.ВремяНачала КАК ВремяНачала,
		|	ЛБ_ПраздничныеСокращенныеДни.ВремяОкончания КАК ВремяОкончания,
		|	ЛБ_ПраздничныеСокращенныеДни.ЧасовСокращено КАК ЧасовСокращено,
		|	ЛБ_ПраздничныеСокращенныеДни.РабочийДень КАК РабочийДень
		|ИЗ
		|	Справочник.ЛБ_ПраздничныеСокращенныеДни КАК ЛБ_ПраздничныеСокращенныеДни
		|ГДЕ
		|	ЛБ_ПраздничныеСокращенныеДни.Дата = &Дата
		|	И НЕ ЛБ_ПраздничныеСокращенныеДни.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Дата", Формат(ДатаКон, "ДФ=dd.MM.yyyy"));
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Константы.ЛБ_ПроизводственныйКалендарьДляЛимитов.Получить()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.ЛБ_ПроизводственныйКалендарьДляЛимитов.Получить()) Тогда
		Если Константы.ЛБ_ПроизводственныйКалендарьДляЛимитов.Получить().ПометкаУдаления Тогда
			Возврат "Удаление";
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПроизводственногоКалендаря.Дата КАК Дата,
		|	ДанныеПроизводственногоКалендаря.ВидДня КАК ВидДня
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И ДанныеПроизводственногоКалендаря.Дата = &Дата";
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаКон)); //Формат(ДатаКон, "ДФ=dd.MM.yyyy"));
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", Константы.ЛБ_ПроизводственныйКалендарьДляЛимитов.Получить());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Если РезультатЗапроса.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий
			ИЛИ РезультатЗапроса.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	ЛБ_РабочиеДниЛомбардаСрезПоследних.Период КАК Период,
	//	|	ЛБ_РабочиеДниЛомбардаСрезПоследних.Ломбард КАК Ломбард,
	//	|	ЛБ_РабочиеДниЛомбардаСрезПоследних.Выходной КАК Выходной,
	//	|	ЛБ_РабочиеДниЛомбардаСрезПоследних.ДеньНедели КАК ДеньНедели,
	//	|	ЛБ_РабочиеДниЛомбардаСрезПоследних.НомерДня КАК НомерДня
	//	|ИЗ
	//	|	РегистрСведений.ЛБ_РабочиеДниЛомбарда.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_РабочиеДниЛомбардаСрезПоследних";
	//
	//Запрос.УстановитьПараметр("Дата", ДатаКон);
	//Запрос.УстановитьПараметр("Ломбард", Ломбард);
	//
	//РезультатЗапроса = Запрос.Выполнить().Выбрать();
	//
