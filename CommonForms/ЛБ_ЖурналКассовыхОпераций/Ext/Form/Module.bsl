&НаКлиенте
Процедура Печать(Команда)
	ТекСтрока = Элементы.КассовыеОперации.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда 
		Если НЕ ТекСтрока.СостояниеДокумента = 1 Тогда  
			Предупреждение("Печать непроведенного документа запрещена!", 60);
			Возврат
		КонецЕсли;	
		Если ПолучитьТипДокумента(ТекСтрока.Регистратор) = 1 Тогда		
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "ПКО"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриходныйКассовыйОрдер");
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекСтрока.Регистратор);
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
		ИначеЕсли ПолучитьТипДокумента(ТекСтрока.Регистратор) = 2 Тогда     
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "РКО"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_РасходныйКассовыйОрдер");
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекСтрока.Регистратор);
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
		ИначеЕсли ПолучитьТипДокумента(ТекСтрока.Регистратор) = 0 Тогда
			Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ОплатаПоЗайму") ИЛИ 
				 ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ОплатаПоЗаймуПереоформление") Тогда
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ИменаМакетов", "ПКО"); 
				ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ОперацияПоЗалогу");
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(ТекСтрока.Регистратор);
				ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
				ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
			ИначеЕсли ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаЗайма") ИЛИ 
				 ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаЗаймаПереоформление") Тогда
                ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ИменаМакетов", "РКО"); 
				ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ОперацияПоЗалогу");
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(ТекСтрока.Регистратор);
				ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
				ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
			КонецЕсли;	 
		КонецЕсли;	
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОстаткиПоКассе()  
	//+МАН 03.12.24 Добавлена проверка дат. Заявка 2904
	Если НачалоДня(ДатаНач) > КонецДня(ДатаКон) Тогда
		Сообщить("Неправильно задан период: начало периода должно быть меньше или равно окончанию!", СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	//-МАН
	
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));  
	Запрос.УстановитьПараметр("Дата2", ?(ДатаКон = Дата(1,1,1), ДатаКон, КонецДня(ДатаКон)));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДенежныеСредстваОстаткиИОбороты.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаНачальныйОстаток) КАК СуммаНач,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаКонечныйОстаток) КАК СуммаКон,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаПриход) КАК СуммаПриход,
	               |	СУММА(ЛБ_ДенежныеСредстваОстаткиИОбороты.СуммаРасход) КАК СуммаРасход
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДенежныеСредства.ОстаткиИОбороты(
	               |			&Дата1,
	               |			&Дата2,
	               |			,
	               |			,
	               |			Организация = &Организация
	               |				И ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
	               |				И Ломбард = &Ломбард) КАК ЛБ_ДенежныеСредстваОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ДенежныеСредстваОстаткиИОбороты.Ломбард";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		СуммаНач = Выборка.СуммаНач;
		СуммаКон = Выборка.СуммаКон; 
		СуммаПриход = Выборка.СуммаПриход;
		СуммаРасход = Выборка.СуммаРасход;
	Иначе
		СуммаНач = 0;
		СуммаКон = 0; 
		СуммаПриход = 0;
		СуммаРасход = 0;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ОстатокНаДатуОперации(Дата) 
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДенежныеСредстваОстатки.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ДенежныеСредстваОстатки.СуммаОстаток) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДенежныеСредства.Остатки(
	               |			&Дата,
	               |			Организация = &Организация
	               |				И Ломбард = &Ломбард
	               |				И ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)) КАК ЛБ_ДенежныеСредстваОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ДенежныеСредстваОстатки.Ломбард"; 
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Возврат Выборка.Сумма;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаКлиенте
Процедура ОбновитьИнформациюОстатокОперации()
	ТекСтрока = Элементы.КассовыеОперации.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		Остаток = ОстатокНаДатуОперации(ТекСтрока.Дата);  
		Если ТекСтрока.СостояниеДокумента = 1 Тогда 
		    Остаток = Остаток + ТекСтрока.Приход - Текстрока.Расход;  
		КонецЕсли;
		Элементы.ДекорацияОперацияОстаток.Заголовок = Формат(Остаток, "ЧЦ=15; ЧДЦ=2; ЧФ=' Ч  ""руб. ""'");  
		Если Остаток < 0 Тогда 
			Элементы.ДекорацияОперацияОстаток.ЦветТекста = WebЦвета.Красный;
		Иначе 
			Элементы.ДекорацияОперацияОстаток.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;	
	Иначе 
		Элементы.ДекорацияОперацияОстаток.Заголовок = "";
	КонецЕсли;	
КонецПроцедуры	   

&НаКлиенте
Процедура КассовыеОперацииПриАктивизацииСтроки(Элемент)
	ОбновитьИнформациюОстатокОперации();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервал(Команда)
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период = Новый СтандартныйПериод(ДатаНач, ДатаКон);
	Оповещение = Новый ОписаниеОповещения("ВыборПериодаЗавершение", ЭтаФорма);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериодаЗавершение(Период, ДополнительныеПараметры) Экспорт 
	Если Период = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ДатаНач = Период.ДатаНачала;
    ДатаКон = Период.ДатаОкончания;
	Если НЕ ДатаКон = Дата(1,1,1) И НЕ ДатаНач = Дата(1,1,1) Тогда
		Если  ДатаКон < ДатаНач Тогда
			Предупреждение("Конечная дата выбранного периода не может быть больше начальной даты периода.", 60);
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	КассовыеОперации.Параметры.УстановитьЗначениеПараметра("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	КассовыеОперации.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ДатаКон, КонецДня(ДатаКон)));	
	Элементы.КассовыеОперации.Обновить(); 
	ОстаткиПоКассе(); 
	ОбновитьИнформациюИтого();
	ОбновитьИнформациюОстатокОперации(); 
	ОбновитьИнформациюКассовойСмены();
	//+МАН 12.02.26
	ОбновитьКассовыйЛимит();
	ПроверитьПревышениеЛимита();
	//-МАН
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.КассовыеОперации.Обновить(); 
	ОстаткиПоКассе();
	ОбновитьИнформациюИтого();
	ОбновитьИнформациюОстатокОперации(); 
	ОбновитьИнформациюКассовойСмены();
	//+МАН 12.02.26
	ОбновитьКассовыйЛимит();
	ПроверитьПревышениеЛимита();
	//-МАН
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьОткрытьКассовуюСмену(Дата = неопределено)   
	СтруктураВозврата = Новый Структура;
	
	ДатаПроверки = ?(Дата = неопределено, ТекущаяДатаСеанса(), Дата); 
    Результат = ЛБ_ОбщийМодуль.ПолучитьЗакрытыйКассовыйДень(ДатаПроверки, Организация, Ломбард);
	Если НЕ Результат = неопределено  тогда 
		Если (НачалоДня(Результат.КассовыйДень) = НачалоДня(ДатаПроверки)) Тогда 
			СтруктураВозврата.Вставить("Результат", Ложь); 
			СтруктураВозврата.Вставить("Сообщение", "Кассовый день " + Формат(Результат.КассовыйДень, "ДЛФ=D") + " в ломбарде закрыт!");
			Возврат СтруктураВозврата; 
		КонецЕсли;	
	КонецЕсли;	
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьТекущийСтатусКассовойСмены(ДатаПроверки, Организация, Ломбард);
	Если НЕ Результат = неопределено  тогда    
		СтатусКС = Результат.Статус; 
        Если СтатусКС = Перечисления.ЛБ_КассоваяСменаСтатус.Открыта Тогда
			СтруктураВозврата.Вставить("Результат", Ложь); 
			СтруктураВозврата.Вставить("Сообщение", "Нужно сначала завершить кассовую смену окрытую в ломбарде " + Формат(Результат.Дата, "ДЛФ=DT")+ "!");
			Возврат СтруктураВозврата;  
		КонецЕсли;	
	КонецЕсли;	       
	
	СтруктураВозврата.Вставить("Результат", Истина);
	Возврат СтруктураВозврата; 
КонецФункции	

&НаСервере
Функция ОткрытьКассовуюСменуНаСервере(Дата = неопределено)   
	СтруктураВозврата = Новый Структура; 
	
	ДатаОткрытия = ?(Дата = неопределено, ТекущаяДатаСеанса(), Дата);
	НоваяКС = Документы.ЛБ_ОперацииКассовойСмены.СоздатьДокумент(); 
	НоваяКС.Дата = ДатаОткрытия;
	НоваяКС.ВидОперации = Перечисления.ЛБ_ВидыОперацийКассовойСмены.Открыть;
	НоваяКС.Организация = Организация;
	НоваяКС.Ломбард = Ломбард; 
	Результат = ЛБ_ОбщийМодуль.ПолучитьСводныйПКО_РКО(ДатаОткрытия, Организация, Ломбард);  
	Если НЕ Результат = неопределено Тогда
		НоваяКС.СводныйПКО = Результат.ПКОСводный; 
		НоваяКС.СводныйРКО = Результат.РКОСводный;
	КонецЕсли;	
	НоваяКС.Ответственный = Ответственный;
	Попытка
	    НоваяКС.Записать(РежимЗаписиДокумента.Проведение);
		СтруктураВозврата.Вставить("Результат", Истина);
		Возврат СтруктураВозврата;
	Исключение  
		СтруктураВозврата.Вставить("Результат", Ложь); 
		СтруктураВозврата.Вставить("Сообщение", "Не удалось открыть кассовую смену. Обратитесь к администратору!");
		Возврат СтруктураВозврата;
	КонецПопытки;   
КонецФункции	

&НаКлиенте
Процедура ОткрытьКассовуюСмену(Команда)
	ВсеОК = Истина;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда  
		ВсеОК = Ложь;
		Сообщить("Не выбрана организация!");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Ломбард) Тогда  
		ВсеОК = Ложь;
		Сообщить("Не выбран ломбард!");
	КонецЕсли;	

	Если ВсеОК тогда    
		Если СотрудникЦО Тогда
			ПараметрыФормы = Новый структура;
			ПараметрыФормы.Вставить("Дата", ПолучитьДатуСеанса());  
			//+МАН 24.04.25 Дабавил параметр т.к. его не указали при написании функционала. Заявка 2956
			ПараметрыФормы.Вставить("ОткрытиеЗакрытие", 0);
			//-МАН
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДатыОткрытияКС",ЭтаФорма);
			ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборДатыОткрытияЗакрытияКассовыхОпераций", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе	
			СтруктураВ = ПроверитьВозможностьОткрытьКассовуюСмену(); 
			Если СтруктураВ.Результат Тогда
			    Режим = РежимДиалогаВопрос.ДаНет;
			    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОткрыть", ЭтотОбъект, неопределено);
			    ПоказатьВопрос(Оповещение, "Внимание! Смена текущего дня на кассовом аппарате будет открыта. Продолжаем?" , Режим, 0); 
			Иначе
				Предупреждение(СтруктураВ.Сообщение, 60); 
			КонецЕсли;	 
		КонецЕсли;	
	КонецЕсли;   
КонецПроцедуры   

&НаКлиенте
Процедура ПослеВыбораДатыОткрытияКС(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВ = ПроверитьВозможностьОткрытьКассовуюСмену(Результат); 
	Если СтруктураВ.Результат Тогда
	    Режим = РежимДиалогаВопрос.ДаНет;
	    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОткрыть", ЭтотОбъект, Результат);
	    ПоказатьВопрос(Оповещение, "Внимание! Смена дня на кассовом аппарате будет открыта " + Формат(Результат, "ДЛФ=DT") + ". Продолжаем?" , Режим, 0); 
	Иначе
		Предупреждение(СтруктураВ.Сообщение, 60); 
	КонецЕсли;	 
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗакрытияВопросаОткрыть(Результат, ДатаОткрытия) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    СтруктураВ = ОткрытьКассовуюСменуНаСервере(ДатаОткрытия);
	Если СтруктураВ.Результат тогда
		ОстаткиПоКассе();                   
	    ОбновитьИнформациюИтого();
	    ОбновитьИнформациюКассовойСмены();
    Иначе 
	    Предупреждение(СтруктураВ.Сообщение, 60);
    КонецЕсли;	   
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьЗакрытьКассовуюСмену(Дата = неопределено)   
	СтруктураВозврата = Новый Структура;
	
	ДатаПроверки = ?(Дата = неопределено, ТекущаяДатаСеанса(), Дата);
	Результат  = ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(ДатаПроверки, Организация, Ломбард);
	Если Результат = неопределено  тогда  
		СтруктураВозврата.Вставить("Результат", Ложь); 
		СтруктураВозврата.Вставить("Сообщение", "В ломбарде нет открытой кассовой смены!");
		Возврат СтруктураВозврата; 
	Иначе
		Запрос = новый Запрос; 
		Запрос.УстановитьПараметр("Дата", ДатаПроверки); 
		Запрос.УстановитьПараметр("КассоваяСмена", Результат.КассоваяСмена);
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	ЛБ_ДвиженияДенежныхСредств.Период КАК Период
	                   |ИЗ
	                   |	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
	                   |ГДЕ
	                   |	ЛБ_ДвиженияДенежныхСредств.Период > &Дата
	                   |	И ЛБ_ДвиженияДенежныхСредств.КассоваяСмена = &КассоваяСмена
	                   |
	                   |УПОРЯДОЧИТЬ ПО
	                   |	Период УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			СтруктураВозврата.Вставить("Результат", Ложь);  
			СообщениеП = "В ломбарде есть операции по открытой кассовой смене " + Формат(Результат.Дата, "ДЛФ=DT") + " на более позднюю дату.";
			Если НЕ Дата = неопределено Тогда 
				СообщениеП = СообщениеП + Символы.ПС + "Кассовую смену можно закрыть на " + Формат(Выборка.Период + 1, "ДЛФ=DT"); 
			КонецЕсли;	
			СтруктураВозврата.Вставить("Сообщение", СообщениеП);
			Возврат СтруктураВозврата; 
		КонецЕсли;	
	КонецЕсли;	       
	СтруктураВозврата.Вставить("Результат", Истина);
	Возврат СтруктураВозврата;
КонецФункции	

