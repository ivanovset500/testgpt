
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаКон = ТекущаяДатаСеанса();
	ДатаНач = ДатаКон;
	Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	Ломбард = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь); 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь; 
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
			СотрудникЦО = Истина;
		КонецЕсли;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	
	КассовыеОперации.Параметры.УстановитьЗначениеПараметра("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	КассовыеОперации.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)));
    КассовыеОперации.Параметры.УстановитьЗначениеПараметра("Организация", Организация); 
	КассовыеОперации.Параметры.УстановитьЗначениеПараметра("Ломбард", Ломбард); 
	СписокОперацийОтмены = Новый СписокЗначений;
	СписокОперацийОтмены.Добавить(Перечисления.ЛБ_ВидыОперацийПКО.ОтменаОплатыПоЗаймуПереоформлению);
	СписокОперацийОтмены.Добавить(Перечисления.ЛБ_ВидыОперацийРКО.ОтменаВыдачиЗайма);
	
	КассовыеОперации.Параметры.УстановитьЗначениеПараметра("СписокОтмена", СписокОперацийОтмены);
	
	ОстаткиПоКассе();                   
	ОбновитьИнформациюИтого();
	ОбновитьИнформациюКассовойСмены(); 
	
	//+МАН 12.02.26
	ОбновитьКассовыйЛимит();
	//-МАН
	
	//+МАН 19.03.26 Заявка 3750
	УстановитьДоступность();
	//-МАН
КонецПроцедуры     

&НаСервере
Процедура ОбновитьИнформациюКассовойСмены()  
	ДатаПроверки = ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон));
	Результат = ЛБ_ОбщийМодуль.ПолучитьТекущийСтатусКассовойСмены(ДатаПроверки, Организация, Ломбард);
	Если Результат = неопределено Тогда 
		Элементы.ИнформацияКС.Заголовок = "Информация о кассовых сменах отсутствует"; 
	Иначе	      
		СтатусКС = Результат.Статус;   
		Если  НЕ (НачалоДня(Результат.Дата) = НачалоДня(ДатаКон)) Тогда 
			Элементы.ИнформацияКС.Заголовок = "Информация о кассовых сменах на " + Формат(ДатаКон, "ДФ=dd.MM.yyyy") + " отсутствует";  
		Иначе	
			Если СтатусКС = Перечисления.ЛБ_КассоваяСменаСтатус.Открыта  тогда  
				Элементы.ИнформацияКС.Заголовок = "Открыта кассовая смена " + Формат(Результат.Дата, "ДЛФ=DT") + ", кассир " + СокрЛП(Результат.Ответственный);	
			ИначеЕсли СтатусКС = Перечисления.ЛБ_КассоваяСменаСтатус.Закрыта  тогда 
				Элементы.ИнформацияКС.Заголовок = "Закрыта кассовая смена " + Формат(Результат.Дата, "ДЛФ=DT") + ", кассир " + СокрЛП(Результат.Ответственный);  		
			КонецЕсли;	 
		КонецЕсли;	
	КонецЕсли;	 
	Результат = ЛБ_ОбщийМодуль.ПолучитьЗакрытыйКассовыйДень(ДатаПроверки, Организация, Ломбард); 
	ДоступностьЗакрытьКассовыйДень = Истина;
	Если Результат = неопределено Тогда 
		Элементы.ИнформацияКД.Заголовок = "Информация о закрытом кассовом дне отсутствует";
	Иначе	      
		Если НЕ (НачалоДня(Результат.Дата) = НачалоДня(ДатаКон)) Тогда 
			Элементы.ИнформацияКД.Заголовок = "Информация о закрытом кассовом дне " + Формат(ДатаКон, "ДФ=dd.MM.yyyy") + " отсутствует";
		Иначе	
    	    Элементы.ИнформацияКД.Заголовок = "Закрыт кассовый день " + Формат(Результат.КассовыйДень, "ДЛФ=D") + ", дата закрытия " + Формат(Результат.Дата, "ДЛФ=DT") + ", кассир " + СокрЛП(Результат.Ответственный);
			ДоступностьЗакрытьКассовыйДень = Ложь;
		КонецЕсли;	
	КонецЕсли;	 
	Элементы.ФормаЗакрытьКассовыйДень.Доступность = ДоступностьЗакрытьКассовыйДень;
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюИтого() 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	Запрос.УстановитьПараметр("Дата2", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)));
    Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Ломбард", Ломбард); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДвиженияДенежныхСредств.Регистратор КАК Регистратор,
	               |	ЛБ_ДвиженияДенежныхСредств.КассоваяОперация КАК КассоваяОперация,
	               |	ЛБ_ДвиженияДенежныхСредств.ВидОперации КАК ВидОперации
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
	               |ГДЕ
	               |	ЛБ_ДвиженияДенежныхСредств.Организация = &Организация
	               |	И ЛБ_ДвиженияДенежныхСредств.Ломбард = &Ломбард
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
	               |	И ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &Дата1 И &Дата2";   
	ИтогоКО	= 0;
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Для каждого Выборка из ТаблицаЗапроса Цикл 
		Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.ЛБ_ОтменаПКО") ИЛИ
			 ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.ЛБ_ОтменаРКО") Тогда
			Отбор = новый Структура;
			Отбор.Вставить("Регистратор", Выборка.КассоваяОперация);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 Тогда 
				ИтогоКО = ИтогоКО - 1;
			Иначе                  
				ИтогоКО = ИтогоКО + 1;
			КонецЕсли;	           
		ИначеЕсли Выборка.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОтменаОплатыПоЗаймуПереоформлению ИЛИ 
			      Выборка.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.ОтменаВыдачиЗайма Тогда   
			ИтогоКО = ИтогоКО - 1;
		Иначе	
		    ИтогоКО = ИтогоКО + 1;      
		КонецЕсли;	
	КонецЦикла;
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьНомерКассовогоЛиста(ДатаНач, ДатаКон, Организация, Ломбард);
	НомерКЛ = Результат.Номер; 
	Элементы.НомерКЛ.Заголовок = СокрЛП(Ломбард.НомерЛомбарда) + "/" + ?(НомерКЛ = 0, "", Строка(НомерКЛ));
	Элементы.ДатаКЛ.Заголовок = "от " + Формат(Результат.Дата, "ДФ=dd.MM.yyyy");
КонецПроцедуры


&НаСервере
Процедура ДинамическийСписокВТаблицуЗначений()

	//Получаем схема компановки данных (здесь хранится текст запроса)
	Схема = Элементы.КассовыеОперации.ПолучитьИсполняемуюСхемуКомпоновкиДанных();

	//Получаем настройки пользователя (отборы, сортировки и т.п.)
	Настройки = Элементы.КассовыеОперации.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();

	//Выводим динамический список в таблицу значений
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ТаблицаКО.Загрузить(ТЗ);	
	
	Остаток = СуммаНач;
	Для каждого Стр Из ТаблицаКО Цикл
		Остаток = Остаток = Стр.Приход - Стр.Расход;
		Стр.Остаток = Остаток;
	Конеццикла;	
КонецПроцедуры  

