Процедура ПослеВыбораДатыЗакрытияКС(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВ = ПроверитьВозможностьЗакрытьКассовуюСмену(Результат); 
	Если СтруктураВ.Результат Тогда
	    Режим = РежимДиалогаВопрос.ДаНет;   
	    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗакрыть", ЭтотОбъект, Результат);
	    ПоказатьВопрос(Оповещение, "Внимание! Смена дня на кассовом аппарате будет закрыта " + Формат(Результат, "ДЛФ=DT") + ". Продолжаем?" , Режим, 0); 
	Иначе
		Предупреждение(СтруктураВ.Сообщение, 60); 
	КонецЕсли;	 
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗакрытияВопросаЗакрыть(Результат, ДатаЗакрытия) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    СтруктураВ = ЗакрытьКассовуюСменуНаСервере(ДатаЗакрытия);
	Если СтруктураВ.Результат тогда
		ОстаткиПоКассе();                   
	    ОбновитьИнформациюИтого();
	    ОбновитьИнформациюКассовойСмены();
    Иначе 
	    Предупреждение(СтруктураВ.Сообщение, 60);
    КонецЕсли;	    
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВПротоколРаботы()
	Если ЗначениеЗаполнено(ПараметрыСеанса.ТекущийСотрудник) и ЗначениеЗаполнено(ПараметрыСеанса.ТекущийЛомбард) Тогда
		МенеджерЗаписи = РегистрыСведений.ЛБ_ПротоколРаботы.СоздатьМенеджерЗаписи(); 
		МенеджерЗаписи.Сотрудник 	= ПараметрыСеанса.ТекущийСотрудник; 
		МенеджерЗаписи.Дата 		= ТекущаяДата(); 
		МенеджерЗаписи.Ломбард 		= ПараметрыСеанса.ТекущийЛомбард; 
		МенеджерЗаписи.Действие 	= Перечисления.ЛБ_ДействияПользователя.Выход;
		МенеджерЗаписи.Записать(); 		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗакрытьКассовыйДеньНаСервере() 
	СтруктураВозврата = Новый Структура;
   
	НоваяКС = Документы.ЛБ_ОперацииКассовойСмены.СоздатьДокумент(); 
	НоваяКС.Дата = ТекущаяДатаСеанса();
	НоваяКС.ВидОперации = Перечисления.ЛБ_ВидыОперацийКассовойСмены.ЗакрытьКассовыйДень;
	НоваяКС.Организация = Организация;           
	НоваяКС.Ломбард = Ломбард;
	НоваяКС.Ответственный = Ответственный;
	Попытка
	    НоваяКС.Записать(РежимЗаписиДокумента.Проведение);
		СтруктураВозврата.Вставить("Результат", Истина);
		Возврат СтруктураВозврата;
	Исключение  
		СтруктураВозврата.Вставить("Результат", Ложь); 
		СтруктураВозврата.Вставить("Сообщение", "Не удалось закрыть кассоый день. Обратитесь к администратору!");
		Возврат СтруктураВозврата;
	КонецПопытки;   
КонецФункции	

&НаСервере
Функция ПроверитьВозможностьЗакрытьКассовыйДень()   
	СтруктураВозврата = Новый Структура;
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьТекущийСтатусКассовойСмены(ТекущаяДатаСеанса(), Организация, Ломбард);
	Если НЕ Результат = неопределено Тогда 
		СтатусКС = Результат.Статус;
		Если СтатусКС = Перечисления.ЛБ_КассоваяСменаСтатус.Открыта  тогда  
			СтруктураВозврата.Вставить("Результат", Ложь); 
			СтруктураВозврата.Вставить("Сообщение", "Необходимо закрыть открытую кассовую смену!");
			Возврат СтруктураВозврата;
		ИначеЕсли СтатусКС = Перечисления.ЛБ_КассоваяСменаСтатус.КассовыйДеньЗакрыт  тогда  
			СтруктураВозврата.Вставить("Результат", Ложь); 
			СтруктураВозврата.Вставить("Сообщение", "Кассовый день " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + " уже закрыт!");
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураВозврата.Вставить("Результат", Истина);
	Возврат СтруктураВозврата;
 КонецФункции	


&НаКлиенте
Процедура ЗакрытьКассовыйДень(Команда)
	ВсеОК = Истина;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда  
		ВсеОК = Ложь;
		Сообщить("Не выбрана организация!");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Ломбард) Тогда  
		ВсеОК = Ложь;
		Сообщить("Не выбран ломбард!");
	КонецЕсли;	
	
	//+МАН 12.02.26
	Если ПроверитьПревышениеЛимита(Истина) Тогда
		ВсеОК = Ложь;
	КонецЕсли;
	//-МАН
	
	Если ВсеОК тогда   
		СтруктураВ = ПроверитьВозможностьЗакрытьКассовыйДень(); 
		Если СтруктураВ.Результат Тогда		
			Режим = РежимДиалогаВопрос.ДаНет;
		    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗакрытьКассовыйДень", ЭтотОбъект, Параметры);
		    ПоказатьВопрос(Оповещение, "Внимание! Текущий день на кассовом аппарате будет закрыт. Продолжаем?" , Режим, 0);  
		Иначе   
			Предупреждение(СтруктураВ.Сообщение, 60);
		КонецЕсли;	
	КонецЕсли;   
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗакрытьКассовыйДень(Результат, Параметры) Экспорт
