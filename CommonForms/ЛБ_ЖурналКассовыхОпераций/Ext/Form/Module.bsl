&НаСервере
Функция УдалитьНаСервере(Документ)  
	СтруктураВ = новый структура;
	ДокОбъект = Документ.ПолучитьОбъект();  
	ТипДок = ПолучитьТипДокумента(Документ);
	Если ТипДок = 1 Или ТипДок = 2 Тогда 
		СтруктураРез = ПроверитьКассовыйДеньЗакрыт(ДокОбъект);
		Если СтруктураРез.Результат И ДокОбъект.Проведен Тогда  
			СтруктураВ.Вставить("Результат", Ложь);
			СтруктураВ.Вставить("Сообщение", СтруктураРез.Сообщение); 
			Возврат СтруктураВ;
		КонецЕсли;	
		Если ДокОбъект.Проведен И (ТекущаяДатаСеанса() - ДокОбъект.Дата) > 3600 Тогда
			СтруктураВ.Вставить("Результат", Ложь);
			СтруктураВ.Вставить("Сообщение", "Удаление документа возможно только в течение часа с момента создания!"); 
			Возврат СтруктураВ;
		КонецЕсли;
	КонецЕсли;	
	Пометка = ?(ДокОбъект.ПометкаУдаления, Ложь, Истина);
	ДокОбъект.УстановитьПометкуУдаления(Пометка);  
	СтруктураВ.Вставить("Результат", Истина);   
	Возврат СтруктураВ;
КонецФункции

