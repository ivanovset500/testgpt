    КонецЕсли;

    СтруктураВ = ЗакрытьКассовыйДеньНаСервере();
	Если СтруктураВ.Результат тогда  
		ОстаткиПоКассе();                   
	    ОбновитьИнформациюИтого();
	    ОбновитьИнформациюКассовойСмены();
		ЗаписатьВПротоколРаботы();//Савранин 14.05.25
    Иначе 
	    Предупреждение(СтруктураВ.Сообщение, 60);
    КонецЕсли;	    
КонецПроцедуры


&НаСервере
Функция ПроверитьВозвможностьОтмены(Документ) 
	ВсеОк = Ложь;  
	СтруктураВ = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КассоваяОперация", Документ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДвиженияДенежныхСредствОбороты.СуммаОборот КАК СуммаОборот
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств.Обороты(, , , КассоваяОперация = &КассоваяОперация) КАК ЛБ_ДвиженияДенежныхСредствОбороты";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.СуммаОборот > 0 Тогда
			ВсеОк = Истина;
		КонецЕсли;	
	КонецЕсли;	          
	Если Не ВсеОК Тогда
		СтруктураВ.Вставить("Результат", Ложь);  
		СтруктураВ.Вставить("Сообщение", "Кассовая операция уже отменена");  
		Возврат структураВ;
	КонецЕсли;	
	Если (ТекущаяДатаСеанса() - Документ.Дата) > 3600 Тогда
		СтруктураВ.Вставить("Результат", Ложь);  
		СтруктураВ.Вставить("Сообщение", "Отменяемая кассовая операция создана больше часа назад. Отмена запрещена.");  
		Возврат структураВ;
    КонецЕсли;
	СтруктураВ.Вставить("Результат", Истина);   
	Возврат структураВ;

КонецФункции

&НаКлиенте
Процедура ОтменитьРКО(Документ)
	Если НЕ ПроверитьПроведен(Документ) Тогда  
		Предупреждение("Текущий документ не проведен.", 60);  
		Возврат;
	КонецЕсли;      
	Если НЕ ПроверитьМожноОтменить(Документ) тогда
		Предупреждение("Нельзя отменять кассовые операции без чеков.", 60);  
		Возврат;
	КонецЕсли;	
	СтруктураВ = ПроверитьВозвможностьОтмены(Документ);
	Если НЕ СтруктураВ.Результат Тогда 
		Предупреждение(СтруктураВ.Сообщение, 60);  
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = Новый Структура; 
	ПараметрыФормы.Вставить("РКО", Документ);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыполненияОперации",ЭтаФорма);
	ОткрытьФорму("Документ.ЛБ_ОтменаРКО.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПКО(Документ)	
	Если НЕ ПроверитьПроведен(Документ) Тогда  
		Предупреждение("Текущий документ не проведен.", 60);  
		Возврат;
	КонецЕсли; 
	Если НЕ ПроверитьМожноОтменить(Документ) тогда  
		Предупреждение("Нельзя отменять кассовые операции без чеков.", 60);  
		Возврат;
	КонецЕсли;	
	СтруктураВ = ПроверитьВозвможностьОтмены(Документ);
	Если НЕ СтруктураВ.Результат Тогда 
		Предупреждение(СтруктураВ.Сообщение, 60);  
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;  
	ПараметрыФормы.Вставить("ПКО", Документ);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыполненияОперации",ЭтаФорма);
	ОткрытьФорму("Документ.ЛБ_ОтменаПКО.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры	  

&НаСервере
Функция ПроверитьПроведен(Документ) 
	Возврат ?(Документ.Проведен, Истина, Ложь);
КонецФункции		

&НаСервере
Функция ПроверитьМожноОтменить(Документ) 
	Если Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков") ИЛИ
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО") ИЛИ 
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВозвратПроцентов") ИЛИ 
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВозвратПроцентовПоЗаявке") ИЛИ
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВозвратРазницыРеализацииНевостребованногоЗалога") ИЛИ 
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.РасходныеОперацииПоСогласованиюСЦО") Тогда   
		Возврат Истина; 
	КонецЕсли;	
    Возврат Ложь;
КонецФункции		

&НаКлиенте
Процедура ОтменитьКассовуюОперацию(Команда) 
	ТекСтрока = Элементы.КассовыеОперации.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда   
		СтруктураРез = ПроверитьКассовыйДеньЗакрыт(ТекСтрока.Регистратор); 
		Если СтруктураРез.Результат Тогда  
			Предупреждение(СтруктураРез.Сообщение, 60);
		    Возврат;
		КонецЕсли;	
		Если ПолучитьТипДокумента(ТекСтрока.Регистратор) = 1 И ПроверитьПроведен(ТекСтрока.Регистратор) Тогда		
			ОтменитьПКО(ТекСтрока.Регистратор);
		ИначеЕсли ПолучитьТипДокумента(ТекСтрока.Регистратор) = 2 И ПроверитьПроведен(ТекСтрока.Регистратор) Тогда     
			ОтменитьРКО(ТекСтрока.Регистратор);	 
		Иначе 
            Предупреждение("Можно отменить только проведенный приходный или расходный кассовый ордер.", 60);
	    КонецЕсли;	  
    КонецЕсли;
КонецПроцедуры

