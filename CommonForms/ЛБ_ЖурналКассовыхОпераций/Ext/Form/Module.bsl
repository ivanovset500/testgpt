&НаКлиенте
Процедура ПечатьПакетОтчетовПродолжить(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ПараметрыОтчета = Новый Структура;
		ПараметрыОтчета.Вставить("Период", НачалоДня(ДатаНач));
		ПараметрыОтчета.Вставить("НачалоПериода", НачалоДня(ДатаНач));
		ПараметрыОтчета.Вставить("КонецПериода", КонецДня(ДатаКон));
		ПараметрыОтчета.Вставить("Организация", Организация);
		ПараметрыОтчета.Вставить("Ломбард", Ломбард);
		Если Результат Тогда
			ЛБ_ЖурналКассовыхДокументовКлиент.ОбработкаКоманд("ПечатьПакетОтчетов", ПараметрыОтчета);
		Иначе
			ЛБ_ЖурналКассовыхДокументовКлиент.ОбработкаКоманд("ПечатьПакетОтчетовПросмотр", ПараметрыОтчета);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтчетОСогласиях(Команда)
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("НачалоПериода", ДатаНач);
	ПараметрыОтчета.Вставить("КонецПериода", ДатаКон);
	ПараметрыОтчета.Вставить("Организация", Организация);
	ПараметрыОтчета.Вставить("Ломбард", Ломбард);
	
	ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд(Команда.Имя, ,,ПараметрыОтчета, ЭтаФорма);
КонецПроцедуры

