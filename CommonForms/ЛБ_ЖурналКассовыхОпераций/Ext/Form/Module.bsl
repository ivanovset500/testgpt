&НаСервере
Функция ОтменитьПроведениеНаСервере(Документ)
	ДокОбъект = Документ.ПолучитьОбъект(); 
	СтруктураВ = новый структура;  
	ТипДок = ПолучитьТипДокумента(Документ);
	Если ТипДок = 1 Или ТипДок = 2 Тогда   
		СтруктураРез = ПроверитьКассовыйДеньЗакрыт(ДокОбъект);
		Если СтруктураРез.Результат Тогда  
			СтруктураВ.Вставить("Результат", Ложь);
			СтруктураВ.Вставить("Сообщение", СтруктураРез.Сообщение); 
			Возврат СтруктураВ;
		КонецЕсли;	

		Если ДокОбъект.Проведен И (ТекущаяДатаСеанса() - ДокОбъект.Дата) > 3600 Тогда
			СтруктураВ.Вставить("Результат", Ложь);
			СтруктураВ.Вставить("Сообщение", "Корректировка документа возможна только в течение часа с момента создания!"); 
			Возврат СтруктураВ;
		КонецЕсли;
	КонецЕсли;
	
	Если ДокОбъект.ПометкаУдаления Тогда
		СтруктураВ.Вставить("Результат", Ложь);
		СтруктураВ.Вставить("Сообщение", "Выбранный документ не проведен!"); 
		Возврат СтруктураВ;
	КонецЕсли;	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
		СтруктураВ.Вставить("Результат", Истина);
		Возврат СтруктураВ;
	Исключение  
		СтруктураВ.Вставить("Результат", Ложь);
		СтруктураВ.Вставить("Сообщение", "Ошибка отмены проведения документа!"); 
		Возврат СтруктураВ;
	КонецПопытки	
КонецФункции

