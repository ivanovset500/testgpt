&НаСервере
Функция ПроверитьОперацияСЧеком(Документ)
	Если Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков ИЛИ 
		 Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО ИЛИ
		 Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.ВозвратПроцентов ИЛИ 
		 Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.ВозвратПроцентовПоЗаявке ИЛИ
		 Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.ВозвратРазницыРеализацииНевостребованногоЗалога ИЛИ
		 Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.РасходныеОперацииПоСогласованиюСЦО Тогда  
	    Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ПолучитьТипДокумента(Документ)
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_ПриходныйКассовыйОрдер") Тогда 
		Если Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.СводныйПКО Тогда
			Возврат 0;
		Иначе	
		    Возврат 1;  
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_РасходныйКассовыйОрдер") Тогда 
		Если Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийРКО.СводныйРКО Тогда
			Возврат 0;
		Иначе	
		    Возврат 2;  
		КонецЕсли;	  
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_ОтменаПКО") Тогда 
	     Возврат 3; 
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_ОтменаРКО") Тогда 
	     Возврат 4; 	 
    Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура КассовыеОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекСтрока = Элементы.КассовыеОперации.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  
		ПараметрыФормы = Новый Структура;
	    ПараметрыФормы.Вставить("Ключ", ТекСтрока.Регистратор);
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыполненияОперации",ЭтаФорма);     
		Если ПолучитьТипДокумента(ТекСтрока.Регистратор) = 1 Тогда
		    ОткрытьФорму("Документ.ЛБ_ПриходныйКассовыйОрдер.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ПолучитьТипДокумента(ТекСтрока.Регистратор) = 2 Тогда
		    ОткрытьФорму("Документ.ЛБ_РасходныйКассовыйОрдер.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		ИначеЕсли ПолучитьТипДокумента(ТекСтрока.Регистратор) = 3 Тогда
		    ОткрытьФорму("Документ.ЛБ_ОтменаПКО.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	    ИначеЕсли ПолучитьТипДокумента(ТекСтрока.Регистратор) = 4 Тогда
		    ОткрытьФорму("Документ.ЛБ_ОтменаРКО.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияОперации(Результат, ДопПараметры) Экспорт 
