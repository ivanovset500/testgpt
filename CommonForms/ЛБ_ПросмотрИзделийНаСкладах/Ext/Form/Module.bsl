
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда 
			СотрудникЦО = Истина;
		КонецЕсли;	
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
	    Дата = ТекущаяДатаСеанса(); 
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
	    Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	КонецЕсли;        
	
	Если ТекПользователь.ЭтоЛомбард Тогда 
		Ломбард = ПараметрыСеанса.ТекущийЛомбард; 
		Элементы.Ломбард.Доступность = Ложь;
		Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов());
		Элементы.ПеремещениеЗалогов.Видимость = Ложь; 
		Элементы.НазначитьГруппу.Видимость = Ложь;
		Элементы.УстановитьЦены.Видимость = Ложь;   		
		ОтбиратьПо = 0;
		Элементы.ОтбиратьПо.Доступность = Ложь;   
		ЗаполнитьТаблицуНаСервере();
	Иначе
		УстановитьОтбиратьПо();
		//lion+++ 13.08.2025
		Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
		Элементы.Склад.СписокВыбора.Очистить();
		//Если НЕ ЗначениеЗаполнено(Ломбард) Тогда
		//    Ломбард = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);  
		//	Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов());  
		//КонецЕсли; 
		//lion--- 13.08.2025
	КонецЕсли;	 
	Если НЕ СотрудникЦО Тогда
		Элементы.ТаблицаТоваровИзъятие.Видимость = Ложь; 
		Элементы.ТаблицаТоваровОтменаИзъятия.Видимость = Ложь; 
		Элементы.ТаблицаТоваровВозвратИзъятого.Видимость = ложь; 
		Элементы.ТаблицаТоваровОтменаВозвратаИзъятого.Видимость = ложь;  
		Элементы.ТаблицаТоваровГруппаОтчеты.ПодчиненныеЭлементы.ТаблицаТоваровИсторияЗалога.Видимость = ложь;
	ИначеЕсли НЕ Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
		Элементы.ТаблицаТоваровИзъятие.Видимость = Ложь; 
		Элементы.ТаблицаТоваровОтменаИзъятия.Видимость = Ложь; 
		Элементы.ТаблицаТоваровВозвратИзъятого.Видимость = ложь; 
		Элементы.ТаблицаТоваровОтменаВозвратаИзъятого.Видимость = ложь;
	КонецЕсли;	
	УстановитьВидимостьКолонок();
		
КонецПроцедуры

&НаКлиенте
Процедура ПеремещениеЗалогов(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ОткрытьФорму("Документ.ЛБ_ПеремещениеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОприходованиеЗалогов(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НазначитьГруппу(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ОткрытьФорму("Документ.ЛБ_НазначениеГруппыОбъектамЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПодразделений()  
	СписокПодразделений = Новый СписокЗначений;
	Если ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		СписокПодразделений.Добавить(Ломбард);
	ИначеЕсли ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЛомбардыВОтделении(ТекущаяДатаСеанса(), Ломбард);
	КонецЕсли;
	Возврат СписокПодразделений;
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("Организация", Организация);  
	Условие = ""; 
	УсловиеСумка = "";
	Если ЗначениеЗаполнено(Ломбард) Тогда  
		Запрос.УстановитьПараметр("Подразделения", ПолучитьСписокПодразделений());
        Условие = Условие + " И Ломбард В (&Подразделения)"; 
		УсловиеСумка = УсловиеСумка + " И Получатель В (&Подразделения)";
	КонецЕсли;	  
	Если ЗначениеЗаполнено(Склад) Тогда
		Запрос.УстановитьПараметр("Склад", Склад);  
		Условие = Условие + " И Склад = &Склад";
        УсловиеСумка = УсловиеСумка + " И СкладПолучатель = &Склад"; 
	Иначе     
		Запрос.УстановитьПараметр("ПустойСклад", Справочники.ЛБ_Склады.ПустаяСсылка());
		Условие = Условие + " И НЕ Склад = &ПустойСклад"; 
		УсловиеСумка = УсловиеСумка + " И НЕ СкладПолучатель = &ПустойСклад";  //" + Условие + "     " + УсловиеСумка + "
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаОстатки.Склад КАК Склад,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни КАК СуммаОценкиВставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды КАК СуммаСсуды,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток КАК Количество,
	               |	ЛОЖЬ КАК ВСумке,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа,
	               |	ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Цена КАК Цена,
	               |	ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Период КАК ДатаЦены
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, Организация = &Организация" + Условие + ") КАК ЛБ_ОбъектыЗалогаОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ЦеныОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ЦеныОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаВСумкеОстатки.Получатель,
	               |	ЛБ_ОбъектыЗалогаВСумкеОстатки.СкладПолучатель,
	               |	ЛБ_ОбъектыЗалогаВСумкеОстатки.ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаВСумкеОстатки.ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки,
	               |	1,
	               |	ИСТИНА,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа,
	               |	ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Цена,
	               |	ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Период
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаВСумке.Остатки(&Дата, Организация = &Организация" + УсловиеСумка + ") КАК ЛБ_ОбъектыЗалогаВСумкеОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаВСумкеОстатки.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаВСумкеОстатки.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаВСумкеОстатки.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаВСумкеОстатки.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ЦеныОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ЦеныОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаВСумкеОстатки.ЗалоговыйБилет = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_ОбъектыЗалогаВСумкеОстатки.ОбъектЗалога = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаТоваров.Загрузить(ТаблицаЗапроса);  
	
	ИтогКоличество = ТаблицаТоваров.Итог("Количество");        
	ИтогВесИзделия = ТаблицаТоваров.Итог("ВесИзделия"); 
	ИтогВесМеталла = ТаблицаТоваров.Итог("ВесМеталла");
	ИтогСуммаОценки = ТаблицаТоваров.Итог("СуммаОценки");
	ИтогСуммаОценкиМакс = ТаблицаТоваров.Итог("СуммаОценкиМакс");
	ИтогСуммаОценкиМеталлы = ТаблицаТоваров.Итог("СуммаОценкиМеталлы");
	ИтогСуммаОценкиВставки = ТаблицаТоваров.Итог("СуммаОценкиВставки");      
	ИтогСуммаСсуды = ТаблицаТоваров.Итог("СуммаСсуды");  
	ИтогЦена = ТаблицаТоваров.Итог("Цена");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьТекущуюДатуСеанса()
	Возврат ТекущаяДатаСеанса(); 
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТаблицуНаТекущуюДату(Команда)
	Дата = ПолучитьТекущуюДатуСеанса();
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьОтбиратьПо()
	Если ОтбиратьПо = 0 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_Ломбарды";
	    Элементы.Ломбард.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);		
		Элементы.Склад.ТолькоПросмотр = Ложь;   
		Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
		КонецЕсли;	
	ИначеЕсли ОтбиратьПо = 1 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_ОтделенияЛомбардов";
	    Элементы.Ломбард.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр); 
		Элементы.Склад.ТолькоПросмотр = Истина; 
		Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			Ломбард = Справочники.ЛБ_ОтделенияЛомбардов.ПустаяСсылка();
		КонецЕсли;	
	КонецЕсли;	
	Значение = Элементы.Ломбард;
    Элементы.Ломбард.ОграничениеТипа.ПривестиЗначение(Значение);
    Элементы.Ломбард.ВыбиратьТип = Ложь; 
	Элементы.Склад.СписокВыбора.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ОтбиратьПоПриИзменении(Элемент)
	УстановитьОтбиратьПо();               
	Склад = ПредопределенноеЗначение("Справочник.ЛБ_Склады.ПустаяСсылка"); 
	ТаблицаТоваров.Очистить();
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораСкладов() 
	МассивСкладов = Новый Массив;
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Запрос = новый Запрос; 
		Запрос.УстановитьПараметр("Владелец", Ломбард);
