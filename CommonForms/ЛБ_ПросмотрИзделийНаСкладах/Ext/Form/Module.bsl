&НаСервере
Функция ПолучитьЗБ(Идентификатор) 
	Стр = ТаблицаТоваров.НайтиПоИдентификатору(Идентификатор); 
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ЗБ", Стр.ЗалоговыйБилет);
	СтруктураВ.Вставить("Залогодатель", Стр.ЗалоговыйБилет.Залогодатель); 
	СтруктураВ.Вставить("НомерЗБ", Стр.ЗалоговыйБилет.НомерЗалоговогоБилета);
	Возврат СтруктураВ;
КонецФункции	

&НаКлиенте
Процедура ИсторияЗБ(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда
		Результат = ПолучитьЗБ(ТекСтрока.ПолучитьИдентификатор());
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Результат.Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗБ);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСкладДляУстановкиЦены() 
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда 
		Если Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
		    ВидСклада = Перечисления.ЛБ_ВидыСкладов.ВитринаОбщая;
		Иначе    
			ВидСклада = Перечисления.ЛБ_ВидыСкладов.Витрина;
		КонецЕсли;	
        Возврат ЛБ_Общиймодуль.ПолучитьСклад(Ломбард, ВидСклада);
	КонецЕсли;	
	Возврат неопределено;
КонецФункции	
	 
&НаКлиенте
Процедура УстановитьЦены(Команда)  
	СкладДляУстановкиЦены = ПолучитьСкладДляУстановкиЦены();
	Если ЗначениеЗаполнено(Ломбард) Тогда  
		Если СкладДляУстановкиЦены = неопределено Тогда 
			Предупреждение("Для подразделения " + СокрЛП(Ломбард) + " не определен склад с видом " + ?(Ломбард = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис"), "«Витрина общая»", "«Витрина ломбарда/ЦЛО»"));
		Иначе	
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Склад", СкладДляУстановкиЦены); 
			ОткрытьФорму("Документ.ЛБ_УстановкаЦены.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		КонецЕсли;
	Иначе   
	   	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораСклада",ЭтаФорма); 
		ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборСкладаДляУстановкиЦен",, ЭтаФорма,,,, ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;
КонецПроцедуры   

