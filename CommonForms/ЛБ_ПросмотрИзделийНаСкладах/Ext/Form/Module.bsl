&НаСервере
Функция ПроверитьПередИзъятием(ЗалоговыйБилет)
    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ломбард", Справочники.ЛБ_Ломбарды.ЦентральныйОфис); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
	               |			,
	               |			Ломбард = &Ломбард
	               |				И ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ЕстьИзделия = Ложь;
	Для каждого Стр Из ТаблицаЗапроса Цикл 
		Если НЕ Стр.Количество = 0 Тогда 
			ЕстьИзделия = Истина;
			Прервать;
		КонецЕсли;	
	Конеццикла;
	
	Возврат ЕстьИзделия;
КонецФункции

&НаСервере
Функция ПроверитьПередОтменойИзъятия()
	ТекДата = ТекущаяДатаСеанса();
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ТекДата));  
	Запрос.УстановитьПараметр("Ломбард", Справочники.ЛБ_Ломбарды.ЦентральныйОфис);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет КАК ДокументЗалога,
	               |	ЛБ_СостояниеЗалоговогоБилета.Залогодатель КАК Залогодатель,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК Номер
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.Период МЕЖДУ &Дата1 И &Дата2
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор ССЫЛКА Документ.ЛБ_ОперацияПоЗалогу
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога)
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.Ломбард = &Ломбард"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции


&НаКлиенте
Процедура Изъятие(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда
		Результат = ПолучитьЗБ(ТекСтрока.ПолучитьИдентификатор());
		Если НЕ ПроверитьПередИзъятием(Результат.ЗБ) Тогда   
			Если ТекСтрока.ВСумке Тогда
				ТекстПредупреждения = "Изделие " + СокрЛП(ТекСтрока.ВидИзделия) + " арт. " + СокрЛП(ТекСтрока.Артикул) + " находится на складе " + СокрЛП(ТекСтрока.Склад) + " в сумке. Изятие невозможно."
			Иначе	
			    ТекстПредупреждения = "Объекты залога из залогового билета № " + СокрЛП(Результат.НомерЗБ) + " в ЦО не найдены. Изятие невозможно."; 
			КонецЕсли;	
			Предупреждение(ТекстПредупреждения, 60);
			Возврат;
		КонецЕсли;	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗБ);
		ПараметрыФормы.Вставить("Ломбард", ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис"));
								
		ОткрытьФорму("ОбщаяФорма.ЛБ_ИзъятиеОбъектовЗалога", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаИзъятия(Команда) 
	Если НЕ ПроверитьПередОтменойИзъятия() Тогда
		Предупреждение("Не найдены документы изъятия из ЦО для которых возможна операция отмены.", 60);    
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты")); 
	ПараметрыФормы.Вставить("Ломбард", ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОтменаОперацииПоЗайму", Этаформа); 
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателяПоНомеруБилета", ПараметрыФормы, Этаформа,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОтменаОперацииПоЗайму(Результат,Параметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат; 
	Иначе
		ОтменяемаяОперация = ПолучитьИнформациюОЗБ(Результат.НомерЗалоговогоБилета, ТекущаяДата());
		//+МАН Изменил т.к. не тем сравнивается.
		//Если НЕ ОтменяемаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога") Тогда
		Если НЕ ОтменяемаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога") Тогда
		//-МАН
			//+МАН 13.03.26 Изменил сообщение. Заявка 3654.
			//Предупреждение("Вид последней операции с ЗБ " + СокрЛП(Результат.НомерЗалоговогоБилета) + " не изъятие объектов залога. Отмена изъятия не возможна!");  
			Предупреждение("Отмена изъятого по ЗБ №" + СокрЛП(Результат.НомерЗалоговогоБилета) + " невозможна, т.к. операция уже была отменена.");  
			//-МАН
			Возврат;
		КонецЕсли;	
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Документ", ОтменяемаяОперация.Документ); 
		ОткрытьФорму("ОбщаяФорма.ЛБ_ИзъятиеОбъектовЗалога", ПараметрыФормы, ЭтаФорма, Истина,,,);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОЗБ(НомерЗалоговогоБилета, Дата)
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(НомерЗалоговогоБилета, Дата, Истина);
	
	ИнформацияОЗБ = Новый Структура;
	ИнформацияОЗБ.Вставить("Документ", Результат.Регистратор);
	ИнформацияОЗБ.Вставить("ВидОперации", Результат.Регистратор.ВидОперации);
	
	Возврат ИнформацияОЗБ;
	
КонецФункции

&НаКлиенте
Процедура ВозвратИзъятого(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога"));
	ПараметрыФормы.Вставить("Ломбард", ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораВозвратаИзъятие", Этаформа); 
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателяПоНомеруБилета", ПараметрыФормы, Этаформа,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВозвратаИзъятие(Результат,Параметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат; 
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗалоговыйБилет);
		ПараметрыФормы.Вставить("Ломбард", ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис"));
										
		ОткрытьФорму("ОбщаяФорма.ЛБ_ВозвратОбъектовЗалога", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ПроверитьПередОтменойВозвратаИзъятия()
	ТекДата = ТекущаяДатаСеанса();
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ТекДата));  
	Запрос.УстановитьПараметр("Ломбард", Справочники.ЛБ_Ломбарды.ЦентральныйОфис);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет КАК ДокументЗалога,
	               |	ЛБ_СостояниеЗалоговогоБилета.Залогодатель КАК Залогодатель,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерЗалоговогоБилета КАК Номер
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.Период МЕЖДУ &Дата1 И &Дата2
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор ССЫЛКА Документ.ЛБ_ОперацияПоЗалогу
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога)
	               |	И ЛБ_СостояниеЗалоговогоБилета.Регистратор.Ломбард = &Ломбард"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции


&НаКлиенте
Процедура ОтменаВозвратаИзъятого(Команда)
	Если НЕ ПроверитьПередОтменойВозвратаИзъятия() Тогда
		Предупреждение("Не найдены документы возврата изъятого в ЦО для которых возможна операция отмены.", 60);    
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты")); 
	ПараметрыФормы.Вставить("Ломбард", ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОтменаОперацииПоЗаймуВозврат", Этаформа); 
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателяПоНомеруБилета", ПараметрыФормы, Этаформа,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры


&НаКлиенте
Процедура ПослеВыбораОтменаОперацииПоЗаймуВозврат(Результат,Параметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат; 
	Иначе
		ОтменяемаяОперация = ПолучитьИнформациюОЗБ(Результат.НомерЗалоговогоБилета, ТекущаяДата());   
		Если НЕ ОтменяемаяОперация.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога") Тогда
			//+МАН 13.03.26 Изменил сообщение. Заявка 3654.
			//Предупреждение("Вид последней операции с ЗБ " + СокрЛП(Результат.НомерЗалоговогоБилета) + " не возврат изъятых объектов залога. Отмена возврата изъятого не возможна!");  
			Предупреждение("Отмена возврата изъятого по ЗБ №" + СокрЛП(Результат.НомерЗалоговогоБилета) + " невозможна, т.к. операция уже была отменена.");  
			//-МАН
			Возврат;
		КонецЕсли;	
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Документ", ОтменяемаяОперация.Документ);
		
		ОткрытьФорму("ОбщаяФорма.ЛБ_ВозвратОбъектовЗалога", ПараметрыФормы, ЭтаФорма, Истина,,,);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьДатуОтгрузки(ЗалоговыйБилет, ОбъектЗалога)  
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Период КАК ДатаНач
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(
	               |			,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНач УБЫВ";
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.Отгружено Тогда
			Возврат Выборка.ДатаНач;
		КонецЕсли;	
	КонецЕсли;	                    
	Возврат Дата(1,1,1);
КонецФункции    

&НаСервере
Функция ПолучитьНомерЗБ(ЗалоговыйБилет) 
	Возврат ЗалоговыйБилет.НомерЗалоговогоБилета;
КонецФункции	  

&НаКлиенте
Процедура ИсторияЗалога(Команда) 
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда
		НомерЗБ = ПолучитьНомерЗБ(ТекСтрока.ЗалоговыйБилет);
		Если ПолучитьДатуОтгрузки(ТекСтрока.ЗалоговыйБилет, ТекСтрока.ОбъектЗалога) = Дата(1,1,1) Тогда  
			Предупреждение("Залоговый билет № " + СокрЛП(НомерЗБ) + " не был отгружен из ломбарда", 60);
        Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);
			ПараметрыФормы.Вставить("ОбъектЗалога", ТекСтрока.ОбъектЗалога);	
									
			ОткрытьФорму("Отчет.ЛБ_ИсторияДвиженияОбъектаЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		КонецЕсли;	 
	Иначе
		Предупреждение("Для формирования отчета выберите изделие в табличной части формы", 60);
	КонецЕсли;	
КонецПроцедуры




