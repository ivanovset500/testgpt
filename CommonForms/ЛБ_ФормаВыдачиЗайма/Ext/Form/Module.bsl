Процедура ЛомбардПриИзменении(Элемент) 
	РасчетСуммыОценкиИтоговой();
	ПолучитьДоступныеПроцентныеСхемыАкции();				
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
        Иначе
			СхемаКредитования = СтрокаСК.СхемаКредитования; 
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;   
			ОбработатьСхемуКредитованияНаСервере();
			ПроверитьДоступностьДопКнопок();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
			ЗаполнитьТаблицуСтавок();
			ОбработатьДополнительныеКнопки();
			ЗаполнитьДатуВыкупа();
		    ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа(); 
		КонецЕсли;	
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1); 
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;     
		Элементы.ПовышеннаяОценка.Доступность = ложь; 
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  
	УстановитьВидимость();
    ОбработатьВыделениеЗБНасервере();
    ЗаполнитьДопИнформациюПоЗБ();
КонецПроцедуры

&НаСервере
Функция ПроверитьМинСуммыЗайма()  
	ТекстП = "";
	ТаблицаП = Товары.Выгрузить();
	ТаблицаП.Свернуть("ВыделитьВЗалоговыйБилет", "СуммаСсуды"); 	
	Для каждого СтрП Из ТаблицаП Цикл
		Если СтрП.СуммаСсуды < МинСуммаЗайма Тогда 
			ТекстП = ТекстП + ?(ПустаяСтрока(ТекстП), "Минимальная сумма займа " + СокрЛП(Формат(МинСуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " руб.!", ""); 
			Если ТаблицаП.Количество() > 1 Тогда
			    ТекстП = ТекстП + Символы.ПС + "-" + Строка(СтрП.ВыделитьВЗалоговыйБилет) + " сумма займа " + СокрЛП(Формат(СтрП.СуммаСсуды, "ЧЦ=15; ЧДЦ=2")) + " руб.";
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	 
		
	Возврат ТекстП; 
КонецФункции	

&НаКлиенте
Процедура СуммаЗаймаПриИзменении(Элемент)
	РаспределитьСуммуЗайма();
	ТекстП = ПроверитьМинСуммыЗайма();
	Если НЕ ПустаяСтрока(ТекстП) Тогда 
		Предупреждение("Внимание! " + ТекстП, 60);
		Возврат;
	КонецЕсли;	
	Для каждого СтрокаТабличнойЧасти из Товары Цикл  
		РасчетМаксимальнойСуммыОценки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		//СтрокаТабличнойЧасти.СуммаОценкиМаксимальная = ОкруглитьСуммуСсуды(СтрокаТабличнойЧасти.СуммаОценкиМаксимальная); 
	Конеццикла;	     
	МаксОценка = ОкруглитьСуммуСсуды(Товары.Итог("СуммаОценкиМаксимальная"));
	Если СуммаЗайма > МаксОценка Тогда
		СуммаЗайма = ОкруглитьСуммуСсуды(Товары.Итог("СуммаОценкиМаксимальная"));  
 	ИначеЕсли СуммаЗайма <= Товары.Итог("СуммаОценки") Тогда //И НЕ (ПроцентУвеличенияОценкиЗалога = 0) Тогда   
		Округление = Ложь;
		ПовышеннаяОценка = ложь;                                            	
	КонецЕсли;       
	РаспределитьСуммуЗайма();
	ПолучитьДоступныеПроцентныеСхемыАкции();
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
			ПодборСтавки(); //+Мельников 18.07.24 Подбор схемы кредитования
        Иначе			
			СхемаКредитования = СтрокаСК.СхемаКредитования;  
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;    
			ОбработатьСхемуКредитованияНаСервере();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт(); 
			ПроверитьДоступностьДопКнопок();			
			ЗаполнитьТаблицуСтавок(); 
			ПодборСтавки(); //+Мельников 18.07.24 Подбор схемы кредитования
			ОбработатьДополнительныеКнопки();
			ЗаполнитьДатуВыкупа();
		    ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа(); 
		КонецЕсли;	
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1); 
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;   
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;     
	ТоварыИтоги();  
	УстановитьВидимость();
	УстановитьТекстСуммаЗаймаДень();
	ОбработатьВыделениеЗБНасервере();
	ЗаполнитьДопИнформациюПоЗБ();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	Если Поле.Имя = "ТоварыЕстьФайл" тогда
		ТекСтрока = Элементы.Товары.ТекущиеДанные;  
		Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда
			СсылкаНаЭтикетку = ТекСтрока.Этикетка;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ", СсылкаНаЭтикетку); 
			ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
			ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		КонецЕсли;	 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Этикетка(Команда)  
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные; 
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда 
		ПрисоединитьЭтикетку(СтрокаТабличнойЧастиТовары);
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура ПрисоединитьЭтикетку(СтрокаТабличнойЧастиТовары)
	
	Если НЕ СтрокаТабличнойЧастиТовары.ЕстьЭтикетка Тогда 
		СсылкаНаЭтикетку = СтрокаТабличнойЧастиТовары.Этикетка; 
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЭтикетки",ЭтаФорма);
		Если ЗначениеЗаполнено(СсылкаНаЭтикетку) Тогда
			ПараметрыФормы = Новый Структура("Ключ", СсылкаНаЭтикетку);
		Иначе					
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Дата", ДатаДок);
			ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
		КонецЕсли;	
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЭтикетки",ЭтаФорма);  
		ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	Иначе
		Сообщить("У изделия есть этикетка. Скриншот сайта не нужен.");
	КонецЕсли;	
КонецПроцедуры	

&НаСервере  
