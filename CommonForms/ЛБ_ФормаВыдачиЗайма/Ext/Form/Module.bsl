Процедура СрокЗалогаПриИзменении(Элемент)
	ЗаполнитьДатуВыкупа();
	ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
	
    ОбработатьВыделениеЗБНасервере();
    ЗаполнитьДопИнформациюПоЗБ();
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыделениеЗБНасервере() 
	ТаблицаЗБ = Товары.Выгрузить(, "ВыделитьВЗалоговыйБилет, СуммаСсуды");
	ТаблицаЗБ.Свернуть("ВыделитьВЗалоговыйБилет", "СуммаСсуды");
	Для каждого стрЗБ Из ТаблицаЗБ Цикл   
		Если СтрЗБ.СуммаСсуды = 0 Тогда
			Продолжить;
		КонецЕсли;	   
		Отбор = Новый Структура;
        Отбор.Вставить("ВыделитьВЗалоговыйБилет", стрЗБ.ВыделитьВЗалоговыйБилет);
		СтрокиП = ПакетДокументов.НайтиСтроки(Отбор);
		Если НЕ СтрокиП.Количество() = 0 Тогда 
			СтрП = СтрокиП.получить(0);
			СтрП.СуммаЗайма = СтрЗБ.СуммаСсуды;						 

			ПроцентыРасчет = РассчитатьСуммуПроцентов(стрЗБ.ВыделитьВЗалоговыйБилет);
			ПСКГодРасчет = РасчетПСКГод(СтрЗБ.СуммаСсуды, ПроцентыРасчет);          
			Если НЕ ПСК = 0 Тогда      
				Если ПСКГодРасчет > ПСК Тогда  
					ОбщегоНазначения.СообщитьПользователю("Сумма процентов в год (" + Строка(стрЗБ.ВыделитьВЗалоговыйБилет) + ") превышает предельную ставку кредитования!");
				КонецЕсли;	
			КонецЕсли; 
			СтрП.ПСК = ПСКГодРасчет;
		КонецЕсли;	
	Конеццикла;	
КонецПроцедуры	 

&НаКлиенте
Процедура ТоварыВыделитьВЗалоговыйБилетПриИзменении(Элемент)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("ВыделитьВЗалоговыйБилет", ТекСтрока.ВыделитьВЗалоговыйБилет);
		СтрокиП = ПакетДокументов.НайтиСтроки(Отбор);
		Если СтрокиП.Количество() = 0 Тогда
			НоваяСтрП = ПакетДокументов.Добавить();
		    НоваяСтрП.ВыделитьВЗалоговыйБилет = ТекСтрока.ВыделитьВЗалоговыйБилет;  
			НоваяСтрП.СуммаЗайма = ТекСтрока.СуммаСсуды;
		КонецЕсли;			
		ОбработатьВыделениеЗБНасервере();
		ЗаполнитьДопИнформациюПоЗБ();         
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьСписокЛьготныхСтатусовСотрудника(ЕстьЛьготы = Истина) 
	СтатусС = СписокЛьготныхСтатусов.НайтиПоЗначению(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Сотрудник);
	Если ЕстьЛьготы Тогда
		Если СтатусС = неопределено Тогда
		   СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Сотрудник); 
		КонецЕсли;   
	Иначе
		Если НЕ СтатусС = неопределено Тогда
			СписокЛьготныхСтатусов.Удалить(СтатусС);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ПроверитьЕстьЛьготыСотрудника() 
	Для каждого стр из ТаблицаВыбораСхемыКредитованияАкции Цикл  
		Если ЗначениеЗаполнено(Стр.Акция) И Стр.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.ПоСтатусамЗаемщика Тогда
			Для каждого СтрА Из Стр.Акция.СтатусыЗаемщика Цикл  
				Если стрА.Статус = Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Сотрудник Тогда   
					Возврат Истина;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	Конеццикла;   
	Возврат ложь;
КонецФункции	
	
&НаСервере
Процедура ОбработатьДополнительныеКнопки() 
	Для каждого СтрокаТабличнойЧасти из Товары Цикл 
		РасчетМаксимальнойСуммыОценки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());  
		СтрокаТабличнойЧасти.СуммаСсуды = СтрокаТабличнойЧасти.СуммаОценкиМаксимальная;
	Конеццикла;	                                               	
	СуммаЗайма = ОкруглитьСуммуСсуды(Товары.Итог("СуммаОценкиМаксимальная"));
	РаспределитьСуммуЗайма();   
	ТоварыИтоги();   
	ПолучитьДоступныеПроцентныеСхемыАкции();				
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СхемаКредитования = СтрокаСК.СхемаКредитования;   
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;    
			ОбработатьСхемуКредитованияНаСервере();
			ПроверитьДоступностьДопКнопок();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
			ЗаполнитьТаблицуСтавок();
			ОбработатьДополнительныеКнопки();
			ЗаполнитьДатуВыкупа();
			ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
		КонецЕсли;	
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1);  
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;  
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		ПовышеннаяОценка = Ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  
	УстановитьВидимость();
	УстановитьТекстСуммаЗаймаДень(); 
	ОбработатьВыделениеЗБНасервере();	
КонецПроцедуры	

