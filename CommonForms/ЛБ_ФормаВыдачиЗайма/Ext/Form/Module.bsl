&НаКлиенте
Процедура ВставкиПередУдалением(Элемент, Отказ)
	//++ИВВ, 02.2026, вычеты для часов
	Если ПроверкаВидаКомплектующегоМеханизм(Элемент.ТекущиеДанные.ВидВставки) Тогда
		СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = 0;
		Элемент.ТекущиеДанные.РазмерСкидкиМеханизм = 0;
		ПослеУдаленияЧМ(Элемент.ТекущиеДанные)
	КонецЕсли;
	  
	Если ПроверкаВидаКомплектующегоНика(Элемент.ТекущиеДанные.ВидВставки) Тогда
		СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
		СтрокаТабличнойЧастиТовары.СкидкаНика = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = 0;
		Элемент.ТекущиеДанные.РазмерСкидкиНика = 0;
	КонецЕсли;
	//--ИВВ
КонецПроцедуры






