&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
        ДокументЗайма = Параметры.Документ; 
		Если ДокументЗайма.Проведен тогда 
		    НеРедактировать = Истина;   
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		Иначе
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		КонецЕсли;	
		ДатаДок = ДокументЗайма.Дата; 
		Ломбард = ДокументЗайма.Ломбард;  
		Организация = ДокументЗайма.Организация; 
		ОтветственныйПользователь = ДокументЗайма.ОтветственныйПользователь;
		ОтветственныйСотрудник = ДокументЗайма.ОтветственныйСотрудник;
	
		ТекущийСотрудник = ЛБ_ОбщийМодуль.ПолучитьСотрудника(ОтветственныйПользователь);
		Комментарий = ДокументЗайма.Комментарий;
		Залогодатель = ДокументЗайма.Залогодатель; 
		ДокументЗалогодателя = ДокументЗайма.ДокументЗалогодателя;
		СхемаКредитования = ДокументЗайма.СхемаКредитования;
		СрокЗалога = ДокументЗайма.СрокЗалога;
		Акция = ДокументЗайма.Акция;
		ПСК_LX = ДокументЗайма.ПСК_LX;
		СуммаСсуды = ДокументЗайма.СуммаСсуды;
		Промокод = ДокументЗайма.Промокод; 
		Предъявитель = ДокументЗайма.Предъявитель;
		ОтказОтВыкупа = ДокументЗайма.ОтказОтВыкупа;  
		ПакетДоговоров = ДокументЗайма.ПакетДоговоров;
		ПроцентнаяСхема = ДокументЗайма.ПроцентнаяСхема; 
		ПредельныйСрокЗайма = ДокументЗайма.ПредельныйСрокЗайма; 
		ПредельныйСрокЗаймаДни = ДокументЗайма.ПредельныйСрокЗаймаДни;                                        
		ДатаВыкупа = ДокументЗайма.ДатаВыкупа;
		ДатаВыкупаЛьготная = ДокументЗайма.ДатаВыкупаЛьготная; 
		СогласиеНаСМСРассылку = ДокументЗайма.СогласиеНаСМСРассылку; 
		ТекущаяУстановкаУсловийПоСхемеКредитования = ДокументЗайма.ТекущаяУстановкаУсловийПоСхемеКредитования;
		ПриказСтавки = ДокументЗайма.ПриказСтавки; 		
		ПриказАкцияСтавки = ДокументЗайма.ПриказАкцияСтавки;
		ОтклонениеПоАкции = ДокументЗайма.ОтклонениеПоАкции;
		ЗаполнитьКонтакнуюИнформациюЗалогодателя();
	    КонтактнаяИнформацияВСтроку();
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();
		СтатусЗалогодателя = ДокументЗайма.СтатусЗалогодателя; 
		ЗаполнитьТовары(); 
		НомераЗБ = ПолучитьНомераЗБ();
		ЗаполнитьТабличныеЧасти();
		//+МАН 17.06.25 Изменил на запрос
		//+Мельников 25.04.24 Отмена операции
		ДокументОтмены = ПолучитьДокументОтмены(ДокументЗайма);//Было: ДокументЗайма.ДокументОтмены;
		//-Мельников
		//-МАН
		//+МАН 10.12.25
		ПриказВИПСтавки = ДокументЗайма.ПриказВИПСтавки;
		//-МАН
		Если Параметры.ТолькоПросмотр = Истина Тогда	
			Этаформа.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе              		
		Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя(); 
		ДатаДок = ТекущаяДатаСеанса();   
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		//Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		//  	ОтветственныйПользователь = ТекПользователь;
		//Иначе
		//	ОтветственныйПользователь = ПараметрыСеанса.ТекущийСотрудник;
		//КонецЕсли;
		ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
        ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;

		Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();  
		ТекущийСотрудник = ЛБ_ОбщийМодуль.ПолучитьСотрудника(ОтветственныйПользователь);
		Если Параметры.Свойство("Залогодатель") Тогда 
			Залогодатель = Параметры.Залогодатель;
			ЗаполнитьИнфорациюОЗалогодателе(Параметры); 
			ЗаполнитьДопДокументы();
			СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДатаДок, Залогодатель); 
			СогласиеНаСМСРассылку = ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ДатаДок, Залогодатель); 
			
			Сотрудник = ПроверитьКлиентСотрудник(Залогодатель);
			Если НЕ Сотрудник = неопределено Тогда  
				Если Сотрудник = ТекущийСотрудник Тогда 
					ОбщегоНазначения.СообщитьПользователю("Выбранный заемщик является сотрудником оформляющим займ. Это запрещено!"); 
					Отказ = Истина;
					Возврат;  				
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;     		
		Элементы.ТоварыНомерЗалоговогоБилета.Видимость = Ложь; 
		Элементы.ДопИнформацияПоЗБ.Видимость = Ложь;
	КонецЕсли;  
	ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;	
	
	ОсновнаяЕдиницаИзмеренияКамни = Константы.ЛБ_ОсновнаяЕдиницаКамни.Получить();
	ОсновнаяЕдиницаИзмеренияМеталлы = Константы.ЛБ_ОсновнаяЕдиницаМеталлы.Получить();
	ЗаполнитьТаблицуДопСтатусовКлиента(); 
	ПолучитьДопСтатусыКлиента();  
	ПолучитьНастройкиЗайма(); 
			
	СуммаЗайма = Товары.Итог("СуммаСсуды");
	СуммаЗаймаДень = ПроверитьЕстьЗалогиДень();	
	ЗаполнитьСписокЛьготныхСтатусов();  
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ДатаДок, Организация);
	Если НЕ СтруктураП = неопределено Тогда
        ПСК = СтруктураП.ПСКГод;  
	Иначе
		ПСК = 0;
	КонецЕсли;  
	
	ПолучитьДоступныеПроцентныеСхемыАкции();  
	Если ЭтоСотрудник Тогда
	    ЕстьЛьготыСотрудника = ПроверитьЕстьЛьготыСотрудника(); 
		ЗаполнитьЛьготныеСтатусыСотрудника();
		СуммаЗаймаПоЛьготамСотрудника = ЛБ_УправлениеЛомбардом.ПолучитьЛьготнуюСуммуЗаймаСотрудника(ДатаДок, Залогодатель);  
		УстановитьТекстСуммаЗаймаСотрудник();  
		Элементы.ДекорацияСотрудник.Видимость = ?(НЕ НеРедактировать, Истина, ложь);
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) Тогда
		Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
			СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			СхемаКредитования = СтрокаСК.СхемаКредитования;
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;   			
			ЗаполнитьТаблицуСтавок();
			ПодборОптимальнойСтавки(); //+Мельников 18.07.24 Подбор схемы кредитования
		КонецЕсли; 
		РассчитатьПредельныСрокЗайма();
	Иначе        
		Отбор = Новый Структура;
		Отбор.Вставить("ДеньНач", 1);
		Строки = ГрафикПлатежей.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			СуммаПроцентов = Строки.Получить(0).СуммаПроцентов;
			СуммаПроцентовДень = Строки.Получить(0).СуммаПроцентовДень;
		КонецЕсли;	
	КонецЕсли;	 
	ОбработатьСхемуКредитованияНаСервере();  
	ПроверитьДоступностьДопКнопок();
	Если НЕ ЗначениеЗаполнено(ПроцентнаяСхема) Тогда
        Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	//Иначе
	//	ОбработатьВыделениеЗБНасервере();
	КонецЕсли;	
    СтатусыКлиентаВСтроку();	                              
	ТоварыИтоги();
	ВставкиИтоги();
	УстановитьВидимость(); 
	ДополнительныеМеталлыИтоги(); 	
	Если ЗначениеЗаполнено(ДокументЗайма) тогда
	    Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаОбъектыЗалога;  
	КонецЕсли;	
	Элементы.ДекорацияСуммаЗаймаДень.Видимость = ?(Этаформа.СуммаЗаймаДень = 0, Ложь, Истина);  	
	ДатаДокТекущая = ДатаДок; 
	МинСуммаЗайма = ЛБ_ОбщийМодуль.ПолучитьМинимальнуюСуммуЗайма(ДатаДок);
	//+Мельников 25.04.24
	УстановитьВидимость();
	//+Мельников 13.08.24 Формирование списка проб по прейскуранту. Заявка 2677.
	ЗаполнитьСписокПроб();
	//-Мельников    
	
	//++ИВВ 02.2026, вычеты для часов 
	ПроверкаВставокПриОткрытииНика();
	ПроверкаВставокПриОткрытииМеханизм();
	//--ИВВ
	
КонецПроцедуры   

&НаСервере
Функция ПроверитьКлиентСотрудник(Клиент)
    Возврат ЛБ_УправлениеЛомбардом.ПроверитьКлиентСотрудник(Клиент);
КонецФункции

&НаСервере
Процедура ЗаполнитьЛьготныеСтатусыСотрудника()  
	ДопСтатусСотрудник = Константы.ЛБ_ДопСтатусСотрудника.Получить();
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПромокодПредъявитель() 
	Если НЕ ПустаяСтрока(Промокод) Тогда
		Элементы.Предъявитель.Доступность = Ложь; 
	Иначе
		Элементы.Предъявитель.Доступность = Истина;
	КонецЕсли;   
	Если Предъявитель Тогда
		Элементы.Промокод.Доступность = Ложь; 
	Иначе
		Элементы.Промокод.Доступность = Истина;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДопДокументы()  
	Если НЕ ЗначениеЗаполнено(Гражданство) Или Гражданство = Справочники.СтраныМира.Россия тогда 
		ДопДокументы.Очистить();
	Иначе	
		//ТаблицаДоп = ЛБ_УправлениеЛомбардом.ПолучитьДокументыПравоПребыванияРФ(ДатаДок, Залогодатель);
		ДопДокументы.Загрузить(ЛБ_УправлениеЛомбардом.ПолучитьДокументыПравоПребыванияРФ(ДатаДок, Залогодатель, Гражданство));
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьПредельныСрокЗайма()
	ПредельныйСрокЗаймаДни = ЛБ_УправлениеЛомбардом.ПолучитьПредельныйСрокЗайма(ДатаДок, СхемаКредитования);
	Если НЕ ПредельныйСрокЗаймаДни = 0 Тогда  
		ПредельныйСрокЗайма = НачалоДня(ДатаДок) + ПредельныйСрокЗаймаДни*24*60*60;
	Иначе  
		ПредельныйСрокЗайма = Дата(1,1,1);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройкиЗайма()
	ЗапросН = Новый Запрос;
	ЗапросН.УстановитьПараметр("Дата", Этаформа.ДатаДок);
	ЗапросН.Текст = "ВЫБРАТЬ
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Настройка КАК Настройка,
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Значение КАК Значение
	                |ИЗ
	                |	РегистрСведений.ЛБ_НастройкаЗайма.СрезПоследних(&Дата, ) КАК ЛБ_НастройкаЗаймаСрезПоследних
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ЛБ_НастройкаЗаймаСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = ЗапросН.Выполнить().Выгрузить();
	НастройкиЗайма.Загрузить(ТаблицаЗапроса);
КонецПроцедуры 

&НаСервере
Функция ПолучитьНомераЗБ() 
	ИнфНомераЗБ = "";  
	ТоварыДоп = Товары.Выгрузить();
	ТоварыДоп.Свернуть("НомерЗалоговогоБилета");
	Для каждого СтрДоп из ТоварыДоп Цикл 
		ИнфНомераЗБ = ИнфНомераЗБ + ?(Пустаястрока(ИнфНомераЗБ), "", ", ") + СокрЛП(стрДоп.НомерЗалоговогоБилета);
	Конеццикла;	  
	//ИнфНомераЗБ = ИнфНомераЗБ + " от " + Формат(ДатаДок, "ДЛФ=DDT");
	Возврат ИнфНомераЗБ; 
КонецФункции	          

&НаСервере
Функция ИнформацияПродукт()
	Если НЕ ЗначениеЗаполнено(СхемаКредитования) тогда
		Возврат "";
	КонецЕсли;
	Возврат  СокрЛП(СхемаКредитования) + ?(ЗначениеЗаполнено(Акция), ", " + СокрЛП(Акция), "");
КонецФункции	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) Тогда
		СписокСС = ПолучитьСлужебныеСтатусыКлиента(Залогодатель);
		Если НЕ СписокСС.Количество() = 0 Тогда 
			ПредупреждениеП = "";
			Для каждого Элемент из СписокСС Цикл 
				СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение);
				Если СтруктураВозврата.Запрет Тогда 
					ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог");
					//+МАН 03.04.26 Изменено сообщение. Заявка 3759
					//Предупреждение("Для клиента " + СокрЛП(Залогодатель) + " определен запрет на операцию " + Строка(ВидОперации), 60, "Проверка служебных статусов клиента");
					Предупреждение("Клиенту " + СокрЛП(Залогодатель) + " присвоен служебный статус """ + Строка(Элемент.Значение) + """, в связи с чем запрещена операция: """ + Строка(ВидОперации) + """", 60, "Проверка служебных статусов клиента");
					//-МАН
					Отказ = Истина;
					Возврат;  
				Иначе
					ПредупреждениеП = СтруктураВозврата.Предупредить;
				КонецЕсли;	
			КонецЦикла;   
			Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
				Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена); 
				Если Ответ = КодВозвратаДиалога.Отмена Тогда  
					Отказ = Истина;
				    Возврат;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;    
		
		//Режим = РежимДиалогаВопрос.ДаНетОтмена;
		//Ответ = Вопрос("Клиент отказывается от выкупа залога?", Режим, 0);
		//Если Ответ = КодВозвратаДиалога.Отмена Тогда
		//	Отказ = Истина;
		//    Возврат;  
		//ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		//	ОтказОтВыкупа = Истина;  
		//	ОбработатьОтказОтВыкупаИзменение();
		//КонецЕсли;  
    КонецЕсли;
	
	Если НЕ ДопДокументы.Количество() = 0 Тогда
		Элементы.ГруппаДопДокумент.Показать(); 
	КонецЕсли;	
	
	Если НеРедактировать Тогда  
		Элементы.Редактировать.Видимость = ?(Этаформа.ТолькоПросмотр, Ложь, Истина);
		Элементы.КнопкаИстория.Видимость = Истина;
		Элементы.ВыдатьЗайм.Доступность = ложь;
		Элементы.ТоварыГруппаЭ.Доступность = ложь; 
		Элементы.ПовышеннаяОценка.Доступность = ложь; 
		Элементы.Округление.Доступность = ложь;
		Элементы.Отмена.Заголовок = "Закрыть";  
	Иначе
		Если ПроцентУвеличенияОценкиЗалога = 0 Тогда  
			Элементы.ПовышеннаяОценка.Доступность = ложь; 
			ПовышеннаяОценка = Ложь;
		КонецЕсли;
	КонецЕсли;		
	ОбновитьДанныеТовары(); 
	ОбновитьДанныеВставки();			
	Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;
	ПриСменеСтраницы(Элементы.ОсновнаяПанель.ТекущаяСтраница); 
	
	ЗаполнитьДопИнформациюПоЗБ();
	
	//Иванов ВВ, 06.2025, ЭДО, согласия
	НаличиеЭДО = ЛБ_СоглашенияЭДОСервер.НаличиеДействующегоСоглашения(Залогодатель);
	
	Если НаличиеЭДО Тогда
		Элементы.СтатусЭДО.Заголовок = "есть";
	Иначе
		Элементы.СтатусЭДО.Заголовок = "нет";
	КонецЕсли;
	
	НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
	
	Если НаличиеСогласия Тогда
		Элементы.СтатусСогласия.Заголовок = "есть";
	Иначе
		Элементы.СтатусСогласия.Заголовок = "нет";
	КонецЕсли;
	//
	
	Если ЗначениеЗаполнено(Залогодатель) И НЕ ЗначениеЗаполнено(ДокументЗайма) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Залогодатель);	
			
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеПроверкиАктуальности",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПроверкаАктуальностиДанныхКлиента", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;    
КонецПроцедуры  

