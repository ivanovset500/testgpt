КонецФункции


&НаСервере
Процедура УстановитьВидимость()
	Если Гражданство = Справочники.СтраныМира.Россия Тогда 
		Элементы.ГруппаДопДокумент.Видимость = Ложь;
	Иначе 
		Элементы.ГруппаДопДокумент.Видимость = Истина;
	КонецЕсли;
	Если СуммаЗаймаДень = 0 тогда
		Элементы.ДекорацияСуммаЗаймаДень.Видимость = Ложь;
	Иначе
		Элементы.ДекорацияСуммаЗаймаДень.Видимость = Истина;
		УстановитьТекстСуммаЗаймаДень();
	КонецЕсли;  
	Если НЕ ЭтоСотрудник тогда
		Элементы.ДекорацияСотрудник.Видимость = Ложь;
	Иначе
		Если НЕ НеРедактировать Тогда 
			Элементы.ДекорацияСотрудник.Видимость = Истина;
			УстановитьТекстСуммаЗаймаСотрудник();  
		Иначе
			Элементы.ДекорацияСотрудник.Видимость = Ложь;
		КонецЕсли;	
	КонецЕсли;       
	//+Мельников 25.04.24 Отмена операции
	Если ЗначениеЗаполнено(ДокументЗайма) Тогда

		ПроверкаПоследующихОпереаций = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ДокументЗайма.НомерЗалоговогоБилета, ТекущаяДата(),,Истина);
		ЛомбардПользователя = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);
		ПоследняяОперация = ?(ПроверкаПоследующихОпереаций = Неопределено, Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка(), ПроверкаПоследующихОпереаций.Регистратор);
		
		Если ДокументЗайма.Проведен И НЕ ТекущаяДата() - ДатаДок >= 3600 И ЛомбардПользователя = ДокументЗайма.Ломбард И
			?(ЗначениеЗаполнено(ДокументЗайма), ?(ПоследняяОперация = ДокументЗайма, Истина, Ложь), Ложь) Тогда

			Элементы.ОтменитьОперацию.Доступность = Истина;
		Иначе
			Элементы.ОтменитьОперацию.Доступность = Ложь;
		КонецЕсли;

		//+МАН 17.06.25 Изменил
		//Если ЗначениеЗаполнено(ДокументЗайма.ДокументОтмены) Тогда
		Если ЗначениеЗаполнено(ДокументОтмены) Тогда
			Элементы.ГруппаОтмена.Видимость = Истина;
			Элементы.Расчеты.Доступность = Ложь; //+Мельников 27.04.24
			//Элементы.ДекорНомерЗБ.Заголовок = ДокументЗайма.ДокументОтмены.НомерЗалоговогоБилета;
			Элементы.ДекорНомерЗБ.Заголовок = ДокументОтмены.НомерЗалоговогоБилета;
		//-МАН
			Элементы.Редактировать.Доступность = Ложь; //+Мельников 28.05.24
		КонецЕсли;
	КонецЕсли;
	//-Мельников
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстСуммаЗаймаДень() 
	Элементы.ДекорацияСуммаЗаймаДень.Заголовок = "Клиенту уже выдан займ " + СокрЛП(Формат(СуммаЗаймаДень, "ЧЦ=15; ЧДЦ=2")) + 
	    " руб. Итого сумма займа для расчета процентов " + СокрЛП(Формат(СуммаЗаймаДень + СуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " руб.";
КонецПроцедуры	

&НаСервере
Процедура УстановитьТекстСуммаЗаймаСотрудник()   
	Если ЕстьЛьготыСотрудника Тогда
		Если НЕ СуммаЗаймаПоЛьготамСотрудника = 0 Тогда
			Элементы.ДекорацияСотрудник.Заголовок = "Для сотрудника расчет процентов по льготной ставке при сумме займа не более " + СокрЛП(Формат(СуммаЗаймаПоЛьготамСотрудника, "ЧЦ=15; ЧДЦ=2")) + 
			         " руб." + ?(ЗначениеЗаполнено(ДопСтатусСотрудник), " В противном случае расчет как для клиента со статусом """ + сокрЛП(ДопСтатусСотрудник) + """.", ""); 
		Иначе 
			Элементы.ДекорацияСотрудник.Заголовок = ?(ЗначениеЗаполнено(ДопСтатусСотрудник), "Для сотрудника расчет процентов как для клиента со статусом """ + сокрЛП(ДопСтатусСотрудник) + """.", "Льготы по процентным ставкам для сотрудников не установлены");
		КонецЕсли;
	Иначе
		Элементы.ДекорацияСотрудник.Заголовок = "Льготы по процентным ставкам для сотрудников не установлены";
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура КарточкаПлательщика(Команда)
	СтандартнаяОбработка = ложь;
	Если ЗначениеЗаполнено(Залогодатель) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
		ПараметрыФормы.Вставить("Дата", ДатаДок);	
		ПараметрыФормы.Вставить("ТолькоПросмотр", истина);
		//ПараметрыФормы.Вставить("НеРедактировать", истина); 
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеИзмененияКарточки",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Сообщить("Не выбран заемщик!");
	КонецЕсли;	
КонецПроцедуры   

&НаСервере
Функция ПолучитьДокументЗалогодателя() 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Залогодатель
	               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДокументЗалогодателя;
	КонецЕсли; 
	Возврат ДокументЗалогодателя;
КонецФункции

&НаКлиенте
Процедура ПослеИзмененияКарточки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	Если ЭтаФорма.НеРедактировать тогда
		Возврат;
	КонецЕсли;	
	
	//Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ТекущаяДата()) Тогда  
	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если НачалоДня(ДатаДок) = НачалоДня(ДатаСеанса) Тогда
		ДатаДок = ДатаСеанса;
	КонецЕсли;	
    ЗаполнитьКонтакнуюИнформациюЗалогодателя();
    КонтактнаяИнформацияВСтроку();       
	
	НовыйДокументЗалогодателя = ПолучитьДокументЗалогодателя();
	Если НЕ ДокументЗалогодателя = НовыйДокументЗалогодателя Тогда
		ДокументЗалогодателя = НовыйДокументЗалогодателя;
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();  	
	КонецЕсли;	
	ЗаполнитьДопДокументы();
КонецПроцедуры 

&НаСервере
Функция ПолучитьТекущийСтатусКлиента()
	Возврат ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДатаДок, Залогодатель);
КонецФункции

&НаСервере
Функция ПроверитьЕстьПакетЗаймов() 
	Если Товары.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;	
	Отбор = Новый структура;          
	Для Каждого Зн Из Метаданные.Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.ЗначенияПеречисления Цикл 
		Отбор.Вставить("ВыделитьВЗалоговыйБилет", ПредопределенноеЗначение("Перечисление.ЛБ_ВыделитьВЗалоговыйБилет." + Зн.Имя));
        СтрокиТовары = Товары.НайтиСтроки(Отбор);
		Если НЕ СтрокиТовары.Количество() = Товары.Количество() Тогда 
			Возврат Истина;
		КонецЕсли;	
	Конеццикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ПолучитьМинСуммуЗайма()
    Возврат ЛБ_ОбщийМодуль.ПолучитьМинимальнуюСуммуЗайма(ДатаДок);
КонецФункции

&НаСервере
Функция ПолучитьСогласиеНаСМСРассылку()
    Возврат ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ДатаДок, Залогодатель);
КонецФункции

&НаСервере
Процедура ПересчитатьПСК()
    СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ДатаДок, Организация);
	Если НЕ СтруктураП = неопределено Тогда
        ПСК = СтруктураП.ПСКГод;  
	Иначе
		ПСК = 0;
	КонецЕсли;   
КонецПроцедуры	

&НаКлиенте
Процедура ДатаДокПриИзменении(Элемент) 
	ИзменениеДатыВозможно = Истина;
	ПолучитьНастройкиЗайма(); 
	ОтборН = Новый структура;
	ОтборН.Вставить("Настройка", ПредопределенноеЗначение("Перечисление.ЛБ_ТипыНастроекЗайма.РазбиватьЗалоговыйБилет"));
	СтрокиН = НастройкиЗайма.НайтиСтроки(ОтборН);
	Если НЕ СтрокиН.Количество() = 0 Тогда 
		Если НЕ СтрокиН.Получить(0).Значение тогда
			Если ПроверитьЕстьПакетЗаймов() Тогда 
				Сообщить("В выбранном временном периоде действует другая настройка возможности оформления пакета займов.");
				ИзменениеДатыВозможно = Ложь;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	

	Если НЕ ИзменениеДатыВозможно Тогда   		
		ДатаДокТекущая = ДатаДок;
		Возврат;
	КонецЕсли;
	
	ДатаДокТекущая = ДатаДок;
	СогласиеНаСМСРассылку = ПолучитьСогласиеНаСМСРассылку();
	ЗаполнитьКонтакнуюИнформациюЗалогодателя();
    КонтактнаяИнформацияВСтроку();
	ЗаполнитьИнформациюОДокументеЗалогодателя();
	ИнформацияОДокументеВСтроку(); 
	ЗаполнитьДопДокументы();
	
	СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента();
	Если ЭтоСотрудник Тогда
		ЗаполнитьЛьготныеСтатусыСотрудника();
	КонецЕсли;	
	ПолучитьДопСтатусыКлиента();  
	ЗаполнитьСписокЛьготныхСтатусов();
	СтатусыКлиентаВСтроку(); 
	СуммаЗаймаДень = ПроверитьЕстьЗалогиДень();  	
	//Элементы.ДекорацияСуммаЗаймаДень.Видимость = ?(Этаформа.СуммаЗаймаДень = 0, Ложь, Истина);  
	РасчетСуммыОценкиИтоговой(); 

	ПолучитьДоступныеПроцентныеСхемыАкции();
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СхемаКредитования = СтрокаСК.СхемаКредитования; 
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрокаСК.Акция;     
			ОбработатьСхемуКредитованияНаСервере();
			//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт(); 
			ПроверитьДоступностьДопКнопок();	
			ЗаполнитьТаблицуСтавок();   			
			ОбработатьДополнительныеКнопки();
		КонецЕсли;	
   	    ЗаполнитьДатуВыкупа();
	    ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
		ЗаполнитьТаблицуСтавок();
	Иначе
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка"); 
		//Элементы.ДекорацияПродукт.Заголовок = ИнформацияПродукт();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1); 
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;   
		Элементы.ПовышеннаяОценка.Доступность = ложь;
		ПовышеннаяОценка = Ложь;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	  	
	УстановитьВидимость();
	ПересчитатьПСК();
	РассчитатьПредельныСрокЗайма();
	ОбработатьВыделениеЗБНасервере();
	ЗаполнитьДопИнформациюПоЗБ();
	МинСуммаЗайма = ПолучитьМинСуммуЗайма(); 
	//+Мельников 13.08.24 Формирование списка проб по прейскуранту. Заявка 2677.
	ЗаполнитьСписокПроб();
	//-Мельников
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть(?(СписокЗалоговыхБилетов.Количество() = 0, неопределено, СписокЗалоговыхБилетов));
КонецПроцедуры 


&НаСервере
Функция ПроверитьКлиентаПоПеречням()
	РезультатПроверки = Истина; 
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК СтатусКлиентаВПеречне,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И ВидПеречня = &ВидПеречня) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ"; 

	СписокПеречней = Новый СписокЗначений;
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);  
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	Для каждого Эл из СписокПеречней Цикл 
		Запрос.УстановитьПараметр("ВидПеречня", Эл.Значение);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда     
			Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
				Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
					Сообщить("Клиент найден в перечне террористов. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
					Сообщить("Клиент найден в перечне ФРОМУ. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
		        ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
					Сообщить("Клиент найден в списке МВК. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
					Сообщить("Клиент найден в перечне ООН. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;	
				КонецЕсли;	  
			КонецЕсли;	
		КонецЕсли;     
	Конеццикла;	
	Возврат РезультатПроверки;
КонецФункции	

&НаСервере
Функция ПроверкаКлиента() 
	ВсеОК = Истина;
	
	ВозрастКлиента = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
	Если ВозрастКлиента  < 18 Тогда
	    Сообщить("Клиенту " + Строка(ВозрастКлиента) + " лет, работа с несовершеннолетними клиентами не осуществляется!", СтатусСообщения.Важное);
		ВсеОК = ложь;
	КонецЕсли;	
	
	Если НЕ ПроверитьКлиентаПоПеречням() Тогда
		ВсеОК = ложь;
	КонецЕсли; 
			
	Возврат ВсеОК;
КонецФункции    

&НаКлиенте
Процедура ФИОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Залогодатель) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
	КонецЕсли;	  
	ПараметрыФормы.Вставить("Дата", ДатаДок); 
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ПараметрыФормы.Вставить("НаТекущуюДату", Истина);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог"));
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалогодателя",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПаспортНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Залогодатель) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
	КонецЕсли;	
	ПараметрыФормы.Вставить("Дата", ДатаДок); 
	Если НЕ ЗначениеЗаполнено(ДокументЗайма) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ПараметрыФормы.Вставить("НаТекущуюДату", Истина);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог"));
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалогодателя",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры     

&НаКлиенте
Процедура ПослеВыбораЗалогодателя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;    
	
	Сотрудник = ПроверитьКлиентСотрудник(Результат.Залогодатель);
	Если НЕ Сотрудник = неопределено Тогда   
		Если Сотрудник = ТекущийСотрудник Тогда 
			Сообщить("Выбранный заемщик является сотрудником оформляющим займ. Это запрещено!"); 
			Возврат; 
		Иначе
			ЭтоСотрудник = Истина;
		КонецЕсли;	              
	Иначе
		ЭтоСотрудник = Ложь;
	КонецЕсли;	
	
	СписокСС = ПолучитьСлужебныеСтатусыКлиента(Результат.Залогодатель);  
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение);
			Если СтруктураВозврата.Запрет Тогда    
				ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог");
				//+МАН 03.04.26 Изменено сообщение. Заявка 3759
				//Предупреждение("Для клиента " + СокрЛП(Результат.Залогодатель) + " определен запрет на операцию " + Строка(ВидОперации), 60, "Проверка служебных статусов клиента");
				Предупреждение("Клиенту " + СокрЛП(Результат.Залогодатель) + " присвоен служебный статус """ + Строка(Элемент.Значение) + """, в связи с чем запрещена операция: """ + Строка(ВидОперации) + """", 60, "Проверка служебных статусов клиента");
				//-МАН
				Возврат;  
			Иначе
				ПредупреждениеП = СтруктураВозврата.Предупредить;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена, , "Проверка служебных статусов клиента"); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;  
	
	ВыборЗалогодателяНаСервере(Результат);
	ЗаполнитьДопИнформациюПоЗБ();
	УстановитьВидимость();
КонецПроцедуры 

&НаСервере
Процедура ОчиститьДокументыЗалогодателя()
	ДопДокументы.Очистить();
	
	ДокументЗалогодателя = Справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
	ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПустаяСсылка();
	ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ПустаяСсылка();
	ДокументГражданство = Справочники.СтраныМира.ПустаяСсылка();
	ДокументДатаВыдачи = Дата(1,1,1);
	ДокументКемВыдан = "";
	ДокументКодПодразделения = "";
	ДокументНачалоДействия = Дата(1,1,1);
	ДокументСрокДействия = Дата(1,1,1);
	ЭтаФорма.Паспорт = "";
КонецПроцедуры

&НаСервере
Процедура ВыборЗалогодателяНаСервере(Результат) 
	Залогодатель = Результат.Залогодатель;
	ОчиститьДокументыЗалогодателя();
	ЗаполнитьИнфорациюОЗалогодателе(Результат);  
	ЗаполнитьДопДокументы();
	
	Если ЭтоСотрудник Тогда
		ЗаполнитьЛьготныеСтатусыСотрудника();
	КонецЕсли;
	
	НеРезидент = ?(Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия"), ложь, истина);
	СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДатаДок, Залогодатель);
	СогласиеНаСМСРассылку = ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ДатаДок, Залогодатель);
	ПолучитьДопСтатусыКлиента();   
	СтатусыКлиентаВСтроку();    		
	СуммаЗаймаДень = ПроверитьЕстьЗалогиДень();
	ЗаполнитьСписокЛьготныхСтатусов();  
	//Элементы.ДекорацияСуммаЗаймаДень.Видимость = ?(Этаформа.СуммаЗаймаДень = 0, Ложь, Истина);   
	РасчетСуммыОценкиИтоговой();
	
	ПолучитьДоступныеПроцентныеСхемыАкции();
    Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СхемаКредитования); 
		ОтборК.Вставить("Акция", Акция);
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборК);
		Если СтрокиСК.Количество() = 0 Тогда 
		    СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0); 
		Иначе  
			СтрокаСК = СтрокиСК.Получить(0);
		КонецЕсли;   
		Если СхемаКредитования = СтрокаСК.СхемаКредитования И Акция = СтрокаСК.Акция Тогда
			ЗаполнитьТаблицуСтавок();
        Иначе
			СхемаКредитования = СтрокаСК.СхемаКредитования; 
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
