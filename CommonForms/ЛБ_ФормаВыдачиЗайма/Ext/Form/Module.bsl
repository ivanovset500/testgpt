&НаСервере
Функция ПроверитьЕстьЗалогиДень() 
	Отбор = Новый структура;
	Отбор.Вставить("Настройка", Перечисления.ЛБ_ТипыНастроекЗайма.СуммироватьЗаймыЗаДень);
	СтрокиН = НастройкиЗайма.НайтиСтроки(Отбор);
	Если СтрокиН.Количество() = 0 Тогда
		Возврат 0;
	ИначеЕсли НЕ СтрокиН.Получить(0).Значение Тогда 
	    Возврат 0;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(Залогодатель) тогда
		Запрос = новый Запрос; 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
		Запрос.УстановитьПараметр("Дата1", НачалоДня(ДатаДок)); 
		Запрос.УстановитьПараметр("Дата2", ДатаДок);

		//+Мельников 22.04.24 Отмена операции. Не учитывались операции отмены выдачи. Закомментировал старый запрос.
		//Запрос.Текст = "ВЫБРАТЬ
		//               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор,
		//               |	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаСсудыОборот) КАК СуммаСсуды
		//               |ИЗ
		//               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(
		//               |			&Дата1,
		//               |			&Дата2,
		//               |			Регистратор,
		//               |			ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
		//               |				И Залогодатель = &Залогодатель) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
		//               |
		//               |СГРУППИРОВАТЬ ПО
		//               |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор";  
		Запрос.Текст = "ВЫБРАТЬ
						|	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор,
						|	СУММА(ЛБ_ОборотыПоОперациямЗаймаОбороты.СуммаСсудыОборот) КАК СуммаСсуды
						|ИЗ
						|	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(
						|			&Дата1,
						|			&Дата2,
						|			Регистратор,
						|			ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
						|					И Залогодатель = &Залогодатель
						|				ИЛИ ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога)
						|					И Залогодатель = &Залогодатель) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
						|
						|СГРУППИРОВАТЬ ПО
						|	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор";
		//-Мельников
		Выборка = Запрос.Выполнить().Выбрать();
		СуммаСсуды = 0;
		Пока Выборка.Следующий() Цикл 
			Если ЗначениеЗаполнено(ДокументЗайма) тогда
				Если Выборка.Регистратор = ДокументЗайма Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ПакетДоговоров) И  (Выборка.Регистратор.ПакетДоговоров = ПакетДоговоров) Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	 
			СуммаСсуды = СуммаСсуды + Выборка.СуммаСсуды;
		КонецЦикла;
		Возврат СуммаСсуды;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаСервере
Процедура ЗаполнитьТовары()  
	Если ЗначениеЗаполнено(ПакетДоговоров) Тогда  
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров); 
		Запрос.Текст ="ВЫБРАТЬ
		              |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
		              |ИЗ
		              |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
		              |ГДЕ
		              |	ЛБ_ОперацияПоЗалогу.ПакетДоговоров = &ПакетДоговоров
		              |	И ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
		              |АВТОУПОРЯДОЧИВАНИЕ";
		Выборка = Запрос.Выполнить().Выбрать(); 
		Ном = 0;
		Пока Выборка.Следующий() Цикл
			НоваяСтрП = ПакетДокументов.Добавить();
			НоваяСтрП.ДокументЗайма = Выборка.Ссылка;
			НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Получить(Ном); 
			НоваяСтрП.СуммаЗайма = НоваяСтрП.ДокументЗайма.СуммаСсуды;
			СуммаПроцентовЗБ = НоваяСтрП.ДокументЗайма.ГрафикПлатежей.Итог("СуммаПроцентов");
			НоваяСтрП.ПСК = РасчетПСКГод(НоваяСтрП.СуммаЗайма, СуммаПроцентовЗБ);
			Ном = Ном + 1;
		КонецЦикла;	  		
	Иначе  
		НоваяСтрП = ПакетДокументов.Добавить();
		НоваяСтрП.ДокументЗайма = ДокументЗайма;
		НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Билет1;  
		НоваяСтрП.СуммаЗайма = НоваяСтрП.ДокументЗайма.СуммаСсуды;
		СуммаПроцентовЗБ = НоваяСтрП.ДокументЗайма.ГрафикПлатежей.Итог("СуммаПроцентов");
		НоваяСтрП.ПСК = РасчетПСКГод(НоваяСтрП.СуммаЗайма, СуммаПроцентовЗБ);
	КонецЕсли;	  
	
	Ном = 0;
	Для каждого СтрП Из ПакетДокументов Цикл    
		Если СтрП.ДокументЗайма.Проведен Тогда
			НеРедактировать = Истина;
		КонецЕсли;
		Для каждого стр Из СтрП.ДокументЗайма.Товары Цикл
			НоваяСтр = Товары.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр); 
			НоваяСтр.ВыделитьВЗалоговыйБилет = СтрП.ВыделитьВЗалоговыйБилет; 
			НоваяСтр.НомерЗалоговогоБилета = СтрП.ДокументЗайма.НомерЗалоговогоБилета; 
			НоваяСтр.Статус = ?(НеРедактировать, "Принят", "Проект");   
			НоваяСтр.Артикул = ?(НеРедактировать, ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(СтрП.ДокументЗайма, стр.НомерСтроки), "");
		Конеццикла;	 
	Конеццикла;	

КонецПроцедуры   
	
&НаСервере
Процедура ЗаполнитьТабличныеЧасти() 
	Для каждого стр Из ДокументЗайма.ДополнительныеДокументыПравоПребыванияРФ Цикл
		НоваяСтр = ДопДокументы.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;	    
	Для каждого стр Из ДокументЗайма.ПроцентныеСтавкиПоПериодам Цикл
		НоваяСтр = ПроцентныеСтавкиПоПериодам.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	Конеццикла;	 
	Для каждого СтрП Из ПакетДокументов Цикл  
		Для каждого стр Из СтрП.ДокументЗайма.Вставки Цикл
			НоваяСтр = Вставки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла;	
	    Для каждого стр Из СтрП.ДокументЗайма.ДополнительныеМеталлы Цикл
			НоваяСтр = ДополнительныеМеталлы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла;
		Для каждого стр Из СтрП.ДокументЗайма.Дефекты Цикл
			НоваяСтр = Дефекты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла;	   

		Для каждого стр Из СтрП.ДокументЗайма.ГрафикПлатежей Цикл
			НоваяСтр = ГрафикПлатежей.Добавить();
			НоваяСтр.ВыделитьВЗалоговыйБилет = СтрП.ВыделитьВЗалоговыйБилет;
			ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
		Конеццикла;
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ЦенаДрагоценногоКамня(Идентификатор, ИдентификаторТовары) 
	СтрокаТабличнойЧасти 				  = Вставки.НайтиПоИдентификатору(Идентификатор);
	СтрокаТабличнойЧастиТовары 			  = Товары.НайтиПоИдентификатору(ИдентификаторТовары);
	
	Если СтрокаТабличнойЧасти.НеОценивать Тогда
        СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;
	Иначе           
		СтруктураВставки = новый Структура; 
		СтруктураВставки.Вставить("Дата", ДатаДок); 
		СтруктураВставки.Вставить("Ломбард", Ломбард);
		СтруктураВставки.Вставить("ВидВставки", СтрокаТабличнойЧасти.ВидВставки);
		СтруктураВставки.Вставить("ФормаОгранки", СтрокаТабличнойЧасти.ФормаОгранки);
        СтруктураВставки.Вставить("ВидОгранки", СтрокаТабличнойЧасти.ВидОгранки);
        СтруктураВставки.Вставить("КачествоОгранки", СтрокаТабличнойЧасти.КачествоОгранки);
        СтруктураВставки.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧасти.ЕдиницаИзмерения);
		//+Мельников 23.09.24 ВИП. Заявка 2792
        СтруктураВставки.Вставить("Залогодатель", Залогодатель);
        СтруктураВставки.Вставить("СхемаКредитования", СхемаКредитования);

		//+Мельников 24.07.24 Для расчета суммы от единицы, а не общего веса
		//СтруктураВставки.Вставить("Вес", ?(СтрокаТабличнойЧасти.ЕдиницаИзмерения.Код = "162", СтрокаТабличнойЧасти.вес, СтрокаТабличнойЧасти.ВесГраммы));
        СтруктураВставки.Вставить("Вес", ?(СтрокаТабличнойЧасти.ЕдиницаИзмерения.Код = "162", СтрокаТабличнойЧасти.ВесШтКар, СтрокаТабличнойЧасти.ВесГраммыШт));
		//-Мельников
		
		Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуДрагоценногоКамняИзПрейскуранта(СтруктураВставки);
	    СтрокаТабличнойЧасти.Цена = Результат.Цена;  
		СтрокаТабличнойЧасти.Приказ = Результат.Приказ;
		//+МАН 10.12.25
		СтрокаТабличнойЧасти.ПриказВИПВставки = Результат.ПриказВИПВставки;
		//-МАН
	    СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * ?(НЕ СтрокаТабличнойЧасти.ЭтоВесовой, СтрокаТабличнойЧасти.Количество, СтрокаТабличнойЧасти.Вес), 2);
	КонецЕсли;	
КонецПроцедуры   

&НаСервере 
Функция ОкруглитьСуммуСсуды(Сумма)
	Если ЭтаФорма.Округление Тогда
	    Возврат ЛБ_УправлениеЛомбардом.ОкруглитьСуммуСсудыПоНастройкам(ДатаДок, Организация, Сумма);
	Иначе
		Возврат Сумма;
	КонецЕсли;	
КонецФункции	

&НаСервере
Процедура РасчетСуммыОценкиИтоговой()
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата", ДатаДок);
	СтруктураПараметров.Вставить("Ломбард", Ломбард);
	СтруктураПараметров.Вставить("СхемаКредитования", СхемаКредитования);
	//+Мельников 23.09.24 Добавлен Залогодатель. ВИП. Заявка 2792
	СтруктураПараметров.Вставить("Залогодатель", Залогодатель);
	//-Мельников
	Для каждого Стр Из Товары Цикл 
		СтруктураПараметров.Вставить("Проба", Стр.Проба);
		СтруктураПараметров.Вставить("Категория", Стр.Категория);
		СтруктураПараметров.Вставить("ЕдиницаИзмерения", Стр.ЕдиницаИзмерения);
		
		Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуМеталлаИзПрейскуранта(СтруктураПараметров);
		Стр.Цена = Результат.Цена;  
		Стр.Приказ = Результат.Приказ;
		//+МАН 10.12.25
		Стр.ПриказВИПМеталлы = Результат.ПриказВИПМеталлы;
		//-МАН
	    Стр.СуммаОценкиМеталлы = Стр.ВесЧистый*Стр.Цена; 
		ОтборВ = Новый Структура;
		ОтборВ.Вставить("КлючСтроки", Стр.КлючСтроки);
		Строки = Вставки.НайтиСтроки(ОтборВ);
	    СуммаОценкиКамни = 0;		
		Для каждого СтрВ Из Строки Цикл	
	        ЦенаДрагоценногоКамня(СтрВ.ПолучитьИдентификатор(), Стр.ПолучитьИдентификатор());
		    СуммаОценкиКамни = СуммаОценкиКамни + СтрВ.Сумма; 
		КонецЦикла;		
	    Стр.СуммаОценкиКамни = СуммаОценкиКамни;
	    
		ОтборДоп = Новый Структура;
		ОтборДоп.Вставить("КлючСтроки", Стр.КлючСтроки);
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);
		Для каждого СтрДоп Из СтрокиДоп Цикл  
			СтруктураПараметров.Вставить("Проба", СтрДоп.Проба);
		    СтруктураПараметров.Вставить("Категория", СтрДоп.Категория);
		    СтруктураПараметров.Вставить("ЕдиницаИзмерения", СтрДоп.ЕдиницаИзмерения);
			
			Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуМеталлаИзПрейскуранта(СтруктураПараметров);
			СтрДоп.Цена = Результат.Цена;  
			СтрДоп.Приказ = Результат.Приказ;
			//+МАН 10.12.25
			СтрДоп.ПриказВИПМеталлы = Результат.ПриказВИПМеталлы;
			//-МАН
         	СтрДоп.СуммаОценкиМеталлы = СтрДоп.Цена*СтрДоп.ВесЧистый;
			Стр.СуммаОценкиМеталлы = Стр.СуммаОценкиМеталлы + СтрДоп.СуммаОценкиМеталлы;
		Конеццикла;	
		Стр.СуммаОценки = Стр.СуммаОценкиМеталлы + Стр.СуммаОценкиКамни;
		
		РасчетМаксимальнойСуммыОценки(Стр.ПолучитьИдентификатор());
		Если Стр.СуммаСсуды > Стр.СуммаОценкиМаксимальная Тогда
			Стр.СуммаСсуды = Стр.СуммаОценкиМаксимальная;
		КонецЕсли;	
	КонецЦикла;	
	СуммаЗайма = ОкруглитьСуммуСсуды(Товары.Итог("СуммаОценкиМаксимальная")); 
	РаспределитьСуммуЗайма();                                                 
	ТоварыИтоги();
	УстановитьТекстСуммаЗаймаДень();
КонецПроцедуры  

&НаСервере
Процедура РаспределитьСуммуЗайма()
    СуммаДляРаспределения = СуммаЗайма;
	Если СуммаДляРаспределения = 0 Тогда
		Возврат;
	КонецЕсли;	 
	//МаксимальнаяОценкаИтог = Товары.Итог("СуммаОценкиМаксимальная");  
	//Если МаксимальнаяОценкаИтог = 0 Тогда  
	ОценкаИтог = Товары.Итог("СуммаОценки");  
	Если ОценкаИтог = 0 Тогда 
        Возврат;  
	КонецЕсли;	  
	НомСтрМакс = 0; 
	МаксОценка = 0;  
	Коэфф = СуммаЗайма/ОценкаИтог;
	
	НомСтр = 0;
	Для каждого Стр Из Товары Цикл  
		НомСтр = НомСтр + 1;
		//Коэфф = Стр.СуммаОценкиМаксимальная/МаксимальнаяОценкаИтог;
		//Стр.СуммаСсуды = СуммаЗайма*Коэфф; 
		Стр.СуммаСсуды = Стр.СуммаОценки*Коэфф;
		Стр.СуммаОценкиМаксимальная = Стр.СуммаСсуды;
		Если Стр.СуммаОценкиМаксимальная < Стр.СуммаОценки Тогда
			Стр.СуммаОценкиМаксимальная = Стр.СуммаОценки;
		КонецЕсли;	  
		СуммаДляРаспределения = СуммаДляРаспределения - Стр.СуммаСсуды; 
		Если Стр.СуммаОценкиМаксимальная > МаксОценка Тогда
			МаксОценка = Стр.СуммаОценкиМаксимальная;  
			НомСтрМакс = НомСтр-1;
		КонецЕсли;	
	КонецЦикла;    
	
	Если НЕ СуммаДляРаспределения = 0 Тогда
		Стр = Товары.Получить(НомСтрМакс);
		Стр.СуммаСсуды = Стр.СуммаСсуды + СуммаДляРаспределения;   
		Стр.СуммаОценкиМаксимальная = Стр.СуммаСсуды;
		Если Стр.СуммаОценкиМаксимальная < Стр.СуммаОценки Тогда
			Стр.СуммаОценкиМаксимальная = Стр.СуммаОценки;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры
             
&НаСервере
Процедура ЗаполнитьТаблицуСтавок() 
	ПроцентныеСтавкиПоПериодам.Очистить();
	ТаблицаСтавок.Очистить();       
	СуммаЗаймаРасчеты = СуммаЗайма + СуммаЗаймаДень;    
	Если ЭтоСотрудник И РасчетСотрудникаДоп Тогда
		//+Мельников 24.09.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
		ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(ДатаДок, Ломбард, СхемаКредитования, Акция, ДопСтатусСотрудник, СписокДопСтатусов, СуммаЗаймаРасчеты, Залогодатель);
	Иначе	
		//+Мельников 24.09.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
	    ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(ДатаДок, Ломбард, СхемаКредитования, Акция, СтатусЗалогодателя, СписокДопСтатусов, СуммаЗаймаРасчеты, Залогодатель);
	КонецЕсли;
	Если НЕ ТаблицаС.Количество() = 0 Тогда 
		СтрС = ТаблицаС.Получить(0);
		ПриказСтавки = СтрС.Приказ;
		ПриказАкцияСтавки = СтрС.ПриказАкция;
		//+МАН 10.12.25
		ПриказВИПСтавки = СтрС.ПриказВИП;
		//-МАН

		ПроцентныеСтавкиПоПериодам.Загрузить(ТаблицаС);
		
		Отбор = Новый структура;
		Отбор.Вставить("ПричинаПрименения", ПричинаПримененияПроцентнойСхемы); 
		СтрокиП = ПроцентныеСтавкиПоПериодам.НайтиСтроки(Отбор); 
		Для каждого СтрП из строкиП цикл 
			НоваяСтр = ТаблицаСтавок.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрП);
		КонецЦикла;	
		
		ОтборС = Новый Структура;
		ОтборС.Вставить("ДеньНачалаПрименения", 1);
		СтрокиС = ТаблицаСтавок.НайтиСтроки(ОтборС); 
		Если НЕ СтрокиС.Количество() = 0 Тогда 
			СтрС = СтрокиС.Получить(0);	 
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая Тогда 
				ПроцентнаяСхема = СтрС.ПроцентнаяСтавка;
			ИначеЕсли СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда	
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда 
					ПроцентнаяСхема = СтрС.ПроцентнаяСтавкаАкция; 
					ОтклонениеПоАкции = Ложь;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					ПроцентнаяСхема = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
					ОтклонениеПоАкции = Истина;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда
					ПроцентнаяСхема = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
					ОтклонениеПоАкции = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры	  

&НаСервере
Функция РассчитатьСуммуПроцентов(ВыделитьВЗалоговыйБилет)  
	Отбор = Новый Структура;
	Отбор.Вставить("ВыделитьВЗалоговыйБилет", ВыделитьВЗалоговыйБилет); 
	Строки = ГрафикПлатежей.НайтиСтроки(Отбор);
	Для каждого стр Из строки Цикл
	   ГрафикПлатежей.Удалить(Стр);    
	КонецЦикла;
	Если НЕ ПроцентнаяСхема = 0 Тогда   		
		СтруктураОкругления = новый Структура;
		СтруктураОкругления.Вставить("ОкруглятьЦены", ОкруглятьПроценты);  
		СтруктураОкругления.Вставить("ВидОкругленияСуммыПроцентов", ВидОкругленияСуммыПроцентов);
		СтруктураОкругления.Вставить("ПорядокОкругления", ПорядокОкругления);  
		СтруктураОкругления.Вставить("ОкруглятьВБольшуюСторону", ОкруглятьВБольшуюСторону);  
		
		//ДатаНачала = НачалоДня(ДатаДок);  
		//Если НачислятьПроцентыЗаДеньЗалога Тогда  
		//	ДатаНачала = НачалоДня(ДатаНачала);
		//Иначе	
		//	ДатаНачала = НачалоДня(ДатаНачала + (60 * 60 * 24));
		//КонецЕсли;   
		СуммаПроцентов = 0;
		Строки = ПакетДокументов.НайтиСтроки(Отбор);
		Для каждого Стр из Строки Цикл
			ДатаНачала = ЛБ_УправлениеЛомбардом.ПолучитьДатуНачалаРасчетаПроцентов(ДатаДок, Константы.ЛБ_ОсновнаяОрганизация.Получить());
			
			Для сч = 0 По ТаблицаСтавок.Количество()-1 Цикл 
				СтрС = ТаблицаСтавок.Получить(сч); 
				Если СтрС.ДеньНачалаПрименения = 1 Тогда
					ДатаНач = ДатаНачала;
				Иначе 
					ДатаНач = НачалоДня(ДатаНачала-1) + СтрС.ДеньНачалаПрименения*(60 * 60 * 24);
				КонецЕсли;	
				Если ДатаНач > ДатаВыкупа Тогда 
			 		Прервать;
				КонецЕсли;	
				
				сч1 = сч + 1;
				Если сч1 >= ТаблицаСтавок.Количество() Тогда
					ДатаКон = ДатаВыкупа; 
					ДеньКон = СрокЗалога;
				Иначе   
					СтрС1 = ТаблицаСтавок.Получить(сч1);
					ДатаКонца = НачалоДня(ДатаНачала-1) + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24); 
					Если ДатаКонца > ДатаВыкупа Тогда
						ДатаКон = ДатаВыкупа;
						ДеньКон = СрокЗалога;
					Иначе
						ДатаКон = ДатаКонца; 
						ДеньКон = СтрС1.ДеньНачалаПрименения-1;
					КонецЕсли;	
				КонецЕсли;	
				
				Если НЕ (НачалоДня(ДатаКон) < НачалоДня(ДатаНач)) тогда
					СтавкаП = СтрС.ПроцентнаяСтавка; 
					Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
						Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
							СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
						ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
							СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
						ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
							СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
					    КонецЕсли; 
					КонецЕсли;	              
				    Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, СтавкаП, Стр.СуммаЗайма, СтруктураОкругления);
					СуммаПроцентов = СуммаПроцентов + Результат.СуммаПроцентов; 
					Если СтрС.ДеньНачалаПрименения = 1 Тогда
			            СуммаПроцентовДень = Результат.СуммаПроцентовДень;				
					КонецЕсли;	
					СтрП = ГрафикПлатежей.Добавить();  
					СтрП.ВыделитьВЗалоговыйБилет = Стр.ВыделитьВЗалоговыйБилет;
					СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
					СтрП.ДатаНач = ДатаНач;
					СтрП.ДатаКон = ДатаКон;
					СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
					СтрП.ДеньКон = ДеньКон; 
					СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
					СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
					СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
					СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
	                СтрП.СуммаПроцентов = Результат.СуммаПроцентов;
					СтрП.СуммаПроцентовДень = СуммаПроцентовДень; 
					СтрП.ВыделитьВЗалоговыйБилет = ВыделитьВЗалоговыйБилет;   					
				КонецЕсли;	
			Конеццикла;	 
		КонецЦикла;	
	Иначе
		СуммаПроцентов = 0;
		СуммаПроцентовДень = 0;
	КонецЕсли;
	Возврат СуммаПроцентов;
КонецФункции	

&НаСервере
Процедура ЗаполнитьИнфорациюОЗалогодателе(Параметры)
	Если Параметры.Свойство("ДокументЗалогодателя") Тогда
		ДокументЗалогодателя = Параметры.ДокументЗалогодателя; 
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();
	КонецЕсли;	
	ЗаполнитьКонтакнуюИнформациюЗалогодателя();
	КонтактнаяИнформацияВСтроку();
КонецПроцедуры 

&НаСервере
Процедура ИнформацияОДокументеВСтроку()
	Информация = "";
	Информация = СокрЛП(ДокументВид);
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументСерия), " " + СокрЛП(ДокументСерия), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументНомер), " " + СокрЛП(ДокументНомер), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументКемВыдан), " выдан " + СокрЛП(ДокументКемВыдан), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументДатаВыдачи), " " + Формат(ДокументДатаВыдачи,"ДФ=dd.MM.yyyy"), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументКодПодразделения), " код подр. " + СокрЛП(ДокументКодПодразделения), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументНачалоДействия), " действует с " + Формат(ДокументНачалоДействия,"ДФ=dd.MM.yyyy"), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДокументСрокДействия), " по " + Формат(ДокументСрокДействия,"ДФ=dd.MM.yyyy"), "");
	Паспорт = Информация;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюОДокументеЗалогодателя()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);  
	Запрос.УстановитьПараметр("ДокументЗалогодателя", ДокументЗалогодателя);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
		               |ИЗ
		               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
		               |			&Дата,
		               |			ДокументЗалогодателя = &ДокументЗалогодателя
		               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя;
		ДокументВид = Выборка.ВидДокумента;
		ДокументГражданство = Выборка.Гражданство;
		ДокументСерия = Выборка.ДокументСерия;
		ДокументНомер = Выборка.ДокументНомер;
		ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи;
		ДокументКемВыдан = Выборка.ДокументКемВыдан;
		ДокументКодПодразделения = Выборка.ДокументКодПодразделения;
		ДокументНачалоДействия = Выборка.ДокументНачалоДействия;
		ДокументСрокДействия = Выборка.ДокументСрокДействия;  
	Иначе
		ДокументВидДокументаЗалогодателя = справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
		ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПустаяСсылка();
		ДокументГражданство = Справочники.СтраныМира.ПустаяСсылка();
		ДокументСерия = "";
		ДокументНомер = "";
		ДокументДатаВыдачи = Дата(1,1,1);
		ДокументКемВыдан = "";
		ДокументКодПодразделения = "";
		ДокументНачалоДействия = Дата(1,1,1);
		ДокументСрокДействия = Дата(1,1,1); 
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура КонтактнаяИнформацияВСтроку()
	Информация = "";
	Информация = Информация + ?(ЗначениеЗаполнено(Гражданство), СокрЛП(Гражданство), "");
	Информация = Информация + ?(ЗначениеЗаполнено(Пол), ?(ПустаяСтрока(Информация), "", "; ") + "пол.: " + Строка(Пол), "");
	Информация = Информация + ?(ЗначениеЗаполнено(ДатаРождения), ?(ПустаяСтрока(Информация), "", "; ") + "дата рожд.: " +  Формат(ДатаРождения, "ДФ=dd.MM.yyyy"), "");
	Информация = Информация + ?(ЗначениеЗаполнено(МестоРождения), ?(ПустаяСтрока(Информация), "", "; ") + "место рожд.: " +  СокрЛП(МестоРождения), "");
	Информация = Информация + ?(ЗначениеЗаполнено(Телефон), ?(ПустаяСтрока(Информация), "", "; ") + "тел.: " + СокрЛП(Телефон), "");
	Информация = Информация + ?(ЗначениеЗаполнено(Email), ?(ПустаяСтрока(Информация), "", "; ") + "email: " + СокрЛП(Email), "");    
	Если ЗначениеЗаполнено(АдресПоПрописке) Тогда
		АдресК = "адрес по прописке: " + СокрЛП(АдресПоПрописке);
	Иначе  
		АдресК = "фактический адрес: " + СокрЛП(ФактическийАдрес);
	КонецЕсли;	
	Информация = Информация + ?(ПустаяСтрока(Информация), "", "; ") + АдресК;

	КонтактнаяИнформация = Информация;
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьКонтакнуюИнформациюЗалогодателя()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
                   |ИЗ
                   |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Фамилия = Выборка.Фамилия;
        Имя = Выборка.Имя;
        Отчество = Выборка.Отчество;		
		ДатаРождения = Выборка.ДатаРождения;		
		Гражданство = Выборка.Гражданство;
		Пол = Выборка.Пол;
		МестоРождения = МестоРождения;
		Email = Выборка.Email;
		Телефон = Выборка.Телефон;		
		АдресПоПрописке = Выборка.АдресПоПрописке; 
		ФактическийАдрес = Выборка.ФактическийАдрес;
		ФИО = Фамилия + " " + Имя + ?(ПустаяСтрока(Отчество), "", " " + Отчество);  
	Иначе
		Фамилия = "";
        Имя = "";
        Отчество = "";		
		ДатаРождения = "";		
		Гражданство = Справочники.СтраныМира.ПустаяСсылка();
		Пол = перечисления.ПолФизическогоЛица.ПустаяСсылка();
		МестоРождения = "";
		Email = "";
		Телефон = "";		
		АдресПоПрописке = ""; 
		ФактическийАдрес = "";
		ФИО = "";  
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуДопСтатусовКлиента() 		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателей.Ссылка КАК Статус
	               |ИЗ
	               |	Справочник.ЛБ_СтатусыЗалогодателей КАК ЛБ_СтатусыЗалогодателей
	               |ГДЕ
	               |	ЛБ_СтатусыЗалогодателей.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ЭтоГруппа = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную = ИСТИНА
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаДопСтатусов.Загрузить(ТаблицаЗапроса); 
	Новаястр = ТаблицаДопСтатусов.Добавить();
	НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;
КонецПроцедуры	

&НаСервере
Процедура ПолучитьДопСтатусыКлиента()  
	//очистим таблицу доп. статусов
	Для каждого Стр Из ТаблицаДопСтатусов Цикл 
		Стр.Используется = ложь;	
	КонецЦикла;	  
	
	Клиент = Залогодатель;
	ДатаРождения = ДатаРождения;
	Пол = Пол;	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Залогодатель", Клиент);  
	Запрос.УстановитьПараметр("Дата", ДатаДок); 
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1)); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И Статус = &Статус
	               |				И ВЫБОР
	               |					КОГДА СрокДействия = &ПустаяДата
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ВЫБОР
				   //+МАН 15.08.25 Исправил, чтобы срок действия учитывался как крнец дня
	               //|							КОГДА СрокДействия < &Дата
	               |							КОГДА КОНЕЦПЕРИОДА(СрокДействия, ДЕНЬ) < &Дата
				   //-МАН
	               |								ТОГДА ЛОЖЬ
	               |							ИНАЧЕ ИСТИНА
	               |						КОНЕЦ
	               |				КОНЕЦ) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних
	               |
				   //+МАН 13.01.25 Иначе статус ВИП не корректно подбирался. Заявка 2792.
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Период УБЫВ";
				   //-МАН
	Для каждого Стр Из ТаблицаДопСтатусов Цикл  
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется; 
			Если Выборка.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник Тогда  
				Если стр.Используется Тогда 
					ЭтоСотрудник = Истина;
				Иначе
					ЭтоСотрудник = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;   
	
	Если ЭтоСотрудник Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Сотрудник);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл
		Если СтрС.Используется Тогда
		    СписокДопСтатусов.Добавить(СтрС.Статус);
		КонецЕсли;	
	Конеццикла;	 
	
КонецПроцедуры

&НаСервере
Процедура СтатусыКлиентаВСтроку()
	СтатусыЗалогодателя = сокрЛП(СтатусЗалогодателя);
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл 
		Если СтрС.Используется Тогда 
		    СтатусыЗалогодателя = СтатусыЗалогодателя + ?(ПустаяСтрока(СтатусыЗалогодателя), "", "; " + СокрЛП(СтрС.Статус));
		конецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ОбработатьСхемуКредитованияНаСервере()	
	БезПродленияДоговора = СхемаКредитования.БезПродленияДоговора;
    ПризнакПримененияГибкогоПроцента = СхемаКредитования.ПризнакПримененияГибкогоПроцента;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("СхемаКредитования", СхемаКредитования);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УсловияПредоставленияКредитаСрезПоследних.СрокЗалога КАК СрокЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		СрокЗалога = Выборка.СрокЗалога;
		ЗаполнитьДатуВыкупа();
		ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
	КонецЕсли;	  
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.НачислятьПроцентыЗаДеньЗалога КАК НачислятьПроцентыЗаДеньЗалога,
	               |	УсловияПредоставленияКредита.НеНачислятьПроцентыЗаПоследнийДень КАК НеНачислятьПроцентыЗаПоследнийДень,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуПроценты КАК ОкруглятьПроценты,
	               |	УсловияПредоставленияКредита.ПорядокОкругленияПроценты КАК ПорядокОкругления,
	               |	УсловияПредоставленияКредита.ОкруглятьВБольшуюСторонуПроценты КАК ОкруглятьВБольшуюСторону,
	               |	УсловияПредоставленияКредита.ВидОкругленияСуммыПроцентов КАК ВидОкругленияСуммыПроцентов,
	               |	УсловияПредоставленияКредита.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа КАК СчитатьПроцентыДеньВыдачиРавенДеньВыкупа,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуОценка КАК ОкруглятьОценка
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
		НачислятьПроцентыЗаДеньЗалога = Выборка.НачислятьПроцентыЗаДеньЗалога;
		НеНачислятьПроцентыЗаПоследнийДень = Выборка.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Выборка.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
		ОкруглятьПроценты = Выборка.ОкруглятьПроценты;
		ПорядокОкругления = Выборка.ПорядокОкругления;
        ОкруглятьВБольшуюСторону = Выборка.ОкруглятьВБольшуюСторону;
        ВидОкругленияСуммыПроцентов = Выборка.ВидОкругленияСуммыПроцентов;
		ОкруглятьЦены = Выборка.ОкруглятьОценка;
    КонецЕсли;
	
	ПроцентУвеличенияОценкиЗалога = 0;

	МассивС = Новый Массив;
	МассивС.Добавить(СтатусЗалогодателя); 
	МассивС.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.ПустаяСсылка()); 
	Для каждого Эл Из СписокДопСтатусов Цикл  
		МассивС.Добавить(Эл.Значение);
	Конеццикла; 
	Запрос.УстановитьПараметр("СтатусыЗалогодателя", МассивС); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних";
	ВыборкаДок = Запрос.Выполнить().Выбрать();
	Если ВыборкаДок.Следующий() Тогда   
		Запрос.УстановитьПараметр("Регистратор", ВыборкаДок.Регистратор);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.УвеличениеСтоимостиЗалога КАК УвеличениеСтоимостиЗалога
		               |ИЗ
		               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних(, СтатусЗалогодателя В (&СтатусыЗалогодателя)) КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних
		               |ГДЕ
		               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.Регистратор = &Регистратор";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПроцентУвеличенияОценкиЗалога = Выборка.УвеличениеСтоимостиЗалога;  
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьДатуВыкупа() 
	ДатаВыкупа = НачалоДня(ДатаДок) + 86401*СрокЗалога;  
	ДатаВыкупа = ЛБ_УправлениеЛомбардом.ИсключитьДатаВыкупаПразничныйДень(ДатаВыкупа);
КонецПроцедуры  

&НаСервере
Функция ПолучитьЛьготнуюДатуВыкупа()
    Возврат ЛБ_УправлениеЛомбардом.ПолучитьЛьготныйСрокЗалоговогоБилета(ДатаВыкупа); 
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокЛьготныхСтатусов() 
	СписокЛьготныхСтатусов.Очистить();
	
	//Проверим нового клиента
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(ДокументЗайма), Новый Граница(Новый МоментВремени(ДокументЗайма.Дата, ДокументЗайма), ВидГраницы.Исключая), ДатаДок));
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОперацииПоСистемеЛояльностиОбороты.КоличествоЗалоговОборот КАК КоличествоЗалогов
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОперацииПоСистемеЛояльности.Обороты(, &Дата, , Залогодатель = &Залогодатель) КАК ЛБ_ОперацииПоСистемеЛояльностиОбороты";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда   
		Если НЕ Выборка.КоличествоЗалогов = 0 Тогда
			СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.НовыйКлиент);
		КонецЕсли;	
	Иначе	
		СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.НовыйКлиент);
	КонецЕсли;
	
	//проверим пенсионер по возрасту 
	ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
	Если ЗначениеЗаполнено(ВозрастЗалогодателя) И ЗначениеЗаполнено(Пол) Тогда
		Если Пол = Перечисления.ПолФизическогоЛица.Женский Тогда 
			Если  ВозрастЗалогодателя  >= 55 Тогда  
				СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Пенсионер);
			КонецЕсли;	
		ИначеЕсли  Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
			Если  ВозрастЗалогодателя  >= 60 Тогда  
				СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Пенсионер);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	//проверим льготные документы   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ДокументыЗалогодателя.ВидДокумента КАК ВидДокумента,
	              |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК СрокДействия
	              |ИЗ
	              |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
	              |		ПО ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка
	              |ГДЕ
	              |	ЛБ_ДокументыЗалогодателя.ПометкаУдаления = ЛОЖЬ
	              |	И ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент)
	              |	И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен = ЛОЖЬ
	              |	И ЛБ_ДокументыЗалогодателя.Владелец = &Залогодатель";
	Выборка = Запрос.Выполнить().Выбрать();   
	ДатаПроверки = ДатаДок;
	Пока Выборка.Следующий() цикл
		Если НЕ (Выборка.СрокДействия = Дата(1,1,1)) Тогда
			Если Выборка.СрокДействия < ДатаПроверки Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		Строки = ТаблицаСоответствия.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;     
		Стр = Строки.Получить(0);
		Если СписокЛьготныхСтатусов.НайтиПоЗначению(Стр.Статус) = неопределено  Тогда
			СписокЛьготныхСтатусов.Добавить(Стр.Статус);
		КонецЕсли;	
	КонецЦикла;	  
	Если ЭтоСотрудник Тогда
	    СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Сотрудник);
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ПолучитьДоступныеПроцентныеСхемыАкции() 
	СуммаЗаймаРасчет = СуммаЗаймаДень + СуммаЗайма; 
	Если ЭтоСотрудник тогда 
		РасчетСотрудникаДоп = Ложь;
		Если ЕстьЛьготыСотрудника Тогда
			Если (СуммаЗаймаПоЛьготамСотрудника >= СуммаЗайма) тогда
				ИзменитьСписокЛьготныхСтатусовСотрудника();
				ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
			Иначе        
				ИзменитьСписокЛьготныхСтатусовСотрудника(Ложь);
				Если ЗначениеЗаполнено(ДопСтатусСотрудник) Тогда
					РасчетСотрудникаДоп = Истина;
					ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, ДопСтатусСотрудник, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
				Иначе      
			        ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
				КонецЕсли;	 
			КонецЕсли;	
		Иначе 
			Если ЗначениеЗаполнено(ДопСтатусСотрудник) Тогда
				РасчетСотрудникаДоп = Истина;
				ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, ДопСтатусСотрудник, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
			Иначе      
		        ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
			КонецЕсли;	
		КонецЕсли;	
	Иначе		
		//+МАН 24.12.24 Добавил передачу залогодателя для дальнейшей проверки на наличие действующих условий по процентным ставкам. Заявка 2792.
	    //Было: ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель); 
		ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель, Залогодатель);
	КонецЕсли;	
	НомерСтроки = 0;                                                                                                                                                   
	ТаблицаВыбораСхемыКредитованияАкции.Очистить();
	Если НЕ ТаблицаЗапроса = неопределено Тогда
		Для каждого стрЗ Из ТаблицаЗапроса Цикл
			//+Мельников 24.07.24 Из списка убраны акции Промокод и Предъявитель Заявка 2582
			Если стрЗ.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.НаПредъявителя ИЛИ стрЗ.Акция.ВидАкции = Перечисления.ЛБ_ВидыАкций.ПоПромокоду Тогда
				Продолжить;
			КонецЕсли;
			//-Мельников
		    НоваяСтрСК = ТаблицаВыбораСхемыКредитованияАкции.Добавить();
			НоваяСтрСК.НомерСтроки = НомерСтроки; 
			НоваяСтрСК.СхемаКредитования = стрЗ.СхемаКредитования;
			НоваяСтрСК.Акция = стрЗ.Акция;  			
			НоваяСтрСК.Приоритет = стрЗ.Приоритет; 
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;	  
		ТаблицаВыбораСхемыКредитованияАкции.Сортировать("Приоритет Убыв"); 
	конецЕсли;	
КонецПроцедуры   

