//+Мельников 18.07.24 Взята оригинальная процедура "ЗаполнитьТаблицуСтавок" и добавлен перебор доступных схем
&НаСервере
Процедура ПодборОптимальнойСтавки()
	ПроцентныеСтавкиПоПериодам.Очистить();
	ТаблицаСтавок.Очистить();       
	СуммаЗаймаРасчеты = СуммаЗайма + СуммаЗаймаДень;

	тзСхем = Новый ТаблицаЗначений;
	тзСхем.Колонки.Добавить("СхемаКредитования");
	тзСхем.Колонки.Добавить("Акция");
	тзСхем.Колонки.Добавить("Ставка");

	Для каждого СтрСхема Из ТаблицаВыбораСхемыКредитованияАкции Цикл
		
		Если ЭтоСотрудник И РасчетСотрудникаДоп Тогда
			//+МАН 10.12.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
			ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(ДатаДок, Ломбард, СтрСхема.СхемаКредитования, СтрСхема.Акция, ДопСтатусСотрудник, СписокДопСтатусов, СуммаЗаймаРасчеты, Залогодатель);
		Иначе	
			//+МАН 10.12.24 Добавлен параметр "Залогодатель". ВИП. Заявка 2792
			ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(ДатаДок, Ломбард, СтрСхема.СхемаКредитования, СтрСхема.Акция, СтатусЗалогодателя, СписокДопСтатусов, СуммаЗаймаРасчеты, Залогодатель);
		КонецЕсли;
		
		Если НЕ ТаблицаС.Количество() = 0 Тогда  
			СтрС = ТаблицаС.Получить(0);
			ПриказСтавки = СтрС.Приказ;
			ПриказАкцияСтавки = СтрС.ПриказАкция;
			//+МАН 10.12.25
			ПриказВИПСтавки = СтрС.ПриказВИП;
			//-МАН

			ПроцентныеСтавкиПоПериодам.Загрузить(ТаблицаС);
			
			Отбор = Новый структура;
			Отбор.Вставить("ПричинаПрименения", ПричинаПримененияПроцентнойСхемы); 
			СтрокиП = ПроцентныеСтавкиПоПериодам.НайтиСтроки(Отбор); 
			Для каждого СтрП из строкиП цикл 
				НоваяСтр = ТаблицаСтавок.Добавить(); 
				ЗаполнитьЗначенияСвойств(НоваяСтр, СтрП);
			КонецЦикла;	
			
			ОтборС = Новый Структура;
			ОтборС.Вставить("ДеньНачалаПрименения", 1);
			СтрокиС = ТаблицаСтавок.НайтиСтроки(ОтборС); 
			Если НЕ СтрокиС.Количество() = 0 Тогда 
				СтрС = СтрокиС.Получить(0);	
				Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая Тогда 
					Ставка = СтрС.ПроцентнаяСтавка;
				ИначеЕсли СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда	
					Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда 
						Ставка = СтрС.ПроцентнаяСтавкаАкция;                            
						ОтклонениеПоАкции = Ложь;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
						Ставка = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное; 
						ОтклонениеПоАкции = Истина;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда
						Ставка = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
						ОтклонениеПоАкции = Истина;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		НоваяСтрока = тзСхем.Добавить();
		НоваяСтрока.СхемаКредитования = СтрСхема.СхемаКредитования;
		НоваяСтрока.Акция = СтрСхема.Акция;
		НоваяСтрока.Ставка = Ставка;

		ТаблицаСтавок.Очистить();       

	КонецЦикла;
	
	тзСхем.Сортировать("Ставка Возр");
	
	НомСтр = 1;
	
	МинСхема = Новый Структура;
		
	Для каждого СтрСхем Из тзСхем Цикл
	
		Если НомСтр = 1 Тогда
			
			МинСхема.Вставить("СхемаКредитования", СтрСхем.СхемаКредитования);
			МинСхема.Вставить("Акция", СтрСхем.Акция);
			МинСхема.Вставить("Ставка", СтрСхем.Ставка);
			
		ИначеЕсли СтрСхем.Ставка < МинСхема.Ставка Тогда
			
			МинСхема.Вставить("СхемаКредитования", СтрСхем.СхемаКредитования);
			МинСхема.Вставить("Акция", СтрСхем.Акция);
			МинСхема.Вставить("Ставка", СтрСхем.Ставка);
			
		КонецЕсли;
		
		Если СтрСхем.Ставка <= МинСхема.Ставка И ЗначениеЗаполнено(СтрСхем.Акция) Тогда

			МинСхема.Вставить("СхемаКредитования", СтрСхем.СхемаКредитования);
			МинСхема.Вставить("Акция", СтрСхем.Акция);
			МинСхема.Вставить("Ставка", СтрСхем.Ставка);

		КонецЕсли;
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	//СхемаКредитования = тзСхем[0].СхемаКредитования;
	//Акция = тзСхем[0].Акция;
	//ПроцентнаяСхема = тзСхем[0].Ставка;

	СхемаКредитования = МинСхема.СхемаКредитования;
	ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
	Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
		 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
	КонецЕсли; 

	Акция = МинСхема.Акция;
	ПроцентнаяСхема = МинСхема.Ставка;
	
КонецПроцедуры

//+Мельников 18.07.24 Взята процедура "ПодборОптимальнойСтавки" и адаптирована под функцию для вывода сообщения
