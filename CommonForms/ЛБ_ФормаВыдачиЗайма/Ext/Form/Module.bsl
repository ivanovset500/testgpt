//+МАН 22.10.24 Исправление подвала вставок. Старое расчитывало по всем вставкам, без учета ОЗ. Заявка 2735
&НаКлиенте
Процедура ВставкиИтогиНаКлиенте()
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	Если СтрокаТабличнойЧастиТовары <> Неопределено Тогда
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);

		ВставкиИтогКоличество = СтруктураР.Количество;
		ВставкиИтогВесК = СтруктураР.ВесКарат;
		ВставкиИтогВесГ = СтруктураР.Вес;
		ВставкиИтогОценка = СтруктураР.Сумма;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДопМеталлыИтогиНаКлиенте()
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	Если СтрокаТабличнойЧастиТовары <> Неопределено Тогда
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);

		ДополнительныеМеталлыИтогВес = СтруктураР.ВесДопМеталлов;
		ДополнительныеМеталлыИтогОценка = СтруктураР.СуммаДопМеталлов;
	КонецЕсли;
КонецПроцедуры

//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
&НаКлиенте
Процедура ТоварыВес30ПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти.Вес <> 0 Тогда
		ВесМ = СтрокаТабличнойЧасти.Вес;    	
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧасти.КлючСтроки);
		ВесМ = Цел((ВесМ - СтруктураР.Вес)*100)/100;
		
		ОтборДоп = Новый Структура;
		ОтборДоп.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки); 
		
		ВесДоп = 0;
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);    
		Для каждого СтрДоп Из СтрокиДоп Цикл
			ВесДоп = ВесДоп + СтрДоп.ВесЧистый;
		Конеццикла;   
		ВесМ = ?(СтрокаТабличнойЧасти.Вес30, Цел(((ВесМ - ВесДоп) * 0.7)*100)/100, ВесМ - ВесДоп);
		
		СтрокаТабличнойЧасти.ВесЧистый = ВесМ;
	КонецЕсли;
КонецПроцедуры

//+МАН 12.11.24 Добавлена проверка ТЧ Вставок на заполненность цен у бриллиантов
&НаКлиенте
Функция ПроверитьВставки()

	НомерСтроки = 0;
	
	Для каждого Стр Из Вставки Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если Стр.ВидВставки = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И
			НЕ Стр.НеОценивать И Стр.Цена = 0 И Стр.Сумма = 0 Тогда

			СтруктураВозврата = Новый Структура;
			СтруктураВозврата.Вставить("НомерСтроки", НомерСтроки);
			
			Возврат СтруктураВозврата;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

