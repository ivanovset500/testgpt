&НаСервере
Процедура ОбработатьПромокодНаСервереИзм()
	РасчетСуммыОценкиИтоговой(); 
	СуммаЗаймаРасчет = СуммаЗаймаДень + СуммаЗайма; 
    ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(ДатаДок, Ломбард, СтатусЗалогодателя, СуммаЗаймаРасчет, ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Промокод, Предъявитель);

	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		Если НЕ ПустаяСтрока(Промокод) Тогда
			ЕстьАкцияПромокод = Ложь;
			Для каждого СтрТЗ Из ТаблицаЗапроса Цикл
				Если ЗначениеЗаполнено(СтрТЗ.Акция) И СокрЛП(СтрТЗ.Акция.Промокод) = СокрЛП(Промокод) Тогда
					СхемаКредитования = СтрТЗ.СхемаКредитования; 
					ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
					Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
						 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
					КонецЕсли; 
					Акция = СтрТЗ.Акция;
				    ЗаполнитьТаблицуСтавок(); 
					ЕстьАкцияПромокод = Истина; 
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ЕстьАкцияПромокод Тогда
				Сообщить("В ломбарде №" + Ломбард.НомерЛомбарда + ", по кредитным схемам, акция с промокодом " + """" + СокрЛП(Промокод) + """" + " не действует.");
				Промокод = "";
				ПодборОптимальнойСтавки();
				Возврат;
			КонецЕсли;	
		Иначе  
			СтрСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			СхемаКредитования = СтрСК.СхемаКредитования;    
			ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
			Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
				 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
			КонецЕсли; 
			Акция = СтрСК.Акция;
			ЗаполнитьТаблицуСтавок();
			ПодборОптимальнойСтавки();
			ОбработатьСхемуКредитованияНаСервере(); 
			Если НЕ ЗначениеЗаполнено(ПроцентнаяСхема) Тогда
                Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
            КонецЕсли;
		КонецЕсли; 
	Иначе     
		СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");  
		ГрафикПлатежей.Очистить();
		ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		ДатаВыкупа = Дата(1,1,1); 
		ДатаВыкупаЛьготная = Дата(1,1,1);
		СрокЗалога = 0;
		ПроцентнаяСхема = 0;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	
	ОбработатьВыделениеЗБНасервере();
КонецПроцедуры
