&НаСервере
Процедура ПроверитьДоступностьДопКнопок()
	Если ПроцентУвеличенияОценкиЗалога = 0 Тогда  
		Элементы.ПовышеннаяОценка.Доступность = Ложь;
		ПовышеннаяОценка = Ложь;
	Иначе
		Элементы.ПовышеннаяОценка.Доступность = Истина;
	КонецЕсли;
    Если НЕ ОкруглятьЦены Тогда  
		Элементы.Округление.Доступность = Ложь;
		Округление = Ложь;
	Иначе
		Элементы.Округление.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКатегории(Результат, Параметр) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ТекСтрока = Элементы.Товары.ТекущиеДанные; 
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);   
		СтрокиВ = Вставки.НайтиСтроки(Отбор);
		Для сч = 0 По СтрокиВ.Количество()-1 Цикл 
			СтрВ = СтрокиВ.Получить(сч);
			Вставки.Удалить(СтрВ);
		КонецЦикла;	
        ТекСтрока.Категория = Параметр;
	КонецЕсли;   
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыКатегорияОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);   
	СтрокиВ = Вставки.НайтиСтроки(Отбор);
	
	//+МАН 16.12.24 Проверяем есть комплектующие или нет. Заявка 2956
	Отбор.Вставить("Вид", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Комплектующее"));
	СтрКомплектующих = Вставки.НайтиСтроки(Отбор);
	//-МАН
	
	Если НЕ (СтрокиВ.Количество() = 0) И НЕ (ВыбранноеЗначение = ТекСтрока.Категория)
		И СтрокиВ.Количество() <> СтрКомплектующих.Количество() Тогда //+МАН 16.12.24 Добавил условие. Заявка 2956
	    СтандартнаяОбработка = Ложь;  
	    Оповещение = Новый ОписаниеОповещения("ПослеВыбораКатегории", ЭтотОбъект, ВыбранноеЗначение);
	    ПоказатьВопрос(Оповещение, "После изменения категории вставки изделия будут очищены. Продолжть?", РежимДиалогаВопрос.ДаНет);  
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;	
КонецПроцедуры

//+Мельников 25.04.24 Отмена операции
&НаКлиенте
Процедура ОтменитьОперацию(Команда)
	
	ЛомбардПользователя = ПолучитьЛомбардПольвателя();
	
	ЛомбардВДокументе = ПолучитьЛомбардВдокументе(ЭтотОбъект.ДокументЗайма);

	//+Мельников 19.06.24
	НомерЗалоговогоБилета = ПолучитьНомерЗБ(ДокументЗайма);
	
	ПоследняяОперация = ПолучитьИнформациюОЗБПоНомеру(НомерЗалоговогоБилета, ТекущаяДата());
	//-Мельников

	Если ЛомбардПользователя <> ЛомбардВДокументе Тогда
		Предупреждение("Операция оформлена в другом ломбарде.
		|Действия с документом запрещены!");
		Возврат
	ИначеЕсли Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") <> Формат(ЭтотОбъект.ДатаДок, "ДФ=dd.MM.yyyy") Тогда
		Предупреждение("Отмена операции возможна только в текущем дне.");
		Возврат
	ИначеЕсли ТекущаяДата() - ДатаДок >= 3600 Тогда
		Предупреждение("Прошло больше часа от времени оформления текущей операции.");
		Возврат
	//+Мельников 19.06.24
	ИначеЕсли ПоследняяОперация = Неопределено Тогда
		Предупреждение("Операция уже отменена.");
		УстановитьВидимость();
		ДокументОтмены = ПолучитьДокументОтмены(ЭтотОбъект.ДокументЗайма);
		Возврат;
	//-Мельников 
	ИначеЕсли ПроверитьКассовуюСмену() = неопределено Тогда 
		Предупреждение("Не открыта кассовая смена в ломбарде.");
	    Возврат;
	Иначе
		
		Ответ = Вопрос("Выполнить отмену текущей операции?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			
			ПакетДоговоров = ПолучитьПакетДоговоров(ДокументЗайма);
			
			Если ЗначениеЗаполнено(ПакетДоговоров) Тогда

				ОтветВсе = Вопрос("Отменить все залоговые билеты из данной операции выдачи?", РежимДиалогаВопрос.ДаНет);
				
				Если ОтветВсе = КодВозвратаДиалога.Да Тогда

					МассивЗБ = Новый Массив;
					
					ЕстьДругиеОперации = "";
					НетДругихОпераций = "";
					Отмененные = "";
					//+Мельников 27.05.24 Добавлена проверка на одинаковые номера ЗБ.
					ПредыдущийДокументОтмены = "";
					
					Для каждого Стр Из ЭтотОбъект.Товары Цикл
						
						ПоследняяОперация = ПолучитьИнформациюОЗБПоНомеру(Стр.НомерЗалоговогоБилета, ТекущаяДата());
						
						Если ПоследняяОперация <> Неопределено Тогда
							АктуальныйДокмент = ПоследняяОперация.ЗБ = ПоследняяОперация.ДокументОперации;
							
							Если АктуальныйДокмент Тогда
								Если ПредыдущийДокументОтмены <> Стр.НомерЗалоговогоБилета Тогда
									МассивЗБ.Добавить(Стр.НомерЗалоговогоБилета);
									НетДругихОпераций = ?(НетДругихОпераций = "", НетДругихОпераций, НетДругихОпераций + ", ") + Стр.НомерЗалоговогоБилета;
								Иначе
									Продолжить;
								КонецЕсли;
							Иначе
								Если ПредыдущийДокументОтмены <> Стр.НомерЗалоговогоБилета Тогда
									ЕстьДругиеОперации = ?(ЕстьДругиеОперации = "", ЕстьДругиеОперации, ЕстьДругиеОперации + ", ") + Стр.НомерЗалоговогоБилета;
								Иначе
									Продолжить;
								КонецЕсли;
							КонецЕсли;
						Иначе
							Если ПредыдущийДокументОтмены <> Стр.НомерЗалоговогоБилета Тогда
								Отмененные = ?(Отмененные = "", Отмененные, Отмененные + ", ") + Стр.НомерЗалоговогоБилета;
							Иначе
								Продолжить;
							КонецЕсли;
						КонецЕсли;
						
							ПредыдущийДокументОтмены = Стр.НомерЗалоговогоБилета;
							
					КонецЦикла;
					
					Если ЕстьДругиеОперации <> "" ИЛИ Отмененные <> "" Тогда
						Предупреждение("Пакетная отмена невозможна."
						+ ?(Отмененные <> "", Символы.ПС + "По ЗБ " + Отмененные + " уже произведена отмена.", "")
						+ ?(ЕстьДругиеОперации <> "", Символы.ПС + "По ЗБ " + ЕстьДругиеОперации + " уже есть другие операции.", "")
						+ Символы.ПС + "Операцию отмены можно сделать только по ЗБ " + НетДругихОпераций + ".
						|Выполните выборочную отмену ЗБ.");
						Возврат;
					КонецЕсли;
				
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("ЗалоговыйБилет", ДокументЗайма);
					ПараметрыФормы.Вставить("НомерЗалоговогоБилета", ПолучитьНомерЗБ(ДокументЗайма));
					ПараметрыФормы.Вставить("ПакетДоговоров", ПакетДоговоров);
					ПараметрыФормы.Вставить("МассивЗБ", МассивЗБ);
					
					ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтаФорма);	
					
					Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда  
						ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма.ВладелецФормы, Истина,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
					Иначе	
					    ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
					КонецЕсли;
				Иначе
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("ЗалоговыйБилет", ДокументЗайма);
					СтруктураПараметров.Вставить("НомерЗалоговогоБилета", ПолучитьНомерЗБ(ДокументЗайма));
					СтруктураПараметров.Вставить("ПакетДоговоров", ПакетДоговоров);
					
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("ПакетДоговоров", ПакетДоговоров);
					ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораЗБ", ЭтаФорма, СтруктураПараметров);	

					ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыбораЗБ", ПараметрыФормы, ЭтаФорма, Истина,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

				КонецЕсли;
			Иначе
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ЗалоговыйБилет", ДокументЗайма);
				ПараметрыФормы.Вставить("НомерЗалоговогоБилета", НомерЗалоговогоБилета);
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтаФорма); //+Мельников 27.04.24	
				
				Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда  
					ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма.ВладелецФормы, Истина,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
				Иначе	
				    ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); //+Мельников 27.04.24 
				КонецЕсли;	
			КонецЕсли;
			
			УстановитьВидимость();
			
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументОтмены(Ссылка)
	//+МАН 17.06.25 Закомментировал. Было
	//Возврат Ссылка.ДокументОтмены;

	//Сделал поиск в регистре
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|ГДЕ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент В(&ЗБ)";
	
	Запрос.УстановитьПараметр("ЗБ", Ссылка);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Регистратор;
	КонецЕсли;
	
	Возврат Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка();
	//-МАН
КонецФункции

&НаКлиенте
Процедура ПослеВыбораЗБ(Результат, Параметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
        Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПакетДоговоров", Параметры.ПакетДоговоров);
	ПараметрыФормы.Вставить("МассивЗБ", Результат);
	ПараметрыФормы.Вставить("ЗалоговыйБилет", ДокументЗайма);

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтаФорма);	

	ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма, Истина,,, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияДокумента(Результат,Параметры) Экспорт
	Если ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		
		НомераЗБОтмены = "";
		
		Для каждого Документ Из Результат Цикл
			НомераЗБОтмены = ?(НомераЗБОтмены = "", НомераЗБОтмены, НомераЗБОтмены + ", ") + ПолучитьНомерЗБ(Документ.Значение);
		КонецЦикла;

		ДокументОтмены = ?(СтрНайти(НомераЗБОтмены, ",") > 0, "", Результат[0].Значение);
		Элементы.ОтменитьОперацию.Доступность = Ложь;
		Элементы.ГруппаОтмена.Видимость = Истина;
		Элементы.Расчеты.Доступность = Ложь; //+Мельников 27.04.24
		Элементы.ДокументОтмены.Видимость = ?(ЗначениеЗаполнено(ДокументОтмены), Истина, Ложь);
		Элементы.ДекорНомерЗБ.Заголовок = НомераЗБОтмены;
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОЗБ(ЗалоговыйБилет, Дата)
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, Дата,, Истина);
	
	Если Результат <> Неопределено Тогда
		ПоследняяОперация = Новый Структура;
		ПоследняяОперация.Вставить("Дата", Результат.Регистратор.Дата);
		ПоследняяОперация.Вставить("ВидОперации", Результат.Регистратор.ВидОперации);
		ПоследняяОперация.Вставить("ДокументОперации", Результат.Регистратор);
	Иначе
		ПоследняяОперация = Неопределено;
	КонецЕсли;
	
	Возврат ПоследняяОперация;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОЗБПоНомеру(Номер, Дата)
	
	Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(Номер, Дата,, Истина);
	
	Если Результат <> Неопределено Тогда
		ПоследняяОперация = Новый Структура;
		ПоследняяОперация.Вставить("ЗБ", Результат.ЗалоговыйБилет);
		ПоследняяОперация.Вставить("ДокументОперации", Результат.Регистратор);
	Иначе
		ПоследняяОперация = Неопределено;
	КонецЕсли;
	
	Возврат ПоследняяОперация;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛомбардПольвателя()
	Возврат ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);
КонецФункции

