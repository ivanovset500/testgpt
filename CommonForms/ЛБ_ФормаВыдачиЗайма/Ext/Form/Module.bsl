&НаСервере
Процедура ОбновитьДанныеТовары() 
	Для Каждого Стр Из Товары Цикл  
		Отбор = новый структура;
		Отбор.Вставить("КлючСтроки", Стр.КлючСтроки); 
		СтрокиВ = Вставки.НайтиСтроки(Отбор);
		Стр.КоличествоВ = СтрокиВ.Количество();
		Стр.ЕстьФайл = ?(ЗначениеЗаполнено(Стр.Этикетка), истина, ложь);
	Конеццикла;	
	УстановитьТекстСуммаЗаймаДень();
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыЕстьВставкиПриИзменении(Элемент)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные; 
	Если НЕ СтрокаТабличнойЧастиТовары.ЕстьВставки Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Строки = Вставки.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("У изделия есть вставки. Удалить вставки?", Режим, 0);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				
				//++ИВВ, 02.2026, вычеты для часов
				СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Ложь;
				СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = 0;					
				СтрокаТабличнойЧастиТовары.СкидкаНика = Ложь;
				СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = 0;
				//--ИВВ
				
				Для каждого стр из Строки Цикл 
					Вставки.Удалить(Стр);
				Конеццикла;
				
				//++ИВВ 02.2026, вычеты для часов
				ПроверкаПослеУдаленияМеханизм();
				ПроверкаПослеУдаленияНика();
				//--ИВВ
				
				ВесМ = СтрокаТабличнойЧастиТовары.Вес;
				Отбор = Новый структура;
				Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
				СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(Отбор); 
				Для каждого Стр Из СтрокиДоп Цикл
				    ВесМ = ВесМ - Стр.ВесЧистый;
				Конеццикла;

				СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
				//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
				//Было: СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((ВесМ - СтруктураР.Вес)*100)/100;
				//-Мельников
				//++ИВВ 02.2026, вычеты для часов
				//было:
				//СтрокаТабличнойЧастиТовары.ВесЧистый = ?(СтрокаТабличнойЧастиТовары.Вес30, Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100, Цел((ВесМ - СтруктураР.Вес)*100)/100);
				//стало:
				Если СтрокаТабличнойЧастиТовары.Вес30 Тогда
					СтрокаТабличнойЧастиТовары.ВесЧистый = Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100;
				ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И Не СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
					СтрокаТабличнойЧастиТовары.ВесЧистый = (ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100);
				ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
					СтрокаТабличнойЧастиТовары.ВесЧистый = (((ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100))
						* (100 - СтрокаТабличнойЧастиТовары.РазмерСкидкиНика)) / 100;
				Иначе
					СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((ВесМ - СтруктураР.Вес)*100)/100;
				КонецЕсли;
			    //--ИВВ
				СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;

				ПересчитатьСуммТовары(СтрокаТабличнойЧастиТовары);
				ОбновитьДанныеТовары();
			Иначе
			    СтрокаТабличнойЧастиТовары.ЕстьВставки = Истина; 	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	ВставкиИтогиНаКлиенте();
	//-МАН
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокДопМеталлов(Идентификатор)
	Стр = Товары.НайтиПоИдентификатору(Идентификатор);
	СписокПроб = Новый СписокЗначений;
    ОсновнойМеталл = Стр.Проба.Владелец; 
	
	ЗапросП = Новый Запрос;
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_Пробы.Ссылка КАК Проба
	                |ИЗ
	                |	Справочник.ЛБ_Пробы КАК ЛБ_Пробы
	                |ГДЕ
	                |	ЛБ_Пробы.Владелец = &Владелец
	                |	И ЛБ_Пробы.ПометкаУдаления = ЛОЖЬ
	                |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ОсновнойМеталл", ОсновнойМеталл);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДополнительныеМеталлыВИзделиях.ДополнительныйМеталл КАК ДополнительныйМеталл
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДополнительныеМеталлыВИзделиях КАК ЛБ_ДополнительныеМеталлыВИзделиях
	               |ГДЕ
	               |	ЛБ_ДополнительныеМеталлыВИзделиях.ОсновнойМеталл = &ОсновнойМеталл
	               |АВТОУПОРЯДОЧИВАНИЕ";  
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапросП.УстановитьПараметр("Владелец", Выборка.ДополнительныйМеталл); 
		ВыборкаП = ЗапросП.Выполнить().Выбрать();
		Пока ВыборкаП.Следующий() Цикл 
			СписокПроб.Добавить(ВыборкаП.Проба);
		Конеццикла;	
	Конеццикла;	 
	
	Возврат СписокПроб;
КонецФункции

&НаКлиенте
Процедура ТоварыЕстьДопМеталлыПриИзменении(Элемент)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные; 
	Если НЕ СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Строки = ДополнительныеМеталлы.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("У изделия есть дополнительные металлы. Удалить доп. металлы?", Режим, 0);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Для каждого стр из Строки Цикл  
				//+Мельников 09.10.24 Скидка 30%. Изменил формулу. Заявка 2732.
					//Было: СтрокаТабличнойЧастиТовары.ВесЧистый = СтрокаТабличнойЧастиТовары.ВесЧистый + Стр.ВесЧистый; 
					ДополнительныеМеталлы.Удалить(Стр);
				Конеццикла;	    
				ВесМ = СтрокаТабличнойЧастиТовары.Вес;
				СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
				//++ИВВ 02.2026, вычеты для часов
				//было:
				//СтрокаТабличнойЧастиТовары.ВесЧистый = ?(СтрокаТабличнойЧастиТовары.Вес30, 
				//Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100, Цел((ВесМ - СтруктураР.Вес)*100)/100);
				//стало:
				Если СтрокаТабличнойЧастиТовары.Вес30 Тогда
					СтрокаТабличнойЧастиТовары.ВесЧистый = Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100;
				ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И Не СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
					СтрокаТабличнойЧастиТовары.ВесЧистый = (ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100);
				ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
					СтрокаТабличнойЧастиТовары.ВесЧистый = (((ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100))
					* (100 - СтрокаТабличнойЧастиТовары.РазмерСкидкиНика)) / 100;
				Иначе
					СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((ВесМ - СтруктураР.Вес)*100)/100;
				КонецЕсли;
			    //--ИВВ
				ПересчитатьСуммТовары(СтрокаТабличнойЧастиТовары);
			Иначе
			    СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы = Истина;  
			КонецЕсли;
		КонецЕсли;          
	КонецЕсли;
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЭтикеткаПриИзменении(Элемент)  	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;   
	Если ТекСтрока.ЕстьЭтикетка Тогда
		Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда 
			УдалитьСканЭтикетки(ТекСтрока.Этикетка);
			ТекСтрока.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка");  
			ТекСтрока.ЕстьФайл = ложь;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКатегорияПриИзменении(Элемент)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());

	ОтборВ = Новый Структура;
	ОтборВ.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
	Строки = ДополнительныеМеталлы.НайтиСтроки(ОтборВ);
	Для каждого СтрокаТабличнойЧасти Из Строки Цикл		
	    ЦенаДрагоценногоМеталла(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы + СтрокаТабличнойЧасти.СуммаОценкиМеталлы;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыИменникПриИзменении(Элемент)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекСтрока.Именник = ПредопределенноеЗначение("Перечисление.ЛБ_Именник.Да") Тогда 
		ТекСтрока.ДанныеИменника = "";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДанныеИменникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ТекущееЗначение = ТекСтрока.ДанныеИменника;
	Если ВвестиЗначение(ТекущееЗначение, "Введите данные именника") Тогда
		ТекСтрока.ДанныеИменника = ТекущееЗначение;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕстьДеффектыПриИзменении(Элемент)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекСтрока.ЕстьДеффекты Тогда 
		ТекСтрока.Дефекты = ""; 
		Дефекты.Очистить(); 
	Иначе
		ОткрытьВыборДефектов();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыборДефектов()
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;   
	ОтборД = Новый Структура;
	ОтборД.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	СтрокиД = Дефекты.НайтиСтроки(ОтборД);
	Если НЕ СтрокиД.Количество() = 0 Тогда
		СписокДефектов = новый списокЗначений;
		ДругиеДефекты = "";
		Для каждого СтрД из СтрокиД Цикл 
			Если ТипЗнч(СтрД.Дефект) = Тип("СправочникСсылка.ЛБ_Дефекты") Тогда 
				СписокДефектов.Добавить(СтрД.Дефект);
			ИначеЕсли ТипЗнч(СтрД.Дефект) = Тип("Строка") Тогда
				ПараметрыФормы.Вставить("ДругиеДефекты", СтрД.Дефект);
	        КонецЕсли;
		Конеццикла;	 
		Если НЕ СписокДефектов.Количество() = 0 Тогда
		    ПараметрыФормы.Вставить("Дефекты", СписокДефектов);
		КонецЕсли;	 
	КонецЕсли;	
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДефектов",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборДефектов", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыДефектыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьВыборДефектов();
КонецПроцедуры
  
 &НаКлиенте 
Процедура ПослеВыбораДефектов(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные; 
	ТекСтрока.Дефекты = "";
	ОтборД = Новый Структура;
	ОтборД.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	СтрокиД = Дефекты.НайтиСтроки(ОтборД);
	
	Для каждого стрД из СтрокиД Цикл 
		Дефекты.Удалить(СтрД);
	Конеццикла;	                   
	
	Для каждого Эл Из Результат.списокДефектов цикл 
		Если Эл.Пометка тогда 
			НоваяСтрД = Дефекты.Добавить();
			НоваяСтрД.Ключстроки = ТекСтрока.КлючСтроки; 
			НоваяСтрД.Дефект = Эл.Значение;
			
			ТекСтрока.Дефекты = ТекСтрока.Дефекты + ?(Пустаястрока(ТекСтрока.Дефекты), "", "; ") + сокрЛП(НоваяСтрД.Дефект);
		КонецЕсли;	
	Конеццикла;	 
	Если НЕ Пустаястрока(Результат.ДругиеДефекты) тогда 
		НоваяСтрД = Дефекты.Добавить();
		НоваяСтрД.Ключстроки = ТекСтрока.КлючСтроки; 
		НоваяСтрД.Дефект = Результат.ДругиеДефекты;
		
		ТекСтрока.Дефекты = ТекСтрока.Дефекты + ?(Пустаястрока(ТекСтрока.Дефекты), "", "; ") + сокрЛП(НоваяСтрД.Дефект);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьВесИСуммуВставокИзделия(КлючСтроки)
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", КлючСтроки);
	СтрокиВставки = Вставки.НайтиСтроки(Отбор);
	ВесВставок = 0;
	СуммаВставок = 0;
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	КоличествоВставок = 0;
	ВесКаратВставок = 0;
	ВесДопМеталлов = 0;
	СуммаДопМеталлов = 0;
	//-МАН
	
	Для каждого Стр Из СтрокиВставки Цикл
		Если Стр.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
	        ВесВставок = ВесВставок + Стр.ВесГраммы;
		    СуммаВставок = СуммаВставок + Стр.Сумма;
			//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
			КоличествоВставок = КоличествоВставок + Стр.Количество;
			ВесКаратВставок = ВесКаратВставок + Стр.Вес;
			//-МАН
		Иначе
			ВесВставок = ВесВставок + Стр.ВесГраммы;
			//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
			КоличествоВставок = КоличествоВставок + Стр.Количество;
			//-МАН
		КонецЕсли;	
	КонецЦикла;	

	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	СтрокиДопМеталлы = ДополнительныеМеталлы.НайтиСтроки(Отбор);

	Для каждого Стр Из СтрокиДопМеталлы Цикл
		ВесДопМеталлов = ВесДопМеталлов + Стр.ВесЧистый;
		СуммаДопМеталлов = СуммаДопМеталлов + Стр.СуммаОценкиМеталлы;
	КонецЦикла;	
	//-МАН

	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Вес", ВесВставок);
	СтруктураРезультат.Вставить("Сумма", СуммаВставок);
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	СтруктураРезультат.Вставить("Количество", КоличествоВставок);
	СтруктураРезультат.Вставить("ВесКарат", ВесКаратВставок);
	СтруктураРезультат.Вставить("ВесДопМеталлов", ВесДопМеталлов);
	СтруктураРезультат.Вставить("СуммаДопМеталлов", СуммаДопМеталлов);
	//-МАН	
	
	Возврат СтруктураРезультат;
КонецФункции

&НаСервере
Функция ПолучитьВесВЧистоте(ВесЧистый, Идентификатор, ИмяТаблицы = "Товары")  
	Если ИмяТаблицы = "Товары" Тогда
	    СтрокаТабличнойЧасти = Товары.НайтиПоИдентификатору(Идентификатор);
	Иначе 
		СтрокаТабличнойЧасти = ДополнительныеМеталлы.НайтиПоИдентификатору(Идентификатор);
	КонецЕсли;
	
