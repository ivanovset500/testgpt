&НаКлиенте
Процедура ПодборСтавки()
	
	Ставка = ПолучитьСтавку();
	
	//+МАН 13.01.25 Добавлено сравнение процентов. Заявка 2792
	Если (Ставка.СхемаКредитования <> СхемаКредитования И Ставка.Ставка < ПроцентнаяСхема) ИЛИ (Ставка.Акция <> Акция И Ставка.Ставка < ПроцентнаяСхема) Тогда
		
		//+МАН 12.11.24 Добавлено наименование схемы кредитования. Заявка 2792.
		ТекстВопроса = "Подобрана схема кредитования " + """" + Ставка.СхемаКредитования + """" + " с меньшей процентной ставкой "
						+ Ставка.Ставка + "%."
						+ Символы.ПС + "Применить?";
		//-МАН
		Оповещение = Новый ОписаниеОповещения("ИзменитьСхемуКредитования", ЭтотОбъект, Ставка);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Заголовок);
		
	КонецЕсли;
	
	ЗаполнитьТаблицуСтавок();

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСхемуКредитования(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		СхемаКредитования = ДополнительныеПараметры.СхемаКредитования; 
		ТекущаяУстановкаУсловийПоСхемеКредитования = ПолучитьУсловияСК();
		Если НЕ ЗначениеЗаполнено(ТекущаяУстановкаУсловийПоСхемеКредитования) тогда
			 Сообщить("На дату документа не определены условия по кредитной схеме " + СокрЛП(СхемаКредитования) + "!"); 
		КонецЕсли; 
		Акция = ДополнительныеПараметры.Акция;
		ПроцентнаяСхема = ДополнительныеПараметры.Ставка;
		
		ОбработатьСхемуКредитованияНаСервере();
		ПроверитьДоступностьДопКнопок();
		ЗаполнитьТаблицуСтавок();
		РасчетСуммыОценкиИтоговой(); 			 
		РассчитатьПредельныСрокЗайма(); 
		УстановитьВидимость();
		ОбработатьВыделениеЗБНасервере();
		ЗаполнитьДопИнформациюПоЗБ();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПромокодОчистка(Элемент, СтандартнаяОбработка)
	ПодборОптимальнойСтавки();
КонецПроцедуры

//+Мельников 13.08.24 Формирование списка проб по прейскуранту. Заявка 2677.
&НаСервере
Процедура ЗаполнитьСписокПроб()

	ЗапросДокумента = Новый Запрос;
	ЗапросДокумента.Текст = 
		//+Мельников 19.08.24 По каким то причинам показывал не срез последних, а все что были до указанной даты. Изменил запрос.
		//"ВЫБРАТЬ
		//|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба КАК Проба
		//|ИЗ
		//|	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
		//|
		//|СГРУППИРОВАТЬ ПО
		//|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба
		//|АВТОУПОРЯДОЧИВАНИЕ";
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Период УБЫВ";
	
	ЗапросДокумента.УстановитьПараметр("Дата", ЭтотОбъект.ДатаДок);
	ЗапросДокумента.УстановитьПараметр("Ломбард", ЭтотОбъект.Ломбард);
	
	РезультатДокумент = ЗапросДокумента.Выполнить().Выбрать();

	Если РезультатДокумент.Следующий() Тогда
		
		ЗапросПроб = Новый Запрос;
		ЗапросПроб.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы.Проба КАК Проба
		|ИЗ
		|	Документ.ЛБ_ПриказУсловияПредоставленияЗаймов.ЦеныМеталлы КАК ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЛБ_ПриказУсловияПредоставленияЗаймов КАК ЛБ_ПриказУсловияПредоставленияЗаймов
		|		ПО ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы.Ссылка = ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка
		|ГДЕ
		|	ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ПриказУсловияПредоставленияЗаймовЦеныМеталлы.Проба
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		ЗапросПроб.УстановитьПараметр("Ссылка", РезультатДокумент.Регистратор);
		
		Элементы.ТоварыПроба.СписокВыбора.Очистить();
		Элементы.ТоварыПроба.РежимВыбораИзСписка = Истина;
		Элементы.ТоварыПроба.СписокВыбора.ЗагрузитьЗначения(ЗапросПроб.Выполнить().Выгрузить().ВыгрузитьКолонку("Проба"));

		//+Мельников 19.08.24 По каким то причинам показывал не срез последних, а все что были до указанной даты. Изменил запрос.
		//Элементы.ТоварыПроба.СписокВыбора.Очистить();
		//Элементы.ТоварыПроба.РежимВыбораИзСписка = Истина;
		//Элементы.ТоварыПроба.СписокВыбора.ЗагрузитьЗначения(ЗапросДокумента.Выполнить().Выгрузить().ВыгрузитьКолонку("Проба"));
		
	КонецЕсли;
	
КонецПроцедуры

//+Мельников 23.08.24 Настройка работы с комплектующим. Заявка 2735.
&НаКлиенте
Процедура ПослеВыбораКомплектующего(Результат, ДопПараметры) Экспорт 
	
	ОчиститьСообщения();
	
	Если Результат = Неопределено Тогда
		Если Не ЗначениеЗаполнено(Элементы.Вставки.ТекущиеДанные.ВидВставки) Тогда
			УдалитьСтрокуВставки(Элементы.Вставки.ТекущиеДанные.ПолучитьИдентификатор());
		КонецЕсли;
		Возврат;
	ИначеЕсли Результат = Ложь Тогда
		УдалитьСтрокуВставки(Элементы.Вставки.ТекущиеДанные.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти       = Элементы.Вставки.ТекущиеДанные;
	
	СтрокаТабличнойЧасти.Количество = Результат.Количество; 
	СтрокаТабличнойЧасти.ВидВставки = Результат.ВидВставки;
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения;
	СтрокаТабличнойЧасти.ВесГраммы = Результат.Вес;
	СтрокаТабличнойЧасти.НеОценивать = Истина;
	СтрокаТабличнойЧасти.ПроверкаНеОценивать = Истина;
	СтрокаТабличнойЧасти.ЭтоВесовой = Ложь;
	
	//++ИВВ, 02.2026, вычеты для часов ч.2
	Если ПроверкаВидаКомплектующегоНика(Результат.ВидВставки) И Не ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, 0) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 
			|'Для применения вычета на капсулу (для часов «Ника») необходимо вначале выбрать комплектующее «Часовой механизм».'"));
		
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = 0;
		СтрокаТабличнойЧасти.РазмерСкидкиМеханизм = 0;
		ПроверкаПослеУдаленияМеханизм();
		
		УдалитьСтрокуВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	
	Если ПроверкаВидаКомплектующегоМеханизм(Результат.ВидВставки) И ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, 1) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 
			|'Комплектующее «Часовой механизм» уже добавлено на форму выдачи займа. Повторное добавление невозможно!'"));
		Если ПроверкаНаличияНика(СтрокаТабличнойЧасти, 0) Тогда
			СтрокаТабличнойЧастиТовары.СкидкаНика = Ложь;
			СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = 0;
			СтрокаТабличнойЧасти.РазмерСкидкиНика = 0;
			ПроверкаПослеУдаленияНика();
		КонецЕсли;
		УдалитьСтрокуВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	
	Если ПроверкаВидаКомплектующегоНика(Результат.ВидВставки) И ПроверкаНаличияНика(СтрокаТабличнойЧасти, 1) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 
			|'Комплектующее «Ника, капсула» уже добавлено на форму выдачи займа. Повторное добавление невозможно!'"));
		УдалитьСтрокуВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		Возврат;
	КонецЕсли;
	//--ИВВ
	
	//++ИВВ, 02.2026, вычеты для часов
	Если ПроверкаВидаКомплектующегоМеханизм(Результат.ВидВставки) Тогда
		Элементы.ТоварыСкидкаМеханизм.Видимость = Истина;
		Элементы.ТоварыСкидкаМеханизм.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Истина;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = Результат.РазмерСкидки;
		СтрокаТабличнойЧасти.РазмерСкидкиМеханизм = Результат.РазмерСкидки;
		Элементы.ТоварыВес30.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.Вес30 = Ложь;
	ИначеЕсли ПроверкаВидаКомплектующегоНика(Результат.ВидВставки) Тогда
		Элементы.ТоварыСкидкаНика.Видимость = Истина;
		Элементы.ТоварыСкидкаНика.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.СкидкаНика = Истина;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = Результат.РазмерСкидки;
		СтрокаТабличнойЧасти.РазмерСкидкиНика = Результат.РазмерСкидки;
		Элементы.ТоварыВес30.Доступность = Ложь;
		СтрокаТабличнойЧастиТовары.Вес30 = Ложь;
	КонецЕсли;
	
	Если Не ПроверкаВидаКомплектующегоМеханизм(Результат.ВидВставки)
		И Не ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, 0) Тогда	
		СтрокаТабличнойЧастиТовары.СкидкаМеханизм = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм = 0;
		СтрокаТабличнойЧасти.РазмерСкидкиМеханизм = 0;
		ПроверкаПослеУдаленияМеханизм();
	КонецЕсли;
	
	Если Не ПроверкаВидаКомплектующегоНика(Результат.ВидВставки)
		И Не ПроверкаНаличияНика(СтрокаТабличнойЧасти, 0) Тогда
		СтрокаТабличнойЧастиТовары.СкидкаНика = Ложь;
		СтрокаТабличнойЧастиТовары.РазмерСкидкиНика = 0;
		СтрокаТабличнойЧасти.РазмерСкидкиНика = 0;
		ПроверкаПослеУдаленияНика();
	КонецЕсли;
	//--ИВВ	

	Если СтрокаТабличнойЧасти.НеОценивать Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;
	КонецЕсли;
	
	Если СтрокаТабличнойЧастиТовары <> Неопределено Тогда
		ВесМ = СтрокаТабличнойЧастиТовары.Вес;
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		СтрокиДоп = ДополнительныеМеталлы.НайтиСтроки(Отбор); 
		Для каждого Стр Из СтрокиДоп Цикл
		    ВесМ = ВесМ - Стр.ВесЧистый;
		Конеццикла;
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
		
		//+Мельников 09.10.24 Скидка 30%. Заявка 2732.
		//Было: СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((ВесМ - СтруктураР.Вес)*100)/100;
		
		//++ИВВ 02.2026, вычеты для часов
		//было:
		//СтрокаТабличнойЧастиТовары.ВесЧистый = ?(СтрокаТабличнойЧастиТовары.Вес30, Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100, Цел((ВесМ - СтруктураР.Вес)*100)/100);
		//-Мельников
		//стало:
		Если СтрокаТабличнойЧастиТовары.Вес30 Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = Цел(((ВесМ - СтруктураР.Вес)*0.7)*100)/100;
		ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И Не СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = (ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100);
		ИначеЕсли СтрокаТабличнойЧастиТовары.СкидкаМеханизм И СтрокаТабличнойЧастиТовары.СкидкаНика Тогда
			СтрокаТабличнойЧастиТовары.ВесЧистый = (((ВесМ - СтруктураР.Вес)*(СтрокаТабличнойЧастиТовары.РазмерСкидкиМеханизм/100))
				* (100 - СтрокаТабличнойЧастиТовары.РазмерСкидкиНика)) / 100;
		Иначе
			СтрокаТабличнойЧастиТовары.ВесЧистый = ВесМ - СтруктураР.Вес;
		КонецЕсли;
		//--ИВВ
		
		СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
		ПересчитатьСуммТовары();
	КонецЕсли;	                        
	ОбновитьДанныеВставки(); 
	//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
	//Было: ВставкиИтоги();
	ВставкиИтогиНаКлиенте();
	//-МАН
	ОбновитьДанныеТовары();
	ЭтаФорма.ТекущийЭлемент = Элементы["ВставкиВидВставки"];
КонецПроцедуры 

&НаКлиенте
Функция ПроверкаНаличияЧМ(СтрокаТабличнойЧасти, Количество)
	
	СтруктураОтбора = Новый Структура("КлючСтроки, ВидВставки", СтрокаТабличнойЧасти.КлючСтроки, ПолучитьВидКомплектующегоМеханизм());
	РезультатОтбораВставки = Вставки.НайтиСтроки(СтруктураОтбора);
	
	Если РезультатОтбораВставки.Количество() > Количество Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПроверкаНаличияНика(СтрокаТабличнойЧасти, Количество)
	
	СтруктураОтбора = Новый Структура("КлючСтроки, ВидВставки", СтрокаТабличнойЧасти.КлючСтроки, ПолучитьВидКомплектующегоНика());
	РезультатОтбораВставки = Вставки.НайтиСтроки(СтруктураОтбора);
	
	Если РезультатОтбораВставки.Количество() > Количество Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура ПослеУдаленияЧМ(СтрокаТабличнойЧасти)
	
	СтруктураОтбора = Новый Структура("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);
	РезультатОтбораВставки = Вставки.НайтиСтроки(СтруктураОтбора);
	МассивКУдалению = Новый Массив;
	Для Каждого ТекущаяСтрока Из РезультатОтбораВставки Цикл
		Если ПроверкаВидаКомплектующегоНика(ТекущаяСтрока.ВидВставки) Тогда
			МассивКУдалению.Добавить(ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из МассивКУдалению Цикл
		Вставки.Удалить(Вставки.Индекс(ТекущаяСтрока));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
