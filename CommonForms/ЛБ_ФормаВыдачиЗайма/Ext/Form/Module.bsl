&НаКлиенте
Процедура ТоварыЕстьЭтикеткаПриИзменении(Элемент)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;  
	Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда 
		УдалитьСканЭтикетки(ТекСтрока.Этикетка);
		ТекСтрока.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка");  
		ТекСтрока.ЕстьФайл = ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары)
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		Если СтрокаТабличнойЧастиТовары.ЕстьВставки Тогда
			Элементы.ГруппаВставок.Показать();
			Элементы.ГруппаВставок.Доступность = Истина;
		Иначе
			Элементы.ГруппаВставок.Скрыть();
			Элементы.ГруппаВставок.Доступность = ложь;
		КонецЕсли;	
		
		Если СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы Тогда
			Элементы.ГруппаДопМеталлы.Показать(); 
			Элементы.ГруппаДопМеталлы.Доступность = Истина;
			Элементы.ТоварыГруппаЭтикетка.Видимость = Истина;
			Элементы.ТоварыГруппаЭ.Доступность = ?(НеРедактировать, Элементы.ТоварыГруппаЭ.Доступность, Истина);
		Иначе
			Элементы.ГруппаДопМеталлы.Скрыть();
			Элементы.ГруппаДопМеталлы.Доступность = ложь;
			Если СтрокаТабличнойЧастиТовары.ЕстьЭтикетка тогда
				СтрокаТабличнойЧастиТовары.ЕстьЭтикетка = ложь;
			КонецЕсли;	   
			Если ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.Этикетка) тогда 
				УдалитьСканЭтикетки(СтрокаТабличнойЧастиТовары.Этикетка);
				СтрокаТабличнойЧастиТовары.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка"); 
			КонецЕсли;	
			Элементы.ТоварыГруппаЭтикетка.Видимость = ложь;  
			Элементы.ТоварыГруппаЭ.Доступность = ложь;
		КонецЕсли;	
	Иначе
		Элементы.ГруппаВставок.Скрыть();
		Элементы.ГруппаДопМеталлы.Скрыть(); 
		Элементы.ТоварыГруппаЭ.Доступность = ложь;
	КонецЕсли;	
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
		
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
		
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
		СтрокиДопМеталлы = ДополнительныеМеталлы.НайтиСтроки(Отбор);
		//-МАН
		
		Если НЕ СтрокаТабличнойЧастиТовары.КлючСтроки = 0 Тогда
		    ЗаполнитьДопИнформациюПоЗБ(); 
			//+МАН 22.10.24 Исправление подвала вставок. Заявка 2735
			ВставкиИтогиНаКлиенте();
			Если СтрокиДопМеталлы <> 0 Тогда
				ДопМеталлыИтогиНаКлиенте();
			КонецЕсли;
			//-МАН
		КонецЕсли;	
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДопИнформациюПоЗБ(ВыделитьВЗалоговыйБилет)
	Отбор = Новый Структура;
	Отбор.Вставить("ВыделитьВЗалоговыйБилет", ВыделитьВЗалоговыйБилет); 
	
	СтрокиП = ПакетДокументов.НайтиСтроки(Отбор);  
	Если НЕ СтрокиП.Количество() = 0 Тогда
		СтрП = строкиП.Получить(0);
		ПСКГод = СтрП.ПСК;
	КонецЕсли;   
	
	СтрокиП = ГрафикПлатежей.НайтиСтроки(Отбор); 
	Если НЕ СтрокиП.Количество() = 0 Тогда
		СтрП = строкиП.Получить(0);
		СуммаПроцентовДень = СтрП.СуммаПроцентовДень;
        		
		СуммаПроцентов = 0;
		Для каждого СтрП из СтрокиП Цикл 
			СуммаПроцентов = СуммаПроцентов + СтрП.СуммаПроцентов;
		КонецЦикла;	  
	КонецЕсли;	
КонецФункции

&НаКлиенте 
Процедура ЗаполнитьДопИнформациюПоЗБ()  
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекСтрока = Неопределено Тогда  
		Если ПакетДокументов.Количество() > 1 Тогда
			Элементы.ДопИнформацияПоЗБ.Видимость = Истина;
			ИнформацияЗБ = Строка(ТекСтрока.ВыделитьВЗалоговыйБилет);  	
			Отбор = Новый Структура;
			Отбор.Вставить("ВыделитьВЗалоговыйБилет", ТекСтрока.ВыделитьВЗалоговыйБилет); 
			
			СтрокиП = ПакетДокументов.НайтиСтроки(Отбор);  
			Если НЕ СтрокиП.Количество() = 0 Тогда 
				СтрП = строкиП.Получить(0);
				ИнформацияЗБ = ИнформацияЗБ + Символы.ПС + СокрЛП(Формат(СтрП.СуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " руб."; 
			КонецЕсли;	 
			Элементы.ДопИнформацияПоЗБ.Заголовок = ИнформацияЗБ;
		Иначе
			Элементы.ДопИнформацияПоЗБ.Видимость = ложь;
		КонецЕсли;	 
		ПолучитьДопИнформациюПоЗБ(ТекСтрока.ВыделитьВЗалоговыйБилет);
    КонецЕсли;
КонецПроцедуры	
	
&НаСервере 
Процедура ЗаполнитьСписокВыбораВыделить() 
	Элементы.ТоварыВыделитьВЗалоговыйБилет.СписокВыбора.Очистить(); 
	Отбор = Новый структура;
	Отбор.Вставить("Настройка", Перечисления.ЛБ_ТипыНастроекЗайма.РазбиватьЗалоговыйБилет);
	СтрокиН = НастройкиЗайма.НайтиСтроки(Отбор);
	Если СтрокиН.Количество() = 0 Тогда
		Элементы.ТоварыВыделитьВЗалоговыйБилет.СписокВыбора.Добавить(Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Билет1);
		Возврат;
	ИначеЕсли НЕ СтрокиН.Получить(0).Значение Тогда
		Элементы.ТоварыВыделитьВЗалоговыйБилет.СписокВыбора.Добавить(Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Билет1);
	    Возврат;	
	КонецЕсли;	 

	Если Товары.Количество() = 0 Тогда  
		Элементы.ТоварыВыделитьВЗалоговыйБилет.СписокВыбора.Добавить(Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Билет1);
		Возврат;
	КонецЕсли;	
	КолТовары = Товары.Количество();  
	КолТовары = ?(КолТовары  > 7, 6, КолТовары);
	Для сч = 0 По КолТовары Цикл 
		Элементы.ТоварыВыделитьВЗалоговыйБилет.СписокВыбора.Добавить(Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Получить(сч));
    КонецЦикла;
КонецПроцедуры

