Процедура История(Команда) 
	Если ПакетДокументов.Количество() > 1 Тогда
		СписокВыбора = Новый СписокЗначений; 
		
		Для каждого СтрП Из ПакетДокументов Цикл  
			Если ЗначениеЗаполнено(СтрП.ДокументЗайма) Тогда
		        СписокВыбора.Добавить(СтрП.ДокументЗайма, ПолучитьНомерЗБ(СтрП.ДокументЗайма));  
			КонецЕсли;	  
		КонецЦикла; 
		
		Если НЕ СписокВыбора.Количество() = 0 Тогда
		    ВыбранноеЗначение = ВыбратьИзСписка(СписокВыбора, Элементы.НомераЗБ); 
			Если НЕ ВыбранноеЗначение = неопределено Тогда 
			    ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Клиент", Залогодатель);
				ПараметрыФормы.Вставить("ЗалоговыйБилет", ВыбранноеЗначение.Значение);	 
										
				ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		    КонецЕсли;
		КонецЕсли;
	Иначе	
		Если ЗначениеЗаполнено(ДокументЗайма) Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Клиент", Залогодатель);
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ДокументЗайма);	 
									
			ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	 
	КонецЕсли;	
КонецПроцедуры
	
