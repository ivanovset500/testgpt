&НаКлиенте
Процедура ВставкиНеОцениватьПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Вставки.ТекущиеДанные;
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти.НеОценивать Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;		
	Иначе
		Если СтрокаТабличнойЧасти.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
			
			СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
			ЦенаДрагоценногоКамня(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
			
			Если СтрокаТабличнойЧасти.ЭтоВесовой Тогда
			    СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Вес, 2);
			Иначе
				СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество, 2);
			КонецЕсли;
        КонецЕсли;
	КонецЕсли;	   
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда	
		Если СтрокаТабличнойЧасти.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда 
			СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
			СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
			ПересчитатьСуммТовары(); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьОписаниеИзделия(Стр)  
	МассивСлов = СтрРазделить(СокрЛП(Стр.Описание), " ", ложь);
    Рез = истина;
	ВыборкаСпр = Справочники.ЛБ_НеДопустимыеЗначенияВОписанииИзделия.Выбрать();
	Пока ВыборкаСпр.Следующий() цикл
		Если ВыборкаСпр.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	
		Для каждого Слово из МассивСлов Цикл  
			Если СокрЛП(нрег(Слово)) = СокрЛП(нрег(ВыборкаСпр.Наименование)) Тогда
				Сообщить("В описании изделия найдены недопустимые символы """ + СокрЛП(ВыборкаСпр.Наименование) + """"); 
				Рез = Ложь;
			КонецЕсли;	
		КонецЦикла;	
	Конеццикла;	 
	Возврат Рез;
КонецФункции 

&НаСервере
// Проверяет заполнение полей залогового билета
//
// Параметры
//  Нет
//
// Возвращаемое значение
//  Булево - результат проверки
//
Функция ПроверкаЗаполнения()
	
	Результат = Истина;       
	Если НЕ ЗначениеЗаполнено(Ломбард) тогда
		Результат = Ложь;
		Сообщить("Не выбран ломбард!",СтатусСообщения.Внимание);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Фамилия) тогда
		Результат = Ложь;
		Сообщить("Не заполнена фамилия клиента!",СтатусСообщения.Внимание);
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Имя) тогда
		Результат = Ложь;
		Сообщить("Не заполнено имя клиента!",СтатусСообщения.Внимание);
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(ДатаРождения) тогда
		Результат = Ложь;
		Сообщить("Не заполнена дата рождения клиента!",СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Гражданство) тогда
		Результат = Ложь;
		Сообщить("Не выбрано гражданство клиента!",СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СхемаКредитования) тогда
		Результат = Ложь;
		Сообщить("Не выбрана схема кредитования!",СтатусСообщения.Внимание);
	КонецЕсли;    
	
	Если ПроцентныеСтавкиПоПериодам.Количество() = 0 Тогда
		Результат = Ложь;
		Сообщить("Не определены процентные ставки!",СтатусСообщения.Внимание);
	КонецЕсли;  

	Если НЕ Товары.Количество() Тогда		
		Результат = Ложь;
		Сообщить("Состав залога не указан!",СтатусСообщения.Внимание);		
	КонецЕсли;    
	
	Если Не Результат Тогда
		возврат Результат;
	КонецЕсли;	
	
	Если Результат Тогда
		Если ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
			Если ПустаяСтрока(ДокументКодПодразделения) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить код подразделения!");
				Результат = ложь;
			КонецЕсли;	
			Если ПустаяСтрока(ДокументКемВыдан) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить кем выдан!");
				Результат = ложь;
			КонецЕсли;	
		КонецЕсли;
		Если ((ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
		(ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) Тогда
		    Если ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда 			    
				Парам = Новый Структура("Серия, Номер", СокрЛП(ДокументСерия), СокрЛП(ДокументНомер));
				Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
					Если ЗначениеЗаполнено(ДокументЗайма) Тогда
						Сообщить("Документ найден в списке недействительных паспортов!");
					    Результат = ложь; 
					КонецЕсли;	
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, ДокументДатаВыдачи) Тогда
					Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
				    Результат = ложь;	
				КонецЕсли;	
			ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, ДокументДатаВыдачи) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
			    Результат = ложь;   
			КонецЕсли;	
		ИначеЕсли (ДокументВид = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) И НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(ДатаРождения, ДатаДок) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		    Результат = ложь;
		КонецЕсли;	
		Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, ДокументВидДокументаЗалогодателя, ДокументВид) тогда
			Если НЕ ЗначениеЗаполнено(ДокументСрокДействия) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить срок действия!");
		        Результат = ложь;
			ИначеЕсли ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		        Результат = ложь;
			КонецЕсли;	  
		ИначеЕсли ЗначениеЗаполнено(ДокументСрокДействия) И (ДокументСрокДействия < НачалоДня(ДатаДок)) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		    Результат = ложь;
		КонецЕсли;	      
		Если НЕ Гражданство = Справочники.СтраныМира.Россия Тогда
			Отбор = Новый Структура; 
			Отбор.Вставить("Клиент", Залогодатель);
			Строки = ДопДокументы.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда 
				Сообщить("Не выбран документ удостоверяющий право пребывания клиента на территории РФ!");
		        Результат = ложь;
			Иначе                  
				ЕстьДокументГражданствоНЕРФ = ложь;
				Для каждого Стр Из Строки Цикл
					//Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, Стр.ДокументЗалогодателя, Стр.ВидДокумента) тогда 
					//	Если НЕ ЗначениеЗаполнено(Стр.ДокументСрокДействия) Тогда
					//		Продолжить;
					//	ИначеЕсли Стр.ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
					//		Продолжить;
					//	КонецЕсли;	
					//    ЕстьДокументГражданствоНЕРФ = Истина;
					//	Прервать; 
					//ИначеЕсли ЗначениеЗаполнено(Стр.ДокументСрокДействия) Тогда
					//    Если Стр.ДокументСрокДействия < НачалоДня(ДатаДок) Тогда
					//		Продолжить;
					//	КонецЕсли;	
					//    ЕстьДокументГражданствоНЕРФ = Истина;
					//	Прервать; 
					//Иначе
					//	ЕстьДокументГражданствоНЕРФ = Истина;
					//	Прервать; 
					//КонецЕсли;      	
					Если Стр.ДокументГражданство = Гражданство Тогда
						ЕстьДокументГражданствоНЕРФ = Истина;     
						Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда 
						    Если НЕ ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Стр.ДокументГражданство, Стр.ВидДокументаЗалогодателя, Стр.ВидДокумента) тогда
						        ТекстСообщения1 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоВозраст(ДатаРождения, Стр.ДокументДатаВыдачи); 
								Если НЕ Пустаястрока(ТекстСообщения1) тогда 
								    Сообщить(ТекстСообщения1); 
									Результат = ложь;
								КонецЕсли;	  
							КонецЕсли; 
							ТекстСообщения2 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоКонтактнаяИнформация(Залогодатель, Стр.ДокументДатаВыдачи, ДатаДок); 
							Если НЕ Пустаястрока(ТекстСообщения2) тогда 
								Сообщить(ТекстСообщения2); 
								Результат = ложь;
							КонецЕсли;	 
						КонецЕсли;	 
					КонецЕсли;		
				КонецЦикла;	
				Если НЕ ЕстьДокументГражданствоНЕРФ Тогда
					Сообщить("У клиента нет действующего документа, удостоверяющего право пребывания на территории РФ!");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	  
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПроцентнаяСхема) Тогда
		Сообщить("Не выбрана схема расчета процентов!");
		Результат = ложь;  
		
	ИначеЕсли НЕ ПСК = 0 Тогда  
		ЕстьОшибкиПСК = ложь;
		Для каждого стр Из ПакетДокументов Цикл
			Если стр.ПСК > ПСК Тогда 
				ЕстьОшибкиПСК = Истина;
				//Сообщить("Сумма процентов в год (" + Строка(стр.ВыделитьВЗалоговыйБилет) + ") превышает предельную ставку кредитования!", СтатусСообщения.Важное);  
