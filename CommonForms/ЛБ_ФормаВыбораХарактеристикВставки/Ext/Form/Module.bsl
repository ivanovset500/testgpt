		ФормыОгранки[сч].Вкл = Ложь;
	КонецЦикла;	   
	
	Для сч = 0 По ВидыОгранки.Количество()-1 Цикл 
		ВидыОгранки[сч].Вкл = Ложь;
	КонецЦикла;	
	
	Для сч = 0 По КачествоОгранки.Количество()-1 Цикл 
		КачествоОгранки[сч].Вкл = Ложь;
