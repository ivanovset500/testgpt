	Строки = КачествоОгранки.НайтиСтроки(Отбор);
	Для каждого стр Из строки Цикл     
		Стр.Вкл = ТекСтрока.Вкл;
	Конеццикла;	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьФлажкиФО(Команда)
	Для сч = 0 По ФормыОгранки.Количество()-1 Цикл 
		ФормыОгранки[сч].Вкл = Истина;
	КонецЦикла;	
КонецПроцедуры

