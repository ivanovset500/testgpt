
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь; 
	Если УправлениеДоступом.ЕстьРоль("ЛБ_Суперпользователь") Тогда 
		Суперпользователь = Истина;
	КонецЕсли;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда 
			СотрудникЦО = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ СотрудникЦО Тогда
		Элементы.ДокументыДвиженияГруппаИзъятие.Видимость = ложь; 
		Элементы.ДокументыДвиженияГруппаВозвратИзъятого.Видимость = ложь;
		Элементы.ДокументыДвиженияИсторияЗалога.Видимость = Ложь;
	КонецЕсли;	

	ДатаКон = ТекущаяДатаСеанса();
	ДатаНач = ДатаКон;    
	ДатаНачТекущая = ДатаНач;
	ДатаКонТекущая = ДатаКон;
	Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	Если ТекПользователь.ЭтоЛомбард Тогда  
		Ломбард = ПараметрыСеанса.ТекущийЛомбард; 
		Элементы.Ломбард.Доступность = Ложь;
		//+МАН 19.03.26 Заявка 3750
		Элементы.Организация.Доступность = Ложь;
		//-МАН
		Элементы.ДобавитьПеремещение.Видимость = Ложь; 
		ОтбиратьПо = 0;
		Элементы.ОтбиратьПо.Доступность = Ложь;   
        Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	Иначе      
		Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис; 
		Элементы.Ломбард.Доступность = Истина;
		//+МАН 19.03.26 Заявка 3750
		Элементы.Организация.Доступность = Истина;
		//-МАН
		Элементы.ДобавитьПеремещение.Видимость = Истина; 
        Элементы.ОтбиратьПо.Доступность = Истина; 
		Ответственный = ТекПользователь;
	КонецЕсли;	
	
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон))); 
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Организация", Организация); 
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("ПустаяНакладная", Документы.ЛБ_НакладнаяНаОтгрузку.ПустаяСсылка());
	УстановитьОтбиратьПо();
	УстановитьОтборПоПодразделениямИСкладам();
	Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов());
	ОстаткиПоПеремещениям();                   
	ОбновитьИнформациюИтого();	
КонецПроцедуры     

&НаСервере 
Процедура  УстановитьОтборПоПодразделениямИСкладам() 
	Если ЗначениеЗаполнено(Ломбард) Тогда 
		ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("ОтборПоПодразделениям", Истина); 
		ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Подразделения", ПолучитьСписокПодразделений());
	Иначе  
		ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("ОтборПоПодразделениям", ложь);
		ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Подразделения", Новый СписокЗначений);
	КонецЕсли;	  
	Если ЗначениеЗаполнено(Склад) Тогда  
	    ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("ОтборПоСкладу", Истина); 
		ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Склад", Склад);
	Иначе  
	    ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("ОтборПоСкладу", ложь);
		ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Склад", Справочники.ЛБ_Склады.ПустаяСсылка());
	КонецЕсли;	 
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораСкладов() 
	МассивСкладов = Новый Массив;
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Запрос = новый Запрос; 
		Запрос.УстановитьПараметр("Владелец", Ломбард);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_Склады.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
		               |ГДЕ
		               |	ЛБ_Склады.Владелец = &Владелец";
		Выборка = Запрос.Выполнить().Выбрать();     
		Пока Выборка.Следующий() Цикл 
			МассивСкладов.Добавить(Выборка.Ссылка);
		Конеццикла;	
	КонецЕсли;
	Возврат МассивСкладов;
КонецФункции

&НаСервере
Функция ПолучитьСписокПодразделений()  
	СписокПодразделений = Новый СписокЗначений;
	Если ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		СписокПодразделений.Добавить(Ломбард);
	ИначеЕсли ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
		Возврат ЛБ_ОбщийМодуль.ПолучитьЛомбардыВОтделении(ТекущаяДатаСеанса(), Ломбард);
	КонецЕсли;
	Возврат СписокПодразделений;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	УстановитьДоступностьПечати();
КонецПроцедуры

&НаСервере
Функция ПолучитьТипДокумента(Документ)
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") Тогда 
		Если Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог Тогда
			Возврат 1;
		ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда	
		    Возврат 2;  
		ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда	
		    Возврат 3;  
	    ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога Тогда	
		    Возврат 4;  
        ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога Тогда	
		    Возврат 5;  
        ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога Тогда	
		    Возврат 6;  
        ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога Тогда	
		    Возврат 7;  
        ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления Тогда	
		    Возврат 8;  
		ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты Тогда	
		    Возврат 9; 
		ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВыдачиСОХ Тогда	
		    Возврат 9; 
		ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия Тогда	
		    Возврат 9; 
		ИначеЕсли Документ.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВозвратаИзъятого Тогда	
		    Возврат 9; 
		Иначе
			Возврат 0;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_НакладнаяНаОтгрузку") Тогда 
		Возврат 10;  
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_ПеремещениеОбъектовЗалога") Тогда 
	     Возврат 11; 
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_ОприходованиеОбъектовЗалога") Тогда 
	     Возврат 12; 
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЛБ_Реализация") Тогда 
	     Возврат 13; 	 	 
    Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ДокументыДвиженияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекСтрока = Элементы.ДокументыДвижения.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  				
		ТипДокумента = ПолучитьТипДокумента(ТекСтрока.Регистратор);
		Если НЕ ТипДокумента = 0 Тогда
			Если ТипДокумента < 10 Тогда 
				ПараметрыФормы = Новый Структура;
	            ПараметрыФормы.Вставить("Документ", ТекСтрока.Регистратор);
				ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
				Если ТипДокумента = 1 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗайма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				ИначеЕсли ТипДокумента = 2 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
                ИначеЕсли ТипДокумента = 3 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаОплатыПроцентов", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
				ИначеЕсли ТипДокумента = 4 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗалога", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	            ИначеЕсли ТипДокумента = 5 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ИзъятиеОбъектовЗалога", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
                ИначеЕсли ТипДокумента = 6 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ВозвратОбъектовЗалога", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
                ИначеЕсли ТипДокумента = 7 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаВыдачиЗайма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
                ИначеЕсли ТипДокумента = 8 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
                ИначеЕсли ТипДокумента = 9 Тогда 
					ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаОперацииПоЗайму", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
              	КонецЕсли;	
			Иначе   
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Ключ", ТекСтрока.Регистратор);

				ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыполненияОперации",ЭтаФорма);     
				Если ТипДокумента = 10 Тогда  
					ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
                    ОткрытьФорму("Документ.ЛБ_НакладнаяНаОтгрузку.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);    
				ИначеЕсли ТипДокумента = 11 Тогда 
                    ОткрытьФорму("Документ.ЛБ_ПеремещениеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	            ИначеЕсли ТипДокумента = 12 Тогда 
                    ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
				ИначеЕсли ТипДокумента = 13 Тогда 
                    ОткрытьФорму("Документ.ЛБ_Реализация.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
                КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияОперации(Результат, ДопПараметры) Экспорт 
	Элементы.ДокументыДвижения.Обновить();
	ОстаткиПоПеремещениям();   
	ОбновитьИнформациюИтого();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачПриИзменении(Элемент)  
	Если НЕ ДатаКон = Дата(1,1,1) И НЕ ДатаНач = Дата(1,1,1) Тогда 
		Если ДатаНач > ДатаКон Тогда
			ДатаНач = ДатаНачТекущая;
			Предупреждение("Начальная дата выбранного периода не может быть больше конечной даты периода.", 60); 
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	ДатаНачТекущая = ДатаНач;
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Дата1", НачалоДня(ДатаНач));	
	Элементы.ДокументыДвижения.Обновить(); 
	ОстаткиПоПеремещениям();
	ОбновитьИнформациюИтого();
КонецПроцедуры

&НаКлиенте
Процедура ДатаКонПриИзменении(Элемент)  
	Если НЕ ДатаКон = Дата(1,1,1) И НЕ ДатаНач = Дата(1,1,1) Тогда 
		Если ДатаКон < ДатаНач Тогда
			ДатаКон = ДатаКонТекущая;
			Предупреждение("Конечная дата выбранного периода не может быть меньше начальной даты периода.", 60); 
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	ДатаКонТекущая = ДатаКон;
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ДатаКон, КонецДня(ДатаКон)));
 	Элементы.ДокументыДвижения.Обновить(); 
	ОстаткиПоПеремещениям();      
	ОбновитьИнформациюИтого(); 
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент) 
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Организация", Организация); 
	Элементы.ДокументыДвижения.Обновить();
	ОстаткиПоПеремещениям();       
	ОбновитьИнформациюИтого();
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	УстановитьОтборПоПодразделениямИСкладам();
	Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов());
	Элементы.ДокументыДвижения.Обновить();
	ОстаткиПоПеремещениям();  
	ОбновитьИнформациюИтого();
КонецПроцедуры 

&НаКлиенте
Процедура ЛомбардОчистка(Элемент, СтандартнаяОбработка)
	УстановитьОтборПоПодразделениямИСкладам();
	Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов());
	Элементы.ДокументыДвижения.Обновить();
	ОстаткиПоПеремещениям();  
	ОбновитьИнформациюИтого();
КонецПроцедуры

&НаСервере
Функция ПроверитьКассовыйДеньЗакрыт(Документ = неопределено) 
	СтруктураВозврата = Новый Структура;
	Если Документ = неопределено Тогда
		ДатаПроверки = ?(СотрудникЦО ИЛИ Суперпользователь, ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон)), ТекущаяДатаСеанса());
	Иначе
		ДатаПроверки = КонецДня(Документ.Дата);
	КонецЕсли;	  
	Результат = ЛБ_ОбщийМодуль.ПолучитьЗакрытыйКассовыйДень(ДатаПроверки, Организация, Ломбард); 
	Если НЕ Результат = неопределено Тогда  
		Если Результат.КассовыйДень = НачалоДня(ДатаКон) Тогда        		
			СтруктураВозврата.Вставить("Результат", Истина);
			СтруктураВозврата.Вставить("Сообщение", "Кассовый день " + Формат(ДатаПроверки, "ДФ=dd.MM.yyyy") + " закрыт.");
			Возврат СтруктураВозврата;    
  		КонецЕсли;
	КонецЕсли;	

	СтруктураКС = ЛБ_ОбщийМодуль.ПолучитьТекущийСтатусКассовойСмены(ДатаПроверки, Организация, Ломбард); 
	Если СтруктураКС = неопределено Тогда 
		СтруктураВозврата.Вставить("Результат", Истина);
		СтруктураВозврата.Вставить("Сообщение", "Кассовая смена не открыта.");
		Возврат СтруктураВозврата;
	ИначеЕсли СтруктураКС.Статус = Перечисления.ЛБ_КассоваяСменаСтатус.Закрыта Тогда
			СтруктураВозврата.Вставить("Результат", Истина);
			СтруктураВозврата.Вставить("Сообщение", "Кассовая смена закрыта.");
			Возврат СтруктураВозврата;       
	КонецЕсли;	
	СтруктураВозврата.Вставить("Результат", Ложь);
	Возврат СтруктураВозврата;
КонецФункции

