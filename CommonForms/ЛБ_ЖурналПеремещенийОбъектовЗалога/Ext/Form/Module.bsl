&НаСервере
Функция ДействиеЗапретить(Регистратор, Код) 
	Если НЕ НачалоДня(Регистратор.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
		Если Код = 1 Тогда //проведение   
			Если НЕ Регистратор.Проведен Тогда
				Возврат Истина;  
		    КонецЕсли;	
	    ИначеЕсли Код = 2 Тогда //отмена проведения 
		    Если Регистратор.Проведен Тогда
			    Возврат Истина;  
			КонецЕсли;	
		ИначеЕсли Код = 3 Тогда //удаление
			Если Регистратор.Проведен Тогда
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;    
КонецФункции

&НаСервере
Функция УдалитьНаСервере(Документ)  
	СтруктураВ = новый структура;
	ДокОбъект = Документ.ПолучитьОбъект();  
	Пометка = ?(ДокОбъект.ПометкаУдаления, Ложь, Истина);
	ДокОбъект.УстановитьПометкуУдаления(Пометка);  
	СтруктураВ.Вставить("Результат", Истина);   
	Возврат СтруктураВ;
КонецФункции

&НаКлиенте
Процедура Удалить(Команда)
    ТекСтрока = Элементы.ДокументыДвижения.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  
		КодРегистратора = ПолучитьТипДокумента(ТекСтрока.Регистратор);
		Если КодРегистратора >= 11 Тогда   
			Если КодРегистратора = 13 Тогда 
				Если НЕ Суперпользователь Тогда
					Если ДействиеЗапретить(ТекСтрока.Регистратор, 3) Тогда
						Предупреждение("Пометка на удаление этого документа пользователю запрещена.", 60);
						Возврат;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			СтруктураВ = УдалитьНаСервере(ТекСтрока.Регистратор);
			Если СтруктураВ.Результат Тогда
				Элементы.ДокументыДвижения.Обновить();   
				ОстаткиПоПеремещениям();
				ОбновитьИнформациюИтого();
			Иначе
				Предупреждение(СтруктураВ.Сообщение, 60);
			КонецЕсли;
		Иначе
			Предупреждение("Пометка на удаление этого документа из журнала запрещена.", 60);	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

