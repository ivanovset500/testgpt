&НаСервере
Функция ОстатокНаДатуОперации(Дата) 
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДенежныеСредстваОстатки.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ДенежныеСредстваОстатки.СуммаОстаток) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДенежныеСредства.Остатки(
	               |			&Дата,
	               |			Организация = &Организация
	               |				И Ломбард = &Ломбард
	               |				И ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)) КАК ЛБ_ДенежныеСредстваОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ДенежныеСредстваОстатки.Ломбард"; 
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Возврат Выборка.Сумма;
	КонецЕсли;
	Возврат 0;
КонецФункции

