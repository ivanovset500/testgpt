		Возврат СтруктураВ;
	КонецЕсли;	 
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
		СтруктураВ.Вставить("Результат", Истина); 
		Возврат СтруктураВ;
