		Элементы.ДокументыДвиженияПечатьРеализацияИзделия.Видимость = Истина;
		Элементы.ДокументыДвиженияПечатьРеализацияЛом.Видимость = Истина;
		Элементы.ДокументыДвиженияПечатьРеализацияКассовыйЧек.Видимость = Ложь;
	Иначе	                                                                     
		Элементы.ДокументыДвиженияПечатьРеализацияИзделия.Видимость = Ложь;
