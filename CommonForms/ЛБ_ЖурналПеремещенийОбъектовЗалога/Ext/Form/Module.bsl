&НаКлиенте
Процедура ВыборПериодаЗавершение(Период, ДополнительныеПараметры) Экспорт 
	Если Период = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ДатаНач = Период.ДатаНачала;
    ДатаКон = Период.ДатаОкончания;
	Если НЕ ДатаКон = Дата(1,1,1) И НЕ ДатаНач = Дата(1,1,1) Тогда
		Если  ДатаКон < ДатаНач Тогда 
			ДатаНач = ДатаНачТекущая;
	        ДатаКон = ДатаКонТекущая;
			Предупреждение("Конечная дата выбранного периода не может быть меньше начальной даты периода.", 60);
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	ДатаНачТекущая = ДатаНач;
	ДатаКонТекущая = ДатаКон;
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));
	ДокументыДвижения.Параметры.УстановитьЗначениеПараметра("Дата2", ?(ДатаКон = Дата(1,1,1), ДатаКон, КонецДня(ДатаКон)));	
	Элементы.ДокументыДвижения.Обновить(); 
	ОстаткиПоПеремещениям(); 
	ОбновитьИнформациюИтого();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.ДокументыДвижения.Обновить(); 
	ОстаткиПоПеремещениям();
	ОбновитьИнформациюИтого();
КонецПроцедуры


&НаСервере
Функция ПроверитьПроведен(Документ) 
	Возврат ?(Документ.Проведен, Истина, Ложь);
КонецФункции		

&НаСервере
Функция ПроверитьМожноОтменить(Документ) 
	Если Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков") ИЛИ
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО") ИЛИ 
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВозвратПроцентов") ИЛИ 
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВозвратПроцентовПоЗаявке") ИЛИ
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВозвратРазницыРеализацииНевостребованногоЗалога") ИЛИ 
		 Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.РасходныеОперацииПоСогласованиюСЦО") Тогда   
		Возврат Истина; 
	КонецЕсли;	
    Возврат Ложь;
КонецФункции		

&НаСервере
Процедура УстановитьОтбиратьПо()
	Если ОтбиратьПо = 0 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_Ломбарды";
	    Элементы.Ломбард.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);		
		Элементы.Склад.ТолькоПросмотр = Ложь;   
		Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_ОтделенияЛомбардов") Тогда
			Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
		КонецЕсли;	
	ИначеЕсли ОтбиратьПо = 1 Тогда
		ТипСтр = "СправочникСсылка.ЛБ_ОтделенияЛомбардов";
	    Элементы.Ломбард.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр); 
		Элементы.Склад.ТолькоПросмотр = Истина; 
		Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
			Ломбард = Справочники.ЛБ_ОтделенияЛомбардов.ПустаяСсылка();
		КонецЕсли;	
	КонецЕсли;	
	Значение = Элементы.Ломбард;
    Элементы.Ломбард.ОграничениеТипа.ПривестиЗначение(Значение);
    Элементы.Ломбард.ВыбиратьТип = Ложь;  	
КонецПроцедуры

&НаКлиенте
Процедура ОтбиратьПоПриИзменении(Элемент)  
	УстановитьОтбиратьПо();               
	Склад = ПредопределенноеЗначение("Справочник.ЛБ_Склады.ПустаяСсылка"); 
	Элементы.Склад.СписокВыбора.Очистить();
	УстановитьОтборПоПодразделениямИСкладам();  
	Элементы.ДокументыДвижения.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	УстановитьОтборПоПодразделениямИСкладам();  
	Элементы.ДокументыДвижения.Обновить();
	ОстаткиПоПеремещениям();  
	ОбновитьИнформациюИтого();
КонецПроцедуры   

&НаКлиенте
Процедура СкладОчистка(Элемент, СтандартнаяОбработка)
	УстановитьОтборПоПодразделениямИСкладам();  
	Элементы.ДокументыДвижения.Обновить();
	ОстаткиПоПеремещениям();  
	ОбновитьИнформациюИтого();
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюИтого()    
	Дата1 = ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач));
	Дата2 = ?(ДатаКон = Дата(1,1,1), ТекущаяДатаСеанса(), КонецДня(ДатаКон));
	
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата1", Дата1); 
	Запрос.УстановитьПараметр("Дата2", Дата2);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК Кол
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам КАК ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам
	               |ГДЕ
	               |	ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам.Период МЕЖДУ &Дата1 И &Дата2";
	Если ЗначениеЗаполнено(Ломбард) Тогда
		Запрос.УстановитьПараметр("Подразделения", ПолучитьСписокПодразделений());
		Запрос.Текст = Запрос.Текст + "
	               |	И (ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам.ПодразделениеОтправитель В (&Подразделения)
	               |			ИЛИ ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам.ПодразделениеПолучатель В (&Подразделения))";
	КонецЕсли;	
	Если ЗначениеЗаполнено(Склад) Тогда
		Запрос.УстановитьПараметр("Склад", Склад);
        Запрос.Текст = Запрос.Текст + "
	               |	И (ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам.СкладОтправитель = &Склад
	               |			ИЛИ ЛБ_ОперацииДвиженияОбъектовЗалогаПоСкладам.СкладПолучатель = &Склад)";  
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
        ИтогоОпераций = Выборка.Кол; 
	Иначе 
		ИтогоОпераций = 0;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОстаткиПоПеремещениям()  
		
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("Дата1", ?(ДатаНач = Дата(1,1,1), ДатаНач, НачалоДня(ДатаНач)));  
	Запрос.УстановитьПараметр("Дата2", ?(ДатаКон = Дата(1,1,1), ДатаКон, КонецДня(ДатаКон)));
	Запрос.УстановитьПараметр("Организация", Организация);  
	Условие = "";
	Если ЗначениеЗаполнено(Ломбард) Тогда  
		Запрос.УстановитьПараметр("Подразделения", ПолучитьСписокПодразделений());
        Условие = Условие + " И Ломбард В (&Подразделения)";
	КонецЕсли;	  
	Если ЗначениеЗаполнено(Склад) Тогда
		Запрос.УстановитьПараметр("Склад", Склад);
        Условие = Условие + " И Склад = &Склад";
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНач,
	               |	ЛБ_ОбъектыЗалогаОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКон, 
				   |	ЛБ_ОбъектыЗалогаОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
				    |	ЛБ_ОбъектыЗалогаОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.ОстаткиИОбороты(
	               |			&Дата1,
	               |			&Дата2,
	               |			,
	               |			,
	               |			Организация = &Организация"  + Условие + ") КАК ЛБ_ОбъектыЗалогаОстаткиИОбороты";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ОстатокНач = Выборка.КоличествоНач;
		ОстатокКон = Выборка.КоличествоКон;
		Приход = Выборка.КоличествоПриход; 
		Расход = Выборка.КоличествоРасход;
	Иначе
		ОстатокНач = 0;
		ОстатокКон = 0; 
	КонецЕсли;	 
	                    
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалога.ВидДвижения КАК ВидДвижения,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЛБ_ОбъектыЗалога.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЭтоОперацияЗайма,
	               |	СУММА(ЛБ_ОбъектыЗалога.Количество) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога КАК ЛБ_ОбъектыЗалога
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалога.Период МЕЖДУ &Дата1 И &Дата2
	               |	И ЛБ_ОбъектыЗалога.Организация = &Организация" + Условие + "
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалога.ВидДвижения,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЛБ_ОбъектыЗалога.Регистратор) = ТИП(Документ.ЛБ_ОперацияПоЗалогу)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидДвижения", ВидДвиженияНакопления.Приход); 
	Отбор.Вставить("ЭтоОперацияЗайма", Истина); 
	
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если строки.Количество() = 0 тогда
		ПриходОперации = 0;
	Иначе
		ПриходОперации = Строки.Получить(0).Количество;
	КонецЕсли;	   
	
	Отбор.Вставить("ЭтоОперацияЗайма", Ложь); 
	
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если строки.Количество() = 0 тогда
		ПриходПеремещения = 0;
	Иначе
		ПриходПеремещения = Строки.Получить(0).Количество;
	КонецЕсли;	
		
	Отбор.Вставить("ВидДвижения", ВидДвиженияНакопления.Расход); 
	Отбор.Вставить("ЭтоОперацияЗайма", Истина); 
	
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если строки.Количество() = 0 тогда
		РасходОперации = 0;
	Иначе
		РасходОперации = Строки.Получить(0).Количество;
	КонецЕсли;	   
	
	Отбор.Вставить("ЭтоОперацияЗайма", Ложь); 
	
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
	Если строки.Количество() = 0 тогда
		РасходПеремещения = 0;
	Иначе
		РасходПеремещения = Строки.Получить(0).Количество;
	КонецЕсли;	
		
	//ТекстРасшифровки = "Приход изделий по операциям займа " + Строка(ПриходОперации) + " шт., по остальным операциям " + Строка(ПриходПеремещения) + " шт. " +  
	//     "Расход изделий по операциям займа " + Строка(РасходОперации) + " шт., по остальным операциям " + Строка(РасходПеремещения) + " шт. ";
	
	ТекстРасшифровки = "По операциям займа приход изделий " + Строка(ПриходОперации) + " шт., расход изделий " + Строка(РасходОперации) + " шт. " +
	     "По остальным операциям приход изделий " + Строка(ПриходПеремещения) + " шт., расход изделий " + Строка(РасходПеремещения) + " шт. ";
    Элементы.РасшифровкаОборотаПеремещений.Заголовок = ТекстРасшифровки;
КонецПроцедуры	

&НаКлиенте
Процедура Реализация(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыполненияОперации",ЭтаФорма);
