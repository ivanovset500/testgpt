
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Дата") Тогда
		ДатаОперации = Параметры.Дата;  
	Иначе
		ДатаОперации = ТекущаяДатаСеанса();
	КонецЕсли;	                           
	Если Параметры.Свойство("ОткрытиеЗакрытие") Тогда  
		ОткрытиеЗакрытие = Параметры.ОткрытиеЗакрытие;  
	КонецЕсли;
	ЭтаФорма.Заголовок = "Выбор даты " + ?(ОткрытиеЗакрытие = 0, "открытия ", "закрытия ") + "кассовой смены"; 
	Элементы.ДатаОперации.Заголовок = ?(ОткрытиеЗакрытие = 0, "Открыть ", "Закрыть ") + "кассовую смену на дату ";
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗакрытьСмену(Команда)
    ЭтаФорма.Закрыть(ДатаОперации); 
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры
