&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
        ДокументЗайма = Параметры.Документ;
		ЗалоговыйБилет = ДокументЗайма.ПредыдущаяОперация;
		Если ДокументЗайма.Проведен тогда
			НеРедактировать = Истина;
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		Иначе
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		КонецЕсли;	   
		ДатаДок = ДокументЗайма.Дата; 
		Ломбард = ДокументЗайма.Ломбард;  
		ОтветственныйПользователь = ДокументЗайма.ОтветственныйПользователь;
		ОтветственныйСотрудник = ДокументЗайма.ОтветственныйСотрудник;
		Комментарий = ДокументЗайма.Комментарий;
		Залогодатель = ДокументЗайма.Залогодатель; 
		СхемаКредитования = ДокументЗайма.СхемаКредитования; 
		СрокЗалога = ДокументЗайма.СрокЗалога;
		ОтказОтВыкупа = ДокументЗайма.ОтказОтВыкупа;  
		ПакетДоговоров = ДокументЗайма.ПакетДоговоров;  
		СтатусЗалогодателя = ДокументЗайма.СтатусЗалогодателя; 		
		ЗаполнитьСостояниеЗалоговогоБилета();
		ЗаполнитьТовары(); 
		НомераЗБ = ПолучитьНомераЗБ();
		//+Мельников 25.04.24 Отмена операции
		ОтмененныйДокумент = ДокументЗайма.ОтмененныйДокумент;
		Элементы.ВидОтменненойОперации.Заголовок = "Отмененная операция: " + """" + ДокументЗайма.ОтмененныйДокумент.ВидОперации + """";
		//-        
		БезналичнаяОплата = ОтмененныйДокумент.БезналичнаяОплата;
		Если НЕ БезналичнаяОплата Тогда  
			ДокументЗалогодателя = ДокументЗайма.ДокументЗалогодателя;
			ДопДокументы.Загрузить(ДокументЗайма.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
			ЗаполнитьКонтакнуюИнформациюЗалогодателя();
			ЗаполнитьИнформациюОДокументеЗалогодателя();   
		КонецЕсли;	
		Если БезналичнаяОплата Тогда
			РеестрПлатежей = ОтмененныйДокумент.РеестрПлатежей; 
			СуммаПлатежа = ОтмененныйДокумент.СуммаПлатежа;
			ДатаПлатежа = ОтмененныйДокумент.ДатаПлатежа;
			ИдентификаторПлатежа = ОтмененныйДокумент.ИдентификаторПлатежа; 
			РаспределениеПереплаты = ОтмененныйДокумент.РаспределениеПереплаты;
		КонецЕсли;	 
	Иначе		
		ДатаДок = ТекущаяДатаСеанса();   
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		//Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		//  	ОтветственныйПользователь = ТекПользователь;
		//Иначе
		//	ОтветственныйПользователь = ПараметрыСеанса.ТекущийСотрудник;
		//КонецЕсли;	
		ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
		ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;
	
		Если Параметры.Свойство("ЗалоговыйБилет") Тогда  
			ЗалоговыйБилет = Параметры.ЗалоговыйБилет;
			Ломбард = ЗалоговыйБилет.Ломбард;   
			Залогодатель = ЗалоговыйБилет.Залогодатель; 
			ДокументЗалогодателя = ЗалоговыйБилет.ДокументЗалогодателя;
			СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;
			СрокЗалога = ЗалоговыйБилет.СрокЗалога;
			ОтказОтВыкупа = ЗалоговыйБилет.ОтказОтВыкупа;  
			ПакетДоговоров = ЗалоговыйБилет.ПакетДоговоров;
			ДопДокументы.Загрузить(ЗалоговыйБилет.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
		    ЗаполнитьКонтакнуюИнформациюЗалогодателя();
		   	ЗаполнитьИнформациюОДокументеЗалогодателя();
			СтатусЗалогодателя = ЗалоговыйБилет.СтатусЗалогодателя; 
			ЗаполнитьСостояниеЗалоговогоБилета();
		    ЗаполнитьТовары(); 
			НомераЗБ = ПолучитьНомераЗБ(); 
		КонецЕсли;  
	КонецЕсли;  
	ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
	                              
	ТоварыИтоги();
	Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаЗаемщик;
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументОтменыЗайма(ЗБ)
	ЗапросОтмена = Новый Запрос;  
	ЗапросОтмена.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров);
	ЗапросОтмена.УстановитьПараметр("ЗалоговыйБилет", ЗБ);
	ЗапросОтмена.Текст ="ВЫБРАТЬ
	                    |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	                    |ИЗ
	                    |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	                    |ГДЕ
	                    |	ЛБ_ОперацияПоЗалогу.ПакетДоговоров = &ПакетДоговоров
	                    |	И ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога)
	                    |	И ЛБ_ОперацияПоЗалогу.ПредыдущаяОперация = &ЗалоговыйБилет
	                    |АВТОУПОРЯДОЧИВАНИЕ";
	ВыборкаОтмена = ЗапросОтмена.Выполнить().Выбрать(); 
	Если ВыборкаОтмена.Следующий() Тогда
		Возврат ВыборкаОтмена.Ссылка;
	КонецЕсли;
	Возврат ПредопределенноеЗначение("Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка");
КонецФункции

&НаСервере
Процедура ЗаполнитьТовары() 
	Если ЗначениеЗаполнено(ПакетДоговоров) Тогда  
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров); 
		Запрос.Текст ="ВЫБРАТЬ
		              |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
		              |ИЗ
		              |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
		              |ГДЕ
		              |	ЛБ_ОперацияПоЗалогу.ПакетДоговоров = &ПакетДоговоров
		              |	И ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
		              |АВТОУПОРЯДОЧИВАНИЕ";
		Выборка = Запрос.Выполнить().Выбрать(); 
		Ном = 0;
		Пока Выборка.Следующий() Цикл
			НоваяСтрП = ПакетДокументов.Добавить();			 
			НоваяСтрП.ЗалоговыйБилет = Выборка.Ссылка; 
			НоваяСтрП.ДокументЗайма = ПолучитьДокументОтменыЗайма(Выборка.Ссылка);
			НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Получить(Ном); 
			 
			Ном = Ном + 1;
		КонецЦикла;	  		
	Иначе  
		НоваяСтрП = ПакетДокументов.Добавить();
		НоваяСтрП.ДокументЗайма = ДокументЗайма; 
		НоваяСтрП.ЗалоговыйБилет = ЗалоговыйБилет;
		НоваяСтрП.ВыделитьВЗалоговыйБилет = Перечисления.ЛБ_ВыделитьВЗалоговыйБилет.Билет1; 
	КонецЕсли;	  
	
	ТаблицаТоваров.Очистить();
	Для каждого СтрП Из ПакетДокументов Цикл    
		Для каждого стр Из СтрП.ЗалоговыйБилет.Товары Цикл
			НоваяСтр = ТаблицаТоваров.Добавить(); 
			НоваяСтр.Номерстроки = Стр.Номерстроки;    
			НоваяСтр.Артикул = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(СтрП.ЗалоговыйБилет, Стр.Номерстроки); //+МАН 03.12.24 Было: стр.ОбъектЗалога. Заявка 2904
			НоваяСтр.ОбъектЗалога = стр.ОбъектЗалога; 
			НоваяСтр.СтатусОбъекта = ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(ДатаДок, НоваяСтр.ОбъектЗалога, СтрП.ЗалоговыйБилет);
			НоваяСтр.СуммаСсуды = стр.СуммаСсуды;
			НоваяСтр.СуммаОценки = стр.СуммаОценкиМаксимальная; 
			НоваяСтр.ВыделитьВЗалоговыйБилет = СтрП.ВыделитьВЗалоговыйБилет; 
			НоваяСтр.НомерЗалоговогоБилета = СтрП.ДокументЗайма.НомерЗалоговогоБилета; 
		Конеццикла;	 
	Конеццикла;		
	ТоварыИтогОценка = ТаблицаТоваров.Итог("СуммаОценки");
	ТоварыИтогЗайи = ТаблицаТоваров.Итог("СуммаСсуды");
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСостояниеЗалоговогоБилета() 
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	//Если ЗначениеЗаполнено(ДокументЗайма) Тогда
	//	Запрос.УстановитьПараметр("Период", ДатаДок-1);
	//Иначе	
	    Запрос.УстановитьПараметр("Период", ДатаДок); 
	//КонецЕсли;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период <= &Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСостояний.Очистить();
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрСостояние = ТаблицаЗапроса.Получить(0);
		//Начальные условия займа
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		НоваяСтр.Статус = СтрСостояние.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
		//-
		
		//+Мельников 25.04.24
		//Состояние залогового билета до операции отмены
		ОтборДоОтмены = Новый Структура;
		ОтборДоОтмены.Вставить("Регистратор", ДокументЗайма.ОтмененныйДокумент);
		
		СтатусОтмененнойОперации = ТаблицаЗапроса.НайтиСтроки(ОтборДоОтмены).Получить(0);
		
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета до операции отмены";
		НоваяСтр.КлючСтроки = 2;
		НоваяСтр.Статус = СтатусОтмененнойОперации.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтатусОтмененнойОперации.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтатусОтмененнойОперации.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтатусОтмененнойОперации.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтатусОтмененнойОперации.ДатаНачалаРасчетаПроцентов;
		
		Если ДокументЗайма.ОтмененныйДокумент.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога Тогда
			
			Отбор = Новый структура;
			Отбор.Вставить("КлючСтроки", 3);
			Строки = ДокументЗайма.ТаблицаСостоянийОтмененного.НайтиСтроки(Отбор);  
			Стр = Строки.Получить(0);
			
			Элементы.ТаблицаСостоянийСуммаПроцентовДолг.Видимость = Истина;
			
			НоваяСтр.СуммаПроцентовДолг = Стр.СуммаПроцентовДолг;
			
		КонецЕсли;
		
		//Если ДокументЗайма.ОтмененныйДокумент.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда
		//	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
		//	
		//	Если СтруктураП <> Неопределено Тогда
		//	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		//		ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
		//	Иначе
		//		ПредельноеЗначениеПроцентов = 0;
		//	КонецЕсли;

		//	ОбъектОтмененнойОперации = ДокументЗайма.ОтмененныйДокумент.ПолучитьОбъект();
		//	ПричинаПримененияПроцентнойСхемы = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(ДокументЗайма.ОтмененныйДокумент, ЗалоговыйБилет); 
		//	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
		//	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
		//	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ОбъектОтмененнойОперации, НоваяСтр.ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр); 
		//КонецЕсли;
		
		НоваяСтр.ПроцентнаяСтавка = ?(ДокументЗайма.ОтмененныйДокумент.ПроцентнаяСхема <> 0, ДокументЗайма.ОтмененныйДокумент.ПроцентнаяСхема, ЗалоговыйБилет.ПроцентнаяСхема);
		НоваяСтр.СуммаПроцентовДень = СтатусОтмененнойОперации.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтатусОтмененнойОперации.СуммаПроцентовСрок;
		//-
		
		//Состояние залогового билета после операции отмены
		ОтборПослеОтмены = Новый Структура;
		ОтборПослеОтмены.Вставить("Регистратор", ДокументЗайма);
		
		Попытка
			СтатусОтмененнойОперации = ТаблицаЗапроса.НайтиСтроки(ОтборПослеОтмены).Получить(0);

			НоваяСтр = ТаблицаСостояний.Добавить();
			НоваяСтр.Состояние = "Состояние залогового билета после операции отмены";
			НоваяСтр.КлючСтроки = 3;  	                                          
			НоваяСтр.Статус = СтатусОтмененнойОперации.СтатусЗалоговогоБилета;
			НоваяСтр.СуммаЗайма = СтатусОтмененнойОперации.СуммаЗайма;
			НоваяСтр.ДатаВозврата = СтатусОтмененнойОперации.ДатаВыкупа;
			НоваяСтр.ДатаВозвратаЛьготная = СтатусОтмененнойОперации.ДатаВыкупаЛьготныйСрок; 
			НоваяСтр.ДатаНачалаРасчета = СтатусОтмененнойОперации.ДатаНачалаРасчетаПроцентов;
			НоваяСтр.ПроцентнаяСтавка = ?(ДокументЗайма.ПроцентнаяСхема <> 0, ДокументЗайма.ПроцентнаяСхема, ЗалоговыйБилет.ПроцентнаяСхема);
			НоваяСтр.СуммаПроцентовДень = СтатусОтмененнойОперации.СуммаПроцентовДень;
			НоваяСтр.СуммаПроцентовСрок = СтатусОтмененнойОперации.СуммаПроцентовСрок; 
		Исключение
		КонецПопытки;	
		//-
		//-Мельников
	КонецЕсли;
	
	//ЗаполнитьСтрокуСостоянияПослеОплаты(ДокументЗайма.Выкуп);
	
КонецПроцедуры

