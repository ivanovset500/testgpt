&НаСервере
Процедура ЗаписатьАдресВСтрокуXML()
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Адрес");
	ЗаписьXML.ЗаписатьАтрибут("СтранаКод", ?(Не ЗначениеЗаполнено(Страна), "", Страна.Код));
	ЗаписьXML.ЗаписатьАтрибут("НаселенныйПункт", СокрЛП(НаселенныйПункт));
	ЗаписьXML.ЗаписатьАтрибут("Индекс",          СокрЛП(Индекс));

	// ++ Сербаев 17.05.2023
	ЗаписьXML.ЗаписатьАтрибут("Область",         СокрЛП(Область));
	ЗаписьXML.ЗаписатьАтрибут("Район",           СокрЛП(Район));
	// -- Сербаев 17.05.2023
	
	ЗаписьXML.ЗаписатьАтрибут("Улица",           СокрЛП(Улица));
	ЗаписьXML.ЗаписатьАтрибут("Дом",             СокрЛП(Дом));
	ЗаписьXML.ЗаписатьАтрибут("Корпус",          СокрЛП(Корпус));
	ЗаписьXML.ЗаписатьАтрибут("Квартира",        СокрЛП(Квартира));
	ЗаписьXML.ЗаписатьКонецЭлемента();

	
	АдресСтруктура = ЗаписьXML.Закрыть();	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьАдресXML(СтрXML)
	Если НЕ ПустаяСтрока(СтрXML) Тогда
		ЧтениеXML = Новый ЧтениеXML;
	    ЧтениеXML.УстановитьСтроку(СтрXML);
		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Адрес" Тогда
				КодСтраны = ЧтениеXML.ЗначениеАтрибута("СтранаКод");
				Если НЕ ПустаяСтрока(КодСтраны) Тогда
					Страна = Справочники.СтраныМира.НайтиПоКоду(КодСтраны);
				Иначе
					Страна = Справочники.СтраныМира.ПустаяСсылка();
				КонецЕсли;	
				НаселенныйПункт = ЧтениеXML.ЗначениеАтрибута("НаселенныйПункт");			
				Индекс          = ЧтениеXML.ЗначениеАтрибута("Индекс");
				
				// ++ Сербаев 17.05.2023
				Область         = ЧтениеXML.ЗначениеАтрибута("Область");
				Район           = ЧтениеXML.ЗначениеАтрибута("Район");
				// -- Сербаев 17.05.2023
				
				Улица           = ЧтениеXML.ЗначениеАтрибута("Улица");
				Дом             = ЧтениеXML.ЗначениеАтрибута("Дом");	     
				Корпус          = ЧтениеXML.ЗначениеАтрибута("Корпус");	        
				Квартира        = ЧтениеXML.ЗначениеАтрибута("Квартира");
