&НаКлиенте
Процедура ЗаполнитьАдресСтрокой()
	
	// ++ Сербаев 17.05.2023
	ОшибкаЗаполненияПолей = Ложь;
	СообщениеОшибкиЗаполненияПолей = "";
	РеквизитОшибкиЗааолненияПолей  = "";
		
	ВведеныОдниБуквыДом      = ?(НЕ ПустаяСтрока(Дом),      ЛБ_ОбщегоНазначения.ПроверитьСтрокуНаОдниБуквы(СокрЛП(Дом),      Истина), Ложь);
	ВведеныОдниБуквыКвартира = ?(НЕ ПустаяСтрока(Квартира), ЛБ_ОбщегоНазначения.ПроверитьСтрокуНаОдниБуквы(СокрЛП(Квартира), Истина), Ложь);
	
	Если ВведеныОдниБуквыДом Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Дом не должен состоять из одних букв!'"), , ,"Дом");
		СообщениеОшибкиЗаполненияПолей = "Дом не должен состоять из одних букв!";
		РеквизитОшибкиЗааолненияПолей  = "Дом";
		ОшибкаЗаполненияПолей          = Истина;
	ИначеЕсли ВведеныОдниБуквыКвартира Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Квартира не должна состоять из одних букв!'"), , ,"Квартира");
		СообщениеОшибкиЗаполненияПолей = "Квартира не должна состоять из одних букв!";
		РеквизитОшибкиЗааолненияПолей  = "Квартира";
		ОшибкаЗаполненияПолей          = Истина;
	Иначе
		СтрокаА = ""; 
		
		//СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Индекс),          ?(ПустаяСтрока(СтрокаА), "", " ") + СокрЛП(Индекс), "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Индекс),          ?(ПустаяСтрока(СтрокаА), "", ", ") + СокрЛП(Индекс),  "");
		СтрокаА = СтрокаА + ?(ЗначениеЗаполнено(Страна),        ?(ПустаяСтрока(СтрокаА), "", ", ") + СокрЛП(Страна),  "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Область),         ?(ПустаяСтрока(СтрокаА), "", ", ") + СокрЛП(Область), "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Район),           ?(ПустаяСтрока(СтрокаА), "", ", ") + СокрЛП(Район),   "");
		
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(НаселенныйПункт), ?(ПустаяСтрока(СтрокаА), "", ", ") + СокрЛП(НаселенныйПункт),   "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Улица),           ?(ПустаяСтрока(СтрокаА), "", ", ") + СокрЛП(Улица),             "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Дом),             ?(ПустаяСтрока(СтрокаА), "", ", ") + "д. " + СокрЛП(Дом),       "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Корпус),          ?(ПустаяСтрока(СтрокаА), "", ", ") + "корп. " + СокрЛП(Корпус), "");
		СтрокаА = СтрокаА + ?(НЕ ПустаяСтрока(Квартира),        ?(ПустаяСтрока(СтрокаА), "", ", ") + "кв. " + СокрЛП(Квартира), "");
		
		АдресСтрока = СтрокаА;
	КонецЕсли;	
	// -- Сербаев 17.05.2023
	
КонецПроцедуры

