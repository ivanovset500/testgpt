&НаКлиенте
Процедура АдресОднойСтрокойПриИзменении(Элемент)  
	
	Модифицированность = Истина;
	
	АдресСтрока    = "";
	АдресСтруктура = "";
	Если АдресОднойСтрокой Тогда
		Страна          = ПредопределенноеЗначение("Справочник.СтраныМира.ПустаяСсылка");
		Индекс          = "";
		Область         = "";
		Район           = "";
		НаселенныйПункт = "";
		Улица           = "";
		Дом             = "";
		Корпус          = "";
		Квартира        = "";
	КонецЕсли;

	УстановитьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступность()
	
	Если АдресОднойСтрокой Тогда
		Элементы.Страна.Доступность          = Ложь;
		Элементы.Индекс.Доступность          = Ложь;
		Элементы.Область.Доступность         = Ложь;
		Элементы.Район.Доступность           = Ложь;
		Элементы.НаселенныйПункт.Доступность = Ложь;
		Элементы.Улица.Доступность           = Ложь;
		Элементы.Дом.Доступность             = Ложь;
		Элементы.Корпус.Доступность          = Ложь;
		Элементы.Квартира.Доступность        = Ложь;
		Элементы.АдресСтрока.ТолькоПросмотр  = Ложь;
	Иначе
        Элементы.Страна.Доступность          = Истина;
		Элементы.Индекс.Доступность          = Истина;
		Элементы.Область.Доступность         = Истина;
		Элементы.Район.Доступность           = Истина;
		Элементы.НаселенныйПункт.Доступность = Истина;
		Элементы.Улица.Доступность           = Истина;
		Элементы.Дом.Доступность             = Истина;
		Элементы.Корпус.Доступность          = Истина;
		Элементы.Квартира.Доступность        = Истина;
		Элементы.АдресСтрока.ТолькоПросмотр  = Истина;
	КонецЕсли;
	
КонецПроцедуры

