&НаСервере
Функция ПроверитьЗаполнениеиИндекса() 
	Если Страна = Справочники.СтраныМира.Россия Тогда 
		Если НЕ ЗначениеЗаполнено(Индекс) Тогда
			Возврат Ложь;   
		КонецЕсли;	
	КонецЕсли; 
	Возврат Истина;	
КонецФункции	

&НаКлиенте
Процедура ЗакрытьФормуРучногоВвода()
	
	Если ОшибкаЗаполненияПолей Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОшибкиЗаполненияПолей, , ,РеквизитОшибкиЗааолненияПолей);
	    Возврат;
	КонецЕсли;
	
	Если Не АдресОднойСтрокой Тогда
		
		Если ПроверитьЗаполнение() Тогда 
			ВсеОК = Истина;      
			Если ПроверитьЗаполнениеиИндекса() Тогда
				Если ЗначениеЗаполнено(Индекс) Тогда 
					Если СтрДлина(сокрЛП(Индекс)) <> 6  Тогда
						Сообщить("Индекс должен состоять из 6 символов!"); 
						ВсеОК = Ложь;
					ИначеЕсли ЛБ_ОбщегоНазначения.ПроверкаВсеСимволыНули(Индекс) Тогда 
						ВсеОК = Ложь;
						Сообщить("Индекс не должен содержать только нули!");
					КонецЕсли;
				КонецЕсли;	
			Иначе     
				ВсеОК = Ложь;
				Сообщить("Для российского адреса заполнение индекса обязательно!");
			КонецЕсли;	
			Если ВсеОК Тогда	
				ЗаписатьАдресВСтрокуXML();
				Результат = Новый Структура;
				Результат.Вставить("Представление", АдресСтрока);
				Результат.Вставить("Значение", АдресСтруктура);
				Закрыть(Результат);
			КонецЕсли;	
			
		КонецЕсли;
		
		// ++ Сербаев 31.05.2023
	Иначе
		Результат = Новый Структура;
		Результат.Вставить("Представление", АдресСтрока);
		//Результат.Вставить("Значение", АдресСтруктура);
		Результат.Вставить("Значение", "");
		Закрыть(Результат);
	    // -- Сербаев 31.05.2023
		
	КонецЕсли;
	
КонецПроцедуры	

