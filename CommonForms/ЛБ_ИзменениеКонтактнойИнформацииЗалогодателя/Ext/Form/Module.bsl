&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Владелец") Тогда
	    Залогодатель           = Параметры.Владелец;
		Период = Параметры.Дата;
		ЗаполнитьИнформациюОКонтакте();
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Гражданство) Тогда
		Гражданство = Справочники.СтраныМира.Россия;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступность()
	Если ФактическийСовпадает Тогда
		Элементы.ФактическийАдрес.ТолькоПросмотр = Истина;
	Иначе	
		Элементы.ФактическийАдрес.ТолькоПросмотр = ложь;
	КонецЕсли;	
	
	Если ПочтовыйСовпадает Тогда
		Элементы.ПочтовыйАдрес.ТолькоПросмотр = Истина;
	Иначе	
		Элементы.ПочтовыйАдрес.ТолькоПросмотр = ложь;
	КонецЕсли;	

КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(Период) Тогда
	    Период = ТекущаяДата();
	КонецЕсли;
	Если АдресПоПрописке = ФактическийАдрес Тогда
		ФактическийСовпадает = Истина;
	Иначе	
		ФактическийСовпадает = Ложь;
	КонецЕсли;	
	
	Если АдресПоПрописке = ПочтовыйАдрес Тогда
		ПочтовыйСовпадает = Истина;
	Иначе	
		ПочтовыйСовпадает = Ложь;
	КонецЕсли;	

	УстановитьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ПочтовыйСовпадаетПриИзменении(Элемент)
	ПочтовыйАдрес = АдресПоПрописке;
	ПочтовыйАдресСтруктура = АдресПоПропискеСтруктура;
	УстановитьДоступность();
КонецПроцедуры


&НаКлиенте
Процедура ФактическийСовпадаетПриИзменении(Элемент)
	ФактическийАдрес = АдресПоПрописке;
	ФактическийАдресСтруктура = АдресПоПропискеСтруктура;
	УстановитьДоступность();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюОКонтакте()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Период", Период);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ТелефонСтруктура КАК ТелефонСтруктура,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПропискеСтруктура КАК АдресПоПропискеСтруктура,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдресСтруктура КАК ФактическийАдресСтруктура,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ПочтовыйАдресСтруктура КАК ПочтовыйАдресСтруктура,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияСтрана КАК МестоРожденияСтрана,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияОбласть КАК МестоРожденияОбласть,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияРайон КАК МестоРожденияРайон,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРожденияНаселенныйПункт КАК МестоРожденияНаселенныйПункт
                   |ИЗ
                   |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Период, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаРождения = Выборка.ДатаРождения;
		МестоРождения = Выборка.МестоРождения;
		МестоРожденияСтрана = Выборка.МестоРожденияСтрана;
		МестоРожденияОбласть = Выборка.МестоРожденияОбласть;
		МестоРожденияРайон = Выборка.МестоРожденияРайон;
		МестоРожденияНаселенныйПункт = Выборка.МестоРожденияНаселенныйПункт;
		Пол = Выборка.Пол;
		Гражданство = Выборка.Гражданство;
		Email = Выборка.Email;
		Телефон = Выборка.Телефон;
		АдресПоПрописке = Выборка.АдресПоПрописке;
		АдресПоПропискеСтруктура = Выборка.АдресПоПропискеСтруктура;
		ФактическийАдрес = Выборка.ФактическийАдрес;
		ФактическийАдресСтруктура = Выборка.ФактическийАдресСтруктура;
        ПочтовыйАдрес = Выборка.ПочтовыйАдрес;
		ПочтовыйАдресСтруктура = Выборка.ПочтовыйАдресСтруктура;
    КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьКонтакт()
	// изменим запись рег. сведений
	НаборЗаписей = РегистрыСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СоздатьНаборЗаписей();  			
	НаборЗаписей.Отбор.Период.Установить(Период);
	НаборЗаписей.Отбор.Залогодатель.Установить(Залогодатель);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		НоваяЗапись = НаборЗаписей.Добавить();
	ИначеЕсли НаборЗаписей.Количество() = 1 Тогда
		НоваяЗапись = НаборЗаписей[0];
	КонецЕсли;
	НоваяЗапись.Период = Период;
	НоваяЗапись.Залогодатель = Залогодатель;
	НоваяЗапись.ДатаРождения = ДатаРождения;
	НоваяЗапись.МестоРождения = МестоРождения;
	НоваяЗапись.МестоРожденияСтрана = МестоРожденияСтрана;
	НоваяЗапись.МестоРожденияОбласть = МестоРожденияОбласть;
	НоваяЗапись.МестоРожденияРайон = МестоРожденияРайон;
	НоваяЗапись.МестоРожденияНаселенныйПункт = МестоРожденияНаселенныйПункт;
	НоваяЗапись.Гражданство = Гражданство;
	НоваяЗапись.Телефон = Телефон;
	НоваяЗапись.ТелефонСтруктура = ТелефонСтруктура;
	НоваяЗапись.Пол = Пол;
	НоваяЗапись.Email = Email;
	НоваяЗапись.АдресПоПрописке = АдресПоПрописке;
	НоваяЗапись.АдресПоПропискеСтруктура = АдресПоПропискеСтруктура;
	НоваяЗапись.ФактическийАдрес = ФактическийАдрес;
	НоваяЗапись.ФактическийАдрес = ФактическийАдресСтруктура;
	НоваяЗапись.ПочтовыйАдрес = ПочтовыйАдрес;
	НоваяЗапись.ПочтовыйАдрес = ПочтовыйАдресСтруктура;
	НаборЗаписей.Записать();	
КонецПроцедуры

&НаСервере
Функция ПроверитьПередЗаписью()
	Если НЕ ПустаяСтрока(АдресПоПропискеСтруктура) Тогда
		//Савранин 27.04.2023 -->
		//СтруктураАдреса = УправлениеКонтактнойИнформациейСлужебный.СтрокаJSONВСтруктуру(АдресПоПропискеСтруктура);
		СтруктураАдреса = АдресныйКлассификаторСлужебный.КонтактнаяИнформацияВСтруктуруJSON(АдресПоПропискеСтруктура);
		//<-- Савранин 27.04.2023		
	КонецЕсли;	
	Возврат Истина;
КонецФункции	

&НаКлиенте
Процедура Записать(Команда)
	Если ПроверитьЗаполнение() И ПроверитьПередЗаписью() Тогда
		ЗаписатьКонтакт();
		Закрыть(Истина);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Функция ПолучитьВозрастЗалогодателя()
	Возврат ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
КонецФункции	

&НаКлиенте
Процедура ДатаРожденияПриИзменении(Элемент)
	ЕстьОш = ложь;
	Если ДатаРождения > Период Тогда
	    Сообщить("Дата рождения клиента позже текущей даты! Проверьте правильность ввода даты рождения.", СтатусСообщения.Информация);
		ЕстьОш = истина;
	ИначеЕсли ДатаРождения <= Дата(1922, 01, 01) Тогда
		Сообщить("Клиенту 120 лет?! Проверьте правильность ввода даты рождения.", СтатусСообщения.Информация);
		ЕстьОш = истина;
	КонецЕсли;	
	ВозрастЗалогодателя = ПолучитьВозрастЗалогодателя();
	Если ВозрастЗалогодателя < 18 Тогда
	    Сообщить("Клиенту " + Строка(ВозрастЗалогодателя) + " лет. Выдача займов и прием оплаты по договору займа от лиц, не достигших 18 лет, не осуществляется!", СтатусСообщения.Важное);
		ЕстьОш = истина;
	КонецЕсли;	
    Если ЕстьОш Тогда
	    ДатаРождения = Дата(1,1,1);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораМестаРождения(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	МестоРожденияСтрана = Результат.МестоРожденияСтрана;
	МестоРожденияОбласть = Результат.МестоРожденияОбласть;
    МестоРожденияРайон = Результат.МестоРожденияРайон;
    МестоРожденияНаселенныйПункт = Результат.МестоРожденияНаселенныйПункт;
	МестоРождения = Результат.МестоРождения;

КонецПроцедуры

&НаКлиенте
Процедура МестоРожденияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораМестаРождения",ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МестоРожденияСтрана", МестоРожденияСтрана);
	ПараметрыФормы.Вставить("МестоРожденияОбласть", МестоРожденияОбласть);
	ПараметрыФормы.Вставить("МестоРожденияРайон", МестоРожденияРайон);
