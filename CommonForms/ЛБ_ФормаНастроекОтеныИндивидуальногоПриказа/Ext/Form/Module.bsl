
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ТекущийПриказ") Тогда
		ТекущийПриказ = Параметры.ТекущийПриказ.Ссылка;
		ОтменаСтавок = ТекущийПриказ.ОтменаСтавок;
		ОтменаМеталлов = ТекущийПриказ.ОтменаМеталлов;
		ОтменаВставкок = ТекущийПриказ.ОтменаВставкок;
		
		
	КонецЕсли;

	Если Параметры.Свойство("Залогодатели") Тогда
		Залогодатели.Очистить();
		ЗалогодателиВыбранные.Очистить();
		ЗалогодателиВыбранные.Загрузить(Параметры.Залогодатели.Выгрузить());
		Элементы.ЗалогодателиВыбранныеЗалогодатель.ТекстПодвала = ЗалогодателиВыбранные.Количество();
	КонецЕсли;

	Если Параметры.Свойство("ТолькоПросмотр") Тогда
		ТолькоПросмотр = Параметры.ТолькоПросмотр;
	КонецЕсли;
	
	Если Параметры.Свойство("ОтменяемыеПриказы") Тогда
		ПриказыДляОтмены.Очистить();
		ПриказыДляОтмены.Загрузить(Параметры.ОтменяемыеПриказы.Выгрузить());
	КонецЕсли;
	
	Если НЕ ТолькоПросмотр Тогда
		ЗаполнитьСписокЗалогодателейДляВыбора();
		УдалитьЗалогодателейПриоткрытии();
	КонецЕсли;
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗалогодателейПриоткрытии()
	МассивУдаления = Новый Массив;
	
	Для каждого Стр Из ЗалогодателиВыбранные Цикл
		//СтрЗ = Залогодатели.НайтиПоИдентификатору(Стр); // Получить(СтрМ);
		
		Отбор = Новый Структура;
		Отбор.Вставить("Залогодатель", Стр.Залогодатель);
		
		МассивЗ = Залогодатели.НайтиСтроки(Отбор);
		
		Если МассивЗ.Количество() > 0 Тогда
			МассивУдаления.Добавить(МассивЗ[0]);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрМ Из МассивУдаления Цикл
		Залогодатели.Удалить(СтрМ);
	КонецЦикла;

	Элементы.ЗалогодателиЗалогодатель.ТекстПодвала = Залогодатели.Количество();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	Если ТолькоПросмотр Тогда
		ЭтаФорма.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьИЗакрытьНаСервере()
	
	ДокОбъектОтмены	= ТекущийПриказ.ПолучитьОбъект();

	ДокОбъектОтмены.СтавкиПроцентов.Очистить();
	ДокОбъектОтмены.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
	ДокОбъектОтмены.НастройкаОтклоненийОтБазовыхЦенВставки.Очистить();
	
	ЗагрузитьСтавки = Истина;
	ЗагрузитьМеталлы = Истина;
	ЗагрузитьВставки = Истина;
	
	Для каждого Стр Из ПриказыДляОтмены Цикл
		Если ЗагрузитьСтавки И ОтменаСтавок И Стр.Ставки Тогда
			ДокОбъектОтмены.СтавкиПроцентов.Загрузить(Стр.Приказ.СтавкиПроцентов.Выгрузить());
			ЗагрузитьСтавки = Ложь;
		КонецЕсли;
		
		Если ЗагрузитьМеталлы И ОтменаМеталлов И Стр.Металлы Тогда
			ДокОбъектОтмены.НастройкаОтклоненийОтБазовыхЦенМеталлы.Загрузить(Стр.Приказ.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить());
			ЗагрузитьМеталлы = Ложь;
		КонецЕсли;
		
		Если ЗагрузитьВставки И ОтменаВставкок И Стр.Вставки Тогда
			ДокОбъектОтмены.НастройкаОтклоненийОтБазовыхЦенВставки.Загрузить(Стр.Приказ.НастройкаОтклоненийОтБазовыхЦенВставки.Выгрузить());
			ЗагрузитьВставки = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ДокОбъектОтмены.Залогодатели.Очистить();
	ДокОбъектОтмены.Залогодатели.Загрузить(ЗалогодателиВыбранные.Выгрузить());
	ДокОбъектОтмены.ОтменяемыеПриказы.Очистить();
	ДокОбъектОтмены.ОтменяемыеПриказы.Загрузить(ПриказыДляОтмены.Выгрузить());
	
	//+МАН 13.11.24 Заполнение строки залогодателей в документе. Заявка 2792
	СтрЗалогодателей = "";
	Для каждого Стр Из ДокОбъектОтмены.Залогодатели Цикл
		СтрЗалогодателей = СтрЗалогодателей + ?(ПустаяСтрока(СтрЗалогодателей), "", "; ") + СокрЛП(Стр.Залогодатель.Наименование);
	КонецЦикла;	
	ДокОбъектОтмены.СтрокаЗалогодатели = СтрЗалогодателей; 
	//-МАН
	
	ТекстНомераПриказов = "";
	Для каждого Стр Из ПриказыДляОтмены Цикл
		ТекстНомераПриказов = ?(ТекстНомераПриказов = "", "" + Стр.НомерПриказа, ТекстНомераПриказов + "; " + Стр.НомерПриказа)
	КонецЦикла;
	
	ДокОбъектОтмены.ОтменяемыеПриказыСтрока = ТекстНомераПриказов;
	ДокОбъектОтмены.ОтменаСтавок = ОтменаСтавок;
	ДокОбъектОтмены.ОтменаМеталлов = ОтменаМеталлов;
	ДокОбъектОтмены.ОтменаВставкок = ОтменаВставкок;
	
	ДокОбъектОтмены.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	Если ЗалогодателиВыбранные.Количество() = 0 Тогда
		Предупреждение("Не выбраны залогодатели!");
		Возврат;
	КонецЕсли;
	
	Если НЕ ОтменаСтавок И НЕ ОтменаМеталлов И НЕ ОтменаВставкок Тогда
		Предупреждение("Не выбраны отменяемые условия!");
		Возврат;
	КонецЕсли;
	
	Если ПриказыДляОтмены.Количество() = 0 Тогда
		Если ЗалогодателиВыбранные.Количество() = 1 Тогда
			Предупреждение("По данному клиенту нет условий которые можно отменить");
		ИначеЕсли ЗалогодателиВыбранные.Количество() > 1 Тогда
			Предупреждение("По данным клиентам нет условий которые можно отменить");
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	СохранитьИЗакрытьНаСервере();
	ЭтаФорма.Закрыть(Истина);
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораПриказа(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗалогодателиВыбранные.Очистить();
	
	ТЗЗалогодатели = Результат.Залогодатели.Выгрузить();
	
	ЗалогодателиВыбранные.Загрузить(ТЗЗалогодатели);
	
	МассивУдаления = Новый Массив;
	
	Для каждого Стр Из ТЗЗалогодатели Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Залогодатель", Стр.Залогодатель);
		
		МНайденных = Залогодатели.НайтиСтроки(Отбор);
		
		Для каждого СтрНайденных Из МНайденных Цикл
			МассивУдаления.Добавить(СтрНайденных);
		КонецЦикла;
		
	КонецЦикла;

	Для каждого СтрМ Из МассивУдаления Цикл
		Залогодатели.Удалить(СтрМ);
	КонецЦикла;
	
	ЗалогодателиВыбранные.Сортировать("Залогодатель Возр");
	Залогодатели.Сортировать("Залогодатель Возр");
	Элементы.ЗалогодателиВыбранныеЗалогодатель.ТекстПодвала = ЗалогодателиВыбранные.Количество();
	Элементы.ЗалогодателиЗалогодатель.ТекстПодвала = Залогодатели.Количество();
	ПолучитьПриказыДляОтменыПоЗалогодателям(ОтменаСтавок, ОтменаМеталлов, ОтменаВставкок);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПриказ(Команда)

	Если ЗалогодателиВыбранные.Количество() > 0 Тогда
		Ответ = Вопрос("При загрузке залогодателей из приказа очистится список выбранных залогодателей."
		+ Символы.ПС + "Продолжить?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПриказа", ЭтаФорма);

			ПараметрыФормы = Новый Структура("ТекущаяДата", ТекущаяДата());

			ОткрытьФорму("Документ.ЛБ_ПриказИндивидуальныеУсловия.Форма.ФормаВыбораДокументаОтмены",ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПриказа", ЭтаФорма);
		
		ПараметрыФормы = Новый Структура("ТекущаяДата", ТекущаяДата());
			
		ОткрытьФорму("Документ.ЛБ_ПриказИндивидуальныеУсловия.Форма.ФормаВыбораДокументаОтмены",ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиВыбранныеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	ДобавитьЗалогодателя(Элементы.Залогодатели.ВыделенныеСтроки, Неопределено); //.ТекущиеДанные); //.Залогодатель);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗалогодателя(Массив, ДанныеЗалогодателя) //Залогодатель)

	Если Массив <> Неопределено И ДанныеЗалогодателя = Неопределено Тогда
		
		МассивУдаления = Новый Массив;
		
		Для каждого СтрМ Из Массив Цикл
			СтрЗ = Залогодатели.НайтиПоИдентификатору(СтрМ); // Получить(СтрМ);
			
			Отбор = Новый Структура;
			Отбор.Вставить("Залогодатель", СтрЗ.Залогодатель);
			
			НайденныйЗалогодатель = ЗалогодателиВыбранные.НайтиСтроки(Отбор);
			
			Если НайденныйЗалогодатель.Количество() > 0 Тогда
				Сообщить("" + Строка(СтрЗ.Залогодатель) + " уже выбран.");
				//Возврат;
			Иначе
				НоваяСтр = ЗалогодателиВыбранные.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, СтрЗ);
				
				МассивУдаления.Добавить(СтрЗ);
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрМ Из МассивУдаления Цикл
			Залогодатели.Удалить(СтрМ);
		КонецЦикла;
		
	ИначеЕсли Массив = Неопределено И ДанныеЗалогодателя <> Неопределено Тогда
		
			Отбор = Новый Структура;
			Отбор.Вставить("Залогодатель", ДанныеЗалогодателя.Залогодатель);
			
			НайденныйЗалогодатель = ЗалогодателиВыбранные.НайтиСтроки(Отбор);
			
			Если НайденныйЗалогодатель.Количество() > 0 Тогда
				Сообщить("Данный залогодатель уже выбран.");
				Возврат;
			Иначе
				НоваяСтр = ЗалогодателиВыбранные.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, ДанныеЗалогодателя);
				
				МЗалогодатели = Залогодатели.НайтиСтроки(Отбор);
				
				Если МЗалогодатели.Количество() > 0 Тогда
					Для каждого СтрЗ Из МЗалогодатели Цикл
						Залогодатели.Удалить(СтрЗ);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
	КонецЕсли;
	
	ЗалогодателиВыбранные.Сортировать("Залогодатель Возр");
	Залогодатели.Сортировать("Залогодатель Возр");
	Элементы.ЗалогодателиВыбранныеЗалогодатель.ТекстПодвала = ЗалогодателиВыбранные.Количество();
	Элементы.ЗалогодателиЗалогодатель.ТекстПодвала = Залогодатели.Количество();
	//УстановитьВидимость();
	ПолучитьПриказыДляОтменыПоЗалогодателям(ОтменаСтавок, ОтменаМеталлов, ОтменаВставкок)
	
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ДобавитьЗалогодателя(Неопределено, Элемент.ТекущиеДанные); //.Залогодатель);
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	УдалитьЗалогодателя(Элементы.ЗалогодателиВыбранные.ВыделенныеСтроки, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиВыбранныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	УдалитьЗалогодателя(Неопределено, Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗалогодателя(Массив, ДанныеЗалогодателя)
	
	Если Массив <> Неопределено И ДанныеЗалогодателя = Неопределено Тогда

		МассивУдаления = Новый Массив;
		
		Для каждого СтрМ Из Массив Цикл
			СтрЗ = ЗалогодателиВыбранные.НайтиПоИдентификатору(СтрМ); // Получить(СтрМ);
			
			Отбор = Новый Структура;
			Отбор.Вставить("Залогодатель", СтрЗ.Залогодатель);
			
			НоваяСтр = Залогодатели.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрЗ);
				
			МассивУдаления.Добавить(СтрЗ);
		КонецЦикла;
		
		Для каждого СтрМ Из МассивУдаления Цикл
			ЗалогодателиВыбранные.Удалить(СтрМ);
		КонецЦикла;
		
	ИначеЕсли Массив = Неопределено И ДанныеЗалогодателя <> Неопределено Тогда
		
			Отбор = Новый Структура;
			Отбор.Вставить("Залогодатель", ДанныеЗалогодателя.Залогодатель);
			
			НоваяСтр = Залогодатели.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, ДанныеЗалогодателя);
			
			МЗалогодатели = ЗалогодателиВыбранные.НайтиСтроки(Отбор);
			
			Если МЗалогодатели.Количество() > 0 Тогда
				Для каждого СтрЗ Из МЗалогодатели Цикл
					ЗалогодателиВыбранные.Удалить(СтрЗ);
				КонецЦикла;
			КонецЕсли;
	КонецЕсли;
	
	ЗалогодателиВыбранные.Сортировать("Залогодатель Возр");
	Залогодатели.Сортировать("Залогодатель Возр");
	Элементы.ЗалогодателиВыбранныеЗалогодатель.ТекстПодвала = ЗалогодателиВыбранные.Количество();
	Элементы.ЗалогодателиЗалогодатель.ТекстПодвала = Залогодатели.Количество();
	//УстановитьВидимость();
	ПолучитьПриказыДляОтменыПоЗалогодателям(ОтменаСтавок, ОтменаМеталлов, ОтменаВставкок)
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗалогодателейДляВыбора()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель КАК Залогодатель,
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель.Наименование КАК ЗалогодательНаименование
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		|ГДЕ
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период, ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия, ДЕНЬ) = 0
		|			ТОГДА ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период <= &Дата
		|		ИНАЧЕ ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Залогодатель,
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Залогодатель.Наименование
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
		|ГДЕ
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период, ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия, ДЕНЬ) = 0
		|			ТОГДА ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период <= &Дата
		|		ИНАЧЕ ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия <= &Дата
		|		КОНЕЦ
		|
