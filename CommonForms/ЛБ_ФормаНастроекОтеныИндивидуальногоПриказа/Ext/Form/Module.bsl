			Запрос.УстановитьПараметр("Залогодатель", Стр.Залогодатель);

			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			
			Пока РезультатЗапроса.Следующий() Цикл
				Если Ставки И РезультатЗапроса.Ставки Тогда
					НоваяСтр = ТЗПриказы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, РезультатЗапроса);
					НоваяСтр.Залогодатель = Стр.Залогодатель;
				ИначеЕсли Металлы И РезультатЗапроса.Металлы Тогда
					НоваяСтр = ТЗПриказы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, РезультатЗапроса);
					НоваяСтр.Залогодатель = Стр.Залогодатель;
				ИначеЕсли Вставки И РезультатЗапроса.Вставки Тогда
					НоваяСтр = ТЗПриказы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, РезультатЗапроса);
					НоваяСтр.Залогодатель = Стр.Залогодатель;
				КонецЕсли;
				
				Если (Ставки И РезультатЗапроса.Ставки) ИЛИ (Металлы И РезультатЗапроса.Металлы) ИЛИ (Вставки И РезультатЗапроса.Вставки) Тогда
					Если Ставки И НЕ Металлы И НЕ Вставки Тогда
						НоваяСтр.Ставки = РезультатЗапроса.Ставки;
						НоваяСтр.Металлы = Ложь;
						НоваяСтр.Вставки = Ложь;
					ИначеЕсли Ставки И Металлы И НЕ Вставки Тогда
						НоваяСтр.Ставки = РезультатЗапроса.Ставки;
						НоваяСтр.Металлы = РезультатЗапроса.Металлы;
						НоваяСтр.Вставки = Ложь;
					ИначеЕсли Ставки И Металлы И Вставки Тогда
						НоваяСтр.Ставки = РезультатЗапроса.Ставки;
						НоваяСтр.Металлы = РезультатЗапроса.Металлы;
						НоваяСтр.Вставки = РезультатЗапроса.Вставки;
					ИначеЕсли НЕ Ставки И Металлы И НЕ Вставки Тогда
						НоваяСтр.Ставки = Ложь;
						НоваяСтр.Металлы = РезультатЗапроса.Металлы;
						НоваяСтр.Вставки = Ложь;
					ИначеЕсли НЕ Ставки И Металлы И Вставки Тогда
						НоваяСтр.Ставки = Ложь;
						НоваяСтр.Металлы = РезультатЗапроса.Металлы;
						НоваяСтр.Вставки = РезультатЗапроса.Вставки;
					ИначеЕсли НЕ Ставки И НЕ Металлы И Вставки Тогда
						НоваяСтр.Ставки = Ложь;
						НоваяСтр.Металлы = Ложь;
						НоваяСтр.Вставки = РезультатЗапроса.Вставки;
					ИначеЕсли Ставки И НЕ Металлы И Вставки Тогда
						НоваяСтр.Ставки = РезультатЗапроса.Ставки;
						НоваяСтр.Металлы = Ложь;
						НоваяСтр.Вставки = РезультатЗапроса.Вставки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ТЗПриказы.Свернуть("Залогодатель, Приказ, НомерПриказа, СистемныйНомер, ДатаДокумента, ДатаНачалаДействия, ДатаОкончанияДействия, Ставки, Металлы, Вставки");
		ПриказыДляОтмены.Загрузить(ТЗПриказы);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменаСтавокПриИзменении(Элемент)
	ПолучитьПриказыДляОтменыПоЗалогодателям(ОтменаСтавок, ОтменаМеталлов, ОтменаВставкок);
