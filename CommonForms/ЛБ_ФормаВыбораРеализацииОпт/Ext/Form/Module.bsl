
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	Если Параметры.Свойство("Документ") Тогда
		Ломбард = Параметры.Документ.Ломбард;
		Склад = Параметры.Документ.Склад;  
		Организация = Параметры.Документ.Организация; 
		Дата = Параметры.Документ.Дата;
		ПодбиратьПо = 1;
		УстановитьВидимость(); 		
	Иначе
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	Если ПодбиратьПо = 1 Тогда
		Элементы.ГруппаВес.Видимость = Истина;
	Иначе
		Элементы.ГруппаВес.Видимость = Ложь;
		ВесОт = 0;
		ВесДо = 0;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтоги()
	ИтогКоличество = ТаблицаТоваров.Итог("Количество");
	ИтогВесНовый = ТаблицаТоваров.Итог("ВесМеталлаНовый"); 
	ИтогВесСтарый = ТаблицаТоваров.Итог("ВесМеталла"); 
  	ИтогЦена = ТаблицаТоваров.Итог("ОптоваяЦена");
КонецПроцедуры	  

&НаСервере
Функция РассчитатьВесПоПробе(ПробаСтарая, ВесСтарый)
	Если (Проба.Проба = 585 И ПробаСтарая.Проба = 583) ИЛИ 
		 (Проба.Проба = 583 И ПробаСтарая.Проба = 585) Тогда
		Возврат ВесСтарый;
	Иначе	
	    Возврат ВесСтарый*ПробаСтарая.Проба/Проба.Проба; 
	КонецЕсли;	
КонецФункции	

&НаСервере
Функция РассчитатьЦену(ВесНовый)
	Возврат ВесНовый*ЦенаЗаГрамм; 
КонецФункции  

&НаСервере
Функция ПроверитьВес(ВесНовый) 
	Если ВесДо = 0 Тогда
		Возврат Истина;
	КонецЕсли;	
	ВесДляПроверки = ВесНовыйВ + ВесНовый;
	Если ВесДляПроверки < ВесДо Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции	

&НаСервере
Процедура ЗаполнитьТаблицуТоваров()  
	Запрос = Новый Запрос;  
	СписокОЗ = Новый СписокЗначений;
	СписокЗБ = Новый СписокЗначений;
	Для каждого Стр Из Товары Цикл 
		Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда 
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;	
		Если СписокОЗ.НайтиПоЗначению(Стр.ОбъектЗалога) = неопределено Тогда 
			СписокОЗ.Добавить(Стр.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	       
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЗалоговыеБилеты", СписокЗБ); 
	Запрос.УстановитьПараметр("ОбъектыЗалога", СписокОЗ);  
	Запрос.УстановитьПараметр("Металл", Металл);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	1 КАК Количество,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних.Период КАК ДатаОприходования,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценкиМеталл,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	               |			&Дата,
	               |			ОбъектЗалога В (&ОбъектыЗалога)
	               |				И ЗалоговыйБилет В (&ЗалоговыеБилеты)) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДополнительныеМатериалыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба = ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.Проба
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОприходованныеОбъектыЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних.ОбъектЗалога
	               |ГДЕ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба.Владелец = &Металл
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОприходования";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаТоваров.Загрузить(ТаблицаЗапроса);  
	УдСтроки = Новый СписокЗначений;    
	ВесНовыйВ = 0;
	КоличествоВ = 0;

	Для каждого Стр Из ТаблицаТоваров Цикл
		 СтрокаДолжнаПопадатьВИтоги=истина; //lion 14.08.2025
		 РезультатПроверки = ЛБ_УправлениеЛомбардом.ПроверитьОбъектЗалогаДобавленВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога); 
		 Если НЕ РезультатПроверки = неопределено Тогда 
			 СтрокаДолжнаПопадатьВИтоги=Ложь; //lion 14.08.2025
			 УдСтроки.Добавить(Стр);    
			 Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			 Если ЗначениеЗаполнено(РезультатПроверки.Регистратор) Тогда
			     ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ» № " + СокрЛП(РезультатПроверки.Регистратор.ПредставлениеНомера) + " от " + Формат(РезультатПроверки.Регистратор.Дата, "ДЛФ=");
			 Иначе 
				 ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ», ответственный " + СокрЛП(РезультатПроверки.Ответственный);
			 КонецЕсли;	 
			 ТекстСообщения = ТекстСообщения + ". Добавление в текущий документ невозможно.";
			 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		 КонецЕсли;	   
		 Если ЛБ_УправлениеЛомбардом.ПроверитьЗалоговыйБилетСогласованКОплате(Дата, Стр.ЗалоговыйБилет) Тогда   
			 СтрокаДолжнаПопадатьВИтоги=Ложь; //lion 14.08.2025
			 УдСтроки.Добавить(Стр);                                                                                   
			 Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			 ТекстСообщения = "Внимание! Залоговый билет № " + СокрЛП(Стр.ЗалоговыйБилет.НомерЗалоговогоБилета) + " согласован к оплате, невостребованный залог с артикулом " + СокрЛП(Артикул) + " добавить в текущий документ невозможно.";
			 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		 КонецЕсли;	
		 Если ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(Дата, Стр.ЗалоговыйБилет) = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ГотовКОтправкеОХ Тогда  
			Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			ТекстСообщения = "Внимание! Залоговый билет № " + СокрЛП(Стр.ЗалоговыйБилет.НомерЗалоговогоБилета) + " выкуплен заемщиком, залог с артикулом " + СокрЛП(Артикул) + " добавить в текущий документ невозможно.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);      
			Продолжить;
		КонецЕсли;	
        Если СтрокаДолжнаПопадатьВИтоги тогда //lion 14.08.2025
			Стр.ВесМеталлаНовый = РассчитатьВесПоПробе(Стр.Проба, стр.ВесМеталла);
			Если ПодбиратьПо = 1 Тогда 
				Если ПроверитьВес(Стр.ВесМеталлаНовый) Тогда 
					Стр.Включить = Истина;  
					КоличествоВ = КоличествоВ + Стр.Количество;
					ВесНовыйВ = ВесНовыйВ + Стр.ВесМеталлаНовый;
				    Стр.ОптоваяЦена = РассчитатьЦену(Стр.ВесМеталлаНовый);
				КонецЕсли;	
			Иначе
				Стр.Включить = Истина;                                 
				КоличествоВ = КоличествоВ + Стр.Количество;
				ВесНовыйВ = ВесНовыйВ + Стр.ВесМеталлаНовый;
				Стр.ОптоваяЦена = РассчитатьЦену(Стр.ВесМеталлаНовый); 
			КонецЕсли;
		КонецЕсли; //lion 14.08.2025
	КонецЦикла;	  
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаТоваров.Удалить(Эл.Значение);
	КонецЦикла;

	ЗаполнитьИтоги(); 
	ОбновитьСтрокуИтоги();
КонецПроцедуры	

&НаСервере
Процедура ПолучитьТоварыПоОстаткам()  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбарда(Дата, Организация, Ломбард, Склад); 	
	Товары.Загрузить(ТаблицаЗапроса); 
КонецПроцедуры	

&НаКлиенте
Процедура Заполнить(Команда) 
	Если НЕ ЗначениеЗаполнено(Проба) Тогда
		Предупреждение("Не выбрана проба металла для расчета!", 60);
		Возврат;
	КонецЕсли; 	
	ПолучитьТоварыПоОстаткам();
	ЗаполнитьТаблицуТоваров();
КонецПроцедуры 

&НаСервере
Процедура ДобавитьВТаблицуТоваров(ТаблицаОЗ)     	
	Запрос = Новый Запрос;  
	СписокОЗ = Новый СписокЗначений;
	СписокЗБ = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаОЗ Цикл 
		Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда 
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;	
		Если СписокОЗ.НайтиПоЗначению(Стр.ОбъектЗалога) = неопределено Тогда 
			СписокОЗ.Добавить(Стр.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("ЗалоговыеБилеты", СписокЗБ); 
	Запрос.УстановитьПараметр("ОбъектыЗалога", СписокОЗ);
	Запрос.УстановитьПараметр("Металл", Металл);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	1 КАК Количество,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних.Период КАК ДатаОприходования,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценкиМеталл,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	               |			&Дата,
	               |			ОбъектЗалога В (&ОбъектыЗалога)
	               |				И ЗалоговыйБилет В (&ЗалоговыеБилеты)) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДополнительныеМатериалыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба = ЛБ_ДополнительныеМатериалыОбъектаЗалогаСрезПоследних.Проба
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ОприходованныеОбъектыЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ОприходованныеОбъектыЗалогаСрезПоследних.ОбъектЗалога
	               |ГДЕ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба.Владелец = &Металл
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОприходования";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТаблицаЗапроса Цикл 
		РезультатПроверки = ЛБ_УправлениеЛомбардом.ПроверитьОбъектЗалогаДобавленВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога); 
		Если НЕ РезультатПроверки = неопределено Тогда     
			Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			Если ЗначениеЗаполнено(РезультатПроверки.Регистратор) Тогда
			    ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ» № " + СокрЛП(РезультатПроверки.Регистратор.ПредставлениеНомера) + " от " + Формат(РезультатПроверки.Регистратор.Дата, "ДЛФ=");
			Иначе 
			    ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ», ответственный " + СокрЛП(РезультатПроверки.Ответственный);
			КонецЕсли;	 
			ТекстСообщения = ТекстСообщения + ". Добавление в текущий документ невозможно.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения); 
			Продолжить;
		КонецЕсли;	   
		Если ЛБ_УправлениеЛомбардом.ПроверитьЗалоговыйБилетСогласованКОплате(Дата, Стр.ЗалоговыйБилет) Тогда                                                                                     
			Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			ТекстСообщения = "Внимание! Залоговый билет № " + СокрЛП(Стр.ЗалоговыйБилет.НомерЗалоговогоБилета) + " согласован к оплате, невостребованный залог с артикулом " + СокрЛП(Артикул) + " добавить в текущий документ невозможно.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);      
			Продолжить;
		КонецЕсли;	 
		Если ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(Дата, Стр.ЗалоговыйБилет) = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ГотовКОтправкеОХ Тогда  
			Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			ТекстСообщения = "Внимание! Залоговый билет № " + СокрЛП(Стр.ЗалоговыйБилет.НомерЗалоговогоБилета) + " выкуплен заемщиком, залог с артикулом " + СокрЛП(Артикул) + " добавить в текущий документ невозможно.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);      
			Продолжить;
		КонецЕсли;	

		Отбор = Новый структура;
		Отбор.Вставить("ЗалоговыйБилет", стр.ЗалоговыйБилет);
		Отбор.Вставить("ОбъектЗалога", стр.ОбъектЗалога);
		СтрокиТ = ТаблицаТоваров.НайтиСтроки(Отбор);
		Если СтрокиТ.Количество() = 0 Тогда
		    НоваяСтр = ТаблицаТоваров.Добавить(); 
			НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
			НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
			НоваяСтр.Артикул = Стр.Артикул;
			НоваяСтр.Проба = Стр.Проба;
			НоваяСтр.ВесИзделия = Стр.ВесИзделия;
			НоваяСтр.ВесМеталла = Стр.ВесМеталла;
			НоваяСтр.СуммаОценкиМеталл = Стр.СуммаОценкиМеталл;
			НоваяСтр.Количество = Стр.Количество;
			НоваяСтр.Вставки = Стр.Вставки;  
			НоваяСтр.Группа = Стр.Группа;  
			НоваяСтр.ДатаОприходования = Стр.ДатаОприходования;
			НоваяСтр.Категория = Стр.Категория;
			
			НоваяСтр.ВесМеталлаНовый = РассчитатьВесПоПробе(НоваяСтр.Проба, Новаястр.ВесМеталла);
			Если ПодбиратьПо = 1 Тогда 
				Если ПроверитьВес(НоваяСтр.ВесМеталлаНовый) Тогда 
					НоваяСтр.Включить = Истина;  
					КоличествоВ = КоличествоВ + НоваяСтр.Количество;
					ВесНовыйВ = ВесНовыйВ + НоваяСтр.ВесМеталлаНовый;
				    НоваяСтр.ОптоваяЦена = РассчитатьЦену(НоваяСтр.ВесМеталлаНовый);
				КонецЕсли;	
			Иначе
				НоваяСтр.Включить = Истина;                                 
				КоличествоВ = КоличествоВ + НоваяСтр.Количество; 
				ВесНовыйВ = ВесНовыйВ + НоваяСтр.ВесМеталлаНовый;
				НоваяСтр.ОптоваяЦена = РассчитатьЦену(НоваяСтр.ВесМеталлаНовый); 
			КонецЕсли;	

		КонецЕсли;	
	Конеццикла;    
	ЗаполнитьИтоги();  
	ОбновитьСтрокуИтоги();
КонецПроцедуры	

&НаСервере
Функция ПолучитьТоварыПоОстаткамАртикул(Артикул)  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбардаПоАртикулу(Дата, Организация, Ломбард, Склад, Артикул);
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
	    ДобавитьВТаблицуТоваров(ТаблицаЗапроса); 
		Возврат "";
	Иначе          
		Возврат "Изделие с артикулом " + сокрЛП(Артикул) + " на складе не найдено.";
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоАртикулу(Команда)   
	Если НЕ ЗначениеЗаполнено(Проба) Тогда
		Предупреждение("Не выбрана проба металла для расчета!", 60);
