&НаКлиенте
Процедура Выбрать(Команда)
	Если ПодбиратьПо = 1 И НЕ ВесОт = 0 Тогда 
		Если ВесНовыйВ < ВесОт Тогда  
			Предупреждение("Указанный диапазон веса не достигнут!", 60);
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	//lion+++ 14.08.2025               
	//проверка заполенения Оптовой цены по всем позициям
	ОбнаруженаНезаполненнаяОптоваяЦена=Ложь;
	//+МАН 09.10.25
	сч=1;
	//-МАН
	Для каждого СтрокаТаблицыТоваров из ТаблицаТоваров цикл
		//сч=1; //+МАН 09.10.25 Перенес выше иначе номер всегда был "1".
		//+МАН 09.10.25 Добавил проверку оптовой цены только по выбранным позициям
		Если СтрокаТаблицыТоваров.Включить Тогда
		//-МАН
			Если СтрокаТаблицыТоваров.ОптоваяЦена<=0 тогда
				Артикул = ЛБПолучитьАртикул(Дата, СтрокаТаблицыТоваров.ЗалоговыйБилет, СтрокаТаблицыТоваров.ОбъектЗалога);
				Сообщить("Не задана Оптовая цена в строке "+сч+ " для товара "+Артикул);
				ОбнаруженаНезаполненнаяОптоваяЦена=Истина;
			КонецЕсли;
		//+МАН 09.10.25
		КонецЕсли;
		//-МАН
		сч=сч+1;
	КонецЦикла;
	Если ОбнаруженаНезаполненнаяОптоваяЦена тогда
			Предупреждение("Есть позиции с пустой Оптовой Ценой", 60);
			Возврат;
		Возврат;                                           
	КонецЕсли;
	//lion--- 14.08.2025

	ЗаполнитьТоварыВРеализации();
	Закрыть(Документ);
КонецПроцедуры


&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры


&НаКлиенте
Процедура РасчитатьЦену(Команда)
	Для каждого Стр из ТаблицаТоваров цикл  
		Если НЕ стр.Включить Тогда
			Продолжить;
		КонецЕсли;	  
		Стр.ОптоваяЦена = РассчитатьЦену(Стр.ВесМеталлаНовый);
	КонецЦикла;
	ЗаполнитьИтоги();  
	ОбновитьСтрокуИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицу()
	Для каждого Стр Из ТаблицаТоваров Цикл
        Стр.ВесМеталлаНовый = РассчитатьВесПоПробе(Стр.Проба, стр.ВесМеталла);
		Если Стр.Включить Тогда 
			Если ПроверитьВес(Стр.ВесМеталлаНовый) Тогда 
			    Стр.ОптоваяЦена = РассчитатьЦену(Стр.ВесМеталлаНовый);
			КонецЕсли; 
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры		
		

&НаСервере
Процедура ОбновитьСтрокуИтоги()   
	Элементы.ДекорацияКоличество.Заголовок = Строка(КоличествоВ);
	Элементы.ДекорацияИтоги.Заголовок = СокрЛП(Формат(ВесНовыйВ, "ЧЦ=10; ЧДЦ=2")); 
	Элементы.ДекорацияСумма.Заголовок = СокрЛП(Формат(ТаблицаТоваров.Итог("ОптоваяЦена"), "ЧЦ=15; ЧДЦ=2"));
КонецПроцедуры

&НаКлиенте
Процедура Округлить(Команда)
	Для каждого Стр из ТаблицаТоваров цикл  
		Если НЕ стр.Включить Тогда
			Продолжить;
		КонецЕсли;	  
		Стр.ОптоваяЦена = окр(Стр.ОптоваяЦена, 0, РежимОкругления.Окр15как20);
	КонецЦикла;
	ЗаполнитьИтоги(); 
	ОбновитьСтрокуИтоги();
КонецПроцедуры

&НаСервере
Функция ПолучитьМеталл()  
	Возврат Проба.Владелец;
КонецФункции

&НаКлиенте
Процедура ПробаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Проба) тогда 
		МеталлНовый = ПолучитьМеталл();
		Если НЕ МеталлНовый = Металл Тогда
			Металл = МеталлНовый;  
			ТаблицаТоваров.Очистить();
		Иначе
			ПересчитатьТаблицу(); 
		КонецЕсли;	
		ЗаполнитьИтоги();  
	    ОбновитьСтрокуИтоги();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПодбиратьПоПриИзменении(Элемент)
	УстановитьВидимость(); 
	ТаблицаТоваров.Очистить();   
	КоличествоВ = 0;
	ВесНовыйВ = 0; 
	ЗаполнитьИтоги();
	ОбновитьСтрокуИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровВключитьПриИзменении(Элемент)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекСтрока.Включить Тогда
		Если ПодбиратьПо = 1 Тогда 
			Если ПроверитьВес(ТекСтрока.ВесМеталлаНовый) Тогда 				  
				КоличествоВ = КоличествоВ + ТекСтрока.Количество;
				ВесНовыйВ = ВесНовыйВ + ТекСтрока.ВесМеталлаНовый;
			    ТекСтрока.ОптоваяЦена = РассчитатьЦену(ТекСтрока.ВесМеталлаНовый);
			Иначе
				ТекСтрока.Включить = ложь;
				Предупреждение("Превышен диапазон выбора веса металла", 60);
			КонецЕсли;	
		Иначе                                
			КоличествоВ = КоличествоВ + ТекСтрока.Количество;
			ВесНовыйВ = ВесНовыйВ + ТекСтрока.ВесМеталлаНовый;
			ТекСтрока.ОптоваяЦена = РассчитатьЦену(ТекСтрока.ВесМеталлаНовый); 
		КонецЕсли;	   
	иначе 
		КоличествоВ = КоличествоВ - ТекСтрока.Количество;
		ВесНовыйВ = ВесНовыйВ - ТекСтрока.ВесМеталлаНовый;
		ТекСтрока.ОптоваяЦена = 0; 
	КонецЕсли;	
    ЗаполнитьИтоги();  
	ОбновитьСтрокуИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМножественныйФильтр(Команда)
	 Если НЕ ЗначениеЗаполнено(Проба) Тогда
		Предупреждение("Не выбрана проба металла для расчета!", 60);
		Возврат;
	КонецЕсли; 	 
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПоНесколькимПозициям", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаОтбораРеализацииОпт", , ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицуОтбора(ТаблицаЗапроса)
	УдСтроки = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаРезультатОтбора Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			УдСтроки.Добавить(Стр);
		КонецЕсли;	
	КонецЦикла;
	Для каждого Эл Из УдСтроки Цикл
		ТаблицаРезультатОтбора.Удалить(Эл.Значение);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПолучитьТоварыПоОстаткамМножественныйФильтр(СтруктураОтбора)
    ТаблицаРезультатОтбора.Очистить();
	
	СтрокаФильтр = ""; 
	Если НЕ СтруктураОтбора.ПробыМеталла.Количество() = 0 Тогда		
		СтрокаО = "";
		Для каждого Эл Из СтруктураОтбора.ПробыМеталла Цикл 
			СтрокаО = СтрокаО + ?(ПустаяСтрока(СтрокаО), "", ", ") + СокрЛП(Эл.Значение);
		КонецЦикла;	 
		СтрокаФильтр = СтрокаФильтр + ?(ПустаяСтрока(СтрокаФильтр), "", "; ") + СтрокаО;
	КонецЕсли;
	
	Если НЕ СтруктураОтбора.Категории.Количество() = 0 Тогда
		СтрокаО = "";
		Для каждого Эл Из СтруктураОтбора.Категории Цикл 
			СтрокаО = СтрокаО + ?(ПустаяСтрока(СтрокаО), "", ", ") + СокрЛП(Эл.Значение);
		КонецЦикла;	
		СтрокаФильтр = СтрокаФильтр + ?(ПустаяСтрока(СтрокаФильтр), "", "; ") + СтрокаО;
	КонецЕсли;
	
	Если НЕ СтруктураОтбора.Группы.Количество() = 0 Тогда
		СтрокаО = "";
		Для каждого Эл Из СтруктураОтбора.Группы Цикл 
			СтрокаО = СтрокаО + ?(ПустаяСтрока(СтрокаО), "", ", ") + СокрЛП(Эл.Значение);
		КонецЦикла;	 
		СтрокаФильтр = СтрокаФильтр + ?(ПустаяСтрока(СтрокаФильтр), "", "; ") + СтрокаО;
	КонецЕсли;
	
	Если СтруктураОтбора.ИзделияСБриллиантами Тогда 
        СтрокаФильтр = СтрокаФильтр + ?(ПустаяСтрока(СтрокаФильтр), "", "; ") + "с бриллиантами";
	КонецЕсли; 
	
	Если СтруктураОтбора.ИзделияБезВставок Тогда 
