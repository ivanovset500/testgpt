&НаСервере
Функция ПроверитьДокумент()	
	ВсеОК = Истина;  
	Если ПроверитьЗаполнение() Тогда 
		Если (ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
		 (ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность) Тогда  
		    Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
				Парам = Новый Структура("Серия, Номер", СокрЛП(ДокументСерия), СокрЛП(ДокументНомер));
				Если НЕ (ДокументДействителен ИЛИ ДокументНеДействителен) Тогда
					Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
						Сообщить("Документ найден в списке недействительных паспортов!");
					    ВсеОК = ложь;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			Если ВсеОК И НЕ ДатаРождения = Дата(1,1,1) Тогда
				Если НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(ДатаРождения, ДокументДатаВыдачи) Тогда			
					Сообщить("Документ уже не действителен!");
				    ВсеОК = ложь;
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении Тогда
			Если НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(ДатаРождения) Тогда
				Сообщить("Документ уже не действителен!");
				ВсеОК = ложь;
			КонецЕсли;		
		ИначеЕсли ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(ДокументГражданство, ВидДокументаЗалогодателя, ВидДокумента) Тогда
			Если ДокументСрокДействия = Дата(1,1,1) Тогда
				Сообщить("Необходимо заполнить срок действия документа!");
			    ВсеОК = ложь;  
			ИначеЕсли ДокументСрокДействия < НачалоДня(ТекущаяДата()) Тогда
				Сообщить("Документ просрочен!");
		        ВсеОК = ложь;	
			КонецЕсли;	
		ИначеЕсли НЕ ДокументСрокДействия = Дата(1,1,1) Тогда
			Если ДокументСрокДействия < НачалоДня(ТекущаяДата()) Тогда
				Сообщить("Документ просрочен!");
		        ВсеОК = ложь;
			КонецЕсли;	
		КонецЕсли;
		// ++ Сербаев 08.06.2023  (Проверка документа Вид на жительство на действительность)
		Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда
			СтруктудаД = Новый Структура("ДокументСрокДействия, ДокументДатаВыдачи", ДокументСрокДействия, ДокументДатаВыдачи); 
			Если Не ЛБ_ОбщийМодуль.ПроверитьДействительностьВидаНаЖительство(СтруктудаД, ДатаРождения) Тогда
			    ВсеОК = ложь;
			КонецЕсли;
		КонецЕсли;
        // -- Сербаев 08.06.2023         
		Если ЗначениеЗаполнено(ДокументСерия) ИЛИ ЗначениеЗаполнено(ДокументНомер) Тогда   
			Если ЗначениеЗаполнено(ДокументЗалогодателя) Тогда
		        НайденныйДокумент = ЛБ_ОбщийМодуль.ПроверитьЕстьДокумент(ДокументГражданство, ВидДокумента, ДокументСерия, ДокументНомер, ДокументЗалогодателя);
			Иначе
				НайденныйДокумент = ЛБ_ОбщийМодуль.ПроверитьЕстьДокумент(ДокументГражданство, ВидДокумента, ДокументСерия, ДокументНомер);
			КонецЕсли;	
			Если НЕ НайденныйДокумент = неопределено Тогда  
				НайденныйЗалогодатель = НайденныйДокумент.Владелец;
				Если НЕ (НайденныйЗалогодатель = Залогодатель) Тогда  
					Сообщить("В базе уже есть клиент " + СокрЛП(НайденныйЗалогодатель) + " с документом " + СокрЛП(ВидДокумента) + " серия " + СокрЛП(ДокументСерия) + " номер " + СокрЛП(ДокументНомер) +
					   ", найдите карточку клиента и внесите изменения (при необходимости).");
					ВсеОК = ложь;   
				Иначе 
					Сообщить("У клиента " + СокрЛП(Залогодатель) + " уже есть документ " + СокрЛП(ВидДокумента) + " серия " + СокрЛП(ДокументСерия) + " номер " + СокрЛП(ДокументНомер));					
					ВсеОК = ложь;  
				КонецЕсли;	
			КонецЕсли;  
		КонецЕсли;	
		Если НЕ ПроверитьПоНастройкам() Тогда
			ВсеОК = ложь;
		КонецЕсли;	
	Иначе
		ВсеОК = ложь;
	КонецЕсли;	
	Если НЕ (ДокументДатаВыдачи = Дата(1,1,1)) И (ДокументДатаВыдачи > КонецДня(ТекущаяДата())) Тогда
		Сообщить("Дата выдачи документа не может быть больше текущей даты!");
		ВсеОК = ложь;
	КонецЕсли;	
	Если НЕ (ДокументДатаВыдачи = Дата(1,1,1)) И (ДокументДатаВыдачи < НачалоДня(ДатаРождения)) Тогда
		Сообщить("Дата выдачи документа не может быть меньше даты рождения клиента!");
		ВсеОК = ложь;
	КонецЕсли;	
	Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти Тогда
		Если ДокументДатаСмерти = Дата(1,1,1) Тогда
			Сообщить("Небходимо заполнить дату смерти!");
		    ВсеОК = ложь;    
		ИначеЕсли ДокументДатаВыдачи < ДокументДатаСмерти Тогда
			Сообщить("Дата выдачи свидетельства о смерти не может быть меньше даты смерти!");
		    ВсеОК = ложь;
		КонецЕсли;	
	КонецЕсли;         
	
	Если ЗначениеЗаполнено(ДокументСерия) Тогда
		Если ЛБ_ОбщийМодуль.ПроверитьЕстьТолькоСпецСимволы(ДокументСерия) тогда
			Сообщить("Серия документа не может содержать только специальные символы!");
		    ВсеОК = ложь;
        КонецЕсли;
	КонецЕсли;  
	Если ЗначениеЗаполнено(ДокументНомер) Тогда
		Если ЛБ_ОбщийМодуль.ПроверитьЕстьТолькоСпецСимволы(ДокументНомер) тогда
			Сообщить("Номер документа не может содержать только специальные символы!");
		    ВсеОК = ложь;
        КонецЕсли;
	КонецЕсли;  
	Если ЗначениеЗаполнено(ДокументКемВыдан) Тогда
		Если ЛБ_ОбщийМодуль.ПроверитьЕстьТолькоСпецСимволы(ДокументКемВыдан) тогда
			Сообщить("Кем выдан документ не может содержать только специальные символы!");
		    ВсеОК = ложь;
        КонецЕсли;
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(ДокументНаименованиеИногоДокумента) Тогда 
		Если ЛБ_ОбщийМодуль.ПроверитьЕстьТолькоСпецСимволы(ДокументНаименованиеИногоДокумента) тогда
			Сообщить("Название документа не может содержать только специальные символы!");
		    ВсеОК = ложь;
        КонецЕсли;
	КонецЕсли;     
	
	Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти Тогда
		Если ДокументДатаСмерти > ДокументНачалоДействия Тогда
			Сообщить("Дата смерти клиента не может быть позже даты создания свидетельства о смерти!");
		    ВсеОК = ложь;	 
		КонецЕсли;
	КонецЕсли;	

	Возврат ВсеОК;
КонецФункции 

