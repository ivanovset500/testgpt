	СтруктураВозврата.Вставить("КемВыдан", ДокументКемВыдан);
	СтруктураВозврата.Вставить("КодПодразделения", ДокументКодПодразделения);
	СтруктураВозврата.Вставить("СрокДействия", ДокументСрокДействия);
	СтруктураВозврата.Вставить("НеДействителен", ДокументНеДействителен); 
	СтруктураВозврата.Вставить("Действителен", ДокументДействителен);
	СтруктураВозврата.Вставить("ДатаСмерти", ДокументДатаСмерти);
	//+МАН 04.12.25
	СтруктураВозврата.Вставить("НачалоДействия", ДокументНачалоДействия);
	//-МАН
	
	// ++ Сербаев 24.05.2023 TODO: Сербаев
	СтруктураВозврата.Вставить("СтранаЭмитент", ДокументСтранаЭмитент);
	// -- Сербаев 24.05.2023
	// ++ Сербаев 14.06.2023 (иной документ)
	СтруктураВозврата.Вставить("НаименованиеИногоДокумента", ДокументНаименованиеИногоДокумента);
    // -- Сербаев 14.06.2023
	Закрыть(СтруктураВозврата);
	
КонецПроцедуры
 
