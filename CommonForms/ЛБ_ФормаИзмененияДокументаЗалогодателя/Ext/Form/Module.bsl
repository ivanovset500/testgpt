
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	Если Параметры.Свойство("ТолькоПросмотр") И НЕ Параметры.ТолькоПросмотр = неопределено Тогда
		Элементы.ЗаписатьИЗакрыть.Доступность = ?(Параметры.ТолькоПросмотр, ложь, истина);
	КонецЕсли;	
	Если Параметры.Свойство("Залогодатель") Тогда
		Залогодатель = Параметры.Залогодатель;	
	КонецЕсли;	
	Если Параметры.Свойство("Гражданство") Тогда
		ДокументГражданство = Параметры.Гражданство;
	КонецЕсли;
	Если Параметры.Свойство("ДатаРождения") Тогда
		ДатаРождения = Параметры.ДатаРождения;
	КонецЕсли;
	Если Параметры.Свойство("ДокументЗалогодателя") Тогда
		ДокументЗалогодателя = Параметры.ДокументЗалогодателя;
	КонецЕсли;
	
	// ++ Сербаев 24.05.2023 TODO: Сербаев
	Если Параметры.Свойство("СтранаЭмитент") Тогда
		ДокументСтранаЭмитент = Параметры.СтранаЭмитент;	
	КонецЕсли;
	// -- Сербаев 24.05.2023  
	// ++ Сербаев 14.06.2023 (иной документ)
	Если Параметры.Свойство("ДокументНаименованиеИногоДокумента") Тогда
		ДокументНаименованиеИногоДокумента = Параметры.НаименованиеИногоДокумента;	
	КонецЕсли;
    // -- Сербаев 14.06.2023   
	
	Если Параметры.Свойство("НачалоДействия") Тогда  
		ДокументНачалоДействия = Параметры.НачалоДействия;  
	Иначе
		ДокументНачалоДействия = НачалоДня(ТекущаяДата());
	КонецЕсли;	
	
	Если Параметры.Свойство("КлючСтроки") Тогда
		КлючСтроки = Параметры.КлючСтроки;	
	   	ЗаполнитьИнформациюОДокументе(Параметры); 
		Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
		    Элементы.ИнформацияПаспортРФ.Видимость = Истина;
			ИнформацияПаспортВСпискеНеддействительныхПаспортов();
	    КонецЕсли;			
	Иначе
		Элементы.ДокументНеДействителен.ТолькоПросмотр = Истина;   
		Элементы.ДокументДействителен.ТолькоПросмотр = Истина;   
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВидДокументаЗалогодателя) Тогда
		ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
		ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ДокументГражданство) Тогда
		СписокВыбораВидов = ПолучитьДоступныеВидыДокументовЗалогодателя();
		Элементы.ВидДокументаЗалогодателя.СписокВыбора.Очистить();
		Для каждого Эл Из СписокВыбораВидов Цикл
			Элементы.ВидДокументаЗалогодателя.СписокВыбора.Добавить(Эл.Значение);
		КонецЦикла;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(ВидДокументаЗалогодателя) И ЗначениеЗаполнено(ДокументГражданство) Тогда
		СписокВыбораВидов = ПолучитьДоступныеВидыДокументов();
		Элементы.ВидДокумента.СписокВыбора.Очистить();
		Для каждого Эл Из СписокВыбораВидов Цикл
			Элементы.ВидДокумента.СписокВыбора.Добавить(Эл.Значение);
		КонецЦикла;	
	КонецЕсли;
	
	// ++ Сербаев 24.05.2023 TODO: Сербаев
	Если Не ЗначениеЗаполнено(ДокументСтранаЭмитент) Тогда
		Если ДокументГражданство = Справочники.СтраныМира.Россия Тогда
			ДокументСтранаЭмитент = ДокументГражданство;
		ИначеЕсли ДокументГражданство = Справочники.СтраныМира.БезГражданства Тогда
			Если ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ Тогда
			    ДокументСтранаЭмитент = Справочники.СтраныМира.Россия;
			Иначе 
			    ДокументСтранаЭмитент = ДокументГражданство;
			КонецЕсли;
		Иначе		
			Если ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ Тогда
			    ДокументСтранаЭмитент = Справочники.СтраныМира.Россия;
			Иначе 
			    ДокументСтранаЭмитент = ДокументГражданство;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
    // -- Сербаев 24.05.2023
	
	УстановитьВидимость();	
КонецПроцедуры 

&НаСервере
Процедура ИнформацияПаспортВСпискеНеддействительныхПаспортов()
	Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда  
		Если НЕ ПустаяСтрока(ДокументСерия) И НЕ ПустаяСтрока(ДокументНомер) Тогда 
			Элементы.ИнформацияПаспортРФ.Видимость = Истина;
			Парам = Новый Структура("Серия, Номер", СокрЛП(ДокументСерия), СокрЛП(ДокументНомер));
			Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда
				Элементы.ИнформацияПаспортРФ.ЦветТекста = WebЦвета.Красный;
				Элементы.ИнформацияПаспортРФ.Заголовок = "Паспорт найден в списке недействительных паспортов";  
				Элементы.ДокументДействителен.ТолькоПросмотр = ложь;
			Иначе
				Элементы.ИнформацияПаспортРФ.ЦветТекста = WebЦвета.Зеленый;
				Элементы.ИнформацияПаспортРФ.Заголовок = "Паспорт не найден в списке недействительных паспортов";
				Элементы.ДокументДействителен.ТолькоПросмотр = Истина;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимость()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", ВидДокументаЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Реквизит КАК Реквизит,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен КАК Обязателен,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Видимость КАК Видимость,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.КоличествоСимволов КАК КоличествоСимволов,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ТолькоЦифры КАК ТолькоЦифры
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя КАК ЛБ_НастройкаРеквизитовДокументовЗалогодателя
	               |ГДЕ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокумента = &ВидДокумента
	               |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		ЭлементФормы = Элементы[Выборка.Реквизит.ИмяПредопределенныхДанных];
		Если НЕ Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументКодПодразделения Тогда
		    Элементы[Выборка.Реквизит.ИмяПредопределенныхДанных].Маска = "";
		КонецЕсли;	
		Если НЕ Выборка.Обязателен Тогда
			ЭлементФормы.АвтоОтметкаНезаполненного = Ложь;
		КонецЕсли;
		ЭлементФормы.Видимость = Выборка.Видимость; 
		Если НЕ Выборка.КоличествоСимволов = 0 Тогда
			Если НЕ Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументКодПодразделения Тогда
				Маска = "";
				Если Выборка.ТолькоЦифры Тогда					
					Если НЕ ЗначениеЗаполнено(Маска) Тогда
						Для сч = 0 По Выборка.КоличествоСимволов - 1 Цикл
							Маска = Маска + "9";
						Конеццикла;	
					КонецЕсли;	
				КонецЕсли;          
				Элементы[Выборка.Реквизит.ИмяПредопределенныхДанных].Маска = Маска;
			КонецЕсли;
		ИначеЕсли (Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументНомер) ИЛИ (Выборка.Реквизит = Справочники.ЛБ_РеквизитыДокументовЗалогодателя.ДокументСерия) Тогда
            Маска = "";
			Если Выборка.ТолькоЦифры Тогда					
				Если НЕ ЗначениеЗаполнено(Маска) Тогда
					Для сч = 0 По Выборка.КоличествоСимволов - 1 Цикл
						Маска = Маска + "9";
					Конеццикла;	
				КонецЕсли;	
			КонецЕсли;
			Элементы[Выборка.Реквизит.ИмяПредопределенныхДанных].Маска = Маска;
		КонецЕсли;	
	Конеццикла;	
	Если ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти") Тогда
		Элементы.ДокументДатаСмерти.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьИнформациюОДокументе(Параметры)
	ВидДокументаЗалогодателя = Параметры.ВидДокументаЗалогодателя;
	ВидДокумента = Параметры.ВидДокумента;
	ДокументГражданство = Параметры.Гражданство;
	ДокументСерия = Параметры.Серия;
	ДокументНомер = Параметры.Номер;
	ДокументДатаВыдачи = Параметры.ДатаВыдачи;
	ДокументКемВыдан = Параметры.КемВыдан;
	ДокументКодПодразделения = Параметры.КодПодразделения;
	ДокументСрокДействия = Параметры.СрокДействия;
	ДокументНеДействителен = Параметры.НеДействителен; 
	ДокументДействителен = Параметры.Действителен;
	ДокументДатаСмерти = Параметры.ДатаСмерти;

	// ++ Сербаев 24.05.2023 TODO: Сербаев
    ДокументСтранаЭмитент = Параметры.СтранаЭмитент; 
	// -- Сербаев 24.05.2023
	// ++ Сербаев 14.06.2023 (иной документ)
	ДокументНаименованиеИногоДокумента = Параметры.НаименованиеИногоДокумента;
    // -- Сербаев 14.06.2023
	
КонецПроцедуры	

