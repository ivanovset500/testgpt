&НаСервере
Функция ПроверитьПоНастройкам()
	Результат = Истина;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", ВидДокументаЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Реквизит КАК Реквизит,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.КоличествоСимволов КАК КоличествоСимволов,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ТолькоЦифры КАК ТолькоЦифры
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя КАК ЛБ_НастройкаРеквизитовДокументовЗалогодателя
	               |ГДЕ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокумента = &ВидДокумента
	               |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
	               |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Видимость = ИСТИНА";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		Реквизит = ЭтаФорма[Выборка.Реквизит.ИмяПредопределенныхДанных];
		Если НЕ Выборка.КоличествоСимволов = 0 Тогда
			Если НЕ СтрДлина(СокрЛП(Реквизит)) = Выборка.КоличествоСимволов Тогда
				Сообщить("Для документа " + СокрЛП(ВидДокумента) + " количество символов реквизита " + СокрЛП(Выборка.Реквизит) + " должно быть равным " + Строка(Выборка.КоличествоСимволов));
				Результат = ложь;
			КонецЕсли;	
		КонецЕсли;	
		Если Выборка.ТолькоЦифры ИЛИ Выборка.Реквизит.ИмяПредопределенныхДанных = "ДокументКодПодразделения" Тогда
			Если Выборка.Реквизит.ИмяПредопределенныхДанных = "ДокументКодПодразделения" Тогда
				Если ЛБ_ОбщегоНазначения.ПроверкаВсеСимволыНули(СокрЛП(Реквизит), "-") Тогда
					Сообщить("Для документа " + СокрЛП(ВидДокумента) + " реквизит " + СокрЛП(Выборка.Реквизит) + " не должен содержать только нули.");
				    Результат = ложь;
				КонецЕсли;	
			Иначе	
				Если НЕ ЛБ_ОбщийМодуль.ПроверкаТолькоЦифры(СокрЛП(Реквизит)) Тогда
					Сообщить("Для документа " + СокрЛП(ВидДокумента) + " реквизит " + СокрЛП(Выборка.Реквизит) + " должен содержать только цифры.");
				    Результат = ложь;
				КонецЕсли;
				Если ЛБ_ОбщегоНазначения.ПроверкаВсеСимволыНули(СокрЛП(Реквизит)) Тогда
					Сообщить("Для документа " + СокрЛП(ВидДокумента) + " реквизит " + СокрЛП(Выборка.Реквизит) + " не должен содержать только нули.");
				    Результат = ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	Конеццикла;	
    Возврат Результат;
КонецФункции	

