&НаКлиенте
Процедура ВидДокументаЗалогодателяПриИзменении(Элемент)
	
	// ++ Сербаев 24.05.2023 TODO: Сербаев
	Если ЗначениеЗаполнено(ВидДокументаЗалогодателя) Тогда
		Если ВидДокументаЗалогодателя = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ") Тогда
		    ДокументСтранаЭмитент =  ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
		Иначе
		    ДокументСтранаЭмитент =  ДокументГражданство;
		КонецЕсли;
	КонецЕсли;	
    // -- Сербаев 24.05.2023
	
	Если ЗначениеЗаполнено(ВидДокументаЗалогодателя) И ЗначениеЗаполнено(ДокументГражданство) Тогда
		СписокВыбораВидов = ПолучитьДоступныеВидыДокументов();
		Элементы.ВидДокумента.СписокВыбора.Очистить();
		Для каждого Эл Из СписокВыбораВидов Цикл
			Элементы.ВидДокумента.СписокВыбора.Добавить(Эл.Значение);
		КонецЦикла;	
	КонецЕсли;    
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	Элементы.ИнформацияПаспортРФ.Видимость = Ложь;
	Если ВидДокумента = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ") Тогда
	    ИнформацияПаспортВСпискеНеддействительныхПаспортов();
    КонецЕсли;	
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", ВидДокументаЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Реквизит КАК Реквизит,
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен КАК Обязателен
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя КАК ЛБ_НастройкаРеквизитовДокументовЗалогодателя
	               |ГДЕ
	               |	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокумента = &ВидДокумента
	               |	И ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		Если НЕ Выборка.Обязателен Тогда
			ИндексПоля = ПроверяемыеРеквизиты.Найти(Выборка.Реквизит.ИмяПредопределенныхДанных);
			Если ИндексПоля <> Неопределено Тогда
			    ПроверяемыеРеквизиты.Удалить(ИндексПоля);
			КонецЕсли;
		КонецЕсли;	
	Конеццикла;	
КонецПроцедуры

