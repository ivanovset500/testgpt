&НаСервере
Процедура ЗаполнитьСписокВыбораДоверенностейПлательщика() 
	Элементы.Доверенность.СписокВыбора.Очистить();
	Если Плательщик = ЗалоговыйБилет.Залогодатель Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.УстановитьПараметр("Клиент", ЗалоговыйБилет.Залогодатель);
	Запрос.УстановитьПараметр("Представитель", Плательщик);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Клиент = &Клиент
	               |				И Доверенность.ПредставительКлиента = &Представитель
	               |				И СтатусДоверенности = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена)) КАК ЛБ_ДоверенностиСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать(); 	
	Пока Выборка.Следующий() Цикл  
		Если Выборка.Доверенность.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда   
			ОписаниеДоверенности = "Свидетельство о праве на наследство № " + СокрЛП(Выборка.Доверенность.НомерДоверенности) + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy");
		Иначе	
			Если Выборка.Доверенность.СрокДействияДоверенности  < НачалоДня(ДатаДок) Тогда
				Продолжить;
			КонецЕсли;	      
			ОписаниеДоверенности = "Доверенность " + НРег(строка(Выборка.Доверенность.ВидДоверенности)) + " № " +
					   ?(НЕ ПустаяСтрока(Выборка.Доверенность.НомерДоверенности), СокрЛП(Выборка.Доверенность.НомерДоверенности), "б/н") + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
					   " действует до " + Формат(Выборка.Доверенность.СрокДействияДоверенности, "ДФ=dd.MM.yyyy");   
		КонецЕсли;			   
		Элементы.Доверенность.СписокВыбора.Добавить(Выборка.Доверенность, ОписаниеДоверенности);
	Конеццикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстДоверенности()   
	Если ЗначениеЗаполнено(ДоверенностьПлательщика) Тогда  
		Если ДоверенностьПлательщика.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда   
			Доверенность = "Свидетельство о праве на наследство № " + СокрЛП(ДоверенностьПлательщика.НомерДоверенности) + " от " + Формат(ДоверенностьПлательщика.ДатаДоверенности, "ДФ=dd.MM.yyyy"); 
		Иначе	
		    Доверенность = "Доверенность " + НРег(строка(ДоверенностьПлательщика.ВидДоверенности)) + " № " +                                                                                               		
				   ?(НЕ ПустаяСтрока(ДоверенностьПлательщика.НомерДоверенности), СокрЛП(ДоверенностьПлательщика.НомерДоверенности), "б/н") + " от " + Формат(ДоверенностьПлательщика.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
				   " действует до " + Формат(ДоверенностьПлательщика.СрокДействияДоверенности, "ДФ=dd.MM.yyyy"); 
		КонецЕсли;		   
	Иначе
		Доверенность = "";
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьПлательщикЭтоЗаемщик() 
	Возврат ?(Плательщик = ЗалоговыйБилет.Залогодатель, Истина, Ложь);
КонецФункции	

&НаКлиенте
Процедура ПослеВыбораПлательщика(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	СписокСС = ПолучитьСлужебныеСтатусыКлиента(Результат.Залогодатель);  
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение);
			Если СтруктураВозврата.Запрет Тогда    
				ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов");
				//+МАН 03.04.26 Изменено сообщение. Заявка 3759
				//Предупреждение("Для клиента " + СокрЛП(Результат.Залогодатель) + " определен запрет на операцию " + Строка(ВидОперации), 60, "Проверка служебных статусов клиента");
				Предупреждение("Клиенту " + СокрЛП(Результат.Залогодатель) + " присвоен служебный статус """ + Строка(Элемент.Значение) + """, в связи с чем запрещена операция: """ + Строка(ВидОперации) + """", 60, "Проверка служебных статусов клиента");
				//-МАН
				Возврат;  
			Иначе
				ПредупреждениеП = СтруктураВозврата.Предупредить;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена, , "Проверка служебных статусов клиента"); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;  

	Если Результат.Свойство("Залогодатель") Тогда 
		Плательщик = Результат.Залогодатель;
		ЗаполнитьКонтакнуюИнформацию();
	конецЕсли;	
	
	Если Результат.Свойство("ДокументЗалогодателя") Тогда
		ДокументПлательщика = Результат.ДокументЗалогодателя; 
		ЗаполнитьИнформациюОДокументе();
	КонецЕсли;	  
	ЗаполнитьДопДокументы();
	
	Если НЕ ПроверитьПлательщикЭтоЗаемщик() Тогда
		Элементы.ГруппаДоверенность.Видимость = Истина;
		ЗаполнитьСписокВыбораДоверенностейПлательщика();
		Если НЕ Элементы.Доверенность.СписокВыбора.Количество() = 0 Тогда 
			ДоверенностьПлательщика = Элементы.Доверенность.СписокВыбора.Получить(0).Значение;
			ЗаполнитьТекстДоверенности();
		КонецЕсли;      
		ПроверитьОХПоПлательщику();
		Если НЕ СуммаОплаты = 0 тогда 			
		    ЗаполнитьСтрокуСостоянияПослеОплаты(Выкуп); 
			Если Выкуп Тогда
				ЗаполнитьТоварыПослеВыкупа(ложь);           				
			КонецЕсли;                                  
			ЗаполнитьСостояниеТоваровПерезалог();
		КонецЕсли;		
	иначе
		Элементы.ГруппаДоверенность.Видимость = ложь; 
		ДоверенностьПлательщика = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
	КонецЕсли;     	
	ИнформацияОплата();
    УстановитьВидимость();
КонецПроцедуры


&НаКлиенте
Процедура ФИОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Плательщик) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Плательщик);
	КонецЕсли;	  
    ПараметрыФормы.Вставить("Дата", ДатаДок);  	
	Если НЕ ЗначениеЗаполнено(ДокументОплаты) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ПараметрыФормы.Вставить("НаТекущуюДату", Истина);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов"));
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПлательщика",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры


&НаКлиенте
Процедура ПаспортНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Плательщик) Тогда
		ПараметрыФормы.Вставить("Залогодатель", Плательщик);
	КонецЕсли;	
	ПараметрыФормы.Вставить("Дата", ДатаДок);
	Если НЕ ЗначениеЗаполнено(ДокументОплаты) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ПараметрыФормы.Вставить("НаТекущуюДату", Истина);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов"));
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПлательщика",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры


&НаКлиенте
Процедура ДоверенностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыбЭлемент = ЭтаФорма.ВыбратьИзСписка(Элемент.СписокВыбора, Элемент, 0);
	Если НЕ ВыбЭлемент = Неопределено Тогда 
		ДоверенностьПлательщика = ВыбЭлемент.Значение;    
		ЗаполнитьТекстДоверенности();  
		ПроверитьОХПоПлательщику();
		Если НЕ СуммаОплаты = 0 тогда
		    ЗаполнитьСтрокуСостоянияПослеОплаты(Выкуп); 
			Если Выкуп Тогда
				ЗаполнитьТоварыПослеВыкупа(Ложь);				 
	        КонецЕсли;
		КонецЕсли;   
		ЗаполнитьСостояниеТоваровПерезалог();
		ИнформацияОплата(); 		
	КонецЕсли;
КонецПроцедуры   

&НаКлиенте
Процедура ДоверенностьОчистка(Элемент, СтандартнаяОбработка)  
	ДоверенностьПлательщика = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
	ПроверитьОХПоПлательщику();
	Если НЕ СуммаОплаты = 0 тогда
		ЗаполнитьСтрокуСостоянияПослеОплаты(Выкуп); 
		Если Выкуп Тогда
			ЗаполнитьТоварыПослеВыкупа(Ложь);
		КонецЕсли;  
		ЗаполнитьСостояниеТоваровПерезалог();
		ИнформацияОплата(); 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НаличныеПриИзменении(Элемент)
	Сдача = Наличные - СуммаОплаты;
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьСтрокуСостоянияПослеОплаты(ЭтоВыкуп = ложь)            
	Отбор = Новый структура;
	Отбор.Вставить("КлючСтроки", 2);
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтрНач = Строки.Получить(0);  
	Если СтрНач.СуммаЗайма + СтрНач.СуммаПроцентовДолг = СуммаОплаты Тогда
		ЭтоВыкуп = Истина;
	КонецЕсли;	
	СуммаПроцентовНач = СтрНач.СуммаПроцентовДолг;  
	СуммаПроцентовДень = СтрНач.СуммаПроцентовДень;
	ДатаНачалаРасчетаНач = СтрНач.ДатаНачалаРасчета;
	НомерДопСоглашенияНач = СтрНач.НомерДС;
	СтатусЗБ = СтрНач.Статус;
	Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен ИЛИ 
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство тогда
	    БезПродленияДоговора = Истина;
	Иначе	
        БезПродленияДоговора = ЗалоговыйБилет.СхемаКредитования.БезПродленияДоговора;
	КонецЕсли;  
	ДатаНачалаРасчета = КонецДня(ДатаДок)+1;
	
	Отбор = Новый структура;
	Отбор.Вставить("КлючСтроки", 3);
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтрКон = Строки.Получить(0);  

	Если ЭтоВыкуп Тогда  
		МожноЗакрытьБилет = Истина;
		Для каждого Стр из ТаблицаТоваров цикл
			Если Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен ИЛИ Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ Стр.ВернутьЗалог Тогда
				МожноЗакрытьБилет = Ложь;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Если СтрНач.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен Тогда
			СтрКон.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ГотовКОтправкеОХ; 
			ВыдачаЗалога = Ложь;
		Иначе	
			Если НЕ ОХ И МожноЗакрытьБилет Тогда
				СтрКон.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт; 
				ВыдачаЗалога = Истина;
			Иначе                                                              
				СтрКон.Статус = ?(СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство, СтатусЗБ, Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение);
				ВыдачаЗалога = Ложь;
			КонецЕсли;  
		КонецЕсли;	
		СтрКон.ПроцентнаяСтавка = 0; 			
		СтрКон.ДатаВозврата = Дата(1,1,1);
		СтрКон.ДатаВозвратаЛьготная = Дата(1,1,1);	
		СтрКон.СуммаЗайма = 0;  
        СтрКон.СуммаПроцентовДень = 0;
		СтрКон.СуммаПроцентовДолг = 0;
		//НомерДопСоглашения = НомерДопСоглашенияНач;  
		//СтрКон.НомерДС = НомерДопСоглашенияНач;
	Иначе	
		Если НЕ БезПродленияДоговора Тогда  
			СуммаПроцентовДеньРасчет = СтрНач.СуммаЗайма*СтрНач.ПроцентнаяСтавка/100;    
			ОстатокПроцентовНаНачалоРасчета = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентовНаДату(ДатаНачалаРасчетаНач, ЗалоговыйБилет);
			СуммаПроцентовНачислено = ЛБ_ОбщийМодуль.ПолучитьНачисленияПроцентов(?(ЗначениеЗаполнено(ДокументОплаты), ДокументОплаты, неопределено), ЗалоговыйБилет, ДатаНачалаРасчетаНач);  
			СуммаПроцентовНачислено = СуммаПроцентовНачислено + ОстатокПроцентовНаНачалоРасчета; 
			ПроцентДляПродленияДоговора = ?(СуммаПроцентовНач = 0, 0, СуммаОплатыПроценты/СуммаПроцентовНач);
			//Если ПроцентДляПродленияДоговора >= 0.9 Тогда    
			Если СуммаОплатыПроценты >= СуммаОплатыДляПродленияДоговора Тогда
				Если ПроцентДляПродленияДоговора = 1 Тогда 
					Если СуммаПроцентовНачислено = 0 Тогда
					    СуммаПроцентовНачислено = СуммаПроцентовНачислено + СуммаПроцентовНач;
					Иначе
						ДолгПоПроцентам = СуммаПроцентовНач - НачисленоПроцентов;
					    СуммаПроцентовНачислено = СуммаПроцентовНачислено + СуммаПроцентовНач - ДолгПоПроцентам;
                    КонецЕсли;
                    Коэфф = СуммаПроцентовНачислено/СуммаПроцентовДеньРасчет;  
					
					ПродлитьДоговорДни = Цел(Коэфф) + ?(Коэфф = Цел(Коэфф), 0, 1);
				Иначе	
					СуммаПроцентовНачислено = СуммаПроцентовНачислено + НачисленоПроцентов;
					Коэфф = СуммаПроцентовНачислено/СуммаПроцентовДеньРасчет;
					ПродлитьДоговорДни = Цел(Коэфф) + ?(Коэфф = Цел(Коэфф), 0, 1);
					
					СуммаПроцентовДолг = СтрНач.СуммаПроцентовДолг - СуммаОплатыПроценты;
					Коэфф = СуммаПроцентовДолг/СуммаПроцентовДеньРасчет;  
					КорректировкаПоДолгу = Цел(Коэфф) + ?(Коэфф = Цел(Коэфф), 0, 1);  
					
					ПродлитьДоговорДни = ПродлитьДоговорДни - КорректировкаПоДолгу;
				КонецЕсли;	
          	Иначе      
				ПродлитьДоговорДни = 0;
			КонецЕсли;  
			
			Отбор = Новый структура;
			Отбор.Вставить("КлючСтроки", 3);
			Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
			СтрКон = Строки.Получить(0); 
			СтрКон.Статус = ?(ПродлитьДоговорДни = 0, СтатусЗБ, Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен); 
			Если НЕ ПродлитьДоговорДни = 0 Тогда  
				СтрКон.НомерДС = НомерДопСоглашенияНач + 1;
			ИначеЕсли (СуммаПроцентовНачислено = 0) И НЕ (СуммаОплатыСсуда = 0) Тогда
				СтрКон.НомерДС = НомерДопСоглашенияНач + 1;
			Иначе	
				СтрКон.НомерДС = НомерДопСоглашенияНач;
			КонецЕсли;	
			СтрКон.ПроцентнаяСтавка = СтрНач.ПроцентнаяСтавка; 	
			Если НЕ ПродлитьДоговорДни = 0 Тогда
				ДатаВыкупа = СтрНач.ДатаВозврата + ПродлитьДоговорДни*(60 * 60 * 24);  
				ДатаВыкупа = ?(ДатаВыкупа < ДатаНачалаРасчета, ДатаНачалаРасчета, ДатаВыкупа);
				ЛБ_УправлениеЛомбардом.ИсключитьДатаВыкупаПразничныйДень(ДатаВыкупа);
				ДатаВыкупаЛьготная = ЛБ_УправлениеЛомбардом.ПолучитьЛьготныйСрокЗалоговогоБилета(ДатаВыкупа);
			Иначе 
				ДатаВыкупа = СтрНач.ДатаВозврата;
				ДатаВыкупаЛьготная = СтрНач.ДатаВозвратаЛьготная;
			КонецЕсли;	
			СтрКон.ДатаВозврата = ДатаВыкупа;
			СтрКон.ДатаВозвратаЛьготная = ДатаВыкупаЛьготная;	
			СтрКон.СуммаЗайма = СтрНач.СуммаЗайма - СуммаОплатыСсуда;     
		    СтрКон.СуммаПроцентовДень = СтрКон.СуммаЗайма*СтрНач.ПроцентнаяСтавка/100;
			СтрКон.СуммаПроцентовДолг = СтрНач.СуммаПроцентовДолг - СуммаОплатыПроценты;  
			ВыдачаЗалога = Ложь;       
			Если НЕ ПредельныйСрокЗайма = Дата(1,1,1) И ПредельныйСрокЗайма <= СтрКон.ДатаВозврата Тогда    
				ОбщегоНазначения.СообщитьПользователю("Внимание! В результате оплаты новая расчетная дата возврата ("+Формат(СтрКон.ДатаВозврата, "ДФ=dd.MM.yyyy")+") превысит предельный срок займа ("+Формат(ПредельныйСрокЗайма, "ДФ=dd.MM.yyyy")+")"+
