&НаСервере
Функция ПроверитьПечататьДопСоглашение() 
	Отбор = Новый структура;
	Отбор.Вставить("КлючСтроки", 2);
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтрНач = Строки.Получить(0); 
	
	Отбор.Вставить("КлючСтроки", 3);
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтрКон = Строки.Получить(0);  
	
	Если НЕ СтрКон.статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен И 
		 НЕ СтрКон.статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен Тогда
        Возврат  Ложь;
	КонецЕсли;   
	
	Если НЕ СуммаОплатыПроценты = 0 Тогда 
		Если СуммаОплатыСсуда = 0 Тогда
	        Возврат НЕ (СтрНач.НомерДС = СтрКон.НомерДС); 
		Иначе
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;   
	
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
    Если ЗначениеЗаполнено(ДокументОплаты) Тогда	
		Если ДокументОплатыПроведен() Тогда  
			Если НЕ ПроверитьПечататьДопСоглашение() Тогда
				Предупреждение("Печать дополнительного соглашения не требуется", 60);
			Иначе	
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ИменаМакетов", "ДополнительноеСоглашение"); 
				ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ОперацияПоЗалогу");
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(ДокументОплаты);
				ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
				ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
			КонецЕсли;	
		Иначе  
			Предупреждение("Печать проекта документа оплаты процентов не разрешена!", 60);
		КонецЕсли;	
	Иначе     
		Предупреждение("Документ оплаты процентов не записан!", 60);
	КонецЕсли;	

КонецПроцедуры 

