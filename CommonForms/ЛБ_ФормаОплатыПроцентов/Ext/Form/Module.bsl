&НаКлиенте
Функция ОткрытыеФормыПоИмени(ИмяФормы, ВернутьПервые = 0) Экспорт

   Результат = Новый Массив; // Массив из ФормаКлиентскогоПриложения

   ОткрытыеОкна = ПолучитьОкна();
   Для Каждого ОткрытоеОкно Из ОткрытыеОкна Цикл

       Для Каждого ОткрытаяФорма Из ОткрытоеОкно.Содержимое Цикл //ФормаКлиентскогоПриложения

           Если ТипЗнч(ОткрытаяФорма) = Тип("ФормаКлиентскогоПриложения") Тогда

               Если ОткрытаяФорма.ИмяФормы = ИмяФормы Тогда

                   Результат.Добавить(ОткрытаяФорма);

                   Если ВернутьПервые > 0 И Результат.Количество() = ВернутьПервые Тогда
                       Прервать;
                   КонецЕсли;

               КонецЕсли;

           КонецЕсли;

       КонецЦикла;

   КонецЦикла;

   Возврат Результат;

КонецФункции

&НаКлиенте
Процедура Оплатить(Команда)      
	Если НеРедактировать Тогда
		Возврат;
	КонецЕсли;   

	Если НЕ ЗначениеЗаполнено(ДокументОплаты) И НачалоДня(ДатаДок) = НачалоДня(ТекущаяДата()) Тогда
	    ДатаПроверки = ТекущаяДата();		
	Иначе
		ДатаПроверки = ДатаДок;  
	КонецЕсли;	      
	СтруктураКС = ПроверитьКассовуюСмену(ДатаПроверки);
	Если СтруктураКС = неопределено И НЕ СуммаОплаты = 0 Тогда
		Предупреждение("Не открыта кассовая смена в ломбарде. Оплата процентов запрещена.", 60);
		Возврат;
	КонецЕсли;	

	Если ПроверкаКлиента() Тогда   
		Если НЕ ЗначениеЗаполнено(ДокументОплаты) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		    ДатаДок = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли;	
		
		Отбор = новый Структура;
		Отбор.Вставить("КлючСтроки", 2); 
		СтрокиС = ТаблицаСостояний.НайтиСтроки(Отбор);  
		СтатусЗБ = СтрокиС.Получить(0).Статус;
		Если СтатусЗБ = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Отгружен") Тогда 
            ЕстьНеПроведенные  = СоздатьДокументНаСервере();
			Если НЕ ЕстьНеПроведенные Тогда
				НеРедактировать = Истина;
				Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
				Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
				Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;		       
				Элементы.Оплатить.Доступность = Ложь;
			    Элементы.Отмена.Заголовок = "Закрыть"; 
				Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;
				УстановитьИнформациюВыкуп();
				УстановитьВидимость(); 
				Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
		   	        ФормаРМП = ВладелецФормы;  
					Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
		                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
					КонецЕсли;	
				КонецЕсли;
	       	КонецЕсли;		
		Иначе
			Отбор = Новый Структура;
			Отбор.Вставить("КлючСтроки", 1);       
			Строки = ТаблицаСостояний.НайтиСтроки(Отбор);   
			Если НЕ Строки.Количество() = 0 Тогда  
				ДатаПЗС = Строки.Получить(0).ПредельныйСрокЗайма; 
			КонецЕсли;	
			
			БудетДостигнутПредельныйСрокЗайма = Ложь;
			Отбор.Вставить("КлючСтроки", 3);       
			Строки = ТаблицаСостояний.НайтиСтроки(Отбор);   
			Если НЕ Строки.Количество() = 0 Тогда  
				ДатаВозвратаРасчет = Строки.Получить(0).ДатаВозврата;
				Если ДатаВозвратаРасчет >= ДатаПЗС Тогда   
					БудетДостигнутПредельныйСрокЗайма = Истина;
					СпособОплаты = 4;      
					ПолныйВыкуп();
				КонецЕсли;	
			КонецЕсли;	
			
			СтруктураВ = ПроверитьЕстьВНакладной();
			Если СтруктураВ = неопределено Тогда
				ЕстьВНакладной = Ложь;
			Иначе
				ЕстьВНакладной = Истина;
				НакладнаяНаОтгрузку = СтруктураВ.НакладнаяНаОтгрузку; 
				СтатусНакладной = СтруктураВ.СтатусНакладной;
			КонецЕсли;  
			
			Если ЕстьВНакладной Тогда   
				СтруктураН = ПолучитьРеквизитыНакладной(НакладнаяНаОтгрузку); 
			    ТекстПредупреждения = "Предметы залога по ЗБ № " + СокрЛП(ПолучитьНомерЗБ()) + " в накладной № " + СокрЛП(СтруктураН.Номер)+ " от " + Формат(СтруктураН.Дата, "ДЛФ=DT");
			    Если СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена") Тогда
				    ТекстПредупреждения = ТекстПредупреждения + " уже отгружены.";   			
					ТекстПредупреждения = ТекстПредупреждения + " Для согласования возможности приема оплаты/выкупа обратитесь в ЦО.";
					Предупреждение(ТекстПредупреждения, 60);
					Возврат;
			    ИначеЕсли СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаОткрыта") ИЛИ  
					      СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаЗакрыта") Тогда  
				   ТекстПредупреждения = ТекстПредупреждения + " в сумке.";	
				   
				   СтруктураВ = ПолучитьЛомбардЗБ();
				   Если НЕ Ломбард = СтруктураВ.Ломбард Тогда
				        ТекстПредупреждения = "Внимание! Изделия по ЗБ № " + СокрЛП(ПолучитьНомерЗБ()) + " в сумке! Для проведения оплаты свяжитесь с ломбардом № " + СокрЛП(СтруктураВ.Номер) + "." ;
				   Иначе	   
					   Если Выкуп Тогда
					       ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + "Для выкупа или переоформления ЗБ измените статус накладной и вскройте сумку."; 
					   Иначе 
						   ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + "Для оплаты ЗБ измените статус накладной и вскройте сумку."; 
					   КонецЕсли;	
				   КонецЕсли;	   
			   	   Предупреждение(ТекстПредупреждения, 60);  
				   Возврат; 
			    КонецЕсли;	   
			КонецЕсли;		  

			
			ВозможноПереоформление = ПроверитьВозможноПереоформление();		
			Если Выкуп И НЕ ВозможноПереоформление Тогда 
				Если ЕстьВНакладной Тогда
				    Предупреждение("Внимание! В результате выкупа предметы залога будут исключены из накладной!", 60); 
				КонецЕсли;	
				ЕстьНеПроведенные  = СоздатьДокументНаСервере();
				Если НЕ ЕстьНеПроведенные Тогда
					НеРедактировать = Истина;
					Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
					Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
					Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
			        Элементы.Редактировать.Видимость = Истина; 
					Элементы.Оплатить.Доступность = Ложь;
				    Элементы.Отмена.Заголовок = "Закрыть"; 
					Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;
					УстановитьИнформациюВыкуп();
	                //+Мельников 25.04.24 Отмена операции
					УстановитьВидимость();
					//-Мельников      
					Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
			   	        ФормаРМП = ВладелецФормы;  
						Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
			                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
						КонецЕсли;	
					КонецЕсли;
		       	КонецЕсли;		
			ИначеЕсли Выкуп ИЛИ ДостигнутПредельныйСрокЗайма ИЛИ БудетДостигнутПредельныйСрокЗайма Тогда
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
				ПараметрыФормы.Вставить("Ломбард", Ломбард);
				ПараметрыФормы.Вставить("Плательщик", Плательщик);
				ПараметрыФормы.Вставить("ДоверенностьПлательщика", ДоверенностьПлательщика); 
				ПараметрыФормы.Вставить("ДатаДок", ДатаДок);  
				ПараметрыФормы.Вставить("Выкуп", ?(ДостигнутПредельныйСрокЗайма, Истина, Выкуп));
				ПараметрыФормы.Вставить("СуммаОплаты", СуммаОплаты); 
				ПараметрыФормы.Вставить("СуммаПроценты", СуммаОплатыПроценты);
				ПараметрыФормы.Вставить("СуммаЗайм", СуммаОплатыСсуда); 
				ПараметрыФормы.Вставить("ФИОПлательщика", ФИО); 
				ПараметрыФормы.Вставить("Доверенность", Доверенность);  
				ПараметрыФормы.Вставить("СписокНельзяВыкупить", ЗаполнитьСписокТоваровНеВЛомбарде());
				ПараметрыФормы.Вставить("ДатаПЗС", ДатаПЗС);  
				ПараметрыФормы.Вставить("ДатаВозврата", ДатаВозвратаРасчет);  
				ПараметрыФормы.Вставить("ЕстьВНакладной", ЕстьВНакладной);
				
				//+МАН 29.11.24 Дополнение для вывода сообщения при экспресе и накладной в факте. Заявка 2904.
				Если ЕстьВНакладной Тогда
					ПараметрыФормы.Вставить("СтатусНакладной", СтатусНакладной);
				КонецЕсли;
				//-МАН
				
				Отбор.Вставить("КлючСтроки", 2);       
				Строки = ТаблицаСостояний.НайтиСтроки(Отбор);   
				Если НЕ Строки.Количество() = 0 Тогда  
					ПараметрыФормы.Вставить("СтатусЗБ", Строки.Получить(0).Статус); 
				КонецЕсли;	
				
				ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораОплатаПереоформить", ЭтотОбъект);
				ОткрытьФорму("ОбщаяФорма.ЛБ_ОплатаПереоформить", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе          
				Если ЕстьВНакладной И НЕ ПолучитьБезПродленияДоговора() Тогда
					Если ОплатаМеньше90Процентов() Тогда
						Режим = РежимДиалогаВопрос.ДаНет;
					    ТекстВопроса = "Внимание! Сумма оплаты менее 90% от суммы начисленных процентов. Предметы залога не будут исключены из накладной!"; 
					    Ответ = Вопрос(ТекстВопроса + Символы.ПС + "Продолжить выполнение операции?", Режим, 0);
					    Если Ответ = КодВозвратаДиалога.Нет Тогда
						    Возврат;
					    КонецЕсли;  
					Иначе   
						Предупреждение("Внимание! В результате оплаты предметы залога будут исключены из накладной!", 60);
					КонецЕсли;
				КонецЕсли;
				
				//+МАН 29.11.24 Дополнение для вывода сообщения при экспресе и накладной в факте. Заявка 2904.
				Если ЕстьВНакладной И ПолучитьБезПродленияДоговора() Тогда
					
						ПродлениеСК = ПолучитьСхемуКредитования(ЗалоговыйБилет);
						
						Предупреждение("Внимание! Вид займа " + ПродлениеСК.НаименованиеСК
						+ ", продление срока займа не предусмотрено. Предметы залога не будут исключены из накладной!");
				КонецЕсли;
				//-МАН
				
				ЕстьНеПроведенные  = СоздатьДокументНаСервере();
				Если НЕ ЕстьНеПроведенные Тогда
					НеРедактировать = Истина;
					Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
					Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
					Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
			        Элементы.Редактировать.Видимость = Истина; 
					Элементы.Оплатить.Доступность = Ложь;
				    Элементы.Отмена.Заголовок = "Закрыть"; 
					Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;  			
					//+Мельников 25.04.24 Отмена операции
					УстановитьВидимость();
					//-Мельников    
					Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
			   	        ФормаРМП = ВладелецФормы;  
						Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
			                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
						КонецЕсли;	
					КонецЕсли;
		       	КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Функция ПолучитьОсновнойДокументПереоформление(Клиент) 
	Если Клиент = Плательщик Тогда
		Возврат ДокументПлательщика;
	КонецЕсли;
	
	Гражданство = Справочники.СтраныМира.Россия;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса()); 
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Гражданство = Выборка.Гражданство;
	КонецЕсли;	
	Возврат ЛБ_УправлениеЛомбардом.ПроверитьОсновнойДокумент(ДатаДок, Клиент, Гражданство);
КонецФункции

//+Мельников 05.07.24 Проверка на банкрота
&НаСервере
Функция ПроверитьСтатусБанкрот(ЗБ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется
		|ИЗ
		|	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(
		|			&Дата,
		|			Залогодатель = &Залогодатель
		|				И Статус.Несостоятельный = ИСТИНА) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Залогодатель", ЗБ.Залогодатель);
	//Запрос.УстановитьПараметр("Статус", Справочники.ЛБ_СлужебныеСтатусыКлиентов.НайтиПоКоду("000000003"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Используется;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
//-Мельников

//+МАН 29.11.24 Дополнение для вывода сообщения при экспресе и накладной в факте. Заявка 2904.
&НаСервереБезКонтекста
Функция ПолучитьСхемуКредитования(ЗалоговыйБилет)

	Результат = Новый Структура;
	Результат.Вставить("БезПродленияДоговора", ЗалоговыйБилет.СхемаКредитования.БезПродленияДоговора);
	Результат.Вставить("НаименованиеСК", ЗалоговыйБилет.СхемаКредитования.НаименованиеДляПечати);
	
	Возврат Результат;

КонецФункции
//-МАН

&НаКлиенте
Процедура ПослеВыбораОплатаПереоформить(Результат, ДопПараметры) Экспорт
    Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
        Возврат;
	КонецЕсли; 

	//+Мельников 05.07.24 Проверка на банкрота
	Банкрот = ПроверитьСтатусБанкрот(ЗалоговыйБилет);
	//-Мельников    
	
	Если Результат.Операция = 1 Тогда 
		Если Результат.ЕстьВНакладной Тогда
		    Предупреждение("Внимание! В результате оплаты предметы залога будут исключены из накладной!", 60); 
		КонецЕсли;   
		ЕстьНеПроведенные  = СоздатьДокументНаСервере();
		Если НЕ ЕстьНеПроведенные Тогда
			НеРедактировать = Истина;
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
	        Элементы.Редактировать.Видимость = Истина; 
			Элементы.Оплатить.Доступность = Ложь;
		    Элементы.Отмена.Заголовок = "Закрыть"; 
			Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;  	
			УстановитьИнформациюВыкуп();  
			Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
			      ФормаРМП = ВладелецФормы;  
				Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
			        ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		//+Мельников 05.07.24 Банкрот
		Если Банкрот Тогда
			//+МАН 06.04.26 Изменил сообщение. Заявка 3759
			ТекстСообщения = "Клиенту " + Строка(ПолучитьЗалогодателя()) + " присвоен служебный статус ""Банкрот"", в связи с чем выдача залога клиенту/доверенному лицу запрещена!";
			//Было:
			//Предупреждение("Полная оплата займа клиента – банкрота.
			//				|Выдача залога клиенту/доверенному лицу запрещена!");
			//Сообщить("Полная оплата займа клиента – банкрота.
			//				|Выдача залога клиенту/доверенному лицу запрещена!", СтатусСообщения.ОченьВажное);
			Предупреждение(ТекстСообщения);
			Сообщить(ТекстСообщения, СтатусСообщения.ОченьВажное);
			//-МАН
		КонецЕсли;
		//-Мельников
	ИначеЕсли Результат.Операция = 2 Тогда   
		Если Результат.ЕстьВНакладной Тогда
		    Предупреждение("Внимание! В результате выкупа/переоформления предметы залога будут исключены из накладной!", 60);  
		КонецЕсли;	
	
		ПараметрыФормы = Новый Структура;      
		ПараметрыФормы.Вставить("Дата", ДатаДок); 
		ПараметрыФормы.Вставить("ПредыдущаяОперация", ЗалоговыйБилет);  
			
		Если Результат.СпособПереоформления = 0 Тогда  //на заемщика  
			Залогодатель = ПолучитьЗалогодателя();
			ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
			ПараметрыФормы.Вставить("ДокументЗалогодателя", ПолучитьОсновнойДокументПереоформление(Залогодатель)); 
			Если НЕ Плательщик = Залогодатель Тогда  
				ПараметрыФормы.Вставить("Представитель", Плательщик);
				ПараметрыФормы.Вставить("ДокументПредставителя", ДокументПлательщика); 
				ПараметрыФормы.Вставить("ДоверенностьПредставителя", ДоверенностьПлательщика);
			КонецЕсли;	  
		Иначе //на доверенное лицо
			ПараметрыФормы.Вставить("Залогодатель", Плательщик);
			ПараметрыФормы.Вставить("ДокументЗалогодателя", ДокументПлательщика); 
			ПараметрыФормы.Вставить("ДоверенностьПредставителя", ДоверенностьПлательщика);
		КонецЕсли;
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеСозданияПереоформления", ЭтотОбъект); 
		Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
		    ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма.ВладелецФормы, Истина,,,ОписаниеОповещения); 
		Иначе 
			ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);
		КонецЕсли;	
	КонецЕсли;	
	//+Мельников 20.06.24 Установка видимости т.к. кнопка "отмена" не активна
	УстановитьВидимость();
	//-Мельников
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияПереоформления(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Открыта() Тогда
	    ЭтаФорма.Закрыть();  
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ПроверитьКлиентаПоПеречням() 
	РезультатПроверки = Истина;
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Плательщик);  
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК СтатусКлиентаВПеречне,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И ВидПеречня = &ВидПеречня) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ"; 

	СписокПеречней = Новый СписокЗначений;
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);  
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	Для каждого Эл из СписокПеречней Цикл 
		Запрос.УстановитьПараметр("ВидПеречня", Эл.Значение);
	
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда  
			Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
				Продолжить;
			КонецЕсли;	
			Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
				ОбщегоНазначения.СообщитьПользователю("Клиент " + СокрЛП(ФИО) + " найден в перечне террористов. Операции с клиентом запрещены!");  
				РезультатПроверки = Ложь;
			ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
				ОбщегоНазначения.СообщитьПользователю("Клиент " + СокрЛП(ФИО) + " найден в перечне ФРОМУ. Операции с клиентом запрещены!");  
				РезультатПроверки = Ложь;
		    ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
				ОбщегоНазначения.СообщитьПользователю("Клиент " + СокрЛП(ФИО) + " найден в списке МВК. Операции с клиентом запрещены!");  
				РезультатПроверки = Ложь;
			ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
				ОбщегоНазначения.СообщитьПользователю("Клиент " + СокрЛП(ФИО) + " найден в перечне ООН. Операции с клиентом запрещены!");  
				РезультатПроверки = Ложь;		
			КонецЕсли;
		КонецЕсли;	
	Конеццикла;     
	
	Если РезультатПроверки И НЕ Плательщик = ЗалоговыйБилет.Залогодатель Тогда
		//проверим владельца залогового билета
		Запрос.УстановитьПараметр("Залогодатель", ЗалоговыйБилет.Залогодатель);  
		
		Для каждого Эл из СписокПеречней Цикл 
			Запрос.УстановитьПараметр("ВидПеречня", Эл.Значение);
		
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда   
				Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен Тогда
					Продолжить;
				КонецЕсли;	
				Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
					ОбщегоНазначения.СообщитьПользователю("Заемщик найден в перечне террористов. Операции с клиентом запрещены!");  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
					ОбщегоНазначения.СообщитьПользователю("Заемщик найден в перечне ФРОМУ. Операции с клиентом запрещены!");  
					РезультатПроверки = Ложь;
		        ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
					ОбщегоНазначения.СообщитьПользователю("Заемщик найден в списке МВК. Операции с клиентом запрещены!");  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
					ОбщегоНазначения.СообщитьПользователю("Заемщик найден в перечне ООН. Операции с клиентом запрещены!");  
					РезультатПроверки = Ложь;		
				КонецЕсли;
			КонецЕсли;	
		Конеццикла;  
	КонецЕсли;	

	Возврат РезультатПроверки;
КонецФункции	

