&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
        ДокументОплаты = Параметры.Документ; 
		Если ДокументОплаты.Проведен тогда
			НеРедактировать = Истина;
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		Иначе
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		КонецЕсли;	
		ДатаДок = ДокументОплаты.Дата; 
		Ломбард = ДокументОплаты.Ломбард;  
		ОтветственныйПользователь = ДокументОплаты.ОтветственныйПользователь; 
		ОтветственныйСотрудник = ДокументОплаты.ОтветственныйСотрудник; 
		Комментарий = ДокументОплаты.Комментарий;
		ЗалоговыйБилет = ДокументОплаты.ПредыдущаяОперация; 
		ПСК_LX = СокрЛП(Формат(ЗалоговыйБилет.ПСК_LX, "ЧЦ=10; ЧДЦ=3; ЧН=0,00"));
		Плательщик = ДокументОплаты.Залогодатель; 
		ПричинаПримененияПроцентнойСхемы = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(ДокументОплаты, ЗалоговыйБилет); 
		ЗаполнитьТовары();
		Если НЕ ДокументОплаты.БезналичнаяОплата Тогда
			ЗаполнитьКонтакнуюИнформацию();
			ДокументПлательщика = ДокументОплаты.ДокументЗалогодателя;
			ЗаполнитьИнформациюОДокументе();		
			ДопДокументы.Загрузить(ДокументОплаты.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
			Если НЕ Плательщик = ЗалоговыйБилет.Залогодатель Тогда 
				Элементы.ГруппаДоверенность.Видимость = Истина; 
				ЗаполнитьСписокВыбораДоверенностейПлательщика();
				ДоверенностьПлательщика = ДокументОплаты.ДоверенностьПредставителя;
				ЗаполнитьТекстДоверенности();
			КонецЕсли;	
			ПроверитьОХПоПлательщику();
		КонецЕсли;	
		Выкуп = ДокументОплаты.Выкуп; 
		ВыдачаЗалога = ДокументОплаты.ВыдачаЗалога;
		СпособОплаты = 1; 
		СуммаОплаты = ДокументОплаты.СуммаОплаты;
		СуммаОплатыПроценты = ДокументОплаты.СуммаОплатыПроценты;
		СуммаОплатыСсуда = ДокументОплаты.СуммаОплатыСсуда; 		
		НакладнаяНаОтгрузку = ЛБ_УправлениеЛомбардом.ПолучитьНакладнуюНаОтгрузкуЗалогоговогоБилета(ДатаДок-1, ЗалоговыйБилет);
		БезналичнаяОплата = ДокументОплаты.БезналичнаяОплата; 
		Если БезналичнаяОплата Тогда
			РеестрПлатежей = ДокументОплаты.РеестрПлатежей; 
			СуммаПлатежа = ДокументОплаты.СуммаПлатежа;
			ДатаПлатежа = ДокументОплаты.ДатаПлатежа;
			ИдентификаторПлатежа = ДокументОплаты.ИдентификаторПлатежа;
			РаспределениеПереплаты = ДокументОплаты.РаспределениеПереплаты; 
			Если Выкуп Тогда 
				ОХ = Истина;
			КонецЕсли;	
		КонецЕсли;	
		ЗаполнитьСостояниеЗалоговогоБилета(); 
		ЗаполнитьСтрокуСостоянияПослеОплаты(Выкуп);	 
		//ЗаполнитьТовары(); 
				
		ИнформацияОплата(); 	
		//+Мельников 25.04.24 Отмена операции.
		ДокументОтмены = ПолучитьДокументОтмены(ДокументОплаты); //Было: ДокументОплаты.ДокументОтмены;
		//-Мельников     
		Если Параметры.ТолькоПросмотр = Истина Тогда	
			Этаформа.ТолькоПросмотр = Истина;
		КонецЕсли;
	ИначеЕсли Параметры.Свойство("ЗалоговыйБилет") Тогда
		ЗалоговыйБилет = Параметры.ЗалоговыйБилет; 
		Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя(); 
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		//Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		//  	ОтветственныйПользователь = ТекПользователь;
		//Иначе
		//	ОтветственныйПользователь = ПараметрыСеанса.ТекущийСотрудник;
		//КонецЕсли;	
		ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь; 
		ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;

		
		ДатаДок = ТекущаяДата();
		ПричинаПримененияПроцентнойСхемы = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(, ЗалоговыйБилет, ДатаДок);
		ЗаполнитьТовары();
		СтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ТекущаяДата(), ЗалоговыйБилет);
		//Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен ИЛИ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен Тогда
			Если Параметры.Свойство("Плательщик") Тогда
				Плательщик = Параметры.Плательщик;  
				Если Параметры.Свойство("ДокументПлательщика") Тогда 
					ДокументПлательщика = Параметры.ДокументПлательщика;
					Если ЗначениеЗаполнено(ДокументПлательщика) Тогда 
						ЗаполнитьИнформациюОДокументе();
					КонецЕсли;	
				КонецЕсли;	
            Иначе
			    Плательщик = ЗалоговыйБилет.Залогодатель;
				ДокументПлательщика = ЗалоговыйБилет.ДокументЗалогодателя;
			    ЗаполнитьИнформациюОДокументе(); 
			КонецЕсли;	
			ЗаполнитьКонтакнуюИнформацию();
			Если НЕ Плательщик = ЗалоговыйБилет.Залогодатель Тогда 
				Элементы.ГруппаДоверенность.Видимость = Истина; 
				ЗаполнитьСписокВыбораДоверенностейПлательщика();
				Если Параметры.Свойство("Доверенность") Тогда
					Для Сч = 0 По Элементы.Доверенность.СписокВыбора.Количество()-1 Цикл 
						Если Элементы.Доверенность.СписокВыбора.Получить(сч).Значение = Параметры.Доверенность Тогда
						    ДоверенностьПлательщика = Элементы.Доверенность.СписокВыбора.Получить(сч).Значение;
						    ЗаполнитьТекстДоверенности();
							Прервать;
						КонецЕсли;	
					КонецЦикла;  
				КонецЕсли;
			КонецЕсли;	    
			ЗаполнитьДопДокументы();
			НакладнаяНаОтгрузку = ЛБ_УправлениеЛомбардом.ПолучитьНакладнуюНаОтгрузкуЗалогоговогоБилета(ДатаДок, ЗалоговыйБилет);
			ЗаполнитьСостояниеЗалоговогоБилета();  
			ПроверитьОХПоПлательщику();
       		//ЗаполнитьТовары();  			
			СпособОплаты = 1; 			
		//Иначе 
		//	Сообщить("Статус выбранного залогового билета " + ?(СтатусЗБ = неопределено, "не определен", строка(СтатусЗБ)) + ". Оплата процентов невозможна!");//lion 
		//    Отказ = Истина;
		//КонецЕсли;	
	Иначе 
		Сообщить("Не выбран залоговый билет!"); 
		Отказ = Истина;
	КонецЕсли;     
	//ПроверитьПредельныйСрокЗайма();
	//УстановитьВидимость();
КонецПроцедуры  

&НаСервере
Функция ПолучитьСлужебныеСтатусыКлиента(Клиент)
	Возврат ЛБ_ОбщийМодуль.ПолучитьСлужебныеСтатусыКлиента(ДатаДок, Клиент);
КонецФункции	

&НаСервере
Функция ПроверитьСлужебныйСтатус(Статус)  
	Возврат ЛБ_ОбщийМодуль.ПроверитьСлужебныйСтатус(Статус, Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов);
КонецФункции
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СписокСС = ПолучитьСлужебныеСтатусыКлиента(ЭтаФорма.Плательщик);
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение);
			Если СтруктураВозврата.Запрет Тогда 
				ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов");
				//+МАН 03.04.26 Изменено сообщение. Заявка 3759
				//Предупреждение("Для клиента " + СокрЛП(Плательщик) + " определен запрет на операцию " + Строка(ВидОперации), 60, "Проверка служебных статусов клиента");
				Предупреждение("Клиенту " + СокрЛП(Плательщик) + " присвоен служебный статус """ + Строка(Элемент.Значение) + """, в связи с чем запрещена операция: """ + Строка(ВидОперации) + """", 60, "Проверка служебных статусов клиента");
				//-МАН
				Отказ = Истина;
				Возврат;  
			Иначе
				ПредупреждениеП = СтруктураВозврата.Предупредить;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
				Отказ = Истина;
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;   

	Если НеРедактировать Тогда  
		Элементы.Редактировать.Видимость = ?(Этаформа.ТолькоПросмотр, Ложь, Истина);  
		Элементы.Оплатить.Доступность = ложь;
		Элементы.Отмена.Заголовок = "Закрыть";
	КонецЕсли;
	Элементы.ОсновнаяПанель.ТолькоПросмотр = ?(БезналичнаяОплата, Истина, НеРедактировать);
	ПриСменеСтраницы(Элементы.ОсновнаяПанель.ТекущаяСтраница);  
	
	Если НЕ ДопДокументы.Количество() = 0 Тогда
		Элементы.ГруппаДопДокумент.Показать(); 
	КонецЕсли;	
	
	Отбор = новый Структура;
	Отбор.Вставить("КлючСтроки", 2); 
	СтрокиС = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтрС = СтрокиС.Получить(0);
	СтатусЗБ = СтрС.Статус;
	Если СтатусЗБ = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Отгружен") Тогда  
		СпособОплаты = 4;                             
		Если (СтрС.СуммаПроцентовДолг + СтрС.СуммаЗайма) = 0 Тогда
			Элементы.ДекорацияОплаченПолностью.Видимость = Истина; 
			Элементы.ДекорацияОплаченПолностью.Заголовок = "Задолженность по договору займа полностью погашена в результате поступления денежных средств от реализации предмета (-ов) залога." +
			    Символы.ПС + "Залоговый билет необходимо перевести в статус «ОХ (готов к отправке)». Нажмите кнопку «Принять оплату»";
		КонецЕсли;	
		Элементы.СуммаОплаты.ТолькоПросмотр = Истина; 
		Если ЗначениеЗаполнено(ДокументОплаты) Тогда 
			Элементы.Редактировать.Видимость = ложь;
		Иначе	
		    ПолныйВыкуп();
		КонецЕсли;	
	Иначе	
		ЗаполнитьСостояниеТоваровПерезалог();
		ПроверитьПредельныйСрокЗайма();
		УстановитьВидимость();	
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Плательщик) И НЕ ЗначениеЗаполнено(ДокументОплаты) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Плательщик);	
			
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеПроверкиАктуальности",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПроверкаАктуальностиДанныхКлиента", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;   

КонецПроцедуры  

&НаКлиенте
Процедура ПослеПроверкиАктуальности(Результат, ДопПараметры) Экспорт
	Если Результат = Ложь тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Плательщик);
		ПараметрыФормы.Вставить("Дата", ДатаДок);	 
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеИзмененияКарточки",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ПриПовторномОткрытии()  
	ЭтаФорма.ТолькоПросмотр = НеРедактировать; 
	Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
	Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
	Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
	Элементы.Редактировать.Видимость = Ложь;  
	Элементы.Оплатить.Доступность = Истина;
	Элементы.Отмена.Заголовок = "Отмена";    
	Если Выкуп Тогда 
		ЗаполнитьТоварыПослеВыкупа(Ложь);
		ИнформацияОплата(); 		
	КонецЕсли;	
КонецПроцедуры    

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ЭтаФорма.Закрыть(?(ЗначениеЗаполнено(ДокументОплаты), ДокументОплаты, неопределено));
КонецПроцедуры

&НаСервере
Функция ПроверитьИзделияИзъяты()
	ВсеИзделияИзъяты = Истина;
	Для каждого стр Из ТаблицаТоваров Цикл
		Если НЕ Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят Тогда 
			ВсеИзделияИзъяты = Ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Возврат ВсеИзделияИзъяты; 
КонецФункции

&НаСервере
Процедура ПроверитьОХПоПлательщику()
	Если Плательщик = ЗалоговыйБилет.Залогодатель Тогда
		ОХ = Ложь
	ИначеЕсли ЗначениеЗаполнено(ДоверенностьПлательщика) Тогда
		ОХ = ложь;   
	ИначеЕсли ПроверитьИзделияИзъяты() Тогда
		ОХ = ложь;	
	Иначе                                                              
		ОХ = Истина;
	КонецЕсли;
КонецПроцедуры	
	
&НаСервере
Процедура УстановитьВидимость()
	Если Гражданство = Справочники.СтраныМира.Россия Тогда 
		Элементы.ГруппаДопДокумент.Видимость = Ложь;
	Иначе 
		Элементы.ГруппаДопДокумент.Видимость = Истина;
	КонецЕсли;	
	//+Мельников 25.04.24 Отмена операции
	ПроверкаПоследующихОпереаций = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, ТекущаяДата(),,Истина);
	ЛомбардПользователя = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);

	Если ДокументОплаты.Проведен И НЕ ТекущаяДата() - ДатаДок >= 3600 И ЛомбардПользователя = ДокументОплаты.Ломбард И
		?(ЗначениеЗаполнено(ДокументОплаты), ?(ПроверкаПоследующихОпереаций = Неопределено, Истина, ?(ПроверкаПоследующихОпереаций.Регистратор = ДокументОплаты, Истина, Ложь)), Ложь) Тогда

		Элементы.ОтменитьОперацию.Доступность = Истина;
	Иначе
		Элементы.ОтменитьОперацию.Доступность = Ложь;
	КонецЕсли;

	//+МАН 17.06.25 Изменил
	//Если ЗначениеЗаполнено(ДокументОплаты.ДокументОтмены) Тогда
	Если ЗначениеЗаполнено(ДокументОтмены) Тогда
	//-МАН
		Элементы.ГруппаОтмена.Видимость = Истина;
		//+Мельников 28.05.24
		Элементы.Расчеты.Доступность = Ложь;
		Элементы.Редактировать.Доступность = Ложь;
		//-Мельников
	КонецЕсли;
	//-Мельников  
	Если БезналичнаяОплата Тогда 
		Элементы.ГруппаПлательщик.Видимость = Ложь; 
		Элементы.ГруппаДопДокумент.Видимость = Ложь;
		Элементы.Редактировать.Видимость = Ложь;
		Элементы.ГруппаБезНал.Видимость = Истина; 
		ИнформацияРеестр = "";    
		Если РаспределениеПереплаты Тогда
			ИнформацияРеестр = ИнформацияРеестр + "Уточнение переплаты: ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(РеестрПлатежей) Тогда
			ИнформацияРеестр = ИнформацияРеестр + "Реестр платежей № " + СокрЛП(РеестрПлатежей.НомерРеестра);
			ВидПлатежа = ?(РеестрПлатежей.ВидОперации = Перечисления.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет, " п/п ", " идентификатор ");   
		Иначе
			ВидПлатежа = " идентификатор ";
		КонецЕсли;	 
		Если ЗначениеЗаполнено(ИдентификаторПлатежа) Тогда
			ИнформацияРеестр = ИнформацияРеестр + ВидПлатежа + СокрЛП(ИдентификаторПлатежа);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДатаПлатежа) Тогда
			ИнформацияРеестр = ИнформацияРеестр + " от " + Формат(ДатаПлатежа, "ДЛФ=DT");
		КонецЕсли;	        
		Если НЕ СуммаПлатежа = 0 Тогда
			ИнформацияРеестр = ИнформацияРеестр + " сумма платежа " + СокрЛП(Формат(СуммаПлатежа, "ЧЦ=15; ЧДЦ=2")) + " руб."; 
			Если НЕ СуммаОплаты = СуммаПлатежа Тогда  
				ИнформацияРеестр = ИнформацияРеестр + " переплата " + СокрЛП(Формат(СуммаПлатежа-СуммаОплаты, "ЧЦ=15; ЧДЦ=2")) + " руб.";
			КонецЕсли;	
		КонецЕсли;	
		Элементы.ДекорацияРеестр.Заголовок = ИнформацияРеестр;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция СоздатьНовуюОплатуПроцентов()
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет; 
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	//ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ДокументОплаты), ДатаДок-1, ДатаДок);
	ДокументОбъект.Дата = ДатаДок; 
	ДокументОбъект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	ДокументОбъект.ПроцентнаяСхема = ЗалоговыйБилет.ПроцентнаяСхема;  
	ДокументОбъект.Выкуп = Выкуп;
	Возврат ДокументОбъект; 
КонецФункции

&НаСервере
Процедура ЗаполнитьДопДокументы()  
	Если НЕ ЗначениеЗаполнено(Гражданство) Или Гражданство = Справочники.СтраныМира.Россия тогда 
		ДопДокументы.Очистить();
	Иначе	
		ДопДокументы.Загрузить(ЛБ_УправлениеЛомбардом.ПолучитьДокументыПравоПребыванияРФ(ДатаДок, Плательщик, Гражданство));
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТоварыПослеВыкупа(ВыводитьСообщение = Истина) 
	Отбор = новый Структура;
	Отбор.Вставить("КлючСтроки", 2); 
	СтрокиС = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтатусЗБ = СтрокиС.Получить(0).Статус;
	
	Запрос = новый Запрос;   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
    Запрос.УстановитьПараметр("Дата", ДатаДок);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	Для каждого стр Из ТаблицаТоваров цикл  
		Если Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен тогда
			Стр.ПроверкаВернутьЗалог = Ложь;
			Стр.ВернутьЗалог = Ложь; 
			Продолжить;
		КонецЕсли;
		
		//+Мельников 05.07.24 Банкрот
		Банкрот = ПроверитьСтатусБанкрот(ЗалоговыйБилет);
		//-Мельников
		
		Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен Тогда 
			Стр.ПроверкаВернутьЗалог = ложь;
			Стр.ПроверкаВернутьЗалог = ложь;  
			Если НЕ Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Реализован Тогда
			    Стр.СтатусПослеОплаты = Перечисления.ЛБ_СтатусыОбъектовЗалога.ГотовКОтправкеОХ;
			КонецЕсли;	
		Иначе
			Отбор = Новый структура;
			Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
			Отбор.Вставить("Ломбард", Ломбард);
			Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 тогда  
				Если Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят Тогда 
					Стр.ПроверкаВернутьЗалог = Ложь;
					Стр.ВернутьЗалог = Ложь;    
					Стр.СтатусПослеОплаты = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят;
				ИначеЕсли ОХ = Истина тогда 
					Стр.ПроверкаВернутьЗалог = Ложь;
					Стр.ВернутьЗалог = Ложь;
					Стр.СтатусПослеОплаты = ?(Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Наследство, Перечисления.ЛБ_СтатусыОбъектовЗалога.Наследство, Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение);
	            //+Мельников 05.07.24 Банкрот
				ИначеЕсли Банкрот Тогда
					Стр.ПроверкаВернутьЗалог = Ложь;
					Стр.ВернутьЗалог = Ложь;    
					Стр.СтатусПослеОплаты = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение;
				//-Мельников
				Иначе	
					Стр.ПроверкаВернутьЗалог = Истина;
					Стр.ВернутьЗалог = Истина;
					Стр.СтатусПослеОплаты = Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен;
				КонецЕсли;	
			Иначе             
				Если НЕ ОХ И ВыводитьСообщение Тогда
					Отбор.Удалить("Ломбард");
					Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
					Если НЕ Строки.Количество() = 0 тогда 
						Сообщить("Объект залога " + сокрЛП(стр.ОбъектЗалога) + " находится в " + СокрЛП(Строки.Получить(0).Ломбард));
					ИначеЕсли НЕ Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят Тогда	
					    Сообщить("Местонахождение объекта залога " + сокрЛП(стр.ОбъектЗалога) + " не определено", СтатусСообщения.Важное); 	
					КонецЕсли; 
				КонецЕсли;	
				Стр.ПроверкаВернутьЗалог = ложь;
				Стр.ПроверкаВернутьЗалог = ложь;  
				Стр.СтатусПослеОплаты = ?(Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят ИЛИ Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Наследство, Стр.СтатусОбъекта, Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение);
			КонецЕсли;
		КонецЕсли;	
	Конеццикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТовары() 
	Запрос = новый Запрос;   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Если ЗначениеЗаполнено(ДокументОплаты) И ДокументОплаты.Проведен Тогда 
		ДатаПроверки = ДатаДок-1; 
	Иначе	
	    ДатаПроверки = ДатаДок;
	КонецЕсли;	   
	Запрос.УстановитьПараметр("Дата", ДатаПроверки);

	//+Мельников 25.04.24 Закомментировал
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
	               |	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаРасход) КАК СуммаОплаты
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.Обороты(, &Дата, , ) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ЗалоговыйБилет = &ЗалоговыйБилет
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога";
	
	//+Мельников 25.04.24 Отмена операции. Убрал старый запрос т.к. он не учитывал суммы по отмененным операциям.
	//Запрос.Текст = "ВЫБРАТЬ
	//				|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
	//				|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаОборот КАК СуммаОборот,
	//				|	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаРасход) КАК СуммаОплаты
	//				|ИЗ
	//				|	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.Обороты(, &Дата, , ) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты
	//				|ГДЕ
	//				|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ЗалоговыйБилет = &ЗалоговыйБилет
	//				|
	//				|СГРУППИРОВАТЬ ПО
	//				|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога,
	//				|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаОборот,
	//				|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаРасход";
	//-Мельников
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	ТаблицаТоваров.Очистить();  
	Ном = 0;
	Для каждого стр Из ЗалоговыйБилет.Товары цикл  
		Если ЗалоговыйБилет.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда 
			Если НЕ Стр.Переоформить тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	      
		Ном = Ном + 1;
		НоваяСтр = ТаблицаТоваров.Добавить(); 
		НоваяСтр.Номерстроки = Стр.Номерстроки;
		НоваяСтр.Артикул = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет, Ном);
		НоваяСтр.ОбъектЗалога = стр.ОбъектЗалога;
		НоваяСтр.СтатусОбъекта = ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(ДатаПроверки, НоваяСтр.ОбъектЗалога, ЗалоговыйБилет);  
		//Если ЗначениеЗаполнено(НакладнаяНаОтгрузку) Тогда 
		//	Отбор = Новый структура;
		//	Отбор.Вставить("КлючСтроки", 2);
		//	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
		//	СтрНач = Строки.Получить(0);  
		//	СуммаПроцентовНач = СтрНач.СуммаПроцентовДолг;  
		//    ПроцентДляИсключенияИзНакладной = ?(СуммаПроцентовНач = 0, 0, СуммаОплаты/СуммаПроцентовНач);
		//	Если ПроцентДляИсключенияИзНакладной >= 0.9 Тогда 
		//		НоваяСтр.СтатусПослеОплаты = ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(НакладнаяНаОтгрузку.Дата-1, НоваяСтр.ОбъектЗалога, ЗалоговыйБилет);
		//	Иначе   
		//		НоваяСтр.СтатусПослеОплаты = НоваяСтр.СтатусОбъекта;
		//	КонецЕсли;	
		//Иначе	
		//     НоваяСтр.СтатусПослеОплаты = НоваяСтр.СтатусОбъекта;
		//КонецЕсли;
		НоваяСтр.СтатусПослеОплаты = НоваяСтр.СтатусОбъекта; 
		НоваяСтр.СуммаОценки = стр.СуммаСсуды;  
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", НоваяСтр.ОбъектЗалога);
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ строки.Количество() = 0 тогда			
			НоваяСтр.СуммаОплатыНач = Строки.Получить(0).СуммаОплаты; 
			Если НоваяСтр.СуммаОплатыНач < 0 Тогда 
				НоваяСтр.СуммаОценки = НоваяСтр.СуммаОценки - НоваяСтр.СуммаОплатыНач;
				НоваяСтр.СуммаОплатыНач = 0;
			КонецЕсли;	
		КонецЕсли;	 
		Если ЗначениеЗаполнено(ДокументОплаты) Тогда
			Строки = ДокументОплаты.Товары.НайтиСтроки(Отбор);
			Если НЕ строки.Количество() = 0 тогда			
				НоваяСтр.СуммаОплаты = Строки.Получить(0).СуммаОплаты;
			КонецЕсли;	 
		КонецЕсли;	   
		Если Выкуп Тогда   
			ЗаполнитьТоварыПослеВыкупа(Ложь); 
			//ИнформацияОплата();
		КонецЕсли;
		НоваяСтр.ЗадолженностьНач = НоваяСтр.СуммаОценки - НоваяСтр.СуммаОплатыНач; 
		НоваяСтр.ЗадолженностьКон = НоваяСтр.ЗадолженностьНач - НоваяСтр.СуммаОплаты;
	Конеццикла;	
	
	ТоварыИтогОценка = ТаблицаТоваров.Итог("СуммаОценки");
	ТоварыИтогОплатаНач = ТаблицаТоваров.Итог("СуммаОплатыНач");
	ТоварыИтогДолгНач = ТаблицаТоваров.Итог("ЗадолженностьНач");
	ТоварыИтогОплатаКон = ТаблицаТоваров.Итог("СуммаОплаты");
	ТоварыИтогДолгКон = ТаблицаТоваров.Итог("Задолженностькон");
КонецПроцедуры	

&НаСервере
Функция РасчитатьДолгПоПроцентам(СтатусЗБ, СуммаЗайма, ПроцентнаяСтавка, ДатаНачалаРасчета) 
	ТаблицаОплатДетально.Очистить();
	Если ЗначениеЗаполнено(ДокументОплаты) И ДокументОплаты.Проведен Тогда 
		ДокументОбъект = ДокументОплаты.ПолучитьОбъект();
	Иначе	      
		ДокументОбъект = СоздатьНовуюОплатуПроцентов(); 	    
	КонецЕсли;	     
	
	НачисленияОстановлены = Ложь;
	ДатаСмертиКлиента = ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(ЗалоговыйБилет.Залогодатель, ДатаДок);   
	Если НЕ ДатаСмертиКлиента = неопределено Тогда   
		ПредыдущийСтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ДатаСмертиКлиента-1, ЗалоговыйБилет); 
		Если ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда 
			НачисленияОстановлены = Истина; 
		КонецЕсли; 
	КонецЕсли;

	Если НачисленияОстановлены ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
		 СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда
		СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(ДокументОбъект, ДокументОбъект.ПредыдущаяОперация);
		
		Если НЕ СуммаПроцентов = 0 Тогда
			СтрП = ТаблицаОплатДетально.Добавить();   
			СтрП.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая; 
			СтрП.ДатаНач = ДатаНачалаРасчета;
			СтрП.ДатаКон = ДокументОбъект.Дата;
			СтрП.ДеньНач = 1;  
			СтрП.ДеньКон = (НачалоДня(СтрП.ДатаКон) - НачалоДня(СтрП.ДатаНач)) / (60 * 60 * 24) + 1; 
			СтрП.СуммаПроцентов = СуммаПроцентов;
			//СтрП.СуммаПроцентовДень = СуммаПроцентов/СтрП.ДеньКон; 
			//СтрП.ПроцентнаяСтавкаБазовая = СтрП.СуммаПроцентовДень/СтрП.СуммаПроцентов*100;
		КонецЕсли;
		
		Возврат СуммаПроцентов;
	КонецЕсли;		
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ЗалоговыйБилет.Дата, ЗалоговыйБилет.Организация);
	Если НЕ СтруктураП = неопределено Тогда
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
		ПредельноеЗначениеПроцентов = ЗалоговыйБилет.СуммаСсуды*СтруктураП.ПланкаПроцентов; 
	Иначе
		ПредельноеЗначениеПроцентов = 0;
	КонецЕсли;   
	СтруктураОкр = ЛБ_УправлениеЛомбардом.ПолучитьУсловияОкругленияПроцентов(ЗалоговыйБилет);
	Установки = ЛБ_УправлениеЛомбардом.ПолучитьУсловияПоДоговору(ЗалоговыйБилет); 	
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(ДокументОбъект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкр); 
	Если Результат.ПредельноеЗначениеПоДоговору Тогда     
		Если НЕ ДостигнутПределПроценты Тогда    
			ДостигнутПределПроценты = Истина;
	        Сообщить("Достигнуто предельное значение суммы процентов по договору.", Статуссообщения.Информация);
		КонецЕсли;	   
	ИначеЕсли ДостигнутПределПроценты Тогда
		ДостигнутПределПроценты = ложь;
	КонецЕсли; 
		
	Для каждого стр из ДокументОбъект.НачислениеПроцентовДетально Цикл 
	    НоваяСтр = ТаблицаОплатДетально.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);
	КонецЦиклА;
	
	НачисленоПроцентов = Результат.СуммаПроцентовНачислено;
	
	Возврат Результат.СуммаПроцентов;
КонецФункции
	

&НаСервере
Процедура ЗаполнитьСостояниеЗалоговогоБилета() 
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	//Если ЗначениеЗаполнено(ДокументОплаты) Тогда
	//	Запрос.УстановитьПараметр("Период", ?(ДокументОплаты.Проведен, ДатаДок-1, ДатаДок)); 
	//Иначе	
	    Запрос.УстановитьПараметр("Период", ДатаДок);  		
	//КонецЕсли;	                                       
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор КАК Регистратор,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовДень КАК СуммаПроцентовДень,
	               |	ЛБ_СостояниеЗалоговогоБилета.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения КАК НомерДопСоглашения,
	               |	ЛБ_СостояниеЗалоговогоБилета.ПричинаПрименения КАК ПричинаПрименения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.Период < &Период
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСостояний.Очистить();
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		СтрСостояние = ТаблицаЗапроса.Получить(0);
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		НоваяСтр.Статус = СтрСостояние.СтатусЗалоговогоБилета;
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;
		НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;
		НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;
		НоваяСтр.СуммаПроцентовСрок = СтрСостояние.СуммаПроцентовСрок;
		НоваяСтр.ПредельныйСрокЗайма = СтрСостояние.ПредельныйСрокЗайма;
		НоваяСтр.ПредельныйСрокЗаймаДни = СтрСостояние.ПредельныйСрокЗаймаДни;  
				
		КолСтр = ТаблицаЗапроса.Количество()-1;  		
		СтрСостояние = ТаблицаЗапроса.Получить(КолСтр);   
		Если ТипЗнч(СтрСостояние.Регистратор) = Тип("ДокументСсылка.ЛБ_КарточкаЗалогодателя") Тогда
			ТекущийСтатусЗБ = СтрСостояние.СтатусЗалоговогоБилета; 
			СтрСостояние = ТаблицаЗапроса.Получить(КолСтр-1); 
		Иначе
			ТекущийСтатусЗБ = неопределено;
		КонецЕсли;	
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета до уплаты процентов";
		НоваяСтр.КлючСтроки = 2;
		НоваяСтр.Статус = ?(ТекущийСтатусЗБ = неопределено, СтрСостояние.СтатусЗалоговогоБилета, ТекущийСтатусЗБ); 
		НоваяСтр.СуммаЗайма = СтрСостояние.СуммаЗайма;
		НоваяСтр.ДатаВозврата = СтрСостояние.ДатаВыкупа;
		НоваяСтр.ДатаВозвратаЛьготная = СтрСостояние.ДатаВыкупаЛьготныйСрок; 
		НоваяСтр.ДатаНачалаРасчета = СтрСостояние.ДатаНачалаРасчетаПроцентов;  
		Если НЕ НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят И 
			 НЕ НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен И 
			 НЕ НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен тогда
			//НоваяСтр.ПроцентнаяСтавка = ЗалоговыйБилет.ПроцентнаяСхема;  
			НоваяСтр.ПроцентнаяСтавка = ЛБ_ОбщийМодуль.ПолучитьПроцентнуюСхемуЗБ(ЗалоговыйБилет, СтрСостояние.ПричинаПрименения);
			НоваяСтр.СуммаПроцентовДень = СтрСостояние.СуммаПроцентовДень;  
		    НоваяСтр.СуммаПроцентовДолг = РасчитатьДолгПоПроцентам(НоваяСтр.Статус, НоваяСтр.СуммаЗайма, НоваяСтр.ПроцентнаяСтавка, НоваяСтр.ДатаНачалаРасчета);
			СуммаОплатыДляПродленияДоговора = окр(НоваяСтр.СуммаПроцентовДолг*90/100, 2);
		Иначе              
			Если ЗначениеЗаполнено(ДокументОплаты) И ДокументОплаты.Проведен Тогда 
				ДокументОбъект = ДокументОплаты.ПолучитьОбъект();
			Иначе	      
				ДокументОбъект = СоздатьНовуюОплатуПроцентов(); 	    
			КонецЕсли;	   
			НоваяСтр.СуммаПроцентовДолг = ЛБ_Общиймодуль.ПолучитьОстатокПроцентов(ДокументОбъект, ЗалоговыйБилет);				
		КонецЕсли;	 
		НоваяСтр.НомерДС = СтрСостояние.НомерДопСоглашения;
			  
		БезПродленияДоговора = ложь;
		СтатусЗалоговогоБилетаНач = ?(ТекущийСтатусЗБ = неопределено, СтрСостояние.СтатусЗалоговогоБилета, ТекущийСтатусЗБ);
		Если СтатусЗалоговогоБилетаНач = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
			 СтатусЗалоговогоБилетаНач = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
			 СтатусЗалоговогоБилетаНач = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен ИЛИ 
			 СтатусЗалоговогоБилетаНач = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство тогда  
			БезПродленияДоговора = Истина;
		Иначе	
		    БезПродленияДоговора = ЗалоговыйБилет.СхемаКредитования.БезПродленияДоговора;
		КонецЕсли;   
	Иначе
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Начальные условия займа";
		НоваяСтр.КлючСтроки = 1;
		
		НоваяСтр = ТаблицаСостояний.Добавить();
		НоваяСтр.Состояние = "Состояние залогового билета до уплаты процентов";
		НоваяСтр.КлючСтроки = 2;     
		
		БезПродленияДоговора = ложь;
	КонецЕсли;	
	БилетИзъят = ?(НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят или НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен, Истина, Ложь); 
	БилетОтгружен = ?(НоваяСтр.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен, Истина, Ложь);

	НоваяСтр = ТаблицаСостояний.Добавить();
	НоваяСтр.Состояние = "Состояние залогового билета после уплаты процентов";
	НоваяСтр.КлючСтроки = 3;  
	
	Отбор = новый Структура;
	Отбор.Вставить("КлючСтроки", 1); 
	СтрокиС = ТаблицаСостояний.НайтиСтроки(Отбор);  
	ПСЗ = СтрокиС.Получить(0).ПредельныйСрокЗайма;
	Если НЕ ПСЗ = Дата(1,1,1) Тогда
	    ДостигнутПСЗ = ?(ДатаДок < ПСЗ, Ложь, Истина);
	Иначе
		ДостигнутПСЗ = Ложь;
	КонецЕсли;	  
	Если БилетОтгружен Тогда
		Элементы.ГруппаПредельныйсрокЗайма.Видимость = Истина;  
		Элементы.СпособОплаты.Видимость = Ложь; 
		Элементы.СпособОплатыБезПродления.Видимость = Ложь;
        Элементы.ГруппаДекорацииПС.Видимость = ложь;
		Элементы.ГруппаОплатаОтгружен.Видимость = Истина; 
	Иначе	
		Если НЕ ДостигнутПСЗ Тогда
			Если БезПродленияДоговора Тогда 
				Элементы.СпособОплаты.Видимость = Ложь; 
				Элементы.СпособОплатыБезПродления.Видимость = Истина;
			Иначе	
				Элементы.СпособОплаты.Видимость = Истина; 
				Элементы.СпособОплатыБезПродления.Видимость = Ложь;		 
			КонецЕсли;   
		ИначеЕсли БезналичнаяОплата Тогда  
			Если БезПродленияДоговора Тогда 
				Элементы.СпособОплаты.Видимость = Ложь; 
				Элементы.СпособОплатыБезПродления.Видимость = Истина;
			Иначе	
				Элементы.СпособОплаты.Видимость = Истина; 
				Элементы.СпособОплатыБезПродления.Видимость = Ложь;		 
			КонецЕсли;     
			Элементы.ГруппаБезналичнаяОплата.Видимость = Истина; 
		Иначе
			Элементы.ГруппаПредельныйсрокЗайма.Видимость = Истина;  
			Элементы.СпособОплаты.Видимость = Ложь; 
			Элементы.СпособОплатыБезПродления.Видимость = Ложь;

			Если (НЕ (Плательщик = ЗалоговыйБилет.Залогодатель) И НЕ ЗначениеЗаполнено(ДоверенностьПлательщика)) ИЛИ БилетИзъят Тогда
			    Элементы.ДекорацияПредельныйСрокДоп.Заголовок = "Возможен только полный выкуп.";
			Иначе
				Элементы.ДекорацияПредельныйСрокДоп.Заголовок = "Возможен только полный выкуп или переоформление." + 
				  ?(ЭтаФорма.НеРедактировать, "", " Нажмите кнопку ""Принять оплату"" и выберите необходимое действие.");
			КонецЕсли;	  
		КонецЕсли;   
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Процедура УстановитьИнформациюВыкуп()
	Если ДостигнутПредельныйСрокЗайма И НЕ БезналичнаяОплата Тогда
		Если (НЕ (Плательщик = ЗалоговыйБилет.Залогодатель) И НЕ ЗначениеЗаполнено(ДоверенностьПлательщика)) ИЛИ БилетИзъят Тогда
		    Элементы.ДекорацияПредельныйСрокДоп.Заголовок = "Возможен только полный выкуп.";
		Иначе
			Элементы.ДекорацияПредельныйСрокДоп.Заголовок = "Возможен только полный выкуп или переоформление." + 
			  ?(ЭтаФорма.НеРедактировать, "", " Нажмите кнопку ""Принять оплату"" и выберите необходимое действие.");
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьПредельныйСрокЗайма() 
	Отбор = Новый структура;
	Отбор.Вставить("КлючСтроки", 1);
	СтрокиС = ТаблицаСостояний.НайтиСтроки(Отбор);  
	Если НЕ СтрокиС.Количество() = 0 Тогда  
		СтрСостояние = СтрокиС.Получить(0); 
		ПредельныйСрокЗайма = СтрСостояние.ПредельныйСрокЗайма;
		Если НЕ ПредельныйСрокЗайма = Дата(1,1,1) тогда
			Если ПредельныйСрокЗайма > НачалоДня(ДатаДок) Тогда
				ДостигнутПредельныйСрокЗайма = Ложь;	
			Иначе  
				ДостигнутПредельныйСрокЗайма = Истина;
				Если НЕ БезналичнаяОплата Тогда
					СпособОплаты = 4;
					ПолныйВыкуп(); 
				КонецЕсли;	
				//ЗаполнитьВернутьЗалог();
			КонецЕсли; 
		КонецЕсли;	
	КонецЕсли;	 
КонецПроцедуры		
		

&НаСервере
Процедура ЗаполнитьКонтакнуюИнформацию()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", Плательщик);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
                   |ИЗ
                   |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		КонтактнаяИнформация = "";
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(Выборка.Гражданство), СокрЛП(Выборка.Гражданство), "");
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(Выборка.Пол), ?(ПустаяСтрока(КонтактнаяИнформация), "", "; ") + "пол.: " + Строка(Выборка.Пол), "");
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(Выборка.ДатаРождения), ?(ПустаяСтрока(КонтактнаяИнформация), "", "; ") + "дата рожд.: " +  Формат(Выборка.ДатаРождения, "ДФ=dd.MM.yyyy"), "");
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(Выборка.МестоРождения), ?(ПустаяСтрока(КонтактнаяИнформация), "", "; ") + "место рожд.: " +  СокрЛП(Выборка.МестоРождения), "");
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(Выборка.Телефон), ?(ПустаяСтрока(КонтактнаяИнформация), "", "; ") + "тел.: " + СокрЛП(Выборка.Телефон), "");
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(Выборка.Email), ?(ПустаяСтрока(КонтактнаяИнформация), "", "; ") + "email: " + СокрЛП(Выборка.Email), "");  
		Если ЗначениеЗаполнено(Выборка.АдресПоПрописке) Тогда
			АдресК = "адрес по прописке: " + СокрЛП(Выборка.АдресПоПрописке);
		Иначе  
			АдресК = "фактический адрес: " + СокрЛП(Выборка.ФактическийАдрес);
		КонецЕсли;	
		КонтактнаяИнформация = КонтактнаяИнформация +  ?(ПустаяСтрока(КонтактнаяИнформация), "", "; ") + АдресК;

		ФИО = СокрЛП(Выборка.Фамилия) + " " + СокрЛП(Выборка.Имя) + ?(НЕ ПустаяСтрока(Выборка.Отчество), " " + СокрЛП(Выборка.Отчество), "");
		Гражданство = Выборка.Гражданство; 
		ДатаРождения = Выборка.ДатаРождения;   
	Иначе
		КонтактнаяИнформация = "";
        ФИО = "";
		Гражданство = справочники.СтраныМира.ПустаяСсылка(); 
		ДатаРождения = Дата(1,1,1); 
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьИнформациюОДокументе()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ДокументЗалогодателя", ДокументПлательщика);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Информация = "";
		Информация = СокрЛП(Выборка.ВидДокумента);
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументСерия), " " + СокрЛП(Выборка.ДокументСерия), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументНомер), " " + СокрЛП(Выборка.ДокументНомер), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументКемВыдан), " выдан " + СокрЛП(Выборка.ДокументКемВыдан), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументДатаВыдачи), " " + Формат(Выборка.ДокументДатаВыдачи,"ДФ=dd.MM.yyyy"), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументКодПодразделения), " код подр. " + СокрЛП(Выборка.ДокументКодПодразделения), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументНачалоДействия), " действует с " + Формат(Выборка.ДокументНачалоДействия,"ДФ=dd.MM.yyyy"), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументСрокДействия), " по " + Формат(Выборка.ДокументСрокДействия,"ДФ=dd.MM.yyyy"), "");
		Паспорт = Информация;  
	Иначе
		Паспорт = "";
   	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьНачалоДействияДокумента()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Владелец", Плательщик); 
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя
	              |ИЗ
	              |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	              |			&Дата,
	              |			ДокументЗалогодателя.Владелец = &Владелец
	              |				И ВидДокументаЗалогодателя = Значение(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";

КонецФункции	

&НаКлиенте
Процедура КарточкаПлательщика(Команда)
	СтандартнаяОбработка = ложь;
	Если ЗначениеЗаполнено(плательщик) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Плательщик);
		ПараметрыФормы.Вставить("Дата", ДатаДок);	
		ПараметрыФормы.Вставить("ТолькоПросмотр", истина);
		//ПараметрыФормы.Вставить("НеРедактировать", истина); 
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеИзмененияКарточки",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Сообщить("Не выбран плательщик!");
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Функция ПолучитьДокументПлательщика() 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", Плательщик);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Залогодатель
	               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДокументЗалогодателя;
	КонецЕсли; 
	Возврат ДокументПлательщика;
КонецФункции


&НаКлиенте
Процедура ПослеИзмененияКарточки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	Если ЭтаФорма.НеРедактировать тогда
		Возврат;
	КонецЕсли;	
	
	//Если НЕ ЗначениеЗаполнено(ДокументОплаты) И НачалоДня(ДатаДок) = НачалоДня(ТекущаяДата()) Тогда 
	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	Если НачалоДня(ДатаДок) = НачалоДня(ДатаСеанса) Тогда
		ДатаДок = ДатаСеанса;
	КонецЕсли;	
    ЗаполнитьКонтакнуюИнформацию(); 
	НовыйДокументПлательщика = ПолучитьДокументПлательщика();
	Если НЕ ДокументПлательщика = НовыйДокументПлательщика Тогда
		ДокументПлательщика = НовыйДокументПлательщика;
		ЗаполнитьИнформациюОДокументе();
	    ЗаполнитьДопДокументы();	
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьИнформациюОплательщике() 
	ЗаполнитьКонтакнуюИнформацию(); 
	ЗаполнитьИнформациюОДокументе();	  
	ЗаполнитьДопДокументы(); 
	Если НЕ Плательщик = ЗалоговыйБилет.Залогодатель Тогда 
		ЗаполнитьСписокВыбораДоверенностейПлательщика();  
		Если НЕ Элементы.Доверенность.СписокВыбора.Количество() = 0 Тогда
			Если НЕ ДоверенностьПлательщика = Элементы.Доверенность.СписокВыбора.Получить(0).Значение Тогда
			    ДоверенностьПлательщика = Элементы.Доверенность.СписокВыбора.Получить(0).Значение;
				ЗаполнитьТекстДоверенности();
			КонецЕсли; 
		Иначе    
			ДоверенностьПлательщика = ПредопределенноеЗначение("Документ.ЛБ_Доверенности.ПустаяСсылка");
			Доверенность = "";
		КонецЕсли;	
	КонецЕсли;	    
КонецПроцедуры	

&НаСервере 
Функция ПолучитьПричинуПримененияПроцентнойСхемы()
	Возврат ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(, ЗалоговыйБилет, ДатаДок); 
КонецФункции

&НаСервере 
Функция ПолучитьНакладнуюНаОтгрузку()
	Возврат ЛБ_УправлениеЛомбардом.ПолучитьНакладнуюНаОтгрузкуЗалогоговогоБилета(ДатаДок, ЗалоговыйБилет);
КонецФункции


&НаКлиенте
Процедура ДатаДокПриИзменении(Элемент)  
	ЗаполнитьИнформациюОплательщике(); 
	НакладнаяНаОтгрузку = ПолучитьНакладнуюНаОтгрузку();
	
	ТаблицаСостояний.Очистить(); 
	ТаблицаТоваров.Очистить();
	ПричинаПримененияПроцентнойСхемы = ПолучитьПричинуПримененияПроцентнойСхемы();
	ЗаполнитьСостояниеЗалоговогоБилета(); 
	ЗаполнитьТовары(); 
	Если Выкуп тогда
		ЗаполнитьТоварыПослеВыкупа(Ложь);
		ИнформацияОплата();
	КонецЕсли;   

	СпособОплаты = 1; 	
	СуммаОплаты = 0;
	Наличные = 0;
	Сдача = 0;
	Элементы.ДекорацияОплата.Заголовок = "";
	ПроверитьПредельныйСрокЗайма();
    Если НЕ ДостигнутПредельныйСрокЗайма Тогда
		Если БезПродленияДоговора Тогда 
			Элементы.СпособОплаты.Видимость = Ложь; 
			Элементы.СпособОплатыБезПродления.Видимость = Истина;
		Иначе	
			Элементы.СпособОплаты.Видимость = Истина; 
			Элементы.СпособОплатыБезПродления.Видимость = Ложь;		 
		КонецЕсли;                                                
		Элементы.ГруппаПредельныйсрокЗайма.Видимость = ложь; 
		Элементы.ГруппаБезналичнаяОплата.Видимость = Ложь;
	ИначеЕсли БезналичнаяОплата Тогда  
		Если БезПродленияДоговора Тогда 
			Элементы.СпособОплаты.Видимость = Ложь; 
			Элементы.СпособОплатыБезПродления.Видимость = Истина;
		Иначе	
			Элементы.СпособОплаты.Видимость = Истина; 
			Элементы.СпособОплатыБезПродления.Видимость = Ложь;		 
		КонецЕсли;     
		Элементы.ГруппаПредельныйсрокЗайма.Видимость = Ложь; 
		Элементы.ГруппаБезналичнаяОплата.Видимость = Истина;
	 Иначе
		Элементы.ГруппаПредельныйсрокЗайма.Видимость = Истина;  
		Элементы.ГруппаБезналичнаяОплата.Видимость = Ложь;
		Элементы.СпособОплаты.Видимость = Ложь; 
		Элементы.СпособОплатыБезПродления.Видимость = Ложь;	 
		Если (НЕ (Плательщик = ПолучитьЗалогодателя()) И НЕ ЗначениеЗаполнено(ДоверенностьПлательщика)) ИЛИ ЭтаФорма.БилетИзъят Тогда
		    Элементы.ДекорацияПредельныйСрокДоп.Заголовок = "Возможен только полный выкуп.";
		Иначе
			Элементы.ДекорацияПредельныйСрокДоп.Заголовок = "Возможен только полный выкуп или переоформление." + 
			  ?(ЭтаФорма.НеРедактировать, "", " Нажмите кнопку ""Принять оплату"" и выберите необходимое действие.");
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть(?(ЗначениеЗаполнено(ДокументОплаты), ДокументОплаты, неопределено));
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПроцентов(Полностью = ложь)  
	Выкуп = ложь; 
	ЗаполнитьСостояниеЗалоговогоБилета();
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", 2);       
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);
	СуммаПроцентов = Строки[0].СуммаПроцентовДолг; 
	Если Полностью Тогда 
		СуммаОплаты = СуммаПроцентов;
	Иначе	
	    СуммаОплаты = СуммаОплатыДляПродленияДоговора; 
	КонецЕсли;	
	СуммаОплатыПроценты = СуммаОплаты;
	СуммаОплатыСсуда = 0; 
	РаспределитьСуммуОплатыСсудыТовары(); 	
	ЗаполнитьСтрокуСостоянияПослеОплаты(); 
	ЗаполнитьСостояниеТоваровПерезалог();
	ИнформацияОплата(); 
КонецПроцедуры    

&НаКлиенте
Процедура ПолныйВыкуп()   
	Выкуп = Истина;    
	ЗаполнитьСостояниеЗалоговогоБилета(); 
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", 2);       
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);
    СуммаОплатыПроценты = Строки[0].СуммаПроцентовДолг;
	СуммаОплатыСсуда = Строки[0].СуммаЗайма;
	СуммаОплаты = СуммаОплатыПроценты + СуммаОплатыСсуда; 
	РаспределитьСуммуОплатыСсудыТовары(Истина); 
	ЗаполнитьВернутьЗалог();  	
	ЗаполнитьСтрокуСостоянияПослеОплаты(Истина);
	ИнформацияОплата(); 
КонецПроцедуры   


&НаСервере
Процедура ИнформацияОплата()
	СтрокаОплата = "Оплата проценты " + сокрЛП(Формат(СуммаОплатыПроценты, "ЧЦ=15; ЧДЦ=2; ЧН='0, 00'")) + " руб., тело займа " + сокрЛП(Формат(СуммаОплатыСсуда, "ЧЦ=15; ЧДЦ=2; ЧН='0, 00'")) + " руб.";
	Элементы.ДекорацияОплата.Заголовок = СтрокаОплата;  
	СтрокаВыкуп = "";
	Если Выкуп Тогда
		Если НЕ Плательщик = ЗалоговыйБилет.Залогодатель Тогда
			Если НЕ ЗначениеЗаполнено(ДоверенностьПлательщика) Тогда   
				СтрокаВыкуп = "Внимание! Не выбрана доверенность представителя заемщика. Выкупленные объекты залога будут оставлены в ломбарде на отвественное хранение.";
			КонецЕсли;	
		КонецЕсли; 
	Иначе	
	КонецЕсли;
	Элементы.ДекорацияВыкуп.Заголовок = СтрокаВыкуп; 
	УстановитьИнформациюВыкуп();
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьСостояниеТоваровПерезалог() 
	Если Выкуп Тогда
		Возврат;
	КонецЕсли;	
	Перезалог = ?(ПродлитьДоговорДни = 0, Ложь, Истина);
	Если Перезалог Тогда
		Для каждого стр из ТаблицаТоваров Цикл 
			Если Стр.СтатусПослеОплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.Принят") ИЛИ 
				 Стр.СтатусПослеОплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную") ИЛИ
				 Стр.СтатусПослеОплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг") Тогда
			    Стр.СтатусПослеОплаты = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.Продлен");
			КонецЕсли;	
		Конеццикла;	
	Иначе
		Для каждого стр из ТаблицаТоваров Цикл
			Стр.СтатусПослеОплаты = Стр.СтатусОбъекта;
		Конеццикла;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВернутьЗалог()
	Если Выкуп Тогда
		ЗаполнитьТоварыПослеВыкупа(Ложь); 
		ИнформацияОплата();
	Иначе
		Для каждого стр из ТаблицаТоваров Цикл
			Стр.ВернутьЗалог = ложь;
			Стр.ПроверкаВернутьЗалог = ложь;
		Конеццикла;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СпособОплатыПриИзменении(Элемент) 
	Элементы.СуммаОплаты.ТолькоПросмотр = Истина;
	Если СпособОплаты = 1 Тогда //Свободная оплата
		Элементы.СуммаОплаты.ТолькоПросмотр = ложь;
	ИначеЕсли СпособОплаты = 2 Тогда //продление договора
		ОплатаПроцентов();
	ИначеЕсли СпособОплаты = 3 Тогда //все проценты
		ОплатаПроцентов(Истина);
	ИначеЕсли СпособОплаты = 4 Тогда //выкуп
		ПолныйВыкуп();	
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура СуммаОплатыПриИзменении(Элемент)	
	Выкуп = Истина;
	ЗаполнитьСостояниеЗалоговогоБилета();
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", 2);       
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	ОбщаяСуммаДолга = Строки[0].СуммаЗайма + Строки[0].СуммаПроцентовДолг;
	Если СуммаОплаты > ОбщаяСуммаДолга Тогда 
		Сообщить("Введенная сумма оплаты " + СокрЛП(Формат(СуммаОплаты,"ЧЦ=15; ЧДЦ=2" )) + " руб. больше суммы долга клиента по оплате процентов и тела займа " + СокрЛП(Формат(ОбщаяСуммаДолга,"ЧЦ=15; ЧДЦ=2" )) + " руб.");
		СуммаОплаты = ОбщаяСуммаДолга;
	КонецЕсли;	
    СуммаОплатыПроценты = Строки[0].СуммаПроцентовДолг;
	Если СуммаОплаты <= Строки[0].СуммаПроцентовДолг Тогда
		СуммаОплатыПроценты = СуммаОплаты;
		СуммаОплатыСсуда = 0;
	Иначе	
		СуммаОплатыПроценты = Строки[0].СуммаПроцентовДолг;
		СуммаОплатыСсуда = СуммаОплаты - СуммаОплатыПроценты;
	КонецЕсли;  
	ЭтоВыкуп = ?(СуммаОплатыСсуда = Строки[0].СуммаЗайма, истина, ложь);  
	Если НЕ Выкуп = ЭтоВыкуп Тогда
		Выкуп = ЭтоВыкуп;     
		ЗаполнитьСостояниеЗалоговогоБилета(); 
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", 2);       
		Строки = ТаблицаСостояний.НайтиСтроки(Отбор);   
		СуммаОплатыПроценты = Строки[0].СуммаПроцентовДолг;
		Если СуммаОплаты <= Строки[0].СуммаПроцентовДолг Тогда
			СуммаОплатыПроценты = СуммаОплаты;
			СуммаОплатыСсуда = 0;
		Иначе	
			СуммаОплатыПроценты = Строки[0].СуммаПроцентовДолг;
			СуммаОплатыСсуда = СуммаОплаты - СуммаОплатыПроценты;
		КонецЕсли;  
	КонецЕсли;	       
	РаспределитьСуммуОплатыСсудыТовары(ЭтоВыкуп);
	ЗаполнитьВернутьЗалог();
	ЗаполнитьСтрокуСостоянияПослеОплаты(ЭтоВыкуп);	
	ЗаполнитьСостояниеТоваровПерезалог();
	ИнформацияОплата();    
КонецПроцедуры 

&НаСервере
Процедура РаспределитьСуммуОплатыСсудыТовары(Выкуп = ложь) 
	Если Выкуп Тогда 
		Для каждого Стр Из ТаблицаТоваров Цикл 
			Стр.СуммаОплаты = Стр.ЗадолженностьНач;  
			Стр.ЗадолженностьКон = 0;
		КонецЦикла;	
	Иначе	
		СуммаДляРаспределения = СуммаОплатыСсуда;
		Если СуммаДляРаспределения = 0 Тогда
			Для каждого Стр Из ТаблицаТоваров Цикл
				Стр.СуммаОплаты = 0;   
				Стр.ЗадолженностьКон = Стр.ЗадолженностьНач - Стр.СуммаОплаты;
			Конеццикла;	
		Иначе	
			НомСтрМакс = 0; 
			МаксЗадолженность = 0;
			ЗадолженностьНачИтог = ТаблицаТоваров.Итог("ЗадолженностьНач");
			Для каждого Стр Из ТаблицаТоваров Цикл 
			    Коэфф = Стр.ЗадолженностьНач/ЗадолженностьНачИтог;
				Стр.СуммаОплаты = СуммаОплатыСсуда*Коэфф;
				Стр.ЗадолженностьКон = Стр.ЗадолженностьНач - Стр.СуммаОплаты;
				СуммаДляРаспределения = СуммаДляРаспределения - Стр.СуммаОплаты;
				Если Стр.ЗадолженностьНач > МаксЗадолженность Тогда
					МаксЗадолженность = Стр.ЗадолженностьНач;  
					НомСтрМакс = стр.НомерСтроки-1;
				КонецЕсли;	
			КонецЦикла;
			Если НЕ СуммаДляРаспределения = 0 Тогда
				Стр = ТаблицаТоваров.Получить(НомСтрМакс);
				Стр.СуммаОплаты = Стр.СуммаОплаты + СуммаДляРаспределения;
				Стр.ЗадолженностьКон = Стр.ЗадолженностьНач - Стр.СуммаОплаты;
			КонецЕсли;  
		КонецЕсли;	
	КонецЕсли;	
	
	ТоварыИтогОплатаКон = ТаблицаТоваров.Итог("СуммаОплаты");
	ТоварыИтогДолгКон = ТаблицаТоваров.Итог("ЗадолженностьКон");
КонецПроцедуры	

&НаСервере
Функция ЗаполнитьСписокТоваровНеВЛомбарде()  
    СписокТоваров = Новый СписокЗначений;
	
	Запрос = новый Запрос;   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
    Запрос.УстановитьПараметр("Дата", ДатаДок);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	Для каждого стр Из ТаблицаТоваров цикл  
		Если Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
		Отбор.Вставить("Ломбард", Ломбард);
		Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 тогда 			
			Отбор.Удалить("Ломбард");
			Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 тогда 
				ИнформацияВыкуп = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет, Стр.НомерСтроки) + " " + СокрЛП(Стр.ОбъектЗалога) + ": находится в " + СокрЛП(Строки.Получить(0).Ломбард);
				СписокТоваров.Добавить(ИнформацияВыкуп);
			ИначеЕсли НЕ Стр.СтатусОбъекта = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят Тогда	 
				ИнформацияВыкуп = ЛБ_УправлениеЛомбардом.АртикулОбъектаЗалога(ЗалоговыйБилет, Стр.НомерСтроки) + " " + СокрЛП(Стр.ОбъектЗалога) + ": местонахождение не определено";
			    СписокТоваров.Добавить(ИнформацияВыкуп); 	
			КонецЕсли; 
		КонецЕсли;	
	Конеццикла;	   
	
	Возврат СписокТоваров;
КонецФункции	

&НаСервере
Функция ПроверитьВозможноПереоформление()  
	СтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ДатаДок, ЗалоговыйБилет);
	Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят Или СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен Тогда
		Возврат ложь;                                                                                                
	//ИначеЕсли НЕ ЗалоговыйБилет.Ломбард = Ломбард Тогда
	//	Возврат Ложь;
	ИначеЕсли ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(ЗалоговыйБилет.Залогодатель, ДатаДок) = неопределено Тогда 
	    Возврат ?(НЕ ПроверитьПлательщикЭтоЗаемщик() И НЕ ЗначениеЗаполнено(ДоверенностьПлательщика), Ложь, Истина); 	
	Иначе      
		Если НЕ ЗначениеЗаполнено(ДоверенностьПлательщика) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ ДоверенностьПлательщика.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.СвидетельствоОСмерти Тогда
			Возврат ложь;
		Иначе      
			Возврат Истина;
		КонецЕсли;	  
	КонецЕсли;	
КонецФункции

&НаСервере
Функция ПроверитьКассовуюСмену(ДатаПроверки = неопределено) 	            
	Возврат ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(?(ДатаПроверки = неопределено, ТекущаяДатаСеанса(), ДатаПроверки), ЗалоговыйБилет.Организация, Ломбард);
КонецФункции

&НаСервере
Функция ПроверитьЕстьВНакладной()
	Возврат  ЛБ_УправлениеЛомбардом.ПолучитьСтатусНакладнойПоЗБ(ДатаДок, ЗалоговыйБилет); 
КонецФункции

&НаСервере
Функция ОплатаМеньше90Процентов()
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", 2);       
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СуммаДолга = Строки[0].СуммаПроцентовДолг;
	Если НЕ СуммаДолга = 0 Тогда
		Если окр(СуммаОплаты/СуммаДолга*100, 2) < 90 Тогда 
			Возврат Истина;
		КонецЕсли; 
	КонецЕсли;
	Возврат Ложь;
КонецФункции

