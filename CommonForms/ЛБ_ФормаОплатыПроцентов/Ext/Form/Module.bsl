&НаСервере
Функция ПроверкаЗаполненияДокумента(НовыйДокумент) 
	Результат = Истина;
	Если ((НовыйДокумент.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
	   (НовыйДокумент.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И НовыйДокумент.ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) Тогда
	    Если НовыйДокумент.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда 			    
			Парам = Новый Структура("Серия, Номер", СокрЛП(НовыйДокумент.ДокументСерия), СокрЛП(НовыйДокумент.ДокументНомер));
			Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
				Сообщить("Документ найден в списке недействительных паспортов!");
				Результат = ложь; 
			ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(НовыйДокумент.ДатаРождения, НовыйДокумент.ДокументДатаВыдачи) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
			    Результат = ложь;	
			КонецЕсли;	
		ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(НовыйДокумент.ДатаРождения, НовыйДокумент.ДокументДатаВыдачи) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		    Результат = ложь;   
		КонецЕсли;	
	ИначеЕсли (НовыйДокумент.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) И НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(НовыйДокумент.ДатаРождения, ДатаДок) Тогда
		Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
	    Результат = ложь;
	КонецЕсли;	
	Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, НовыйДокумент.ДокументВидДокументаЗалогодателя, НовыйДокумент.ДокументВид) тогда
		Если НЕ ЗначениеЗаполнено(НовыйДокумент.ДокументСрокДействия) Тогда
			Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить срок действия!");
	        Результат = ложь;
		ИначеЕсли НовыйДокумент.ДокументСрокДействия <	НачалоДня(ДатаДок) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
	        Результат = ложь;
		КонецЕсли;	
	КонецЕсли;	 
	Если НЕ НовыйДокумент.Гражданство = Справочники.СтраныМира.Россия Тогда
		Отбор = Новый Структура; 
		Отбор.Вставить("Клиент", НовыйДокумент.Залогодатель);
		Строки = НовыйДокумент.ДополнительныеДокументыПравоПребыванияРФ.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда 
			Сообщить("Не выбран документ удостоверяющий право пребывания клиента на территории РФ!");
	        Результат = ложь;
		Иначе                  
			ЕстьДокументГражданствоНЕРФ = ложь;
			Для каждого Стр Из Строки Цикл
				//Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Гражданство, Стр.ДокументЗалогодателя, Стр.ВидДокумента) тогда 
				//	Если НЕ ЗначениеЗаполнено(НовыйДокумент.ДокументСрокДействия) Тогда
				//		Продолжить;
				//	ИначеЕсли НовыйДокумент.ДокументСрокДействия <	НачалоДня(ДатаДок) Тогда
				//		Продолжить;
				//	КонецЕсли;	
				//    ЕстьДокументГражданствоНЕРФ = Истина;
				//	Прервать;  
				//Иначе
				//	ЕстьДокументГражданствоНЕРФ = Истина;
				//	Прервать; 
				//КонецЕсли;	
				Если Стр.ДокументГражданство = Гражданство Тогда
					ЕстьДокументГражданствоНЕРФ = Истина;
					Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда 
					    Если НЕ ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Стр.ДокументГражданство, Стр.ВидДокументаЗалогодателя, Стр.ВидДокумента) тогда
					         ТекстСообщения1 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоВозраст(ДатаРождения, Стр.ДокументДатаВыдачи); 
							 Если НЕ Пустаястрока(ТекстСообщения1) тогда 
								 Сообщить(ТекстСообщения1); 
								 Результат = ложь;
							 КонецЕсли;	  								  
						 КонецЕсли;       
						 ТекстСообщения2 = ЛБ_ОбщийМодуль.ПроверитьСменаВидНаЖительствоКонтактнаяИнформация(Плательщик, Стр.ДокументДатаВыдачи, ДатаДок); 
						 Если НЕ Пустаястрока(ТекстСообщения2) тогда 
							 Сообщить(ТекстСообщения2); 
							 Результат = ложь;
						 КонецЕсли;	
					КонецЕсли;	 
				КонецЕсли;	
			КонецЦикла;	
			Если НЕ ЕстьДокументГражданствоНЕРФ Тогда
				Сообщить("У клиента нет действующего документа, удостоверяющего право пребывания на территории РФ!");
				Результат = ложь;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	// ++ Сербаев 08.06.2023  (Проверка документа Вид на жительство на действительность)
	Если НовыйДокумент.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда
		СтруктураД = Новый Структура("ДокументСрокДействия, ДокументДатаВыдачи", НовыйДокумент.ДокументСрокДействия, НовыйДокумент.ДокументДатаВыдачи);        
	    Если ЛБ_ОбщийМодуль.ПроверитьДействительностьВидаНаЖительство(СтруктураД, ДатаРождения, ДатаДок) Тогда
		    ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Документ вид на жительство просрочен!'"));
			Результат = ложь;
		КонецЕсли;
	КонецЕсли;
    // -- Сербаев 08.06.2023
	
	Возврат Результат;
КонецФункции


&НаСервере
Функция СоздатьДокументНаСервере()  
	Если ЗначениеЗаполнено(ДокументОплаты) Тогда
		ДокументОбъект = ДокументОплаты.ПолучитьОбъект(); 
		ДокументОбъект.Дата = ДатаДок;
	Иначе	
	    ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
		ДокументОбъект.Дата = ДатаДок;
		ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;  
	    ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет;
        ДокументОбъект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
        ДокументОбъект.Товары.Загрузить(ДокументОбъект.ПредыдущаяОперация.Товары.Выгрузить());
		ДокументОбъект.Вставки.Загрузить(ДокументОбъект.ПредыдущаяОперация.Вставки.Выгрузить());
		ДокументОбъект.ДополнительныеМеталлы.Загрузить(ДокументОбъект.ПредыдущаяОперация.ДополнительныеМеталлы.Выгрузить());
		ДокументОбъект.Дефекты.Загрузить(ДокументОбъект.ПредыдущаяОперация.Дефекты.Выгрузить()); 
		Если ДокументОбъект.ПредыдущаяОперация.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
			СтрокиТоварыУдалить = Новый СписокЗначений;
			СтрокиДефектыУдалить = Новый СписокЗначений;
			СтрокиВставкиУдалить = Новый СписокЗначений;
			СтрокиДополнительныеМеталлыУдалить = Новый СписокЗначений;
			Для каждого СтрТ Из ДокументОбъект.Товары Цикл  
				Если НЕ СтрТ.Переоформить Тогда
					СтрокиТоварыУдалить.Добавить(СтрТ);
					ОтборТ = Новый Структура;
					ОтборТ.Вставить("КлючСтроки", СтрТ.КлючСтроки); 
					
					СтрокиД = ДокументОбъект.Дефекты.НайтиСтроки(ОтборТ);
					Для каждого СтрД Из СтрокиД Цикл 
						СтрокиДефектыУдалить.Добавить(СтрД);
					КонецЦикла;	 
					
					СтрокиВ = ДокументОбъект.Вставки.НайтиСтроки(ОтборТ);
					Для каждого СтрВ Из СтрокиВ Цикл 
						СтрокиВставкиУдалить.Добавить(СтрВ);
					КонецЦикла;	
					
					СтрокиДМ = ДокументОбъект.ДополнительныеМеталлы.НайтиСтроки(ОтборТ);
					Для каждого СтрДМ Из СтрокиДМ Цикл 
						СтрокиДополнительныеМеталлыУдалить.Добавить(СтрДМ);
					КонецЦикла;	
				КонецЕсли;	
			КонецЦикла;	        
			Для каждого Эл Из СтрокиТоварыУдалить Цикл 
				ДокументОбъект.Товары.Удалить(Эл.Значение);
			КонецЦикла;	
			Для каждого Эл Из СтрокиДефектыУдалить Цикл 
				ДокументОбъект.Дефекты.Удалить(Эл.Значение);
			КонецЦикла;	 
            Для каждого Эл Из СтрокиВставкиУдалить Цикл 
				ДокументОбъект.Вставки.Удалить(Эл.Значение);
			КонецЦикла;	 
            Для каждого Эл Из СтрокиДополнительныеМеталлыУдалить Цикл 
				ДокументОбъект.ДополнительныеМеталлы.Удалить(Эл.Значение);
			КонецЦикла;	 			 
		КонецЕсли;	
		ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет; 
