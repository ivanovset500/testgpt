&НаСервере
Функция ПроверитьЕстьВНакладной()
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок);   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("СтатусЗалоговогоБилета", Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.Период КАК Дата,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.Период <= &Дата
	               |	И ЛБ_СостояниеЗалоговогоБилета.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета = &СтатусЗалоговогоБилета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Возврат Выборка.СтатусЗалоговогоБилета;
	КонецЕсли;	                            
	Возврат неопределено;
КонецФункции  

&НаКлиенте
Процедура ВернутьЗалог(Команда)
	Если НеРедактировать Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый структура;
	Отбор.Вставить("КлючСтроки", 2);
	СтрокиС = ТаблицаСостояний.НайтиСтроки(Отбор);
	Если НЕ СтрокиС.Количество() = 0 Тогда    
		СтатусЗБ = СтрокиС.Получить(0).Статус;
		Если НЕ СтатусЗБ = Строка(ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение")) И
			 НЕ СтатусЗБ = Строка(ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Наследство")) Тогда 
			Сообщить("Статус выбранного залогового билета на " + Формат(ЭтаФорма.ДатаДок, "ДЛФ=DT") + ?(СтатусЗБ = неопределено, " не определен", " """ + строка(СтатусЗБ)) + """. Выдача залога не возможна!");
			Возврат;
		КонецЕсли;	
	Иначе
		Сообщить("Статус выбранного залогового билета на " + Формат(ЭтаФорма.ДатаДок, "ДЛФ=DT") + " не определен. Выдача залога не возможна!");
		Возврат;
	КонецЕсли;	
	
	Если ПроверитьЕстьВНакладной() = неопределено Тогда
		ЕстьВНакладной = Ложь;
	Иначе	         
		ЕстьВНакладной = Истина;
	КонецЕсли;

	БилетИзъят = Ложь;
	ЕстьВернутьЗалог = ложь;
	Для каждого Стр из ТаблицаТоваров Цикл  
		Если Стр.ВернутьЗалог Тогда
			ЕстьВернутьЗалог = Истина;
		КонецЕсли;	
		Если Стр.СтатусОбъектаЗалога = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.Изъят") ИЛИ	Стр.СтатусОбъектаЗалога = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.Возвращен") Тогда  
			БилетИзъят = Истина
		КонецЕсли;	
	Конеццикла;	     
	Если НЕ ЕстьВернутьЗалог Тогда
		Сообщить("Не выбраны возвращаемые объекты залога!");
		Возврат;
	КонецЕсли;
	
	Отбор = новый Структура;
	Отбор.Вставить("КлючСтроки", 3); 
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0 Тогда
		ЗаймДолг = Строки.Получить(0).СуммаЗайма;
		Если НЕ ЗаймДолг = 0 Тогда  
			Сообщить("Долг по оплате суммы займа " + СокрЛП(Формат(ЗаймДолг, "ЧЦ=15; ЧДЦ=2")) + ". Выдача объектов залога запрещена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;	

	Если ПроверкаКлиента() Тогда  
		Если НЕ ЗначениеЗаполнено(ДокументВыдачиЗалога) И НачалоДня(ДатаДок) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		    ДатаДок = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли;	   
		
		Если НЕ БилетИзъят И НЕ ЕстьВНакладной Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет); 
			ПараметрыФормы.Вставить("Ломбард", Ломбард);
			ПараметрыФормы.Вставить("Получатель", Получатель);
			ПараметрыФормы.Вставить("ДоверенностьПолучателя", ДоверенностьПолучателя); 
			ПараметрыФормы.Вставить("ДатаДок", ДатаДок);  
			ПараметрыФормы.Вставить("ФИОПолучателя", ФИО); 
			ПараметрыФормы.Вставить("Доверенность", Доверенность);  
							
			ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораПереоформить", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ЛБ_ВыдатьЗалогПереоформить", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе  
			ЕстьНеПроведенные  = СоздатьДокументНаСервере();
			Если НЕ ЕстьНеПроведенные Тогда
				НеРедактировать = Истина;
				Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
				Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
				Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		        Элементы.Редактировать.Видимость = Истина; 
				Элементы.ВернутьЗалог.Доступность = Ложь;
			    Элементы.Отмена.Заголовок = "Закрыть"; 
				Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;
				ЗаполнитьТовары();
				Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
		   	        ФормаРМП = ВладелецФормы;   
					Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
		                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
					КонецЕсли;	
	            КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры      

&НаСервере
Функция ПолучитьОсновнойДокументПереоформление(Клиент) 
	Если Клиент = Получатель Тогда
		Возврат ДокументПолучателя;
	КонецЕсли;
	
	Гражданство = Справочники.СтраныМира.Россия;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса()); 
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Гражданство = Выборка.Гражданство;
	КонецЕсли;	
	Возврат ЛБ_УправлениеЛомбардом.ПроверитьОсновнойДокумент(ДатаДок, Клиент, Гражданство);
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПереоформить(Результат, ДопПараметры) Экспорт
    Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
        Возврат;
	КонецЕсли; 
	
	Если Результат.Операция = 1 Тогда 
		ЕстьНеПроведенные  = СоздатьДокументНаСервере();
		Если НЕ ЕстьНеПроведенные Тогда
			НеРедактировать = Истина;
			Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
			Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
			Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
	        Элементы.Редактировать.Видимость = Истина; 
			Элементы.ВернутьЗалог.Доступность = Ложь;
		    Элементы.Отмена.Заголовок = "Закрыть"; 
			Элементы.ОсновнаяПанель.ТолькоПросмотр = НеРедактировать;
			ЗаполнитьТовары();    
			Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
	   	        ФормаРМП = ВладелецФормы;   
				Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
	                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
				КонецЕсли;	
            КонецЕсли;
		КонецЕсли;	
	ИначеЕсли Результат.Операция = 2 Тогда 
		ПараметрыФормы = Новый Структура;      
		ПараметрыФормы.Вставить("Дата", ДатаДок); 
		ПараметрыФормы.Вставить("ПредыдущаяОперация", ЗалоговыйБилет);  
		Если Результат.СпособПереоформления = 0 Тогда  //на заемщика  
			Залогодатель = ПолучитьЗалогодателя();
			ПараметрыФормы.Вставить("Залогодатель", Залогодатель);
			ПараметрыФормы.Вставить("ДокументЗалогодателя", ПолучитьОсновнойДокументПереоформление(Залогодатель)); 
			Если НЕ Получатель = Залогодатель Тогда  
				ПараметрыФормы.Вставить("Представитель", Получатель);
				ПараметрыФормы.Вставить("ДокументПредставителя", ДокументПолучателя); 
				ПараметрыФормы.Вставить("ДоверенностьПредставителя", ДоверенностьПолучателя); 
			КонецЕсли;	  
		Иначе //на доверенное лицо
			ПараметрыФормы.Вставить("Залогодатель", Получатель);
			ПараметрыФормы.Вставить("ДокументЗалогодателя", ДокументПолучателя);
			ПараметрыФормы.Вставить("ДоверенностьПредставителя", ДоверенностьПолучателя); 
		КонецЕсли;
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеСозданияПереоформления", ЭтотОбъект);  
		Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
		    ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма.ВладелецФормы, Истина,,,ОписаниеОповещения); 
		Иначе
			ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения); 
        КонецЕсли;
	КонецЕсли;	
	//+Мельников 25.04.24 Отмена операции
	УстановитьВидимость();
	//-Мельников
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияПереоформления(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено Тогда
