&НаСервере
Процедура УстановитьТекщиеСтроки()
	Если Залогодатели.Количество() <> 0  Тогда
	    СтрокаЗ = Залогодатели[0]; 
		ИдентификаторСтрокиЗ = СтрокаЗ.ПолучитьИдентификатор();
		Элементы.Залогодатели.ТекущаяСтрока = ИдентификаторСтрокиЗ;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ДобавитьЗалогодателя(Элемент.ТекущиеДанные.Залогодатель);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗалогодателя(Залогодатель)
	Отбор = Новый Структура;
	Отбор.Вставить("Залогодатель", Залогодатель);

	НайденныйЗалогодатель = ВыбранныеЗалогодатели.НайтиСтроки(Отбор);
	
	Если НайденныйЗалогодатель.Количество() > 0 Тогда
		Сообщить("Данный залогодатель уже выбран.");
		Возврат;
	ИначеЕсли НЕ ПроверитьНачалоРаботыСКлиентом(Залогодатель) Тогда
		Возврат;
	Иначе
		НоваяСтр = ВыбранныеЗалогодатели.Добавить();
		НоваяСтр.Залогодатель = Залогодатель;
	КонецЕсли;
	
	ВыбранныеЗалогодатели.Сортировать("Залогодатель Возр");
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодателиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	Если Элементы.Залогодатели.ТекущиеДанные <> Неопределено Тогда
		ДобавитьЗалогодателя(Элементы.Залогодатели.ТекущиеДанные.Залогодатель);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Выбор(Команда)
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Количество", ВыбранныеЗалогодатели.Количество());
	Ном = 0;
	Для каждого Стр Из ВыбранныеЗалогодатели Цикл
		Ном = Ном + 1;
		СтруктураВозврата.Вставить("Значение" + Строка(Ном), Стр.Залогодатель);
	КонецЦикла;	

	Закрыть(СтруктураВозврата);
КонецПроцедуры

&НаСервере
Функция ПроверитьНачалоРаботыСКлиентом(Залогодатель)  
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АнкетаЗалогодателя.ДатаОформленияАнкеты КАК ДатаОформленияАнкеты
	               |ИЗ
	               |	РегистрСведений.ЛБ_АнкетаЗалогодателя КАК ЛБ_АнкетаЗалогодателя
	               |ГДЕ
	               |	ЛБ_АнкетаЗалогодателя.Залогодатель = &Залогодатель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_АнкетаЗалогодателя.Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ДатаДок < Выборка.ДатаОформленияАнкеты Тогда
			ОбщегоНазначения.СообщитьПользователю("Анкета клиента оформлена " + Формат(Выборка.ДатаОформленияАнкеты, "ДФ=dd.MM.yyyy") + ". Выбор клиента на " + Формат(ДатаДок, "ДФ=dd.MM.yyyy; ДЛФ=DT") + " невозможен.");
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПолучитьДокументЗалогодателя(Залогодатель, Дата)
	
	СтруктураВозврата = Новый Структура("Серия, Номер, КемВыдан", "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.Период КАК Период,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец КАК Залогодатель,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан
		|ИЗ
		|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		СтруктураВозврата.Серия = РезультатЗапроса.ДокументСерия;
		СтруктураВозврата.Номер = РезультатЗапроса.ДокументНомер;
		СтруктураВозврата.КемВыдан = РезультатЗапроса.ДокументКемВыдан;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ЗалогодателиПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		СерияНомерДокумента = ПолучитьДокументЗалогодателя(Элемент.ТекущиеДанные.Залогодатель, ДатаДок);
		Серия = СерияНомерДокумента.Серия;
		Номер = СерияНомерДокумента.Номер;
		КемВыдан = СерияНомерДокумента.КемВыдан;
	Иначе
		Серия = "";
		Номер = "";
		КемВыдан = "";
	КонецЕсли;
КонецПроцедуры
