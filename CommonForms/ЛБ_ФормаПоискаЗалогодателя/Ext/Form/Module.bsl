&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Дата") Тогда 
		ДатаДок = Параметры.Дата; 
	Иначе
		ДатаДок = ТекущаяДата(); 
	КонецЕсли;
	Если Параметры.Свойство("Залогодатели") Тогда  
		Для Каждого СтрВыбранные Из Параметры.Залогодатели Цикл
			НоваяСтрока = ВыбранныеЗалогодатели.Добавить();
			НоваяСтрока.Залогодатель = СтрВыбранные.Залогодатель;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ФИООчистка(Элемент, СтандартнаяОбработка)
	Залогодатели.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ФИОИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 2 Тогда
		ФИО = Текст;
        НайтиВозможныеВариантыЗалогодатели();  
	ИначеЕсли СтрДлина(Текст) = 0 Тогда	 
		ФИО = Текст;
		Залогодатели.Очистить();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФИООкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 2 Тогда
		ФИО = Текст;
        НайтиВозможныеВариантыЗалогодатели(); 
	ИначеЕсли СтрДлина(Текст) = 0 Тогда	 
		ФИО = Текст;
		Залогодатели.Очистить();
    КонецЕсли;
КонецПроцедуры

