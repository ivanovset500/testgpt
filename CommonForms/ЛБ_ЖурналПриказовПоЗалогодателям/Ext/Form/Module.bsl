&НаСервере
Процедура ПолучитьДополнительныеРеквизиты(СтрокаПриказа) 
	ДокументОбъект = СтрокаПриказа.Ссылка.ПолучитьОбъект();
	//ЛБ_УправлениеЛомбардом.ЗаполнитьДополнительныеРеквизитыПриказа(ДокументОбъект); 
	ЗаполнитьДополнительныеРеквизитыПриказа(ДокументОбъект);
	ДокументОбъект.Записать();    
	
	СтрокаПриказа.Металлы = ДокументОбъект.ЕстьМеталлы;
	СтрокаПриказа.Вставки = ДокументОбъект.ЕстьВставки;
	СтрокаПриказа.ПроцентныеСтавки = ДокументОбъект.ЕстьПроцентныеСтавки;
	//СтрокаПриказа.АкцияСтавки = ДокументОбъект.ЕстьАкцииПроцентныеСтавки; 
	//СтрокаПриказа.АкцияМеталлы = ДокументОбъект.ЕстьАкцииМеталлы;
	СтрокаПриказа.КоличествоЗалогодателей = ДокументОбъект.КоличествоЗалогодателей; 
	СтрокаПриказа.БазоваяЦенаМеталлы = ДокументОбъект.БазоваяЦенаМеталлы;
	СтрокаПриказа.МаксимальнаяПроцентнаяСтавка = ДокументОбъект.МаксимальнаяПроцентнаяСтавка; 
 КонецПроцедуры	
	
&НаСервере
Процедура ЗаполнитьТаблицуПриказов(ИдентификаторСтроки = неопределено)    
	Запрос = Новый Запрос;
	//+МАН 30.07.25 Изменил запрос. Добавил поиск прикрепленных файлов
	//Запрос.Текст ="ВЫБРАТЬ
	//              |	ЛБ_ПриказИндивидуальныеУсловия.Ссылка КАК Ссылка,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.Номер КАК Номер,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.Дата КАК Дата,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.Ответственный КАК Ответственный,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.Комментарий КАК Комментарий,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.СтрокаЗалогодатели КАК СтрокаЗалогодатели,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ДатаОкончанияДействияПриказа КАК ДатаОкончанияДействияПриказа,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ВидОперации КАК ВидОперации,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ВидПриказа КАК ВидПриказа,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ДатаНачалаДействияПриказа КАК ДатаНачалаДействияПриказа,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.НомерПриказа КАК НомерПриказа,
	//			  |	ЛБ_ПриказИндивидуальныеУсловия.НомерСистемныйЧисло КАК СистемныйНомер,
	//              |	ВЫБОР
	//              |		КОГДА ЛБ_ПриказИндивидуальныеУсловия.ПометкаУдаления
	//              |			ТОГДА 2
	//              |		ИНАЧЕ ВЫБОР
	//              |				КОГДА ЛБ_ПриказИндивидуальныеУсловия.Проведен
	//              |					ТОГДА 1
	//              |				ИНАЧЕ 0
	//              |			КОНЕЦ
	//              |	КОНЕЦ КАК СостояниеДокумента,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ЕстьМеталлы КАК Металлы,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ЕстьВставки КАК Вставки,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.ЕстьПроцентныеСтавки КАК ПроцентныеСтавки,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.КоличествоЗалогодателей КАК КоличествоЗалогодателей,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.БазоваяЦенаМеталлы КАК БазоваяЦенаМеталлы,
	//              |	ЛБ_ПриказИндивидуальныеУсловия.МаксимальнаяПроцентнаяСтавка КАК МаксимальнаяПроцентнаяСтавка,
	//			  //+МАН 13.11.24 Заявка 2792
	//			  |	ЛБ_ПриказИндивидуальныеУсловия.ОтменяемыйПриказ.НомерПриказа КАК ОтменяемыйПриказНомерПриказа
	//			  //-МАН
	//              |ИЗ
	//              |	Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
	//              |ГДЕ
	//              |	ЛБ_ПриказИндивидуальныеУсловия.Дата МЕЖДУ &Дата1 И &Дата2";

	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ПриказИндивидуальныеУсловияПрисоединенныеФайлы.ВладелецФайла КАК ВладелецФайла
	              |ПОМЕСТИТЬ ВТ
	              |ИЗ
	              |	Справочник.ЛБ_ПриказИндивидуальныеУсловияПрисоединенныеФайлы КАК ЛБ_ПриказИндивидуальныеУсловияПрисоединенныеФайлы
	              |ГДЕ
	              |	ЛБ_ПриказИндивидуальныеУсловияПрисоединенныеФайлы.ВладелецФайла.Дата МЕЖДУ &Дата1 И &Дата2
	              |	И НЕ ЛБ_ПриказИндивидуальныеУсловияПрисоединенныеФайлы.ПометкаУдаления
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ЛБ_ПриказИндивидуальныеУсловияПрисоединенныеФайлы.ВладелецФайла
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ЛБ_ПриказИндивидуальныеУсловия.Ссылка КАК Ссылка,
	              |	ВЫБОР
	              |		КОГДА ВТ.ВладелецФайла ЕСТЬ NULL
	              |			ТОГДА ИСТИНА
	              |		ИНАЧЕ ЛОЖЬ
	              |	КОНЕЦ КАК ЕстьПрикрепленныйФайл,
	              |	ЛБ_ПриказИндивидуальныеУсловия.Номер КАК Номер,
	              |	ЛБ_ПриказИндивидуальныеУсловия.Дата КАК Дата,
	              |	ЛБ_ПриказИндивидуальныеУсловия.Ответственный КАК Ответственный,
	              |	ЛБ_ПриказИндивидуальныеУсловия.Комментарий КАК Комментарий,
	              |	ЛБ_ПриказИндивидуальныеУсловия.СтрокаЗалогодатели КАК СтрокаЗалогодатели,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ДатаОкончанияДействияПриказа КАК ДатаОкончанияДействияПриказа,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ВидОперации КАК ВидОперации,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ВидПриказа КАК ВидПриказа,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ДатаНачалаДействияПриказа КАК ДатаНачалаДействияПриказа,
	              |	ЛБ_ПриказИндивидуальныеУсловия.НомерПриказа КАК НомерПриказа,
	              |	ЛБ_ПриказИндивидуальныеУсловия.НомерСистемныйЧисло КАК СистемныйНомер,
	              |	ВЫБОР
	              |		КОГДА ЛБ_ПриказИндивидуальныеУсловия.ПометкаУдаления
	              |			ТОГДА 2
	              |		ИНАЧЕ ВЫБОР
	              |				КОГДА ЛБ_ПриказИндивидуальныеУсловия.Проведен
	              |					ТОГДА 1
	              |				ИНАЧЕ 0
	              |			КОНЕЦ
	              |	КОНЕЦ КАК СостояниеДокумента,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ЕстьМеталлы КАК Металлы,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ЕстьВставки КАК Вставки,
	              |	ЛБ_ПриказИндивидуальныеУсловия.ЕстьПроцентныеСтавки КАК ПроцентныеСтавки,
	              |	ЛБ_ПриказИндивидуальныеУсловия.КоличествоЗалогодателей КАК КоличествоЗалогодателей,
	              |	ЛБ_ПриказИндивидуальныеУсловия.БазоваяЦенаМеталлы КАК БазоваяЦенаМеталлы,
	              |	ЛБ_ПриказИндивидуальныеУсловия.МаксимальнаяПроцентнаяСтавка КАК МаксимальнаяПроцентнаяСтавка,
				  //+МАН 22.08.25
	              //|	ЛБ_ПриказИндивидуальныеУсловия.ОтменяемыйПриказ.НомерПриказа КАК ОтменяемыйПриказНомерПриказа
	              |	ЛБ_ПриказИндивидуальныеУсловия.ОтменяемыеПриказыСтрока КАК ОтменяемыйПриказНомерПриказа
				  //-МАН
	              |ИЗ
	              |	Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
	              |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	              |		ПО ЛБ_ПриказИндивидуальныеУсловия.Ссылка = ВТ.ВладелецФайла
	              |ГДЕ
	              |	ЛБ_ПриказИндивидуальныеУсловия.Дата МЕЖДУ &Дата1 И &Дата2";
				  
	Запрос.УстановитьПараметр("Дата1", ?(НачПериода = Дата(1,1,1), НачПериода, НачалоДня(НачПериода))); 
	Запрос.УстановитьПараметр("Дата2", ?(КонПериода = Дата(1,1,1), КонецДня(ТекущаяДата()), КонецДня(КонПериода)));
	
	Если ЗначениеЗаполнено(ПоискПоЗалогодателю) Тогда
		Запрос.Текст = Запрос.Текст + "
	              |	И ЛБ_ПриказИндивидуальныеУсловия.Залогодатели.Залогодатель = &Залогодатель";
		
		Запрос.УстановитьПараметр("Залогодатель", ПоискПоЗалогодателю);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ВыборНомерПриказа) Тогда
		Запрос.Текст = Запрос.Текст + "
	              |	И ЛБ_ПриказИндивидуальныеУсловия.НомерПриказа ПОДОБНО &НомерПриказа";
		
		Запрос.УстановитьПараметр("НомерПриказа", СокрЛП(ВыборНомерПриказа) + "%");
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + "
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Дата УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаПриказов.Загрузить(ТаблицаЗапроса); 
	
	Если ТаблицаПриказов.Количество() <> 0 Тогда
		Если ИдентификаторСтроки = Неопределено Тогда
			//КолСтр = ТаблицаПриказов.Количество();
			СтрокаТЗ = ТаблицаПриказов[0];
			ИдентификаторСтроки = СтрокаТЗ.ПолучитьИдентификатор();
		КонецЕсли;	
		Элементы.ТаблицаПриказов.ТекущаяСтрока = ИдентификаторСтроки;
		//+МАН 30.07.25 Изменил т.к. все время переходил на первую строку.
		ДокументОбъект = ТаблицаПриказов[0].Ссылка.ПолучитьОбъект();
		//ТекСтр = ТаблицаПриказов.НайтиПоИдентификатору(ИдентификаторСтроки);
		//ДокументОбъект = ТекСтр.Ссылка.ПолучитьОбъект();
		//-МАН
		ЗначениеВРеквизитФормы(ДокументОбъект, "ТекущийПриказ");
		//+Мельников 26.09.24 Заявка 2792
		Комментарий = ДокументОбъект.Комментарий;
		//-
		Если ДокументОбъект.Проведен Тогда 
			//Элементы.СтрокаЛомбарды.ТолькоПросмотр = Истина;
			Элементы.СтрокаСК.ТолькоПросмотр = Истина;
			//Элементы.Акция.ТолькоПросмотр = Истина;
		Иначе
			//Элементы.СтрокаЛомбарды.ТолькоПросмотр = Ложь;
			Элементы.СтрокаСК.ТолькоПросмотр = Ложь;
			//Элементы.Акция.ТолькоПросмотр = Ложь; 
		КонецЕсли;	
	КонецЕсли;	
		
КонецПроцедуры  

&НаСервере 
Процедура ЗаполнитьВыборЕдиницИзмеренияВставки()
	ТаблицаЕдиницИзмерения = ЛБ_ОбщийМодуль.ВыборЕдиницИзмеренияРасчетаЦенКамней();
	Элементы.ЦеныВставкиЕдиницаИзмерения.СписокВыбора.Очистить();		
	Для каждого Стр Из ТаблицаЕдиницИзмерения Цикл
		Элементы.ЦеныВставкиЕдиницаИзмерения.СписокВыбора.Добавить(Стр.ЕдиницаИзмерения);
	КонецЦикла;
КонецПроцедуры

