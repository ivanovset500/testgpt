&НаСервере
Функция ПроверитьОтменуВДругихДокументах(Залогодатель, Дата, Ссылка, Ставки = Ложь, Металлы = Ложь, Вставки = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ПриказИндивидуальныеУсловия.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
		|ГДЕ
		|	НЕ ЛБ_ПриказИндивидуальныеУсловия.ПометкаУдаления
		|	И ЛБ_ПриказИндивидуальныеУсловия.Проведен
		|	И ЛБ_ПриказИндивидуальныеУсловия.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
		|	И ЛБ_ПриказИндивидуальныеУсловия.Залогодатели.Залогодатель = &Залогодатель
		|	И 100 = 100
		|	И ЛБ_ПриказИндивидуальныеУсловия.ДатаНачалаДействияПриказа < &Дата
		|	И ЛБ_ПриказИндивидуальныеУсловия.ОтменяемыйПриказ = &ОтменяемыйПриказ";
	
	Если Ставки Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", "ЛБ_ПриказИндивидуальныеУсловия.Залогодатели.НетСтавок = &Ставки");
		Запрос.УстановитьПараметр("Ставки", Ставки);
	ИначеЕсли Металлы Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", "ЛБ_ПриказИндивидуальныеУсловия.Залогодатели.НетМеталлов = &Металлы");
		Запрос.УстановитьПараметр("Металлы", Металлы);
	ИначеЕсли Вставки Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", "ЛБ_ПриказИндивидуальныеУсловия.Залогодатели.НетВставок = &Вставки");
		Запрос.УстановитьПараметр("Вставки", Вставки);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("ОтменяемыйПриказ", Ссылка);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ТекущийПриказНачальникОтделенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ТекущийПриказ.Отделение) Тогда
		Предупреждение("Не выбрано отдеделение");
		Возврат;
	Иначе
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораСотрудника", ЭтаФорма);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МассивСотрудников", НайтиНачальникаОтделения(ТекущийПриказ.Отделение, НачалоДня(ТекущийПриказ.Дата)));
		
		ОткрытьФорму("Справочник.ЛБ_Сотрудники.Форма.ФормаВыбораСотрудников",ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекущийПриказОтделениеПриИзменении(Элемент)
	ЗаписатьРеквизит("Отделение", ТекущийПриказ.Отделение);
	
	Если ЗначениеЗаполнено(ТекущийПриказ.НачальникОтделения) Тогда
		ЗаписатьРеквизит("НачальникОтделения", ПредопределенноеЗначение("Справочник.ЛБ_Сотрудники.ПустаяСсылка"));
		ОбновитьСтрокуПриказа();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиНачальникаОтделения(Отделение, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(
		|			&Дата,
		|			ВЫБОР
		|					КОГДА Подразделение = ЗНАЧЕНИЕ(Справочник.ЛБ_Ломбарды.ЦентральныйОфис)
		|						ТОГДА ИСТИНА
		|					КОГДА Подразделение В
		|							(ВЫБРАТЬ
		|								ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|							ИЗ
		|								РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Отделение = &Отделение) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|							ГДЕ
		|								НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт)
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|				И НЕ Сотрудник.ПометкаУдаления) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
		|ГДЕ
		|	НЕ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность В
		|				(ВЫБРАТЬ
		|					ЛБ_ДолжностиДляИнвентаризационнойКомиссии.Должность КАК Должность
		|				ИЗ
		|					РегистрСведений.ЛБ_ДолжностиДляИнвентаризационнойКомиссии КАК ЛБ_ДолжностиДляИнвентаризационнойКомиссии)
		|	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыКадровыхСобытий.Увольнение)
		|	И ВЫБОР
		|			КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяНачальникомОтделения
		|				ТОГДА ИСТИНА
		|			КОГДА ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяЗаместителемНачальникаОтделения
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.Наименование";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Отделение", Отделение);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	МассивВозврата = Новый Массив;
	
	Пока Результат.Следующий() Цикл
		МассивВозврата.Добавить(Результат.Сотрудник);
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСотрудника(Результат, ДопПараметры) Экспорт
	ЗаписатьРеквизит("НачальникОтделения", Результат);
	ОбновитьСтрокуПриказа();
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайл(Команда)
	
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда  
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВладелецФайла",  ТекСтрока.Ссылка);
		ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Ссылка", ТекСтрока.Ссылка);

		ОбработкаПрикрепления = Новый ОписаниеОповещения("ПослеПрикрепленияФайла", ЭтаФорма, ДопПараметры);
		
		ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы", ПараметрыФормы, ЭтаФорма,,,, ОбработкаПрикрепления, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура ПослеПрикрепленияФайла(Результат, ДопПараметры) Экспорт
	ЗаполнитьТаблицуПриказов();
		
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", ДопПараметры.Ссылка);
	
	мСтр = ТаблицаПриказов.НайтиСтроки(Отбор);
	ИндексСтр = ТаблицаПриказов.Индекс(мСтр[0]);
	
	ИдентификаторСтр = ТаблицаПриказов[ИндексСтр].ПолучитьИдентификатор();

	Элементы.ТаблицаПриказов.ТекущаяСтрока = ИдентификаторСтр;
	ДокументОбъект = ТаблицаПриказов[ИндексСтр].Ссылка.ПолучитьОбъект();
	ЗначениеВРеквизитФормы(ДокументОбъект, "ТекущийПриказ");
КонецПроцедуры

&НаКлиенте
Процедура ЗБПоПриказу(Команда)
	
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		ДанныеДокумента = ВернутьПроведениеДокумента(ТекСтрока.Ссылка);
		
		Если НЕ ДанныеДокумента.Проведен Тогда
			Предупреждение("Приказ не введен в действие!
						   |Невозможно сформировать отчет.");
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ДатаНач", ТекСтрока.Дата);
		ПараметрыФормы.Вставить("ДатаКон", ?(ТекСтрока.ДатаОкончанияДействияПриказа > ТекущаяДата(), ТекСтрока.ДатаОкончанияДействияПриказа, ТекущаяДата()));
		ПараметрыФормы.Вставить("Ссылка", ДанныеДокумента.Ссылка);
								
		ОткрытьФорму("Отчет.ЛБ_ЗалоговыеБилетыПоДоговоруВИП.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	 

КонецПроцедуры

&НаСервере
Функция ВернутьПроведениеДокумента(Ссылка);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Проведен", Ссылка.Проведен);
	СтруктураВозврата.Вставить("Ссылка", Ссылка);
	
	Возврат СтруктураВозврата;
КонецФункции

