&НаКлиенте
Процедура ТекущийПриказДатаОкончанияДействияПриказаПриИзменении(Элемент)
	Если ТекущийПриказ.ДатаНачалаДействияПриказа > ТекущийПриказ.ДатаОкончанияДействияПриказа Тогда
		Предупреждение("Дата окончания действия приказа не может быть меньше даты начала действия приказа!");
		ТекущийПриказ.ДатаОкончанияДействияПриказа = Дата(1,1,1);
		Возврат;
	Иначе
		ЗаписатьРеквизит("ДатаОкончанияДействияПриказа", ТекущийПриказ.ДатаОкончанияДействияПриказа);
		ОбновитьСтрокуПриказа();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокуПриказа()
	ТекСтрокаПриказы = Элементы.ТаблицаПриказов.ТекущиеДанные;
	ИдентификаторСтроки = ТекСтрокаПриказы.ПолучитьИдентификатор();
		
	ТекСтрокаПриказы.НомерПриказа = ТекущийПриказ.НомерПриказа;
	ТекСтрокаПриказы.Дата = ТекущийПриказ.Дата;
	ТекСтрокаПриказы.ДатаНачалаДействияПриказа = ТекущийПриказ.ДатаНачалаДействияПриказа;
	ТекСтрокаПриказы.ДатаОкончанияДействияПриказа = ТекущийПриказ.ДатаОкончанияДействияПриказа;
	ПолучитьОбъектПриказа(ИдентификаторСтроки);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПечати();
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Элемент",, "Элемент");
	ТЗ.Колонки.Добавить("Должность",, "Должность");
	
	НоваяСтр = ТЗ.Добавить();
	НоваяСтр.Элемент = "ТекущийПриказНачальникОРБ";
	НоваяСтр.Должность = "Начальник отдела развития бизнеса";

	НоваяСтр = ТЗ.Добавить();
	НоваяСтр.Элемент = "ТекущийПриказОтветственноеЛицоОРБ";
	НоваяСтр.Должность = "Маркетолог-аналитик";
	
	НоваяСтр = ТЗ.Добавить();
	НоваяСтр.Элемент = "ТекущийПриказНачальникОДО";
	НоваяСтр.Должность = "Начальник отдела документационного обеспечения";

	//НоваяСтр = ТЗ.Добавить();
	//НоваяСтр.Элемент = "ТекущийПриказОтветственноеЛицоРеклама";
	//НоваяСтр.Должность = "Менеджер по рекламе";

	НоваяСтр = ТЗ.Добавить();
	НоваяСтр.Элемент = "ТекущийПриказПодписантФИО";
	НоваяСтр.Должность = "Директор";

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
		|ГДЕ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность = &Должность
		|	И НЕ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыКадровыхСобытий.Увольнение)";
	
	Для каждого Стр Из ТЗ Цикл
		
		Если Стр.Элемент = "ТекущийПриказПодписантФИО" Тогда
			Элементы[Стр.Элемент].СписокВыбора.Очистить();
			Элементы[Стр.Элемент].СписокВыбора.Добавить(Справочники.ЛБ_Сотрудники.НайтиПоКоду("ЛКЗК-02501"));
			Элементы[Стр.Элемент].СписокВыбора.Добавить(Справочники.ЛБ_Сотрудники.НайтиПоКоду("000001599"));
		Иначе
			Элементы[Стр.Элемент].СписокВыбора.Очистить();
			
			Должность = Справочники.Должности.НайтиПоНаименованию(Стр.Должность, Истина);
			
			Запрос.УстановитьПараметр("Должность", Должность);
			
			Результат = Запрос.Выполнить().Выбрать();
			
			Пока Результат.Следующий() Цикл
				Элементы[Стр.Элемент].СписокВыбора.Добавить(Результат.Сотрудник);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСК(ДокументОбъект)
	
	Если ДокументОбъект.СхемыКредитования.Количество() = 0 Тогда
		ДокументОбъект.СтавкиПроцентов.Очистить();
		ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Очистить();
		ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
	Иначе
		МассивСК = Новый Массив;
		
		Для каждого Стр Из ДокументОбъект.СхемыКредитования Цикл
			МассивСК.Добавить(Стр.СхемаКредитования);
		КонецЦикла;
		
		//Процентные ставки
		Если ДокументОбъект.СтавкиПроцентов.Количество() > 0 Тогда
			ТЗСтавки = ДокументОбъект.СтавкиПроцентов.Выгрузить();
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВнешнийИсточник.СхемаКредитования КАК СхемаКредитования,
			|	ВнешнийИсточник.ДиапазонСумм КАК ДиапазонСумм,
			|	ВнешнийИсточник.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
			|	ВнешнийИсточник.Ставка КАК Ставка
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	&ВнешнийИсточник КАК ВнешнийИсточник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.СхемаКредитования КАК СхемаКредитования,
			|	ВТ.ДиапазонСумм КАК ДиапазонСумм,
			|	ВТ.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
			|	ВТ.Ставка КАК Ставка
			|ИЗ
			|	ВТ КАК ВТ
			|ГДЕ
			|	ВТ.СхемаКредитования В(&СхемаКредитования)";
			
			Запрос.УстановитьПараметр("СхемаКредитования", МассивСК);
			Запрос.УстановитьПараметр("ВнешнийИсточник", ТЗСтавки);
			
			Результат = Запрос.Выполнить().Выгрузить();
			
			Если Результат.Количество() > 0 Тогда
				ДокументОбъект.СтавкиПроцентов.Очистить();
				
				Для каждого Стр Из Результат Цикл
					НоваяСтр = ДокументОбъект.СтавкиПроцентов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				КонецЦикла;
			Иначе
				ДокументОбъект.СтавкиПроцентов.Очистить();
			КонецЕсли;
		КонецЕсли;
		
		//Вставки
		Если ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0 Тогда
			ТЗВставки = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Выгрузить();
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВнешнийИсточник.ВидВставки КАК ВидВставки,
			|	ВнешнийИсточник.ВидОгранки КАК ВидОгранки,
			|	ВнешнийИсточник.КачествоОгранки КАК КачествоОгранки,
			|	ВнешнийИсточник.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
			|	ВнешнийИсточник.ЗначениеОтклонения КАК ЗначениеОтклонения,
			|	ВнешнийИсточник.СхемаКредитования КАК СхемаКредитования
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	&ВнешнийИсточник КАК ВнешнийИсточник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.ВидВставки КАК ВидВставки,
			|	ВТ.ВидОгранки КАК ВидОгранки,
			|	ВТ.КачествоОгранки КАК КачествоОгранки,
			|	ВТ.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
			|	ВТ.ЗначениеОтклонения КАК ЗначениеОтклонения,
			|	ВТ.СхемаКредитования КАК СхемаКредитования
			|ИЗ
			|	ВТ КАК ВТ
			|ГДЕ
			|	ВТ.СхемаКредитования В(&СхемаКредитования)";
			
			Запрос.УстановитьПараметр("СхемаКредитования", МассивСК);
			Запрос.УстановитьПараметр("ВнешнийИсточник", ТЗВставки);
			
			Результат = Запрос.Выполнить().Выгрузить();
			
			Если Результат.Количество() > 0 Тогда
				ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Очистить();
				
				Для каждого Стр Из Результат Цикл
					НоваяСтр = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				КонецЦикла;
			Иначе
				ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Очистить();
			КонецЕсли;
		КонецЕсли;
		
		//Металлы
		Если ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0 Тогда
			ТЗМеталлы = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить();
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВнешнийИсточник.КатегорияОбъектаЗалога КАК КатегорияОбъектаЗалога,
			|	ВнешнийИсточник.СхемаКредитования КАК СхемаКредитования,
			|	ВнешнийИсточник.Металл КАК Металл,
			|	ВнешнийИсточник.Проба КАК Проба,
			|	ВнешнийИсточник.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
			|	ВнешнийИсточник.ЗначениеОтклонения КАК ЗначениеОтклонения
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	&ВнешнийИсточник КАК ВнешнийИсточник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.КатегорияОбъектаЗалога КАК КатегорияОбъектаЗалога,
			|	ВТ.СхемаКредитования КАК СхемаКредитования,
			|	ВТ.Металл КАК Металл,
			|	ВТ.Проба КАК Проба,
			|	ВТ.ОтклонениеОтБазовойЦены КАК ОтклонениеОтБазовойЦены,
			|	ВТ.ЗначениеОтклонения КАК ЗначениеОтклонения
			|ИЗ
			|	ВТ КАК ВТ
			|ГДЕ
			|	ВТ.СхемаКредитования В(&СхемаКредитования)";
			
			Запрос.УстановитьПараметр("СхемаКредитования", МассивСК);
			Запрос.УстановитьПараметр("ВнешнийИсточник", ТЗМеталлы);
			
			Результат = Запрос.Выполнить().Выгрузить();
			
			Если Результат.Количество() > 0 Тогда
				ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
				
				Для каждого Стр Из Результат Цикл
					НоваяСтр = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				КонецЦикла;
			Иначе
				ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьСК(Ссылка)
	
	СтруктураВозврата = Новый Структура("СК");
	Отбор = Новый Структура;
	
	Для каждого СтрСК Из Ссылка.СхемыКредитования Цикл
		Отбор.Вставить("СхемаКредитования", СтрСК.СхемаКредитования);
		
		МассивС = Ссылка.СтавкиПроцентов.НайтиСтроки(Отбор);
		МассивВ = Ссылка.НастройкаОтклоненийОтБазовыхЦенВставки.НайтиСтроки(Отбор);
		МассивМ = Ссылка.НастройкаОтклоненийОтБазовыхЦенМеталлы.НайтиСтроки(Отбор);
		
		Кол = 0;
		
		Для каждого СтрС Из МассивС Цикл
			Если СтрС.Ставка = 0 Тогда
				Кол = Кол + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если МассивС.Количество() = Кол И МассивВ.Количество() = 0 И МассивМ.Количество() = 0 Тогда
			СтруктураВозврата.СК = СтрСК.СхемаКредитования;
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеСотрудников(Ссылка)
	
	Если НЕ ЗначениеЗаполнено(Ссылка.НачальникОРБ) ИЛИ НЕ ЗначениеЗаполнено(Ссылка.НачальникОДО)
		ИЛИ НЕ ЗначениеЗаполнено(Ссылка.ОтветственноеЛицоОРБ) //ИЛИ НЕ ЗначениеЗаполнено(Ссылка.ОтветственноеЛицоРеклама)
		ИЛИ НЕ ЗначениеЗаполнено(Ссылка.ПодписантФИО)
		//+МАН 04.07.25
		ИЛИ НЕ ЗначениеЗаполнено(Ссылка.Отделение) ИЛИ НЕ ЗначениеЗаполнено(Ссылка.НачальникОтделения)
		ИЛИ Ссылка.ОснованиеПриказа = "" Тогда
		//-МАН
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

