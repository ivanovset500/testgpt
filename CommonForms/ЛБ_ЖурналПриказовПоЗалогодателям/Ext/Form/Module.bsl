&НаКлиенте
Функция ПередОтменитьПроведение(ОтменаПроведения = Ложь, Удаление = Ложь)
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		ЕстьДокументы = ПроверитьНаличиеДокументов(ТекСтрока.Ссылка);
		
		Если ЕстьДокументы Тогда
			Предупреждение(?(ОтменаПроведения, "Отмена проведения приказа невозможна", "Удаление приказа невозможно") + ", есть последующие операции или приказы!");
			Возврат Ложь;
		Иначе
			//+МАН 20.03.25
			//Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП")
			//	И ТекущаяДата() > ТекСтрока.Дата + 86400 Тогда
			Если ТекущаяДата() > ТекСтрока.Дата + 86400 Тогда
				
				Предупреждение(?(ОтменаПроведения, "Отмена проведения приказа невозможна", "Удаление приказа невозможно") + ", прошло больше суток с момента проведения документа!");
				Возврат Ложь;
			КонецЕсли;
			//-МАН
			
			ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();		
			РаспровестиДокументСервере(ИдентификаторСтроки); 
			ПолучитьОбъектПриказа(ИдентификаторСтроки);
		КонецЕсли;
		
		Возврат Истина;
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура ПечатьПриказа(Команда)
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда   

		РезультатПроверкиЗаполненияСотрудников = ПроверитьЗаполнениеСотрудников(ТекСтрока.Ссылка);
		Если РезультатПроверкиЗаполненияСотрудников Тогда
			Сообщить("Выбраны не все сотрудники в параметрах печати!");
			Возврат;
		КонецЕсли;
		
		//+МАН 09.10.25 Дабавлена проверка на наличие контактной информации
		ЕстьДанныеЗалогодателя = ПроверитьНаличиеДанныхЗалогодателей(ТекСтрока.Ссылка);
		Если НЕ ЕстьДанныеЗалогодателя Тогда
			Возврат;
		КонецЕсли;
		//-МАН
		
		Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП") Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "ПриказУстановкиВИП"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриказИндивидуальныеУсловия");
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекСтрока.Ссылка);
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
		Иначе     
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИменаМакетов", "ПриказОтмены"); 
			ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриказИндивидуальныеУсловия");
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ТекСтрока.Ссылка);
			ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
		КонецЕсли;	
    КонецЕсли;
КонецПроцедуры  

&НаСервере 
Функция ПроверитьНаличиеДанныхЗалогодателей(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель КАК Залогодатель,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
		|	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.Период КАК Период,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК Серия,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК Номер,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК КемВыдан,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК КодПодразделения,
		|	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК СрокДействия
		|ИЗ
		|	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, ) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
		|		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
	Запрос.УстановитьПараметр("Дата", НачалоДня(Ссылка.Дата));
	
	Текст = "";
	Для каждого СтрЗ Из Ссылка.Залогодатели Цикл
		Запрос.УстановитьПараметр("Залогодатель", СтрЗ.Залогодатель);
			
		Результат = Запрос.Выполнить().Выбрать();
		
		Если НЕ Результат.Следующий() Тогда
			Текст = ?(Текст = "", "", Текст + Символы.ПС);
			Текст = Текст + "У залогодателя " + СтрЗ.Залогодатель + " не корректно заполнена карточка.";
		КонецЕсли;
	КонецЦикла;
	
	Если Текст <> "" Тогда
		Сообщить(Текст);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере 
Функция ПолучитьСписокСК() 
	СК = Новый СписокЗначений;
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СхемыКредитования.Ссылка КАК СхемаКредитования
	               |ИЗ
	               |	Справочник.ЛБ_СхемыКредитования КАК ЛБ_СхемыКредитования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, ) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних
	               |		ПО (ЛБ_УсловияПредоставленияКредитаСрезПоследних.СхемаКредитования = ЛБ_СхемыКредитования.Ссылка)
	               |ГДЕ
	               |	ЛБ_СхемыКредитования.ПометкаУдаления = ЛОЖЬ";
				   //|	И ЛБ_УсловияПредоставленияКредитаСрезПоследних.НеАктуальная = ЛОЖЬ";
	ТЗ = Запрос.Выполнить().Выгрузить();     
	Массив = ТЗ.ВыгрузитьКолонку("СхемаКредитования");//выгружаем таблицу значений в массив
    СК.ЗагрузитьЗначения(Массив);//загружаем массив в список значений  
	
	Возврат СК;
КонецФункции	

