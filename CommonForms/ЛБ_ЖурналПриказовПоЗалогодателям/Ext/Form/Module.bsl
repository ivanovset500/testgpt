&НаСервере
Процедура ЗаполнитьЦеныМеталловПоСценариюНаСервере(ТаблицаБазовыхЦен) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);	
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
	ДокументОбъект.ЦеныМеталлы.Очистить(); 
	ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
	ТаблицаЦен = ДокументОбъект.ЦеныМеталлы.Выгрузить();     
	
	//Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("Дата", ДатаДок);
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	//               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.Металл КАК Металл,
	//               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.ПроцентОтклонения КАК ПроцентОтклонения,
	//               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.УстанавливатьОтклонение КАК УстанавливатьОтклонение
	//               |ИЗ
	//               |	РегистрСведений.ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлы.СрезПоследних(&Дата, ) КАК ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних";
	//ТаблицаНастроек = Запрос.Выполнить().Выгрузить(); 
	//ТаблицаСК = ТаблицаНастроек.Скопировать(); 
	//ТаблицаСК.Свернуть("СхемаКредитования");
	
	//заполним таблицу цен по сценарию
	Для каждого Стр Из ДокументОбъект.СценарийОценкиМеталлов.БазовыеНастройки Цикл  
		БазоваяЦена = 0;
		ОтборЦен = Новый структура;
		ОтборЦен.Вставить("БазоваяПроба", Стр.БазоваяПроба); 
		ОтборЦен.Вставить("БазоваяКатегория", Стр.БазоваяКатегория);
		
		СтрокиЦен = ТаблицаБазовыхЦен.НайтиСтроки(ОтборЦен);
		Если НЕ СтрокиЦен.Количество() = 0 Тогда 
			БазоваяЦена = СтрокиЦен[0].БазоваяЦена;
		КонецЕсли;	
		
