	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеРедактированияВставок",ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ЗаполнениеЦенВставокИзПриказа", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
