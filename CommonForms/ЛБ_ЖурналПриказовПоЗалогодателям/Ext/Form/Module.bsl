Процедура СтрокаСКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	//СК = ВыбратьСК();  
    //ОповещениеПослеОтметкиЭлементов = Новый ОписаниеОповещения("ПослеОтметкиЭлементовСК", ЭтаФорма);	
    //СК.ПоказатьОтметкуЭлементов(ОповещениеПослеОтметкиЭлементов, "Выберите схемы кредитования");  
	ПараметрыФормы = новый структура;
	ПараметрыФормы.Вставить("Приказ", ТекущийПриказ.Ссылка); 
	ОповещениеПослеВыборка = Новый ОписаниеОповещения("ПослеВыбораСК", ЭтаФорма); 
	ОткрытьФорму("Документ.ЛБ_ПриказИндивидуальныеУсловия.Форма.ФормаВыбораСхемКредитования", ПараметрыФормы, Этаформа,,,,ОповещениеПослеВыборка,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры 

&НаСервере
Процедура ОбработкаВыбораСК()
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
	
	//+МАН 04.03.25
	УдалитьСК(ДокументОбъект);
	
	//Добавил усолвие
	Если ДокументОбъект.СтавкиПроцентов.Количество() = 0 Тогда
		ДокументОбъект.СтавкиПроцентов.Очистить(); 
	КонецЕсли;
	//-МАН
	
	Для Каждого Стр Из ДокументОбъект.СхемыКредитования Цикл
		ШаблонПриказа = стр.ШаблонПроцентныеСтавки;
		Если ЗначениеЗаполнено(ШаблонПриказа) Тогда 
			
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", Стр.СхемаКредитования);
							
			Для каждого СтрШ Из ШаблонПриказа.СтавкиПроцентов Цикл 
				Отбор.Вставить("ДиапазонСумм", СтрШ.ДиапазонСумм);
				
				МассивСтрок = ДокументОбъект.СтавкиПроцентов.НайтиСтроки(Отбор);
				Если МассивСтрок.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрП = ДокументОбъект.СтавкиПроцентов.Добавить();
				НоваяСтрП.СхемаКредитования = Стр.СхемаКредитования;
				//НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
				//НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
				НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;
				//НоваяСтрП.ДеньНачалаПрименения = СтрШ.ДеньНачалаПрименения;
				НоваяСтрП.Ставка = 0;
			Конеццикла;	
		Иначе
			Сообщить("Для кредитной схемы " + СокрЛП(Стр.СхемаКредитования) + " не установлен шаблон процентных ставок!");					
		КонецЕсли;	
	КонецЦикла; 
	ЗаполнитьСписокСК(ДокументОбъект);
    ДокументОбъект.Записать();          
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
    ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
	СхемыКредитования.Загрузить(ТекущийПриказ.СхемыКредитования.Выгрузить());
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор); 		   
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВыбораСК(Результат, ДопПараметры) Экспорт   
	Если НЕ Результат = неопределено Тогда 
		ОбработкаВыбораСК();
		Для каждого СтрК Из ТекущийПриказ.СхемыКредитования Цикл
			//+Мельников Убрать
			//Если НЕ ЗначениеЗаполнено(СтрК.Ломбард) Тогда
			//	Продолжить;
			//КонецЕсли;
			//-Мельников
			ПроставитьПроцентныеСтавкиПоТекущимНастройкам(СтрК.СхемаКредитования, СтрК.Ломбард); 
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСК(ДокументОбъект)  
	Результат = "";
	Для каждого Стр Из ДокументОбъект.СхемыКредитования Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + СокрЛП(Стр.СхемаКредитования.Наименование);
	КонецЦикла;	
	ДокументОбъект.СтрокаСхемыКредитования = Результат;
КонецПроцедуры	

