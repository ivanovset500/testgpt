	СписокЛ = Новый СписокЗначений; 
	СписокЛ.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка());
	Для каждого Стр Из ТекущийПриказ.Ломбарды цикл 
		СписокЛ.Добавить(Стр.Ломбард);
	Конеццикла;	
	Возврат ЛБ_ОбщийМодуль.ПолучитьТекущийШаблон(ДатаДок, ВидПрейскуранта, СписокЛ);
КонецФункции

&НаСервере
Функция ПолучитьТекущийШаблонАкция(ВидПрейскуранта)
	Возврат ЛБ_ОбщийМодуль.ПолучитьТекущийШаблонАкция(ДатаДок, Перечисления.ЛБ_ВидыПрейскурантов.Металлы, );
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьЦеныМеталловПоНастройкам(Команда)
	ШаблонПриказа = ПолучитьТекущийШаблон(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПрейскурантов.Металлы"));  
	Если НЕ ШаблонПриказа = неопределено Тогда 
		ЗаполнитьЦеныМеталловПоНастройкамНаСервере(ШаблонПриказа);  
		ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
		ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		ПолучитьОбъектПриказа(ИдентификаторСтроки);
		Если НЕ ТекущийПриказ.Ломбарды.Количество() = 0 Тогда 
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("Заполнить цены металлов по текущим данным в ломбарде?", Режим, 0);
			Если Ответ = КодВозвратаДиалога.Да Тогда									
				Если ТекущийПриказ.Ломбарды.Количество() = 1 Тогда
					ПроставитьМеталлыПоТекущимНастройкам(ТекущийПриказ.Ломбарды.Получить(0).Ломбард); 
				Иначе
					ПараметрыФормы = Новый Структура;
				    ПараметрыФормы.Вставить("Приказ", ТекущийПриказ.Ссылка); 
					
					ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЛомбардаМеталлы", ЭтаФорма);
					ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборЛомбардаИзПриказа", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
				КонецЕсли;
				ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
				ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
				ПолучитьОбъектПриказа(ИдентификаторСтроки);
			КонецЕсли;	
		КонецЕсли;
	Иначе  
		Сообщить("Не установлен шаблон цен металлов!");
	КонецЕсли;			    
КонецПроцедуры   

&НаКлиенте
Процедура ЗаполнитьЦеныМеталловПоШаблону(Команда) 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора",Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор",Ложь); 

	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораШаблонаМеталлов", ЭтаФорма);

	ОткрытьФорму("Справочник.ЛБ_ШаблоныПриказовМеталлы.ФормаВыбора",ПараметрыФормы,
	        ЭтаФорма, , , , ОбработкаВыбора);
КонецПроцедуры  
		
&НаКлиенте
Процедура ПриЗакрытииФормыВыбораШаблонаМеталлов(Значение, ДопПараметры) Экспорт

	Если Значение = Неопределено Тогда  
		Возврат;
    КонецЕсли;
     
    ШаблонПриказа  = Значение;  
    ЗаполнитьЦеныМеталловПоНастройкамНаСервере(ШаблонПриказа);  
    ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
    ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
    ПолучитьОбъектПриказа(ИдентификаторСтроки);
    Если НЕ ТекущийПриказ.Ломбарды.Количество() = 0 Тогда 
	    Режим = РежимДиалогаВопрос.ДаНет;
	    Ответ = Вопрос("Заполнить цены металлов по текущим данным в ломбарде?", Режим, 0);
	    Если Ответ = КодВозвратаДиалога.Да Тогда									
		    Если ТекущийПриказ.Ломбарды.Количество() = 1 Тогда
		        ПроставитьМеталлыПоТекущимНастройкам(ТекущийПриказ.Ломбарды.Получить(0).Ломбард); 
		    Иначе
		        ПараметрыФормы = Новый Структура;
			    ПараметрыФормы.Вставить("Приказ", ТекущийПриказ.Ссылка); 
				
			    ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЛомбардаМеталлы", ЭтаФорма);
		  	    ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборЛомбардаИзПриказа", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		    КонецЕсли;
		    ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
		    ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		    ПолучитьОбъектПриказа(ИдентификаторСтроки);
	    КонецЕсли;	
    КонецЕсли;
КонецПроцедуры		
		
&НаКлиенте
Процедура ПослеВыбораЛомбардаМеталлы(Результат, ДопПараметры) Экспорт 
	Если Результат = неопределено Тогда
	   Возврат; 	
	КонецЕсли;
	ПроставитьМеталлыПоТекущимНастройкам(Результат);
КонецПроцедуры	

&НаСервере
Процедура ПроставитьМеталлыПоТекущимНастройкам(Ломбард) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба.Владелец КАК Металл,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Проба КАК Проба,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Категория КАК КатегорияОбъектаЗалога,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Цена КАК Цена,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(
	               |			&Дата,
	               |			Ломбард = &Ломбард
	               |				И ДатаНачалаДействия < &Дата) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Металл,
	               |	Проба,
	               |	КатегорияОбъектаЗалога";
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();   
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.Металл КАК Металл,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.ПроцентОтклонения КАК ПроцентОтклонения,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.УстанавливатьОтклонение КАК УстанавливатьОтклонение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлы.СрезПоследних(&Дата, ) КАК ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних";
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить(); 
	ТаблицаСК = ТаблицаНастроек.Скопировать(); 
	ТаблицаСК.Свернуть("СхемаКредитования");

	Если НЕ ТаблицаЦен.Количество() = 0 тогда     
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
		ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
		ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
		
		Для каждого Стр Из ДокументОбъект.ЦеныМеталлы Цикл
			Отбор = новый Структура;
			Отбор.Вставить("Металл", Стр.Металл);
			Отбор.Вставить("Проба", Стр.Проба);
			Отбор.Вставить("КатегорияОбъектаЗалога", Стр.КатегорияОбъектаЗалога);
			 
			СтрокиЦен = ТаблицаЦен.НайтиСтроки(Отбор);
			Если НЕ СтрокиЦен.Количество() = 0 Тогда
				СтрЦ = СтрокиЦен.Получить(0);
				Стр.Цена = СтрЦ.Цена;
			КонецЕсли;	 
			
			Если НЕ ТаблицаСК.Количество() = 0 тогда
				Для каждого СтрК Из ТаблицаСК Цикл
					ОтборН = новый Структура;
					ОтборН.Вставить("СхемаКредитования", СтрК.СхемаКредитования);	
					ОтборН.Вставить("Металл", Стр.Металл);
					СтрокиН = ТаблицаНастроек.НайтиСтроки(ОтборН); 
					Если СтрокиН.Количество() = 0 Тогда 
						ОтборН.Вставить("Металл", Справочники.ЛБ_ДрагоценныеМеталлы.ПустаяСсылка()); 
						СтрокиН = ТаблицаНастроек.НайтиСтроки(ОтборН); 
					КонецЕсли;	
					Если СтрокиН.Количество() = 0 Тогда
						НоваяСтрН = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Добавить();
						НоваяСтрН.СхемаКредитования = СтрК.СхемаКредитования; 
						НоваяСтрН.Металл = Стр.Металл;
		                НоваяСтрН.Проба = Стр.Проба;
		                НоваяСтрН.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога;
                    Иначе 
						Для каждого СтрН Из СтрокиН Цикл  
							НоваяСтрН = ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Добавить();
							НоваяСтрН.СхемаКредитования = СтрК.СхемаКредитования; 
							НоваяСтрН.Металл = Стр.Металл;
			                НоваяСтрН.Проба = Стр.Проба;
			                НоваяСтрН.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога;
					        НоваяСтрН.ОтклонениеОтБазовойЦены = СтрН.УстанавливатьОтклонение; 
							Если НоваяСтрН.ОтклонениеОтБазовойЦены = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
	                            НоваяСтрН.ЗначениеОтклонения = СтрН.ПроцентОтклонения;  
							Иначе 
								НоваяСтрН.ЗначениеОтклонения = Стр.Цена*СтрН.ПроцентОтклонения/100 - Стр.Цена;
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;	
				Конеццикла;
			КонецЕсли;   
		КонецЦикла;	
		
		ДокументОбъект.Записать();     
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор); 
		СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
		ПолучитьДополнительныеРеквизиты(СтрокаПриказа); 
	КонецЕсли;	
		 
КонецПроцедуры	 

&НаСервере
Процедура ЗаполнитьЦеныВставокПоНастройкамНаСервере(ШаблонВставки)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВидВставки КАК ВидВставки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВесоваяГруппа КАК ВесоваяГруппа,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ФормаОгранки КАК ФормаОгранки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ВидОгранки КАК ВидОгранки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.КачествоОгранки КАК КачествоОгранки,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Цена КАК Цена,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СрезПоследних(&Дата, Ломбард В (&Ломбарды)) КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВидВставки,
	               |	ФормаОгранки,
	               |	ВидОгранки,
	               |	КачествоОгранки,
	               |	ВесоваяГруппа";
	СписокЛ = Новый СписокЗначений;
	Для каждого СтрЛ из ТекущийПриказ.Ломбарды Цикл
		СписокЛ.Добавить(СтрЛ.Ломбард);
	КонецЦикла;	
	Запрос.УстановитьПараметр("Ломбарды", СписокЛ);
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
	ДокументОбъект.ЦеныВставки.Очистить();
	
	Для каждого Стр Из ШаблонВставки.Вставки Цикл
	     НоваяСтр = ДокументОбъект.ЦеныВставки.Добавить();
		 НоваяСтр.ВидВставки = Стр.Вставка;
		 НоваяСтр.ВесоваяГруппа = Стр.ВесоваяГруппа;
		 НоваяСтр.КачествоОгранки = Стр.КачествоОгранки;
		 НоваяСтр.ФормаОгранки = Стр.ФормаОгранки; 
		 НоваяСтр.ВидОгранки = Стр.ВидОгранки;
		 
		 Отбор = новый Структура;
		 Отбор.Вставить("ВидВставки", Стр.Вставка);
		 Отбор.Вставить("ВесоваяГруппа", Стр.ВесоваяГруппа);
		 Отбор.Вставить("КачествоОгранки", Стр.КачествоОгранки);
		 Отбор.Вставить("ФормаОгранки", Стр.ФормаОгранки); 
		 Отбор.Вставить("ВидОгранки", Стр.ВидОгранки);
		 
		 СтрокиЦен = ТаблицаЦен.НайтиСтроки(Отбор);
		 Если СтрокиЦен.Количество() = 0 Тогда
		     НоваяСтр.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмеренияВставки;
		 Иначе
		     СтрЦ = СтрокиЦен.Получить(0);
		     НоваяСтр.Цена = СтрЦ.Цена;
		     НоваяСтр.ЕдиницаИзмерения = СтрЦ.ЕдиницаИзмерения;
		 КонецЕсли;	 
	КонецЦикла;	 
	ДокументОбъект.ШаблонВставки = ШаблонВставки;
	ДокументОбъект.Записать();
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦеныВставокПоНастройкам(Команда) 
	ШаблонПриказа = ПолучитьТекущийШаблон(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПрейскурантов.Вставки"));  
	Если НЕ ШаблонПриказа = неопределено Тогда 
		ЗаполнитьЦеныВставокПоНастройкамНаСервере(ШаблонПриказа); 
		ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
		ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		ПолучитьОбъектПриказа(ИдентификаторСтроки);
