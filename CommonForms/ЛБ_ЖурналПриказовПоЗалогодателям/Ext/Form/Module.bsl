&НаКлиенте
Процедура ТаблицаПриказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  
		СписокВыбора = Новый СписокЗначений; 
		
		Если ЕстьПолныеПрава Тогда
		    СписокВыбора.Добавить("Документ", "Открыть приказ"); 
		КонецЕсли;	
		СписокВыбора.Добавить("Отчет", "Открыть отчет по условиям займа"); 
		СписокВыбора.Добавить("Печать", "Печать приказа");

		ВыбранноеЗначение = ВыбратьИзМеню(СписокВыбора, Элементы.ТаблицаПриказов.ТекущаяСтрока); 
		
		Если НЕ ВыбранноеЗначение = неопределено Тогда
			Если ВыбранноеЗначение.Значение = "Документ" Тогда
			    ПараметрыФормы = Новый Структура;
			    ПараметрыФормы.Вставить("Ключ", ТекСтрока.Ссылка);
				
				ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПриказа",ЭтаФорма);
				ОткрытьФорму("Документ.ЛБ_ПриказУсловияПредоставленияЗаймов.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			ИначеЕсли ВыбранноеЗначение.Значение = "Отчет" Тогда 
			    ПараметрыФормы = Новый Структура;
			    ПараметрыФормы.Вставить("Приказ", ТекСтрока.Ссылка);
				
				Если ТекущийПриказ.Ломбарды.Количество() > 1 Тогда
					ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЛомбарда",ЭтаФорма);
					ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборЛомбардаИзПриказа", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
				Иначе 
					ПараметрыФормы = Новый Структура; 
					Если ТекущийПриказ.Ломбарды.Количество() = 1 Тогда
				        ПараметрыФормы.Вставить("Ломбард", ТекущийПриказ.Ломбарды.Получить(0).Ломбард); 
					Иначе 
						ПараметрыФормы.Вставить("Ломбард", ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка"));
					КонецЕсли;	
					ПараметрыФормы.Вставить("Дата", ТекСтрока.Дата);
						
					ОткрытьФорму("Отчет.ЛБ_УсловияЗаймаВЛомбарде.Форма.ФормаОтчета", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.Независимый);
				КонецЕсли;	
			ИначеЕсли ВыбранноеЗначение.Значение = "Печать" Тогда
				Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.Базовый") Тогда		
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("ИменаМакетов", "Приказ"); 
					ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриказУсловияПредоставленияЗаймов");
					МассивОбъектов = Новый Массив;
					МассивОбъектов.Добавить(ТекСтрока.Ссылка);
					ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
					ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
				Иначе     
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("ИменаМакетов", "Акция"); 
					ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриказУсловияПредоставленияЗаймов");
					МассивОбъектов = Новый Массив;
					МассивОбъектов.Добавить(ТекСтрока.Ссылка);
					ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
					ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
				КонецЕсли;	
			КонецЕсли; 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьЦеныМеталловПоНастройкамНаСервере(ШаблонМеталлы) 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
	ДокументОбъект.ЦеныМеталлы.Очистить();
		
	Для каждого Стр Из ШаблонМеталлы.Металлы Цикл
	     НоваяСтр = ДокументОбъект.ЦеныМеталлы.Добавить();
		 НоваяСтр.Металл = Стр.Металл;
		 НоваяСтр.Проба = Стр.Проба;
		 НоваяСтр.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога;
		 НоваяСтр.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмерения;		 
	 конецЦикла;	
	 ДокументОбъект.ЦеныМеталлы.Сортировать("Металл, Проба, КатегорияОбъектаЗалога");
	 ДокументОбъект.ШаблонМеталлы = ШаблонМеталлы;
	 ДокументОбъект.Записать();  
	 СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	 ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры    

