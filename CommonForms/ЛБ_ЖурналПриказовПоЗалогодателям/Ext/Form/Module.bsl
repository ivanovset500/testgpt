&НаКлиенте
Процедура ОчиститьНастройкиМеталлы(Команда)
	Если  ТекущийПриказ.Проведен Тогда  
		Сообщить("Приказ введен в действие, его корректировка запрещена!");
	Иначе	          
	    Ответ = Вопрос("Удалить все строки таблицы?", РежимДиалогаВопрос.ДаНет, 0);
	    Если Ответ = КодВозвратаДиалога.Да Тогда
		    ОчиститьНастройкиМеталлыНаСервере();
			ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
		    ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		    ПолучитьОбъектПриказа(ИдентификаторСтроки); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

