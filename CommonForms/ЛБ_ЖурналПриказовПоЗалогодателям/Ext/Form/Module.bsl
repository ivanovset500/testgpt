КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриказовПриАктивизацииСтроки(Элемент) 
	//Если НЕ  ЭтаФорма.ТекущийЭлемент = Элементы.ТаблицаПриказов Тогда
	//	Возврат;
	//КонецЕсли;	
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;  
	Если НЕ ТекСтрока = неопределено Тогда  
		ТекущийПриказИдентификатор = ТекСтрока.ПолучитьИдентификатор();
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
		ДатаДок = ТекСтрока.Дата; 
		//СтрокаАкция = СокрЛП(ТекущийПриказ.Акция);				
		
		Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП") Тогда
			Элементы.ТекущийПриказЗалогодателиЗалогодатель.ТекстПодвала = ПолучитьКоличествоЗалогодателей(ТекСтрока.Ссылка, "Залогодатели");
			//Элементы.ТекущийПриказЗалогодателиОтменыЗалогодатель.ТекстПодвала = ПолучитьКоличествоЗалогодателей(ТекСтрока.Ссылка, "ЗалогодателиОтмены");
		КонецЕсли;
		УстановитьВидимость();
		
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Процедура ПолучитьОбъектПриказа(Идентификатор) 
	СтрП = ТаблицаПриказов.НайтиПоИдентификатору(Идентификатор); 
	Если НЕ СтрП = Неопределено Тогда
		ДокументОбъект = СтрП.Ссылка.ПолучитьОбъект();
		ЗначениеВРеквизитФормы(ДокументОбъект, "ТекущийПриказ");

		//+Мельников 26.09.24 Заявка 2792
		Комментарий = ДокументОбъект.Комментарий;
		//-

		Если ДокументОбъект.Проведен Тогда 
			//Элементы.СтрокаЛомбарды.ТолькоПросмотр = Истина;
			Элементы.СтрокаСК.ТолькоПросмотр = Истина;
			//Элементы.Акция.ТолькоПросмотр = Истина;
		Иначе
			//Элементы.СтрокаЛомбарды.ТолькоПросмотр = Ложь;
			Элементы.СтрокаСК.ТолькоПросмотр = Ложь;
			//Элементы.Акция.ТолькоПросмотр = Ложь;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	
	
&НаСервере
Процедура ВводДокументовНаОсновании(ИдентификаторСтроки)
	СтрП = ТаблицаПриказов.НайтиПоИдентификатору(ИдентификаторСтроки); 
	ДокОбъект = СтрП.Ссылка.ПолучитьОбъект(); 

	//металлы
	Если НЕ ДокОбъект.ЦеныМеталлы.Количество() = 0 Тогда 
		 ЗапросДок = Новый Запрос;
		 ЗапросДок.УстановитьПараметр("Приказ", ДокОбъект.Ссылка);
		 ЗапросДок.Текст = "ВЫБРАТЬ
		                   |	ЛБ_ПрейскурантЦенНаМеталлы.Ссылка КАК Ссылка
		                   |ИЗ
		                   |	Документ.ЛБ_ПрейскурантЦенНаМеталлы КАК ЛБ_ПрейскурантЦенНаМеталлы
		                   |ГДЕ
		                   |	ЛБ_ПрейскурантЦенНаМеталлы.Приказ = &Приказ
		                   |	И ЛБ_ПрейскурантЦенНаМеталлы.ПометкаУдаления = ЛОЖЬ
		                   |
		                   |УПОРЯДОЧИТЬ ПО
		                   |	ЛБ_ПрейскурантЦенНаМеталлы.Дата УБЫВ";
		 ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
		 Если  ВыборкаДок.Следующий() Тогда  
			 ДокОбъектМ = ВыборкаДок.Ссылка.ПолучитьОбъект(); 
		 Иначе	
			 ДокОбъектМ = Документы.ЛБ_ПрейскурантЦенНаМеталлы.СоздатьДокумент();
		 КонецЕсли;	 
		 ДокОбъектМ.Дата = ДокОбъект.Дата;
		 ДокОбъектМ.ЗаполнитьНаОсновании(ДокОбъект.Ссылка);
		 
		 Попытка
		     ДокОбъектМ.Записать(РежимЗаписиДокумента.Проведение);
			 Сообщить("Создан прейскурант цен на металлы № " + СокрЛП(ДокОбъектМ.Номер) + " от " + Строка(ДокОбъектМ.Дата) + ".");
		 Исключение              
			ОшибкаПроведения = Истина; 
			Сообщить("Прейскурант цен на металлы не создан!");
			Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;	  
	КонецЕсли;	  
	
	//вставки
	Если НЕ ДокОбъект.ЦеныВставки.Количество() = 0 Тогда 
		 ЗапросДок = Новый Запрос;
		 ЗапросДок.УстановитьПараметр("Приказ", ДокОбъект.Ссылка);
		 ЗапросДок.Текст = "ВЫБРАТЬ
		                   |	ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Ссылка КАК Ссылка
		                   |ИЗ
		                   |	Документ.ЛБ_ПрейскурантЦенНаДрагоценныеКамни КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамни
		                   |ГДЕ
		                   |	ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Приказ = &Приказ
		                   |	И ЛБ_ПрейскурантЦенНаДрагоценныеКамни.ПометкаУдаления = ЛОЖЬ
		                   |
		                   |УПОРЯДОЧИТЬ ПО
		                   |	ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Дата УБЫВ";
		 ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
		 Если  ВыборкаДок.Следующий() Тогда  
			 ДокОбъектВ = ВыборкаДок.Ссылка.ПолучитьОбъект(); 
		 Иначе	
			 ДокОбъектВ = Документы.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СоздатьДокумент();
		 КонецЕсли;	 
		 ДокОбъектВ.Дата = ДокОбъект.Дата;
		 ДокОбъектВ.ЗаполнитьНаОсновании(ДокОбъект.Ссылка);
		 
		 Попытка
		     ДокОбъектВ.Записать(РежимЗаписиДокумента.Проведение);
			 Сообщить("Создан прейскурант цен на драгоценные камни № " + СокрЛП(ДокОбъектВ.Номер) + " от " + Строка(ДокОбъектВ.Дата) + ".");
		 Исключение              
			ОшибкаПроведения = Истина; 
			Сообщить("Прейскурант цен на драгоценные камни не создан!");
			Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;	  
	КонецЕсли;	
	
	//процентные ставки
	Если НЕ ДокОбъект.СтавкиПроцентов.Количество() = 0 Тогда 
		 ЗапросДок = Новый Запрос;
		 ЗапросДок.УстановитьПараметр("Приказ", ДокОбъект.Ссылка);
		 ЗапросДок.Текст = "ВЫБРАТЬ
		                   |	ЛБ_ПрейскурантПроцентныхСтавок.Ссылка КАК Ссылка
		                   |ИЗ
		                   |	Документ.ЛБ_ПрейскурантПроцентныхСтавок КАК ЛБ_ПрейскурантПроцентныхСтавок
						   |ГДЕ
		                   |	ЛБ_ПрейскурантПроцентныхСтавок.Приказ = &Приказ
		                   |	И ЛБ_ПрейскурантПроцентныхСтавок.ПометкаУдаления = ЛОЖЬ
		                   |
		                   |УПОРЯДОЧИТЬ ПО
		                   |	ЛБ_ПрейскурантПроцентныхСтавок.Дата УБЫВ";
		 ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
		 Если  ВыборкаДок.Следующий() Тогда  
			 ДокОбъектС = ВыборкаДок.Ссылка.ПолучитьОбъект(); 
		 Иначе	
			 ДокОбъектС= Документы.ЛБ_ПрейскурантПроцентныхСтавок.СоздатьДокумент();
		 КонецЕсли;	 
		 ДокОбъектС.Дата = ДокОбъект.Дата;
		 ДокОбъектС.ЗаполнитьНаОсновании(ДокОбъект.Ссылка);
		 
		 Попытка
		     ДокОбъектС.Записать(РежимЗаписиДокумента.Проведение);
			 Сообщить("Создан прейскурант процентных ставок № " + СокрЛП(ДокОбъектС.Номер) + " от " + Строка(ДокОбъектС.Дата) + ".");
		 Исключение              
			ОшибкаПроведения = Истина; 
			Сообщить("Прейскурант процентных ставок не создан!");
			Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;	  
	КонецЕсли;	

КонецПроцедуры  

&НаСервере
Функция ВводПриказаВДействие(ИдентификаторСтроки, Результат)
	СтрП = ТаблицаПриказов.НайтиПоИдентификатору(ИдентификаторСтроки); 
	ДокОбъект = СтрП.Ссылка.ПолучитьОбъект(); 
	
	ДокОбъект.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Факт;
	ДокОбъект.НомерПриказа = Результат.НомерПриказа;
	//+МАН 05.02.25 Если изменить дату приказа то она не изменялась в документе.
	ДокОбъект.Дата = Результат.ДатаПриказа;
	//-МАН
	ДокОбъект.ДатаНачалаДействияПриказа = Результат.ДатаНачалаДействияПриказа;
	ДокОбъект.ДатаОкончанияДействияПриказа = Результат.ДатаОкончанияДействияПриказа;
	//Если ДокОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Акция Тогда
	//	ДокОбъект.ДатаОкончанияДействияПриказа = Результат.ДатаОкончанияДействияПриказа;
	//КонецЕсли;
	
	ВсеОК = Истина;
	Попытка
	    ДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
		Сообщить("Приказ введен в действие!");
	Исключение              
		ОшибкаПроведения = Истина; 
		Сообщить("Приказ не введен в действие!");
		//Сообщить(ОписаниеОшибки(), Статуссообщения.Важное);
		ВсеОК = ложь;
	КонецПопытки;	
    Возврат ВсеОК;
КонецФункции

&НаКлиенте
Процедура ПослеВводаПриказаВДействие(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено Тогда 
		Возврат;   
	КонецЕсли;	   
	
	ТекСтрокаПриказы = Элементы.ТаблицаПриказов.ТекущиеДанные; 
	ИдентификаторСтроки = ТекСтрокаПриказы.ПолучитьИдентификатор();
	ПриказВведен = ВводПриказаВДействие(ИдентификаторСтроки, Результат);
		
	Если ПриказВведен Тогда   
		ТекСтрокаПриказы.ВидПриказа = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПриказа.Факт"); 
		ТекСтрокаПриказы.НомерПриказа = Результат.НомерПриказа;    
		ТекСтрокаПриказы.Дата = Результат.ДатаПриказа;
		ТекСтрокаПриказы.ДатаНачалаДействияПриказа = Результат.ДатаНачалаДействияПриказа;
		ТекСтрокаПриказы.ДатаОкончанияДействияПриказа = Результат.ДатаОкончанияДействияПриказа;  
		ТекСтрокаПриказы.СостояниеДокумента = 1;     
		ПолучитьОбъектПриказа(ИдентификаторСтроки);
		//Если ТекСтрокаПриказы.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.Акция") Тогда 
		//	ВводДокументовНаОснованииАкция(ИдентификаторСтроки);
		//Иначе 
		//	ВводДокументовНаОсновании(ИдентификаторСтроки);
		//КонецЕсли;	
	КонецЕсли;	 
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПриказВДействие(Команда)  
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные; 
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	 
	
	//+Мельников 14.08.24 Проверка заполнения поля ставка. Заявка 2676.
	ПустаяСтавка = Ложь;
	
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП")
		И ЭтотОбъект.ТекущийПриказ.СтавкиПроцентов.Количество() > 0 Тогда
		//+МАН 05.03.25 Изменил
		//Для каждого СтрСтавки Из ЭтотОбъект.ТекущийПриказ.СтавкиПроцентов Цикл
		//	Если СтрСтавки.Ставка <> 0 Тогда
		//		Продолжить;
		//	Иначе
		//		Сообщить("В строке № " + СтрСтавки.НомерСтроки + " не заполнена ставка.");
		//		ПустаяСтавка = Истина;
		//	КонецЕсли;
		//КонецЦикла;
		
		//Если ПустаяСтавка Тогда
		//	Возврат;
		//КонецЕсли;
		
		НомераСтрок = "";
		//+МАН 19.03.25
		ЕстьНоль = Ложь;
		//-МАН
		
		Для каждого СтрСтавки Из ЭтотОбъект.ТекущийПриказ.СтавкиПроцентов Цикл
			Если СтрСтавки.Ставка = 0 Тогда
				НомераСтрок = НомераСтрок + ?(НомераСтрок <> "", ", " + СтрСтавки.НомерСтроки, СтрСтавки.НомерСтроки);
				//+МАН 19.03.25
				ЕстьНоль = Истина;
				//-МАН
			КонецЕсли;
		КонецЦикла;
		
		//+МАН 19.03.25
		Если ЕстьНоль Тогда
			ТекстСообщения = "Для строк № " + НомераСтрок + " не указана ставка. При оформлении займа будет действовать базовая ставка!";
			
			Ответ = Вопрос(ТекстСообщения, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
			Если Ответ = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		//-МАН
	КонецЕсли;
	//-Мельников
	
	//+МАН 22.08.25 Убрал
	//Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП")
	//	И НЕ ПроверитьЗаполнениеПриказаОтмены(ТекСтрока.Ссылка) Тогда
	//	Сообщить("Не выбран приказ по которум производится отмена!");
	//	Возврат;
	//КонецЕсли;
	
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП")
		И ЭтотОбъект.ТекущийПриказ.Залогодатели.Количество() = 0 Тогда
		Сообщить("Не выбраны залогодатели по которым производится отмена!");
		Возврат;
	КонецЕсли;

	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП")
		И ЭтотОбъект.ТекущийПриказ.ОтменяемыеПриказы.Количество() = 0 Тогда
			Если ЭтотОбъект.ТекущийПриказ.Залогодатели.Количество() = 1 Тогда
				Сообщить("По данному клиенту нет условий которые можно отменить");
			ИначеЕсли ЭтотОбъект.ТекущийПриказ.Залогодатели.Количество() > 1 Тогда
				Сообщить("По данным клиентам нет условий которые можно отменить");
			КонецЕсли;
		Возврат;
	КонецЕсли;
	//-МАН
	
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП")
		И НЕ ТекущийПриказ.ОтменаСтавок И НЕ ТекущийПриказ.ОтменаМеталлов И НЕ ТекущийПриказ.ОтменаВставкок Тогда
		Сообщить("Не выбраны отменяемые условия!");
		Возврат;
	КонецЕсли;

	//+МАН 04.02.25
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП")
		И ТекущийПриказ.Залогодатели.Количество() = 0 Тогда
		Сообщить("Не выбран залогодатель!");
		Возврат;
	КонецЕсли;

	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП")
		И ТекущийПриказ.СхемыКредитования.Количество() = 0 Тогда
		Сообщить("Не выбрана схема кредитования!");
		Возврат;
	КонецЕсли;

	//+МАН 04.03.25
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП") Тогда
		РезультатПроверкиСК = ПроверитьСК(ТекСтрока.Ссылка);
		Если ЗначениеЗаполнено(РезультатПроверкиСК.СК) Тогда
			Сообщить("По схеме кредитования " + """" + РезультатПроверкиСК.СК + """" + " не установлено ни одно из условий!");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	//+МАН 04.07.25
	РезультатПроверкиЗаполненияСотрудников = ПроверитьЗаполнениеСотрудников(ТекСтрока.Ссылка);
	Если РезультатПроверкиЗаполненияСотрудников Тогда
		//Сообщить("Выбраны не все сотрудники в параметрах печати!");
		Сообщить("В параметрах печати заполнены не все поля!");
		Возврат;
	КонецЕсли;
	//-МАН
	
	Если ТекСтрока.ВидПриказа = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПриказа.Факт") Тогда 
		Сообщить("Приказ уже введен в действие!"); 
		Возврат;
	ИначеЕсли ТекСтрока.СостояниеДокумента = 2 Тогда 
		Сообщить("Приказ помечен на удаление!"); 
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;   
	ПараметрыФормы.Вставить("ВидОперации", ТекСтрока.ВидОперации);
	ПараметрыФормы.Вставить("НомерПриказа", ТекСтрока.НомерПриказа); 
	ПараметрыФормы.Вставить("ДатаПриказа", ТекСтрока.Дата);
	ПараметрыФормы.Вставить("ДатаНачалаДействияПриказа", ТекСтрока.ДатаНачалаДействияПриказа);
	
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП") Тогда
		ПараметрыФормы.Вставить("ДатаОкончанияДействияПриказа", ТекСтрока.ДатаОкончанияДействияПриказа);
	КонецЕсли;
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВводаПриказаВДействие",ЭтаФорма);
	
	ОткрытьФорму("Документ.ЛБ_ПриказИндивидуальныеУсловия.Форма.ВводПриказаВДействие", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

