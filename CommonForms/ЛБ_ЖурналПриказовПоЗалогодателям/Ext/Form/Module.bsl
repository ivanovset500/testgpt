&НаСервере
Процедура ПослеВыбораСценария(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;    
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
	ДокументОбъект.СценарийОценкиМеталлов = Результат;
	ДокументОбъект.Записать(); 
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	
	ТЗМеталлы = Новый ТаблицаЗначений;
	ТЗМеталлы.Колонки.Добавить("Металл");
	ТЗМеталлы.Колонки.Добавить("БазоваяПроба");
	ТЗМеталлы.Колонки.Добавить("БазоваяКатегория");
	ТЗМеталлы.Колонки.Добавить("БазоваяЦена");
	
	Для каждого СтрСпр из Результат.БазовыеНастройки Цикл    
		Стр = ТЗМеталлы.Добавить(); 
		Стр.Металл = СтрСпр.Металл;
		Стр.БазоваяПроба = СтрСпр.БазоваяПроба;
		Стр.БазоваяКатегория = СтрСпр.БазоваяКатегория;
		Стр.БазоваяЦена = СтрСпр.БазоваяЦена;
	Конеццикла;	

	ЗаполнитьЦеныМеталловПоСценариюНаСервере(ТЗМеталлы);  

КонецПроцедуры

