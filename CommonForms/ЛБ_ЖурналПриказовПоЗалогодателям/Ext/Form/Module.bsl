&НаСервере
Функция ЗаполнитьПроцентныеСтавкиПоНастройкамВЛомбарде(СхемаКредитования, Ломбард) 
	ЗапросСтавки = Новый Запрос; 
	ЗапросСтавки.УстановитьПараметр("СхемаКредитования", СхемаКредитования); 
	ЗапросСтавки.УстановитьПараметр("Ломбард", Ломбард);  
	ЗапросСтавки.УстановитьПараметр("Дата", ТекущийПриказ.Дата);
	ЗапросСтавки.Текст = "ВЫБРАТЬ
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Период КАК Период,
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.СтатусЗалогодателя КАК СтатусЗалогодателя,
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ДиапазонСуммЗайма КАК ДиапазонСумм,
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ДеньНачалаПрименения КАК ДеньНачалаПрименения,
	                     |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.ПроцентнаяСтавка КАК Ставка
	                     |ИЗ
	                     |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок.СрезПоследних(
	                     |			&Дата,
	                     |			СхемаКредитования = &СхемаКредитования
	                     |				И Ломбард = &Ломбард
	                     |				И ДатаНачалаДействия <= &Дата) КАК ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних
	                     |
	                     |УПОРЯДОЧИТЬ ПО
	                     |	Период УБЫВ"; 
	ТаблицаЗапросаСтавки = ЗапросСтавки.Выполнить().Выгрузить(); 
	ТаблицаСтавок = ТаблицаЗапросаСтавки.Скопировать(); 
	ТаблицаСтавок.Очистить();
	
	Период = Дата(1,1,1);
	Для каждого Стр Из ТаблицаЗапросаСтавки Цикл
		Если Период = Дата(1,1,1) Тогда
			Период = Стр.Период;
		ИначеЕсли Стр.Период < Период Тогда
			Прервать;
		КонецЕсли;	
		НоваяСтр = ТаблицаСтавок.Добавить();
		НоваяСтр.СхемаКредитования = Стр.СхемаКредитования; 
		//НоваяСтр.СтатусЗалогодателя = Стр.СтатусЗалогодателя;
		//НоваяСтр.ПричинаПрименения = Стр.ПричинаПрименения; 
		НоваяСтр.ДиапазонСумм = Стр.ДиапазонСумм;
		//НоваяСтр.ДеньНачалаПрименения = Стр.ДеньНачалаПрименения;
		НоваяСтр.Ставка = Стр.Ставка;
	КонецЦикла;
	Возврат ТаблицаСтавок;	
КонецФункции	

 &НаСервере
Процедура ПроставитьПроцентныеСтавкиПоТекущимНастройкам(СхемаКредитования, Ломбард) 
	ТаблицаСтавок = ЗаполнитьПроцентныеСтавкиПоНастройкамВЛомбарде(СхемаКредитования, Ломбард);
	Если НЕ ТаблицаСтавок.Количество() = 0 тогда  
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
		ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
		Для каждого стр Из ДокументОбъект.СтавкиПроцентов Цикл  
			ОтборП = Новый Структура;
            ОтборП.Вставить("СхемаКредитования", стр.СхемаКредитования);
			//ОтборП.Вставить("ПричинаПрименения", стр.ПричинаПрименения);
			//ОтборП.Вставить("СтатусЗалогодателя", стр.СтатусЗалогодателя);
			ОтборП.Вставить("ДиапазонСумм", стр.ДиапазонСумм);
			//ОтборП.Вставить("ДеньНачалаПрименения", стр.ДеньНачалаПрименения);
			
			СтрокиП = ТаблицаСтавок.НайтиСтроки(ОтборП); 
			Если НЕ СтрокиП.Количество() = 0 Тогда
				СтрП = строкиП.Получить(0);
				Стр.Ставка = СтрП.ставка;
			КонецЕсли;	
		КонецЦикла;	
        ДокументОбъект.Записать();                         
		СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	    ПолучитьДополнительныеРеквизиты(СтрокаПриказа);

		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор); 	
	КонецЕсли; 	 
КонецПроцедуры	 
	 
&НаСервере
Процедура ОбработкаОтметкиЭлементовСК(Элементы)  	
	Если Элементы <> Неопределено Тогда 
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
		ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");
		ДатаПроверки = ДокументОбъект.Дата;
		ТаблицаСК = ДокументОбъект.СхемыКредитования.Выгрузить();
		ДокументОбъект.СхемыКредитования.Очистить();
		Для Каждого Эл Из Элементы Цикл 
			Если Эл.Пометка Тогда   
				ШаблонПриказа = ЛБ_ОбщийМодуль.ПолучитьТекущийШаблон(ДатаПроверки, Перечисления.ЛБ_ВидыПрейскурантов.ПроцентныеСтавки, Ломбарды, Эл.Значение);
				Если НЕ ШаблонПриказа = неопределено Тогда 
					НоваяСтр = ДокументОбъект.СхемыКредитования.Добавить(); 
				    НоваяСтр.СхемаКредитования = Эл.Значение;
					НоваяСтр.ШаблонПроцентныеСтавки = ШаблонПриказа;
					
					Отбор = Новый Структура;
				    Отбор.Вставить("СхемаКредитования",Эл.Значение);
					Строки = ТаблицаСК.НайтиСтроки(Отбор);
					Если Строки.Количество() = 0 Тогда
						Для каждого СтрШ Из НоваяСтр.ШаблонПроцентныеСтавки.СтавкиПроцентов Цикл 
							НоваяСтрП = ДокументОбъект.СтавкиПроцентов.Добавить();
							НоваяСтрП.СхемаКредитования = НоваяСтр.СхемаКредитования;
							НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
							НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
							НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;
							НоваяСтрП.ДеньНачалаПрименения = СтрШ.ДеньНачалаПрименения;
							НоваяСтрП.Ставка = 0;
						Конеццикла;	
					Иначе
						СтрокаСК = Строки.Получить(0);
						Если НЕ СтрокаСК.ШаблонПроцентныеСтавки = ШаблонПриказа Тогда 
							СтрокиУдалить = ДокументОбъект.СтавкиПроцентов.НайтиСтроки(Отбор);  
							Для каждого Стр Из СтрокиУдалить Цикл
								ТекущийПриказ.СтавкиПроцентов.Удалить(Стр);
							КонецЦикла; 
							Для каждого СтрШ Из НоваяСтр.ШаблонПроцентныеСтавки.СтавкиПроцентов Цикл
	                            НоваяСтрП = ДокументОбъект.СтавкиПроцентов.Добавить();
								НоваяСтрП.СхемаКредитования = НоваяСтр.СхемаКредитования;
								НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
								НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
								НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;
							КонецЦикла;	
						КонецЕсли;	
                    КонецЕсли;
				Иначе
					Сообщить("Для кредитной схемы " + СокрЛП(Эл.Значение) + " не установлен шаблон процентных ставок!");					
				КонецЕсли;	
			Иначе  
				Отбор = Новый Структура;
				Отбор.Вставить("СхемаКредитования",Эл.Значение); 
				Строки = ТаблицаСК.НайтиСтроки(Отбор);
				Если НЕ Строки.Количество() = 0 Тогда
					СтрокиУдалить = ДокументОбъект.СтавкиПроцентов.НайтиСтроки(Отбор);  
					Для каждого Стр Из СтрокиУдалить Цикл
						ДокументОбъект.СтавкиПроцентов.Удалить(Стр);
					КонецЦикла; 	 
				КонецЕсли;	
			КонецЕсли;				
		КонецЦикла; 
		ЗаполнитьСписокСК(ДокументОбъект);
	    ДокументОбъект.Записать();          
		СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор);
	    ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
		СхемыКредитования.Загрузить(ТекущийПриказ.СхемыКредитования.Выгрузить());
		ПолучитьОбъектПриказа(ТекущийПриказИдентификатор); 		
    КонецЕсли; 
КонецПроцедуры  

