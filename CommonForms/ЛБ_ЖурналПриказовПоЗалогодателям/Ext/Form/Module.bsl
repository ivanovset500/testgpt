	НачПериода = НачалоДня(ДобавитьМесяц(КонПериода, -2));  
	Период = Новый СтандартныйПериод(НачПериода, КонПериода);
	ЭтаФорма.Заголовок = "Журнал приказов по залогодателям " + ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания);

	ЗаполнитьТаблицуПриказов();
	ЗаполнитьПараметрыПечати();
