&НаСервере
Функция ПроверитьНаличиеДокументов(Ссылка)
	
	Если Ссылка.Проведен Тогда
		ТЗЗалогодателей = Ссылка.Залогодатели.Выгрузить(,"Залогодатель");
		
		Запрос = Новый Запрос;
		
		//+МАН 20.03.25
		Если Ссылка.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ВИП Тогда
			//-МАН
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ЗалоговыйБилет КАК Документ
			|ИЗ
			|	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.Обороты(&ДатаС, &ДатаПо, , Клиент В (&Клиент)) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЛБ_ПриказИндивидуальныеУсловия.Ссылка
			|ИЗ
			|	Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
			|ГДЕ
			|	ЛБ_ПриказИндивидуальныеУсловия.ОтменяемыйПриказ = &ОтменяемыйПриказ
			//+МАН 19.03.25
			|	И ЛБ_ПриказИндивидуальныеУсловия.Проведен
			|	И ЛБ_ПриказИндивидуальныеУсловия.Дата > &ДатаС";
			//-МАН
			//+МАН 20.03.25
		Иначе
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЛБ_ПриказИндивидуальныеУсловия.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ЛБ_ПриказИндивидуальныеУсловия.Залогодатели КАК ЛБ_ПриказИндивидуальныеУсловияЗалогодатели
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
			|		ПО ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Ссылка = ЛБ_ПриказИндивидуальныеУсловия.Ссылка
			|ГДЕ
			|	ЛБ_ПриказИндивидуальныеУсловия.Проведен
			|	И ЛБ_ПриказИндивидуальныеУсловия.Дата > &ДатаС
			|	И ЛБ_ПриказИндивидуальныеУсловия.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ВИП)
			|	И ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Залогодатель В(&Клиент)";
		КонецЕсли;
		//-МАН
		
		Запрос.УстановитьПараметр("ДатаПо", ?(Ссылка.ДатаОкончанияДействияПриказа = Дата(1, 1, 1), ТекущаяДата(), Ссылка.ДатаОкончанияДействияПриказа));
		Запрос.УстановитьПараметр("Клиент", ТЗЗалогодателей);
		Запрос.УстановитьПараметр("ОтменяемыйПриказ", Ссылка);
		//+МАН 19.03.25
		//Было: Запрос.УстановитьПараметр("ДатаС", Ссылка.ДатаНачалаДействияПриказа);
		Запрос.УстановитьПараметр("ДатаС", Ссылка.Дата);
		//-МАН
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуПриказов();
КонецПроцедуры

