	Если Результат = Неопределено Тогда
	    Возврат;
	КонецЕсли;
		
	//Если ТекущийПриказ.Залогодатели.Количество() = 0 Тогда
	//	ПокаНетЗалогодателей = Истина;
	//Иначе	
	//	ПокаНетЗалогодателей = ложь; 
	//КонецЕсли;
