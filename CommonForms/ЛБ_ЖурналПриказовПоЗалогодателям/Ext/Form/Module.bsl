	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораШаблонаВставок", ЭтаФорма);

	ОткрытьФорму("Справочник.ЛБ_ШаблоныПриказовВставки.ФормаВыбора",ПараметрыФормы,
	        ЭтаФорма, , , , ОбработкаВыбора);
