		//	НовыйДок.ОтветственноеЛицоОРБ = Элементы.ТекущийПриказОтветственноеЛицоОРБ.СписокВыбора.Получить(0).Значение;
		//КонецЕсли;
		//
		//Если Элементы.ТекущийПриказНачальникОДО.СписокВыбора.Количество() = 1 Тогда
		//	НовыйДок.НачальникОДО = Элементы.ТекущийПриказНачальникОДО.СписокВыбора.Получить(0).Значение;
		//КонецЕсли;
		//
		//Если Элементы.ТекущийПриказОтветственноеЛицоРеклама.СписокВыбора.Количество() = 1 Тогда
		//	НовыйДок.ОтветственноеЛицоРеклама = Элементы.ТекущийПриказОтветственноеЛицоРеклама.СписокВыбора.Получить(0).Значение;
		//КонецЕсли;
		//
		//Если Элементы.ТекущийПриказПодписантФИО.СписокВыбора.Количество() = 1 Тогда
		//	НовыйДок.ПодписантФИО = Элементы.ТекущийПриказПодписантФИО.СписокВыбора.Получить(0).Значение;
		//	НовыйДок.ПодписантДолжность = Элементы.ТекущийПриказПодписантФИО.СписокВыбора.Получить(0).Значение.Должность
		//КонецЕсли;
		//-МАН

		//+МАН 29.07.25 Изменил после ввода констант подписантов. Заявка 2792
		ЗаполнитьНастройкиПечатиВНовомДокументе(НовыйДок);
