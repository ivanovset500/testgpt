КонецПроцедуры

&НаСервере
Процедура СохранитьЗалогодателей(Результат)
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);
	ДокументОбъект = РеквизитФормыВЗначение("ТекущийПриказ");  
	ДокументОбъект.Залогодатели.Очистить();  
	КоличествоВыбрано = Результат.Количество;
	Для сч = 1 По КоличествоВыбрано Цикл
		НоваяСтр = ДокументОбъект.Залогодатели.Добавить();
		НоваяСтр.Залогодатель = Результат["Значение" + Строка(сч)];
	КонецЦикла;	
	
	ЗаполнитьСписокЗалогодателей(ДокументОбъект);
	ДокументОбъект.Записать();
	ПолучитьОбъектПриказа(ТекущийПриказИдентификатор);	
	СтрокаПриказа = ТаблицаПриказов.НайтиПоИдентификатору(ТекущийПриказИдентификатор); 
	СтрокаПриказа.СтрокаЗалогодатели = ДокументОбъект.СтрокаЗалогодатели; 
	ПолучитьДополнительныеРеквизиты(СтрокаПриказа);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗалогодателей(ДокументОбъект)
	Результат = "";
	Для каждого Стр Из ДокументОбъект.Залогодатели Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + СокрЛП(Стр.Залогодатель.Наименование);
	КонецЦикла;	
	ДокументОбъект.СтрокаЗалогодатели = Результат; 
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыПриказа(ДокументОбъект) Экспорт 
	ЗапросБазовыеЦены = Новый Запрос;
	ЗапросБазовыеЦены.Текст = "ВЫБРАТЬ
	                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.Период КАК Период,
	                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.Проба КАК Проба,
	                          |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.КатегорияОбъектаЗалога КАК Категория
	                          |ИЗ
	                          |	РегистрСведений.ЛБ_БазовыеЦеныНаДрагоценныеМеталлы КАК ЛБ_БазовыеЦеныНаДрагоценныеМеталлы
	                          |
	                          |УПОРЯДОЧИТЬ ПО
	                          |	Период";
	//ТаблицаБазовыеЦены = ЗапросБазовыеЦены.Выполнить().Выгрузить();
	ТаблицаБазовыеЦены.Загрузить(ЗапросБазовыеЦены.Выполнить().Выгрузить());

	//+МАН 11.11.24 Изменение установки булева. Заявка 2792
	//Было:
	//ДокументОбъект.ЕстьМеталлы = ?(ДокументОбъект.ЦеныМеталлы.Количество() = 0, ложь, Истина);
	//ДокументОбъект.ЕстьВставки = ?(ДокументОбъект.ЦеныВставки.Количество() = 0, ложь, Истина);
	//ДокументОбъект.ЕстьПроцентныеСтавки = ?(ДокументОбъект.СтавкиПроцентов.Количество() = 0, ложь, Истина);
	////
	
	//+МАН 25.08.25 добавил проверку на на наличие не нулевых ставок
	Если ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ВИП Тогда
		МассивУдаленияСтрок = Новый Массив;
		
		ТЗСтавки = ДокументОбъект.СтавкиПроцентов.Выгрузить(, "Ставка");
		
		Для каждого СтрС Из ТЗСтавки Цикл
			Если СтрС.Ставка = 0 Тогда
				МассивУдаленияСтрок.Добавить(СтрС);
			КонецЕсли;			
		КонецЦикла;
		
		Если МассивУдаленияСтрок.Количество() > 0 Тогда
			Для каждого СтрМ Из МассивУдаленияСтрок Цикл
				ТЗСтавки.Удалить(СтрМ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	//-МАН
	
	//+МАН 25.08.25 Изменил
	Если ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ВИП Тогда
		ДокументОбъект.ЕстьМеталлы = ?(ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() = 0, Ложь, Истина);
		ДокументОбъект.ЕстьВставки = ?(ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() = 0, Ложь, Истина);
		//ДокументОбъект.ЕстьПроцентныеСтавки = ?(ДокументОбъект.СтавкиПроцентов.Количество() = 0, Ложь, Истина);
		ДокументОбъект.ЕстьПроцентныеСтавки = ?(ТЗСтавки.Количество() = 0, Ложь, Истина);
	Иначе
		ДокументОбъект.ЕстьМеталлы = ?(ДокументОбъект.ОтменаМеталлов, Истина, Ложь);
		ДокументОбъект.ЕстьВставки = ?(ДокументОбъект.ОтменаВставкок, Истина, Ложь);
		ДокументОбъект.ЕстьПроцентныеСтавки = ?(ДокументОбъект.ОтменаСтавок, Истина, Ложь);
	КонецЕсли;
	//-МАН
	
	ДокументОбъект.КоличествоЗалогодателей = ДокументОбъект.Залогодатели.Количество(); 
	Если ДокументОбъект.ЕстьМеталлы Тогда
		Проба = Справочники.ЛБ_Пробы.ПустаяСсылка(); 
		Категория = Справочники.ЛБ_КатегорииОбъектовЗалога.ПустаяСсылка();
		Для каждого СтрБ Из ТаблицаБазовыеЦены Цикл                                
			Если СтрБ.Период > НачалоДня(ДокументОбъект.Дата) Тогда
				Прервать;
			КонецЕсли;
			Проба = СтрБ.Проба;
			Категория = СтрБ.Категория;
		КонецЦикла;	 
		Отбор = Новый Структура;
		Отбор.Вставить("Проба", Проба); 
		Отбор.Вставить("КатегорияОбъектаЗалога", Категория);
	    Строки = ДокументОбъект.ЦеныМеталлы.НайтиСтроки(Отбор);
		МаксЦена = 0;
		Если НЕ Строки.Количество() = 0 Тогда
		    МаксЦена = Строки[0].Цена;
		КонецЕсли;		

		ДокументОбъект.БазоваяЦенаМеталлы = МаксЦена; 
	КонецЕсли;
	
	//+МАН 25.08.25 Изменил условие
	//Если ДокументОбъект.ЕстьПроцентныеСтавки Тогда
	Если ДокументОбъект.ЕстьПроцентныеСтавки И ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ВИП Тогда
	//-МАН
		ТЗМакс = ДокументОбъект.СтавкиПроцентов.Выгрузить(,"Ставка");
		ТЗМакс.Сортировать("Ставка Убыв");
	    ДокументОбъект.МаксимальнаяПроцентнаяСтавка = ТЗМакс[0].Ставка; 
	КонецЕсли;	

КонецПроцедуры	 

