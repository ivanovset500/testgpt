		НовыйДок.НомерСистемныйЧисло = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(НовыйДок.Номер);
		НовыйДок.Записать();

		Если КонПериода < НовыйДок.Дата Тогда
			КонПериода = НовыйДок.Дата;
		КонецЕсли;	
		ЗаполнитьТаблицуПриказов();
	Иначе
		НовыйДок = Документы.ЛБ_ПриказИндивидуальныеУсловия.СоздатьДокумент(); 
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Проект;  
		НовыйДок.ВидОперации = ВидОперации;
		НовыйДок.НомерПриказа = "";  
		НовыйДок.ДатаНачалаДействияПриказа = Дата(1,1,1); 
		НовыйДок.Ответственный = Пользователи.ТекущийПользователь();
		//+МАН 29.07.25 Заполняем настройки печати. Заявка 2792
		ЗаполнитьНастройкиПечатиВНовомДокументе(НовыйДок);
		//-МАН
		НовыйДок.Записать();  

		НовыйДок.НомерСистемныйЧисло = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(НовыйДок.Номер);
		НовыйДок.Записать();

		Если КонПериода < НовыйДок.Дата Тогда
			КонПериода = НовыйДок.Дата;
		КонецЕсли;	
		ЗаполнитьТаблицуПриказов();
	КонецЕсли;
	//-Мельников
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкиПечатиВНовомДокументе(НовыйДок)
	Если ЗначениеЗаполнено(Константы.ЛБ_НачальникОРБ.Получить()) Тогда
		НовыйДок.НачальникОРБ = Константы.ЛБ_НачальникОРБ.Получить();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.ЛБ_ОтветственноеЛицоОРБ.Получить()) Тогда
		НовыйДок.ОтветственноеЛицоОРБ = Константы.ЛБ_ОтветственноеЛицоОРБ.Получить();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.ЛБ_НачальникОДО.Получить()) Тогда
		НовыйДок.НачальникОДО = Константы.ЛБ_НачальникОДО.Получить();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.ЛБ_Подписант.Получить()) Тогда
		НовыйДок.ПодписантФИО = Константы.ЛБ_Подписант.Получить();
		НовыйДок.ПодписантДолжность = Константы.ЛБ_Подписант.Получить().Должность;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПриказ(Команда)
	ВидыПриказа = Новый СписокЗначений;
    ВидыПриказа.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ВИП")); //+Мельников 28.08.24 ВИП. Заявка 2792
	ВидыПриказа.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП"));
    
    ОповещениеПослеВыбораЭлемента = Новый ОписаниеОповещения("ПослеВыбораВидаОперацииПриказа", ЭтаФорма);//Элементы.ТаблицаПриказовДобавить);
 
    ВидыПриказа.ПоказатьВыборЭлемента(ОповещениеПослеВыбораЭлемента, "Выберите вид операции");
 
КонецПроцедуры
 
&НаКлиенте
Процедура ПослеВыбораВидаОперацииПриказа(Элемент, Параметры) Экспорт
 
	Если Элемент <> Неопределено Тогда 
		ДобавитьПриказСервер(Элемент.Значение); 
	КонецЕсли;
 
КонецПроцедуры

&НаСервере
Процедура КопироватьПриказСервер(ИдентификаторСтроки)  
	Стр = ТаблицаПриказов.НайтиПоИдентификатору(ИдентификаторСтроки); 
	Если Стр = неопределено Тогда
        Возврат;
	КонецЕсли;	
	ДокументКопия = Стр.Ссылка.Скопировать();
    ДокументКопия.Дата = ТекущаяДата();	
	ДокументКопия.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Проект;
	ДокументКопия.НомерПриказа = "";  
	ДокументКопия.ДатаНачалаДействияПриказа = Дата(1,1,1); 
	ДокументКопия.Ответственный = Пользователи.ТекущийПользователь();
    ДокументКопия.Записать();
	Если КонПериода < ДокументКопия.Дата Тогда
		КонПериода = ДокументКопия.Дата;
	КонецЕсли;	
	ЗаполнитьТаблицуПриказов();
КонецПроцедуры

&НаКлиенте
Процедура КопироватьПриказ(Команда)
	ТекСтрока = Элементы.ТаблицаПриказов.ТекущиеДанные;	
	Если НЕ ТекСтрока = неопределено Тогда
		ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
		КопироватьПриказСервер(ИдентификаторСтроки);  
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Процедура ПометитьНаУдалениеСервер(ИдентификаторСтроки) 
	Стр = ТаблицаПриказов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Стр = неопределено Тогда
       Возврат;
	КонецЕсли;   
	ДокОбъект =  Стр.Ссылка.ПолучитьОбъект();
	Если ДокОбъект.ПометкаУдаления Тогда
	    ДокОбъект.УстановитьПометкуУдаления(Ложь);
	    Стр.СостояниеДокумента = 0; 
	Иначе
		Если ДокОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
			Ставки = ПроверитьСтавки(ДокОбъект.Ссылка);
			Металлы = ?(ДокОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Количество() > 0, Истина, Ложь);
			Вставки = ?(ДокОбъект.НастройкаОтклоненийОтБазовыхЦенВставки.Количество() > 0, Истина, Ложь);
			
			СтруктураВозврата = НайтиДокументыОтмены(ДокОбъект.ОтменяемыйПриказ, ДокОбъект.Ссылка, Ставки, Металлы, Вставки);
			
			Отбор = Новый Структура;
			
			Если ЗначениеЗаполнено(ДокОбъект.ОтменяемыйПриказ) Тогда 
				ДокОбъектОтменяемый = ДокОбъект.ОтменяемыйПриказ.ПолучитьОбъект();
				
				Для каждого СтрЗ Из ДокОбъект.Залогодатели Цикл
					
					Отбор.Вставить("Залогодатель", СтрЗ.Залогодатель);
					
					Массивзалогодателей = ДокОбъектОтменяемый.Залогодатели.НайтиСтроки(Отбор);
					
					Для каждого СтрМ Из Массивзалогодателей Цикл
						Если Ставки И НЕ СтруктураВозврата.Ставки Тогда
							СтрМ.НетСтавок = Ложь;
						КонецЕсли;
						
						Если Металлы И НЕ СтруктураВозврата.Металлы Тогда
							СтрМ.НетМеталлов = Ложь;
						КонецЕсли;
						
						Если Вставки И НЕ СтруктураВозврата.Вставки Тогда
							СтрМ.НетВставок = Ложь;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				
				ДокОбъектОтменяемый.Записать();
			КонецЕсли;
		КонецЕсли;
		
		ДокОбъект.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Проект;
		ДокОбъект.Записать();
		
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	    Стр.СостояниеДокумента = 2;
		
		ЗаполнитьТаблицуПриказов();
	КонецЕсли;   
	//ЗаполнитьТаблицуПриказов();
КонецПроцедуры	

&НаСервере
Функция НайтиДокументыОтмены(ДокУстановки, ДокОтмены, Ставки = Ложь, Металлы = Ложь, Вставки = Ложь)
	
	СтруктураВозврата = Новый Структура("Ставки, Металлы, Вставки");
	
	Если Ставки Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор.ОтменяемыйПриказ = &ОтменяемыйПриказ
		|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор <> &Регистратор
		|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор.ВидОперации = &ВидОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период УБЫВ";
		
		Запрос.УстановитьПараметр("ОтменяемыйПриказ", ДокУстановки);
		Запрос.УстановитьПараметр("Регистратор", ДокОтмены);
		Запрос.УстановитьПараметр("ВидОперации", Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			Став = Истина;
		Иначе
			Став = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Металлы Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор.ОтменяемыйПриказ = &ОтменяемыйПриказ
		|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор <> &Регистратор
		|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор.ВидОперации = &ВидОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период УБЫВ";
		
		Запрос.УстановитьПараметр("ОтменяемыйПриказ", ДокУстановки);
		Запрос.УстановитьПараметр("Регистратор", ДокОтмены);
		Запрос.УстановитьПараметр("ВидОперации", Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			Мет = Истина;
		Иначе
			Мет = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если Вставки Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок КАК ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок
		|ГДЕ
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор.ОтменяемыйПриказ = &ОтменяемыйПриказ
		|	И ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор <> &Регистратор
		|	И ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор.ВидОперации = &ВидОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период УБЫВ";
		
		Запрос.УстановитьПараметр("ОтменяемыйПриказ", ДокУстановки);
		Запрос.УстановитьПараметр("Регистратор", ДокОтмены);
		Запрос.УстановитьПараметр("ВидОперации", Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			Встав = Истина;
		Иначе
			Встав = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураВозврата.Ставки = Став;
	СтруктураВозврата.Металлы = Мет;
	СтруктураВозврата.Вставки = Встав;
	
	Возврат СтруктураВозврата;

КонецФункции

&НаСервере
Функция ПроверитьСтавки(Ссылка)
	ТЗ = Ссылка.СтавкиПроцентов.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнешнийИсточник.Ставка КАК Ставка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ВТ.Ставка) КАК Ставка
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.Ставка > 0";
	
	Запрос.УстановитьПараметр("ВнешнийИсточник", ТЗ);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Если Результат.Ставка > 0 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
	
