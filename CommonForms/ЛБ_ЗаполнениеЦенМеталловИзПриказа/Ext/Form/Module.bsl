&НаКлиенте
Процедура ТаблицаНПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если  НоваяСтрока И Не Копирование Тогда
	    ТекстрокаМ = Элементы.ТаблицаМ.ТекущиеДанные;  
		ТекстрокаН = Элементы.ТаблицаН.ТекущиеДанные; 
		ТекстрокаН.Металл = ТекстрокаМ.Металл;
		ТекстрокаН.Проба = ТекстрокаМ.Проба;
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ПоГруппамПробПриИзменении(Элемент)  
	ПоГруппам = ?(ПоГруппамПроб, ложь, истина); 
	Элементы.ТаблицаМПроба.Заголовок = ?(ПоГруппамПроб, "Группа проб", "Проба");
	СохранитьИзмененияМеталловСФормы(ПоГруппам);
	ТаблицаМ.Очистить();
	//ТаблицаН.Очистить(); 
	ЗаполнитьТаблицыИзПриказа(Истина);
	УстановитьУсловноеОформление();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСценарию()
	Если НЕ УсловноеОформление.Элементы.Количество() = 0 Тогда 
		СохранитьИзмененияМеталловСФормы(ПоГруппамПроб);
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор", Приказ.ШаблонМеталлы);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.Металл КАК Металл,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.Проба КАК Проба,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.Категория КАК Категория,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.БазоваяНастройка КАК БазоваяНастройка,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.БазоваяЦена КАК БазоваяЦена,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.ОклонениеОтБазовой КАК ОклонениеОтБазовой,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.ЗначениеОтклонения КАК ЗначениеОтклонения,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.ПорядокОкругления КАК ПорядокОкругления,
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.ОкруглятьВБольшуюСторону КАК ОкруглятьВБольшуюСторону
		               |ИЗ
		               |	РегистрСведений.ЛБ_ТекущийШаблонПриказаМеталлы КАК ЛБ_ТекущийШаблонПриказаМеталлы
		               |ГДЕ
		               |	ЛБ_ТекущийШаблонПриказаМеталлы.Регистратор = &Регистратор";
		ШаблонМеталлов = Запрос.Выполнить().Выгрузить(); 
		ТаблицаДоп = ШаблонМеталлов.Скопировать(); 
		ТаблицаДоп.Свернуть("Металл");
		
		Для каждого СтрМ Из ТаблицаДоп Цикл 
			ЦенаБазовая = 0;
			Отбор = новый Структура;
			Отбор.Вставить("БазоваяНастройка", Истина);
			Отбор.Вставить("Металл", СтрМ.Металл);
			Строки = ТаблицаМеталлов.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 Тогда
				ЦенаБазовая = Строки.Получить(0).Цена;
			КонецЕсли;

			Для каждого Стр Из ШаблонМеталлов Цикл
				Если НЕ Стр.Металл = СтрМ.Металл Тогда
					Продолжить;
				КонецЕсли;	
				Отбор = Новый Структура;
				Отбор.Вставить("Металл", Стр.Металл);
				Отбор.Вставить("Проба", Стр.Проба);
				Отбор.Вставить("КатегорияОбъектаЗалога", Стр.Категория);
				СтрокиМ = ТаблицаМеталлов.НайтиСтроки(Отбор); 
				Если НЕ СтрокиМ.Количество() = 0 Тогда
					СтрМ = СтрокиМ.Получить(0);
				  	Если Стр.БазоваяНастройка Тогда 
						 СтрМ.Цена = ЦенаБазовая;
					 Иначе
						 Если Стр.ОклонениеОтБазовой = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное Тогда  
							 СтрМ.Цена = ЦенаБазовая + стр.ЗначениеОтклонения;
						 ИначеЕсли Стр.ОклонениеОтБазовой = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Относительное Тогда
							 СтрМ.Цена = ЦенаБазовая + ЦенаБазовая*стр.ЗначениеОтклонения/100;
						 КонецЕсли;	  
						 Если ЗначениеЗаполнено(Стр.ПорядокОкругления) Тогда     
							 СтрМ.Цена = ЛБ_ОбщийМодуль.ОкруглитьЦену(СтрМ.Цена, Стр.ПорядокОкругления, Стр.ОкруглятьВБольшуюСторону);
						 КонецЕсли;	 
					 КонецЕсли;	 
				КонецЕсли;	 
			КонецЦикла; 
		КонецЦикла;	
        ТаблицаМ.Очистить();
		ЗаполнитьТаблицыИзПриказа(Истина);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаМПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования) 
	ЗаполнитьПоСценарию();
КонецПроцедуры

&НаСервере
Функция ПроверитьОтказРедактирования(Проба, КатегорияИмя) 
	Если НЕ УсловноеОформление.Элементы.Количество() = 0 Тогда
		ЕстьПроба = Ложь; 
		ЕстьКатегория = Ложь;
		Для сч = 0 По УсловноеОформление.Элементы.Количество() - 1 Цикл 
			Если УсловноеОформление.Элементы.Получить(сч).Отбор.Элементы.Получить(0).ПравоеЗначение = Проба Тогда
				ЕстьПроба = Истина; 
			КонецЕсли;
			Если СокрЛП(УсловноеОформление.Элементы.Получить(сч).Поля.Элементы.Получить(0).Поле) = КатегорияИмя Тогда 
				ЕстьКатегория = Истина;
			КонецЕсли;
			Если ЕстьПроба И ЕстьКатегория Тогда 
				Прервать;
			КонецЕсли;	
		Конеццикла;	
		Если НЕ ЕстьПроба ИЛИ НЕ ЕстьКатегория Тогда
			Возврат Истина;
		КонецЕсли;	  
	КонецЕсли;	
    Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ТаблицаМПередНачаломИзменения(Элемент, Отказ)	
	ТекСтрока = Элементы.ТаблицаМ.ТекущиеДанные; 
    ТекЭлемент = Элементы.ТаблицаМ.ТекущийЭлемент;
	
	Если ПроверитьОтказРедактирования(ТекСтрока.Проба, ТекЭлемент.Имя) Тогда
		Отказ = Истина;
	КонецЕсли;	                                                                    
КонецПроцедуры

