
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Документ") Тогда
		Приказ = Параметры.Документ.Ссылка;  
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Приказ) Тогда 
		Сообщить("Не выбран приказ!");
		Возврат;
	КонецЕсли;   
	
	Если Параметры.ТолькоПросмотр = Истина Тогда
		Элементы.СохранитьИзменения.Доступность = ложь; 
		Элементы.ТаблицаМ.ТолькоПросмотр = Истина;  
		Элементы.ТаблицаН.ТолькоПросмотр = Истина;  
	КонецЕсли;	
	
	ТаблицаМеталлов.Загрузить(Приказ.ЦеныМеталлы.Выгрузить());
	ТаблицаНастроек.Загрузить(Приказ.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить());
	
	ПоГруппамПроб = Истина;
	
	КатегорииДоп = ТаблицаМеталлов.Выгрузить(, "КатегорияОбъектаЗалога");
	КатегорииДоп.Свернуть("КатегорияОбъектаЗалога");   
	
	КлючСтроки = 0; 
	Категории.Очистить();
	Для каждого СтрД Из КатегорииДоп Цикл 
		КлючСтроки = КлючСтроки + 1;
		НоваяСтрД = Категории.Добавить(); 
		НоваяСтрД.КлючСтроки = КлючСтроки; 
		НоваяСтрД.Категория = СтрД.КатегорияОбъектаЗалога;
	КонецЦикла;
	
	Для каждого СтрД Из Категории Цикл
	    ДобавитьКолонкуДоп(СтрД.КлючСтроки, СтрД.Категория);
	КонецЦикла;   
		
	ЗаполнитьТаблицыИзПриказа(); 
	УстановитьУсловноеОформление();
	
	МассивСК = Новый Массив;
	Для каждого СтрК Из Приказ.СхемыКредитования Цикл
		МассивСК.Добавить(СтрК.СхемаКредитования);
	Конеццикла;	
	Элементы.ТаблицаНСхемаКредитования.СписокВыбора.ЗагрузитьЗначения(МассивСК);
КонецПроцедуры


&НаСервере
Процедура УстановитьУсловноеОформление() 
	УсловноеОформление.Элементы.Очистить();

	Для каждого Стр Из ТаблицаМеталлов Цикл 
		Если НЕ стр.БазоваяНастройка Тогда
			Продолжить;
		КонецЕсли;	
			
		ЭлементОформления = УсловноеОформление.Элементы.Добавить(); 
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина,));

		// Создаем условие отбора
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаМ.Проба"); 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		Если ПоГруппамПроб Тогда
			Проба = ЛБ_ОбщийМодуль.ПолучитьГруппуПроб(Стр.Проба);
		Иначе	
		    Проба = Стр.Проба;
		КонецЕсли;
		ЭлементОтбора.ПравоеЗначение = Проба;
        ЭлементОтбора.Использование = Истина;		
			
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить(); 
		Отбор = Новый Структура;
		Отбор.Вставить("Категория", Стр.КатегорияОбъектаЗалога);
		СтрокиК = Категории.НайтиСтроки(Отбор);
		Ключ = СтрокиК.Получить(0).КлючСтроки;
		ИмяПоляФормы = "Категория_" + СокрЛП(Ключ);
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляФормы); 		
		ПолеОформления.Использование = Истина; 	   
				
		ЭлементОформления = УсловноеОформление.Элементы.Добавить(); 
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

		// Создаем условие отбора
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаМ.Проба"); 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		Если ПоГруппамПроб Тогда
			Проба = ЛБ_ОбщийМодуль.ПолучитьГруппуПроб(Стр.Проба);
		Иначе	
		    Проба = Стр.Проба;
		КонецЕсли;
		ЭлементОтбора.ПравоеЗначение = Проба;
        ЭлементОтбора.Использование = Истина;		
			
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить(); 
		Отбор = Новый Структура;
		Отбор.Вставить("Категория", Стр.КатегорияОбъектаЗалога);
		СтрокиК = Категории.НайтиСтроки(Отбор);
		Ключ = СтрокиК.Получить(0).КлючСтроки;
		ИмяПоляФормы = "Категория_" + СокрЛП(Ключ);
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляФормы); 		
		ПолеОформления.Использование = Истина; 	   
				
	   // Если ПоГруппамПроб Тогда
       //   Прервать;
       //КонецЕсли; 
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыИзПриказа(БезНастроек = Ложь) 		
	ТаблицаМеталловДоп = ТаблицаМеталлов.Выгрузить();
	ТаблицаМеталловДоп.Свернуть("Металл, Проба");
	
	ТаблицаМ.Очистить();
	Для каждого Стр Из ТаблицаМеталловДоп Цикл  
		Если ПоГруппамПроб Тогда
			Проба = ЛБ_ОбщийМодуль.ПолучитьГруппуПроб(Стр.Проба);
		Иначе
			Проба = Стр.Проба;
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("Проба", Проба);
		Строки = ТаблицаМ.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтр = ТаблицаМ.Добавить();		 
		НоваяСтр.Металл = Стр.Металл; 
		НоваяСтр.Проба = Проба; 
							
		ОтборМ = Новый Структура;
		ОтборМ.Вставить("Металл", Стр.Металл);
		ОтборМ.Вставить("Проба", Стр.Проба);
		Для каждого СтрК Из Категории Цикл
			ОтборМ.Вставить("КатегорияОбъектаЗалога", СтрК.Категория);
			СтрокиМ = ТаблицаМеталлов.НайтиСтроки(ОтборМ);
			Если НЕ СтрокиМ.Количество() = 0 Тогда 
				СтрМ = СтрокиМ.Получить(0);
			    НоваяСтр["Категория_" + Строка(СтрК.КлючСтроки)] = СтрМ.Цена;
			КонецЕсли;	
        Конеццикла;
	Конеццикла;	  
	
	Если БезНастроек Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаНастроекДоп = ТаблицаНастроек.Выгрузить();
	ТаблицаНастроекДоп.Свернуть("Металл, Проба, СхемаКредитования, ОтклонениеОтБазовойЦены");
	
	ТаблицаН.Очистить();
	Для каждого Стр Из ТаблицаНастроекДоп Цикл 
		Отбор = Новый Структура;
		Отбор.Вставить("Проба", Стр.Проба);
		Строки = ТаблицаН.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	

		НоваяСтр = ТаблицаН.Добавить();		 
		НоваяСтр.Металл = Стр.Металл; 
		НоваяСтр.Проба = Проба;   
		НоваяСтр.СхемаКредитования = Стр.СхемаКредитования;
		НоваяСтр.Отклонение = Стр.ОтклонениеОтБазовойЦены;
				
		ОтборМ = Новый Структура;
		ОтборМ.Вставить("Металл", Стр.Металл);
		ОтборМ.Вставить("Проба", Стр.Проба); 
		ОтборМ.Вставить("СхемаКредитования", Стр.СхемаКредитования);
		ОтборМ.Вставить("ОтклонениеОтБазовойЦены", Стр.ОтклонениеОтБазовойЦены);
		Для каждого СтрК Из Категории Цикл 
			ОтборМ.Вставить("КатегорияОбъектаЗалога", СтрК.Категория);
			СтрокиМ = ТаблицаНастроек.НайтиСтроки(ОтборМ);
			Если НЕ СтрокиМ.Количество() = 0 Тогда 
				СтрМ = СтрокиМ.Получить(0);
			    НоваяСтр["КатегорияН_" + Строка(СтрК.КлючСтроки)] = СтрМ.ЗначениеОтклонения;
			Иначе
				ОтборМ.Вставить("КатегорияОбъектаЗалога", Справочники.ЛБ_КатегорииОбъектовЗалога.ПустаяСсылка());
			    СтрокиМ = ТаблицаНастроек.НайтиСтроки(ОтборМ);
                Если НЕ СтрокиМ.Количество() = 0 Тогда 
					СтрМ = СтрокиМ.Получить(0);
				    НоваяСтр["КатегорияН_" + Строка(СтрК.КлючСтроки)] = СтрМ.ЗначениеОтклонения;
				КонецЕсли;	
			КонецЕсли;	
        Конеццикла;
	Конеццикла;	

КонецПроцедуры   

&НаСервере
Процедура ДобавитьКолонкуДоп(КлючСтроки, Категория)
	МассивДобавляемыхРеквизитов = Новый Массив; 
	СписокТипов = Новый Массив;
    СписокТипов.Добавить(Тип("Число"));
    ОписаниеСоставногоТипа = Новый ОписаниеТипов(СписокТипов,,,Новый КвалификаторыЧисла(10,3));
	НовыйРеквизит = Новый РеквизитФормы("Категория_" + СокрЛП(КлючСтроки), ОписаниеСоставногоТипа, "ТаблицаМ");
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);  
	НовыйРеквизит = Новый РеквизитФормы("КатегорияН_" + СокрЛП(КлючСтроки), ОписаниеСоставногоТипа, "ТаблицаН");
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	 
	ПолеВвода = Элементы.Добавить(
		"Категория_" + СокрЛП(КлючСтроки),    //Имя элемента формы
		Тип("ПолеФормы"), //Тип, всегда ПолеФормы
		Элементы.ТаблицаМ); //Контейнер для поля ввода (Форма,Группа,Страница)
		
	ПолеВвода.Заголовок = СокрЛП(Категория);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;   
	
		
	//Установка связи элемента с данными
	ПолеВвода.ПутьКДанным = "ТаблицаМ.Категория_" + СокрЛП(КлючСтроки); 
	ПолеВвода.ВыбиратьТип = Ложь;
	ПолеВвода.КнопкаСоздания = Ложь;
	ПолеВвода.КнопкаОткрытия = Ложь;  
	
	ПолеВвода = Элементы.Добавить(
		"КатегорияН_" + СокрЛП(КлючСтроки),    //Имя элемента формы
		Тип("ПолеФормы"), //Тип, всегда ПолеФормы
		Элементы.ТаблицаН); //Контейнер для поля ввода (Форма,Группа,Страница)
		
	ПолеВвода.Заголовок = СокрЛП(Категория);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	
	//Установка связи элемента с данными
	ПолеВвода.ПутьКДанным = "ТаблицаН.КатегорияН_" + СокрЛП(КлючСтроки); 
	ПолеВвода.ВыбиратьТип = Ложь;
	ПолеВвода.КнопкаСоздания = Ложь;
	ПолеВвода.КнопкаОткрытия = Ложь;

КонецПроцедуры	

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	СохранитьПриказ();
	ЭтаФорма.Закрыть(Истина);
КонецПроцедуры

&НаСервере
Процедура СохранитьПриказ()
	СохранитьИзмененияМеталловСФормы(ПоГруппамПроб);
	ДокументОбъект = Приказ.ПолучитьОбъект();
	ДокументОбъект.ЦеныМеталлы.Загрузить(ТаблицаМеталлов.Выгрузить());
	ДокументОбъект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Загрузить(ТаблицаНастроек.Выгрузить());
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияМеталловСФормы(ПоГруппам) 
	Если ПоГруппам Тогда 
		Для каждого Стр Из ТаблицаМ Цикл 
			Для каждого СтрП Из Стр.Проба.Пробы Цикл 
				Отбор = Новый Структура;
				Отбор.Вставить("Металл", Стр.Металл);
				Отбор.Вставить("Проба", СтрП.Проба);
						
				СтрокиС = ТаблицаМеталлов.НайтиСтроки(Отбор);
				Для каждого СтрС Из СтрокиС Цикл 
					ОтборД = Новый Структура;  
					ОтборД.Вставить("Категория", СтрС.КатегорияОбъектаЗалога);
					СтрокиД = Категории.НайтиСтроки(ОтборД); 
					Если НЕ СтрокиД.Количество() = 0 Тогда
						КлючСтроки = СтрокиД.Получить(0).КлючСтроки;
						СтрС.Цена = Стр["Категория_" + Строка(КлючСтроки)];
					КонецЕсли;	
				Конеццикла;	
			КонецЦикла;	
		КонецЦикла;	  
	Иначе	
		Для каждого Стр Из ТаблицаМ Цикл  
			Отбор = Новый Структура;
			Отбор.Вставить("Металл", Стр.Металл);
			Отбор.Вставить("Проба", Стр.Проба);
					
			СтрокиС = ТаблицаМеталлов.НайтиСтроки(Отбор);
			Для каждого СтрС Из СтрокиС Цикл 
				ОтборД = Новый Структура;  
				ОтборД.Вставить("Категория", СтрС.КатегорияОбъектаЗалога);
				СтрокиД = Категории.НайтиСтроки(ОтборД); 
				Если НЕ СтрокиД.Количество() = 0 Тогда
					КлючСтроки = СтрокиД.Получить(0).КлючСтроки;
					СтрС.Цена = Стр["Категория_" + Строка(КлючСтроки)];
				КонецЕсли;	
			Конеццикла;	
		Конеццикла;	  
	КонецЕсли;   
	
	ТаблицаНастроек.Очистить();
	Для каждого Стр Из ТаблицаН Цикл   
		Для каждого СтрК Из Категории Цикл 
			КлючСтроки = СтрК.КлючСтроки;
			ЗначениеОтклонения = Стр["КатегорияН_" + Строка(КлючСтроки)]; 
			Если ЗначениеОтклонения = 0 Тогда
				Продолжить;
	        КонецЕсли;
			НоваяСтрН = ТаблицаНастроек.Добавить();
			НоваяСтрН.Металл = Стр.Металл;
			НоваяСтрН.Проба = Стр.Проба;
			НоваяСтрН.СхемаКредитования = Стр.СхемаКредитования;
			НоваяСтрН.ОтклонениеОтБазовойЦены = Стр.Отклонение;
			НоваяСтрН.КатегорияОбъектаЗалога = СтрК.Категория;
			НоваяСтрН.ЗначениеОтклонения = ЗначениеОтклонения;
		Конеццикла;	
	Конеццикла;	

КонецПроцедуры	


