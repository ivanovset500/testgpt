	Возврат Ссылка.Ломбард;
КонецФункции

&НаСервере
Процедура УстановитьВидимость()

	ПроверкаПоследующихОпереаций = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, ТекущаяДата(),,Истина);
	ЛомбардПользователя = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	Если ДокументИзъятия.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда 
		Если ДокументИзъятия.Проведен И НачалоДня(ТекущаяДатаСеанса()) = НачалоДня(ДатаДок) И
			?(ЗначениеЗаполнено(ДокументИзъятия), ?(ПроверкаПоследующихОпереаций = Неопределено, Истина, ?(ПроверкаПоследующихОпереаций.Регистратор = ДокументИзъятия, Истина, Ложь)), Ложь) Тогда
			
			Элементы.ОтменитьОперацию.Доступность = Истина;
		Иначе
			Элементы.ОтменитьОперацию.Доступность = Ложь;
		КонецЕсли; 
	Иначе	
		Если ДокументИзъятия.Проведен И НЕ ТекущаяДата() - ДатаДок >= 3600 И ЛомбардПользователя = ДокументИзъятия.Ломбард И
			?(ЗначениеЗаполнено(ДокументИзъятия), ?(ПроверкаПоследующихОпереаций = Неопределено, Истина, ?(ПроверкаПоследующихОпереаций.Регистратор = ДокументИзъятия, Истина, Ложь)), Ложь) Тогда
			
			Элементы.ОтменитьОперацию.Доступность = Истина;
		Иначе
			Элементы.ОтменитьОперацию.Доступность = Ложь;
		КонецЕсли; 
	КонецЕсли;	

	//+МАН 17.06.25 Изменил
	//Если ЗначениеЗаполнено(ДокументИзъятия.ДокументОтмены) Тогда
	Если ЗначениеЗаполнено(ДокументОтмены) Тогда
	    Элементы.ГруппаОтмена.Видимость = Истина;
		//+Мельников 28.05.24
		Элементы.Расчеты.Доступность = Ложь;
		Элементы.Редактировать.Доступность = Ложь;
		//-Мельников
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОтменыНажатие(Элемент, СтандартнаяОбработка)
	
	Если ПолучитьВидОперации(ДокументОтмены) = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия") Тогда 
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Документ", ДокументОтмены);    
		ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаОперацииПоЗайму", ПараметрыФормы, ЭтаФорма, Истина,,,);	
	Иначе                           
		СтандартнаяОбработка = Истина;
	КонецЕсли;

КонецПроцедуры

