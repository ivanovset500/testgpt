Функция ПолучитьЗалогодателя()
	Возврат  ЗалоговыйБилет.Залогодатель;
КонецФункции

&НаКлиенте
Процедура СтатистикаПоКлиенту(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Клиент", ПолучитьЗалогодателя());
	ПараметрыФормы.Вставить("Дата", ДатаДок);	 
							
	ОткрытьФорму("Отчет.ЛБ_СтатистикаОбращенийКлиента.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура Расчеты(Команда)
	ПараметрыФормы = Новый Структура;  
	ПараметрыФормы.Вставить("Клиент", ПолучитьЗалогодателя());
	ПараметрыФормы.Вставить("ЗалоговыйБилет", ЭтаФорма.ЗалоговыйБилет);	
	ПараметрыФормы.Вставить("Дата", ЭтаФорма.ДатаДок);
							
	ОткрытьФорму("Отчет.ЛБ_НачисленныеПроцентыПоДоговоруЗайма.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	ЗаполнитьТовары(); 
	ЗаполнитьСостояниеЗалоговогоБилета();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

//+Мельников 25.04.24 Отмена операции
&НаКлиенте
Процедура ОтменитьОперацию(Команда)

	ПоследняяОперация = ПолучитьИнформациюОЗБ(ЗалоговыйБилет, ТекущаяДата());
	ЛомбардПользователя = ПолучитьЛомбардПольвателя();
	ЛомбардВДокументе = ПолучитьЛомбардВдокументе(ПоследняяОперация.ДокументОперации);
	
	Если ЛомбардВДокументе = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис") И СотрудникЦО Тогда 
		Если Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") <> Формат(ПоследняяОперация.Дата, "ДФ=dd.MM.yyyy") Тогда
			Предупреждение("Отмена операции возможна только в текущем дне.");
			Возврат;
        КонецЕсли;
	Иначе	
		Если ЛомбардПользователя <> ЛомбардВДокументе Тогда
			Предупреждение("Операция оформлена в другом ломбарде.
			|Действия с документом запрещены!");
			Возврат
		ИначеЕсли Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") <> Формат(ПоследняяОперация.Дата, "ДФ=dd.MM.yyyy") Тогда
			Предупреждение("Отмена операции возможна только в текущем дне.");
			Возврат
		ИначеЕсли ТекущаяДата() - ДатаДок >= 3600 Тогда
			Предупреждение("Прошло больше часа от времени оформления текущей операции.");
			Возврат  
		КонецЕсли;	
	КонецЕсли;
		
	Ответ = Вопрос("Выполнить отмену текущей операции?", РежимДиалогаВопрос.ДаНет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДокументПроведен = ОтменитьОперациюНаСервере();
		УстановитьВидимость();
		ОбновитьИнтерфейс();
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ДокументПроведен Тогда
		Сообщить("Документ отмены создан");   
		Если ВладелецФормы.ИмяФормы = "ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда" Тогда
   	        ФормаРМП = ВладелецФормы;   
			Если ФормаРМП.Залогодатель = ПолучитьЗалогодателя() Тогда
                ФормаРМП.ПослеВыбораТекущееСостояниеЗБ(Истина, неопределено); 
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция ОтменитьОперациюНаСервере()
	
	ДокументОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	ДокументОбъект.Дата = ТекущаяДата();
	ДокументОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия;  
	ДокументОбъект.ПредыдущаяОперация = ЗалоговыйБилет;
	ДокументОбъект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
	ДокументОбъект.СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ДокументОбъект.Дата, ДокументОбъект.ПредыдущаяОперация.Залогодатель); 
	ДокументОбъект.Залогодатель = ЗалоговыйБилет.Залогодатель;  
	ДокументОбъект.ДокументЗалогодателя = ЗалоговыйБилет.ДокументЗалогодателя;
	ДокументОбъект.СхемаКредитования = ЗалоговыйБилет.СхемаКредитования;  
	ДокументОбъект.СрокЗалога = ЗалоговыйБилет.СрокЗалога; 
	ДокументОбъект.Акция = ЗалоговыйБилет.Акция;
	ДокументОбъект.НомерЗалоговогоБилета = ЗалоговыйБилет.НомерЗалоговогоБилета;  
	ДокументОбъект.Товары.Загрузить(ДокументОбъект.ПредыдущаяОперация.Товары.Выгрузить());
	ДокументОбъект.Вставки.Загрузить(ДокументОбъект.ПредыдущаяОперация.Вставки.Выгрузить());
	ДокументОбъект.ДополнительныеМеталлы.Загрузить(ДокументОбъект.ПредыдущаяОперация.ДополнительныеМеталлы.Выгрузить());
	ДокументОбъект.Дефекты.Загрузить(ДокументОбъект.ПредыдущаяОперация.Дефекты.Выгрузить()); 
	ДокументОбъект.Ломбард = Ломбард; 
	ДокументОбъект.ОтветственныйПользователь = ОтветственныйПользователь;   
	ДокументОбъект.ОтветственныйСотрудник = ОтветственныйСотрудник;

	ДокументОбъект.Комментарий = Комментарий;
	ДокументОбъект.ДатаИзъятия = ДатаИзъятия;  
	ДокументОбъект.ГосОрганИзъятие = ГосОрганИзъятие;
	ДокументОбъект.ДатаПротоколИзъятия = ДатаПротоколИзъятия;
	ДокументОбъект.ДокументИзъятияНаименование = ДокументИзъятияНаименование;
	ДокументОбъект.ДокументИзъятияДатаВыдачи = ДокументИзъятияДатаВыдачи;
	ДокументОбъект.ДокументИзъятияКемВыдан = ДокументИзъятияКемВыдан;
	ДокументОбъект.ФИОДолжностьИзъятие = ФИОДолжностьИзъятие;
	ДокументОбъект.ФИОДолжностьСудьи = ФИОДолжностьСудьи;
	ДокументОбъект.ОтмененныйДокумент = ДокументИзъятия;

	Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.МестоРождения КАК МестоРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
                   |ИЗ
                   |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";

	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("Залогодатель", ДокументОбъект.Залогодатель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументОбъект.Фамилия = Выборка.Фамилия;
        ДокументОбъект.Имя = Выборка.Имя;
        ДокументОбъект.Отчество = Выборка.Отчество;		
		ДокументОбъект.ДатаРождения = Выборка.ДатаРождения;		
		ДокументОбъект.Гражданство = Выборка.Гражданство;
		ДокументОбъект.Пол = Выборка.Пол;  
		ДокументОбъект.ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДокументОбъект.ДатаРождения);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";

	Запрос.УстановитьПараметр("ДокументЗалогодателя", ДокументОбъект.ДокументЗалогодателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументОбъект.ДокументВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя;
		ДокументОбъект.ДокументВид = Выборка.ВидДокумента;
		ДокументОбъект.ДокументГражданство = Выборка.Гражданство;
		ДокументОбъект.ДокументСерия = Выборка.ДокументСерия;
		ДокументОбъект.ДокументНомер = Выборка.ДокументНомер;
		ДокументОбъект.ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи;
		ДокументОбъект.ДокументКемВыдан = Выборка.ДокументКемВыдан;
		ДокументОбъект.ДокументКодПодразделения = Выборка.ДокументКодПодразделения;
		ДокументОбъект.ДокументНачалоДействия = Выборка.ДокументНачалоДействия;
		ДокументОбъект.ДокументСрокДействия = Выборка.ДокументСрокДействия;
	КонецЕсли;     
	
	
	Для каждого стр из ДокументОбъект.Товары Цикл 
		Стр.СуммаОплаты = 0;
		
		Отбор = новый структура;
		Отбор.Вставить("ОбъектЗалога", стр.ОбъектЗалога);
		
		СтрокиТ = ТаблицаТоваров.НайтиСтроки(Отбор); 
		Если НЕ СтрокиТ.Количество() = 0 Тогда
			СтрТ = строкиТ.получить(0); 
			Стр.СуммаОплаты = СтрТ.СуммаОплатыПереплата;
		КонецЕсли;	                                                      
	Конеццикла;
	
	ДокументОбъект.ТоварыИзъятыеВозвращенные.Очистить();
	Для каждого стр из ТаблицаТоваров Цикл 
		Если НЕ стр.Изъять Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтр = ДокументОбъект.ТоварыИзъятыеВозвращенные.Добавить();
		НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;  
		НоваяСтр.СуммаОценки = Стр.СуммаОценки;
	Конеццикла;	
	
	Отбор = Новый структура;
	Отбор.Вставить("КлючСтроки", 2);
	Строки = ТаблицаСостояний.НайтиСтроки(Отбор);  
	СтрНач = Строки.Получить(0);
	ДокументОбъект.ДатаВыкупа = СтрНач.ДатаВозврата;
    ДокументОбъект.ДатаВыкупаЛьготная = СтрНач.ДатаВозвратаЛьготная;	
	ДокументОбъект.СуммаСсуды = СтрНач.СуммаЗайма;  
	
	ДокументОбъект.НачислениеПроцентовДетально.Очистить();
	Для каждого стр из ТаблицаОплатДетально Цикл 
	    НоваяСтр = ДокументОбъект.НачислениеПроцентовДетально.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтр, стр);  
		Если Стр.ДеньНач = 1 Тогда     
			СтавкаП = Стр.ПроцентнаяСтавкаБазовая; 
			Если Стр.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
				Если НЕ Стр.ПроцентнаяСтавкаАкция = 0 Тогда
					СтавкаП = Стр.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ Стр.ОтклонениеАкцияОтносительное = 0 Тогда	 
					СтавкаП = Стр.ПроцентнаяСтавкаБазовая + Стр.ПроцентнаяСтавкаБазовая*Стр.ОтклонениеАкцияОтносительное/100;
				ИначеЕсли НЕ Стр.ОтклонениеАкцияАбсолютное = 0 Тогда
					СтавкаП = Стр.ПроцентнаяСтавкаБазовая + Стр.ОтклонениеАкцияАбсолютное;
			    КонецЕсли; 
			КонецЕсли;	
			ДокументОбъект.ПроцентнаяСхема = ставкаП;
		КонецЕсли;	
	КонецЦиклА;
	
	ДокументОбъект.ТаблицаСостоянийОтмененного.Очистить();
	Для каждого СтрСостояния Из ТаблицаСостояний Цикл
		
		НоваяСтрСостояния = ДокументОбъект.ТаблицаСостоянийОтмененного.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрСостояния, СтрСостояния,, "Статус");
	
		НоваяСтрСостояния.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ПустаяСсылка();
		
		Для Номер=0 По Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Количество()-1 Цикл
			Если Строка(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Получить(Номер)) = СтрСостояния.Статус Тогда
				
				НоваяСтрСостояния.Статус = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Получить(Номер);
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Попытка           
	    ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение); 

		//+МАН 17.06.25 Убрал
		//ДокументОтмены = ДокументОбъект.Ссылка;

		////Установка отментки об отмене документа в отменяемом документе
		//ОтменяемыйДокумент = ДокументИзъятия.ПолучитьОбъект();
		//ОтменяемыйДокумент.ДокументОтмены = ДокументОтмены;
		//
		//ОтменяемыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		//
		//Попытка           
		//    ОтменяемыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		//Исключение
		//	ОбщегоНазначения.СообщитьПользователю("Не удалось установить отметку в отменяемом документе");
		//КонецПопытки;
		//
		
		Возврат Истина;
	Исключение   
		ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(ДокументОбъект.Ссылка));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОЗБ(ЗалоговыйБилет, Дата)

	Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, Дата,, Истина);
	
	//+Мельников 06.05.24 Сделано на время тестирования. Убрать при запуске ломбардов.
	Если Результат = Неопределено Тогда
		ДатаПроверки = ТекущаяДата() + 94608000; // + три года к дате проверки документа
		Результат = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗБ(ЗалоговыйБилет.НомерЗалоговогоБилета, ДатаПроверки,, Истина);
	КонецЕсли;
	//-Мельников

	ПоследняяОперация = Новый Структура;
	ПоследняяОперация.Вставить("Дата", Результат.Регистратор.Дата);
	ПоследняяОперация.Вставить("ВидОперации", Результат.Регистратор.ВидОперации);
	ПоследняяОперация.Вставить("ДокументОперации", Результат.Регистратор);
	
	Возврат ПоследняяОперация;

КонецФункции

