//+МАН 05.12.25 Заполнение подвала
&НаСервере
Процедура ЗаполнитьПодвал(Отбор = Неопределено)
	ОтборСтатуса = Новый Структура();
	ОтборСтатуса.Вставить("СтатусЗалоговогоБилета", Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления);
	
	Если Отбор <> Неопределено Тогда
		Для каждого Стр Из Отбор Цикл
			ОтборСтатуса.Вставить(Стр.Ключ, Стр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если Отбор = Неопределено Тогда
		ТЗПоСтатусу = ТаблицаЗБ.Выгрузить(ОтборСтатуса);
		
		ИтогоКоличество = ТаблицаЗБ.Количество() - ТЗПоСтатусу.Количество();
		ИтогоСуммаЗайма = ТаблицаЗБ.Итог("СуммаЗайма") - ТЗПоСтатусу.Итог("СуммаЗайма");
		ИтогоСуммаОценки = ТаблицаЗБ.Итог("СуммаОценки") - ТЗПоСтатусу.Итог("СуммаОценки");
		ИтогоДолг = ТаблицаЗБ.Итог("Долг") - ТЗПоСтатусу.Итог("Долг");
	Иначе
		ТЗОтбора = ТаблицаЗБ.Выгрузить(Отбор);
		
		ТЗПоСтатусу = ТаблицаЗБ.Выгрузить(ОтборСтатуса);
		
		ИтогоКоличество = ТЗОтбора.Количество() - ТЗПоСтатусу.Количество();
		ИтогоСуммаЗайма = ТЗОтбора.Итог("СуммаЗайма") - ТЗПоСтатусу.Итог("СуммаЗайма");
		ИтогоСуммаОценки = ТЗОтбора.Итог("СуммаОценки") - ТЗПоСтатусу.Итог("СуммаОценки");
		ИтогоДолг = ТЗОтбора.Итог("Долг") - ТЗПоСтатусу.Итог("Долг");
	КонецЕсли;

	Элементы.ТаблицаЗБНомерЗБ.ТекстПодвала = ИтогоКоличество;
	Элементы.ТаблицаЗБСуммаЗайма.ТекстПодвала = ИтогоСуммаЗайма;
	Элементы.ТаблицаЗБСуммаОценки.ТекстПодвала = ИтогоСуммаОценки;
	Элементы.ТаблицаЗБДолг.ТекстПодвала = ИтогоДолг;

КонецПроцедуры

