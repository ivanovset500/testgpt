&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
		
	ТекстЗаголовока = НСтр("ru = 'Рабочее место приемщика'");
	
	текПользователь = "" + ПараметрыСеанса.ТекущийСотрудник;
	Если текПользователь = "" Тогда 
		текПользователь = "" + Пользователи.ТекущийПользователь();
	КонецЕсли;
	ТекстЗаголовока = ТекстЗаголовока + "                                                                                                                                                                       " + текПользователь;
	Заголовок = ТекстЗаголовока;   
	
	Если Пользователи.ТекущийПользователь().ЭтоЛомбард Тогда
        ТекущийЛомбард = ПараметрыСеанса.ТекущийЛомбард; 
	Иначе
		ТекущийЛомбард = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(Пользователи.ТекущийПользователь());
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Залогодатель) Тогда
		ФИО = "<Фамилия, имя и отчество клиента>";
		  
		Элементы.КарточкаКлиента.Доступность = Ложь;
		Элементы.СтатистикаОбращений.Доступность = Ложь;
		Элементы.ЭДО.Доступность = Ложь;
		
		//+МАН 28.01.26 Изменил. Заявка 3649
		//Элементы.ГруппаКнопки.Доступность = Ложь;  
		Элементы.СогласиеНаОпробование.Доступность = Ложь;
		Элементы.ФормаЗаявлениеНаВозврат.Доступность = Ложь;
		Элементы.ФормаЗаявлениеОПредоставленииСведений.Доступность = Ложь;
		Элементы.ФормаАктНаследник.Доступность = Ложь;
		//-МАН
		
		Элементы.КомандыТаблицыЗБ.Доступность = Ложь;  
		Элементы.ГруппаВыбораЗБ.Доступность = Ложь;
	КонецЕсли;
	
	//++ООВ 20.03.2026 Заявка 3751
	Если НЕ ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
			Элементы.МаршрутныйЛист.Доступность = Истина;  
		Иначе 
			Элементы.МаршрутныйЛист.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	//--ООВ 20.03.2026
	
	ИнформацияОКлиенте = ЗаполнитьИнформациюОКлиенте(); 
	СтатусыКлиента = ЗаполнитьСтатусыКлиента(); 
	
КонецПроцедуры

