&НаСервере
Процедура ПослеДобавленияКлиента(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Залогодатель = Результат.Залогодатель;
	ПолучитьКонтактнуюИнформацию();
	ИнформацияОКлиенте = ЗаполнитьИнформациюОКлиенте();  
	ЗаполнитьИнформациюОКлиентеДополнительно();   
	СтатусыКлиента = ЗаполнитьСтатусыКлиента(); 	
	ВыборЗБ = 1; 
	ТекущийВыборЗБ = 1;  
	Если НЕ ПустаяСтрока(НомерЗБ) Тогда 
		НомерЗБ = "";
		Элементы.НомерЗБ.Видимость = Ложь;
	КонецЕсли;	
    ПолучитьСписокЗБ(Истина);  		
	ЗаполнитьСписокЛомбардов(); 
	УстановитьОтборНаСервере();          
	Элементы.ИнформацияОКлиенте.Высота = ИнформацияОКлиенте.ВысотаТаблицы;
	Элементы.СтатусыКлиента.Высота = СтатусыКлиента.ВысотаТаблицы; 
	Элементы.КарточкаКлиента.Доступность = Истина;
	Элементы.СтатистикаОбращений.Доступность = Истина;
	Элементы.ЭДО.Доступность = Истина;  
	//+МАН 28.01.26 Изменил. Заявка 3649
	//Элементы.ГруппаКнопки.Доступность = Истина;  
	Элементы.СогласиеНаОпробование.Доступность = Истина;
	Элементы.ФормаЗаявлениеНаВозврат.Доступность = Истина;
	Элементы.ФормаЗаявлениеОПредоставленииСведений.Доступность = Истина;
	Элементы.ФормаАктНаследник.Доступность = Истина;
	//-МАН
	Элементы.КомандыТаблицыЗБ.Доступность = Истина; 
	Элементы.ГруппаВыбораЗБ.Доступность = Истина;
	
	НаличиеЭДО = ЛБ_СоглашенияЭДОСервер.НаличиеДействующегоСоглашения(Залогодатель);
	
	Если НаличиеЭДО Тогда
		Элементы.СтатусЭДО.Заголовок = "есть";
	Иначе
		Элементы.СтатусЭДО.Заголовок = "нет";
	КонецЕсли;	

	//+МАН 28.01.26 Заявка 3649
	ОформлениеЭДО(НаличиеЭДО);
	//-МАН
КонецПроцедуры	

