&НаКлиенте
Процедура ПослеВыбораТекущееСостояниеЗБ(Результат,Параметры) Экспорт  
	ИнформацияОКлиенте = ЗаполнитьИнформациюОКлиенте();
	ЗаполнитьИнформациюОКлиентеДополнительно();
	СтатусыКлиента = ЗаполнитьСтатусыКлиента();    
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
	    ПерезаполнитьСтрокуПоЗБ(ТекСтрока.ПолучитьИдентификатор());
	Иначе  
		ПерезаполнитьСтрокуПоЗБ();
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ИсторияЗБ(Команда)
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЗБПриИзменении(Элемент)
	Если ВыборЗБ = 3 Тогда 
		Параметрыформы = Новый структура;
		Параметрыформы.Вставить("НомерЗБ", НомерЗБ);  
		ОбработкаВвода = Новый ОписаниеОповещения("ПослеВводаНомераЗБ", ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВводаНомераЗБ", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВвода, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе      
		Если Элементы.Ломбард.СписокВыбора.Количество() = 0 Тогда
		    ЗаполнитьСписокЛомбардов();  
		КонецЕсли;	
		УстановитьОтборНаСервере();  
		Элементы.НомерЗБ.Видимость = Ложь; 
		ТекущийВыборЗБ = ВыборЗБ;
	КонецЕсли;	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВводаНомераЗБ(Результат, ДопПараметры) Экспорт  
	Если Результат = Неопределено Тогда
		ВыборЗБ = ТекущийВыборЗБ;
		Возврат;
	КонецЕсли;
	
	НомерЗБ = Результат;
	СообщениеЗБ = ПолучитьЗБОдин();  
	Если Пустаястрока(СообщениеЗБ) Тогда
		Элементы.НомерЗБ.Видимость = Истина;   
		СтрокаНомерЗБ = "№ ЗБ " + СокрЛП(НомерЗБ); 			
		ТекущийВыборЗБ = 3; 
	Иначе      
		Предупреждение(СообщениеЗБ, 60);
		ОбработкаВвода = Новый ОписаниеОповещения("ПослеВводаНомераЗБ", ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВводаНомераЗБ", , ЭтаФорма,,,,ОбработкаВвода, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьЗБОдин() 
	ЗБ = ЛБ_ОбщийМодуль.ПолучитьЗБПоНомеру(СокрЛП(НомерЗБ), Ложь);  
	Если ЗначениеЗаполнено(ЗБ) Тогда
		Если ЗБ.Залогодатель = Залогодатель Тогда
			Элементы.Ломбард.СписокВыбора.Очистить();
			Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
		   	УстановитьОтборНаСервере(ЗБ);
	        Возврат "";  
		Иначе
			Возврат "Залоговый билет клиента № " + СокрЛП(НомерЗБ) + " не найден!";
		КонецЕсли;
	Иначе 
		Возврат "Залоговый билет клиента № " + СокрЛП(НомерЗБ) + " не найден!";
	КонецЕсли;	
КонецФункции

&НаСервере
Процедура УстановитьОтборНаСервере(ЗБ = неопределено)
   Отбор = Новый Структура;
   Если НЕ ЗБ = неопределено Тогда
	   Отбор.Вставить("ЗалоговыйБилет", ЗБ);
   Иначе
	   Если ЗначениеЗаполнено(Ломбард) Тогда
		   Отбор.Вставить("Ломбард", Ломбард);
	   КонецЕсли;	
	   Если ВыборЗБ = 2 Тогда 
		   Отбор.Вставить("Действующий", Истина);
	   КонецЕсли;	   
   КонецЕсли;	   

   Элементы.ТаблицаЗБ.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
   
   //+МАН 05.12.25 Заполнение подвала
   ЗаполнитьПодвал(Отбор);
   //-МАН
   
  Элементы.ТаблицаЗБ.Обновить();
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокЗБ(НовыйКлиент = Ложь) 	
	ТаблицаЗапроса = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель);   
	ЗаполнитьТаблицуЗБ(ТаблицаЗапроса, НовыйКлиент)
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСписокЛомбардов()
	Элементы.Ломбард.СписокВыбора.Очистить(); 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если ТекПользователь.ЭтоЛомбард Тогда
		ТекЛомбард = ПараметрыСеанса.ТекущийЛомбард;  
		//+МАН 28.01.26 Заявка 3649
		ТЗЛомбардыОтделения = ПолучитьЛомбардыОтделения(ТекЛомбард);
		//-МАН
	Иначе
		ТекЛомбард = неопределено;
	КонецЕсли;  

	//+МАН 28.01.26 Изменение порядка ломбардов в списке выбора. Заявка 3649
	ТЗЛомбарды = ТаблицаЗБ.Выгрузить(, "Ломбард");
	ТЗЛомбарды.Свернуть("Ломбард");
			
	Если ТекЛомбард <> Неопределено Тогда
		Если ТЗЛомбардыОтделения <> Неопределено Тогда
			
			МассивУдалениИзСпискаЛомбардов = Новый Массив;
			МассивУдалениИзСпискаОтделения = Новый Массив;
			
			Для каждого СтрЛомб Из ТЗЛомбардыОтделения Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Ломбард", СтрЛомб.Ломбард);
				
				НайденныйЛомбард = ТЗЛомбарды.НайтиСтроки(Отбор);
				
				Если СтрЛомб.Ломбард = ТекЛомбард И НайденныйЛомбард.Количество() > 0 Тогда
					МассивУдалениИзСпискаЛомбардов.Добавить(НайденныйЛомбард[0]);
					МассивУдалениИзСпискаОтделения.Добавить(СтрЛомб);
				ИначеЕсли НайденныйЛомбард.Количество() > 0 Тогда
					МассивУдалениИзСпискаЛомбардов.Добавить(НайденныйЛомбард[0]);
				Иначе
					МассивУдалениИзСпискаОтделения.Добавить(СтрЛомб);
				КонецЕсли;
			КонецЦикла;
			
			Для каждого СтрМ Из МассивУдалениИзСпискаЛомбардов Цикл
				ТЗЛомбарды.Удалить(СтрМ);
			КонецЦикла;
			
			Для каждого СтрМ Из МассивУдалениИзСпискаОтделения Цикл
				ТЗЛомбардыОтделения.Удалить(СтрМ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//+МАН 28.01.26 Закомментировал, то что было ранее.
	//Для каждого Стр Из ТаблицаЗБ цикл  
	//	Если Элементы.Ломбард.СписокВыбора.НайтиПоЗначению(стр.Ломбард) = неопределено Тогда 
	//		Если НЕ стр.Ломбард = ТекЛомбард Тогда
	//		    Элементы.Ломбард.СписокВыбора.Добавить(стр.Ломбард, стр.Ломбард.НаименованиеПолное);  
	//		КонецЕсли;	
	//	КонецЕсли;	
	//Конеццикла;      	
	//Элементы.Ломбард.СписокВыбора.СортироватьПоПредставлению();

	ТЗЛомбарды = СортироватьТЗЛомбарды(ТЗЛомбарды);
	
	Для каждого Стр Из ТЗЛомбарды Цикл
		Если Элементы.Ломбард.СписокВыбора.НайтиПоЗначению(стр.Ломбард) = Неопределено Тогда
		    Элементы.Ломбард.СписокВыбора.Добавить(стр.Ломбард, стр.Ломбард.НаименованиеПолное);
		КонецЕсли;
	Конеццикла;
	
	//Элементы.Ломбард.СписокВыбора.СортироватьПоПредставлению();
	
	Если ТекЛомбард <> Неопределено Тогда
		Для каждого Стр Из ТЗЛомбардыОтделения Цикл
			Если Элементы.Ломбард.СписокВыбора.НайтиПоЗначению(стр.Ломбард) = Неопределено Тогда
				Элементы.Ломбард.СписокВыбора.Вставить(0, стр.Ломбард, стр.Ломбард.НаименованиеПолное); 
			КонецЕсли;
		Конеццикла;
	КонецЕсли;
	//-МАН
	
	Если НЕ ТекЛомбард = неопределено Тогда
		Элементы.Ломбард.СписокВыбора.Вставить(0, ТекЛомбард, ТекЛомбард.НаименованиеПолное); 
	КонецЕсли;	
	Если Элементы.Ломбард.СписокВыбора.Количество() > 1 Тогда 
		Элементы.Ломбард.СписокВыбора.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка(), "Все ломбарды");
	КонецЕсли;    
	Если НЕ ЗначениеЗаполнено(Ломбард) Тогда
		Если Элементы.Ломбард.СписокВыбора.Количество() > 0 Тогда 
			Если НЕ ТекЛомбард = неопределено Тогда
		         Ломбард = Элементы.Ломбард.СписокВыбора.Получить(0).Значение;
			Иначе
				 Ломбард = Справочники.ЛБ_Ломбарды.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСтрокуТаблицыЗБ(Стр, НоваяСтр, НовыйКлиент = Ложь)
	НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
	НоваяСтр.ДатаЗБ = Стр.ЗалоговыйБилет.Дата;
	НоваяСтр.НомерЗБ = Стр.ЗалоговыйБилет.НомерЗалоговогоБилета;
	НоваяСтр.Ломбард = Стр.Ломбард;
	НоваяСтр.СтатусЗалоговогоБилета = Стр.СтатусЗалоговогоБилета;
	НоваяСтр.СуммаЗайма = Стр.ЗалоговыйБилет.СуммаСсуды;  
	НоваяСтр.СуммаОценки = Стр.ЗалоговыйБилет.Товары.Итог("СуммаОценкиМаксимальная"); 
	НоваяСтр.ДатаВозврата = стр.ДатаВыкупа; 
	НоваяСтр.ДатаВозвратаЛьготная = стр.ДатаВыкупаЛьготныйСрок; 
	НоваяСтр.Действующий = стр.Действующий;   
	Если стр.Действующий Тогда
	    НоваяСтр.ТекСрокЗайма = (НачалоДня(ТекущаяДатаСеанса()) - НачалоДня(Стр.ЗалоговыйБилет.Дата)) / (60 * 60 * 24);  
	Иначе
		НоваяСтр.ТекСрокЗайма = 0;
	КонецЕсли;	
		
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
	Запрос.УстановитьПараметр("Дата", Стр.ЗалоговыйБилет.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
	    ПредельныйСрокЗайма = Выборка.ПредельныйСрокЗайма;
		ПредельныйСрокЗаймаДни = Выборка.ПредельныйСрокЗаймаДни;
		НоваяСтр.ПСЗ = Формат(ПредельныйСрокЗайма, "ДФ=dd.MM.yyyy") + " (" + Строка(ПредельныйСрокЗаймаДни) + ")";
		//+МАН 28.01.26 Заявка 3649
		НоваяСтр.ПСЗДни = ПредельныйСрокЗаймаДни;
		//-МАН
	КонецЕсли;  
	СК = ?(Не ПустаяСтрока(Стр.СхемаКредитования.НаименованиеДляПечати), Стр.СхемаКредитования.НаименованиеДляПечати, Стр.СхемаКредитования.Наименование);  
    НоваяСтр.ВидСрок = СокрЛП(СК) + "/" + Строка(Стр.ЗалоговыйБилет.срокЗалога);  
	НоваяСтр.ГибкийПроцент = Стр.СхемаКредитования.ПризнакПримененияГибкогоПроцента;   
	НоваяСтр.ПричинаПрименения = Стр.ПричинаПрименения;
	НоваяСтр.ДатаНачалаРасчетаПроцентов = Стр.ДатаНачалаРасчетаПроцентов; 
	Если НЕ НовыйКлиент Тогда
		НачисленоПроценты = 0;
		НачисленияОстановлены = Ложь;
		Если Стр.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
			 Стр.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
			 Стр.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда   
			НачисленияОстановлены = Истина;
		КонецЕсли;	

		Если НЕ ДатаСмерти = Дата(1,1,1) Тогда   
			ПредыдущийСтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(ДатаСмерти-1, Стр.ЗалоговыйБилет); 
			Если ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ 
			     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен ИЛИ
			     ПредыдущийСтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен Тогда 
				НачисленияОстановлены = Истина; 
			КонецЕсли; 
		КонецЕсли;

		Если НЕ Стр.СуммаЗайма = 0 Тогда 
			СтавкаП = ЛБ_УправлениеЛомбардом.ПолучитьТекущуюПроцентнуюСтавку(Стр.ЗалоговыйБилет, Стр.ПричинаПрименения); 
			НоваяСтр.ПроцентнаяСтавка = Формат(СтавкаП, "ЧЦ=10; ЧДЦ=3"); 
			Если НачисленияОстановлены Тогда  
				НачисленоПроценты = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(, Стр.ЗалоговыйБилет);
				НоваяСтр.СуммаПроцентовВДень = "0,00";
			Иначе	
				ВидОкругленияСуммыПроцентов = ЛБ_УправлениеЛомбардом.ПолучитьВидОкругленияСуммыПроцентов(Стр.ЗалоговыйБилет.Дата);
				Если ВидОкругленияСуммыПроцентов = Перечисления.ЛБ_ВидыОкругленияСуммыПроцентов.ОкруглениеПослеУмноженияНаКоличествоДней Тогда
			        НоваяСтр.СуммаПроцентовВДень = Формат(Стр.СуммаЗайма*СтавкаП/100, "ЧЦ=15; ЧДЦ=5");   
				Иначе
					НоваяСтр.СуммаПроцентовВДень = Формат(Стр.СуммаЗайма*СтавкаП/100, "ЧЦ=15; ЧДЦ=2");
				КонецЕсли;		
				
				НачисленоПроценты = ЛБ_УправлениеЛомбардом.РасчитатьДолгПоПроцентам(ТекущаяДатаСеанса(), Стр.ЗалоговыйБилет, Стр.СуммаЗайма, Стр.ПричинаПрименения, Стр.ДатаНачалаРасчетаПроцентов);
			КонецЕсли; 
		Иначе
			НоваяСтр.ПроцентнаяСтавка = "";
			НоваяСтр.СуммаПроцентовВДень = "";
		КонецЕсли;	
		НоваяСтр.Долг = Стр.СуммаЗайма + НачисленоПроценты;
		НоваяСтр.Доверенность = ЛБ_УправлениеЛомбардом.ЕстьДоверенности(Стр.ЗалоговыйБилет); 
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьТаблицуЗБ(ТаблицаЗапроса, НовыйКлиент)
	ТаблицаЗБ.Очистить();
	Для каждого Стр Из ТаблицаЗапроса Цикл
		НоваяСтр = ТаблицаЗБ.Добавить();   
		ЗаполнитьСтрокуТаблицыЗБ(Стр, НоваяСтр, НовыйКлиент);
	КонецЦикла;	
	ТаблицаЗБ.Сортировать("ДатаЗБ Убыв"); 

	//+МАН 05.12.25 Заполнение подвала
	ЗаполнитьПодвал();
	//-МАН
	
	Элементы.ТаблицаЗБ.Обновить();
КонецПроцедуры	

&НаСервере
Процедура ПерезаполнитьСтрокуПоЗБ(Идентификатор = неопределено)  
	Если НЕ Идентификатор = неопределено Тогда 
		СтрТаб = ТаблицаЗБ.НайтиПоИдентификатору(Идентификатор);
		ТаблицаЗапроса = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель, СтрТаб.ЗалоговыйБилет);
		Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
			Стр = ТаблицаЗапроса.Получить(0);
		    ЗаполнитьСтрокуТаблицыЗБ(Стр, СтрТаб);
			
			Если СтрТаб.ЗалоговыйБилет.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда 
				ТаблицаЗапросаП = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель, СтрТаб.ЗалоговыйБилет.ПредыдущаяОперация);
				Если НЕ ТаблицаЗапросаП.Количество() = 0 Тогда
					Стр = ТаблицаЗапросаП.Получить(0);        
					Отбор = Новый Структура;
					Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
					СтрокиЗБ = ТаблицаЗБ.НайтиСтроки(Отбор); 
					Если НЕ СтрокиЗБ.Количество() = 0 Тогда 
						СтрТаб = СтрокиЗБ.Получить(0);
				        ЗаполнитьСтрокуТаблицыЗБ(Стр, СтрТаб);
					КонецЕсли;	
                КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	//проверим создание нового ЗБ 
	ТаблицаЗапроса = ЛБ_ОбщийМодуль.ПолучитьСписокЗБКлиента(Залогодатель);
	Для каждого Стр из ТаблицаЗапроса Цикл  
		Отбор = Новый Структура;
		Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
		Строки = ТаблицаЗБ.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда  
			НоваяСтр = ТаблицаЗБ.Добавить();   
		    ЗаполнитьСтрокуТаблицыЗБ(Стр, НоваяСтр);
			Элементы.ТаблицаЗБ.ТекущаяСтрока = НоваяСтр.ПолучитьИдентификатор();
		КонецЕсли;	
	КонецЦикла;	
	ТаблицаЗБ.Сортировать("ДатаЗБ Убыв");  
	
	ИнформацияОКлиенте = ЗаполнитьИнформациюОКлиенте();
	ЗаполнитьИнформациюОКлиентеДополнительно();
	СтатусыКлиента = ЗаполнитьСтатусыКлиента();    
	//+МАН 05.12.25 Заполнение подвала
	ЗаполнитьПодвал();
	//-МАН
КонецПроцедуры	

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	УстановитьОтборНаСервере();
КонецПроцедуры

