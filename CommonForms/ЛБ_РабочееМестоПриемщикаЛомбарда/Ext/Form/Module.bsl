	Иначе     
		ВыбранныйЛомбард = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка");//ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		Если ВвестиЗначение(ВыбранныйЛомбард, "Выберите ломбард", Тип("СправочникСсылка.ЛБ_Ломбарды")) Тогда 
			ПараметрыФормы.Вставить("Ломбард", ВыбранныйЛомбард); 
			ОткрытьФорму("ОбщаяФорма.ЛБ_ЖурналПриказов", Параметрыформы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры


