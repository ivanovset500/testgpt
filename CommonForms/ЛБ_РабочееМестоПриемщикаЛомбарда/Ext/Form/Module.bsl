		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗалога", ПараметрыФормы, ЭтаФорма, Истина,,,);
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ПроверитьСтатусНакладной(ЗалоговыйБилет) 
	Возврат ЛБ_УправлениеЛомбардом.ПолучитьСтатусНакладнойПоЗБИзм(ТекущаяДатаСеанса(), ЗалоговыйБилет);
КонецФункции  

&НаСервере
Функция ПолучитьРеквизитыНакладной(НакладнаяНаОтгрузку)  
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("Номер", НакладнаяНаОтгрузку.ПредставлениеНомераНакладной); 
	СтруктураВ.Вставить("Дата", НакладнаяНаОтгрузку.Дата);
	Возврат СтруктураВ; 
КонецФункции

&НаСервере
Функция ПроверитьМестонахождениеОЗ(ЗалоговыйБилет) 
	СообщениеМ = ЛБ_УправлениеЛомбардом.ПроверитьМестонахождениеОЗ(ЗалоговыйБилет, ТекущийЛомбард);
	Если НЕ ПустаяСтрока(СообщениеМ) Тогда
		СообщениеМ = СообщениеМ + символы.ПС + "Выполнение операции невозможно!"; 
	КонецЕсли;
	Возврат СообщениеМ;
КонецФункции

&НаКлиенте
Процедура Изъятие(Команда)  
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда  
		Если ТекСтрока.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Закрыт") ИЛИ
			 ТекСтрока.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления") ИЛИ
			 ТекСтрока.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Реализован") Тогда  
			ТекстПредупреждения = "Залоговый билет № " + СокрЛП(ТекСтрока.НомерЗБ) + " в статусе " + Строка(ТекСтрока.СтатусЗалоговогоБилета) + ". Выполнение операции невозможно.";  
			Предупреждение(ТекстПредупреждения, 60);
			Возврат;
		КонецЕсли;	 
		
		СообщениеМ = ПроверитьМестонахождениеОЗ(ТекСтрока.ЗалоговыйБилет);
		Если НЕ ПустаяСтрока(СообщениеМ) Тогда 
			Предупреждение(СообщениеМ, 60);
			Возврат;
		КонецЕсли;	
		
		СтруктураНакладной = ПроверитьСтатусНакладной(ТекСтрока.ЗалоговыйБилет); 
		Если СтруктураНакладной = неопределено Тогда
			ЕстьВНакладной = Ложь;
		Иначе	         
			ЕстьВНакладной = Истина;
		    НакладнаяНаОтгрузку = СтруктураНакладной.НакладнаяНаОтгрузку; 
			СтатусНакладной = СтруктураНакладной.СтатусНакладной;
		КонецЕсли;
		Если ЕстьВНакладной Тогда    
		    СтруктураН = ПолучитьРеквизитыНакладной(НакладнаяНаОтгрузку);
            ТекстПредупреждения = "Внимание! Изделия по ЗБ № " + СокрЛП(ТекСтрока.НомерЗБ) + " в накладной № " + СокрЛП(СтруктураН.Номер)+ " от " + Формат(СтруктураН.Дата, "ДЛФ=DT");
		    Если СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.Отгружена") Тогда	
				ТекстПредупреждения = ТекстПредупреждения + " в статусе «Отгружено»." + Символы.ПС + "Для согласования возможности изъятия обратитесь в ЦО.";  
				Предупреждение(ТекстПредупреждения, 60);
				Возврат;
			ИначеЕсли СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаОткрыта") 
				ИЛИ  СтатусНакладной = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыНакладнойНаОтгрузку.СумкаЗакрыта") Тогда 
			   ТекстПредупреждения = ТекстПредупреждения + " в сумке." + Символы.ПС + "Для изъятия изделий из ЗБ измените статус накладной и вскройте сумку.";	  
			   Предупреждение(ТекстПредупреждения, 60);
			   Возврат;
	        КонецЕсли;	   
		КонецЕсли;		  
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет); 
		//ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораТекущееСостояниеЗБ", Этаформа);
		//ОткрытьФорму("ОбщаяФорма.ЛБ_ИзъятиеОбъектовЗалога", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ИзъятиеОбъектовЗалога", ПараметрыФормы, ЭтаФорма, Истина,,,);
	КонецЕсли;	
КонецПроцедуры   

