&НаСервере
Функция ПроверитьПаспортВСпискеНеДействительных(ДокументСерия, ДокументНомер)
	Парам = Новый Структура("Серия, Номер", СокрЛП(ДокументСерия), СокрЛП(ДокументНомер));
	Возврат ЛБ_ОбменLX.ПаспортНедействителен(Парам);
КонецФункции

&НаСервере
Функция ПолучитьДокументОтмены(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Период, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|ГДЕ
		|	ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент В(&ЗБ)";
	
	Запрос.УстановитьПараметр("ЗБ", Ссылка);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЗаполнитьИнформациюОКлиенте()
	ИнформацияОКлиенте.Очистить(); 
	ДокументыЗалогодателяДоп.Очистить();
	
	Дата = ТекущаяДатаСеанса();
    ТабличныйДокумент = Новый ТабличныйДокумент;  
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщиеМакеты.ЛБ_ИнформацияОКлиенте"); 
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка"); 
	ТабличныйДокумент.Вывести(ОбластьМакета); 
	
	Если НЕ ЗначениеЗаполнено(Залогодатель) Тогда 
		ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаб"); 
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал"); 
		ТабличныйДокумент.Вывести(ОбластьМакета); 
		
		Возврат ТабличныйДокумент;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДУЛ КАК ОсновнойДУЛ,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ОсновнойДоп КАК ОсновнойДоп,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ДокументНеДействителен,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДействителен КАК ДокументДействителен,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНаименованиеИногоДокумента КАК ДокументНаименованиеИногоДокумента,
	               |	ЛОЖЬ КАК ПроверкаНеДействителен
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(, ДокументЗалогодателя.Владелец = &Залогодатель) КАК ЛБ_ДокументыЗалогодателейСрезПоследних"; 
	ДокументыЗалогодателя = Запрос.Выполнить().Выгрузить(); 
	Если НЕ ДатаСмерти = Дата(1,1,1) Тогда 
		Удстроки = Новый списокЗначений;
		Для каждого Стр Из ДокументыЗалогодателя Цикл
			Если НЕ Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти Тогда  
				Удстроки.Добавить(Стр);
			КонецЕсли;	
		КонецЦикла;   
		
		Для каждого Эл Из Удстроки цикл 
			ДокументыЗалогодателя.Удалить(Эл.Значение);
		Конеццикла;	                                   
	Иначе	
		ЕстьСвидетельствоОРождении = Ложь; 
		ЕстьПаспорт = Ложь;
		Для каждого Стр Из ДокументыЗалогодателя Цикл   
			Если Стр.ВидДокументаЗалогодателя = 	Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ Тогда
				Продолжить;
			КонецЕсли;	
			Если Стр.ДокументНЕДействителен Тогда
				Продолжить; 
			ИначеЕсли (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) Тогда
				ЕстьСвидетельствоОРождении = Истина;	
			КонецЕсли;	
			Стр.ПроверкаНеДействителен = ПроверитьПаспортВСпискеНеДействительных(Стр.ДокументСерия, стр.ДокументНомер);
			Если НЕ Стр.ПроверкаНеДействителен Тогда
				ЛБ_ОбщийМодуль.ПроверитьДействительностьДокумента(Стр, ДатаРождения, ложь, Дата);
			КонецЕсли; 			
		КонецЦикла;
		
		Если ЕстьСвидетельствоОРождении Тогда
			//проверим недействительность свидетельства о рождении если есть паспорт
			ЛБ_ОбщийМодуль.ПроверитьДействительностьСвидетельствоОРождении(ДокументыЗалогодателя);
		КонецЕсли;
		
		Для каждого Стр Из ДокументыЗалогодателя Цикл
			Если (Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) И НЕ Стр.ДокументНЕДействителен Тогда
			    ЕстьПаспорт = Истина;  
				Прервать;
		    КонецЕсли;
		КонецЦикла;	
		
		//проверим недействительность свидетельства о рождении если есть паспорт
		Если ЕстьПаспорт Тогда
			ОтборД = Новый структура;
			ОтборД.Вставить("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении);
			ОтборД.Вставить("ДокументНеДействителен", Ложь);
			СтрокиД = ДокументыЗалогодателя.НайтиСтроки(ОтборД);
			Для каждого СтрД Из СтрокиД цикл
				СтрД.ДокументНеДействителен = Истина;
			Конеццикла;	
		КонецЕсли;  
		
		ОсновнойДУЛ = Справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
		Удстроки = Новый списокЗначений;
		Для каждого Стр Из ДокументыЗалогодателя Цикл
			Если Стр.ДокументНЕДействителен ИЛИ Стр.ПроверкаНеДействителен Тогда  
				Удстроки.Добавить(Стр); 
			Иначе
				Если Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент Тогда    
					НоваяСтр = ДокументыЗалогодателяДоп.Добавить(); 
					НоваяСтр.ВидДокумента = Стр.ВидДокумента;
					НоваяСтр.ДокументСрокДействия = Стр.ДокументСрокДействия; 
				ИначеЕсли Стр.ОсновнойДУЛ Тогда
					ОсновнойДУЛ = Стр.ДокументЗалогодателя; 
					ОсновнойДУЛГражданство = Стр.Гражданство;  
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;  
		
		//проверим вид на жительство если нужно
		Для каждого Стр Из ДокументыЗалогодателя Цикл 
			Если НЕ Стр.ВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ Тогда
				Продолжить;
			КонецЕсли;	

			Если Стр.ДокументНЕДействителен Тогда
				Продолжить; 
			ИначеЕсли ОсновнойДУЛГражданство = Справочники.СтраныМира.Россия Тогда
				Удстроки.Добавить(Стр);
				Продолжить;
			КонецЕсли;	
						
			Если ЗначениеЗаполнено(Стр.Гражданство) И 
				Не Стр.Гражданство = Справочники.СтраныМира.Россия И
				Стр.ВидДокументаЗалогодателя = 	Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ И
				Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство Тогда
				
				Стр.ПроверкаНеДействителен = НЕ ЛБ_ОбщийМодуль.ПроверитьДействительностьВидаНаЖительство(Стр, ДатаРождения, Дата);
			КонецЕсли;
		КонецЦикла;

		
		Для каждого Эл Из Удстроки цикл 
			ДокументыЗалогодателя.Удалить(Эл.Значение);
		Конеццикла;	                                   
		ДокументыЗалогодателя.Сортировать("ОсновнойДУЛ УБЫВ, ОсновнойДоп УБЫВ, ДокументНачалоДействия УБЫВ, ВидДокументаЗалогодателя"); 
	КонецЕсли;	
	
	//+МАН 28.01.26 Заявка 3649
	ОбластьКомментарий = Макет.ПолучитьОбласть("СтрокаКомментарий");
	//-МАН
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаб");
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
				   //+МАН 28.01.26 Заявка 3649
				   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Комментарий КАК Комментарий,
				   //-МАН
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
        ОбластьМакета.Параметры.ДатаРождения = Выборка.ДатаРождения; 
		ОбластьМакета.Параметры.Телефон = Выборка.Телефон;
		ОбластьМакета.Параметры.Адрес = Выборка.АдресПоПрописке;
	    ОбластьМакета.Параметры.Возраст = ЛБ_ОбщийМодуль.ВычислитьВозраст(ДатаРождения);
		//+МАН 28.01.26 Заявка 3649
		ОбластьКомментарий.Параметры.Комментарий = Выборка.Комментарий;
		//-МАН		
	КонецЕсли;  
	
	СписокВидовОперации = Новый списокЗначений;
	СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
	СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога);
	СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов);
	СписокВидовОперации.Добавить(Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление);
	Запрос.УстановитьПараметр("СписокВидовОперации", СписокВидовОперации);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период КАК ДатаОперации,
	               |	ЛБ_ОборотыПоОперациямЗайма.ВидОперации КАК ВидОперации,
	               |	ЛБ_ОборотыПоОперациямЗайма.Ломбард КАК Ломбард,
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	               |ГДЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор.Залогодатель = &Залогодатель
	               |	И ЛБ_ОборотыПоОперациямЗайма.Регистратор ССЫЛКА Документ.ЛБ_ОперацияПоЗалогу
	               |	И ЛБ_ОборотыПоОперациямЗайма.ВидОперации В(&СписокВидовОперации)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период,
	               |	ЛБ_ОборотыПоОперациямЗайма.ВидОперации,
	               |	ЛБ_ОборотыПоОперациямЗайма.Ломбард,
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	               |ГДЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор.Контрагент = &Залогодатель
	               |	И ЛБ_ОборотыПоОперациямЗайма.Регистратор ССЫЛКА Документ.ЛБ_Реализация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОперации УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") И ПолучитьДокументОтмены(Выборка.Регистратор) Тогда
		    Продолжить;
		КонецЕсли;	
		ОбластьМакета.Параметры.ДатаОперации = Выборка.ДатаОперации;
		ОбластьМакета.Параметры.ВидОперации = Выборка.ВидОперации;
		ОбластьМакета.Параметры.Ломбард = Выборка.Ломбард.НомерЛомбарда;
		Прервать;
	КонецЦикла;  
	
	Если НЕ ДокументыЗалогодателя.Количество() = 0 Тогда
	    Стр = ДокументыЗалогодателя.Получить(0); 
		ОбластьМакета.Параметры.ВидДок = Стр.ВидДокумента;
		ОбластьМакета.Параметры.Серия = Стр.ДокументСерия;
		ОбластьМакета.Параметры.Номер = Стр.ДокументНомер;
		ОбластьМакета.Параметры.ДатаВыдачи = Стр.ДокументДатаВыдачи;  
	КонецЕсли;
	ТабличныйДокумент.Вывести(ОбластьМакета); 
	
	//+МАН 28.01.26 Заявка 3649
	Если ДокументыЗалогодателя.Количество() <> 0 Тогда
		Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти Тогда
			ТабличныйДокумент.Область("R4C4").ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
	КонецЕсли;
	//-МАН
	
	Если ДокументыЗалогодателя.Количество() > 1 Тогда 
		КолСтрок = ДокументыЗалогодателя.Количество()-1;
		Для сч = 1 По КолСтрок Цикл 
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаб"); 
			Стр = ДокументыЗалогодателя.Получить(сч);
	    	ОбластьМакета.Параметры.ВидДок = Стр.ВидДокумента;
			ОбластьМакета.Параметры.Серия = Стр.ДокументСерия;
			ОбластьМакета.Параметры.Номер = Стр.ДокументНомер;
			ОбластьМакета.Параметры.ДатаВыдачи = Стр.ДокументДатаВыдачи;
				
			ТабличныйДокумент.Вывести(ОбластьМакета); 
		КонецЦикла;
		
		ТабличныйДокумент.Область(4,8,4+КолСтрок,8).Объединить();
	КонецЕсли;	
	
	//+МАН 28.01.26 Заявка 3649
	ТабличныйДокумент.Вывести(ОбластьКомментарий);
	//-МАН
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал"); 
	ТабличныйДокумент.Вывести(ОбластьМакета); 
	
	Возврат ТабличныйДокумент;
КонецФункции	

&НаСервере
Функция ЗаполнитьСтатусыКлиента()
    СтатусыКлиента.Очистить();
	
    ТабличныйДокумент = Новый ТабличныйДокумент;  
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщиеМакеты.ЛБ_СтатусыКлиента"); 
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка"); 
	ТабличныйДокумент.Вывести(ОбластьМакета); 
	
	Если ТаблицаСтатусов.Количество() = 0 Тогда 
		ОбластьМакета = Макет.ПолучитьОбласть("Строка"); 
		ТабличныйДокумент.Вывести(ОбластьМакета);
			
		Возврат ТабличныйДокумент;
	КонецЕсли;  
	
	ОбластьМакета = Макет.ПолучитьОбласть("Строка");
	//+МАН 06.04.26 Подсветка служебного статуса. Заявка 3759
	ОбластьМакетаСС = Макет.ПолучитьОбласть("СтрокаСС");
	//
	Для каждого Стр Из ТаблицаСтатусов Цикл
		//+МАН 06.04.26 Подсветка служебного статуса. Добавлено условие. Заявка 3759
		Если Стр.НаименованиеСтатуса <> "Служебные статусы" Тогда
			ОбластьМакета.Параметры.Наименование = Стр.НаименованиеСтатуса; 
			ОбластьМакета.Параметры.Статус = Стр.Статус;
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Иначе
			СтрСправочника = Справочники.ЛБ_СлужебныеСтатусыКлиентов.НайтиПоНаименованию(Стр.Статус, Истина);
			Если СтрСправочника.ЗапретНаОперации.Количество() > 0 Тогда
				ОбластьМакетаСС.Параметры.Наименование = Стр.НаименованиеСтатуса; 
				ОбластьМакетаСС.Параметры.Статус = Стр.Статус;
				ТабличныйДокумент.Вывести(ОбластьМакетаСС);
			Иначе
				ОбластьМакета.Параметры.Наименование = Стр.НаименованиеСтатуса; 
				ОбластьМакета.Параметры.Статус = Стр.Статус;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		КонецЕсли;
		//-МАН
	КонецЦикла;	  
	Возврат ТабличныйДокумент;
КонецФункции	

&НаСервере
Функция ПроверитьСтатусПочетный() 
	ЕстьПочетный = Ложь;
	Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда 
		ЕстьПочетный = Истина;
	КонецЕсли;  
	
	Если ЕстьПочетный Тогда
		Возврат ЕстьПочетный;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	|	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		
		СтрокиД = ДокументыЗалогодателяДоп.НайтиСтроки(Отбор); 
		Для сч = 0 По СтрокиД.Количество()- 1 Цикл			
			СтрД = строкиД.Получить(сч);   
			Если НЕ (СтрД.ДокументСрокДействия = Дата(1,1,1)) Тогда
				Если СтрД.ДокументСрокДействия < НачалоДня(ТекущаяДатаСеанса()) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтатусЛояльности = ЛБ_УправлениеЛомбардом.ПолучитьСтатусПоСистемеЛояльности(ТекущаяДатаСеанса(), Выборка.статус);
			Если НЕ СтатусЛояльности = неопределено Тогда 
				ЕстьПочетный = Истина;
			КонецЕсли;	
		КонецЦикла;
	Конеццикла;	
	Возврат ЕстьПочетный;
КонецФункции 	

&НаСервере
Функция ПолучитьДопстатусыКлиента() 
	СписокДопСтатусов = Новый СписокЗначений;  
	
	Запрос = Новый Запрос; 
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
	//+МАН 03.12.25 Закомментировал. Непонятно ... зачем его исключили.
	//МассивСтатусов.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.VIP);
	//-МАН
	
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателей.Ссылка КАК Статус
	               |ИЗ
	               |	Справочник.ЛБ_СтатусыЗалогодателей КАК ЛБ_СтатусыЗалогодателей
	               |ГДЕ
	               |	ЛБ_СтатусыЗалогодателей.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ЭтоГруппа = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную = ИСТИНА
	               |	И НЕ ЛБ_СтатусыЗалогодателей.Ссылка В (&Статусы)
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется,
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.СрокДействия КАК СрокДействия,
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
	|			,
	|			Залогодатель = &Залогодатель
	|				И Статус = &Статус) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Период УБЫВ";
	Для каждого Стр Из ТаблицаЗапроса Цикл 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель);   
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Используется Тогда  
				Если ЗначениеЗаполнено(Выборка.СрокДействия) Тогда
					Если Выборка.СрокДействия >= ТекущаяДатаСеанса() Тогда
						Если СписокДопСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
							СписокДопСтатусов.Добавить(Выборка.Статус);
						КонецЕсли;	
					КонецЕсли;    
				Иначе   
					Если СписокДопСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
						СписокДопСтатусов.Добавить(Выборка.Статус);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ПроверитьСтатусПочетный() Тогда  
		Если СписокДопСтатусов.НайтиПоЗначению(Справочники.ЛБ_СтатусыЗалогодателей.Почетный) = неопределено Тогда 
			СписокДопСтатусов.Добавить(Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СписокДопСтатусов; 
КонецФункции

