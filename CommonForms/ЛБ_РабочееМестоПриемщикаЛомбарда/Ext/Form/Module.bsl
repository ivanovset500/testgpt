&НаСервере
Функция ПроверитьДокументыПравоПребыванияРФ(Клиент, ГражданствоКлиента)
	ЕстьДопДокумент = Ложь;
	Запрос = Новый Запрос;    
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса()); 
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Гражданство", ГражданствоКлиента);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен КАК ДокументНеДействителен,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Клиент
	               |				И Гражданство = &Гражданство
	               |				И ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ)
	               |				И ОсновнойДоп = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		Если Выборка.ДокументНЕДействителен Тогда
			Продолжить;
		КонецЕсли;	
		Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(ГражданствоКлиента, Выборка.ВидДокументаЗалогодателя, Выборка.ВидДокумента) Тогда
			Если Выборка.ДокументСрокДействия < НачалоДня(ТекущаяДатаСеанса()) Тогда
				Продолжить;
			КонецЕсли;	
            ЕстьДопДокумент = Истина;
			Прервать;
		Иначе	
			ЕстьДопДокумент = Истина;
			Прервать;
		КонецЕсли;	
	Конеццикла;	  
	Возврат ЕстьДопДокумент;
КонецФункции

&НаКлиенте
Процедура ВыдачаЗайма(Команда) 
	Если НЕ ДатаСмерти = Дата(1,1,1) Тогда
		Сообщить("Дата смерти клиента " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy") + ". Выдача займа не возможна.");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ОсновнойДУЛ) Тогда
		Сообщить("Основной документ удостоверяющий личность клиента по которому возможна выдача займа не найден!", 60); 
		Возврат; 
	ИначеЕсли НЕ ОсновнойДУЛГражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		Если ПроверитьПоПеречнюНедружественныхСтран(ОсновнойДУЛГражданство) Тогда
			Сообщить("Клиент предъявил документ государства не дружественного по отношению к России. Выдача ссуды по этому документу не возможна.");
			Возврат;
		КонецЕсли;	
		Если НЕ ПроверитьДокументыПравоПребыванияРФ(Залогодатель, ОсновнойДУЛГражданство) Тогда 
			Сообщить("Не найдены основные документы, подверждающие право клиента на пребывание В РФ!");
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	ЕстьСовпадение = ПроверитьКлиента();
	Если ЕстьСовпадение Тогда 
		Возврат;
	КонецЕсли;	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Залогодатель", Залогодатель); 
	СтруктураПараметров.Вставить("ДатаРождения", ЭтаФорма.ДатаРождения);
	СтруктураПараметров.Вставить("ДокументЗалогодателя", ОсновнойДУЛ);
			
	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыдачиЗайма", СтруктураПараметров, ЭтаФорма, Истина,,,);

КонецПроцедуры

