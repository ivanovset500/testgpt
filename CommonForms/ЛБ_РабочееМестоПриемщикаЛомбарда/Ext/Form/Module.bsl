&НаСервере
Функция ПолучитьИзмененныйМакет(ИмяМакета, ИсходныйМакет = "")
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_МакетыПечатныхФормСрезПоследних.Макет КАК Макет
		|ИЗ
		|	РегистрСведений.ЛБ_МакетыПечатныхФорм.СрезПоследних(&Период, ИсходныйМакет = &ИсходныйМакет) КАК ЛБ_МакетыПечатныхФормСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_МакетыПечатныхФормСрезПоследних.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Период", ТекущаяУниверсальнаяДата());
		Запрос.УстановитьПараметр("ИсходныйМакет", ИсходныйМакет);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Макет = Выборка.Макет.Получить();
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПользовательскиеМакетыПечати.Макет КАК Макет,
			|	ПользовательскиеМакетыПечати.Использование КАК Использование
			|ИЗ
			|	РегистрСведений.ПользовательскиеМакетыПечати КАК ПользовательскиеМакетыПечати
			|ГДЕ
			|	ПользовательскиеМакетыПечати.ИмяМакета = &ИмяМакета";
			
			Запрос.УстановитьПараметр("ИмяМакета", ИмяМакета);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Если Выборка.Использование Тогда
					Макет = Выборка.Макет.Получить();
				Иначе	
					Макет = ПолучитьОбщийМакет(ИмяМакета);
				КонецЕсли;
			Иначе
				Макет = ПолучитьОбщийМакет(ИмяМакета);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Макет;
		
КонецФункции 

