&НаКлиенте
Процедура ПечатьЗБ(Команда)  
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда
		ПараметрыФормы = Новый Структура; 
		ВидОперации = ПолучитьВидОперацииЗБ(ТекСтрока.ЗалоговыйБилет); 
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда 
			ПараметрыФормы.Вставить("ИменаМакетов", "Переоформление");
		Иначе	
		    ПараметрыФормы.Вставить("ИменаМакетов", "ЗалоговыйБилет");  
		КонецЕсли;	
		ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ОперацияПоЗалогу");
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ТекСтрока.ЗалоговыйБилет);
		ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
	КонецЕсли;	
КонецПроцедуры

