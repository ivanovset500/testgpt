&НаСервере
Функция ПолучитьЛомбардыОтделения(Ломбард)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			,
		|			ВЫБОР
		|				КОГДА Отделение В
		|						(ВЫБРАТЬ
		|							ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|						ИЗ
		|							РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		//|ГДЕ
		//|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард <> &Ломбард
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЧисловой  УБЫВ";
		//|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЛомбарда  УБЫВ";
	
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

&НаСервере
Функция СортироватьТЗЛомбарды(ТЗЛомбарды)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВнешнийИсточник.Ломбард КАК Ломбард
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВнешнийИсточник КАК ВнешнийИсточник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ломбард КАК Ломбард
	|ИЗ
	|	ВТ КАК ВТ
	|	
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Ломбард.НомерЧисловой";
	
	Запрос.УстановитьПараметр("ВнешнийИсточник", ТЗЛомбарды);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаКлиенте
Процедура ПечатьСогласиеНаОбработкуПД(Команда)
	ТекСтр = Элементы.ТаблицаЗБ.ТекущиеДанные;
	
	ЛБ_СогласияНаОбработкуПД_Сервер.ЗаключитьСогласиеНаОбработкуПД_ЗБ(ТекСтр.ЗалоговыйБилет);
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИмяКоманды",    Команда.Имя);
	СтруктураПараметров.Вставить("ОперацияЗайма", ТекСтр.ЗалоговыйБилет);
	ЛБ_СогласияНаОбработкуПД_Клиент.ОбработкаКоманд(СтруктураПараметров);
КонецПроцедуры
