Функция ПолучитьКомплаенсСтатусыКлиента()
	СписокКомплаенсСтатусов = Новый СписокЗначений;
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);   	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	|	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК Статус
	|ИЗ
	|	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КлиентыВПеречняхСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.Террористы);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);  
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			Если СписокКомплаенсСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
