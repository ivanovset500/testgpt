&НаКлиенте
Процедура РасторгнутьЭДОКлиентЗавершение(Результат, ДополнительныеПараметры) Экспорт
	ОтветРасторжениеПодписано = Вопрос("Заявление о расторжении ЭДО подписано клиентом?",
	РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
	Если ОтветРасторжениеПодписано = КодВозвратаДиалога.Да Тогда
		РезультатРасторженияЭДО = ЛБ_СоглашенияЭДОСервер.РасторгнутьЭДОСервер(Залогодатель);
		Если РезультатРасторженияЭДО Тогда
			Элементы.СтатусЭДО.Заголовок = "нет";
			//+МАН 28.01.26 Заявка 3649
			Элементы.СтатусЭДО.ЦветТекста = WebЦвета.Красный;
			//-МАН
		КонецЕсли;	
	КонецЕсли;
