		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда  
			Если СписокКомплаенсСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
				СписокКомплаенсСтатусов.Добавить("МВК заморожен");
			КонецЕсли;
        КонецЕсли;	
	КонецЕсли;	
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			Если СписокКомплаенсСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
				СписокКомплаенсСтатусов.Добавить("В перечне ФРОМУ");
			КонецЕсли;
		КонецЕсли;  
	КонецЕсли;     
	
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ООН);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0 Тогда
		Выборка = Строки.Получить(0);
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда 
			Если СписокКомплаенсСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
				СписокКомплаенсСтатусов.Добавить("В перечне ООН");
			КонецЕсли;
		КонецЕсли;  
	КонецЕсли;
		
	Отбор.Вставить("ВидПеречня", Перечисления.ЛБ_ВидыПеречней.ЦБ);
	Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
	Если НЕ Строки.Количество() = 0 Тогда  
		Если СписокКомплаенсСтатусов.НайтиПоЗначению(Выборка.Статус) = неопределено Тогда 
			СписокКомплаенсСтатусов.Добавить("В перечне ЦБ");
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СписокКомплаенсСтатусов;
КонецФункции	

&НаСервере
Процедура ЗаполнитьИнформациюОКлиентеДополнительно()  
	ТаблицаСтатусов.Очистить();
	СтатусЗалогодателя = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ТекущаяДатаСеанса(), Залогодатель); 
	
	НоваяСтр = ТаблицаСтатусов.Добавить();
	НоваяСтр.НаименованиеСтатуса = "Статус по системе лояльности"; 
	НоваяСтр.Статус = СтатусЗалогодателя;   
	
	СписокДопСтатусов = ПолучитьДопстатусыКлиента(); 
	Если НЕ СписокДопСтатусов.Количество() = 0 Тогда
	    ДопСтатусы = ""; 
		Для каждого Эл Из СписокДопСтатусов Цикл
			ДопСтатусы = ДопСтатусы + ?(ПустаяСтрока(ДопСтатусы), "", ", ") + строка(Эл.Значение);
		Конеццикла;
		
		НоваяСтр = ТаблицаСтатусов.Добавить();
		НоваяСтр.НаименованиеСтатуса = "Дополнительные статусы"; 
		НоваяСтр.Статус = ДопСтатусы;  
	КонецЕсли;  
	
	СписокСлужебныхСтатусов = ПолучитьСлужебныеСтатусыКлиента(); 
	Если НЕ СписокСлужебныхСтатусов.Количество() = 0 Тогда
	    СтатусыСлужебные = ""; 
		Для каждого Эл Из СписокСлужебныхСтатусов Цикл
			СтатусыСлужебные = СтатусыСлужебные + ?(ПустаяСтрока(СтатусыСлужебные), "", ", ") + строка(Эл.Значение);
		Конеццикла;
		
		НоваяСтр = ТаблицаСтатусов.Добавить();
		НоваяСтр.НаименованиеСтатуса = "Служебные статусы"; 
		НоваяСтр.Статус = СтатусыСлужебные;  
	КонецЕсли; 
	
	СписокКомплаенсСтатусов = ПолучитьКомплаенсСтатусыКлиента(); 
	Если НЕ СписокКомплаенсСтатусов.Количество() = 0 Тогда
	    СтатусыКомплаенс = ""; 
		Для каждого Эл Из СписокКомплаенсСтатусов Цикл
			СтатусыКомплаенс = СтатусыКомплаенс + ?(ПустаяСтрока(СтатусыКомплаенс), "", ", ") + строка(Эл.Значение);
		Конеццикла;
		
		НоваяСтр = ТаблицаСтатусов.Добавить();
		НоваяСтр.НаименованиеСтатуса = "Комплаенс статусы"; 
		НоваяСтр.Статус = СтатусыКомплаенс;  
	КонецЕсли;  
	
	ЕстьЭДО = ЛБ_СоглашенияЭДОСервер.НаличиеДействующегоСоглашения(Залогодатель);
КонецПроцедуры

&НаКлиенте
Процедура ПоискЗалогодателя(Команда)
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалогодателя", ЭтаФорма);

	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", , ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗалогодателя(Результат,Параметры) Экспорт
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;		
	Иначе
		Залогодатель = Результат.Залогодатель;  
		ПолучитьКонтактнуюИнформацию();
		ИнформацияОКлиенте = ЗаполнитьИнформациюОКлиенте();  
		ЗаполнитьИнформациюОКлиентеДополнительно();   
		СтатусыКлиента = ЗаполнитьСтатусыКлиента();
		ВыборЗБ = 1; 
		ТекущийВыборЗБ = 1; 
		Если НЕ ПустаяСтрока(НомерЗБ) Тогда 
			НомерЗБ = "";
			Элементы.НомерЗБ.Видимость = Ложь;
		КонецЕсли;	
	    ПолучитьСписокЗБ(Истина);  		
		ЗаполнитьСписокЛомбардов(); 
		УстановитьОтборНаСервере();          
		Элементы.ИнформацияОКлиенте.Высота = ИнформацияОКлиенте.ВысотаТаблицы;
		Элементы.СтатусыКлиента.Высота = СтатусыКлиента.ВысотаТаблицы; 
		Элементы.КарточкаКлиента.Доступность = Истина;
		Элементы.СтатистикаОбращений.Доступность = Истина;
		Элементы.ЭДО.Доступность = Истина;  
		//+МАН 28.01.26 Изменил. Заявка 3649
		//Элементы.ГруппаКнопки.Доступность = Истина;  
		Элементы.СогласиеНаОпробование.Доступность = Истина;
		Элементы.ФормаЗаявлениеНаВозврат.Доступность = Истина;
		Элементы.ФормаЗаявлениеОПредоставленииСведений.Доступность = Истина;
		Элементы.ФормаАктНаследник.Доступность = Истина;
		//-МАН
		Элементы.КомандыТаблицыЗБ.Доступность = Истина; 
		Элементы.ГруппаВыбораЗБ.Доступность = Истина;
		
		НаличиеЭДО = ЛБ_СоглашенияЭДОСервер.НаличиеДействующегоСоглашения(Залогодатель);
		
		Если НаличиеЭДО Тогда
			Элементы.СтатусЭДО.Заголовок = "есть";
		Иначе
			Элементы.СтатусЭДО.Заголовок = "нет";
		КонецЕсли;
		
		НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
		
		Если НаличиеСогласия Тогда
			Элементы.СтатусСогласия.Заголовок = "есть";
		Иначе
			Элементы.СтатусСогласия.Заголовок = "нет";
		КонецЕсли;
		
		//+МАН 28.01.26 Заявка 3649
		ОформлениеЭДО(НаличиеЭДО);
		//-МАН
		
		ЗапуститьФоновоеЗадание();
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ЗапуститьФоновоеЗадание()
    ИдентификаторЗадания = ЗапуститьФоновоеЗаданиеНаСервере();
    ОжиданиеВыполнения = Новый ОписаниеОповещения("ПроверитьВыполнениеЗадания", ЭтаФорма);
    ПодключитьОбработчикОжидания("ПроверитьВыполнениеЗадания", 1, Ложь);
КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗаданиеНаСервере()
    ПараметрыЗадания = Новый Массив;
	СписокЗБ = Новый СписокЗначений;
	Для Каждого Стр Из ТаблицаЗБ Цикл
	    СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
	КонецЦикла;    
	ПараметрыЗадания.Добавить(СписокЗБ);   
	ПараметрыЗадания.Добавить(ДатаСмерти);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("ЛБ_УправлениеЛомбардом.ВыполнитьОбработкуДанныхТаблицыЗБ", ПараметрыЗадания);
    Возврат ФоновоеЗадание.УникальныйИдентификатор;
КонецФункции

&НаКлиенте
Процедура ПроверитьВыполнениеЗадания() Экспорт
    Результат = ПроверитьВыполнениеЗаданияНаСервере();
    
    Если Результат.Выполнено Тогда
        ОтключитьОбработчикОжидания("ПроверитьВыполнениеЗадания");
        //ПоказатьОповещениеПользователя("Результат обработки", , Результат.ТекстРезультата);
		//+МАН 18.03.26 Добавил установку отбора.
		УстановитьОтборНаСервере();
		//-МАН
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьВыполнениеЗаданияНаСервере()
    Результат = Новый Структура("Выполнено, ТекстРезультата", Ложь, "");
    
    ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания); 
	СообщенияИзФона = ФоновоеЗадание.ПолучитьСообщенияПользователю(Истина);
	Для Каждого Сообщ Из СообщенияИзФона Цикл
		ОбработатьСообщениеФЗ(Сообщ.Текст);
	КонецЦикла;
    
    Если ФоновоеЗадание <> Неопределено И ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
        Результат.Выполнено = Истина;
       // Результат.ТекстРезультата = ФоновоеЗадание.ПолучитьРезультат();
	   ФоновоеЗадание.Отменить();
    КонецЕсли;
    
    Возврат Результат;
КонецФункции     

&НаСервере
Процедура ОбработатьСообщениеФЗ(Сообщ)
	Поз = Найти(Сообщ, ";");
	НомерЗБ = Лев(Сообщ, Поз-1);
	Сообщ = Сред(Сообщ, Поз+1);
	
	Поз = Найти(Сообщ, ";"); 
	ПроцентнаяСтавка = СокрЛП(Лев(Сообщ, Поз-1));
	Сообщ = Сред(Сообщ, Поз+1);

	Поз = Найти(Сообщ, ";"); 
	СуммаПроцентовВДень = СокрЛП(Лев(Сообщ, Поз-1));
	Сообщ = Сред(Сообщ, Поз+1);
	
	Поз = Найти(Сообщ, ";");   
	//Попытка
	    Долг = Число(СокрЛП(Лев(Сообщ, Поз-1))); 
	//Исключение   
	//	Долг = 0;
	//КонецПопытки;   
	Сообщ = Сред(Сообщ, Поз+1);
	
	ЕстьДоверенность = СокрЛП(Сообщ);
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерЗБ", НомерЗБ);
	СтрокиЗБ = ТаблицаЗБ.НайтиСтроки(Отбор);
	Если НЕ СтрокиЗБ.Количество() = 0 Тогда 
		 СтрЗБ = СтрокиЗБ.Получить(0); 
		 СтрЗБ.ПроцентнаяСтавка = ПроцентнаяСтавка;
		 СтрЗБ.СуммаПроцентовВДень = СуммаПроцентовВДень; 
		 СтрЗБ.Долг = Долг;  
		 СтрЗБ.Доверенность = ?(ЕстьДоверенность = "да", истина, ложь);  
		 
		 //+МАН 05.12.25 Заполнение подвала
		 Элементы.ТаблицаЗБДолг.ТекстПодвала = ТаблицаЗБ.Итог("Долг");
		 //-МАН
		 
		 Элементы.ТаблицаЗБ.Обновить();
    КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ПолучитьКонтактнуюИнформацию()  
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти КАК ДатаСмерти,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда   
		Фамилия = Выборка.Фамилия;
		Имя = Выборка.Имя;
		Отчество = Выборка.Отчество;
		ФИО = СокрЛП(Выборка.Фамилия) + " " + СокрЛП(Выборка.Имя) + ?(ПустаяСтрока(Выборка.Отчество), "", " " + СокрЛП(Выборка.Отчество)); 
		ДатаРождения = Выборка.ДатаРождения; 
		ДатаСмерти = Выборка.ДатаСмерти;
		Пол = Выборка.Пол; 
		Телефон = Выборка.Телефон;
		АдресПоПрописке = Выборка.АдресПоПрописке;
		ФактическийАдрес = Выборка.ФактическийАдрес;
	Иначе
		ФИО = "ФИО клиента не определено";
	КонецЕсли;	
КонецПроцедуры	

