	ЗаемщикТекстом  = СтрШаблон("%1 %2%3", Фамилия, Имя, ЗаемщикОтчество);
	ОбластьМакетаШапка.Параметры.Заемщик                            = ПолучитьСклоненияСтроки(ЗаемщикТекстом, , "ПД=Родительный")[0];
	ОбластьМакетаШапка.Параметры.ДатаРожденияЗаемщика               = Формат(ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьМакетаШапка.Параметры.УдостоверяющийДокументЗаемщика     = СокрЛП(ПаспортныеДанныеКлиента().ПаспортныеДанные);
	ОбластьМакетаШапка.Параметры.АдресРегистрацииЗаемщика           = ?(Не ПустаяСтрока(АдресПоПрописке), АдресПоПрописке, ФактическийАдрес);
	ОбластьМакетаШапка.Параметры.Телефон                            = ?(ПустаяСтрока(Телефон), "", Телефон);
	ОбластьМакетаШапка.Параметры.ОрганизацияНаименованиеСокращенное = НаименованиеОрганизации().НаименованиеСокращенное;
	
	ТабДок.Вывести(ОбластьМакетаШапка);
	
	ТабДок.Вывести(ОбластьМакетаТекст);
	
	ОбластьМакетаПодвал.Параметры.НаименованиеЛомбардаИНомерОтделения = "";    
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Сотрудник = ТекПользователь.Сотрудник;
	Иначе
		Сотрудник = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	ОбластьМакетаПодвал.Параметры.Работник                            = Сотрудник;
	ОбластьМакетаПодвал.Параметры.Дата                                = Формат(ТекущаяДатаСеанса(),"ДЛФ=ДД");
	
	ТабДок.Вывести(ОбластьМакетаПодвал);
	
	Возврат ТабДок;
	
КонецФункции  

&НаСервере
Функция ПечатьАктОПолученииИзделийНаследниками_ТабДок()  
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб         = Истина;
	ТабДок.ОтображатьСетку     = Ложь;
	ТабДок.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДок.ТолькоПросмотр      = Истина; 
	
	Если Не РольДоступна("ПолныеПрава") Тогда
		ТабДок.Защита = Истина;
	КонецЕсли;
	
	ИсходныйМакет = Справочники.ЛБ_ШаблоныМакетов.АктОПолученииИзделийНаследниками.Наименование;
	Макет = ПолучитьИзмененныйМакет("ЛБ_АктОПолученииИзделийНаследниками", ИсходныйМакет);
	
	ОбластьМакетаШапка  = Макет.ПолучитьОбласть("Шапка"); 
	ОбластьМакетаТекст  = Макет.ПолучитьОбласть("Текст");
	ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьМакетаШапка.Параметры.АдресЛомбарда                      = "";
	ОбластьМакетаШапка.Параметры.Дата                               = Формат(ТекущаяДатаСеанса(),"ДЛФ=ДД"); 
	ОбластьМакетаШапка.Параметры.ОрганизацияНаименованиеСокращенное = НаименованиеОрганизации().НаименованиеСокращенное;
	
	ТабДок.Вывести(ОбластьМакетаШапка);
	
	ЗаемщикОтчество = ?(ПустаяСтрока(Отчество), "", СтрШаблон(" %1", Отчество));
	ЗаемщикТекстом  = СтрШаблон("%1 %2%3", Фамилия, Имя, ЗаемщикОтчество);
	ОбластьМакетаТекст.Параметры.Заемщик                        = ПолучитьСклоненияСтроки(ЗаемщикТекстом, , "ПД=Родительный")[0];
	ОбластьМакетаТекст.Параметры.УдостоверяющийДокументЗаемщика = СокрЛП(ПаспортныеДанныеКлиента(Истина).ПаспортныеДанные);
	
	ТабДок.Вывести(ОбластьМакетаТекст);
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Сотрудник = ТекПользователь.Сотрудник;
	Иначе
		Сотрудник = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	ОбластьМакетаПодвал.Параметры.Сотрудник = Сотрудник; 
	
	ТабДок.Вывести(ОбластьМакетаПодвал);
	
	Возврат ТабДок;
	
КонецФункции	

