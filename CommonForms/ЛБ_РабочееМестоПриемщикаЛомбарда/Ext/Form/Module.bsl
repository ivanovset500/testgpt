&НаКлиенте
Процедура ТаблицаЗБПриАктивизацииСтроки(Элемент)
	ЭтоЛомбард = ПользовательЛомбард();
	
	ТекСтр = Элементы.ТаблицаЗБ.ТекущиеДанные;
	
	Если ТекСтр <> Неопределено Тогда
		Если ТекСтр.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Реализован") И ЭтоЛомбард Тогда
			Элементы.ТекущееСостояниеЗБ.Доступность = Ложь;
		Иначе
			Элементы.ТекущееСостояниеЗБ.Доступность = Истина;
		КонецЕсли;
	КонецЕсли;

	//+МАН 19.02.26 Заявка 3649
	Если ТекСтр <> Неопределено И ТекСтр.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления") Тогда
		Элементы.ФормаГруппаПечатьЗБ.Доступность = Ложь;
	Иначе
		Элементы.ФормаГруппаПечатьЗБ.Доступность = Истина;
	КонецЕсли;
	//-МАН
КонецПроцедуры

