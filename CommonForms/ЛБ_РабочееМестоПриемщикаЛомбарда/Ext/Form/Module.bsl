&НаКлиенте
Процедура ПослеВыбораЗалогодателяОплатаПроцентов(Результат,Параметры) Экспорт	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат; 
	Иначе          
		Если НЕ Результат.Плательщик = Залогодатель Тогда
		     ПроверкаПоПеречням(Результат.Плательщик);
		КонецЕсли;	 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ПредыдущаяОперация); 
		ПараметрыФормы.Вставить("Плательщик", Результат.Плательщик);
		ПараметрыФормы.Вставить("ДокументПлательщика", Результат.ДокументЗалогодателя);
		ПараметрыФормы.Вставить("Доверенность", Результат.Доверенность);
		//ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораТекущееСостояниеЗБ", Этаформа);
		//ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаОплатыПроцентов", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения); 
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаОплатыПроцентов", ПараметрыФормы, ЭтаФорма, Истина,,,);
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Функция ПолучитьСуммуЗайма(ЗалоговыйБилет) 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаЗайма;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаКлиенте
Процедура ВыдачаОХ(Команда)    
	ТекСтрока = Элементы.ТаблицаЗБ.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		Если НЕ ТекСтрока.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.ОтвественноеХранение") И
			 НЕ ТекСтрока.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Наследство") Тогда  
			ТекстПредупреждения = "Залоговый билет № " + СокрЛП(ТекСтрока.НомерЗБ) + " в статусе " + Строка(ТекСтрока.СтатусЗалоговогоБилета) + ". Выполнение операции невозможно.";  
			Предупреждение(ТекстПредупреждения, 60);
			Возврат;
		ИначеЕсли ТекСтрока.СтатусЗалоговогоБилета = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Наследство") Тогда  
		     СуммаЗайма = ПолучитьСуммуЗайма(ТекСтрока.ЗалоговыйБилет); 
			 Если НЕ СуммаЗайма = 0 Тогда
				 ТекстПредупреждения = "Долг по залоговому билету № " + СокрЛП(ТекСтрока.НомерЗБ) + " в статусе " + Строка(ТекСтрока.СтатусЗалоговогоБилета) +
				      СокрЛП(Формат(СуммаЗайма, "ЧЦ=15; ЧДЦ=2")) + " рублей. Выполнение операции невозможно.";  
				 Предупреждение(ТекстПредупреждения, 60);
				 Возврат;
			 КонецЕсли;	 
		 КонецЕсли;
		 
		СообщениеМ = ПроверитьМестонахождениеОЗ(ТекСтрока.ЗалоговыйБилет);
		Если НЕ ПустаяСтрока(СообщениеМ) Тогда 
			Предупреждение(СообщениеМ, 60);
			Возврат;
		КонецЕсли;	

		СтруктураПараметров = Новый Структура("ВидОперации");
		СтруктураПараметров.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога");
		
		ПараметрыФормы = Новый Структура; 
		ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога"));
		ПараметрыФормы.Вставить("Номер", ПолучитьНомерЗалоговогоБилета(ТекСтрока.ЗалоговыйБилет));
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораЗалогодателяВыдачаЗалога",Этаформа,СтруктураПараметров);	
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателяПоНомеруБилета",ПараметрыФормы,Этаформа,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗалогодателяВыдачаЗалога(Результат,Параметры) Экспорт
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
