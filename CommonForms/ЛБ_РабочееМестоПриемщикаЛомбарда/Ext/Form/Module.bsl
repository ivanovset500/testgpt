//++ИВВ, 02.2026, согласия
#Область Согласия
&НаКлиенте
Процедура ЗаключитьСогласие(Команда)
	Если ДатаСмерти = Дата(1,1,1) Тогда
		Если ЗначениеЗаполнено(Телефон) Тогда	
			ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд(Команда.Имя, Залогодатель,,,ЭтаФорма);
			НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
			
			Если НаличиеСогласия Тогда
				Элементы.СтатусСогласия.Заголовок = "есть";
			Иначе
				Элементы.СтатусСогласия.Заголовок = "нет";
			КонецЕсли;
		Иначе
			Предупреждение("Для заключения согласия на информирование заполните номер телефона",, "Номер телефона не заполнен");
		КонецЕсли;
	Иначе
		Предупреждение("Клиент умер. Дата смерти " + Формат(ДатаСмерти, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьСогласие(Команда)
	ОписаниеОповещенияОтозватьСогласиеПродолжить = Новый ОписаниеОповещения("ОтозватьСогласиеПродолжить", ЭтотОбъект);
	ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд(Команда.Имя, Залогодатель,ОписаниеОповещенияОтозватьСогласиеПродолжить,,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусСогласия(Результат, ДополнительныеПараметры) Экспорт
	НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
	
	Если НаличиеСогласия Тогда
		Элементы.СтатусСогласия.Заголовок = "есть";
	Иначе
		Элементы.СтатусСогласия.Заголовок = "нет";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьСогласиеПродолжить(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		Если Результат Тогда
			ОписаниеОповещенияОтозватьСогласиеЗавершение = Новый ОписаниеОповещения("ОтозватьСогласиеЗавершение", ЭтотОбъект);
			ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд("ОтозватьСогласиеПродолжить", Залогодатель,ОписаниеОповещенияОтозватьСогласиеЗавершение,,ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьСогласиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	ОтветРасторжениеПодписано = Вопрос("Заявление на отзыв Согласия на информирование подписано клиентом?",
	РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
	Если ОтветРасторжениеПодписано = КодВозвратаДиалога.Да Тогда
		РезультатОтзываСогласия = ЛБ_СогласияНаИнформированиеСервер.ОтозватьСогласиеНаИнформирование(Залогодатель);
		Если РезультатОтзываСогласия Тогда
			Элементы.СтатусСогласия.Заголовок = "нет";
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСогласие(Команда)
	ЛБ_СогласияНаИнформированиеКлиент.ОбработкаКоманд(Команда.Имя, Залогодатель);
	НаличиеСогласия = ЛБ_СогласияНаИнформированиеСервер.НаличиеДействующегоСогласия(Залогодатель);
	
	Если НаличиеСогласия Тогда
		Элементы.СтатусСогласия.Заголовок = "есть";
	Иначе
		Элементы.СтатусСогласия.Заголовок = "нет";
	КонецЕсли;	
КонецПроцедуры

