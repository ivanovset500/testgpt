Процедура Прейскурант(Команда) 	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Действующие", Истина); 
	Если ЗначениеЗаполнено(ТекущийЛомбард) Тогда
		ПараметрыФормы.Вставить("Ломбард", ТекущийЛомбард);
