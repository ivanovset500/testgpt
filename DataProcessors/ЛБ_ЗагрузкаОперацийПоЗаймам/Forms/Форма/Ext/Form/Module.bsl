	ЗагрузитьИзъятияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКассуНаСервере() 
	Если ЗначениеЗаполнено(Ломбард) Тогда
		Ломб = СокрЛП(Ломбард.НомерЛомбарда);
	Иначе
		Ломб = "";
	КонецЕсли;
	
	ЛБ_ОбменLX.Kassa(Формат(Нач,"ДФ=dd.MM.yyyy"), Формат(Кон,"ДФ=dd.MM.yyyy"), Ломб);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКассу(Команда)
	ЗагрузитьКассуНаСервере();
КонецПроцедуры

