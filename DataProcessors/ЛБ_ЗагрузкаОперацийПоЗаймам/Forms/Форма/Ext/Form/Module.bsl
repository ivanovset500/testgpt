&НаСервере
Процедура ЗагрузитьОХНаСервере()
	Если Не ЗначениеЗаполнено(Ломбард) Тогда
		Сообщить("Выберите ломбард");
		Возврат ;
	КонецЕсли;
	
	Кон1 = Кон+86400;
	ЛБ_ОбменLX.ЗагрузитьВыдачуОтветхранения(Формат(Нач,"ДФ=dd.MM.yyyy"), Формат(Кон1,"ДФ=dd.MM.yyyy"), СокрЛП(Ломбард.id_LX), ПерезаписыватьКлиентов);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОХ(Команда)
	ЗагрузитьОХНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзъятияНаСервере()

	ЛБ_ОбменLX.ЗагрузитьИзъятиеЗаймов(Формат(Нач,"ДФ=dd.MM.yyyy"), Формат(Кон,"ДФ=dd.MM.yyyy"), "");
	ЛБ_ОбменLX.ЗагрузитьВозвратИзъятого(Формат(Нач,"ДФ=dd.MM.yyyy"), Формат(Кон,"ДФ=dd.MM.yyyy"), "");

КонецПроцедуры

