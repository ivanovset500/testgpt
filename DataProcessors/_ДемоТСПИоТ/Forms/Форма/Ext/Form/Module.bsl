&НаСервере
Функция ПолучитьШаблонЧека(ККТ)
	
	// Общие параметры чека
	ОбщиеПараметры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииЧекаКоррекции();     
	ОбщиеПараметры.ИдентификаторФискальнойЗаписи = ИдентификаторФискальнойЗаписи;
	ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	ОбщиеПараметры.ПокупательEmail = "test@1c.ru";
	ОбщиеПараметры.ПокупательНомер = Неопределено;     
	
	Строка = ККТ.ПараметрыРегистрации.Найти("ОрганизацияНазвание", "НаименованиеПараметра");
	ОбщиеПараметры.ОрганизацияНазвание = Строка.ЗначениеПараметра;
	Строка = ККТ.ПараметрыРегистрации.Найти("ОрганизацияИНН", "НаименованиеПараметра");
	ОбщиеПараметры.ОрганизацияИНН = Строка.ЗначениеПараметра;
	
	ОбщиеПараметры.Кассир     = КассирФИО;
	ОбщиеПараметры.КассирИНН  = КассирИНН;

	ОбщиеПараметры.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
	ОбщиеПараметры.АдресРасчетов  = "г.Москва, Дмитровское ш. д.9";
	ОбщиеПараметры.МестоРасчетов  = "Торговый островок на 1 этаже";
	
	СуммаЧека = 0;
	
	Для Каждого Товар Из Товары Цикл   
		СтрокаПозицииЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
		СтрокаПозицииЧека.Наименование = Товар.Наименование;
		СтрокаПозицииЧека.Количество   = Товар.Количество; 
		СтрокаПозицииЧека.Цена         = Мин(Товар.Цена, 100);
		СтрокаПозицииЧека.Сумма        = Окр(СтрокаПозицииЧека.Количество * СтрокаПозицииЧека.Цена, 2);
		СтрокаПозицииЧека.СтавкаНДС    = Товар.НДС;
		СтрокаПозицииЧека.КодЕдиницыИзмерения = "796";
		СтрокаПозицииЧека.ПризнакСпособаРасчета  = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
		СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ;
		СтрокаПозицииЧека.КонтрольнаяМарка = Товар.КонтрольнаяМарка;   
		СтрокаПозицииЧека.ЗапросПроверкиКода.ИдентификаторЗапроса = Товар.ИдентификаторЗапросаРазрешения;
		СтрокаПозицииЧека.ЗапросПроверкиКода.ВременнаяМетка = Товар.ВремяЗапросаРазрешения;     
		СтрокаПозицииЧека.ЗапросПроверкиКода.ИдентификаторЭкземпляра = Товар.ИдентификаторЭкземпляра;
		СтрокаПозицииЧека.ЗапросПроверкиКода.ВерсияБазы = Товар.ВерсияБазы;
		ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);
		СуммаЧека = СуммаЧека + СтрокаПозицииЧека.Сумма;
	КонецЦикла;
	
	СтрокаОплаты = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыСтрокиОплаты(СуммаЧека);
	СтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные;
	ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	
	Возврат ОбщиеПараметры;
	
КонецФункции

&НаКлиенте
Функция ПараметрыВыполненияОперации();
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
	ПараметрыОперации.Кассир = КассирФИО;
	ПараметрыОперации.КассирИНН = КассирИНН;
	ПараметрыОперации.АдресРасчетов = "Дмитровское ш. д.9";
	ПараметрыОперации.МестоРасчетов = "1 Этаж";
	Возврат ПараметрыОперации;
	
КонецФункции    

&НаКлиенте
Процедура ОбновитьДанные(РезультатВыполнения);
	
	Если РезультатВыполнения.Свойство("НомерЧекаККТ") Тогда
		НомерЧека = РезультатВыполнения.НомерЧекаККТ;
	КонецЕсли;
		
	Если РезультатВыполнения.Свойство("НомерСменыККТ") Тогда
		НомерСмены = РезультатВыполнения.НомерСменыККТ;
	КонецЕсли;
		
	Если РезультатВыполнения.Свойство("СтатусСмены") Тогда  
		Если РезультатВыполнения.СтатусСмены = 1 Тогда
			СтатусСмены = НСтр("ru='Закрыта'")
		ИначеЕсли РезультатВыполнения.СтатусСмены = 2 Тогда
			СтатусСмены = НСтр("ru='Открыта'")
		Иначе
			СтатусСмены = НСтр("ru='Истекла'")
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры     

