&НаКлиенте
Перем ДополнительныеПараметры;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстройствоЗанято = Ложь;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	ПолучитьОборудованиеНаСервере();
	
	КассирФИО = НСтр("ru='Иванов П.П.'");
	КассирИНН = "526317984689";    
	КонтрольнаяМарка = "";
	
	СТ_РегистрацияПройдена = Ложь;
	СТ_АварийныйРежим = Ложь;
	СТ_ЛМЧЗГотов = Ложь;
	СТ_АвторизацияПройдена = Ложь;      
	СТ_ГотовКПроверкеКМOnline = Ложь; 
	СТ_ГотовКПроверкеКМOffline = Ложь;  
	СТ_АварийныйРежим = Ложь; 
	СТ_ПостАварийныйРежим = Ложь;    
	СТ_Error = "";
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ТестовыеДанные");
	Для Индекс = 1 по Макет.ВысотаТаблицы Цикл   
		Строка = ТестовыеДанные.Добавить();  
		Строка.Номер = Макет.Область(Индекс,1).Текст;   
		КодМаркировки = СокрЛП(Макет.Область(Индекс,2).Текст);   
		Если СтрНачинаетсяС(КодМаркировки, "0") Тогда            
			КодМаркировки = СтрЗаменить(КодМаркировки, "\u001d", МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1());
			КодМаркировки = МенеджерОборудованияКлиентСервер.ШтрихкодВBase64(КодМаркировки);
		КонецЕсли;  
		Строка.GTIN = СокрЛП(Макет.Область(Индекс,3).Текст);
		Строка.КодМаркировки = КодМаркировки;   
		Строка.Цена = Число(СокрЛП(Макет.Область(Индекс,4).Текст));       
		Строка.Наименование = СокрЛП(Макет.Область(Индекс,5).Текст); 
		Строка.Название = Строка(Строка.Номер) + "." + СокрЛП(Макет.Область(Индекс,6).Текст);      
	КонецЦикла; 
	
	ИдентификаторФискальнойЗаписи = Новый УникальныйИдентификатор();      
	Элементы.СтраницаСтатусТСПИоТИдетНастройка.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации(Истина);      
	
	ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.СканерШтрихкода = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(Неопределено, УникальныйИдентификатор, ПоддерживаемыеТипы);   
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.СканерШтрихкода = Истина;
	ПоддерживаемыеТипы.ККТ = Истина;
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованияПоТипу(Неопределено, УникальныйИдентификатор, ПоддерживаемыеТипы);   
	
КонецПроцедуры   

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" Тогда
		КонтрольнаяМарка = Параметр[0]; 
		Если ИмяСобытия = "ScanData" Тогда
			Штрихкод = Параметр[0];
			ДанныеМаркировки = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(Штрихкод);
			Если ДанныеМаркировки.Разобран Тогда
				Если ДанныеМаркировки.ТипИдентификатораТовара = ПредопределенноеЗначение("Перечисление.ТипыИдентификаторовТовараККТ.КодТовараВФорматеEAN13") Или
					ДанныеМаркировки.ТипИдентификатораТовара = ПредопределенноеЗначение("Перечисление.ТипыИдентификаторовТовараККТ.КодТовараВФорматеITF14") Тогда 
					ПоказатьПредупреждение(, НСтр("ru='Считайте средство идентификации маркированного товара.'"));
				Иначе
					КонтрольнаяМарка = МенеджерОборудованияКлиентСервер.ШтрихкодВBase64(Штрихкод); 
					НачатьДобавлениеКМ(КонтрольнаяМарка); 
					Сообщить(НСтр("ru='Сканирована КМ:'")+ Штрихкод);
				КонецЕсли; 
			Иначе            
				ПоказатьПредупреждение(, НСтр("ru='Штрихкод не является средством идентификации маркированного товара.'"));
			КонецЕсли; 
		КонецЕсли;                                            
	КонецЕсли;       
	
	// считать средство идентификации маркированного товара
	
КонецПроцедуры

#КонецОбласти

