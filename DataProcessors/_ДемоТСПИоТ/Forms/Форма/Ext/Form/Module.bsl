&НаКлиенте
Процедура НачатьДобавлениеКМЗавершение(РезультатВыполнения, ПараметрыОперации) Экспорт
	
	ОчиститьСообщения();
	Элементы.Главная.Доступность = Истина;
	
	Если РезультатВыполнения.Свойство("СтатусСостояния") И  РезультатВыполнения.СтатусСостояния <> Неопределено Тогда 
		ОбновитьСтатусСостояния(РезультатВыполнения.СтатусСостояния);
	КонецЕсли;
		
	Если РезультатВыполнения.Результат Тогда
		
		РезультатПроверки = ""; 
		РезультатОтвета = Новый Структура();
		Если РезультатВыполнения.Свойство("РезультатПроверки") Тогда     
			РезультатОтвета = РасшифроватьОтветПИоТ(РезультатВыполнения.РезультатПроверки);    
			РезультатПроверки = ОбщегоНазначенияБПОСлужебныйВызовСервера.ФорматироватьJSON(РезультатВыполнения.РезультатПроверки);
		КонецЕсли;                      
		
		ИдентификаторЗапросаРазрешения = ?(РезультатОтвета.Свойство("reqId"), РезультатОтвета.reqId, "");
		ВремяЗапросаРазрешения = ?(РезультатОтвета.Свойство("reqTimestamp"), РезультатОтвета.reqTimestamp, "");  
		ИдентификаторЭкземпляра  = ?(РезультатОтвета.Свойство("inst"), РезультатОтвета.inst, "");     
		ВерсияБазы  = ?(РезультатОтвета.Свойство("version"), РезультатОтвета.version, ""); 
		GTIN = ?(РезультатОтвета.Свойство("gtin"), РезультатОтвета.gtin, "");
		CIS = СокрЛП(?(РезультатОтвета.Свойство("cis"), РезультатОтвета.cis, ""));   
		CIS = СтрЗаменить(CIS, ОбщегоНазначенияБПОКлиентСервер.РазделительGS1(), "");
		
		ПараметрыСтроки = ПараметрыСтрокиЧека();  
		ПараметрыСтроки.КонтрольнаяМарка = ПараметрыОперации.КодМаркировки; 
		ПараметрыСтроки.Вставить("ИдентификаторЗапросаРазрешения", ИдентификаторЗапросаРазрешения);
		ПараметрыСтроки.Вставить("ВремяЗапросаРазрешения"  , ВремяЗапросаРазрешения); 
		ПараметрыСтроки.Вставить("ИдентификаторЭкземпляра" , ИдентификаторЭкземпляра); 
		ПараметрыСтроки.Вставить("ВерсияБазы"              , ВерсияБазы); 
		ПараметрыСтроки.Вставить("GTIN", GTIN); 
		ПараметрыСтроки.Вставить("CIS", CIS);   
		ПараметрыСтроки.Вставить("РезультатПроверки", РезультатВыполнения.РезультатПроверки);
		ПараметрыСтроки.Вставить("ЗапросПроверки", РезультатВыполнения.ЗапросПроверки);
		
		РезультатПараметры = РезультатВыполнения.РезультатПараметры; 
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(РезультатПроверки + Символы.ПС));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Принятие решения ПМСР'") + Символы.ПС , КрупныйШрифтТекста(), ));
		Если РезультатПараметры.РезультатПроверки Тогда
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Товар доступен к продаже'"), КрупныйШрифтТекста(), ЦветСтиляАкцента()));
		Иначе
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'ЗАПРЕТ ПРОДАЖИ'") 
				+ "(" + РезультатПараметры.ОписаниеРезультата + ")", КрупныйШрифтТекста(), ЦветСтиляОтрицательногоЧисла()));
		КонецЕсли;
		ФормСтрока = Новый ФорматированнаяСтрока(МассивСтрок);      
			
		Кнопки = Новый СписокЗначений();    
		Если РезультатПараметры.РезультатПроверки Тогда
			Кнопки.Добавить("ДобавитьТовар", НСтр("ru = 'Добавить товар в чек'"));
		КонецЕсли;
		Кнопки.Добавить("ЗапретПродажи",  НСтр("ru = 'Отмена'"));
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ДобавитьТоварВЧекПродолжить", ЭтотОбъект, ПараметрыСтроки),
			ФормСтрока,
			Кнопки,,, НСтр("ru = 'Добавить товар в чек?'"));
	Иначе
		ПоказатьПредупреждение(Неопределено, РезультатВыполнения.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТоварВЧекПродолжить(Ответ, ПараметрыОперации) Экспорт
	
	Результат = Ответ = "ДобавитьТовар";
	
	ПараметрыОперации.Вставить("ПродажаРазрешена", Результат); 
	ЗаписьВЖурналОперацийПроверкиКМ(ПараметрыОперации);
	
	Если Результат Тогда
		ДобавитьТоварВЧек(ПараметрыОперации);   
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПроверкаКМЗавершение(РезультатВыполнения, ПараметрыОперации) Экспорт
	
	ОчиститьСообщения();
	Элементы.Главная.Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда
		
		ПараметрыОперации = ПолучитьШаблонЧека(ККТ);
		
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЧекФискализацияЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(ОповещениеПриЗавершении, УникальныйИдентификатор, ККТ, ПараметрыОперации, ДополнительныеПараметры);
	
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыСтрокиЧека()  
	
	Результат = Новый Структура();
	Результат.Вставить("Наименование", "Наименование товара");
	Результат.Вставить("GTIN");
	Результат.Вставить("CIS");
	Результат.Вставить("КонтрольнаяМарка");
	Результат.Вставить("Цена", 0);
	Результат.Вставить("Количество", 1);   
	Результат.Вставить("ИдентификаторЗапросаРазрешения");
	Результат.Вставить("ВремяЗапросаРазрешения");              
	Результат.Вставить("ИдентификаторЭкземпляра"); 
	Результат.Вставить("ВерсияБазы"); 
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьТоварВЧек(ПараметрыСтроки)
	
	Наименование = ПараметрыСтроки.Наименование; 
	Цена = 99;
	
	ШтриховойКод = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(ПараметрыСтроки.КонтрольнаяМарка, Истина);
	
	Если ШтриховойКод.Разобран Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("GTIN", ШтриховойКод.GTIN);
		Результат = ТестовыеДанные.НайтиСтроки(Отбор);
		Если Результат.Количество() > 0 Тогда
			Наименование = Результат[0].Наименование;       
			Цена = Результат[0].Цена;           
			Если ШтриховойКод.ЕстьМРЦ Тогда
				Цена = ШтриховойКод.МРЦ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Строка = Товары.Добавить();
	Строка.Наименование =Наименование;  
	Строка.GTIN = ПараметрыСтроки.GTIN;
	Строка.CIS = ПараметрыСтроки.CIS;
	Строка.НДС = 20;
	Строка.Цена = Цена;
	Строка.Количество = ПараметрыСтроки.Количество;   
	Строка.КонтрольнаяМарка = ПараметрыСтроки.КонтрольнаяМарка;
	Строка.Сумма = Строка.Количество * Строка.Цена;    
	Строка.ИдентификаторЗапросаРазрешения = ПараметрыСтроки.ИдентификаторЗапросаРазрешения;
	Строка.ВремяЗапросаРазрешения = ПараметрыСтроки.ВремяЗапросаРазрешения;      
	Строка.ИдентификаторЭкземпляра = ПараметрыСтроки.ИдентификаторЭкземпляра; 
	Строка.ВерсияБазы = ПараметрыСтроки.ВерсияБазы; 
	
КонецПроцедуры    

&НаКлиенте
Процедура НачатьДобавлениеКМ(КонтрольнаяМарка)   
	
	Если Не ЗначениеЗаполнено(ККТ) Тогда      
		ПоказатьПредупреждение(Неопределено, НСтр("ru='ККТ не выбран.'"));
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("КонтрольнаяМарка", КонтрольнаяМарка);
	Результат = Товары.НайтиСтроки(Отбор);
	Если Результат.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Данная позиция уже добавлена в чек.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если НЕ (СТ_ГотовКПроверкеКМOnline Или СТ_ГотовКПроверкеКМOffline) Тогда    
		ТекстСообщения = НСтр("ru='""ТС ПИоТ"" не находиться в статусе готовности к проверке КМ.'") 
			+ Символы.ПС + НСтр("ru='Обновите статус ТС ПИоТ.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если СТ_АварийныйРежим  Тогда    
		ТекстСообщения = НСтр("ru='Введен аварийный режим. Проверка КМ не выполняется.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Элементы.Главная.Доступность = Ложь;
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПроверкиКМПИоТ();     
	ПараметрыОперации.КодМаркировки = КонтрольнаяМарка;  
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("НачатьДобавлениеКМЗавершение", ЭтотОбъект, ПараметрыОперации);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПроверкаКМПИоТ(ОповещениеПриЗавершении, УникальныйИдентификатор, ККТ, ПараметрыОперации, ДополнительныеПараметры);
	
КонецПроцедуры  

&НаКлиенте
Процедура НачатьПроверитьКМ()
	
	ККТ_ПланируемыйСтатусТовара = ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	
	// Создание структуры параметров
	ПараметрыПакетнойОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПроверкиКМ();
	ПараметрыПакетнойОперации.ОтображатьФорму = Ложь;
	Для Каждого Товар Из Товары Цикл
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
		ПараметрыОперации.ЗапросПроверкиКМСредствамиККТ = Истина;      
		ПараметрыОперации.ИдентификаторЗапросаРазрешения = Товар.ИдентификаторЗапросаРазрешения;
		ПараметрыОперации.ВремяЗапросаРазрешения = Товар.ВремяЗапросаРазрешения;
		ПараметрыОперации.Наименование = Товар.Наименование;
		ПараметрыОперации.ИгнорироватьРезультатПроверкиКМ = Истина;
		ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ = Ложь;   
		ПараметрыОперации.ЗапросРазрешенияПродажиКМ = Истина;
		ПараметрыОперации.Количество = Товар.Количество;  
		ПараметрыОперации.ПланируемыйСтатусТовара = ККТ_ПланируемыйСтатусТовара;
		ПараметрыОперации.КонтрольнаяМарка = Товар.КонтрольнаяМарка;
		ПараметрыПакетнойОперации.ЗапросыКМ.Добавить(ПараметрыОперации);
	КонецЦикла;
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("НачатьПроверкаКМЗавершение", ЭтотОбъект);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПроверкуКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ККТ, ПараметрыПакетнойОперации, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция РасшифроватьОтветПИоТ(Текст) 
	
	Результат = Новый Структура();      
	
	Если СтрНачинаетсяС(Текст, "{") Или СтрНачинаетсяС(Текст, "[") Тогда
		
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);    
		Для Каждого КлючЗначение Из Данные Цикл    
			Если КлючЗначение.Ключ = "codesResponse" Тогда  
				Для Каждого ОтветЗначение Из КлючЗначение.Значение Цикл  
					Если ОтветЗначение.Ключ = "codesResponse" Тогда    
						Для Каждого ЭлементОтвета Из ОтветЗначение.Значение[0] Цикл 
							Значение = ЭлементОтвета.Значение;
							Если ТипЗнч(Значение) = Тип("Число") Тогда
								Значение = Формат(Значение,"ЧГ=0"); 
							КонецЕсли;
							Результат.Вставить(ЭлементОтвета.Ключ, Значение);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если Результат.Свойство("codes") Тогда
			Для Каждого ЭлементОтвета Из Результат.codes[0] Цикл  
				Значение = ЭлементОтвета.Значение;
				Если ТипЗнч(Значение) = Тип("Число") Тогда
					Значение = Формат(Значение,"ЧГ=0"); 
				КонецЕсли;
				Результат.Вставить(ЭлементОтвета.Ключ, Значение);
			КонецЦикла;
		КонецЕсли;        
		
		Если Результат.Свойство("results") Тогда
			Для Каждого ЭлементОтвета Из Результат.results[0] Цикл  
				Значение = ЭлементОтвета.Значение;
				Если ТипЗнч(Значение) = Тип("Число") Тогда
					Значение = Формат(Значение,"ЧГ=0"); 
				КонецЕсли;
				Результат.Вставить(ЭлементОтвета.Ключ, Значение);
				
				Если ЭлементОтвета.Ключ = "codes" Тогда
					Для Каждого ЭлементОтвета Из Значение[0] Цикл  
						ЗначениеЛок = ЭлементОтвета.Значение;
						Если ТипЗнч(ЗначениеЛок) = Тип("Число") Тогда
						Значение = Формат(ЗначениеЛок,"ЧГ=0"); 
						КонецЕсли;
					Результат.Вставить(ЭлементОтвета.Ключ, ЗначениеЛок);
					КонецЦикла;    
				КонецЕсли;
				
			КонецЦикла;    
			
		КонецЕсли;

	КонецЕсли;
	
	Возврат Результат;  
	
КонецФункции

&НаКлиенте
Процедура ТестовыеДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = ТестовыеДанные.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекущиеДанные <> Неопределено Тогда
		СообщениеТекст = ТекущиеДанные.Название + Символы.ПС +   
						ТекущиеДанные.Наименование  + Символы.ПС + 
						НСтр("ru = 'Цена: '") + ТекущиеДанные.Цена + Символы.ПС + 
						ТекущиеДанные.КодМаркировки;
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("Продолжить", НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить("Отмена",  НСтр("ru = 'Отмена'"));
		ПоказатьВопрос(Новый ОписаниеОповещения("ТестовыеДанныеВыборПродолжить", ЭтотОбъект, ТекущиеДанные),
			СообщениеТекст,
			Кнопки,,, НСтр("ru = 'Добавить позиции по сценарию'"))
	КонецЕсли

КонецПроцедуры       

&НаКлиенте
Процедура ТестовыеДанныеВыборПродолжить(Ответ, ПараметрыОперации) Экспорт
	
	Если Ответ <> "Продолжить" Тогда
		Возврат; 
	КонецЕсли;                          
	
	НачатьДобавлениеКМ(ПараметрыОперации.КодМаркировки);   
	
КонецПроцедуры

