Перем ПроизводственныйКалендарь Экспорт;  
Перем ДокументНастроек Экспорт;

Процедура СоздатьНакладные() Экспорт 
	Если НЕ ЗначениеЗаполнено(ПроизводственныйКалендарь) Тогда 
		ОбщегоНазначения.СообщитьПользователю("Не найден основной производственный календарь!");
		Возврат;
	КонецЕсли;

	ДатаСоздания = ЭтотОбъект.Дата;  
	ТекущийДеньНедели = ДеньНедели(ДатаСоздания);
	
	//Проверим нужно ли создавать накладные
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаСоздания); 
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.ДеньНедели КАК ДеньНедели,
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.ПорядокВыбораДня КАК ПорядокВыбораДня,
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.ЕстьОграничениеОценки КАК ЕстьОграничениеОценки,
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних.Регистратор КАК ДокументНастроек
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.СрезПоследних(&Дата, Организация = &Организация) КАК ЛБ_НастройкиСозданияНакладныхНаОтгрузкуСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();  
	ДеньНедели = 0;
	Если Выборка.Следующий() тогда
		ДеньНедели = Выборка.ДеньНедели; 
		ПорядокВыбораДня = Выборка.ПорядокВыбораДня;
		ЕстьОграничениеОценки = Выборка.ЕстьОграничениеОценки;
		СуммаОценки = Выборка.СуммаОценки;  
		ДокументНастроек = Выборка.ДокументНастроек;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Не найдены настройки создания накладных на отгрузку на " + Формат(ДатаСоздания, "ДФ=dd.MM.yyyy"));  
		Возврат;
	КонецЕсли;	
	
	Если ДеньНедели = ТекущийДеньНедели  Тогда           				
		ОтборК = Новый Структура;  
		ОтборК.Вставить("Год",                       Год(ДатаСоздания));
		ОтборК.Вставить("Дата",                      ДатаСоздания);
		ОтборК.Вставить("ПроизводственныйКалендарь", ПроизводственныйКалендарь);

		СведенияНаДень=РегистрыСведений.ДанныеПроизводственногоКалендаря.Получить(ОтборК);
		Если НЕ СведенияНаДень.ВидДня=Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий И НЕ СведенияНаДень.ВидДня=Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда 
			ДатаПереноса = ПеренестиДатуСозданияНаРабочийДень(ДатаСоздания);
			ОбщегоНазначения.СообщитьПользователю("Дата создания накладных на огрузку перенесена на " + Формат(ДатаПереноса, "ДФ=dd.MM.yyyy"));
		Иначе	
			КолНакладных = ВыполнитьСозданиеНакладныхНаОтгузку(ДатаСоздания, ДатаСоздания, ПорядокВыбораДня, ?(ЕстьОграничениеОценки, СуммаОценки, 0));
			ОбщегоНазначения.СообщитьПользователю("Создано накладных на отгрузку " + Строка(КолНакладных));
		КонецЕсли; 
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ПереносСозданияНакладныхНаОгрузкуСрезПоследних.ДатаПереноса КАК ДатаПереноса,
		               |	ЛБ_ПереносСозданияНакладныхНаОгрузкуСрезПоследних.Период КАК Период
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПереносСозданияНакладныхНаОгрузку.СрезПоследних(&Дата, Организация = &Организация) КАК ЛБ_ПереносСозданияНакладныхНаОгрузкуСрезПоследних";
		ВыборкаД = Запрос.Выполнить().Выбрать();
		Если ВыборкаД.Следующий() Тогда
			Если ВыборкаД.ДатаПереноса = НачалоДня(ДатаСоздания) Тогда 
				КолНакладных = ВыполнитьСозданиеНакладныхНаОтгузку(ДатаСоздания, ВыборкаД.Период, ПорядокВыбораДня, ?(ЕстьОграничениеОценки, СуммаОценки, 0));
				ОбщегоНазначения.СообщитьПользователю("Создано накладных на отгрузку " + Строка(КолНакладных));
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	 
	ОбщегоНазначения.СообщитьПользователю("Обработка завершена.");
КонецПроцедуры	

Функция ПеренестиДатуСозданияНаРабочийДень(Дата)
	ДатаПереноса = КонецДня(Дата)+1;  
	НашлиРабочийДень = Ложь;
	Пока НЕ НашлиРабочийДень Цикл
		ОтборК = Новый Структура;  
		ОтборК.Вставить("Год",                       Год(ДатаПереноса));
		ОтборК.Вставить("Дата",                      ДатаПереноса);
		ОтборК.Вставить("ПроизводственныйКалендарь", ПроизводственныйКалендарь);

		СведенияНаДень=РегистрыСведений.ДанныеПроизводственногоКалендаря.Получить(ОтборК);
		Если НЕ СведенияНаДень.ВидДня=Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий И НЕ СведенияНаДень.ВидДня=Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда 
			ДатаПереноса = КонецДня(Дата)+1;
		Иначе 
			НашлиРабочийДень = Истина;
		КонецЕсли;	
	КонецЦикла; 
	
	МенеджерЗаписи = РегистрыСведений.ЛБ_ПереносСозданияНакладныхНаОгрузку.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.Период = ЭтотОбъект.Дата;
	МенеджерЗаписи.Организация = ЭтотОбъект.Организация;
	МенеджерЗаписи.ДатаПереноса = ДатаПереноса;

	МенеджерЗаписи.Записать();  
	Возврат ДатаПереноса;
КонецФункции	   

Функция ПроверитьЗБНаследство(ЗалоговыйБилет, Дата)
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", ЗалоговыйБилет.Залогодатель);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1)); 
	Запрос.Текст  = "ВЫБРАТЬ ПЕРВЫЕ 1
	                |	ЛБ_КонтактнаяИнформацияЗалогодателей.Период КАК Период
	                |ИЗ
	                |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей КАК ЛБ_КонтактнаяИнформацияЗалогодателей
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	                |		ПО ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель = ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель
	                |ГДЕ
	                |	ЛБ_КонтактнаяИнформацияЗалогодателей.Залогодатель = &Клиент
	                |	И НЕ ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаСмерти = &ПустаяДата
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();   
	Если Выборка.Следующий() Тогда 
	    ДатаПроверкиНаследство = КонецДня(Выборка.Период) + 1;
		ДатаПроверкиНаследство = ДобавитьМесяц(ДатаПроверкиНаследство, 8);
		Если ДатаПроверкиНаследство > НачалоДня(Дата) Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	

	Возврат Ложь;
КонецФункции

