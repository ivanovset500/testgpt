&НаСервере
Функция ПроверитьНетБлокировки(ЗБ, Дата)
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ЗБ", ЗБ);  
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ЗалоговыеБилетыЗаблокированныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_ЗалоговыеБилетыЗаблокированныеСрезПоследних.ДатаБлокировки КАК ДатаБлокировки
	               |ИЗ
	               |	РегистрСведений.ЛБ_ЗалоговыеБилетыЗаблокированные.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗБ) КАК ЛБ_ЗалоговыеБилетыЗаблокированныеСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		Если Выборка.Статус = Перечисления.ЛБ_СтатусыБлокировкиЗБ.Блокировка тогда
			Если Выборка.ДатаБлокировки >= НачалоДня(ЭтотОбъект.Дата) Тогда
				Возврат Ложь;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	Возврат истина;
КонецФункции


Функция ВыполнитьСозданиеНакладныхНаОтгузку(Дата, ДатаНач, ПорядокВыбораДня, СуммаОценкиДляОтбора)
	ПроверятьЛомбард = Ложь;
	Если ЗначениеЗаполнено(ЭтотОбъект.Ломбард) Тогда 
		ПроверятьЛомбард = Истина;
	КонецЕсли;                	
	
	СтатусыЗБ = новый СписокЗначений; 
	СтатусыЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен); 
	СтатусыЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен);
	СтатусыЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Остановлен);
	СтатусыЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен); 
	СтатусыЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят);
	СтатусыЗБ.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство);
	
	ЗапросЗБ = Новый Запрос;  
	ЗапросЗБ.УстановитьПараметр("Дата", Дата); 
	ЗапросЗБ.УстановитьПараметр("СтатусыЗБ", СтатусыЗБ); 
	ЗапросЗБ.УстановитьПараметр("Ломбард", ЭтотОбъект.Ломбард);
	ЗапросЗБ.Текст = "ВЫБРАТЬ
	                 |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                 |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	                 |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	                 |ГДЕ
	                 |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета В(&СтатусыЗБ)
	                 |	И ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок < НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)";  
	Если ПроверятьЛомбард Тогда
		ЗапросЗБ.Текст = ЗапросЗБ.Текст + "
	                 |	И ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет.Ломбард = &Ломбард";
	КонецЕсли;	
	СписокЗБ = новый СписокЗначений;
    ВыборкаЗБ = ЗапросЗБ.Выполнить().Выбрать();
	Пока ВыборкаЗБ.Следующий() Цикл   
		//проверим попадает ли ЗБ в установленный перид выбора дня
		Если ВыборкаЗБ.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Наследство Тогда  
			Если НЕ ПроверитьЗБНаследство(ВыборкаЗБ.ЗалоговыйБилет, Дата) Тогда
				Продолжить;
			КонецЕсли;	
		//+Мельников 04.07.24
		ИначеЕсли ПроверитьКлиентаНаБанкротство(ВыборкаЗБ.ЗалоговыйБилет, Дата) Тогда
			Продолжить;
		//+Мельников 08.07.24
		ИначеЕсли ЛБ_ОбщегоНазначения.ПроверитьПоПеречням(Дата, ВыборкаЗБ.ЗалоговыйБилет) Тогда
			Продолжить;
		//-Мельников    
	    ИначеЕсли НЕ ПроверитьНетБлокировки(ВыборкаЗБ.ЗалоговыйБилет, Дата) Тогда
		    Продолжить;
		Иначе	
			ДатаПроверки = КонецДня(ВыборкаЗБ.ДатаВыкупаЛьготныйСрок) + 1;
			Если ПорядокВыбораДня > 0 Тогда 
				ДатаПроверки = ДатаПроверки + ПорядокВыбораДня*7*24*60*60;
			КонецЕсли;		
			Если НачалоДня(ДатаНач) < ДатаПроверки Тогда
				Продолжить
			КонецЕсли;	
		КонецЕсли;  
        СписокЗБ.Добавить(ВыборкаЗБ.ЗалоговыйБилет);
	КонецЦикла;	
	
	СтатусыОЗ = новый СписокЗначений; 
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Возвращен); 
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Принят);
    СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Продлен);
	СтатусыОЗ.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.Наследство);
	
	ЗапросЗБ.УстановитьПараметр("СписокЗБ", СписокЗБ); 
	ЗапросЗБ.УстановитьПараметр("СтатусыОбъектаЗалога", СтатусыОЗ);
	ЗапросЗБ.Текст = "ВЫБРАТЬ
	                 |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	                 |	ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток КАК Количество,
	                 |	ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток КАК СуммаОценки,
	                 |	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет.ОтказОтВыкупа КАК ОтказОтВыкупа,
	                 |	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	                 |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	                 |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
	                 |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК Вес
	                 |ИЗ
	                 |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет В (&СписокЗБ)) КАК ЛБ_ОбъектыЗалогаОстатки
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних
	                 |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	                 |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	                 |		ПО ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет
	                 |			И ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога = ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога
	                 |ГДЕ
	                 |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога В(&СтатусыОбъектаЗалога)";         
	ТаблицаЗапроса = ЗапросЗБ.Выполнить().Выгрузить();
	ТаблицаФормированияНакладных = ТаблицаЗапроса.СкопироватьКолонки("Ломбард, ЗалоговыйБилет, ОтказОтВыкупа, ОбъектЗалога, Количество, Вес, СуммаОценки");
	ТаблицаФормированияНакладных.Колонки.Добавить("ПовышеннаяОценка");
	
	Для каждого Стр из ТаблицаЗапроса Цикл 		
		НоваяСтр = ТаблицаФормированияНакладных.Добавить(); 
		НоваяСтр.Ломбард = Стр.Ломбард;  
		НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
		НоваяСтр.ОтказОтВыкупа = Стр.ОтказОтВыкупа;
		НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
		НоваяСтр.Количество = Стр.Количество;  
		НоваяСтр.Вес = Стр.Вес;
		НоваяСтр.СуммаОценки = Стр.СуммаОценки;
		НоваяСтр.ПовышеннаяОценка = Ложь;
		Если Стр.СуммаОценки > СуммаОценкиДляОтбора тогда  
			НоваяСтр.ПовышеннаяОценка = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	ТаблицаЛомбардов = ТаблицаФормированияНакладных.Скопировать();
	ТаблицаЛомбардов.Свернуть("Ломбард");
	
	Отбор1 = Новый Структура; 
    Отбор2 = Новый Структура;  
	
	КолНакладных = 0;   
	Для каждого СтрЛ Из ТаблицаЛомбардов Цикл 
		Отбор1.Вставить("Ломбард", СтрЛ.Ломбард);
		Отбор1.Вставить("ОтказОтВыкупа", Истина);
		Отбор1.Вставить("ПовышеннаяОценка", Ложь);
		
		Сдвиг = 0;
		Строки1 = ТаблицаФормированияНакладных.НайтиСтроки(Отбор1); 
		Если НЕ Строки1.Количество() = 0  Тогда
			СформироватьНакладную(Дата, СтрЛ.Ломбард, Строки1, Истина, Ложь);
			КолНакладных = КолНакладных + 1; 
			Сдвиг = Сдвиг + 1;
		КонецЕсли;  
		
		Отбор1.Вставить("ПовышеннаяОценка", Истина);
		
		Строки1 = ТаблицаФормированияНакладных.НайтиСтроки(Отбор1); 
		Если НЕ Строки1.Количество() = 0  Тогда
			СформироватьНакладную(Дата, СтрЛ.Ломбард, Строки1, Истина, Истина, Сдвиг);
			КолНакладных = КолНакладных + 1; 
			Сдвиг = Сдвиг + 1;
		КонецЕсли;
		
		Отбор2.Вставить("Ломбард", СтрЛ.Ломбард);
		Отбор2.Вставить("ОтказОтВыкупа", Ложь); 
		Отбор2.Вставить("ПовышеннаяОценка", Ложь);
		
		Строки2 = ТаблицаФормированияНакладных.НайтиСтроки(Отбор2); 
		Если НЕ Строки2.Количество() = 0  Тогда
			СформироватьНакладную(Дата, СтрЛ.Ломбард, Строки2, Ложь, Ложь, Сдвиг); 
			КолНакладных = КолНакладных + 1;  
			Сдвиг = Сдвиг + 1;
		КонецЕсли;
		
		Отбор2.Вставить("ПовышеннаяОценка", Истина);
		
		Строки2 = ТаблицаФормированияНакладных.НайтиСтроки(Отбор2); 
		Если НЕ Строки2.Количество() = 0  Тогда  
			СформироватьНакладную(Дата, СтрЛ.Ломбард, Строки2, Ложь, Истина, Сдвиг);    
			КолНакладных = КолНакладных + 1;
		КонецЕсли;
	КонецЦикла;	                            
	Возврат КолНакладных;
КонецФункции

Процедура СформироватьНакладную(Дата, Ломбард, СтрокиТаблицы, ОтказОтВыкупа, ПовышеннаяОценка, Сдвиг = 0) 
	НовыйДок = Документы.ЛБ_НакладнаяНаОтгрузку.СоздатьДокумент();
	НовыйДок.Дата = Дата + Сдвиг; 
	НовыйДок.Организация = ЭтотОбъект.Организация;
	НовыйДок.Ломбард = Ломбард;  
	НовыйДок.ВидОперации = Перечисления.ЛБ_ВидыНакладнойНаОтгрузку.Автоматически;
	НовыйДок.ОтказОтВыкупа = ОтказОтВыкупа;
	НовыйДок.ПовышеннаяОценка = ПовышеннаяОценка;  
	НовыйДок.ДокументНастроек = ДокументНастроек;
	
	Для каждого Стр Из СтрокиТаблицы Цикл 
		НоваяСтр = НовыйДок.Залоги.Добавить();
		НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
		НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
		НоваяСтр.Количество = Стр.Количество;
		НоваяСтр.Вес = Стр.Вес;
		НоваяСтр.СуммаОценки = Стр.СуммаОценки;
	КонецЦикла;		
	
	НовыйДок.НомерНакладной = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерНакладнойНаОтгрузку(НовыйДок.Дата, НовыйДок.Организация, НовыйДок.Ломбард);   
	НовыйДок.ПредставлениеНомераНакладной = СокрЛП(НовыйДок.Ломбард.НомерЛомбарда) + "/" +  СокрЛП(НовыйДок.НомерНакладной) + ?(НовыйДок.ПовышеннаяОценка, "/Т", "");
	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);  
	Попытка   
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;	
КонецПроцедуры	

ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
ДокументНастроек = Документы.ЛБ_УстановкаНастроекСозданияНакладныхНаОтгрузку.ПустаяСсылка();