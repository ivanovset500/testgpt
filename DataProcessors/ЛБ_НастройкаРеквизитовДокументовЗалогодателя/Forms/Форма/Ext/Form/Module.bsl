	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);
    Строки = Объект.ТаблицаРеквизиты.НайтиСтроки(Отбор);
	
	Для каждого Стр Из Строки Цикл
		Объект.ТаблицаРеквизиты.Удалить(Стр);
	КонецЦикла;	
	
	// ++ Сербаев 05.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
    //ОчиститьРегистрНаСервере(СтрокаТабличнойЧасти.ВидДокумента, СтрокаТабличнойЧасти.ВидДокументаЗалогодателя);
	ОчиститьРегистрНаСервере(СтрокаТабличнойЧасти.ВидДокумента, СтрокаТабличнойЧасти.ВидДокументаЗалогодателя, СтрокаТабличнойЧасти.ВидГражданства);
