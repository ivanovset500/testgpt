&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуДокументов();
	ЗаполнитьСписокВыбораДокументов();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораДокументов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокумента КАК ВидДокумента,
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя
        // ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
		|	,
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидГражданства КАК ВидГражданства
        // -- Сербаев 02.06.2023
		|ИЗ
		|	РегистрСведений.ЛБ_ПереченьДокументовЗалогодателя КАК ЛБ_ПереченьДокументовЗалогодателя";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	УдСтроки = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаЗапроса Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ВидДокумента",             Стр.ВидДокумента);
		Отбор.Вставить("ВидДокументаЗалогодателя", Стр.ВидДокументаЗалогодателя);
		// ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
		Отбор.Вставить("ВидГражданства",           Стр.ВидГражданства);
        // -- Сербаев 02.06.2023
		
		Строки = Объект.ТаблицаДокументов.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			УдСтроки.Добавить(Стр);
		КонецЕсли;	
	КонецЦикла; 
	Для каждого Эл Из УдСтроки Цикл
		ТаблицаЗапроса.Удалить(Эл.Значение);
	КонецЦикла;	
	СписокВ = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаЗапроса Цикл
		Если СписокВ.НайтиПоЗначению(Стр.ВидДокумента) = Неопределено Тогда
			СписокВ.Добавить(Стр.ВидДокумента);
		КонецЕсли;	
	КонецЦикла;	
	
	Элементы.ТаблицаДокументовВидДокумента.СписокВыбора.Очистить();
	Для каждого Эл Из СписокВ Цикл
		Элементы.ТаблицаДокументовВидДокумента.СписокВыбора.Добавить(Эл.Значение);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВыбораДокументовЗалогодателя(ВидДокумента)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокумента КАК ВидДокумента,
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя
		// ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
		|	,
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидГражданства КАК ВидГражданства
		// -- Сербаев 02.06.2023
		|ИЗ
		|	РегистрСведений.ЛБ_ПереченьДокументовЗалогодателя КАК ЛБ_ПереченьДокументовЗалогодателя
		|ГДЕ
		|	ЛБ_ПереченьДокументовЗалогодателя.ВидДокумента = &ВидДокумента";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	УдСтроки = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаЗапроса Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ВидДокумента", Стр.ВидДокумента);
		Отбор.Вставить("ВидДокументаЗалогодателя", Стр.ВидДокументаЗалогодателя);
		// ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
		Отбор.Вставить("ВидГражданства", Стр.ВидГражданства);
        // -- Сербаев 02.06.2023
		
		Строки = Объект.ТаблицаДокументов.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			УдСтроки.Добавить(Стр);
		КонецЕсли;	
	КонецЦикла; 
	Для каждого Эл Из УдСтроки Цикл
		ТаблицаЗапроса.Удалить(Эл.Значение);
	КонецЦикла;	
	// ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
	//СписокВ = Новый СписокЗначений;
	//Для каждого Стр Из ТаблицаЗапроса Цикл
	//	Если СписокВ.НайтиПоЗначению(Стр.ВидДокументаЗалогодателя) = Неопределено Тогда
	//		СписокВ.Добавить(Стр.ВидДокументаЗалогодателя);
	//	КонецЕсли;	
	//КонецЦикла;
	МассивВ = Новый Массив;
	Для каждого Стр Из ТаблицаЗапроса Цикл
		СтруктураВ = Новый Структура("ВидДокументаЗалогодателя, ВидГражданства", Стр.ВидДокументаЗалогодателя, Стр.ВидГражданства);
		МассивВ.Добавить(СтруктураВ);
	КонецЦикла;
	Возврат МассивВ;
	// -- Сербаев 02.06.2023
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицу(КлючСтроки)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_РеквизитыДокументовЗалогодателя.Ссылка КАК Реквизит
		|ИЗ
		|	Справочник.ЛБ_РеквизитыДокументовЗалогодателя КАК ЛБ_РеквизитыДокументовЗалогодателя
		|ГДЕ
		|	ЛБ_РеквизитыДокументовЗалогодателя.Предопределенный = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_РеквизитыДокументовЗалогодателя.Порядок";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	    НоваяСтр = Объект.ТаблицаРеквизиты.Добавить();
		НоваяСтр.Реквизит = Выборка.Реквизит;
		НоваяСтр.КлючСтроки = КлючСтроки;
	Конеццикла;   
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуДокументов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокумента КАК ВидДокумента,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Реквизит КАК Реквизит,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Обязателен КАК Обязателен,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.Видимость КАК Видимость,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.КоличествоСимволов КАК КоличествоСимволов,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ТолькоЦифры КАК ТолькоЦифры
		// ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
		|	,
		|	ЛБ_НастройкаРеквизитовДокументовЗалогодателя.ВидГражданства КАК ВидГражданства
        // -- Сербаев 02.06.2023
		|ИЗ
		|	РегистрСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя КАК ЛБ_НастройкаРеквизитовДокументовЗалогодателя";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаВидов = ТаблицаЗапроса.Скопировать();
    // ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
	//ТаблицаВидов.Свернуть("ВидДокумента, ВидДокументаЗалогодателя");
	ТаблицаВидов.Свернуть("ВидДокумента, ВидДокументаЗалогодателя, ВидГражданства");
	// -- Сербаев 02.06.2023
	Объект.ТаблицаДокументов.Загрузить(ТаблицаВидов);
	Ном = 0;
	Для каждого СтрДок Из Объект.ТаблицаДокументов Цикл
		Ном = Ном + 1;
		СтрДок.КлючСтроки = Ном;
		
		ЗаполнитьТаблицу(СтрДок.КлючСтроки); 
		
		ОтборДок = Новый Структура;
		ОтборДок.Вставить("ВидДокумента",             СтрДок.ВидДокумента);
		ОтборДок.Вставить("ВидДокументаЗалогодателя", СтрДок.ВидДокументаЗалогодателя);
        // ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
		ОтборДок.Вставить("ВидГражданства",           СтрДок.ВидГражданства);
        // -- Сербаев 02.06.2023
		Строки = ТаблицаЗапроса.НайтиСтроки(ОтборДок);
		Для каждого Стр Из Строки Цикл
			Отбор = Новый структура;
			Отбор.Вставить("Реквизит", Стр.Реквизит);
			Отбор.Вставить("КлючСтроки", СтрДок.КлючСтроки);
			
			Строки = Объект.ТаблицаРеквизиты.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 Тогда
				СтрТаб = Строки.Получить(0);
				СтрТаб.Обязателен         = Стр.Обязателен;
				СтрТаб.Видимость          = Стр.Видимость;
				СтрТаб.КоличествоСимволов = Стр.КоличествоСимволов;
				СтрТаб.ТолькоЦифры        = Стр.ТолькоЦифры;
			КонецЕсли;	
		Конеццикла;	
    КонецЦикла
КонецПроцедуры	

&НаСервере
// ++ Сербаев 05.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
//Процедура СохранитьНаСервере(Идентификатор, ВидДокумента, ВидДокументаЗалогодателя)
Процедура СохранитьНаСервере(Идентификатор, ВидДокумента, ВидДокументаЗалогодателя, ВидГражданства)
// -- Сербаев 05.06.2023
	Стр = Объект.ТаблицаРеквизиты.НайтиПоИдентификатору(Идентификатор);
	НаборЗаписей = РегистрыСведений.ЛБ_НастройкаРеквизитовДокументовЗалогодателя.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.ВидДокумента.Установить(ВидДокумента); 
	НаборЗаписей.Отбор.ВидДокументаЗалогодателя.Установить(ВидДокументаЗалогодателя);
	// ++ Сербаев 05.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
	НаборЗаписей.Отбор.ВидГражданства.Установить(ВидГражданства);
    // -- Сербаев 05.06.2023
	НаборЗаписей.Отбор.Реквизит.Установить(Стр.Реквизит);
	Запись = НаборЗаписей.Добавить();
	Запись.ВидДокумента             = ВидДокумента;
	Запись.ВидДокументаЗалогодателя = ВидДокументаЗалогодателя;
	// ++ Сербаев 05.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
	Запись.ВидГражданства           = ВидГражданства;
    // -- Сербаев 05.06.2023
	Запись.Реквизит           = Стр.Реквизит;
	Запись.Обязателен         = Стр.Обязателен;
	Запись.Видимость          = Стр.Видимость;
	Запись.КоличествоСимволов = Стр.КоличествоСимволов;
	Запись.ТолькоЦифры        = Стр.ТолькоЦифры;
	
	НаборЗаписей.Записать(Истина);
КонецПроцедуры	

