&НаКлиенте
Процедура ТаблицаДокументовПриАктивизацииСтроки(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТаблицаДокументов.ТекущиеДанные;	
		
	Если СтрокаТабличнойЧасти <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);
		Элементы.ТаблицаРеквизиты.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
		
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", 0);
		Элементы.ТаблицаРеквизиты.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВидДокументаПриИзменении(Элемент)
	
	// ++ Сербаев 02.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
	//СтрокаТабличнойЧасти = Элементы.ТаблицаДокументов.ТекущиеДанные;
	//СписокВыбора = ПолучитьСписокВыбораДокументовЗалогодателя(СтрокаТабличнойЧасти.ВидДокумента);
	//Если СписокВыбора.Количество() > 1 Тогда
	//	ВыбЗначение = ЭтаФорма.ВыбратьИзСписка(СписокВыбора, );
	//	Если НЕ ВыбЗначение = неопределено Тогда
	//		СтрокаТабличнойЧасти.ВидДокументаЗалогодателя = ВыбЗначение.Значение;
	//	КонецЕсли;	
	//Иначе
	//	СтрокаТабличнойЧасти.ВидДокументаЗалогодателя = СписокВыбора.Получить(0).Значение;
	//КонецЕсли;	
	//СохранитьНаСервереПоКлючу(СтрокаТабличнойЧасти.КлючСтроки, СтрокаТабличнойЧасти.ВидДокумента, СтрокаТабличнойЧасти.ВидДокументаЗалогодателя);
	
	СтрокаТабличнойЧасти = Элементы.ТаблицаДокументов.ТекущиеДанные;
	СписокВыбора = ПолучитьСписокВыбораДокументовЗалогодателя(СтрокаТабличнойЧасти.ВидДокумента);
	Если СписокВыбора.Количество() > 1 Тогда
		
		НовСписок = Новый СписокЗначений;
		Для каждого Стр Из СписокВыбора Цикл
			Если НовСписок.НайтиПоЗначению(Стр.ВидДокументаЗалогодателя) = Неопределено Тогда
				НовСписок.Добавить(Стр.ВидДокументаЗалогодателя);
			КонецЕсли;
		КонецЦикла;
		
		Если НовСписок.Количество() > 1 Тогда
			
			ВыбЗначение = ЭтаФорма.ВыбратьИзСписка(НовСписок);
			Если НЕ ВыбЗначение = Неопределено Тогда
				СтрокаТабличнойЧасти.ВидДокументаЗалогодателя = ВыбЗначение.Значение;
				
				СписокВыбораВидаГражданства = Новый СписокЗначений;
				Для каждого Стр1 Из СписокВыбора Цикл
					Если ВыбЗначение.Значение = Стр1.ВидДокументаЗалогодателя Тогда
						СписокВыбораВидаГражданства.Добавить(Стр1.ВидГражданства);
					КонецЕсли;
				КонецЦикла;
				
				Если СписокВыбораВидаГражданства.Количество() > 1 Тогда
					
					ВидГражданстваЗначение = ЭтаФорма.ВыбратьИзСписка(СписокВыбораВидаГражданства);
					Если НЕ ВидГражданстваЗначение = Неопределено Тогда
						СтрокаТабличнойЧасти.ВидГражданства = ВидГражданстваЗначение.Значение;
					КонецЕсли; 
					
				ИначеЕсли СписокВыбораВидаГражданства.Количество() = 1 Тогда	
					СтрокаТабличнойЧасти.ВидГражданства = СписокВыбораВидаГражданства.Получить(0).Значение;
				КонецЕсли;
				
			КонецЕсли; 
			
		ИначеЕсли НовСписок.Количество() = 1 Тогда
			СтрокаТабличнойЧасти.ВидДокументаЗалогодателя = НовСписок.Получить(0).Значение; 
			
			СписокВыбораВидаГражданства = Новый СписокЗначений;
			Для каждого Стр2 Из СписокВыбора Цикл
				Если СтрокаТабличнойЧасти.ВидДокументаЗалогодателя = Стр2.ВидДокументаЗалогодателя Тогда
					СписокВыбораВидаГражданства.Добавить(Стр2.ВидГражданства);
				КонецЕсли; 
			КонецЦикла; 
			
			Если СписокВыбораВидаГражданства.Количество() > 1 Тогда
				
				ВидГражданстваЗначение = ЭтаФорма.ВыбратьИзСписка(СписокВыбораВидаГражданства);
				Если НЕ ВидГражданстваЗначение = Неопределено Тогда
					СтрокаТабличнойЧасти.ВидГражданства = ВидГражданстваЗначение.Значение;
				КонецЕсли; 
				
			ИначеЕсли СписокВыбораВидаГражданства.Количество() = 1 Тогда	
				СтрокаТабличнойЧасти.ВидГражданства = СписокВыбораВидаГражданства.Получить(0).Значение;
			КонецЕсли;
			
		КонецЕсли; 
		
	ИначеЕсли СписокВыбора.Количество() = 1 Тогда
		СтрокаТабличнойЧасти.ВидДокументаЗалогодателя = СписокВыбора[0].ВидДокументаЗалогодателя;
		СтрокаТабличнойЧасти.ВидГражданства           = СписокВыбора[0].ВидГражданства;
	Иначе
		Сообщить("Доработать ошибку!");
	КонецЕсли;	
	СохранитьНаСервереПоКлючу(СтрокаТабличнойЧасти.КлючСтроки, СтрокаТабличнойЧасти.ВидДокумента, 
	СтрокаТабличнойЧасти.ВидДокументаЗалогодателя, СтрокаТабличнойЧасти.ВидГражданства);
	// -- Сербаев 02.06.2023
КонецПроцедуры

&НаСервере
Функция ПолучитьКлючСтроки() Экспорт
	
	ТаблицаКлючей = Объект.ТаблицаДокументов.Выгрузить(, "КлючСтроки");
	Если  ТаблицаКлючей.Количество() = 1 Тогда
		Возврат 1;
	Иначе	
		ТаблицаКлючей.Сортировать("КлючСтроки Убыв");
		
		Возврат ТаблицаКлючей[0].КлючСтроки + 1;
	КонецЕсли;		
КонецФункции

&НаКлиенте
Процедура ТаблицаДокументовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	СтрокаТабличнойЧасти = Элементы.ТаблицаДокументов.ТекущиеДанные;
	СтрокаТабличнойЧастиРеквизиты = Элементы.ТаблицаРеквизиты.ТекущиеДанные;
	Если НоваяСтрока Тогда
		СтрокаТабличнойЧасти.КлючСтроки = ПолучитьКлючСтроки();
		ЗаполнитьТаблицу(СтрокаТабличнойЧасти.КлючСтроки);
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);
		Элементы.ТаблицаРеквизиты.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);	
	КонецЕсли;	
КонецПроцедуры

