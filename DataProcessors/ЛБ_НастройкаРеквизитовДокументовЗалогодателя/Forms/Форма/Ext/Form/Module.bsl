&НаКлиенте
Процедура ТаблицаРеквизитыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	СтрокаТабличнойЧасти = Элементы.ТаблицаРеквизиты.ТекущиеДанные;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧасти.КлючСтроки);
	СтрокиДок = Объект.ТаблицаДокументов.НайтиСтроки(Отбор);
	Если НЕ СтрокиДок.Количество() = 0 Тогда
		СтрДок = СтрокиДок.Получить(0);
		СтрРеквизиты = Объект.ТаблицаРеквизиты.НайтиПоИдентификатору(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		// ++ Сербаев 05.06.2023 (Добавление "Вида гражданства" в натройку реквизитов документов клиента)
        //СохранитьНаСервере(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрДок.ВидДокумента, СтрДок.ВидДокументаЗалогодателя);
	    СохранитьНаСервере(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрДок.ВидДокумента, СтрДок.ВидДокументаЗалогодателя, СтрДок.ВидГражданства);
		// -- Сербаев 05.06.2023
	КонецЕсли;	
КонецПроцедуры

&НаСервере
