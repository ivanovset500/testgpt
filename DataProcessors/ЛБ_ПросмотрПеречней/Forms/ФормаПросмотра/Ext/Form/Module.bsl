
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Свойство("ИД") Тогда
		Отказ = Истина;
	КонецЕсли;
	ИД = Параметры.ИД; 
	ВидПеречня = Параметры.ВидПеречня; 
	ДатаПеречня = Параметры.ДатаПеречня; 
	ФИО = Параметры.Наименование;   
	МестоРождения = Параметры.МестоРождения; 
	ДатаРождения = Параметры.ДатаРождения;  
	ГодРождения = Параметры.ГодРождения;
	ДатаРожденияСтрока = ?(НЕ ДатаРождения = Дата(1,1,1), Формат(ДатаРождения, "ДФ=dd.MM.yyyy"), Строка(ГодРождения));
	ДатаВключения = Параметры.ДатаВключения;
	Статус = Параметры.Статус; 
	СтрокаСтатус = СокрЛП(Статус) + ?(ЗначениеЗаполнено(ДатаВключения), " " + Формат(ДатаВключения, "ДФ=dd/MM/yy"), "");	
	Элементы.ДекорацияСтатус.Заголовок = СтрокаСтатус;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИД", ИД);
	Запрос.УстановитьПараметр("ВидПеречня", ВидПеречня);
	Запрос.УстановитьПараметр("ДатаПеречня", ДатаПеречня);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументНаименование КАК ДокументНаименование,
	               |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументДатаВыдачи КАК ДокументДатаВыдачи
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДокументы КАК ЛБ_ПереченьНежелательныхЛицДокументы
	               |ГДЕ
	               |	ЛБ_ПереченьНежелательныхЛицДокументы.ВидПеречня = &ВидПеречня
	               |	И ЛБ_ПереченьНежелательныхЛицДокументы.ДатаПеречня = &ДатаПеречня
	               |	И ЛБ_ПереченьНежелательныхЛицДокументы.ИД = &ИД"; 
	ТаблицаДокументовЗапрос = Запрос.Выполнить().Выгрузить(); 
	Для каждого Стр Из ТаблицаДокументовЗапрос цикл   
		НоваяСтр = ТаблицаДокументы.Добавить();
		НоваяСтр.ТипДокумента = Стр.ДокументНаименование;
		Док = "";
		Док = Док + ?(ПустаяСтрока(Стр.ДокументСерия), "", ?(ПустаяСтрока(Док), "", " ") + Стр.ДокументСерия); 
		Док = Док + ?(ПустаяСтрока(Стр.ДокументНомер), "", ?(ПустаяСтрока(Док), "", " ") + Стр.ДокументНомер); 
		Док = Док + ?(ПустаяСтрока(Стр.ДокументКемВыдан), "", ?(ПустаяСтрока(Док), "", " ") + Стр.ДокументКемВыдан); 
		Док = Док + ?(ПустаяСтрока(Стр.ДокументДатаВыдачи), "", ?(ПустаяСтрока(Док), "", " ") + Формат(Стр.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy"));
		НоваяСтр.Документ = Док;
	КонецЦикла;	
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПереченьНежелательныхЛицАдреса.Адрес КАК Адрес,
	               |	ЛБ_ПереченьНежелательныхЛицАдреса.ТипАдреса КАК ТипАдреса
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицАдреса КАК ЛБ_ПереченьНежелательныхЛицАдреса
	               |ГДЕ
	               |	ЛБ_ПереченьНежелательныхЛицАдреса.ВидПеречня = &ВидПеречня
	               |	И ЛБ_ПереченьНежелательныхЛицАдреса.ДатаПеречня = &ДатаПеречня
	               |	И ЛБ_ПереченьНежелательныхЛицАдреса.ИД = &ИД";
	ТаблицаАдресовЗапрос = Запрос.Выполнить().Выгрузить(); 
	Для каждого Стр Из ТаблицаАдресовЗапрос цикл   
		НоваяСтр = ТаблицаАдреса.Добавить(); 
		НоваяСтр.ТипАдреса = Стр.ТипАдреса;
		НоваяСтр.Адрес = Стр.Адрес;
	КонецЦикла;    
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПереченьНежелательныхЛицДрНаименования.Наименование КАК Наименование
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДрНаименования КАК ЛБ_ПереченьНежелательныхЛицДрНаименования
	               |ГДЕ
	               |	ЛБ_ПереченьНежелательныхЛицДрНаименования.ВидПеречня = &ВидПеречня
	               |	И ЛБ_ПереченьНежелательныхЛицДрНаименования.ДатаПеречня = &ДатаПеречня
	               |	И ЛБ_ПереченьНежелательныхЛицДрНаименования.ИД = &ИД";
	ТаблицаДрЗапрос = Запрос.Выполнить().Выгрузить(); 
	Для каждого Стр Из ТаблицаДрЗапрос цикл   
		НоваяСтр = ТаблицаДрНаименования.Добавить(); 
		НоваяСтр.Наименование = Стр.Наименование;
	КонецЦикла;

КонецПроцедуры                                                            
