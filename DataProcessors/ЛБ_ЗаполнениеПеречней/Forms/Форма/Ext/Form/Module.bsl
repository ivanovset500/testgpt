								ЕстьСовпадение = Истина;
								Прервать;
							КонецЕсли;				
						КонецЕсли;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;  
			Если ЕстьСовпадение Тогда
				Прервать;
			КонецЕсли; 
		КонецЦикла;	
	ИначеЕсли Объект.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН тогда
