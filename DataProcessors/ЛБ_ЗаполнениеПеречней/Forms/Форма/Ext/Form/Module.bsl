								ЕстьСовпадение = Истина;
								Прервать;
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;  
			Если ЕстьСовпадение Тогда
				////УдалитьИзделияИзНакладнойНаОтгузку(Выборка.Клиент); //+Мельников 10.07.24
				УдалитьИзделияИзНакладнойНаОтгузку(СтрДок.Клиент); //+Мельников 10.07.24
				Прервать;
			КонецЕсли; 
		КонецЦикла;			
	КонецЕсли;

    ОбщегоНазначения.СообщитьПользователю("Проверка клиентов по перечню окончание " + Формат(ТекущаяДата(), "ДЛФ=DT"));
