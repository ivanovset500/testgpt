				НоваяЗапись.ДокументДатаВыдачи = СтрокаТаблицы.ДокументДатаВыдачи;
			КонецЦикла; 

			НаборЗаписей.Записать(Истина);    
		КонецЕсли;	
	
	КонецЕсли;	
		
	//проверим всех клиентов по перечню
	ПроверкаКлиентов();
	
	Если НЕ Объект.ТаблицаКлиентов.Количество() = 0 Тогда 
		Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
		НаборЗаписей = Рег.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня); 
		НаборЗаписей.Отбор.ДатаПеречня.Установить(Объект.ДатаПеречня);
		НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню); 
		
		Для каждого СтрК Из Объект.ТаблицаКлиентов Цикл 
			НоваяЗапись = НаборЗаписей.Добавить();   
			НоваяЗапись.Период = ДатаЗагрузки;
			НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню;
			НоваяЗапись.ВидПеречня = Объект.ВидПеречня; 
		    НоваяЗапись.ДатаПеречня = Объект.ДатаПеречня;
			НоваяЗапись.Залогодатель = СтрК.Клиент;
			НоваяЗапись.СтатусКлиентаВПеречне = СтрК.Статус; 
			НоваяЗапись.ИД = СтрК.ИД;  
			НоваяЗапись.ДатаВключенияВПеречень = СтрК.ДатаВключенияВПеречень; 
			НоваяЗапись.КодОтказа = СтрК.КодОтказа;
			ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
			Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		   		Ответственный = ТекПользователь;
			Иначе
				Ответственный = ПараметрыСеанса.ТекущийСотрудник;
			КонецЕсли;	
			НоваяЗапись.Ответственный = Ответственный;
		Конеццикла;	 
						
		НаборЗаписей.Записать(Истина);
	КонецЕсли;	 
	
	//проверим исключенных по списку террористов 
	Если Объект.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ВидПеречня", Объект.ВидПеречня);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_КлиентыВПеречняхСрезПоследних.ИД КАК ИД,
		               |	ЛБ_КлиентыВПеречняхСрезПоследних.Залогодатель КАК Залогодатель
		               |ИЗ
		               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
		               |			,
		               |			ВидПроверки = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню)
		               |				И СтатусКлиентаВПеречне = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыКлиентаВПеречнях.Включен)
		               |				И ВидПеречня = &ВидПеречня) КАК ЛБ_КлиентыВПеречняхСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл 
			Отбор = Новый Структура;
			Отбор.Вставить("ИД", СокрЛП(Выборка.ИД)); 
			
			Строки = Объект.ТаблицаТеррористы.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда   
				Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
				НаборЗаписей = Рег.СоздатьНаборЗаписей();    
				НаборЗаписей.Отбор.ИД.Установить(Выборка.ИД);
				НаборЗаписей.Отбор.Залогодатель.Установить(Выборка.Залогодатель);
				НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня); 
				НаборЗаписей.Отбор.ДатаПеречня.Установить(Объект.ДатаПеречня);
				НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню);

				НоваяЗапись = НаборЗаписей.Добавить();   
				НоваяЗапись.Период = ДатаЗагрузки;         
				НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню;
				НоваяЗапись.ВидПеречня = Объект.ВидПеречня; 
			    НоваяЗапись.ДатаПеречня = Объект.ДатаПеречня;
				НоваяЗапись.Залогодатель = Выборка.Залогодатель;  
				НоваяЗапись.ИД = Выборка.ИД;
				НоваяЗапись.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Исключен;
				ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
				Если НЕ ТекПользователь.ЭтоЛомбард Тогда
			   		Ответственный = ТекПользователь;
				Иначе
					Ответственный = ПараметрыСеанса.ТекущийСотрудник;
				КонецЕсли;	
				НоваяЗапись.Ответственный = Ответственный;
 
				
				НаборЗаписей.Записать(Истина);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;   
	
	Рег = РегистрыСведений.ЛБ_ДатыЗагрузкиПеречней;
	НаборЗаписей = Рег.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня); 
	НаборЗаписей.Отбор.ДатаПеречня.Установить(Объект.ДатаПеречня); 
	НоваяЗапись = НаборЗаписей.Добавить(); 
	//НоваяЗапись.Период = ДатаЗагрузки;   
	НоваяЗапись.Период = ТекущаяДата();
	НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню;
	НоваяЗапись.ВидПеречня = Объект.ВидПеречня; 
    НоваяЗапись.ДатаПеречня = Объект.ДатаПеречня; 
	НоваяЗапись.РазмерФайла = РазмерФайла;
	НоваяЗапись.Ответственный = Пользователи.ТекущийПользователь();
    НаборЗаписей.Записать(Истина);

	ЗаполнитьОсновнуюТаблицу();    
	
КонецПроцедуры  

&НаСервере
Функция ПроверитьЕстьРусскаяВерсияПеречняООН() 
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ВидПеречня", объект.ВидПеречня); 
	Запрос.УстановитьПараметр("ДатаПеречня", объект.ДатаПеречня);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПереченьНежелательныхЛиц.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц КАК ЛБ_ПереченьНежелательныхЛиц
	               |ГДЕ
	               |	ЛБ_ПереченьНежелательныхЛиц.ВидПеречня = &ВидПеречня
	               |	И ЛБ_ПереченьНежелательныхЛиц.ДатаПеречня = &ДатаПеречня";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Истина;
	КонецЕсли;	       
	Возврат ложь;
КонецФункции

//+Мельников 09.07.24 Проверка наличия в перечне и в накладных. Удаление из накладных. Заявка 2666.
//+МАН 05.12.24 Изменена процедура. Сделано исключение из накладной через документ корректировки. Заявка 2666
&НаСервере
Процедура УдалитьИзделияИзНакладнойНаОтгузку(Клиент)
	
	СтатусЗалоговогоБилета = Новый СписокЗначений;
	СтатусЗалоговогоБилета.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную);
	СтатусЗалоговогоБилета.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг);
	
	Дата = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
		|ГДЕ
		|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета В(&СтатусЗалоговогоБилета)";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Клиент);
	Запрос.УстановитьПараметр("СтатусЗалоговогоБилета", СтатусЗалоговогоБилета);
	
	ТаблицаЗБ = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Организация КАК Организация,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.КоличествоОстаток КАК Количество,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.СуммаОценкиОстаток КАК СуммаОценки,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ВесОстаток КАК Вес
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Остатки(&Дата, ЗалоговыйБилет В (&ЗалоговыйБилет)) КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&Дата, ) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних
	               |		ПО ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет = ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.КоличествоОстаток > 0
	               |	И ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.Отгружено)";

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ТаблицаЗБ);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
		ДокКорректировки = Документы.ЛБ_КорректировкаНакладной.СоздатьДокумент();
		ДокКорректировки.Дата = ТекущаяДатаСеанса();
		ДокКорректировки.Организация = ТаблицаЗапроса[0].Организация;
		ДокКорректировки.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ИсключениеЗБИзНакладной;
		ДокКорректировки.Ответственный = Пользователи.ТекущийПользователь();
		ДокКорректировки.Комментарий = "Исключен по перечню.";
		
		Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл 
			НоваяСтр = ДокКорректировки.ЗалоговыеБилеты.Добавить(); 
			НоваяСтр.НакладнаяНаОтгрузку = СтрЗапроса.НакладнаяНаОтгрузку;
			НоваяСтр.ЗалоговыйБилет = СтрЗапроса.ЗалоговыйБилет;
			НоваяСтр.Ломбард = СтрЗапроса.ЗалоговыйБилет.Ломбард;
			НоваяСтр.ОбъектЗалога = СтрЗапроса.ОбъектЗалога;
			НоваяСтр.Количество = СтрЗапроса.Количество;
			НоваяСтр.Вес = СтрЗапроса.Вес; 
			НоваяСтр.СуммаОценки = СтрЗапроса.СуммаОценки;     

		КонецЦикла;

		
		ДокКорректировки.Записать(РежимЗаписиДокумента.Запись);  
		Попытка   
			ДокКорректировки.Записать(РежимЗаписиДокумента.Проведение);
		Исключение   
			ОбщегоНазначения.СообщитьПользователю("Не удалось провести документ " + строка(ДокКорректировки.Ссылка) + ". Обратитесь к разработчикам.");
		КонецПопытки;	 
    КонецЕсли;
КонецПроцедуры
//-Мельников

//+МАН 15.10.25 Изменил процедуру, старую оставил нетронутой.
&НаСервере
Процедура ПроверкаКлиентов_Старая() 
	Объект.ТаблицаКлиентов.Очистить(); 		
	ОбщегоНазначения.СообщитьПользователю("Проверка клиентов по перечню начало " + Формат(ТекущаяДата(), "ДЛФ=DT"));
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателя.Владелец КАК Клиент,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателя.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |		ПО (ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка)
	               |ГДЕ
	               |	ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя";
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	СписокКлиентов = ЛБ_УправлениеЛомбардом.ЗаполнитьСписокКлиентовДляПроверкиПоПеречням(ТекущаяДата());  
	Запрос.УстановитьПараметр("СписокКлиентов", СписокКлиентов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Залогодатели.Ссылка КАК Клиент,
	               |	ЛБ_Залогодатели.Наименование КАК Наименование,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИНН КАК ИНН,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ТипФизЛица КАК ЮридическоеФизическоеЛицо,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия_А КАК Фамилия_А,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя_А КАК Имя_А,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество_А КАК Отчество_А
	               |ИЗ
	               |	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	               |		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних КАК ЛБ_АнкетаЗалогодателяСрезПоследних
	               |		ПО (ЛБ_АнкетаЗалогодателяСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
	               |ГДЕ
	               |	ЛБ_Залогодатели.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_Залогодатели.Ссылка В(&СписокКлиентов)
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Выборка = Запрос.Выполнить().Выбрать(); 
	Пока Выборка.Следующий() Цикл   
		Наименование = Врег(СокрЛП(Выборка.Наименование)); 
		НаименованиеЛат = СокрЛП(Выборка.Фамилия_А) + ?(ПустаяСтрока(Выборка.Имя_А), "", " " + СокрЛП(Выборка.Имя_А)) + ?(ПустаяСтрока(Выборка.Отчество_А), "", " " + СокрЛП(Выборка.Отчество_А));
		НаименованиеЛат = Врег(НаименованиеЛат);
		ДатаРождения = Выборка.ДатаРождения;
