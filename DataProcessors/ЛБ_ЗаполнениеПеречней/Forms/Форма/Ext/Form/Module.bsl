					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;  
			Если ЕстьСовпадение Тогда
				////УдалитьИзделияИзНакладнойНаОтгузку(Выборка.Клиент); //+Мельников 10.07.24
				УдалитьИзделияИзНакладнойНаОтгузку(СтрДок.Клиент); //+Мельников 10.07.24
				Прервать;
			КонецЕсли; 
		КонецЦикла;	
	ИначеЕсли Объект.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ЦБ тогда
		Для каждого СтрДок Из ТаблицаДокументов Цикл 
			ОтборК = Новый Структура;
			ОтборК.Вставить("ДокументНомер", СокрЛП(СтрДок.ДокументНомер));
			ОтборК.Вставить("ДокументСерия", СокрЛП(СтрДок.ДокументСерия));
			СтрокиК = Объект.ТаблицаЦБДокументы.НайтиСтроки(ОтборК); 
			Если НЕ СтрокиК.Количество() = 0 Тогда 
				Для каждого СтрК Из СтрокиК Цикл  
					ОтборИД = Новый Структура; 
					ОтборИД.Вставить("ИД", СтрК.ИД);
					СтрокиИД = Объект.ТаблицаЦБ.НайтиСтроки(ОтборИД);
					Если НЕ СтрокиИД.Количество() = 0 Тогда  
						СтрИД = СтрокиИД.Получить(0);
						Если НЕ СтрИД.ДатаРождения = Дата(1,1,1) Тогда 
							Если СтрИД.ДатаРождения = ДатаРождения Тогда
								НоваяСтр = Объект.ТаблицаКлиентов.Добавить(); 
