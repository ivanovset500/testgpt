&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.ВидПеречня) тогда 
		Объект.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы;
	КонецЕсли;	
	ЗаполнитьОсновнуюТаблицу();		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОсновнуюТаблицу()
	Если НЕ ЗначениеЗаполнено(Объект.ВидПеречня) Тогда
		Возврат;
	КонецЕсли;	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ВидПеречня", Объект.ВидПеречня); 
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_ПереченьНежелательныхЛиц.Период КАК ДатаЗагрузкиПеречня,
	               |	ЛБ_ПереченьНежелательныхЛиц.ДатаПеречня КАК ДатаПеречня,
	               |	ЛБ_ПереченьНежелательныхЛиц.ДатаПредыдущегоПеречня КАК ДатаПредыдущегоПеречня,
	               |	ЛБ_ПереченьНежелательныхЛиц.Ответственный КАК Ответственный,
	               |	ЛБ_ПереченьНежелательныхЛиц.РазмерФайла КАК РазмерФайла
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц КАК ЛБ_ПереченьНежелательныхЛиц
	               |ГДЕ
	               |	ЛБ_ПереченьНежелательныхЛиц.ВидПеречня = &ВидПеречня
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаЗагрузкиПеречня УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаОсновная.Загрузить(ТаблицаЗапроса);
КонецПроцедуры

&НаКлиенте
Процедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл";
	Диалог.ПолноеИмяФайла = ""; 
	Фильтр = "xml (*.xml)|*.xml"; 
	Диалог.Фильтр = Фильтр; 
	Диалог.МножественныйВыбор = Ложь;	
	Диалог.Показать(Новый ОписаниеОповещения("ЗагрузитьФайлЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог)));		
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог; 
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда				
		
		Объект.Файл = Диалог.ПолноеИмяФайла;  
		
		ФайлНаДиске = Новый Файл(Объект.Файл); 
		РазмерФайла = ФайлНаДиске.Размер();
		РазмерФайла = окр(РазмерФайла/1024, 0, РежимОкругления.Окр15как10);			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МассивВСтроку(МассивСтрок)
    Возврат СтрСоединить(МассивСтрок, "/"); 
КонецФункции

&НаСервере
Процедура ПоискДублейСтрокВТабЧасти(ТаблЗнач)	 
	 Удстроки = Новый СписокЗначений;

	 Отбор = Новый Структура();

	 Для каждого Стр Из ТаблЗнач Цикл
		 Если НЕ Удстроки.НайтиПоЗначению(Стр) = неопределено Тогда
			 Продолжить;
		 КонецЕсли;	 
	     Отбор.Очистить();
	     Для каждого Колонки Из ТаблЗнач.Колонки Цикл
	         Если Колонки.Имя <> "НомерСтроки" Тогда
	             Отбор.Вставить(Колонки.Имя, Стр[Колонки.Имя]);
	         КонецЕсли;
	      КонецЦикла;

		  Строки = ТаблЗнач.НайтиСтроки(Отбор);
		  Если Строки.Количество() > 1 Тогда 
			  Для сч = 1 По Строки.Количество()-1 цикл 				  
				  Удстроки.Добавить(Строки[сч]);
			  Конеццикла;	  
		  КонецЕсли; 
	  КонецЦикла;
	  Для каждого Эл Из Удстроки Цикл 
		  ТаблЗнач.Удалить(Эл.Значение); 
	  Конеццикла;	  
КонецПроцедуры

&НаСервере
Процедура ПоискДублейСтрокВТабЧастиОсн(ТаблЗнач)	 
	 Удстроки = Новый СписокЗначений;

	 Отбор = Новый Структура();

	 Для каждого Стр Из ТаблЗнач Цикл
		 Если НЕ Удстроки.НайтиПоЗначению(Стр) = неопределено Тогда
			 Продолжить;
		 КонецЕсли;	 
	     Отбор.Очистить();
	     Отбор.Вставить("ИД", Стр.ИД);
	     Отбор.Вставить("Статус", Стр.Статус);
		 
		  Строки = ТаблЗнач.НайтиСтроки(Отбор);
		  Если Строки.Количество() > 1 Тогда 
			  Для сч = 1 По Строки.Количество()-1 цикл 				  
				  Удстроки.Добавить(Строки[сч]);
			  Конеццикла;	  
		  КонецЕсли; 
	  КонецЦикла;
	  Для каждого Эл Из Удстроки Цикл 
		  ТаблЗнач.Удалить(Эл.Значение); 
	  Конеццикла;	  
КонецПроцедуры

&НаСервере
Функция УстановитьИмяВременногоФайла() 
	
	КаталогВременныхФайлов = Константы.ЛБ_КаталогВременныхФайлов.Получить();
	Если НЕ Прав(СокрЛП(КаталогВременныхФайлов), 1) = "\" Тогда		
	    КаталогВременныхФайлов = СокрЛП(КаталогВременныхФайлов) + "\";
	КонецЕсли;	    
	
	ИмяФайла = СокрЛП(Объект.Файл);
	Пока Истина Цикл 
		Поз = Найти(ИмяФайла, "\");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ИмяФайла = СокрЛП(Сред(ИмяФайла, Поз+1));
	КонецЦикла;	
	
	Возврат КаталогВременныхФайлов +  ИмяФайла;	
КонецФункции

&НаСервере
Процедура ОбработатьФайлНаСервере(АдресХранилища)  
	ИмяВременногоФайла = УстановитьИмяВременногоФайла(); 
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища); 
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	ДатаЗагрузки = ТекущаяДата();
	
	ЧтениеXML = Новый ЧтениеXML; 
	ПутьКФайлу = СокрЛП(ИмяВременногоФайла);
    ЧтениеXML.ОткрытьФайл(ПутьКФайлу);  
	
	Объект.ДатаПеречня = Дата(1,1,1); 
	Объект.ДатаПредыдущегоПеречня = Дата(1,1,1); 
	ВерсияПеречня = 0; //1 -русская, 2- английская для ООН

	Если Объект.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
		ЭтоФРОМУ = Ложь;
		Пока ЧтениеXML.Прочитать() Цикл 
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "АктуальныйСписок" Тогда
				Прервать;
			КонецЕсли;	 
			
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
				ИмяАтрибута = ЧтениеXML.Имя;
				Если сокрЛП(ЧтениеXML.Имя) = "СписокОМУ" Тогда
					ЭтоФРОМУ = Истина;
				КонецЕсли;	
			ИначеЕсли ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
				Если ИмяАтрибута = "ДатаСписка" Тогда
					 Объект.ДатаПеречня = XMLЗначение(Тип("Дата"), ЧтениеXML.Значение); 
				ИначеЕсли ИмяАтрибута = "ДатаПредыдущегоСписка" Тогда
					 Объект.ДатаПредыдущегоПеречня = XMLЗначение(Тип("Дата"), ЧтениеXML.Значение); 	 
				КонецЕсли;	
			КонецЕсли;		
		Конеццикла;	  
		
		Если НЕ ЭтоФРОМУ Тогда 
			Сообщить("Выбранный файл не является списком FROMU!"); 
			Возврат;
		КонецЕсли;
		
		СтекУзлов = Новый Массив;
		ТекущийПуть = "";  
		Объект.ТаблицаФрому.Очистить();
		Объект.ТаблицаФромуДокументы.Очистить();  
		Объект.ТаблицаДрНаименованияФРОМУ.Очистить();
		Пока ЧтениеXML.Прочитать() Цикл  
			
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда  
				СтекУзлов.Добавить(ЧтениеXML.Имя);
				ТекущийПуть = МассивВСтроку(СтекУзлов); 
				Если ЧтениеXML.Имя = "Субъект" И  ТекущийПуть = "Субъект" Тогда 
					НоваяСтр = Объект.ТаблицаФрому.Добавить();   
					НоваяСтр.Статус = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен;
					СписокГражданств = "";   
				ИначеЕсли ЧтениеXML.Имя = "Документ" И  ТекущийПуть = "Субъект/ФЛ/СписокДокументов/Документ" Тогда	
					НоваяСтрДок = Объект.ТаблицаФромуДокументы.Добавить(); 
					НоваяСтрДок.ИД = НоваяСтр.ИД;					
				ИначеЕсли ЧтениеXML.Имя = "Адрес" И  ТекущийПуть = "Субъект/СписокАдресов/Адрес" Тогда	
					НоваяСтрА = Объект.ТаблицаФромуАдреса.Добавить(); 
					НоваяСтрА.ИД = НоваяСтр.ИД; 	
				КонецЕсли;	
					
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда 
				Если ТекущийПуть = "Субъект/ИдСубъекта" Тогда
					НоваяСтр.ИД = СокрЛП(ЧтениеXML.Значение);
				ИначеЕсли ТекущийПуть = "Субъект/ТипСубъекта/Идентификатор" Тогда
	                НоваяСтр.ЮридическоеФизическоеЛицо = ?(ЧтениеXML.Значение = "1", Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо, Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
				ИначеЕсли ТекущийПуть = "Субъект/История/ДатаВключения" Тогда
					НоваяСтр.ДатаВключенияВПеречень = XMLЗначение(Тип("Дата"), ЧтениеXML.Значение); 
				ИначеЕсли ТекущийПуть = "Субъект/ЮЛ/Наименование" Тогда
					НоваяСтр.Наименование = ЧтениеXML.Значение;
				ИначеЕсли ТекущийПуть = "Субъект/ЮЛ/НаименованиеЛат" Тогда
					НоваяСтр.НаименованиеЛат = ЧтениеXML.Значение;
		        ИначеЕсли ТекущийПуть = "Субъект/ФЛ/ФИО" Тогда
					НоваяСтр.Наименование = ЧтениеXML.Значение;
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/ФИОЛат" Тогда
					НоваяСтр.НаименованиеЛат = ЧтениеXML.Значение;
	            ИначеЕсли ТекущийПуть = "Субъект/ФЛ/Фамилия" Тогда
					НоваяСтр.Фамилия = ЧтениеXML.Значение; 
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/ДатаРождения" Тогда
					НоваяСтр.ДатаРождения = XMLЗначение(Тип("Дата"), ЧтениеXML.Значение);
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/ГодРождения" Тогда 
					Попытка
					    НоваяСтр.ГодРождения = Число(ЧтениеXML.Значение);
					Исключение
					КонецПопытки;
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/СписокГражданств/Гражданство" Тогда
					СписокГражданств = СписокГражданств + ?(ПустаяСтрока(СписокГражданств), "", "; ") + ЧтениеXML.Значение; 	
				ИначеЕсли ТекущийПуть = "Субъект/СписокАдресов/Адрес/ТекстАдреса" Тогда
					НоваяСтрА.Адрес = ЧтениеXML.Значение; 
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/СписокДрНаименований/ДрНаименование/ФИО" Тогда 
					НоваяСтрДр = Объект.ТаблицаДрНаименованияФРОМУ.Добавить(); 
					НоваяСтрДр.ИД = НоваяСтр.ИД;	
	                НоваяСтрДр.Наименование = ЧтениеXML.Значение; 
					//+МАН 23.10.25 Добавил разделение другого наименования на фамилию, Имя и Иотчество и запись в регистр
					Если НоваяСтр.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо
						И НЕ ПустаяСтрока(ЧтениеXML.Значение) Тогда
						СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(СокрЛП(ЧтениеXML.Значение));
						
						НоваяСтрДр.Фамилия = СтруктураФИО.Фамилия;
						НоваяСтрДр.Имя = СтруктураФИО.Имя;
						НоваяСтрДр.Отчество = СтруктураФИО.Отчество;
					КонецЕсли;
					//-МАН
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/СписокДокументов/Документ/ТипДокумента/Идентификатор" Тогда
					НоваяСтрДок.ДокументИдентификатор = ЧтениеXML.Значение; 
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/СписокДокументов/Документ/ТипДокумента/Наименование" Тогда
					НоваяСтрДок.ДокументНаименование = ЧтениеXML.Значение;
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/СписокДокументов/Документ/Номер" Тогда
					НоваяСтрДок.ДокументНомер = ЧтениеXML.Значение;	
				ИначеЕсли ТекущийПуть = "Субъект/ФЛ/СписокДокументов/Документ/ОрганВыдачи" Тогда
					НоваяСтрДок.ДокументКемВыдан = ЧтениеXML.Значение;	
				ИначеЕсли ТекущийПуть = "Субъект/Примечание" Тогда
					НоваяСтр.Примечание = ЧтениеXML.Значение;	
				КонецЕсли;	
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда 
				Если  ЧтениеXML.Имя = "АктуальныйСписок" Тогда   
					Прервать;
				КонецЕсли;    
				
				Если ЧтениеXML.Имя = "Субъект" Тогда
					Если НЕ ПустаяСтрока(СписокГражданств) Тогда 
						НоваяСтр.Гражданство = СписокГражданств; 
					КонецЕсли;	
				КонецЕсли;
				
			    СтекУзлов.Удалить(СтекУзлов.Количество()-1); 
				ТекущийПуть = МассивВСтроку(СтекУзлов);
			КонецЕсли ;

		КонецЦикла; 
	    ЧтениеXML.Закрыть();  
			
		Если НЕ Объект.ТаблицаФрому.Количество() = 0 Тогда
			ТаблЗнач = Объект.ТаблицаФрому.Выгрузить();
			ПоискДублейСтрокВТабЧастиОсн(ТаблЗнач);
			Рег = РегистрыСведений.ЛБ_ПереченьНежелательныхЛиц;
		    НаборЗаписей = Рег.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня); 
			НаборЗаписей.Отбор.ДатаПеречня.Установить(Объект.ДатаПеречня);
			
			Для Каждого СтрокаТаблицы Из ТаблЗнач Цикл 	   
			   НоваяЗапись = НаборЗаписей.Добавить(); 
			   НоваяЗапись.Период = ДатаЗагрузки; 
			   НоваяЗапись.ВидПеречня = Объект.ВидПеречня; 
			   НоваяЗапись.ДатаПеречня = Объект.ДатаПеречня;
			   НоваяЗапись.ДатаПредыдущегоПеречня = Объект.ДатаПредыдущегоПеречня;
			   НоваяЗапись.ДатаВключенияВПеречень = СтрокаТаблицы.ДатаВключенияВПеречень; 
			   НоваяЗапись.ИД = СтрокаТаблицы.ИД;  
			   НоваяЗапись.ЮридическоеФизическоеЛицо = СтрокаТаблицы.ЮридическоеФизическоеЛицо;
			   НоваяЗапись.ДатаРождения = СтрокаТаблицы.ДатаРождения;
			   НоваяЗапись.ГодРождения = СтрокаТаблицы.ГодРождения;
			   НоваяЗапись.Гражданство = СтрокаТаблицы.Гражданство;
			   НоваяЗапись.Фамилия = СтрокаТаблицы.Фамилия;
			   НоваяЗапись.Наименование = СтрокаТаблицы.Наименование; 
			   НоваяЗапись.НаименованиеЛат = СтрокаТаблицы.НаименованиеЛат; 
			   НоваяЗапись.Примечание = СтрокаТаблицы.Примечание;
			   НоваяЗапись.Статус = СтрокаТаблицы.Статус; 
			   НоваяЗапись.Ответственный = Пользователи.ТекущийПользователь();
			   НоваяЗапись.РазмерФайла = РазмерФайла;
			   //+МАН 13.10.25 Запись технического наименования
			   Если ЗначениеЗаполнено(СтрокаТаблицы.Наименование) Тогда
				   Символ = Лев(СтрокаТаблицы.Наименование, 1);
				   
				   Если ЭтоРусскаяБуква(Символ) Тогда
					   НоваяЗапись.ТехническоеНаименование = ЛБ_ОбщийМодуль.СформироватьТехническоеНаименование(СтрокаТаблицы.Наименование);
				   КонецЕсли;
			   КонецЕсли;
			   //-МАН
			КонецЦикла; 

			НаборЗаписей.Записать(Истина); 	     
		КонецЕсли;	
			
		Если НЕ Объект.ТаблицаФромуДокументы.Количество() = 0 Тогда  
			ТаблЗнач = Объект.ТаблицаФромуДокументы.Выгрузить();       
			ПоискДублейСтрокВТабЧасти(ТаблЗнач);
			Рег = РегистрыСведений.ЛБ_ПереченьНежелательныхЛицДокументы;
		    НаборЗаписей = Рег.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня);
			НаборЗаписей.Отбор.ДатаПеречня.Установить(Объект.ДатаПеречня);
			
