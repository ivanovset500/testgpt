&НаСервере
Функция ЗаполнитьПараметрыОтчета(ДатаЗагрузкиПеречня = неопределено, ДатаПеречня) 
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("ВидПеречня", Объект.ВидПеречня); 
	ПараметрыФормы.Вставить("ДатаПеречня", ДатаПеречня);
	ПараметрыФормы.Вставить("ДатаСверки", ?(ДатаЗагрузкиПеречня = неопределено, ТекущаяДата(), ДатаЗагрузкиПеречня)); 
	ПараметрыФормы.Вставить("МассивКлиентов", ЛБ_УправлениеЛомбардом.ПреобразованиеТаблицыЗначенийВМассив(Объект.ТаблицаКлиентов.Выгрузить()));  
		
	Возврат ПараметрыФормы;
КонецФункции	

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	Если ПустаяСтрока(Объект.Файл) тогда 
		Сообщить("Не выбран файл!");
		Возврат;
	КонецЕсли;	    
	Если НЕ ЗначениеЗаполнено(Объект.ВидПеречня) Тогда 
		Сообщить("Не выбран вид перечня!");
		Возврат;
	КонецЕсли;	 
	
	ДвоичныеДанные = Новый ДвоичныеДанные(Объект.Файл);
	Идентификатор  = Новый УникальныйИдентификатор;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Идентификатор); 

	ОбработатьФайлНаСервере(АдресХранилища); 
	
	ОткрытьФорму("Отчет.ЛБ_РезультатСверкиПоПеречням.Форма.ФормаОтчета", ЗаполнитьПараметрыОтчета(, Объект.ДатаПеречня), Этаформа);
КонецПроцедуры     


&НаСервере
Процедура УдалитьНаСервере(Идентификатор)
	Стр = ТаблицаОсновная.НайтиПоИдентификатору(Идентификатор);  
	НаборЗаписей = РегистрыСведений.ЛБ_ПереченьНежелательныхЛиц.СоздатьНаборЗаписей();     
    НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня);
    НаборЗаписей.Отбор.ДатаПеречня.Установить(Стр.ДатаПеречня);  

    НаборЗаписей.Записать();  
	
	НаборЗаписей = РегистрыСведений.ЛБ_ПереченьНежелательныхЛицДокументы.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня);
    НаборЗаписей.Отбор.ДатаПеречня.Установить(Стр.ДатаПеречня);  

    НаборЗаписей.Записать();  
	
	НаборЗаписей = РегистрыСведений.ЛБ_ПереченьНежелательныхЛицДрНаименования.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня);
    НаборЗаписей.Отбор.ДатаПеречня.Установить(Стр.ДатаПеречня);  

    НаборЗаписей.Записать(); 
	
	НаборЗаписей = РегистрыСведений.ЛБ_ПереченьНежелательныхЛицАдреса.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.ВидПеречня.Установить(Объект.ВидПеречня);
    НаборЗаписей.Отбор.ДатаПеречня.Установить(Стр.ДатаПеречня);  

    НаборЗаписей.Записать(); 	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	МассивУдаляемыхСтрок = Элементы.ТаблицаОсновная.ВыделенныеСтроки; 
    КоличествоСтрок = МассивУдаляемыхСтрок.Количество();
	Если НЕ КоличествоСтрок = 0 Тогда   
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросУдалить", ЭтотОбъект); 
	    ПоказатьВопрос(Оповещение, "Вы уверены что хотите удалить " + ?(КоличествоСтрок = 1, "выбранный перечень?", "выбранные перечени?"), РежимДиалогаВопрос.ДаНетОтмена, 0,,);
   	КонецЕсли;	
КонецПроцедуры   

&НаКлиенте
Процедура ПослеОтветаНаВопросУдалить(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда   
		МассивУдаляемыхСтрок = Элементы.ТаблицаОсновная.ВыделенныеСтроки;
		СЗ = Новый СписокЗначений;
		СЗ.ЗагрузитьЗначения(МассивУдаляемыхСтрок);
		СЗ.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
		Для Каждого Эл Из СЗ Цикл  
			УдалитьНаСервере(Эл.Значение);
		КонецЦикла; 
		ЗаполнитьОсновнуюТаблицу();
     КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ВидПеречняПриИзменении(Элемент) 
	ТаблицаОсновная.Очистить();
	ЗаполнитьОсновнуюТаблицу();
КонецПроцедуры

