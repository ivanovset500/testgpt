&НаСервере
Процедура ЗаписатьВПереченьГлобальнаяПроверка(Клиент, ВидПеречня, ДатаПеречня, Ид, ДатаВключенияВПеречень, ДатаПроверки) 
	
	Рег = РегистрыСведений.ЛБ_КлиентыВПеречнях;
	НаборЗаписей = Рег.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Залогодатель.Установить(Клиент); 
	НаборЗаписей.Отбор.ВидПеречня.Установить(ВидПеречня); 
	НаборЗаписей.Отбор.ДатаПеречня.Установить(ДатаПеречня);
	НаборЗаписей.Отбор.ВидПроверки.Установить(Перечисления.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка);
	
	НоваяЗапись = НаборЗаписей.Добавить();   
	НоваяЗапись.Период = ДатаПроверки;   
	НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка;
	НоваяЗапись.ВидПеречня = ВидПеречня; 
    НоваяЗапись.ДатаПеречня = ДатаПеречня;
	НоваяЗапись.Залогодатель = Клиент;  
	НоваяЗапись.ИД = ИД;
	НоваяЗапись.ДатаВключенияВПеречень = ДатаВключенияВПеречень;
	НоваяЗапись.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен;
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	НоваяЗапись.Ответственный = Ответственный;

	
	НаборЗаписей.Записать(Истина);

КонецПроцедуры	 

&НаСервере
Функция ЭтоРусскаяБуква(Символ)
   Возврат Найти("АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЫЬЪЭЮЯ", ВРег(Символ))<>0;
