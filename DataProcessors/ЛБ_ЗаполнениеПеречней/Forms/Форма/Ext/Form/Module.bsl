&НаСервере
Процедура ЗаполнитьТаблицуКлиентов(ДатаПеречня) 
	ЗапросК = Новый Запрос;
	ЗапросК.УстановитьПараметр("ВидПеречня", Объект.ВидПеречня); 
	ЗапросК.УстановитьПараметр("ДатаПеречня", ДатаПеречня);  	
	ЗапросК.Текст = "ВЫБРАТЬ
	                |	ЛБ_КлиентыВПеречнях.Залогодатель КАК Клиент,
	                |	ЛБ_КлиентыВПеречнях.СтатусКлиентаВПеречне КАК Статус,
	                |	ЛБ_КлиентыВПеречнях.ИД КАК ИД,
	                |	ЛБ_КлиентыВПеречнях.ДатаВключенияВПеречень КАК ДатаВключенияВПеречень
	                |ИЗ
	                |	РегистрСведений.ЛБ_КлиентыВПеречнях КАК ЛБ_КлиентыВПеречнях
	                |ГДЕ
	                |	ЛБ_КлиентыВПеречнях.ВидПеречня = &ВидПеречня
	                |	И ЛБ_КлиентыВПеречнях.ДатаПеречня = &ДатаПеречня
	                |	И ЛБ_КлиентыВПеречнях.ВидПроверки = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПроверкиПеречней.ПроверкаПоПеречню)
	                |	И ЛБ_КлиентыВПеречнях.СтатусКлиентаВПеречне = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыКлиентаВПеречнях.Включен)";
	ТаблицаЗапроса = ЗапросК.Выполнить().Выгрузить();
	Объект.ТаблицаКлиентов.Загрузить(ТаблицаЗапроса);
КонецПроцедуры  

&НаКлиенте
Процедура ОтчетПоПроверкеПеречня(Команда)
	ТекСтрока = Элементы.ТаблицаОсновная.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидПеречня) Тогда 
		Сообщить("Не выбран вид перечня!");
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьТаблицуКлиентов(ТекСтрока.ДатаПеречня);
	
	ОткрытьФорму("Отчет.ЛБ_РезультатСверкиПоПеречням.Форма.ФормаОтчета", ЗаполнитьПараметрыОтчета(ТекСтрока.ДатаЗагрузкиПеречня, ТекСтрока.ДатаПеречня), Этаформа);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоГлобальнойПроверке(Команда)
	Если Объект.ДатаНач = Дата(1,1,1) И Объект.ДатаКон = Дата(1,1,1)  Тогда 
		Сообщить("Не выбраны даты проведения глобальных проверок перечней!");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаНач", Объект.ДатаНач);
	ПараметрыФормы.Вставить("ДатаКон", ?(Объект.ДатаКон = Дата(1,1,1), ТекущаяДата(), Объект.ДатаКон));
	
	ОткрытьФорму("Отчет.ЛБ_РезультатГлобальнойПроверкиПоПеречням.Форма.ФормаОтчета", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

//+МАН 11.02.25 для получения информации по клиенту
&НаСервере
Функция ПолучитьДокумент(Залогодатель)
	Запрос = Новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателя.Владелец КАК Клиент,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателя.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |		ПО (ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка)
	               |ГДЕ
	               |	ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя
	               |	И ЛБ_ДокументыЗалогодателя.Владелец = &Залогодатель";
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаДокументов;
КонецФункции

//+МАН 13.02.25 Перенес из общего модуля ЛБ_УправлениеЛомбардом
&НаСервере
Процедура ГлобальнаяПроверкаПоПеречнямНаСервере(Дата1, Дата2)
	ДатаПроверки = ТекущаяДата();
	ВидыПеречней = Новый СписокЗначений;
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ); 
	ВидыПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	ЗапросП = Новый Запрос; 
	ЗапросП.УстановитьПараметр("ВидыПеречней", ВидыПеречней);
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_ВидыПеречней.Ссылка КАК ВидПеречня
	                |ИЗ
	                |	Перечисление.ЛБ_ВидыПеречней КАК ЛБ_ВидыПеречней
	                |ГДЕ
	                |	ЛБ_ВидыПеречней.Ссылка В(&ВидыПеречней)";
	ТаблицаП = ЗапросП.Выполнить().Выгрузить();
	
	ЗапросП1 = Новый Запрос;
	ЗапросП1.УстановитьПараметр("Дата1", НачалоДня(Дата1));  
	ЗапросП1.УстановитьПараметр("Дата2", КонецДня(Дата2));
	ЗапросП1.Текст = "ВЫБРАТЬ
	                 |	ЛБ_ПереченьНежелательныхЛиц.ВидПеречня КАК ВидПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ДатаПеречня КАК ДатаПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ДатаВключенияВПеречень КАК ДатаВключенияВПеречень,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ИД КАК ИД,
	                 |	ЛБ_ПереченьНежелательныхЛиц.Наименование КАК Наименование,
	                 |	ЛБ_ПереченьНежелательныхЛиц.НаименованиеЛат КАК НаименованиеЛат,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ДатаРождения КАК ДатаРождения,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ГодРождения КАК ГодРождения,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ИНН КАК ИНН,
	                 |	ЛБ_ПереченьНежелательныхЛиц.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,
	                 |	ЛБ_ПереченьНежелательныхЛиц.Статус КАК Статус,
	                 |	ЛБ_ПереченьНежелательныхЛиц.РазмерФайла КАК РазмерФайла
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛиц КАК ЛБ_ПереченьНежелательныхЛиц
	                 |ГДЕ
	                 |	ЛБ_ПереченьНежелательныхЛиц.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыКлиентаВПеречнях.Включен)
	                 |	И ЛБ_ПереченьНежелательныхЛиц.Период МЕЖДУ &Дата1 И &Дата2
	                 |
	                 |УПОРЯДОЧИТЬ ПО
	                 |	ЛБ_ПереченьНежелательныхЛиц.Период";  
	ТаблицаПеречней = ЗапросП1.Выполнить().Выгрузить(); 
	ТаблицаПеречнейДаты = ТаблицаПеречней.Скопировать();
	ТаблицаПеречнейДаты.Свернуть("ВидПеречня, ДатаПеречня, РазмерФайла");
	
	ЗапросП2 = Новый Запрос;
	ЗапросП2.УстановитьПараметр("Дата1", Дата1);  
	ЗапросП2.УстановитьПараметр("Дата2", Дата2);
	ЗапросП2.Текст = "ВЫБРАТЬ
	                 |	ЛБ_ПереченьНежелательныхЛицДокументы.ВидПеречня КАК ВидПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛицДокументы.ДатаПеречня КАК ДатаПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛицДокументы.ИД КАК ИД,
	                 |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументНомер КАК ДокументНомер,
	                 |	ЛБ_ПереченьНежелательныхЛицДокументы.ДокументСерия КАК ДокументСерия
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДокументы КАК ЛБ_ПереченьНежелательныхЛицДокументы
	                 |ГДЕ
	                 |	ЛБ_ПереченьНежелательныхЛицДокументы.Период МЕЖДУ &Дата1 И &Дата2"; 
	ТаблицаПеречнейДокументы = ЗапросП2.Выполнить().Выгрузить();
	  
	ЗапросП3 = Новый Запрос;  
	ЗапросП3.УстановитьПараметр("Дата1", Дата1);  
	ЗапросП3.УстановитьПараметр("Дата2", Дата2);
	ЗапросП3.Текст = "ВЫБРАТЬ
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.ВидПеречня КАК ВидПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.ДатаПеречня КАК ДатаПеречня,
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.ИД КАК ИД,
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.Наименование КАК Наименование,
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.ДатаРождения КАК ДатаРождения,
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.ГодРождения КАК ГодРождения
	                 |ИЗ
	                 |	РегистрСведений.ЛБ_ПереченьНежелательныхЛицДрНаименования КАК ЛБ_ПереченьНежелательныхЛицДрНаименования
	                 |ГДЕ
	                 |	ЛБ_ПереченьНежелательныхЛицДрНаименования.Период МЕЖДУ &Дата1 И &Дата2";  
	ТаблицаПеречнейДрНаименования = ЗапросП3.Выполнить().Выгрузить();	
		
    Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ВидДокументаЗалогодателя", Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателя.Владелец КАК Клиент,
	               |	ЛБ_ДокументыЗалогодателей.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателей.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателя.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей КАК ЛБ_ДокументыЗалогодателей
	               |		ПО (ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка)
	               |ГДЕ
	               |	ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = &ВидДокументаЗалогодателя";
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	СписокКлиентов = ЛБ_УправлениеЛомбардом.ЗаполнитьСписокКлиентовДляГлобальнойПроверкиПоПеречням(Дата1, Дата2);
	Запрос.УстановитьПараметр("СписокКлиентов", СписокКлиентов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Залогодатели.Ссылка КАК Клиент,
	               |	ЛБ_Залогодатели.Наименование КАК Наименование,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИНН КАК ИНН,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ТипФизЛица КАК ЮридическоеФизическоеЛицо,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия_А КАК Фамилия_А,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя_А КАК Имя_А,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество_А КАК Отчество_А
	               |ИЗ
	               |	Справочник.ЛБ_Залогодатели КАК ЛБ_Залогодатели
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	               |		ПО (ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних КАК ЛБ_АнкетаЗалогодателяСрезПоследних
	               |		ПО (ЛБ_АнкетаЗалогодателяСрезПоследних.Залогодатель = ЛБ_Залогодатели.Ссылка)
	               |ГДЕ
	               |	ЛБ_Залогодатели.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_Залогодатели.Ссылка В(&СписокКлиентов)
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаК = Запрос.Выполнить().Выгрузить(); 
		
	Для каждого СтрП Из ТаблицаП Цикл 						
		ОтборП = Новый Структура;
		ОтборП.Вставить("ВидПеречня", СтрП.ВидПеречня);  
		СтрокиПеречня = ТаблицаПеречнейДаты.НайтиСтроки(ОтборП);
		
		Для каждого стр Из СтрокиПеречня Цикл 
			Рег = РегистрыСведений.ЛБ_ДатыЗагрузкиПеречней;
			НаборЗаписей = Рег.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВидПеречня.Установить(Стр.ВидПеречня); 
			НаборЗаписей.Отбор.ДатаПеречня.Установить(Стр.ДатаПеречня);
			НаборЗаписей.Отбор.Период.Установить(ДатаПроверки);
			НоваяЗапись = НаборЗаписей.Добавить(); 
			НоваяЗапись.Период = ДатаПроверки; 
			НоваяЗапись.ВидПроверки = Перечисления.ЛБ_ВидыПроверкиПеречней.ГлобальнаяПроверка;
			НоваяЗапись.ВидПеречня = Стр.ВидПеречня; 
		    НоваяЗапись.ДатаПеречня = Стр.ДатаПеречня; 
			НоваяЗапись.РазмерФайла = Стр.РазмерФайла;
			НоваяЗапись.Ответственный = Пользователи.ТекущийПользователь();
		    НаборЗаписей.Записать(Истина);
			
			Для каждого Выборка из ТаблицаК Цикл   
				Клиент = Выборка.Клиент; 
				Наименование = СокрЛП(Выборка.Фамилия) + ?(ПустаяСтрока(Выборка.Имя), "", " " + СокрЛП(Выборка.Имя)) + ?(ПустаяСтрока(Выборка.Отчество), "", " " + СокрЛП(Выборка.Отчество));
				Наименование = ВРег(Наименование);
				НаименованиеЛат = СокрЛП(Выборка.Фамилия_А) + ?(ПустаяСтрока(Выборка.Имя_А), "", " " + СокрЛП(Выборка.Имя_А)) + ?(ПустаяСтрока(Выборка.Отчество_А), "", " " + СокрЛП(Выборка.Отчество_А));
				НаименованиеЛат = ВРег(НаименованиеЛат);
				// ++ Сербаев 25.07.2023
				//ДатаРождения = ?(ДатаРождения = null, Дата(1,1,1), Выборка.ДатаРождения);
				ДатаРождения = ?(Выборка.ДатаРождения = null, Дата(1,1,1), Выборка.ДатаРождения);
				// -- Сербаев 25.07.2023
				ГодРождения = Год(ДатаРождения);
				ЮридическоеФизическоеЛицо = Выборка.ЮридическоеФизическоеЛицо; 
				ИНН = СокрЛП(Выборка.ИНН);

				ЕстьСовпадение = ложь;
				Отбор = Новый Структура; 
				Отбор.Вставить("ВидПеречня", Стр.ВидПеречня);
				Отбор.Вставить("ДатаПеречня", Стр.ДатаПеречня);
				Отбор.Вставить("Наименование", Наименование);
				Отбор.Вставить("ЮридическоеФизическоеЛицо", ЮридическоеФизическоеЛицо);   
				СтрокиК = ТаблицаПеречней.НайтиСтроки(Отбор);
				Если НЕ СтрокиК.Количество() = 0 Тогда 
					Для каждого СтрК Из СтрокиК Цикл  
						Если НЕ СтрК.ДатаРождения = Дата(1,1,1) Тогда 
							Если СтрК.ДатаРождения = ДатаРождения Тогда
								ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрК.ДатаПеречня, СтрК.Ид, СтрК.ДатаВключенияВПеречень, ДатаПроверки);
								ЕстьСовпадение = Истина;  
								Прервать;
							КонецЕсли;	 
						ИначеЕсли НЕ СтрК.ГодРождения = 0 Тогда 
							Если СтрК.ГодРождения = ГодРождения Тогда
								ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрК.ДатаПеречня, СтрК.Ид, СтрК.ДатаВключенияВПеречень, ДатаПроверки);
								ЕстьСовпадение = Истина;  
								Прервать;
							КонецЕсли;	
						КонецЕсли;
						Если НЕ ПустаяСтрока(ИНН) Тогда 
							Если СтрК.ИНН = ИНН Тогда
							    ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрК.ДатаПеречня, СтрК.Ид, СтрК.ДатаВключенияВПеречень, ДатаПроверки);
								ЕстьСовпадение = Истина;
								Прервать;
							КонецЕсли;			
						КонецЕсли;
					КонецЦикла;	
				КонецЕсли; 	
				Если ЕстьСовпадение Тогда
					Продолжить;
				КонецЕсли;  
								
				Отбор = Новый Структура;  
				Отбор.Вставить("ВидПеречня", Стр.ВидПеречня);
				Отбор.Вставить("ДатаПеречня", Стр.ДатаПеречня);
				Отбор.Вставить("Наименование", Наименование);
				СтрокиК = ТаблицаПеречнейДрНаименования.НайтиСтроки(Отбор);
				Если НЕ СтрокиК.Количество() = 0 Тогда 
					Для каждого СтрК Из СтрокиК Цикл  
						ОтборИД = Новый Структура;
						ОтборИД.Вставить("ИД", СтрК.ИД);
						СтрокиИД = ТаблицаПеречней.НайтиСтроки(ОтборИД);
						Если НЕ СтрокиИД.Количество() = 0 Тогда  
							СтрИД = СтрокиИД.Получить(0);
							Если НЕ СтрК.ДатаРождения = Дата(1,1,1) Тогда 
								Если СтрК.ДатаРождения = ДатаРождения Тогда  
									ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрИД.ДатаПеречня, СтрИД.Ид, СтрИД.ДатаВключенияВПеречень, ДатаПроверки);
								    ЕстьСовпадение = Истина; 								
									Прервать;
								КонецЕсли;	 
							ИначеЕсли НЕ ГодРождения = 0 Тогда 
								Если СтрК.ГодРождения = ГодРождения Тогда
									ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрИД.ДатаПеречня, СтрИД.Ид, СтрИД.ДатаВключенияВПеречень, ДатаПроверки);
									ЕстьСовпадение = Истина;  
									Прервать;
								КонецЕсли;		
							КонецЕсли; 
							//Если НЕ ПустаяСтрока(ИНН) Тогда 
							//	Если СтрИД.ИНН = ИНН Тогда
							//	    ЗаписатьВПереченьГлобальнаяПроверка(Клиент, СтрП.ВидПеречня, СтрИД.ДатаПеречня, СтрИД.Ид, СтрИД.ДатаВключенияВПеречень, ДатаПроверки);
							//		ЕстьСовпадение = Истина;
							//		Прервать;
							//	КонецЕсли;			
							//КонецЕсли;
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;  
				Если ЕстьСовпадение Тогда
					Продолжить;
				КонецЕсли;  
				
				Если НЕ Пустаястрока(НаименованиеЛат) Тогда
		        	Отбор = Новый Структура;
