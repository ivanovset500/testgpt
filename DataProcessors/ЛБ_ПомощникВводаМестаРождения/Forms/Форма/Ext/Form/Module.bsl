&НаКлиенте
Процедура МестоРожденияОбластьПриИзменении(Элемент)
	
	// ++ Сербаев 16.06.2023
	Если Не ПустаяСтрока(СокрЛП(Объект.МестоРожденияОбласть)) Тогда
		ТекстОшибки = ЛБ_ОбщегоНазначения.СообщитьЕслиСтрокаНеправильная(Объект.МестоРожденияОбласть, "Область");
		Если ТекстОшибки <> "" Тогда 	
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , , "Объект.МестоРожденияОбласть");
			Возврат;
		КонецЕсли;
	КонецЕсли;
    // -- Сербаев 16.06.2023
	
	Объект.МестоРожденияОбласть = ЛБ_ОбщегоНазначения.ПрописнаяПерваяБуква(Объект.МестоРожденияОбласть);
	ЗаполнитьМестоРожденияСтрока();
КонецПроцедуры

