&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("МестоРожденияСтрана") тогда
		Объект.МестоРожденияСтрана = Параметры.МестоРожденияСтрана;
	КонецЕсли;	
	Если Параметры.Свойство("МестоРожденияОбласть") тогда
		Объект.МестоРожденияОбласть = Параметры.МестоРожденияОбласть;
	КонецЕсли;
	Если Параметры.Свойство("МестоРожденияРайон") тогда
		Объект.МестоРожденияРайон = Параметры.МестоРожденияРайон;
	КонецЕсли;
	Если Параметры.Свойство("МестоРожденияНаселенныйПункт") тогда
		Объект.МестоРожденияНаселенныйПункт = Параметры.МестоРожденияНаселенныйПункт;
	КонецЕсли;
	Если Параметры.Свойство("МестоРождения") тогда
		Объект.МестоРожденияСтрока = Параметры.МестоРождения;
	КонецЕсли;
	//Если НЕ ЗначениеЗаполнено(Объект.МестоРожденияСтрана) Тогда
	//	Объект.МестоРожденияСтрана = "РОССИЯ";
	//КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМестоРожденияСтрока()
    Объект.МестоРожденияСтрока = ЛБ_ОбщегоНазначения.ЗаполнитьИнфорациюОМестеРождения(Объект.МестоРожденияСтрана, Объект.МестоРожденияОбласть, Объект.МестоРожденияРайон, Объект.МестоРожденияНаселенныйПункт);
    // ++ Сербаев 31.05.2023
	Модифицированность = Истина;
	// -- Сербаев 31.05.2023
КонецПроцедуры


&НаКлиенте
Процедура ОсобоеМестоРожденияПриИзменении(Элемент)
	Если ОсобоеМестоРождения Тогда
	    Объект.МестоРожденияСтрана          = "";
		Объект.МестоРожденияОбласть         = "";
		Объект.МестоРожденияРайон           = "";
		Объект.МестоРожденияНаселенныйПункт = "";
		Объект.МестоРожденияСтрока          = "";
	КонецЕсли;	
	УстановитьДоступность();
КонецПроцедуры

Процедура УстановитьДоступность()
	Если ОсобоеМестоРождения Тогда
		Элементы.МестоРожденияСтрана.Доступность          = Ложь;
		Элементы.МестоРожденияОбласть.Доступность         = Ложь;
		Элементы.МестоРожденияРайон.Доступность           = Ложь;
		Элементы.МестоРожденияНаселенныйПункт.Доступность = Ложь;
		Элементы.МестоРожденияСтрока.ТолькоПросмотр       = Ложь;
	Иначе
		Элементы.МестоРожденияСтрана.Доступность          = Истина;
		Элементы.МестоРожденияОбласть.Доступность         = Истина;
		Элементы.МестоРожденияРайон.Доступность           = Истина;
		Элементы.МестоРожденияНаселенныйПункт.Доступность = Истина;
		Элементы.МестоРожденияСтрока.ТолькоПросмотр       = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ПустаяСтрока(Объект.МестоРожденияСтрока) И 
	 ПустаяСтрока(Объект.МестоРожденияСтрана+Объект.МестоРожденияОбласть+Объект.МестоРожденияРайон+Объект.МестоРожденияНаселенныйПункт) Тогда
		ОсобоеМестоРождения = Истина;
	Иначе
		ОсобоеМестоРождения = ложь;
	КонецЕсли;	
    УстановитьДоступность();
КонецПроцедуры

