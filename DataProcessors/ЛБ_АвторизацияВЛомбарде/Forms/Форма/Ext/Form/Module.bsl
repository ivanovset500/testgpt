Процедура ЗаписатьВПротоколРаботы()
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		МенеджерЗаписи = РегистрыСведений.ЛБ_ПротоколРаботы.СоздатьМенеджерЗаписи(); 
		МенеджерЗаписи.Сотрудник = Сотрудник; 
		МенеджерЗаписи.Дата = ТекущаяДата(); 
		МенеджерЗаписи.Ломбард = Ломбард; 
		МенеджерЗаписи.Действие = Перечисления.ЛБ_ДействияПользователя.Вход;
		МенеджерЗаписи.Записать(); 		
	КонецЕсли;	
КонецПроцедуры 

Процедура УстановитьПараметрСеанса(ТекСотр)
	ПараметрыСеанса.ТекущийСотрудник = ТекСотр;
КонецПроцедуры

Процедура УстановитьПараметрСеансаЛомбард(ТекЛомб)
	ПараметрыСеанса.ТекущийЛомбард = ТекЛомб;	
КонецПроцедуры


&НаСервере
Процедура ОтделениеПриИзмененииНаСервере()
	// Вставить содержимое обработчика.
	тзСотр = СформироватьСписокСотрудников(); 
	Для каждого стр из тзСотр Цикл
		Элементы.Сотрудник.СписокВыбора.Добавить(стр.Сотрудник, СокрЛП(стр.Сотрудник) + " ("+СокрЛП(стр.Должность)+")");
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура ОтделениеПриИзменении(Элемент)
	ОтделениеПриИзмененииНаСервере();
