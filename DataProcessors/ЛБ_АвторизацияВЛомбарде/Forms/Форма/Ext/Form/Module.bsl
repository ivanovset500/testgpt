		ОткрытьФорму("ОбщаяФорма.ЛБ_РабочееМестоПриемщикаЛомбарда");
		//-МАН
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьТекущийЛомбардВРегистр()
	МенеджерЗаписи = РегистрыСведений.ЛБ_ТекущийЛомбардПользователя.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Ломбард      = Ломбард;
	МенеджерЗаписи.Записать();	
КонецПроцедуры
	
	

