
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Если НЕ Пользователь.ЭтоЛомбард Тогда
		УстановитьПараметрСеанса(Пользователь.Сотрудник); 
		Отказ = Истина;
	КонецЕсли;
	
	Ломбард = Пользователь.Подразделение; 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	               |			,
	               |			Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	               |ГДЕ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард = &Ломбард";
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отделение = Выборка.Отделение; 
		ОтделениеПриИзмененииНаСервере();
	КонецЕсли;
КонецПроцедуры



Функция СформироватьСписокСотрудников()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	               |			,
	               |			Отделение = &Отделение
	               |				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("Отделение", Отделение);

	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка");
	
				   
	
	Запрос2 = Новый Запрос;

	Запрос2.Текст = "ВЫБРАТЬ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия КАК ВидСобытия,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность
	                |ИЗ
	                |	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	                |ГДЕ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	                |	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЛомбарда";
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	
	тзСотр = Запрос2.Выполнить().Выгрузить();
	
	Возврат тзСотр;
	
КонецФункции

&НаКлиенте
Процедура ОК(Команда)
	// вставить проверку соответствия пароля и сотрудника 
	ОчиститьСообщения();
	Если БезОшибок() Тогда
		ПарольВерный = Истина;
		ЗаписатьВПротоколРаботы();
		УстановитьПараметрСеанса(Сотрудник);
		УстановитьПараметрСеансаЛомбард(Ломбард); 
		ЗаписатьТекущийЛомбардВРегистр();
