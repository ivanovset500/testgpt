&НаКлиенте
Процедура ОбработатьИзменениеРежимаЗаймаХранения(Режим)
	
	Если Режим = "Займы" Тогда
		
		ВидДоговора = ПредопределенноеЗначение("Перечисление.АКСЛМБВидыДоговоров.Займ");
		ЭлементРежимЗаймыХранение = Элементы.ФормаРежимЗаймы;
		
	Иначе
		// Хранение
		ВидДоговора = ПредопределенноеЗначение("Перечисление.АКСЛМБВидыДоговоров.Хранение");
		ЭлементРежимЗаймыХранение = Элементы.ФормаРежимХранение;
		
	КонецЕсли;
	
	ЭлементРежимЗаймыХранение.Пометка = Не ЭлементРежимЗаймыХранение.Пометка;
	
	ЭлементПоВидуДоговора = ВидыДоговоровЗаймаХранения.НайтиПоЗначению(ВидДоговора);
	Если ЭлементРежимЗаймыХранение.Пометка Тогда
		Если ЭлементПоВидуДоговора = Неопределено Тогда
			ВидыДоговоровЗаймаХранения.Добавить(ВидДоговора);
		КонецЕсли;
	Иначе
		Если ЭлементПоВидуДоговора <> Неопределено Тогда 
			ВидыДоговоровЗаймаХранения.Удалить(ЭлементПоВидуДоговора);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьОтборПоВидуДоговора();
	
	УправлениеФормойНаКлиенте();
	
КонецПроцедуры

