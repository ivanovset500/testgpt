&НаСервере
Функция ПолучитьНоменклатуруПоШК(Штрихкод)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Штрихкоды.Номенклатура
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод ПОДОБНО &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Структура("Ошибка, ТекстОшибки", Истина, "Не найдена номенклатура по штрихкоду " + Штрихкод);
	Иначе	
		Возврат Новый Структура("Ошибка, ТЗНоменклатура", Ложь, РезультатЗапроса.Выгрузить());
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция СформироватьСписокДоговоровКОбработке()
	
	ЕстьОтмеченныеЗалоговыеБилеты = ВыбранныеЗалоговыеБилеты.Количество() > 0;
	
	СписокДоговоров = Новый СписокЗначений;
	
	Если ЕстьОтмеченныеЗалоговыеБилеты Тогда
		
		СписокДоговоров = ВыбранныеЗалоговыеБилеты;
		
	Иначе
		
		ТекДанные = Элементы.ЗалоговыеБилеты.ТекущиеДанные;
		ТекЗалоговыйБилет = Неопределено;
		Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда 
			ТекЗалоговыйБилет = Объект.ЗалоговыйБилет;
		ИначеЕсли ТекДанные <> Неопределено И ТекДанные.Свойство("ЗалоговыйБилет") Тогда
			ТекЗалоговыйБилет = ТекДанные.ЗалоговыйБилет;
		КонецЕсли;
		
		Если ТекЗалоговыйБилет <> Неопределено Тогда
			СписокДоговоров.Добавить(ТекЗалоговыйБилет);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СписокДоговоров;
	
КонецФункции

