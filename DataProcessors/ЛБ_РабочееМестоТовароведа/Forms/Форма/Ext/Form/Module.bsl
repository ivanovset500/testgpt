&НаСервере
Функция ПолучитьТекущегоПользователяНаСервере()
	
	текСотрудник = "" + ПараметрыСеанса.ТекущийСотрудник;
	Если текСотрудник = "" Тогда 
		текСотрудник = "" + Пользователи.ТекущийПользователь();
	КонецЕсли;
	Возврат текСотрудник;
КонецФункции
//--- Моисеев 20250520

