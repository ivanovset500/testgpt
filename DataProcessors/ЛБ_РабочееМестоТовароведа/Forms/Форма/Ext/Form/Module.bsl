	МассивИменПервичныхДокументов = Новый Массив;
	МассивИменПервичныхДокументов.Добавить("АКСЛМБВыдачаЗайма");
	МассивИменПервичныхДокументов.Добавить("АКСЛМБПриемНаХранение");
	
	Если ЕстьОтмеченныеЗалоговыеБилеты И МассивИменПервичныхДокументов.Найти(ИмяДокумента) = Неопределено Тогда
		
		Для Каждого ЭлементСписка Из ВыбранныеЗалоговыеБилеты Цикл
			МассивСтруктурОснований.Добавить(ПолучитьСтруктуруОснованиеДляСозданияДокумента(ИмяДокумента, ЭлементСписка.Значение));
		КонецЦикла;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(Объект.Залогодатель) И ИмяДокумента <> "АКСЛМБВыдачаЗайма" Тогда
			
			ПоказатьПредупреждение(, НСтр("ru = 'Не задан отбор по залогодателю.'"),, "Предупреждение");
			
			Возврат;
			
		КонецЕсли;
		
		ТекДанные = Элементы.ЗалоговыеБилеты.ТекущиеДанные;
		ТекЗалоговыйБилет = Неопределено;
		Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда 
			ТекЗалоговыйБилет = Объект.ЗалоговыйБилет;
		ИначеЕсли ТекДанные <> Неопределено И ТекДанные.Свойство("ЗалоговыйБилет") Тогда
			ТекЗалоговыйБилет = ТекДанные.ЗалоговыйБилет;
		КонецЕсли;
		
		МассивСтруктурОснований.Добавить(ПолучитьСтруктуруОснованиеДляСозданияДокумента(ИмяДокумента, ТекЗалоговыйБилет));
	
	КонецЕсли;
	
	Для Каждого СтруктураОснование Из МассивСтруктурОснований Цикл
	
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Основание", СтруктураОснование);
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить("Документ");
		МассивСтрок.Добавить(ИмяДокумента);
		МассивСтрок.Добавить("ФормаОбъекта");
		
		ИмяФормыДокумента = СтрСоединить(МассивСтрок, ".");
		
		ОткрытьФорму(
			ИмяФормыДокумента,
			ПараметрыОткрытия,
			ЭтаФорма,,,,, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруОснованиеДляСозданияДокумента(ИмяДокумента, ЗалоговыйБилет)
	
	СтруктураОснование = Новый Структура;
	СтруктураОснование.Вставить("Организация", 				Объект.Организация);
	СтруктураОснование.Вставить("Контрагент", 				Объект.Контрагент);
	СтруктураОснование.Вставить("ПодразделениеОрганизации", Объект.Подразделение);
	СтруктураОснование.Вставить("Склад",					Объект.Склад);
	
	Если ИмяДокумента = "АКСЛМБВыдачаЗайма"
	  Или ИмяДокумента = "АКСЛМБПриемНаХранение" Тогда	
		СтруктураОснование.Вставить("Клиент", Объект.Залогодатель);
		
	ИначеЕсли ИмяДокумента = "АКСЛМБДоверенность"
	  Или ИмяДокумента = "АКСЛМБАннулированиеДоверенности" Тогда
		СтруктураОснование.Вставить("Клиент", Объект.Залогодатель);
		СтруктураОснование.Вставить("ДоговорКонтрагента", ЗалоговыйБилет);
	Иначе
		СтруктураОснование.Вставить("ДоговорКонтрагента", ЗалоговыйБилет);
		СтруктураОснование.Вставить("Клиент", Объект.Залогодатель);
		Товары = КоличествоПредметовПоДоговору(ЗалоговыйБилет, Объект.Организация, Объект.Контрагент);
		СтруктураОснование.Вставить("Товары",Товары);		
	КонецЕсли;
	
	Возврат СтруктураОснование;
	
КонецФункции

