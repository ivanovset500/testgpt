&НаСервере
Процедура ОбработатьПолученныйКодНаСервере(НайденныйДоговор)
	
	// Добавим собранные данные на форму
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.АКСЛМБФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ДоговорыКонтрагентов.Владелец = Контрагенты.Ссылка
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", НайденныйДоговор);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	Объект.ЗалоговыйБилет = НайденныйДоговор;
	Объект.Залогодатель = ВыборкаДетальныеЗаписи.ФизическоеЛицо;
	
	Элементы.ЗалоговыеБилеты.ТекущаяСтрока = Новый ("РегистрСведенийКлючЗаписи.АКСЛМБСостояниеЗалоговогоБилета", Новый Структура ("ДоговорКонтрагента", НайденныйДоговор));

