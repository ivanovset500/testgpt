&НаСервере
Процедура ЗаполнитьСтатусыКлиентаСервер()
	СтатусыКлиента.Очистить();
	СтрокаПоСистемеЛояльности = СтатусыКлиента.Добавить();
	СтрокаПоСистемеЛояльности.ВидСтатуса = "по системе лояльности";
	СтрокаПоСистемеЛояльности.Значение = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(ТекущаяДата(), Объект.Залогодатель);
	
	//дополнительные статусы
	строкаДополнительныеСтатусы = "";
	результатВИП = ПроверитьСтатусКлиентаВИП(ТекущаяДата(), Объект.Залогодатель);
	Если результатВИП.Используется Тогда 
		строкаДополнительныеСтатусы = строкаДополнительныеСтатусы + ?(ЗначениеЗаполнено(строкаДополнительныеСтатусы), ",", "") + "ВИП";
	КонецЕсли;
	ДопСтатусы = ЗаполнитьТаблицуВыбораДопСтатусовКлиента();
	строкаДополнительныеСтатусы = строкаДополнительныеСтатусы + ДопСтатусы;
	Если ЗначениеЗаполнено(СокрЛП(строкаДополнительныеСтатусы)) Тогда 
		новстрокаДополнительныеСтатусы = СтатусыКлиента.Добавить();
		новстрокаДополнительныеСтатусы.ВидСтатуса = "дополнительный статус";
		новстрокаДополнительныеСтатусы.Значение = СокрЛП(строкаДополнительныеСтатусы);
	КонецЕсли;
	
	СлужебныеСтатусы = ЗаполнитьТаблицуВыбораСлужебныхСтатусовКлиента();
	Если ЗначениеЗаполнено(СокрЛП(СлужебныеСтатусы)) Тогда
		новСтрокаСлужебныеСтатусы = СтатусыКлиента.Добавить();
		новСтрокаСлужебныеСтатусы.ВидСтатуса = "служебный статус";
		новСтрокаСлужебныеСтатусы.Значение = СокрЛП(СлужебныеСтатусы);
	КонецЕсли;
	
	КомплаенсСтатусы = ПроверитьПоПеречням();
	Если ЗначениеЗаполнено(СокрЛП(КомплаенсСтатусы)) Тогда 
		новСтрокаСлужебныеСтатусы = СтатусыКлиента.Добавить();
		новСтрокаСлужебныеСтатусы.ВидСтатуса = "комплаенс статус";
		новСтрокаСлужебныеСтатусы.Значение = СокрЛП(КомплаенсСтатусы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗалогодательПриИзменении(Элемент)
	
	//УстановитьКонтрагентаПоЗалогодателю();
	
	//УстановитьПараметрыВыбораЗалоговогоБилета();
	//УстановитьОтборПоЗалогодателю();
	//ОбновитьРеквизитыЗалогодателя();
	//
	//ОбновитьРеквизитыСтатистикиЗаймов();
	//
	//ОбновитьВыбранныеЗалоговыеБилеты();
	//УстановитьНачальныеЗначенияРеквизитовЗадолженности();
	//УстановитьДанныеЗаголовкаЗадолженностиНаДату();
	//
	
	//получаем Статус клиента
	Если ЗначениеЗаполнено(Объект.Залогодатель) Тогда
		ЗаполнитьСтатусыКлиентаСервер();
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Залогодатель) Тогда 
		Объект.ЗалоговыйБилет = Неопределено;
	КонецЕсли;     
	ВывестиБилетыСОтбором();
	
    // ++ Сербаев 28.06.2023
	Если Элементы.Билеты.ТекущиеДанные = Неопределено Тогда
		Если Билеты.Количество() > 0 Тогда
		    Элементы.Билеты.ТекущаяСтрока = Билеты.Получить(0).ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
    // -- Сербаев 28.06.2023
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры  

&НаСервере
Процедура ВывестиБилетыСОтбором()
	Если Не ЗначениеЗаполнено(Объект.Залогодатель) и Не ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда
		Билеты.Очистить();
		ОперацииЗБ.Очистить();
		Возврат;
	КонецЕсли;
	
	
    // ++ Сербаев 27.06.2023 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОперацияПоЗалогу.Ссылка КАК ОперацияПоЗалогу,
	               |	ЛБ_ОперацияПоЗалогу.НомерЗалоговогоБилета КАК Номер,
	               |	ЛБ_ОперацияПоЗалогу.СуммаСсуды КАК СуммаЗайма,
	               |	ВложенныйЗапрос.СтатусЗалоговогоБилета КАК Статус,
					|	ЛБ_ОперацияПоЗалогу.СхемаКредитования КАК СхемаКредитования0,
					|	ЛБ_ОперацияПоЗалогу.СрокЗалога КАК СрокЗалога,
					|	ВЫБОР
					|		КОГДА ЛБ_ОперацияПоЗалогу.СхемаКредитования.ПризнакПримененияГибкогоПроцента = ИСТИНА
					|			ТОГДА ЛБ_ОперацияПоЗалогу.СхемаКредитования.НаименованиеКраткое
					|		ИНАЧЕ ""Фиксир-я""
					|	КОНЕЦ КАК СхемаКредитования,
					|	РАЗНОСТЬДАТ(ЛБ_ОперацияПоЗалогу.Дата, &ТекДата, ДЕНЬ) КАК СрокЗаймаТекущий,
					|	ЛБ_ОперацияПоЗалогу.Дата КАК ДатаПриема,
					|	ВложенныйЗапрос.ДатаВыкупа КАК СрокВозврата,
					|	ВложенныйЗапрос.ДатаВыкупаЛьготныйСрок КАК СрокЛьготный,
	               |	ЛБ_ОперацияПоЗалогу.Ломбард.НомерЛомбарда КАК НомерЛомбарда
	               |ИЗ
	               |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |			ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
					|			ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
					|			ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок
	               |		ИЗ
	               |			РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних) КАК ВложенныйЗапрос
	               |		ПО ЛБ_ОперацияПоЗалогу.Ссылка = ВложенныйЗапрос.ЗалоговыйБилет
	               |ГДЕ
	               |	ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
	               |	И 100 = 100
	               |	И 200 = 200
	               |	И 300 = 300
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	               |	ЛБ_ДоверенностиСрезПоследних.ЗалоговыйБилет КАК ОперацияПоЗалогу,
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность.СрокДействияДоверенности КАК СрокДействия,
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			,
	               |			Доверенность.СрокДействияДоверенности >= &ТекДата
	               |				И 111 = 111
	               |				И 222 = 222) КАК ЛБ_ДоверенностиСрезПоследних"; 
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	ВЫРАЗИТЬ(ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Регистратор КАК Документ.ЛБ_ОперацияПоЗалогу).Ссылка КАК ОперацияПоЗалогу,
	//	|	ВЫРАЗИТЬ(ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Регистратор КАК Документ.ЛБ_ОперацияПоЗалогу).НомерЗалоговогоБилета КАК Номер,
	//	|	ВЫРАЗИТЬ(ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Регистратор КАК Документ.ЛБ_ОперацияПоЗалогу).СуммаСсуды КАК СуммаЗайма,
	//	|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК Статус
	//	|ИЗ
	//	|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(
	//	|			&ТекДата,
	//	|			ЗалоговыйБилет.ВидОперации = &ВидОперации
	//	|				И 100 = 100
	//	|				И 200 = 200) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	//	|;
	//	|
	//	|////////////////////////////////////////////////////////////////////////////////
	//	|ВЫБРАТЬ
	//	|	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	//	|	ЛБ_ДоверенностиСрезПоследних.ЗалоговыйБилет КАК ОперацияПоЗалогу,
	//	|	ЛБ_ДоверенностиСрезПоследних.Доверенность.СрокДействияДоверенности КАК СрокДействия,
	//	|	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
	//	|ИЗ
	//	|	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	//	|			&ТекДата,
	//	|			Доверенность.СрокДействияДоверенности >= &ТекДата
	//	|				И 111 = 111
	//	|				И 222 = 222) КАК ЛБ_ДоверенностиСрезПоследних";
	
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог);
	// -- Сербаев 27.06.2023
	
	//+++ Моисеев 20250610
	Если текОтборЗБ = "Все" Тогда
		//нечего добавить
	ИначеЕсли текОтборЗБ = "Действующие" Тогда
		//при нажатии кнопки «Все действующие» - билеты в статусах «Принят», «Перезалог» и «Вкл. в накл.»
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "300 = 300", "ВложенныйЗапрос.СтатусЗалоговогоБилета В(&СтатусЗалоговогоБилетаДействует)");
		СписокСтатусовДействует = Новый СписокЗначений();
		СписокСтатусовДействует.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Оформлен);	//принят
		СписокСтатусовДействует.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен);	//перезалог
		СписокСтатусовДействует.Добавить(Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную);
		Запрос.УстановитьПараметр("СтатусЗалоговогоБилетаДействует", СписокСтатусовДействует);
	ИначеЕсли текОтборЗБ = "ВЛомбарде" Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "300 = 300", "ЛБ_ОперацияПоЗалогу.Ломбард = &Ломбард");
		Попытка
			//ПараметрыСеанса.ТекущийЛомбард инициализируется пр входе под пользователем ломбард ##...
			Запрос.УстановитьПараметр("Ломбард", ПараметрыСеанса.ТекущийЛомбард);
		Исключение
			Запрос.УстановитьПараметр("Ломбард", Справочники.ЛБ_Ломбарды.ПустаяСсылка());
		КонецПопытки;
	КонецЕсли;
	//--- Моисеев 20250610
	
	Если ЗначениеЗаполнено(Объект.Залогодатель) Тогда
		//Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", " ЛБ_ОперацияПоЗалогу.Залогодатель = &Залогодатель");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", " Залогодатель = &Залогодатель");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", " ЗалоговыйБилет.Залогодатель = &Залогодатель");
		Запрос.УстановитьПараметр("Залогодатель", Объект.Залогодатель);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет)
		И текОтборЗБ = "Один"	//+++ Моисеев 20250611
		Тогда 
		//Запрос.Текст = СтрЗаменить(Запрос.Текст, "200 = 200", " ЛБ_ОперацияПоЗалогу.НомерЗалоговогоБилета = &Номер");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "200 = 200", " НомерЗалоговогоБилета = &Номер");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "222 = 222", " ЗалоговыйБилет.НомерЗалоговогоБилета = &Номер");

		Запрос.УстановитьПараметр("Номер", Объект.ЗалоговыйБилет);
	КонецЕсли; 
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	Результат = Запрос.ВыполнитьПакет();
	
	тз = Результат[0].Выгрузить(); 	
	тзДоверкиРез = Результат[1].Выгрузить();
	
	ПараметрыОтбора = Новый Структура("СтатусДоверенности",Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена);
	тзДоверки = тзДоверкиРез.Скопировать(ПараметрыОтбора); 
	
	тз.Колонки.Добавить("Доверенность", Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("ВидСрокЗайма", Новый ОписаниеТипов("Строка"));
	
	Для каждого стр из тз Цикл
		печДоверка = "";
		Если ЗначениеЗаполнено(стр.ОперацияПоЗалогу.ПредыдущаяОперация) Тогда
			НайдСтроки = тзДоверки.НайтиСтроки(Новый Структура("ОперацияПоЗалогу", стр.ОперацияПоЗалогу.ПредыдущаяОперация));	
		Иначе
			НайдСтроки = тзДоверки.НайтиСтроки(Новый Структура("ОперацияПоЗалогу", стр.ОперацияПоЗалогу));
		КонецЕсли;
		Для каждого строчка из НайдСтроки Цикл
			печДоверка = печДоверка + "Доверенность до " + Формат(строчка.СрокДействия,"ДФ=dd.MM.yyyy")+"; ";
		КонецЦикла;
		
		печДоверка = Лев(печДоверка, СтрДлина(печДоверка)-2);
		
		стр.Доверенность = печДоверка;
		
		Если ЗначениеЗаполнено(стр.СхемаКредитования0) Тогда
			стрНаименованиеСхемы = стр.СхемаКредитования0.Наименование;
			позКонецНазвания = СтрНайти(стрНаименованиеСхемы, "(");
			Если позКонецНазвания = 0 Тогда
				позКонецНазвания = СтрНайти(стрНаименованиеСхемы, " ");
			КонецЕсли;
			Если позКонецНазвания > 0 Тогда 
				стрНаименованиеСхемы = Лев(стрНаименованиеСхемы, позКонецНазвания-1);
			КонецЕсли;
			стрНаименованиеСхемы = стрНаименованиеСхемы + "/" + стр.СрокЗалога;
			стр.ВидСрокЗайма = стрНаименованиеСхемы;
		 КонецЕсли;
	КонецЦикла;
	
	Билеты.Загрузить(тз); 
	
	Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) И Не ЗначениеЗаполнено(Объект.Залогодатель) Тогда
		Если тз.Количество() > 0 Тогда
			Объект.Залогодатель	= тз[0].ОперацияПоЗалогу.Залогодатель;
		КонецЕсли;
	КонецЕсли;

	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОперацияПоЗалогу.Ссылка КАК ОперацияПоЗалогу,
	               |	ЛБ_ОперацияПоЗалогу.НомерЗалоговогоБилета КАК ЗалоговыйБилет,
	               |	ЛБ_ОперацияПоЗалогу.Номер КАК Номер,
	               |	ЛБ_ОперацияПоЗалогу.Дата КАК Дата,
	               |	ЛБ_ОперацияПоЗалогу.ВидОперации КАК ВидОперации,
				   |	ВЫБОР
	               |		КОГДА ЛБ_ОперацияПоЗалогу.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог)
	               |			ТОГДА ЛБ_ОперацияПоЗалогу.СуммаСсуды
	               |		ИНАЧЕ ЛБ_ОперацияПоЗалогу.СуммаОплаты
	               |	КОНЕЦ КАК Сумма
	               |ИЗ
	               |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	               |ГДЕ ИСТИНА
				   |	И 100 = 100
	               |	И 200 = 200
	              // |	ЛБ_ОперацияПоЗалогу.Залогодатель = &Залогодатель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";  
	
	Если ЗначениеЗаполнено(Объект.Залогодатель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", " ЛБ_ОперацияПоЗалогу.Залогодатель = &Залогодатель");
		Запрос.УстановитьПараметр("Залогодатель", Объект.Залогодатель);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "200 = 200", " ЛБ_ОперацияПоЗалогу.НомерЗалоговогоБилета = &Номер");
		Запрос.УстановитьПараметр("Номер", Объект.ЗалоговыйБилет);
	КонецЕсли; 
	
	тз = Запрос.Выполнить().Выгрузить();  
	ОперацииЗБ.Загрузить(тз); 
	
КонецПроцедуры

