&НаСервере
Процедура ЗаполнитьДанныеКлиента()
	ЭтотОбъект.ДанныеКлиента.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка,
	               |	ЛБ_ОперацияПоЗалогу.Дата КАК Дата,
	               |	ЛБ_ОперацияПоЗалогу.ВидОперации КАК ВидОперации,
	               |	ЛБ_ОперацияПоЗалогу.Ломбард КАК Ломбард,
	               |	ЛБ_ОперацияПоЗалогу.Ломбард.НомерЛомбарда КАК НомерЛомбарда,
	               |	ЛБ_ОперацияПоЗалогу.Проведен КАК Проведен
	               |ПОМЕСТИТЬ ВТ_ПоследняяОперация
	               |ИЗ
	               |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	               |ГДЕ
	               |	ЛБ_ОперацияПоЗалогу.Проведен = ИСТИНА
	               |	И ЛБ_ОперацияПоЗалогу.Залогодатель = &Залогодатель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель КАК СсылкаЗалогодатель,
	               |	ВТ_ПоследняяОперация.Дата КАК ПоследнееОбращениеКлиентаДата,
	               |	ВТ_ПоследняяОперация.ВидОперации КАК ПоследнееОбращениеКлиентаВидОперации,
	               |	ВТ_ПоследняяОперация.НомерЛомбарда КАК ПоследнееОбращениеКлиентаНомерЛомбарда,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресРегистрации,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ВЫБОР
	               |		КОГДА ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА -1
	               |		КОГДА МЕСЯЦ(&ДатаДокумента) < МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД) - 1
	               |		КОГДА МЕСЯЦ(&ДатаДокумента) > МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД)
	               |		КОГДА МЕСЯЦ(&ДатаДокумента) = МЕСЯЦ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ДЕНЬ(&ДатаДокумента) < ДЕНЬ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |						ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД) - 1
	               |					КОГДА ДЕНЬ(&ДатаДокумента) >= ДЕНЬ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения)
	               |						ТОГДА РАЗНОСТЬДАТ(ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения, &ДатаДокумента, ГОД)
	               |				КОНЕЦ
	               |	КОНЕЦ КАК Возраст,
	               |	ЛБ_ДокументыЗалогодателей.ВидДокумента КАК ДокументВид,
	               |	ЛБ_ДокументыЗалогодателей.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателей.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателей.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателей.ДокументДатаВыдачи КАК ДокументДатаВыдачи
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ДокументыЗалогодателей КАК ЛБ_ДокументыЗалогодателей
	               |		ПО ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Залогодатель = ЛБ_ДокументыЗалогодателей.ДокументЗалогодателя.Владелец
				   |			И НЕ ЛБ_ДокументыЗалогодателей.ДокументНеДействителен = Истина
				   
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоследняяОперация КАК ВТ_ПоследняяОперация
	               |		ПО (ИСТИНА)";
	Запрос.УстановитьПараметр("Залогодатель", Объект.Залогодатель);
	Запрос.УстановитьПараметр("ДатаДокумента", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Парам = Новый Структура("Серия, Номер", СокрЛП(Выборка.ДокументСерия), СокрЛП(Выборка.ДокументНомер));
		Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
			Продолжить;//Стр.ПроверкаНеДействителен = Истина;
		КонецЕсли;	
		новДанныеКлиента = ЭтотОбъект.ДанныеКлиента.Добавить();
		ЗаполнитьЗначенияСвойств(новДанныеКлиента, Выборка);
