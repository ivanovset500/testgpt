&НаКлиенте
Процедура УстановитьПараметрыЗалоговыхБилетов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		ЗалоговыеБилеты,
		"ВыбранныеЗалоговыеБилеты",
		ВыбранныеЗалоговыеБилеты
	);	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриАктивизацииСтрокиЗалоговыхБилетов()

	ТекДанные = Элементы.ЗалоговыеБилеты.ТекущиеДанные;
	ТекЗалоговыйБилет = ?(
		ТекДанные <> Неопределено И ТекДанные.Свойство("ЗалоговыйБилет"), 
		ТекДанные.ЗалоговыйБилет, 
		Неопределено
	);
	УстановитьОтборПоЗалоговомуБилету(ТекЗалоговыйБилет, "Операции");

	Если ВыбранныеЗалоговыеБилеты.Количество() = 0 Тогда 
		УстановитьНачальныеЗначенияРеквизитовЗадолженности();
	КонецЕсли;
	
	УстановитьДанныеЗаголовкаЗадолженностиНаДату();

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УстановитьДоступностьКоманд()
	
	ТекДанные = Элементы.ЗалоговыеБилеты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Или СписокСостоянийИсключений.НайтиПоЗначению(ТекДанные.Состояние) <> Неопределено Тогда
		СостояниеЗБ = Ложь;
	Иначе 
		СостояниеЗБ = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьВозвратЗайма",
		"Доступность",
		СостояниеЗБ
	);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьПерезалог",
		"Доступность",
		СостояниеЗБ
	);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьБыстрыйЧастичныйПерезалог",
		"Доступность",
		СостояниеЗБ
	);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьПриемНаХранение",
		"Доступность",
		СостояниеЗБ
	);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьВозвратСХранения",
		"Доступность",
		СостояниеЗБ
	);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьДоверенность",
		"Доступность",
		СостояниеЗБ
	);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоздатьАннулированиеДоверенности",
		"Доступность",
		СостояниеЗБ
	);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоЗалогодателю()
	
	ВидСравненияКомпановки = ВидСравненияКомпоновкиДанных.Равно;
	Если Не ЗначениеЗаполнено(Объект.Залогодатель) Тогда 
		ВидСравненияКомпановки = ВидСравненияКомпоновкиДанных.НеРавно;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		ЗалоговыеБилеты,
		"Залогодатель",
		Объект.Залогодатель,
		ВидСравненияКомпановки,
		,
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный
	);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоЗалоговомуБилету(ТекущийЗалоговыйБилет, ИмяДинамическогоСписка)
	
	УстанавливатьОтбор = (ТекущийЗалоговыйБилет <> ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка"));
	
	Если ИмяДинамическогоСписка = "ЗалоговыеБилеты" Тогда 
		
		//ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(
		//	ЭтотОбъект[ИмяДинамическогоСписка],
		//	"ЗалоговыйБилет",
		//	ТекущийЗалоговыйБилет, 
		//	УстанавливатьОтбор, 
		//	ВидСравненияКомпоновкиДанных.Равно
		//);
		
	Иначе
		
		// "Операции"
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Операции,
			"ОтборПоЗалоговомуБилету",
			УстанавливатьОтбор
		);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Операции,
			"ЗалоговыйБилет",
			ТекущийЗалоговыйБилет
		);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Операции,
			"ДокументыПоЗалоговомуБилету",
			?(УстанавливатьОтбор, ДокументыЖурналаПоЗалоговомуБилетуВТабличнойЧасти(ТекущийЗалоговыйБилет), Неопределено)
		);
		
	КонецЕсли;
	
КонецПроцедуры

