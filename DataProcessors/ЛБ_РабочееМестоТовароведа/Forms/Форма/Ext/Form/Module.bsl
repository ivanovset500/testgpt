&НаСервереБезКонтекста
Функция ПолучитьКонтрагентаЗалогодателяПоДоговору(Договор)
	
	КонтрагентЗалогодатель = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Залогодатель", Истина);
	
	СтруктураКонтрагентЗалогодатель = Новый Структура("Залогодатель", КонтрагентЗалогодатель.Залогодатель);
	
	Возврат СтруктураКонтрагентЗалогодатель;
	
КонецФункции

&НаСервере
Функция ПолучитьТекущиеЗалоговыеБилеты()
	
	Схема 		= Элементы.ЗалоговыеБилеты.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки 	= Элементы.ЗалоговыеБилеты.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		Настройки.Отбор, 
		"Состояние", 
		ВидСравненияКомпоновкиДанных.НеВСписке,
		СписокСостоянийИсключений,, 
		Истина
	);
	
	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(Схема, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТаблицаЗалоговыхБилетов = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ТаблицаЗалоговыхБилетов.ВыгрузитьКолонку("ЗалоговыйБилет"));
	
	Возврат Список;
	
КонецФункции

// Обновить выбранные залоговые билеты в соответствии с установленными отборами
//
&НаКлиенте
Процедура ОбновитьВыбранныеЗалоговыеБилеты()
	
	кол = ВыбранныеЗалоговыеБилеты.Количество() - 1;
	Если кол < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеЗБ = ПолучитьТекущиеЗалоговыеБилеты();
	
	Если ТекущиеЗБ.Количество() = 0 Тогда
		ВыбранныеЗалоговыеБилеты.Очистить();
	Иначе
		Пока кол >= 0 Цикл
			Если ТекущиеЗБ.НайтиПоЗначению(ВыбранныеЗалоговыеБилеты[кол].Значение) = Неопределено Тогда
				ВыбранныеЗалоговыеБилеты.Удалить(кол);
			КонецЕсли;
			кол = кол - 1;
		КонецЦикла;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		ЗалоговыеБилеты,
		"ВыбранныеЗалоговыеБилеты",
		ВыбранныеЗалоговыеБилеты
	);
	
КонецПроцедуры

