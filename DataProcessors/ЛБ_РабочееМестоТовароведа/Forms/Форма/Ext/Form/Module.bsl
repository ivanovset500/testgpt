&НаСервере
Функция ПолучитьЗБ(Идентификатор, ТЧ) 
	Стр = ЭтотОбъект[ТЧ].НайтиПоИдентификатору(Идентификатор); 
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ЗБ", Стр.ОперацияПоЗалогу);
	СтруктураВ.Вставить("Залогодатель", Стр.ОперацияПоЗалогу.Залогодатель);
	Возврат СтруктураВ;
КонецФункции	

