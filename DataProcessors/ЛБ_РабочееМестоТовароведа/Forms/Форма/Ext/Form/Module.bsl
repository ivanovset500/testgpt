Функция ПроверитьСтатусКлиентаВИП(Дата, Залогодатель)
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор КАК Регистратор,
	|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Регистратор.Комментарий КАК Комментарий,
	|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок КАК ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок
	|ГДЕ
	|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Залогодатель = &Залогодатель
	|	И ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.ДатаНачалаДействия <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_ИндивидуальнаяНастройкаПрейскурантаПроцентныхСтавок.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор КАК Регистратор,
	|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор.Комментарий КАК Комментарий,
	|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога КАК ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога
	|ГДЕ
	|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Залогодатель = &Залогодатель
	|	И ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.ДатаНачалаДействия <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор КАК Регистратор,
	|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор.Комментарий КАК Комментарий,
	|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок КАК ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок
	|ГДЕ
	|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Залогодатель = &Залогодатель
	|	И ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.ДатаНачалаДействия <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Период УБЫВ";

	Пакеты = Запрос.ВыполнитьПакет();
	
	ИспользуютсяСтавки = Ложь;
	ИспользуютсяМаталлы = Ложь;
	ИспользуютсяВставки = Ложь;
	Используется = Ложь;
	СрокДействия = Дата(1,1,1);
	Комментарий = "";

	Ставки = Пакеты[0].Выбрать();
	Металлы = Пакеты[1].Выбрать();
	Вставки = Пакеты[2].Выбрать();

	Если Ставки.Следующий() Тогда
		Если Ставки.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
			Если Ставки.ДатаОкончанияДействия >= Дата ИЛИ Ставки.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ИспользуютсяСтавки = Ложь;
			КонецЕсли;	
		Иначе
			Если Ставки.ДатаОкончанияДействия >= Дата ИЛИ Ставки.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ИспользуютсяСтавки = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если Металлы.Следующий() Тогда
		Если Металлы.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
			Если Металлы.ДатаОкончанияДействия >= Дата ИЛИ Металлы.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ИспользуютсяМаталлы = Ложь;
			КонецЕсли;	
		Иначе
			Если Металлы.ДатаОкончанияДействия >= Дата ИЛИ Металлы.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ИспользуютсяМаталлы = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если Вставки.Следующий() Тогда
		Если Вставки.Регистратор.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
			Если Вставки.ДатаОкончанияДействия >= Дата ИЛИ Вставки.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ИспользуютсяВставки = Ложь;
			КонецЕсли;	
		Иначе
			Если Вставки.ДатаОкончанияДействия >= Дата ИЛИ Вставки.ДатаОкончанияДействия = Дата(1,1,1) Тогда
				ИспользуютсяВставки = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользуютсяСтавки ИЛИ ИспользуютсяМаталлы ИЛИ ИспользуютсяВставки Тогда
		Используется = Истина;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Используется", Используется);
	СтруктураВозврата.Вставить("СрокДействия", СрокДействия);
	СтруктураВозврата.Вставить("Комментарий", Комментарий);
	
	Возврат СтруктураВозврата;
	
КонецФункции

