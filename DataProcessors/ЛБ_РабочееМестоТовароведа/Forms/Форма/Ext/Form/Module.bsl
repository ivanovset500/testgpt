	СтрокаНачальныхЗначений = ПолучитьСтрокуНачальногоЗначенияЗадолженности();
	
	ЗадолженностьНаДатуОсновнойДолг = СтрокаНачальныхЗначений;
	ЗадолженностьНаДатуНачисления 	= СтрокаНачальныхЗначений;
