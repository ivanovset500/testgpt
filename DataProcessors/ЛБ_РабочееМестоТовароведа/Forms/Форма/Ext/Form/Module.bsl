Функция КоличествоПредметовПоДоговору(Договор, Организация, Контрагент = Неопределено) Экспорт	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АКСЛМБУчетПредоставленныхЗаймовОстатки.ПредметЗалога КАК ПредметЗалога
		|ИЗ
		|	РегистрНакопления.АКСЛМБУчетПредоставленныхЗаймов.Остатки(
		|			,
		|			Договор = &Договор
		|				И Организация = &Организация
		|				И Контрагент = &Контрагент) КАК АКСЛМБУчетПредоставленныхЗаймовОстатки";
	
	Запрос.УстановитьПараметр("Договор", 	Договор);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	Если Не Контрагент = Неопределено Тогда 	
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Иначе
		Запрос.УстановитьПараметр("Контрагент", Договор.Владелец);
	КонецЕсли;
			
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат ВыборкаДетальныеЗаписи.Количество(); 

КонецФункции

