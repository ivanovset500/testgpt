&НаСервереБезКонтекста
Функция ДанныеВыбора(ПараметрыПолученияДанных)
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ДокументыФизическихЛиц) Тогда 
		Возврат Справочники.ФизическиеЛица.ПолучитьДанныеВыбора(ПараметрыПолученияДанных);
	КонецЕсли;
	
	СтрокаПоиска = СокрЛП(ПараметрыПолученияДанных.СтрокаПоиска);
	
	ПозицияНомера 			= СтрНайти(СтрокаПоиска, "№");
	СтрокаЗаданаФорматно 	= ПозицияНомера > 0;
	
	Запрос = Новый Запрос;
	
	Если СтрокаЗаданаФорматно Тогда 
		
		СтрокаСерия = СокрЛП(Лев(СтрокаПоиска, ПозицияНомера - 1));
		СтрокаНомер = СокрЛП(Сред(СтрокаПоиска, ПозицияНомера + 1));
		
		ОтбиратьПоСерии 	= Не ПустаяСтрока(СтрокаСерия);
		ОтбиратьПоНомеру 	= Не ПустаяСтрока(СтрокаНомер);
		
		Если Не ОтбиратьПоСерии И Не ОтбиратьПоНомеру Тогда 
			Возврат Справочники.ФизическиеЛица.ПолучитьДанныеВыбора(ПараметрыПолученияДанных);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("СтрокаСерия", 		"%" + СтрокаСерия + "%");
		Запрос.УстановитьПараметр("СтрокаНомер", 		"%" + СтрокаНомер + "%");
		Запрос.УстановитьПараметр("ОтбиратьПоСерии", 	ОтбиратьПоСерии);
		Запрос.УстановитьПараметр("ОтбиратьПоНомеру", 	ОтбиратьПоНомеру);
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
		|	ДокументыФизическихЛицСрезПоследних.Физлицо КАК Ссылка,
		|	ДокументыФизическихЛицСрезПоследних.Физлицо.Представление КАК СсылкаПредставление,
		|	ДокументыФизическихЛицСрезПоследних.Представление КАК ДокументПредставление
		|ИЗ
		|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтбиратьПоСерии
		|				ТОГДА ДокументыФизическихЛицСрезПоследних.Серия ПОДОБНО &СтрокаСерия
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ОтбиратьПоНомеру
		|				ТОГДА ДокументыФизическихЛицСрезПоследних.Номер ПОДОБНО &СтрокаНомер
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
			
		
	Иначе
		
		// задана либо серия, либо номер
		
		Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
		|	ДокументыФизическихЛицСрезПоследних.Физлицо КАК Ссылка,
		|	ДокументыФизическихЛицСрезПоследних.Физлицо.Представление КАК СсылкаПредставление,
		|	ДокументыФизическихЛицСрезПоследних.Представление КАК ДокументПредставление
		|ИЗ
		|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|ГДЕ
		|	ДокументыФизическихЛицСрезПоследних.Серия ПОДОБНО &СтрокаПоиска
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 50
		|	ДокументыФизическихЛицСрезПоследних.Физлицо,
		|	ДокументыФизическихЛицСрезПоследних.Физлицо.Представление,
		|	ДокументыФизическихЛицСрезПоследних.Представление
		|ИЗ
		|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|ГДЕ
		|	ДокументыФизическихЛицСрезПоследних.Номер ПОДОБНО &СтрокаПоиска";
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	ШрифтКоманды   = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста);
	ШрифтПодстроки = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина);
	ЦветПодстроки  = ЦветаСтиля.ЦветУспешногоПоиска;
	
	Список = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаПодбора = Выборка.ДокументПредставление + " (" + Выборка.СсылкаПредставление + ")";
		
		Если СтрокаЗаданаФорматно Тогда 
			
			ПозицияСерии 	= СтрНайти(СтрокаПодбора, СтрокаСерия);
			ПозицияНомера 	= СтрНайти(СтрокаПодбора, СтрокаНомер);
			
			Если ОтбиратьПоСерии И Не ОтбиратьПоНомеру Тогда 
				// только по серии
				МассивСтрокПоиска = Новый Массив;
				МассивСтрокПоиска.Добавить(СтрокаСерия);
				Представление = ПредставлениеДанныхВыбора(СтрокаПодбора, МассивСтрокПоиска, ЦветПодстроки, ШрифтКоманды, ШрифтПодстроки);
				
			ИначеЕсли Не ОтбиратьПоСерии И ОтбиратьПоНомеру Тогда 
				// только по номеру
				МассивСтрокПоиска = Новый Массив;
				МассивСтрокПоиска.Добавить(СтрокаНомер);
				НачальнаяПозицияПоиска = СтрНайти(СтрокаПодбора, "№");
				Представление = ПредставлениеДанныхВыбора(СтрокаПодбора, МассивСтрокПоиска, ЦветПодстроки, ШрифтКоманды, ШрифтПодстроки, НачальнаяПозицияПоиска);
				
			Иначе
				// и по номеру, и по серии
				МассивСтрокПоиска = Новый Массив;
				МассивСтрокПоиска.Добавить(СтрокаСерия);
				МассивСтрокПоиска.Добавить(СтрокаНомер);
				Представление = ПредставлениеДанныхВыбора(СтрокаПодбора, МассивСтрокПоиска, ЦветПодстроки, ШрифтКоманды, ШрифтПодстроки);
				
			КонецЕсли;
			
		Иначе
			
			МассивСтрокПоиска = Новый Массив;
			МассивСтрокПоиска.Добавить(СтрокаПоиска);
			Представление = ПредставлениеДанныхВыбора(СтрокаПодбора, МассивСтрокПоиска, ЦветПодстроки, ШрифтКоманды, ШрифтПодстроки);
			
		КонецЕсли;
		
		Список.Добавить(Выборка.Ссылка, Представление);
		
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеДанныхВыбора(Знач СтрокаПодбора, Знач МассивСтрокПоиска, Знач ЦветПодстроки, Знач ШрифтКоманды, Знач ШрифтПодстроки, Знач НачальнаяПозицияПоиска = 1)
	
	// Список, где значение - позиция искомой строки, представление - сама строка поиска
	СписокСтрокПоиска = Новый СписокЗначений;
	Для к = 0 По МассивСтрокПоиска.ВГраница() Цикл
		СписокСтрокПоиска.Добавить(СтрНайти(СтрокаПодбора, МассивСтрокПоиска[к],, НачальнаяПозицияПоиска), МассивСтрокПоиска[к]);
	КонецЦикла;
	
	СписокСтрокПоиска.СортироватьПоЗначению();
	
	МассивФорматированныхСтрок = Новый Массив;
	
	ТекСтрокаПодбора = СтрокаПодбора;
	
	Для к = 0 По СписокСтрокПоиска.Количество() - 1 Цикл
		
		СтрокаПоиска = СписокСтрокПоиска[к].Представление;
		
		ПозицияСтрокиПоиска = СтрНайти(ТекСтрокаПодбора, СтрокаПоиска,, ?(к = 0, НачальнаяПозицияПоиска, 1));
		
		Если ПозицияСтрокиПоиска > 1 Тогда
			
			ПодобраннаяСтрока1 = Лев(ТекСтрокаПодбора, ПозицияСтрокиПоиска - 1);
			
			МассивФорматированныхСтрок.Добавить(Новый ФорматированнаяСтрока(ПодобраннаяСтрока1, ШрифтКоманды));
			МассивФорматированныхСтрок.Добавить(Новый ФорматированнаяСтрока(СтрокаПоиска, ШрифтПодстроки, ЦветПодстроки));
			
		Иначе
			
			МассивФорматированныхСтрок.Добавить(Новый ФорматированнаяСтрока(СтрокаПоиска, ШрифтКоманды, ЦветПодстроки));
			
		КонецЕсли;
		
		// сдвигаем текущую строку поиска
		ТекСтрокаПодбора = Сред(ТекСтрокаПодбора, ПозицияСтрокиПоиска + СтрДлина(СтрокаПоиска));
	
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекСтрокаПодбора) Тогда 
		МассивФорматированныхСтрок.Добавить(Новый ФорматированнаяСтрока(ТекСтрокаПодбора, ШрифтКоманды));
	КонецЕсли;
	
	Представление = Новый ФорматированнаяСтрока(МассивФорматированныхСтрок);
	
	Возврат Представление;

КонецФункции

#КонецОбласти

#Область РаботаСНастройками

&НаСервере
Процедура ЗагрузитьНастройкиНаСервере()
	
	Объект.Организация = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"ЛБ_РабочееМестоТовароведа",
		"Организация",
		БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация")
	);
	
	Если ВестиУчетПоПодразделениям Тогда 
		Объект.Подразделение = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"ЛБ_РабочееМестоТовароведа",
			"Подразделение",
			БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации")
		);
	КонецЕсли;	
		
	Объект.Склад = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"ЛБ_РабочееМестоТовароведа",
		"Склад",
		Справочники.Склады.ПолучитьСкладПоУмолчанию()
	);
	
	ЗагрузитьНастройкуВидыДоговоровЗаймаХранения();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкуВидыДоговоровЗаймаХранения()
	
	СписокВидовДоговоровПоУмолчанию = Новый СписокЗначений;
	
	ФО_УчетЗаймов = ПолучитьФункциональнуюОпцию("АКСЛМБВестиУчетЗаймов");
	Если ФО_УчетЗаймов Тогда
		СписокВидовДоговоровПоУмолчанию.Добавить(Перечисления.АКСЛМБВидыДоговоров.Займ);
	КонецЕсли;
	
	ФО_УчетХранения = ПолучитьФункциональнуюОпцию("АКСЛМБВестиУчетИмуществаНаХранении");
	Если ФО_УчетХранения Тогда
		СписокВидовДоговоровПоУмолчанию.Добавить(Перечисления.АКСЛМБВидыДоговоров.Хранение);
	КонецЕсли;
	
	Объект.ВидыДоговоровЗаймаХранения = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"ЛБ_РабочееМестоТовароведа",
		"ВидыДоговоровЗаймаХранения",
		СписокВидовДоговоровПоУмолчанию
	);
	
	ЭлементЗайм = Объект.ВидыДоговоровЗаймаХранения.НайтиПоЗначению(Перечисления.АКСЛМБВидыДоговоров.Займ);
	Если ФО_УчетЗаймов Тогда
		Если Не ФО_УчетХранения И ЭлементЗайм = Неопределено Тогда
			Объект.ВидыДоговоровЗаймаХранения.Добавить(Перечисления.АКСЛМБВидыДоговоров.Займ);
			НастройкиИзменились = Истина;
		КонецЕсли;
	Иначе
		Если ЭлементЗайм <> Неопределено Тогда
			Объект.ВидыДоговоровЗаймаХранения.Удалить(ЭлементЗайм);
			НастройкиИзменились = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементХранение = Объект.ВидыДоговоровЗаймаХранения.НайтиПоЗначению(Перечисления.АКСЛМБВидыДоговоров.Хранение);
	Если ФО_УчетХранения Тогда 
		Если Не ФО_УчетЗаймов И ЭлементХранение = Неопределено Тогда
			Объект.ВидыДоговоровЗаймаХранения.Добавить(Перечисления.АКСЛМБВидыДоговоров.Хранение);
			НастройкиИзменились = Истина;
		КонецЕсли;
	Иначе
		Если ЭлементХранение <> Неопределено Тогда
			Объект.ВидыДоговоровЗаймаХранения.Удалить(ЭлементХранение);
			НастройкиИзменились = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ВидыДоговоровЗаймаХранения = Объект.ВидыДоговоровЗаймаХранения; // по умолчанию равны

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыНастроек(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда 
		
		ЗаполнитьЗначенияСвойств(Объект, Результат);
		
		Если Результат.Свойство("Организация") Тогда 
			УстановитьОтборПоОрганизации();
		КонецЕсли;
		
		Если Результат.Свойство("Подразделение") Тогда
			УстановитьОтборПоПодразделению();
		КонецЕсли;
		
		ОбновитьРеквизитыДенежныхСредств();
		
		УправлениеФормойНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры

