// Формирует отчет "Расчет задолженности на дату" для выбранных договоров (залоговых билетов)
//
// Параметры:
//  Договор	 - СписокЗначений, СправочникСсылка.ДоговорыКонтрагентов - договор(ы), для которых
//					необходимо открыть отчет.
//
&НаКлиенте
Процедура ОткрытьОтчетРассчитатьНаДату(Договор)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Договор", 						Договор);
	ПараметрыРасчета.Вставить("ДатаРасчета", 					ДатаРасчетаЗадолженности);
	ПараметрыРасчета.Вставить("КлючВарианта", 					"РасчетЗадолженностиНаДату");
	ПараметрыРасчета.Вставить("КлючПользовательскихНастроек", 	""); // пользовательские настройки не грузим
	
	ОткрытьФорму(
		"Отчет.АКСЛМБРасчетЗадолженностиНаДату.ФормаОбъекта", 
		ПараметрыРасчета,
		ЭтаФорма,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	ВыбранныеЗалоговыеБилеты = ПолучитьТекущиеЗалоговыеБилеты();
	
	Если Не ЗначениеЗаполнено(ВыбранныеЗалоговыеБилеты) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru = 'В списке не обнаружены действующие договоры'"),,, "ЗалоговыеБилеты");	
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		ЗалоговыеБилеты,
		"ВыбранныеЗалоговыеБилеты",
		ВыбранныеЗалоговыеБилеты
	);
	
	УстановитьНачальныеЗначенияРеквизитовЗадолженности();
	УстановитьДанныеЗаголовкаЗадолженностиНаДату();
	УстановитьДоступностьКомандыПерезалог();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ВыбранныеЗалоговыеБилеты.Очистить();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		ЗалоговыеБилеты,
		"ВыбранныеЗалоговыеБилеты",
		ВыбранныеЗалоговыеБилеты
	);
	
	УстановитьНачальныеЗначенияРеквизитовЗадолженностиНаСервере();
	УстановитьДанныеЗаголовкаЗадолженностиНаДату();
	УстановитьДоступностьКомандыПерезалог();
	
КонецПроцедуры

