&НаКлиенте
Процедура УстановитьЗаголовокФормы()
	
	ТекстЗаголовока = НСтр("ru = 'Рабочее место товароведа'");
	
	УстановленыОпцииЗаймаХранения = Истина И Ложь;
	
	Если УстановленыОпцииЗаймаХранения Тогда
		Если Элементы.ФормаРежимЗаймы.Пометка И Не Элементы.ФормаРежимХранение.Пометка Тогда
			ТекстЗаголовока = НСтр("ru = 'Рабочее место товароведа (договоры займа)'");
		ИначеЕсли Не Элементы.ФормаРежимЗаймы.Пометка И Элементы.ФормаРежимХранение.Пометка Тогда
			ТекстЗаголовока = НСтр("ru = 'Рабочее место товароведа (договоры хранения)'");
		Иначе
			// дополнительная обработка не требуется
		КонецЕсли;
	КонецЕсли;
	
	//+++ Моисеев 20250520
	текПользователь = ПолучитьТекущегоПользователяНаСервере();
	ТекстЗаголовока = СтрЗаменить(ТекстЗаголовока, "товароведа", "приемщика") + "                    " + текПользователь;
	//--- Моисеев 20250520
	Заголовок = ТекстЗаголовока;

КонецПроцедуры

