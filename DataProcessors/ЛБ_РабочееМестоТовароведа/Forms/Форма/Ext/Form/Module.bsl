&НаСервереБезКонтекста
Функция ПолучитьСтрокуНачальногоЗначенияЗадолженности()
	
	Шрифт 		= Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,, 8, Ложь);
	ЦветТекста 	= ЦветаСтиля.ЦветТекстаИнформационнойПанели;
	
	Возврат Новый ФорматированнаяСтрока("-", Шрифт, ЦветТекста);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДанныеЗаголовкаЗадолженностиНаДату()
	
	КоличествоВыбранныхЗалоговыхБилетов = ВыбранныеЗалоговыеБилеты.Количество();
	Если КоличествоВыбранныхЗалоговыхБилетов > 0 Тогда
		Если КоличествоВыбранныхЗалоговыхБилетов = 1 Тогда
			ЗадолженностьНаДатуДанныеЗаголовка = ВыбранныеЗалоговыеБилеты[0].Значение;
		Иначе
			ЗадолженностьНаДатуДанныеЗаголовка = ВыбранныеЗалоговыеБилеты.Количество();
		КонецЕсли;
	Иначе
		
		ТекДанные = Элементы.ЗалоговыеБилеты.ТекущиеДанные;
		ТекЗалоговыйБилет = Неопределено;
		Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда 
			ТекЗалоговыйБилет = Объект.ЗалоговыйБилет;
		ИначеЕсли ТекДанные <> Неопределено И ТекДанные.Свойство("ЗалоговыйБилет") Тогда
			ТекЗалоговыйБилет = ТекДанные.ЗалоговыйБилет;
		КонецЕсли;
		
		ЗадолженностьНаДатуДанныеЗаголовка = ТекЗалоговыйБилет;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗадолженностьНаДатуДатаРасчета(Дата = Неопределено)
	
	Если Дата = Неопределено Тогда 
		ДатаРасчетаЗадолженности = КонецДня(ОбщегоНазначенияКлиент.ДатаСеанса());
	Иначе
		ДатаРасчетаЗадолженности = КонецДня(Дата);
	КонецЕсли;
	
	ЗадолженностьНаДатуДатаРасчета = ПредставлениеДатыРасчета(ДатаРасчетаЗадолженности);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеДатыРасчета(Дата)
	
	Возврат Новый ФорматированнаяСтрока(
		Формат(Дата, "ДФ='dd.MM.yyyy ""г.""'"), Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,, 8), ЦветаСтиля.ГиперссылкаЦвет,, "ДатаРасчетаЗадолженности"
	);	
	
КонецФункции

