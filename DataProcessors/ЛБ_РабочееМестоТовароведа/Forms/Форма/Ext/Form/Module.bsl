Функция ЗаполнитьТаблицуВыбораСлужебныхСтатусовКлиента() 		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СлужебныеСтатусы.Ссылка КАК Статус,
				   |	ЛОЖЬ КАК Используется
	               |ИЗ
	               |	Справочник.ЛБ_СлужебныеСтатусыКлиентов КАК СлужебныеСтатусы
	               |ГДЕ
	               |	СлужебныеСтатусы.ПометкаУдаления = ЛОЖЬ
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	//ТаблицаСлужебныхСтатусов.Загрузить(ТаблицаЗапроса); 
	ТаблицаСлужебныхСтатусов = ТаблицаЗапроса.Скопировать(); 
		
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Статус КАК Статус,
                   |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется,
                   |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Комментарий КАК Комментарий
                   |ИЗ
                   |	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(
                   |			&Дата,
                   |			Залогодатель = &Залогодатель
                   |				И Статус = &Статус) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
	Для каждого Стр Из ТаблицаСлужебныхСтатусов Цикл 
		Запрос.УстановитьПараметр("Залогодатель", Объект.Залогодатель);  
	    Запрос.УстановитьПараметр("Дата", ТекущаяДата()); 
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется;
			//Стр.Комментарий = Выборка.Комментарий;
		КонецЕсли;	
	КонецЦикла;	   
	
	ИтоговаяСтрока = "";
	Для каждого стрСлужебныйСтатус Из ТаблицаСлужебныхСтатусов Цикл 
		Если стрСлужебныйСтатус.Используется Тогда 
			ИтоговаяСтрока = ИтоговаяСтрока + "," + стрСлужебныйСтатус.Статус;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(ИтоговаяСтрока) > 0 Тогда 
		ИтоговаяСтрока = Сред(ИтоговаяСтрока, 2);
	КонецЕсли;
	
	Возврат ИтоговаяСтрока;
	
КонецФункции        

