Процедура РассчитатьНаДату(Команда)
	
	Если ВыбранныеЗалоговыеБилеты.Количество() > 0 Тогда 
		
		ОткрытьОтчетРассчитатьНаДату(ВыбранныеЗалоговыеБилеты);
		
	Иначе
		
		ТекДанные = Элементы.ЗалоговыеБилеты.ТекущиеДанные;
		Если ТекДанные <> Неопределено И ТекДанные.Свойство("ЗалоговыйБилет") Тогда 
			
			ОткрытьОтчетРассчитатьНаДату(ТекДанные.ЗалоговыйБилет);

		Иначе
			
			ПоказатьПредупреждение(
				,
				НСтр("ru = 'Команда не может быть выполнена для указанного объекта.'"),
				,
				"Предупреждение"
			);		
			
		КонецЕсли;
	
	КонецЕсли;
	
