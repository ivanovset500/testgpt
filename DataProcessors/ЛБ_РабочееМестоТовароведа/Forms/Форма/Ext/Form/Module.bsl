// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЦЫ ФОРМЫ ЗалоговыеБилеты
#Область ОбработчикиСобытийЭлементовТаблицыФормыЗалоговыеБилеты

&НаКлиенте
Процедура ЗалоговыеБилетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если СписокСостоянийИсключений.НайтиПоЗначению(ТекДанные.Состояние)<> Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ЗалоговыеБилетыФлаг"
		И ТекДанные <> Неопределено 
		И ТекДанные.Свойство("ЗалоговыйБилет") Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		ТекЗалоговыйБилет = ТекДанные.ЗалоговыйБилет;
		
		ЭлементСписка = ВыбранныеЗалоговыеБилеты.НайтиПоЗначению(ТекЗалоговыйБилет);
		Если ЭлементСписка = Неопределено Тогда
			ВыбранныеЗалоговыеБилеты.Добавить(ТекЗалоговыйБилет);
		Иначе
			ВыбранныеЗалоговыеБилеты.Удалить(ЭлементСписка);
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			ЗалоговыеБилеты,
			"ВыбранныеЗалоговыеБилеты",
			ВыбранныеЗалоговыеБилеты
		);
		
		УстановитьНачальныеЗначенияРеквизитовЗадолженности();
		УстановитьДанныеЗаголовкаЗадолженностиНаДату();
		УстановитьДоступностьКомандыПерезалог();
		
	ИначеЕсли Поле.Имя = "ЗалоговыеБилетыЗалоговыйБилет"
		И ТекДанные <> Неопределено 
		И ТекДанные.Свойство("ЗалоговыйБилет") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПоказатьЗначение(, ТекДанные.ЗалоговыйБилет);		
	КонецЕсли;
	
КонецПроцедуры

