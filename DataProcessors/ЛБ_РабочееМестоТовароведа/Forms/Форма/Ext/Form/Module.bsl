&НаСервереБезКонтекста
Функция ПредставлениеСуммы(Сумма, Валюта, ОтрицательныеКрасным = Ложь, Жирный = Ложь)
	
	ФорматнаяСтрока = "ЧДЦ=2; ЧН=0";
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		СтроковоеПредставление = СтрШаблон("%1 %2", Формат(Сумма, ФорматнаяСтрока), Валюта);
	Иначе
		СтроковоеПредставление = Формат(Сумма, ФорматнаяСтрока);
	КонецЕсли;
	
	Шрифт = ?(Жирный, Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,, 8, Истина), Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,, 8, Ложь));
	Если ОтрицательныеКрасным Тогда 
		ЦветТекста = ?(Сумма >= 0, ЦветаСтиля.ЦветТекстаИнформационнойПанели, ЦветаСтиля.ВажноеСобытие);
	Иначе
		ЦветТекста = ЦветаСтиля.ЦветТекстаИнформационнойПанели;
	КонецЕсли;
	
	Возврат Новый ФорматированнаяСтрока(СтроковоеПредставление, Шрифт, ЦветТекста);
	
КонецФункции

