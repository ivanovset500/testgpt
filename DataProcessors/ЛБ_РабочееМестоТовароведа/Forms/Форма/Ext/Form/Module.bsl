&НаКлиенте
Процедура ОбработатьАвтоПодборОкончаниеВводаТекстаЗалогодателя(Текст, ПараметрыПолученияДанных, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Текст) Тогда 
		Возврат;
	КонецЕсли;
	
	СтрокаБезСимволаНомер = СтрЗаменить(Текст, "№", "");
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрокаБезСимволаНомер, , Ложь) Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		ДанныеВыбора = ДанныеВыбора(ПараметрыПолученияДанных);
		
	КонецЕсли;
	
