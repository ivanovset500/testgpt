#КонецОбласти

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ИменаНастроек.Добавить("Организация");
	ИменаНастроек.Добавить("Подразделение");
	ИменаНастроек.Добавить("Склад");
	
	СтруктураИсходныхНастроек = Новый Структура;
	
	Для Каждого ЭлементНастройки Из ИменаНастроек Цикл
		
		ИмяНастройки = ЭлементНастройки.Значение;
		
		// начальное заполнение реквизитов формы
		Параметры.Свойство(ИмяНастройки, ЭтотОбъект[ИмяНастройки]);
		
		// сохраняем исходные настройки
		СтруктураИсходныхНастроек.Вставить(ИмяНастройки, ЭтотОбъект[ИмяНастройки]);
		
	КонецЦикла;
	
	АдресВременногоХранилищаЗначенийИсходныхНастроек = ПоместитьВоВременноеХранилище(СтруктураИсходныхНастроек, УникальныйИдентификатор);
	
	УправлениеФормой();
	
КонецПроцедуры	

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ
