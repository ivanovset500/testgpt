#КонецОбласти

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЦЫ ФОРМЫ <ИМЯТАБЛИЦЫФОРМЫ>
#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИмяТаблицыФормы

	

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураИсходныхНастроек = ЗаписатьНастройкиНаСервере();
	
	Закрыть(СтруктураИсходныхНастроек);
	
КонецПроцедуры	

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.Подразделение.Видимость = БухгалтерскийУчетПереопределяемый.ВестиУчетПоПодразделениям();
	
КонецПроцедуры


&НаСервере
Функция ЗаписатьНастройкиНаСервере()
	
	СтруктураИзмененныхНастроек = Новый Структура;
	
	СтруктураИсходныхНастроек = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаЗначенийИсходныхНастроек);
	
	Для Каждого ЭлементНастройки Из ИменаНастроек Цикл
		
		ИмяНастройки = ЭлементНастройки.Значение;
		
		Если ЭтотОбъект[ИмяНастройки] <> СтруктураИсходныхНастроек[ИмяНастройки] Тогда
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
				"ЛБ_РабочееМестоТовароведа",
				ИмяНастройки,
				ЭтотОбъект[ИмяНастройки]
			);
			СтруктураИзмененныхНастроек.Вставить(ИмяНастройки, ЭтотОбъект[ИмяНастройки]);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураИзмененныхНастроек;
	
КонецФункции	

#КонецОбласти

