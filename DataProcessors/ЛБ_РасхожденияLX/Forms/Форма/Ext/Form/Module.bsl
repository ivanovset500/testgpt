Процедура ВыбратьПериод(Команда)
	ПараметрыВыбора = Новый Структура("НачалоПериода,КонецПериода", pDb, pDe);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыВыбора, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);
КонецПроцедуры

функция OpenRs_(ТекстSQL,CATALOG)
	Если CATALOG тогда
		Подключение ="Provider=SQLOLEDB.1;data PROVIDER=SQLOLEDB.1;PASSWORD=123456;PERSIST SECURITY INFO=TRUE;USER ID=elix;INITIAL CATALOG=dlink;DATA SOURCE=192.168.0.244";
	Иначе
		Подключение ="Provider=SQLOLEDB.1;data PROVIDER=SQLOLEDB.1;PASSWORD=123456;PERSIST SECURITY INFO=TRUE;USER ID=elix;INITIAL CATALOG=dcbdl;DATA SOURCE=192.168.0.244";	
	КонецЕсли;
	СоединениеSQL = Новый COMObject("ADODB.Connection");
	СоединениеSQL.ConnectionString = Подключение;
	СоединениеSQL.Open();
	СоединениеSQL.commandTimeout=600;
	ЗаписиSQL = Новый COMObject("ADODB.Recordset");
	ЗаписиSQL.CursorLocation = 3;
	ЗаписиSQL.Open (ТекстSQL, СоединениеSQL,,3) ;
	возврат  ЗаписиSQL;
конецфункции


Функция ВернутьСтатусЗБ(НомерЗБ)
	Рез  = "";
	
	ТекстSQL  = "select stat from azb where nomer = " + СокрЛП(НомерЗБ);
 
	rt = OpenRs_(ТекстSQL,Ложь);
	
	Пока не rt.eof() цикл
		Если не rt.eof() Тогда 
			
			Рез = rt.fields("Stat").value; 
			
			
			rt.movenext();	
		КонецЕсли;
	КонецЦикла; 

	Возврат Рез;
	
	
КонецФункции

Процедура УдалитьЗБСоСтатусом(стрСтатус, тзСтатусов, тз)
	
	отб1 = Новый Структура("СтатусLX", стрСтатус);
	ЗБОтгр = тзСтатусов.НайтиСтроки(отб1);  
	МассивЗБ = Новый Массив;
	Для каждого элЗБОтгр из ЗБОтгр Цикл	
		СтруктураОтбора = Новый Структура("НомерЗБ", элЗБОтгр.НомерЗБ);
		МассивСтрок = тз.НайтиСтроки(СтруктураОтбора);
		Для Каждого ЭлементМассив Из МассивСтрок Цикл
			тз.Удалить(ЭлементМассив); 
		КонецЦикла;
	КонецЦикла;   
	
КонецПроцедуры

