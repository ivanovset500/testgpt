&НаКлиенте
Процедура ПроставитьГалочкиВГруппе() 
    ЭлементыДерева = ДеревоСтатусов.ПолучитьЭлементы();
	Для каждого Элемент Из ЭлементыДерева Цикл	
		Если Элемент.Пометка Тогда
			Продолжить;
		КонецЕсли;	
		ВлЭлементы = Элемент.ПолучитьЭлементы();
		Если ВлЭлементы.Количество()  > 0 Тогда 
			ЕстьОтмеченные = ложь;
			Для каждого ВлЭлемент Из ВлЭлементы Цикл
				Если ВлЭлемент.Пометка Тогда
					ЕстьОтмеченные = Истина; 
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьОтмеченные Тогда
			    Элементы.ДеревоСтатусов.Развернуть(Элемент.ПолучитьИдентификатор(), Истина);   
			Иначе
				Элементы.ДеревоСтатусов.Свернуть(Элемент.ПолучитьИдентификатор());
			КонецЕсли;	
		КонецЕсли;		
	КонецЦикла;	

КонецПроцедуры	

&НаКлиенте
Процедура ДоступностьПоПустомуСтатусу()
	ЕстьОтметкаВсестатусы = Ложь;
    ЭлементыДерева = ДеревоСтатусов.ПолучитьЭлементы();
	Для каждого Элемент Из ЭлементыДерева Цикл	
		Если ЗначениеЗаполнено(Элемент.Статус) Тогда
			Продолжить;
		КонецЕсли;	
		Если Элемент.Пометка Тогда  
			ЕстьОтметкаВсестатусы = Истина; 
			Прервать;
		КонецЕсли;	
	КонецЦикла;	     
	
	Если ЕстьОтметкаВсестатусы Тогда 
		УстановитьДоступностьСтатусов(Истина);
    КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьТекущуюСтрокуСтатусов() 
	ТекСтрока = Неопределено;
	ЭлементыДерева = ДеревоСтатусов.ПолучитьЭлементы();
	Для каждого Элемент Из ЭлементыДерева Цикл
		Если Элемент.Пометка Тогда
			ТекСтрока = Элемент;
			Прервать;
		КонецЕсли;	  
		Для Каждого ПодчиненныйЭлемент Из Элемент.ПолучитьЭлементы() Цикл 
			Если ПодчиненныйЭлемент.Пометка Тогда
				ТекСтрока = ПодчиненныйЭлемент;
				Прервать;
			КонецЕсли;	 
		КонецЦикла;	   
		Если НЕ ТекСтрока = Неопределено Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;

	Если ТекСтрока <> Неопределено Тогда
	    Элементы.ДеревоСтатусов.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
	КонецЕсли;;
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	ДоступностьПоПустомуСтатусу();
	УстановитьТекущуюСтрокуСтатусов(); 
	ПроставитьГалочкиВГруппе(); 
	Если Объект.Акция Тогда  
		Элементы.ДниНачалаПримененияДеньНачалаПрименения.Видимость =ложь; 
		Элементы.ДниНачалаПрименения.ТолькоПросмотр = Истина;
	КонецЕсли;	
КонецПроцедуры

