&НаКлиенте
Процедура КомандаРазрешить(Команда)
	ТекСтр = Элементы.Список.ТекущиеДанные;
	
	Если ТекСтр <> Неопределено Тогда
		ПроверкаПройдена = ПроверитьСтроку(ТекСтр, Истина, Ложь);
		
		Если ПроверкаПройдена Тогда
			РазрешитьЗапретитьНаСервере(ТекСтр, Истина, Ложь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗапретить(Команда)
	ТекСтр = Элементы.Список.ТекущиеДанные;

	Если ТекСтр <> Неопределено Тогда
		ПроверкаПройдена = ПроверитьСтроку(ТекСтр, Ложь, Истина);
		
		Если ПроверкаПройдена Тогда
			РазрешитьЗапретитьНаСервере(ТекСтр, Ложь, Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьСтроку(ТекСтр, Разрешить, Запретить)

	ЕстьНовыеЗаписи = ПроверитьНаличиеНовыхЗаписей(ТекСтр);
	
	Если ЕстьНовыеЗаписи Тогда
		Сообщить("Есть более свежие записи. Подтверждение старых запрещено!");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекСтр.Разрешено И Разрешить Тогда
		Сообщить("Разрешение усже установлено");
		Возврат Ложь;
	КонецЕсли;

	Если ТекСтр.Запрещено И Запретить Тогда
		Сообщить("Запрет усже установлен");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПроверитьНаличиеНовыхЗаписей(ТекСтр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПервых.Период КАК Период,
		|	ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПервых.Залогодатель КАК Залогодатель
		|ИЗ
		|	РегистрСведений.ЛБ_ЧастичныеСовпаденияПоПеречням.СрезПервых(
		|			&Дата,
		|			Залогодатель = &Залогодатель
		|				И ВидСовпадения = &ВидСовпадения) КАК ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПервых
		//|				И ВидПеречня = &ВидПеречня) КАК ЛБ_ЧастичныеСовпаденияПоПеречнямСрезПервых
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", ТекСтр.Период + 1);
	//Запрос.УстановитьПараметр("ВидПеречня", ТекСтр.ВидПеречня);
	Запрос.УстановитьПараметр("ВидСовпадения", ТекСтр.ВидСовпадения);
	Запрос.УстановитьПараметр("Залогодатель", ТекСтр.Залогодатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура РазрешитьЗапретитьНаСервере(ТекСтр, Разрешить, Запретить)

	НаборЗаписей = РегистрыСведений.ЛБ_ЧастичныеСовпаденияПоПеречням.СоздатьНаборЗаписей();
	НаваяЗапись = НаборЗаписей.Добавить();
	НаваяЗапись.Период = ТекущаяДата();
	НаваяЗапись.Залогодатель = ТекСтр.Залогодатель;
	НаваяЗапись.ВидСовпадения = ТекСтр.ВидСовпадения;
	//НаваяЗапись.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ПустаяСсылка(); //ТекСтр.ВидПеречня;
	НаваяЗапись.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
	НаваяЗапись.ТребуетПроверки = Ложь;
	НаваяЗапись.Разрешено = Разрешить;
	НаваяЗапись.Запрещено = Запретить;
	НаваяЗапись.СотрудникОбнаружил = ТекСтр.СотрудникОбнаружил;
	НаваяЗапись.СотрудникПроверил = ПараметрыСеанса.ТекущийСотрудник;
	
	Если ТекСтр.ДатаИВремяСовпадения = Дата(1,1,1) Тогда
		НаваяЗапись.ДатаИВремяСовпадения = ТекСтр.Период;
	Иначе
		НаваяЗапись.ДатаИВремяСовпадения = ТекСтр.ДатаИВремяСовпадения;
	КонецЕсли;
	
	НаваяЗапись.Фамилия = ТекСтр.Залогодатель.Фамилия;
	НаваяЗапись.Имя = ТекСтр.Залогодатель.Имя;
	НаваяЗапись.Отчество = ТекСтр.Залогодатель.Отчество;
	НаваяЗапись.СтрокаСовпадения = "";
	
	НаборЗаписей.Записать(Ложь);
	
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Элементы.Список.Обновить();
КонецПроцедуры

