	   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь; 
	Если НЕ ТекПользователь.ЭтоЛомбард Тогда
		Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда 
			СотрудникЦО = Истина;
		КонецЕсли;   
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если НЕ ТекПользователь.ЭтоЛомбард Тогда
       		Объект.Ответственный = ТекПользователь;
		Иначе
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник; 
		КонецЕсли;	
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
		Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.ИзЛомбарда; 
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;
		Объект.Дата = ТекущаяДатаСеанса(); 
		ЭтаФорма.Заголовок = "Оприходование объектов залога (создание)";
	Иначе
		//ВидОперацииСтрока = " (" + Строка(Объект.ВидОперации) + ")";
	    ЭтаФорма.Заголовок = "Оприходование объектов залога № " + СокрЛП(Объект.ПредставлениеНомераПоступления) + " от " + Формат(Объект.Дата, "ДЛФ=DT"); 
	КонецЕсли;
	УстановитьСостояниеДокумента(); 
	ЗаполнитьВыборКатегории();
	УстановитьВидимость();     
	ЗаполнитьТаблицуТоваров();                
	//ПривестиЗначениеОткуда();  
	Элементы.Откуда.СписокВыбора.ЗагрузитьЗначения(ПолучитьПодразделеняВПути());
	ТекущийВидОперации = Объект.ВидОперации;  
		
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.ИзЛомбарда Тогда
		Элементы.Категория.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Категория.ТолькоПросмотр = Истина;
	КонецЕсли;	 
	
	Если Объект.Проведен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
КонецПроцедуры  


&НаСервере
Процедура ЗаполнитьВыборКатегории()  
	Если Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно Тогда
		ЭтаФорма.ВыборКатегории = 0;
	Иначе   
		ЭтаФорма.ВыборКатегории = 1;
	КонецЕсли;	
КонецПроцедуры

