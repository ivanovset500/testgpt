&НаСервере
Функция ПолучитьТипОтудаКонтрагент()
	Если ТипЗнч(Объект.ЛомбардОткуда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
		Возврат Истина;
	КонецЕсли;	  
	Возврат Ложь;
КонецФункции	

&НаСервере
Функция ЗаполнитьСписокВыбораСкладов(Направление) 
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.ОтСтороннегоКонтрагента И ЗначениеЗаполнено(Объект.ЛомбардКуда) И ЗначениеЗаполнено(Объект.ЛомбардОткуда) Тогда 
		Если Направление = "Откуда" Тогда
		    ВидСкладаНаправление = Объект.СкладПолучатель.ВидСклада;
		Иначе
			ВидСкладаНаправление = Объект.СкладОтправитель.ВидСклада;
		КонецЕсли;	
        Возврат ЛБ_Общиймодуль.ПолучитьСписокВыбораСкладовДляПеремещения(Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту, Объект.ЛомбардКуда, Объект.ЛомбардОткуда, Направление, неопределено); 
	Иначе                    
		Возврат Новый Массив;
	КонецЕсли;
КонецФункции	

&НаКлиенте
Процедура ОткудаПриИзменении(Элемент) 
	Если ПолучитьТипОтудаКонтрагент() Тогда 
		//Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Откуда"));
		Если ВыборКатегории = 0 Тогда
		    ПолучитьТоварыВПути();   
		КонецЕсли;    
	Иначе  
		Объект.ЛомбардОткуда = ПредопределенноеЗначение("Справочник._ДемоКонтрагенты.ПустаяСсылка");
	КонецЕсли;	
КонецПроцедуры

