&НаСервере
Процедура ПривестиЗначениеОткуда()
	Массив = Новый Массив(); 
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.ОтСтороннегоКонтрагента Тогда
	    Массив.Добавить(Тип("СправочникСсылка._ДемоКонтрагенты"));
	Иначе 
		Массив.Добавить(Тип("СправочникСсылка.ЛБ_Ломбарды"));
	КонецЕсли;	
	Описание = Новый ОписаниеТипов(Массив);

	Элементы.Откуда.ОграничениеТипа = Описание; 
	Объект.ЛомбардОткуда = Описание.ПривестиЗначение(Объект.ЛомбардОткуда);  
КонецПроцедуры

