&НаСервере
Функция ПолучитьПодразделеняВПути() 
	СписокП = Новый Массив;
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Объект.Дата); 
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаВПутиОстатки.Отправитель КАК Отправитель
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаВПути.Остатки(
	               |			&Дата,
	               |			Организация = &Организация";
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.ИзЛомбарда Тогда
		Запрос.Текст =  Запрос.Текст + "
	               |				И ТИПЗНАЧЕНИЯ(Отправитель) = ТИП(Справочник.ЛБ_Ломбарды)";
	Иначе 
		Запрос.Текст =  Запрос.Текст + "
	               |				И ТИПЗНАЧЕНИЯ(Отправитель) = ТИП(Справочник._ДемоКонтрагенты)";
	КонецЕсли;	
	Запрос.Текст =  Запрос.Текст + ") КАК ЛБ_ОбъектыЗалогаВПутиОстатки			   
				   |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ОбъектыЗалогаВПутиОстатки.Отправитель";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		СписокП.Добавить(Выборка.Отправитель);
	Конеццикла;	                   
	Возврат СписокП;
КонецФункции	

