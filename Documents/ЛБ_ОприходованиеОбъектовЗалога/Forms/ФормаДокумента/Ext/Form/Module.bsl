&НаКлиенте
Процедура ИсторияЗБ(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрока.ЗалоговыйБилет) Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", ПолучитьЗаемщика(ТекСтрока.ЗалоговыйБилет));
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);   
	КонецЕсли;	 
КонецПроцедуры

&НаСервере
Процедура ПолучитьКатегорию() 
	Если ВыборКатегории = 0 Тогда
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;
	Иначе
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Сумка;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте    
Процедура КатегорияПриИзменении(Элемент)
	ПолучитьКатегорию();
	Если ЗначениеЗаполнено(Объект.ЛомбардКуда) Тогда     
		ПараметрыФормы = новый Структура;   
		ПараметрыФормы.Вставить("Документ", Объект);
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора",ЭтаФорма);
		ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.Форма.ФормаВыбораВПути", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры     

&НаСервере
Процедура ПослеВыбора(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено тогда  
		Возврат;
	КонецЕсли;	
	
	Если НЕ Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.ОтСтороннегоКонтрагента Тогда
		Объект.НакладнаяНаОтгрузку = Результат.НакладнаяНаОтгрузку; 
		Объект.ЛомбардОткуда = Результат.Отправитель;  
		Объект.СкладОтправитель = Результат.СкладОтправитель;
		Объект.ЛомбардКуда = Результат.Получатель;           
		Объект.СкладПолучатель = Результат.СкладПолучатель;  
		Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПоступленияОбъектовЗалога.РазборСумки Тогда 
			Объект.СкладПолучатель = Объект.СкладОтправитель;   
		КонецЕсли;	
	Иначе	
		Объект.СкладПолучатель = Результат.СкладОтправитель;
	КонецЕсли;
	ПолучитьТоварыВПути();
	ЗаполнитьТаблицуТоваров()
КонецПроцедуры	     

&НаКлиенте
Процедура ПослеВыбораРазборкаСумки(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено тогда  
		Возврат;
	КонецЕсли;	
	
	Объект.НакладнаяНаОтгрузку = Результат.НакладнаяНаОтгрузку; 
	Объект.СкладОтправитель = Результат.СкладПолучатель;
	Объект.СкладПолучатель = Результат.СкладПолучатель;
	
	ПолучитьТоварыВСумке();
	ЗаполнитьТаблицуТоваров()
КонецПроцедуры	

&НаСервере
Процедура ПолучитьТоварыВСумке()  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыВСумке(Объект.Дата, Объект.Организация, Объект.ЛомбардКуда, Объект.СкладПолучатель, Объект.НакладнаяНаОтгрузку);  
	Объект.Товары.Загрузить(ТаблицаЗапроса);
	Объект.Товары.Сортировать("ЗалоговыйБилет");
КонецПроцедуры	

&НаКлиенте
Процедура Заполнить(Команда)  
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПоступленияОбъектовЗалога.РазборСумки") Тогда
		Если ЗначениеЗаполнено(Объект.ЛомбардКуда) Тогда     
			ПараметрыФормы = новый Структура;   
			ПараметрыФормы.Вставить("Документ", Объект);
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораРазборкаСумки",ЭтаФорма);
			ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.Форма.ФормаВыбораВСумке", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		Иначе
		    Предупреждение("Необходимо выбрать подразделение-получатель", 60);
		КонецЕсли;	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПоступленияОбъектовЗалога.ОтСтороннегоКонтрагента") Тогда
		Если ЗначениеЗаполнено(Объект.ЛомбардОткуда) И ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда     
			ПараметрыФормы = новый Структура;   
			ПараметрыФормы.Вставить("Документ", Объект);
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора",ЭтаФорма);
			ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.Форма.ФормаВыбораВПути", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			Предупреждение("Необходимо выбрать контрагента и склад-получатель", 60);
		КонецЕсли;	 
	Иначе	
		Если ЗначениеЗаполнено(Объект.ЛомбардКуда) Тогда     
			ПараметрыФормы = новый Структура;   
			ПараметрыФормы.Вставить("Документ", Объект);
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора",ЭтаФорма);
			ОткрытьФорму("Документ.ЛБ_ОприходованиеОбъектовЗалога.Форма.ФормаВыбораВПути", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			Предупреждение("Необходимо выбрать подразделение-получатель", 60);
		КонецЕсли;	 
	КонецЕсли;	
КонецПроцедуры

