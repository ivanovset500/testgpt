	ОписаниеОповещения = новый ОписаниеОповещения("ПослеВыбораОстановкиНачислений",ЭтотОбъект,СтруктураПараметров);	
	ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателяПоНомеруБилета",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОстановкиНачислений(Результат,Параметры) Экспорт 
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат; 
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗалоговыйБилет); 
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ОстановкаНачисленияПроцентов", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);
	КонецЕсли;	
КонецПроцедуры	


&НаСервере
Функция ПолучитьЗалоговыйБилет(ВидОперации, НомерДок, ДатаДок) 
	ДокументОперации = Документы.ЛБ_ОперацияПоЗалогу.НайтиПоНомеру(НомерДок, ДатаДок); 
	Если ДокументОперации = неопределено Тогда  
		Возврат ДокументОперации;
	КонецЕсли; 
	
	Возврат ?(ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление, ДокументОперации, ДокументОперации.ПредыдущаяОперация);
КонецФункции  

&НаСервере
Функция ПолучитьДокументОплаты(НомерДок, ДатаДок) 
	ДокументОперации = Документы.ЛБ_ОперацияПоЗалогу.НайтиПоНомеру(НомерДок, ДатаДок); 
	Если НЕ ДокументОперации = неопределено Тогда  
		Возврат ДокументОперации;
	КонецЕсли; 
КонецФункции


&НаСервере
Процедура СписокПриАктивизацииСтрокиНаСервере(ВидОперации, Клиент, НомерДок, ДатаДок) 
	СписокДоверенностей = "";
	ЗалоговыйБилет = ПолучитьЗалоговыйБилет(ВидОперации, НомерДок, ДатаДок);  
	ДокументКлиента = ЗалоговыйБилет.ДокументЗалогодателя;
	Если ЗалоговыйБилет = неопределено Тогда  
		Элементы.ДекорацияДоверенности.Заголовок = "Введите доверенности";
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Клиент", Клиент); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	              |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.ПредставительКлиента КАК Представитель,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.ВидДоверенности КАК ВидДоверенности,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.СерияДоверенности КАК СерияДоверенности,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.НомерДоверенности КАК НомерДоверенности,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.ДатаДоверенности КАК ДатаДоверенности,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.СрокДействияДоверенности КАК СрокДействияДоверенности,
	              |	ЛБ_ДоверенностиСрезПоследних.Доверенность.Ответственный КАК Ответственный
	              |ИЗ
	              |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	              |			,
	              |			ЗалоговыйБилет = &ЗалоговыйБилет
	              |				И Клиент = &Клиент) КАК ЛБ_ДоверенностиСрезПоследних
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	ЛБ_ДоверенностиСрезПоследних.Период";
	ТЗ = Запрос.Выполнить().Выгрузить();	
	Для каждого Стр Из ТЗ Цикл  
		Если НЕ Стр.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			Продолжить;
		КонецЕсли;	
		Если НЕ (Стр.СрокДействияДоверенности = Дата(1,1,1)) И (Стр.СрокДействияДоверенности < НачалоДня(ДатаДок)) Тогда 
			Продолжить;
		КонецЕсли;	
		СписокДоверенностей = ?(ПустаяСтрока(СписокДоверенностей), "", "; ") + Сокрлп(Стр.Представитель) + ": доверенность " + нрег(Строка(Стр.ВидДоверенности)) + 
		     ?(ПустаяСтрока(Стр.СерияДоверенности), "", " " + СокрЛП(Стр.СерияДоверенности)) + ?(ПустаяСтрока(Стр.НомерДоверенности), "", " № " + СокрЛП(Стр.НомерДоверенности)) + 
			 ?(Стр.ДатаДоверенности = Дата(1,1,1), "", " от " + Формат(Стр.ДатаДоверенности, "ДФ=dd.MM.yyyy")) + 
			 ?(Стр.СрокДействияДоверенности = Дата(1,1,1), "", " действует до " + Формат(Стр.СрокДействияДоверенности, "ДФ=dd.MM.yyyy")) + " отв. " + СокрЛП(Стр.Ответственный); 
	Конеццикла;	 
	Если Пустаястрока(СписокДоверенностей) Тогда 
		Элементы.ДекорацияДоверенности.Заголовок = "Введите доверенности";
	Иначе	
		Элементы.ДекорацияДоверенности.Заголовок = СписокДоверенностей;
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)  
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ТекСтрока = Элементы.Список.ТекущиеДанные; 
	Если НЕ ТекСтрока = неопределено Тогда  
		СписокПриАктивизацииСтрокиНаСервере(ТекСтрока.ВидОперации, ТекСтрока.Залогодатель, ТекСтрока.Номер, ТекСтрока.Дата); 
		
		//+Мельников 25.04.24 Недоступность ввода доверенности по отмененным операциям выдачи займа
		Если (ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") И
			ЗначениеЗаполнено(ПроверитьОтмену(ТекСтрока.Ссылка))) ИЛИ
			(ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВозвратаИзъятого") ИЛИ
			ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВыдачиСОХ") ИЛИ
			ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога") ИЛИ
			ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия") ИЛИ
			ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты") ИЛИ
			ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОстановкиНачисленияПроцентов") ИЛИ
			ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления")) Тогда
			
			Элементы.ДекорацияДоверенности.Доступность = Ложь;
		Иначе
			Элементы.ДекорацияДоверенности.Доступность = Истина;
		КонецЕсли;
		//-Мельников
	КонецЕсли;	 
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДоверенностиНажатие(Элемент)
	ТекСтрока = Элементы.Список.ТекущиеДанные;   
	Если НЕ ТекСтрока = неопределено Тогда
		ПараметрыВыбора = Новый Структура;
		//+Мельников 24.07.24 Исправление. В доверенность вставал кто оплачивает, а не сам заемщик. Заявка 2707
		//ПараметрыВыбора.Вставить("Клиент", ТекСтрока.Залогодатель);  
		ПараметрыВыбора.Вставить("Клиент", ТекСтрока.Заемщик);  
		//-Мельников
		ЗБ = ПолучитьЗалоговыйБилет(ТекСтрока.ВидОперации, ТекСтрока.Номер, ТекСтрока.Дата); 
		Если НЕ ЗБ = неопределено Тогда 
			ПараметрыВыбора.Вставить("ЗалоговыйБилет", ЗБ);
		Иначе
			Возврат;
		КонецЕсли;	        
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДоверенности",ЭтаФорма);
		//ОткрытьФорму("Документ.ЛБ_Доверенности.ФормаСписка", ПараметрыВыбора,ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ОткрытьФорму("ОбщаяФорма.ЛБ_Доверенности", ПараметрыВыбора,ЭтаФорма, Истина,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.Независимый);
	КонецЕсли;	
КонецПроцедуры     

&НаКлиенте
Процедура ПослеВыбораДоверенности(Результат, ДопПараметры) Экспорт
	ТекСтрока = Элементы.Список.ТекущиеДанные; 	 
	СписокПриАктивизацииСтрокиНаСервере(ТекСтрока.ВидОперации, ТекСтрока.Залогодатель, ТекСтрока.Номер, ТекСтрока.Дата); 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)  
	НачПериода = Элементы.Список.Период.ДатаНачала;
	КонПериода = Элементы.Список.Период.ДатаОкончания;
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период = Новый СтандартныйПериод(НачПериода, КонПериода);
	Оповещение = Новый ОписаниеОповещения("ВыборПериодаЗавершение", ЭтаФорма);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериодаЗавершение(Период, ДополнительныеПараметры) Экспорт 
	Если Период = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Элементы.Список.Период.Вариант = Период.Вариант;
	Элементы.Список.Период.ДатаНачала = Период.ДатаНачала;
    Элементы.Список.Период.ДатаОкончания = Период.ДатаОкончания;   
	Элементы.Список.Обновить();
КонецПроцедуры

