		ПараметрыФормы.Вставить("Документ", ТекСтрока.Ссылка);    
		ОписаниеОповещения = новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаПереоформленияЗайма", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);		
		//+Мельников 25.04.24 Отмена операции
	ИначеЕсли ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты") ИЛИ
		ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОстановкиНачисленияПроцентов") ИЛИ
		ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаИзъятия") ИЛИ
		ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВозвратаИзъятого") ИЛИ
		ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаВыдачиСОХ") Тогда 
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Документ", ТекСтрока.Ссылка);    
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияДокумента", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ОтменаОперацииПоЗайму", ПараметрыФормы, ЭтаФорма, Истина,,,ОписаниеОповещения);		
		//-Мельников
	Иначе                           
		СтандартнаяОбработка = Истина;
	КонецЕсли;	
КонецПроцедуры

