&НаСервере 
Функция ПроверитьВозможностьПометкиУдаленияПакетаДоговоров(ПакетДоговоров) 
	Запрос = новый Запрос;  
	Запрос.УстановитьПараметр("ПакетДоговоров", ПакетДоговоров);
	Запрос.Текст = "ВЫБРАТЬ
	                |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	                |ИЗ
	                |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	                |ГДЕ
	                |	ЛБ_ОперацияПоЗалогу.ПометкаУдаления = ЛОЖЬ
	                |	И ЛБ_ОперацияПоЗалогу.ПакетДоговоров = &ПакетДоговоров";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ПроверитьВозможностьПометкиУдаления(Выборка.Ссылка) Тогда
			Возврат Ложь;
		КонецЕсли;	
	Конеццикла;   
	Возврат истина;
КонецФункции	

&НаСервере 
Функция ПроверитьВозможностьПометкиУдаления(Ссылка) 
	ЗапросП = Новый Запрос; 
	ЗапросП.УстановитьПараметр("ЗБ", Ссылка);
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	                |ИЗ
	                |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	                |ГДЕ
	                |	ЛБ_ОперацияПоЗалогу.ПредыдущаяОперация = &ЗБ
	                |	И ЛБ_ОперацияПоЗалогу.Проведен = ИСТИНА";
	ВыборкаП = ЗапросП.Выполнить().Выбрать();
	Если ВыборкаП.Следующий() тогда 
		Возврат Ложь;
	КонецЕсли;  
	Возврат Истина;
КонецФункции	
	
&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
	ТекСтрока = Элементы.Список.ТекущиеДанные;  
	ПакетДоговоров = ТекСтрока.Ссылка.ПакетДоговоров;
	Если ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") И ЗначениеЗаполнено(ПакетДоговоров) Тогда
	     Результат = ПроверитьВозможностьПометкиУдаленияПакетаДоговоров(ПакетДоговоров);   
		 Если НЕ Результат тогда 
		     Сообщить("Залоговый билет " + СокрЛП(ТекСтрока.НомерЗалоговогоБилета) + " принадлежит пакету договоров и есть проведенные документы оплаты процентов. Удаление документа запрещено.");
			 Отказ = Истина;  
		 Иначе	
			 Режим = РежимДиалогаВопрос.ДаНет;
			 Ответ = Вопрос("Залоговый билет " + СокрЛП(ТекСтрока.НомерЗалоговогоБилета) + " принадлежит пакету договоров. Снять или установить пометку удаления можно только для всех документов пакета. Продолжить?", Режим, 0);
			 Если Ответ = КодВозвратаДиалога.Нет Тогда
			    Отказ = Истина;
			 КонецЕсли;		 
		 КонецЕсли;	 
	 ИначеЕсли ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") ИЛИ ТекСтрока.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда
		 Результат = ПроверитьВозможностьПометкиУдаления(ТекСтрока.Ссылка);   
		 Если НЕ Результат тогда 
		     Сообщить("По залоговому билету " + СокрЛП(ТекСтрока.НомерЗалоговогоБилета) + " есть проведенные документы оплаты процентов. Удаление документа запрещено.");
			 Отказ = Истина;
		КонецЕсли;	 
	КонецЕсли;	 
КонецПроцедуры

