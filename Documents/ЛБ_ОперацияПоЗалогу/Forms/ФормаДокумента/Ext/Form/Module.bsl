&НаСервере
Процедура ЗаполнитьИнформациюОКлиенте()
	Если ЗначениеЗаполнено(Объект.Залогодатель) Тогда
		ФИО = Объект.Залогодатель.Наименование;	    
		КонтактнаяИнформацияВСтроку();
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ДокументЗалогодателя) Тогда
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();
	КонецЕсли;	
КонецПроцедуры	
	
&НаСервере
Процедура ЗаполнитьИнфорациюОЗалогодателе(Параметры)
	Если Параметры.Свойство("ДокументЗалогодателя") Тогда
		Объект.ДокументЗалогодателя = Параметры.ДокументЗалогодателя; 
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();
	КонецЕсли;	
	ЗаполнитьКонтакнуюИнформациюЗалогодателя();
	КонтактнаяИнформацияВСтроку();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнфорациюОПредставителе(Параметры)
