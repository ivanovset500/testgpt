&НаСервере
Процедура ПослеВыбораДокумента(Результат, Параметры) Экспорт
	Если НЕ Результат = неопределено Тогда
		Объект.ДокументВид = Результат.ВидДокумента; 
		Объект.ДокументНомер = Результат.Номер;
		Объект.ДокументСерия = Результат.Серия;
		ЗаполнитьИнформациюОДокументеЗалогодателя();
		ИнформацияОДокументеВСтроку();
	КонецЕсли;	
КонецПроцедуры


&НаСервере
Процедура ОчиститьДокументыЗалогодателя()
	Объект.ДополнительныеДокументыПравоПребыванияРФ.Очистить();
	
	Объект.ДокументЗалогодателя = Справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
	Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПустаяСсылка();
	Объект.ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ПустаяСсылка();
	Объект.ДокументГражданство = Справочники.СтраныМира.ПустаяСсылка();
	Объект.ДокументДатаВыдачи = Дата(1,1,1);
	Объект.ДокументКемВыдан = "";
	Объект.ДокументКодПодразделения = "";
	Объект.ДокументНачалоДействия = Дата(1,1,1);
	Объект.ДокументСрокДействия = Дата(1,1,1);
	ЭтаФорма.Паспорт = "";
КонецПроцедуры

&НаСервере
Процедура ОчиститьДокументыПредставителя()
	Объект.ДокументПредставителя = Справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
	Объект.ДокументВидПредставителя = Справочники.ВидыДокументовФизическихЛиц.ПустаяСсылка();
	Объект.ДокументВидДокументаПредставителя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ПустаяСсылка();
	Объект.ДокументГражданствоПредставителя = Справочники.СтраныМира.ПустаяСсылка();
	Объект.ДокументДатаВыдачиПредставителя = Дата(1,1,1);
	Объект.ДокументКемВыданПредставителя = "";
	Объект.ДокументКодПодразделенияПредставителя = "";
	Объект.ДокументНачалоДействияПредставителя = Дата(1,1,1);
	Объект.ДокументСрокДействияПредставителя = Дата(1,1,1);
	ЭтаФорма.ПаспортПредставителя = "";
КонецПроцедуры


