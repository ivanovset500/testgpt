&НаСервере
Функция ПолучитьВесИСуммуВставокИзделия(КлючСтроки)
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", КлючСтроки);
	СтрокиВставки = Объект.Вставки.НайтиСтроки(Отбор);
	ВесВставок = 0;
	СуммаВставок = 0;
	
	Для каждого Стр Из СтрокиВставки Цикл
		Если Стр.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
	        ВесВставок = ВесВставок + Стр.ВесГраммы;
		    СуммаВставок = СуммаВставок + Стр.Сумма;
		Иначе
			ВесВставок = ВесВставок + Стр.ВесГраммы;
		КонецЕсли;	
	КонецЦикла;	

	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Вес", ВесВставок);
	СтруктураРезультат.Вставить("Сумма", СуммаВставок);
	
	Возврат СтруктураРезультат;
КонецФункции

&НаКлиенте
Процедура ВставкиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти = Элементы.Вставки.ТекущиеДанные;
	
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда		
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
		СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((СтрокаТабличнойЧастиТовары.Вес - СтруктураР.Вес)*100)/100;
		СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
		ПересчитатьСуммТовары();
	КонецЕсли;	
	
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);

	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли;    
КонецПроцедуры 

