Процедура ПаспортПредставителяОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	Если ЗначениеЗаполнено(Объект.Залогодатель) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Владелец", Объект.Представитель);
		ПараметрыФормы.Вставить("ВидДокумента", Объект.ДокументВидПредставителя);
		ПараметрыФормы.Вставить("Серия", Объект.ДокументСерияПредставителя);
		ПараметрыФормы.Вставить("Номер", Объект.ДокументНомерПредставителя);
			
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДокументаПредставителя",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаИзмененияДокументаЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Сообщить("Не выбран представитель заемщика!");
	КонецЕсли;	
