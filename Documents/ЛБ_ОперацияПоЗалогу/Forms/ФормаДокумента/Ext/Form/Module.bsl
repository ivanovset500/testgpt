	Запрос.УстановитьПараметр("Клиент", Объект.Залогодатель);
	Запрос.УстановитьПараметр("Представитель", Объект.Представитель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Клиент = &Клиент
	               |				И Доверенность.ПредставительКлиента = &Представитель
	               |				И СтатусДоверенности = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена)) КАК ЛБ_ДоверенностиСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать(); 	
	Пока Выборка.Следующий() Цикл   
		Если Выборка.Доверенность.СрокДействияДоверенности  < НачалоДня(ДатаДок) Тогда
			Продолжить;
		КонецЕсли;	      
		ОписаниДоверенности = "Доверенность " + НРег(строка(Выборка.Доверенность.ВидДоверенности)) + " № " +
				   СокрЛП(Выборка.Доверенность.НомерДоверенности) + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
				   " действует до " + Формат(Выборка.Доверенность.СрокДействияДоверенности, "ДФ=dd.MM.yyyy"); 
		Элементы.ДоверенностьПредставителя.СписокВыбора.Добавить(Выборка.Доверенность, ОписаниДоверенности);
	Конеццикла;	
КонецПроцедуры	
	
&НаСервере
Процедура ВыбораЗалогодателяНаСервере(Результат) 
	Объект.Залогодатель = Результат.Залогодатель;
	Объект.Фамилия = Объект.Залогодатель.Фамилия;
	Объект.Имя = Объект.Залогодатель.Имя;
	Объект.Отчество = Объект.Залогодатель.Отчество;
	ФИО = Объект.Залогодатель.Наименование;
	ОчиститьДокументыЗалогодателя();
	ЗаполнитьИнфорациюОЗалогодателе(Результат); 
	 	
	НеРезидент = ?(Объект.Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия"), ложь, истина);
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") ИЛИ
		    Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда
		Если НЕ Объект.Залогодатель = Объект.ПредыдущаяОперация.Залогодатель Тогда
			Элементы.ГруппаДоверенностьПлательщикаПолучателя.Видимость = Истина;
			ЗаполнитьСписокВыбораДоверенностейПлательщика();
			Если Элементы.ДоверенностьПлательщикаПолучателя.СписокВыбора.Количество() = 1 Тогда 
				Объект.ДоверенностьПредставителя = Элементы.ДоверенностьПлательщикаПолучателя.СписокВыбора.Получить(0).Значение;
				ЗаполнитьТекстДоверенности(ДоверенностьПлательщикаПолучателя);
			КонецЕсли;	
		КонецЕсли; 
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") ИЛИ
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда
		Объект.СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента(Объект.Дата, Объект.Залогодатель); 
		ПолучитьДопСтатусыКлиента();   
		СтатусыКлиентаВСтроку();    		 
		ЗаполнитьСписокЛьготныхСтатусов();
		ПолучитьДоступныеПроцентныеСхемыАкции();
		Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", Объект.СхемаКредитования); 
			Отбор.Вставить("Акция", Объект.Акция);   
			СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(Отбор);
			Если НЕ СтрокиСК.Количество() = 0 Тогда
				ЗаполнитьТаблицуСтавок();
			Иначе
				СтрокаСК = СтрокиСК.Получить(0);
				Объект.СхемаКредитования = СтрокаСК.СхемаКредитования;
				Объект.Акция = СтрокаСК.Акция;
				ЗаполнитьТаблицуСтавок();
				ОбработатьСхемуКредитованияНаСервере(ДатаДок);
			КонецЕсли;	
		Иначе
			Объект.ПроцентнаяСхема = 0;
		КонецЕсли;	
     	РасчетСуммыОценкиИтоговой();
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда	        
		    РассчитатьСуммуПроцентовПереоформление();
		Иначе			
		    РассчитатьСуммуПроцентов();
		КонецЕсли;	
		Если НЕ СуммаЗайма = 0 Тогда	           
			Если НЕ ПСК = 0 Тогда
	            СуммаПСКГод = СуммаЗайма*ПСК/100;  
			Иначе
				СуммаПСКГод = 0;
			КонецЕсли;				
			Если НЕ (СуммаПСКГод = 0) Тогда 
				Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
			        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
				КонецЕсли;	
		    КонецЕсли;	 
       КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	
	
&НаКлиенте
Процедура ПослеВыбораЗалогодателя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;   
	
	СписокСС = ПолучитьСлужебныеСтатусыКлиента(Результат.Залогодатель);  
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтрокаВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение);
			Если СтрокаВозврата = "Запрет" Тогда 
				Предупреждение("Для клиента " + СокрЛП(Объект.Залогодатель) + " определен запрет на операцию " + Строка(Объект.ВидОперации), 60, "Проверка служебных статусов клиента");
				Возврат;  
			Иначе
				ПредупреждениеП = СтрокаВозврата;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена, , "Проверка служебных статусов клиента"); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;  
	
	ВыбораЗалогодателяНаСервере(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораПредставителя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Объект.Представитель = Результат.Залогодатель;
	Объект.ФамилияПредставителя = Объект.Залогодатель.Фамилия;
	Объект.ИмяПредставителя = Объект.Залогодатель.Имя;
	Объект.ОтчествоПредставителя = Объект.Залогодатель.Отчество;
	ФИОПредставителя = Объект.Представитель.Наименование;
	ОчиститьДокументыПредставителя();
	ЗаполнитьИнфорациюОПредставителе(Результат);
	ЗаполнитьСписокВыбораДоверенностейПредставителя();
	Если Элементы.ДоверенностьПредставителя.СписокВыбора.Количество() = 1 Тогда 
		Объект.ДоверенностьПредставителя = Элементы.ДоверенностьПредставителя.СписокВыбора.Получить(0).Значение;
		ЗаполнитьТекстДоверенности(Доверенность);
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ПослеВыбораДоверенности(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Объект.ДоверенностьПредставителя = Результат;
