&НаСервере
Процедура ЗаполнитьСписокВыбораДоверенностейПлательщика() 
	Элементы.ДоверенностьПлательщикаПолучателя.СписокВыбора.Очистить();
	Если Объект.Залогодатель = Объект.ПредыдущаяОперация.Залогодатель Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", объект.ПредыдущаяОперация);
	Запрос.УстановитьПараметр("Клиент", Объект.ПредыдущаяОперация.Залогодатель);
	Запрос.УстановитьПараметр("Представитель", Объект.Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Клиент = &Клиент
	               |				И Доверенность.ПредставительКлиента = &Представитель
	               |				И СтатусДоверенности = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена)) КАК ЛБ_ДоверенностиСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать(); 	
	Пока Выборка.Следующий() Цикл   
		Если Выборка.Доверенность.СрокДействияДоверенности  < НачалоДня(ДатаДок) Тогда
			Продолжить;
		КонецЕсли;	      
		ОписаниДоверенности = "Доверенность " + НРег(строка(Выборка.Доверенность.ВидДоверенности)) + " № " +
				   СокрЛП(Выборка.Доверенность.НомерДоверенности) + " от " + Формат(Выборка.Доверенность.ДатаДоверенности, "ДФ=dd.MM.yyyy") +
				   " действует до " + Формат(Выборка.Доверенность.СрокДействияДоверенности, "ДФ=dd.MM.yyyy"); 
		Элементы.ДоверенностьПлательщикаПолучателя.СписокВыбора.Добавить(Выборка.Доверенность, ОписаниДоверенности);
	Конеццикла;	
КонецПроцедуры	

