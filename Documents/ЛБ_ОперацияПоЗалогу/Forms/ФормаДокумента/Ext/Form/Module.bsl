			ЦенаДрагоценногоМеталла(СтрДоп.ПолучитьИдентификатор());
			Стр.СуммаОценкиМеталлы = Стр.СуммаОценкиМеталлы + СтрДоп.СуммаОценкиМеталлы;
		Конеццикла;	
		Стр.СуммаОценки = Стр.СуммаОценкиМеталлы + Стр.СуммаОценкиКамни;
		
		МассивС = Новый Массив;
		МассивС.Добавить(объект.СтатусЗалогодателя);
		Для каждого Эл Из СписокДопСтатусов Цикл  
			МассивС.Добавить(Эл.Значение);
		Конеццикла;	
	    Стр.СуммаОценкиМаксимальная = ЛБ_УправлениеЛомбардом.РасчитатьМаксимальнуюСуммуЗалога(Объект.Дата, Объект.СхемаКредитования, МассивС, Стр);
		Если Стр.СуммаСсуды > Стр.СуммаОценкиМаксимальная Тогда
			Стр.СуммаСсуды = Стр.СуммаОценкиМаксимальная;
		КонецЕсли;	
	КонецЦикла;	
	Объект.СуммаСсуды = ОкруглитьСуммуСсуды(Объект.Товары.Итог("СуммаОценкиМаксимальная"));
	СуммаЗайма = Объект.СуммаСсуды;  
	РаспределитьСуммуЗайма(); 
