							ЗаполнитьТекстДоверенности(ДоверенностьПлательщикаПолучателя);
						КонецЕсли;	
					КонецЕсли; 
					ЗаполнитьКонтакнуюИнформациюЗалогодателя(); 
				КонецЕсли;	 
				Если  Параметры.Свойство("Доверенность") Тогда 
