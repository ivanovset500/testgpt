&НаСервере 
Функция ОкруглитьСуммуСсуды(Сумма)
	Возврат ЛБ_УправлениеЛомбардом.ОкруглитьСуммуСсудыПоНастройкам(Объект.Дата, Объект.Организация, Сумма);
КонецФункции	

&НаКлиенте
Процедура ПересчитатьСуммТовары(СтрокаТабличнойЧастиТовары = неопределено)
	Если СтрокаТабличнойЧастиТовары = неопределено Тогда
	    СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;	
    СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = СтрокаТабличнойЧастиТовары.ВесЧистый*СтрокаТабличнойЧастиТовары.Цена;
	ОтборДоп = Новый Структура;
	ОтборДоп.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
	СтрокиДоп = Объект.ДополнительныеМеталлы.НайтиСтроки(ОтборДоп);
	ОснМеталлВесЧистый = СтрокаТабличнойЧастиТовары.ВесЧистый;
	Для каждого СтрДоп Из СтрокиДоп Цикл
		ОснМеталлВесЧистый = ОснМеталлВесЧистый - СтрДоп.ВесЧистый;
	Конеццикла;	
	//СтрокаТабличнойЧастиТовары.ВесВПробеЧистоты = ПолучитьВесВЧистоте(ОснМеталлВесЧистый, СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()); 
	СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = ОснМеталлВесЧистый*СтрокаТабличнойЧастиТовары.Цена;
	Для каждого СтрДоп Из СтрокиДоп Цикл
		СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы + СтрДоп.СуммаОценкиМеталлы;
		//СтрокаТабличнойЧастиТовары.ВесВПробеЧистоты = СтрокаТабличнойЧастиТовары.ВесВПробеЧистоты + СтрДоп.ВесВПробеЧистоты;
	Конеццикла;	
	СтрокаТабличнойЧастиТовары.СуммаОценки = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы + СтрокаТабличнойЧастиТовары.СуммаОценкиКамни;
	
	РасчетМаксимальнойСуммыОценки(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
	СтрокаТабличнойЧастиТовары.СуммаСсуды = СтрокаТабличнойЧастиТовары.СуммаОценкиМаксимальная;
	Объект.СуммаСсуды = ОкруглитьСуммуСсуды(Объект.Товары.Итог("СуммаОценкиМаксимальная"));
	СуммаЗайма = Объект.СуммаСсуды;  
	РаспределитьСуммуЗайма();
	ПолучитьДоступныеПроцентныеСхемыАкции();				
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("СхемаКредитования", Объект.СхемаКредитования); 
		Отбор.Вставить("Акция", Объект.Акция);   
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(Отбор);
		Если НЕ СтрокиСК.Количество() = 0 Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			Объект.СхемаКредитования = СтрокаСК.СхемаКредитования;
			Объект.Акция = СтрокаСК.Акция;
			ЗаполнитьТаблицуСтавок();
			ОбработатьСхемуКредитованияНаСервере(ДатаДок);
			ЗаполнитьДатуВыкупа();
			Объект.ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа(); 
		КонецЕсли;	
	Иначе
		Объект.СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Объект.Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		Объект.ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		Объект.ДатаВыкупа = Дата(1,1,1); 
		Объект.ДатаВыкупаЛьготная = Дата(1,1,1);  
		Объект.СрокЗалога = 0;
		Объект.ПроцентнаяСхема = 0;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
    КонецЕсли;	      
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда	        
	    РассчитатьСуммуПроцентовПереоформление();
	Иначе	
	    РассчитатьСуммуПроцентов(); 
	КонецЕсли;       
	Если НЕ СуммаЗайма = 0 Тогда	           
		Если НЕ ПСК = 0 Тогда
            СуммаПСКГод = СуммаЗайма*ПСК/100;  
		Иначе
			СуммаПСКГод = 0;
		КонецЕсли;				
		Если НЕ (СуммаПСКГод = 0) Тогда 
			Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
		        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
			КонецЕсли;	
	    КонецЕсли;	 
    КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ТоварыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) 
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	Если НЕ ПроверитьВесДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()) Тогда
		Сообщить("В разделе ""Дополнительные металлы"" масса металла в общей массе изделия не является наименьшей.");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура РасчетМаксимальнойСуммыОценки(Идентификатор)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(Идентификатор); 
	МассивС = Новый Массив;
	МассивС.Добавить(объект.СтатусЗалогодателя);
	Для каждого Эл Из СписокДопСтатусов Цикл  
		МассивС.Добавить(Эл.Значение);
	Конеццикла;	
	СтрокаТабличнойЧасти.СуммаОценкиМаксимальная = ЛБ_УправлениеЛомбардом.РасчитатьМаксимальнуюСуммуЗалога(Объект.Дата, Объект.СхемаКредитования, МассивС, СтрокаТабличнойЧасти);
КонецПроцедуры	

