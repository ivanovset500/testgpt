&НаСервере
// Проверяет заполнение полей залогового билета
//
// Параметры
//  Нет
//
// Возвращаемое значение
//  Булево - результат проверки
//
Функция ПроверкаЗаполнения() Экспорт   
	Результат = Истина;
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога Тогда   
		Если НЕ Объект.ТоварыИзъятыеВозвращенные.Количество() Тогда
		
			Результат = Ложь;
			Сообщить("Изъятые объекты залога не указаны!",СтатусСообщения.Внимание);  
						
		КонецЕсли;   
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаИзъятия) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ГосОрганИзъятие) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ДатаПротоколИзъятия) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ДокументИзъятияНаименование) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ДокументИзъятияДатаВыдачи) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ДокументИзъятияКемВыдан) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ФИОДолжностьИзъятие) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ФИОДолжностьСудьи) Тогда 
			
			Результат = Ложь;
		    Сообщить("Не заолнены обязательные реквизиты на форме!",СтатусСообщения.Внимание); 
		КонецЕсли;	

		Возврат Результат;	 
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога Тогда   
		Если НЕ Объект.ТоварыИзъятыеВозвращенные.Количество() Тогда
		
			Результат = Ложь;
			Сообщить("Возвращенные объекты залога не указаны!",СтатусСообщения.Внимание);   
			
		КонецЕсли;          
		
		Если НЕ ЗначениеЗаполнено(Объект.ДокументВозвратаНаименование) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ДокументВозвратаНомер) ИЛИ
			 НЕ ЗначениеЗаполнено(Объект.ДокументВозвратаДата) Тогда 
			
			Результат = Ложь;
		    Сообщить("Не заолнены обязательные реквизиты на форме!",СтатусСообщения.Внимание); 
		КонецЕсли;	
		
		Возврат Результат;	
	КонецЕсли;
		
		
	Если НЕ Объект.Товары.Количество() Тогда
		
		Результат = Ложь;
		Сообщить("Состав залога не указан!",СтатусСообщения.Внимание);
		Возврат Результат;
		
	КонецЕсли;
	
	Если Результат Тогда
		Если Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
			Если ПустаяСтрока(Объект.ДокументКодПодразделения) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить код подразделения!");
				Результат = ложь;
			КонецЕсли;	
			Если ПустаяСтрока(Объект.ДокументКемВыдан) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить кем выдан!");
				Результат = ложь;
			КонецЕсли;	
		КонецЕсли;
		Если ((Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
		(Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И Объект.ДокументВидДокументаЗалогодателя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) Тогда
		    Если Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда 			    
				Парам = Новый Структура("Серия, Номер", СокрЛП(Объект.ДокументСерия), СокрЛП(Объект.ДокументНомер));
				Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
					Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
						Сообщить("Документ найден в списке недействительных паспортов!");
					    Результат = ложь; 
					КонецЕсли;	
				ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(Объект.ДатаРождения, Объект.ДокументДатаВыдачи) Тогда
					Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
				    Результат = ложь;	
				КонецЕсли;	
			ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(Объект.ДатаРождения, Объект.ДокументДатаВыдачи) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
			    Результат = ложь;   
			КонецЕсли;	
		ИначеЕсли (Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) И НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(Объект.ДатаРождения) Тогда
			Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		    Результат = ложь;
		КонецЕсли;	
		Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Объект.Гражданство, Объект.ДокументВидДокументаЗалогодателя, Объект.ДокументВид) тогда
			Если НЕ ЗначениеЗаполнено(Объект.ДокументСрокДействия) Тогда
				Сообщить("Для документ удостоверяющего личность залогодателя необходимо заполнить срок действия!");
		        Результат = ложь;
			ИначеЕсли Объект.ДокументСрокДействия <	НачалоДня(Объект.Дата) Тогда
				Сообщить("Документ удостоверяющий личность залогодателя просрочен!");
		        Результат = ложь;
			КонецЕсли;	
		КонецЕсли;	 
		Если НЕ Объект.Гражданство = Справочники.СтраныМира.Россия Тогда
			Отбор = Новый Структура; 
			Отбор.Вставить("Клиент", Объект.Залогодатель);
			Строки = Объект.ДополнительныеДокументыПравоПребыванияРФ.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда 
				Сообщить("Не выбран документ удостоверяющий право пребывания клиента на территории РФ!");
		        Результат = ложь;
			Иначе                  
				ЕстьДокументГражданствоНЕРФ = ложь;
				Для каждого Стр Из Строки Цикл
					Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Объект.Гражданство, Стр.ДокументЗалогодателя, Стр.ВидДокумента) тогда 
						Если НЕ ЗначениеЗаполнено(Объект.ДокументСрокДействия) Тогда
							Продолжить;
						ИначеЕсли Объект.ДокументСрокДействия <	НачалоДня(Объект.Дата) Тогда
							Продолжить;
						КонецЕсли;	
                        ГражданствоНЕРФ = Истина;
						Прервать;  
					Иначе
						ГражданствоНЕРФ = Истина;
						Прервать; 
					КонецЕсли;					
				КонецЦикла;	
				Если НЕ ГражданствоНЕРФ Тогда
					Сообщить("У клиента нет действующего документа, удостоверяющего право пребывания на территории РФ!");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	  
	КонецЕсли;
	
	Если Результат Тогда
		Если ЗначениеЗаполнено(Объект.Представитель) Тогда
			//проверим кон. инф и документ представителя
			Если НЕ ЗначениеЗаполнено(Объект.ФамилияПредставителя) Тогда
				Сообщить("Не заполнена фамилия представиделя заемщика");
				Результат = ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(Объект.ИмяПредставителя) Тогда
				Сообщить("Не заполнено имя представителя заемщика");
				Результат = ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(Объект.ПолПредставителя) Тогда
				Сообщить("Не заполнен пол представителя заемщика");
				Результат = ложь;
			КонецЕсли;	
	        Если НЕ ЗначениеЗаполнено(Объект.ДокументВидПредставителя) Тогда
				Сообщить("Не выбран документ удостоверяющий личность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.ДатаРожденияПредставителя) Тогда
				Сообщить("Не заполнена дата рождения представителя заемщика");
				Результат = ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.ДоверенностьПредставителя) Тогда
				Сообщить("Не выбрана доверенность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.ГражданствоПредставителя) Тогда
				Сообщить("Не выбрано гражданство представителя заемщика");
				Результат = ложь;
			КонецЕсли;
	        Если НЕ ЗначениеЗаполнено(Объект.ДокументВидДокументаПредставителя) Тогда
				Сообщить("Не выбран вид документа удостоверяющего личность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
	        Если НЕ ЗначениеЗаполнено(Объект.ДокументВидПредставителя) Тогда
				Сообщить("Не выбрано наименование документа удостоверяющего личность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
	        Если НЕ ЗначениеЗаполнено(Объект.ДокументГражданствоПредставителя) Тогда
				Сообщить("Не выбрано гражданство документа удостоверяющего личность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.ДокументДатаВыдачиПредставителя) Тогда
				Сообщить("Не выбрана дата выдачи документа удостоверяющего личность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.ДокументНачалоДействияПредставителя) Тогда
				Сообщить("Не выбрана начало действия документа удостоверяющего личность представителя заемщика");
				Результат = ложь;
			КонецЕсли;
			Если Результат Тогда
				Если Объект.ДокументВидПредставителя = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
					Если ПустаяСтрока(Объект.ДокументКодПодразделенияПредставителя) Тогда
						Сообщить("Для документ удостоверяющего личность представителя заемщика необходимо заполнить код подразделения!");
						Результат = ложь;
					КонецЕсли;	
					Если ПустаяСтрока(Объект.ДокументКемВыданПредставителя) Тогда
						Сообщить("Для документ удостоверяющего личность представителя заемщика необходимо заполнить кем выдан!");
						Результат = ложь;
					КонецЕсли;	
                КонецЕсли;
				Если ((Объект.ДокументВидПредставителя = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ) ИЛИ 
		        (Объект.ДокументВидПредставителя = Справочники.ВидыДокументовФизическихЛиц.ВидНаЖительство И Объект.ДокументВидДокументаПредставителя = Перечисления.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийЛичность)) Тогда
					Если Объект.ВидДокументаПредставителя = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
						Парам = Новый Структура("Серия, Номер", СокрЛП(Объект.ДокументСерияПредставителя), СокрЛП(Объект.ДокументНомерПредставителя));
						Если ЛБ_ОбменLX.ПаспортНедействителен(Парам) Тогда 
							Сообщить("Документ представителя заемщика найден в списке недействительных паспортов!");
						    Результат = ложь; 
						ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(Объект.ДатаРожденияПредставителя, Объект.ДокументДатаВыдачиПредставителя) Тогда
							Сообщить("Документ удостоверяющий личность представителя заемщика просрочен!");
						    Результат = ложь;	
						КонецЕсли;	
					ИначеЕсли НЕ ЛБ_ОбщийМодуль.ПроверитьПаспортРФДействует(Объект.ДатаРожденияПредставителя, Объект.ДокументДатаВыдачиПредставителя) Тогда
						Сообщить("Документ удостоверяющий личность представителя заемщика просрочен!");
					    Результат = ложь;  
					КонецЕсли;	
				ИначеЕсли (Объект.ДокументВидПредставителя = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении) И НЕ ЛБ_ОбщийМодуль.ПроверитьСвидетельствоОРожденииДействует(Объект.ДатаРожденияПредставителя) Тогда
					Сообщить("Документ удостоверяющий личность представителя заемщика просрочен!");
				    Результат = ложь;	
				КонецЕсли;	
				Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Объект.Гражданство, Объект.ДокументВидДокументаПредставителя, Объект.ДокументВидПредставителя) тогда
					Если НЕ ЗначениеЗаполнено(Объект.ДокументСрокДействияПредставителя) Тогда
						Сообщить("Для документ удостоверяющего личность представителя заемщика необходимо заполнить срок действия!");
				        Результат = ложь;
					ИначеЕсли Объект.ДокументСрокДействияПредставителя < НачалоДня(Объект.Дата) Тогда
						Сообщить("Документ удостоверяющий личность представителя заемщика просрочен!");
				        Результат = ложь;
					КонецЕсли;	
				КонецЕсли;
				Если НЕ Объект.ГражданствоПредставителя = Справочники.СтраныМира.Россия Тогда
					Отбор = Новый Структура; 
					Отбор.Вставить("Клиент", Объект.Представитель);
					Строки = Объект.ДополнительныеДокументыПравоПребыванияРФ.НайтиСтроки(Отбор);
					Если Строки.Количество() = 0 Тогда 
						Сообщить("Не выбран документ удостоверяющий право пребывания представителя клиента на территории РФ!");
				        Результат = ложь;
					Иначе                  
						ЕстьДокументГражданствоНЕРФ = ложь;
						Для каждого Стр Из Строки Цикл
							Если ЛБ_ОбщийМодуль.ДокументСоСрокомДействия(Объект.Гражданство, Стр.ДокументЗалогодателя, Стр.ВидДокумента) тогда 
								Если НЕ ЗначениеЗаполнено(Объект.ДокументСрокДействия) Тогда
									Продолжить;
								ИначеЕсли Объект.ДокументСрокДействия <	НачалоДня(Объект.Дата) Тогда
									Продолжить;
								КонецЕсли;	
		                        ГражданствоНЕРФ = Истина;
								Прервать;  
							Иначе
								ГражданствоНЕРФ = Истина;
								Прервать; 
							КонецЕсли;					
						КонецЦикла;	
						Если НЕ ГражданствоНЕРФ Тогда
							Сообщить("У представителя клиента нет действующего документа, удостоверяющего право пребывания на территории РФ!");
							Результат = ложь;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	 
			КонецЕсли;	
     	КонецЕсли;	
	КонецЕсли;	


	Если Результат Тогда
		
		Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
			
			Результат = Результат 
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ВидИзделия)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Проба)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Описание)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Количество)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаОценки)
			И ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаСсуды);  
			
			Если СтрокаТабличнойЧасти.Именник = Перечисления.ЛБ_Именник.Да тогда
				Если ПустаяСтрока(СтрокаТабличнойЧасти.ДанныеИменника) Тогда
					Сообщить("Если именник РФ, то необходимо заполнить данные именника.");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;  
			
			Если СтрокаТабличнойЧасти.ЕстьДеффекты тогда
				Если ПустаяСтрока(СтрокаТабличнойЧасти.Дефекты) Тогда
					Сообщить("Если в изделии есть дефекты, то необходимо их описать.");
					Результат = ложь;
				КонецЕсли;	
			КонецЕсли;  
			
			Если НЕ ПроверитьОписаниеИзделия(СтрокаТабличнойЧасти) Тогда
				Результат = ложь;
			КонецЕсли;	
			
			Если НЕ Результат Тогда
				
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
		
	Если НЕ Результат Тогда
		
		Попытка
			Если Объект.ДокументВид = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
				ЛБ_РаботаСДиалогами.НезаполненыОбязательныеПоля(Объект, Новый Структура("Организация, Ломбард, Фамилия, Имя, ДатаРождения, ДокументВид, ДокументСерия,
				|ДокументНомер, ДокументДатаВыдачи, Гражданство, ДокументКемВыдан, СхемаКредитования, ДокументКодПодразделения"), Новый Структура("ВидИзделия, Проба, Количество, Описание, Цена, СуммаОценки,СуммаСсуды"));	
			Иначе
				ЛБ_РаботаСДиалогами.НезаполненыОбязательныеПоля(Объект, Новый Структура("Организация, Ломбард, Фамилия, Имя, ДатаРождения, ДокументВид,
				|ДокументНомер, ДокументДатаВыдачи, Гражданство, ДокументКемВыдан, СхемаКредитованияи"), Новый Структура("ВидИзделия, Проба, Количество, Описание, Цена, СуммаОценки,СуммаСсуды"));	
			КонецЕсли;
		Исключение
			Сообщить("Не заполнены обязательные поля",СтатусСообщения.Внимание);
		КонецПопытки;
		
	КонецЕсли;    
		
	Возврат Результат;
	
КонецФункции // ПроверкаЗаполнения() 

&НаСервере
Функция ПроверитьОписаниеИзделия(Стр)  
	МассивСлов = СтрРазделить(СокрЛП(Стр.Описание), " ", ложь);
    Рез = истина;
	ВыборкаСпр = Справочники.ЛБ_НеДопустимыеЗначенияВОписанииИзделия.Выбрать();
	Пока ВыборкаСпр.Следующий() цикл
		Если ВыборкаСпр.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	
		Для каждого Слово из МассивСлов Цикл  
			Если СокрЛП(нрег(Слово)) = СокрЛП(нрег(ВыборкаСпр.Наименование)) Тогда
				Сообщить("В описании изделия найдены недопустимые символы """ + СокрЛП(ВыборкаСпр.Наименование) + """"); 
				Рез = Ложь;
			КонецЕсли;	
		КонецЦикла;	
	Конеццикла;	 
	Возврат Рез;
КонецФункции 

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
