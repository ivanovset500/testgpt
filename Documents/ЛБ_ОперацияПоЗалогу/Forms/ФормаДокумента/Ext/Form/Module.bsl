&НаКлиенте
Процедура ОплатаПроцентов(Полностью = ложь) 
	Если Полностью Тогда 
		Объект.СуммаОплаты = СуммаПроцентов;
	Иначе	
	    Объект.СуммаОплаты = СуммаПроцентов*90/100; 
	КонецЕсли;	
	Объект.СуммаОплатыПроценты = Объект.СуммаОплаты;
	Объект.СуммаОплатыСсуда = 0;
КонецПроцедуры


&НаКлиенте
Процедура ПолныйВыкуп()  
	РассчитатьСуммуПроцентовОплата();
	Объект.СуммаОплаты = СуммаЗайма + СуммаПроцентов;
	Объект.СуммаОплатыПроценты = СуммаПроцентов;
	Объект.СуммаОплатыСсуда = СуммаЗайма; 
КонецПроцедуры


&НаКлиенте
Процедура СуммаОплатыПриИзменении(Элемент)
	Если Объект.СуммаОплаты <= СуммаПроцентов Тогда
		Объект.СуммаОплатыПроценты = Объект.СуммаОплаты;
		Объект.СуммаОплатыСсуда = 0;
	Иначе	
		Объект.СуммаОплатыПроценты = СуммаПроцентов;
		Объект.СуммаОплатыСсуда = Объект.СуммаОплаты - Объект.СуммаОплатыПроценты;
		Если Объект.СуммаОплаты >= (СуммаЗайма + СуммаПроцентов) Тогда 
			Объект.СуммаОплаты = (СуммаЗайма + СуммаПроцентов);
			Объект.Выкуп = Истина;
			Если НЕ (Объект.Залогодатель = ИнформацияОЗаемщике) И НЕ ЗначениеЗаполнено(Объект.ДоверенностьПредставителя) Тогда
				Объект.ВыдачаЗалога = Ложь;
			Иначе
				Объект.ВыдачаЗалога = Истина;
			КонецЕсли;	
		КонецЕсли;	
		РаспределитьСуммуОплатыСсудыТовары();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьСуммуОплатыСсудыТовары() 
	Если Объект.Выкуп Тогда 
		Для каждого Стр Из Объект.Товары Цикл 
			Стр.СуммаОплаты = Стр.СуммаСсуды;  
		КонецЦикла;	
	Иначе	
		СуммаДляРаспределения = Объект.СуммаОплатыСсуда;
		Если СуммаДляРаспределения = 0 Тогда
			Для каждого Стр Из Объект.Товары Цикл
				Стр.СуммаОплаты = 0;   
			Конеццикла;	
		Иначе	
			НомСтрМакс = 0; 
			МаксЗадолженность = 0;
			ЗадолженностьНачИтог = Объект.Товары.Итог("СуммаСсуды");
			Для каждого Стр Из Объект.Товары Цикл 
				Коэфф = Стр.СуммаСсуды/ЗадолженностьНачИтог;
				Стр.СуммаОплаты = Объект.СуммаОплатыСсуда*Коэфф;
				СуммаДляРаспределения = СуммаДляРаспределения - Стр.СуммаОплаты;
				Если Стр.СуммаСсуды > МаксЗадолженность Тогда
					МаксЗадолженность = Стр.СуммаСсуды;  
					НомСтрМакс = стр.НомерСтроки-1;
				КонецЕсли;	
			КонецЦикла;
			Если НЕ СуммаДляРаспределения = 0 Тогда
				Стр = Объект.Товары.Получить(НомСтрМакс);
				Стр.СуммаОплаты = Стр.СуммаОплаты + СуммаДляРаспределения;
			КонецЕсли;  
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура Оплатить(Команда)
	СписокВыбора = Новый СписокЗначений; 

    СписокВыбора.Добавить(1, "Свободная оплата"); 
    СписокВыбора.Добавить(2, "Оплата процентов для продления договора");
	СписокВыбора.Добавить(3, "Полная оплата процентов");
	СписокВыбора.Добавить(4, "Полный выкуп объектов залога");

    ВыбранноеЗначение = ВыбратьИзСписка(СписокВыбора, Элементы.КнопкаОплатить); 

	Если ВыбранноеЗначение <> Неопределено Тогда 
	    ВыбЗначение = ВыбранноеЗначение.Значение; 
		Если ВыбЗначение = 1 Тогда
			Элементы.СуммаОплаты.ТолькоПросмотр = ложь; 
			Объект.Выкуп = ?(Объект.Выкуп, ложь, Объект.Выкуп);
			Объект.ВыдачаЗалога = ?(Объект.ВыдачаЗалога, ложь, Объект.ВыдачаЗалога);
		ИначеЕсли ВыбЗначение = 2 Тогда
			ОплатаПроцентов();
			Элементы.СуммаОплаты.ТолькоПросмотр = Истина;
			Объект.Выкуп = ?(Объект.Выкуп, ложь, Объект.Выкуп);
			Объект.ВыдачаЗалога = ?(Объект.ВыдачаЗалога, ложь, Объект.ВыдачаЗалога);
		ИначеЕсли ВыбЗначение = 3 Тогда
			ОплатаПроцентов(Истина);
			Элементы.СуммаОплаты.ТолькоПросмотр = Истина;
			Объект.Выкуп = ?(Объект.Выкуп, ложь, Объект.Выкуп);
			Объект.ВыдачаЗалога = ?(Объект.ВыдачаЗалога, ложь, Объект.ВыдачаЗалога);	
		ИначеЕсли ВыбЗначение = 4 Тогда
			ПолныйВыкуп();
			Элементы.СуммаОплаты.ТолькоПросмотр = Истина;
			Объект.Выкуп = Истина; 
			Если НЕ (Объект.Залогодатель = ИнформацияОЗаемщике) И НЕ ЗначениеЗаполнено(Объект.ДоверенностьПредставителя) Тогда
				Объект.ВыдачаЗалога = Ложь;
			Иначе
				Объект.ВыдачаЗалога = Истина;
			КонецЕсли;	
		КонецЕсли;	 
		РаспределитьСуммуОплатыСсудыТовары();
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура Расчеты(Команда)
	Сообщить("Здесь будет отчет по расчетам по договору займа", статусСообщения.Информация);
КонецПроцедуры

&НаСервере
Процедура ОбработатьПромокодНаСервере() 
	ПолучитьДоступныеПроцентныеСхемыАкции();
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		Если НЕ ПустаяСтрока(Объект.Промокод) Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", Объект.СхемаКредитования);   
			СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(Отбор);
			Если НЕ СтрокиСК.Количество() = 0 Тогда 
				ЕстьАкцияПромокод = ложь;
				Для Сч = 0 По СтрокиСК.Количество()-1 Цикл
					Акция = ТаблицаВыбораСхемыКредитованияАкции.Получить(сч).Акция;
					Если НЕ ЗначениеЗаполнено(Акция) Тогда
						Продолжить;
					ИначеЕсли НЕ СокрЛП(Акция.Промокод) = СокрЛП(Объект.Промокод) Тогда	
						Продолжить;
					КонецЕсли;	 
					Объект.Акция = Акция;
				    ЗаполнитьТаблицуСтавок(); 
					ЕстьАкцияПромокод = Истина; 
					Прервать;
				КонецЦикла;  
				Если НЕ ЕстьАкцияПромокод Тогда
					Сообщить("Для кредитной схемы " + СокрЛП(Объект.СхемаКредитования) + " акция с промокодом " + СокрЛП(Объект.Промокод) + " не действует.");
					Объект.Промокод = ""; 
					Возврат;
				КонецЕсли;	
			Иначе  
				Сообщить("Для кредитной схемы " + СокрЛП(Объект.СхемаКредитования) + " акция с промокодом " + СокрЛП(Объект.Промокод) + " не действует.");
				Объект.Промокод = "";
				Возврат;
			КонецЕсли;	 
		Иначе
			СтрСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			Объект.СхемаКредитования = СтрСК.СхемаКредитования;
			Объект.Акция = СтрСК.Акция;			
			ЗаполнитьТаблицуСтавок();    
			Если НЕ ЗначениеЗаполнено(Объект.ПроцентнаяСхема) Тогда
                Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
            КонецЕсли;
			ОбработатьСхемуКредитованияНаСервере(ДатаДок); 
		КонецЕсли;
	Иначе     
		Объект.СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Объект.Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		Объект.ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		Объект.ДатаВыкупа = Дата(1,1,1); 
		Объект.ДатаВыкупаЛьготная = Дата(1,1,1);  
		Объект.СрокЗалога = 0;
		Объект.ПроцентнаяСхема = 0;  
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;
	РасчетСуммыОценкиИтоговой();   
	Если НЕ СуммаЗайма = 0 Тогда	           
		Если НЕ ПСК = 0 Тогда
            СуммаПСКГод = СуммаЗайма*ПСК/100;  
		Иначе
			СуммаПСКГод = 0;
		КонецЕсли;				
		Если НЕ (СуммаПСКГод = 0) Тогда 
			Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
		        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
			КонецЕсли;	
	    КонецЕсли;	 
	КонецЕсли;	
    РассчитатьСуммуПроцентов();
КонецПроцедуры

&НаКлиенте
Процедура ПромокодПриИзменении(Элемент)
	ОбработатьПромокодНаСервере();
КонецПроцедуры

&НаСервере
Процедура РаспределитьСуммуЗайма()
	СуммаДляРаспределения = СуммаЗайма;
	Если СуммаДляРаспределения = 0 Тогда
		Возврат;
	КонецЕсли;	
	НомСтрМакс = 0; 
	МаксОценка = 0;
	МаксимальнаяОценкаИтог = Объект.Товары.Итог("СуммаОценкиМаксимальная");
	Для каждого Стр Из Объект.Товары Цикл 
		Коэфф = Стр.СуммаОценкиМаксимальная/МаксимальнаяОценкаИтог;
		Стр.СуммаСсуды = СуммаЗайма*Коэфф; 
		СуммаДляРаспределения = СуммаДляРаспределения - Стр.СуммаСсуды;
		Если Стр.СуммаОценкиМаксимальная > МаксОценка Тогда
			МаксОценка = Стр.СуммаОценкиМаксимальная;  
			НомСтрМакс = стр.НомерСтроки;
		КонецЕсли;	
	КонецЦикла;
	Если НЕ СуммаДляРаспределения = 0 Тогда
		Стр = Объект.Товары.Получить(НомСтрМакс);
		Стр.СуммаСсуды = Стр.СуммаСсуды + СуммаДляРаспределения;
	КонецЕсли;	
КонецПроцедуры
                                                           
&НаКлиенте
Процедура СуммаЗаймаПриИзменении(Элемент)  	 
	Если СуммаЗайма > Объект.Товары.Итог("СуммаОценкиМаксимальная") Тогда
		СуммаЗайма = ОкруглитьСуммуСсуды(Объект.Товары.Итог("СуммаОценкиМаксимальная"));  
	КонецЕсли;    
	РаспределитьСуммуЗайма();
	Объект.СуммаСсуды = СуммаЗайма;
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("СхемаКредитования", Объект.СхемаКредитования); 
		Отбор.Вставить("Акция", Объект.Акция);   
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(Отбор);
		Если НЕ СтрокиСК.Количество() = 0 Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			Объект.СхемаКредитования = СтрокаСК.СхемаКредитования;
			Объект.Акция = СтрокаСК.Акция; 
			ОбработатьСхемуКредитованияНаСервере(ДатаДок);
			ЗаполнитьТаблицуСтавок();
		КонецЕсли;	
	Иначе
		Объект.СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Объект.Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		Объект.ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		Объект.ДатаВыкупа = Дата(1,1,1); 
		Объект.ДатаВыкупаЛьготная = Дата(1,1,1);  
		Объект.СрокЗалога = 0;
		Объект.ПроцентнаяСхема = 0;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	
	Если НЕ СуммаЗайма = 0 Тогда	           
		Если НЕ ПСК = 0 Тогда
            СуммаПСКГод = СуммаЗайма*ПСК/100;  
		Иначе
			СуммаПСКГод = 0;
		КонецЕсли;				
		Если НЕ (СуммаПСКГод = 0) Тогда 
			Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
		        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
			КонецЕсли;	
	    КонецЕсли;	 
	КонецЕсли;    
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда	        
	    РассчитатьСуммуПроцентовПереоформление();
	Иначе
		РассчитатьСуммуПроцентов(); 
	КонецЕсли;	  
	//Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда 
	//	КВыдачеОплате = СуммаЗайма - СуммаОплатыПереоформление;
	//	Если КВыдачеОплате > 0 Тогда
	//	    Элементы.ДекорацияКВыдачеОплате.Заголовок = "К выдаче " + СокрЛП(Формат(КВыдачеОплате, "ЧЦ=15; ЧДЦ=2; ЧРД=,")) + " руб."; 
	//	Иначе     
	//		КВыдачеОплате = ?(КВыдачеОплате < 0, -КВыдачеОплате, КВыдачеОплате);
	//		Элементы.ДекорацияКВыдачеОплате.Заголовок = "К доплате " + СокрЛП(Формат(КВыдачеОплате, "ЧЦ=15; ЧДЦ=2; ЧРД=,")) + " руб.";
	//	КонецЕсли;	
	//Конецесли;	
КонецПроцедуры

