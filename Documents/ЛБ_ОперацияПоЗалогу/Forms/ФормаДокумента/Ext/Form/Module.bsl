
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ РольДоступна("Администрирование") И НЕ РольДоступна("АдминистраторСистемы") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	

	РольДоступнаПолныеПрава  		= РольДоступна("ПолныеПрава");
	//РольДоступнаПриемщикЛомбарда 	= РольДоступна("ПриемщикЛомбарда");
	//РольДоступнаяРучнойВыборКатЗал  = РольДоступна("ЮС_РучнойВыборКатегорииЗалогодателя"); 
		
	ДатаДок = ?(НЕ ЗначениеЗаполнено(Объект.Ссылка), ТекущаяДата(), Объект.Дата);  
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
			Объект.НомерЗалоговогоБилета = "";
		КонецЕсли;  
		ФИО = Объект.Залогодатель.Наименование;
		ИнформацияОДокументеВСтроку();	
		КонтактнаяИнформацияВСтроку();
		ЗаполнитьКонтакнуюИнформациюПредставителя();
		КонтактнаяИнформацияПредставителяВСтроку();
		Объект.Дата = ДатаДок;
		Объект.ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь; //Пользователи.ТекущийПользователь(); 
		Объект.ОтветственныйСотрудник    = ПараметрыСеанса.ТекущийСотрудник;
		Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
			ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
		ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда	
			ПричинаПримененияПроцентнойСхемы = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(Объект, Объект.ПредыдущаяОперация); 
		КонецЕсли;                          
		Если ЗначениеЗаполнено(Объект.ПредыдущаяОперация) Тогда 
			Объект.СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента(ДатаДок, Объект.ПредыдущаяОперация.Залогодатель);
		Иначе	
		    Объект.СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента(ДатаДок, Объект.Залогодатель);
		КонецЕсли;	
  	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Параметры.Свойство("ВидОперации") Тогда
			Объект.ВидОперации = Параметры.ВидОперации;
		КонецЕсли;  
		
		Объект.Дата = ДатаДок;
		Объект.ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь; //Пользователи.ТекущийПользователь(); 
		Объект.ОтветственныйСотрудник    = ПараметрыСеанса.ТекущийСотрудник; 
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	    //Объект.СхемаКредитования = Константы.ЛБ_ОсновнаяСхемаКредитования.Получить();  
		Объект.Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя(); 														       
		//Объект.СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента(ДатаДок, Объект.ПредыдущаяОперация.Залогодатель); 
		//ОбработатьСхемуКредитованияНаСервере(ДатаДок); 
		//РасчетСуммыОценкиИтоговой(); 			
		
		Если Параметры.Свойство("ПредыдущаяОперация") Тогда  
			Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога Тогда
				ПричинаПримененияПроцентнойСхемы = Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма;
			ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда	
				ПричинаПримененияПроцентнойСхемы = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияПроцентнойСхемы(Объект, Объект.ПредыдущаяОперация); 
			КонецЕсли; 	

			Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда
				ЗаполнитьЗначенияСвойств(Объект, Параметры.ПредыдущаяОперация, , "Ссылка, Номер, Дата, ВидОперации, Ломбард, ОтветственныйСотрудник, ОтветственныйПользователь, Товары, Вставки, ДополнительныеМеталлы, ДополнительныеДокументыПравоПребыванияРФ, Дефекты, ПроцентныеСтавкиПоПериодам, ГрафикПлатежей, НачислениеПроцентовДетально, ТоварыИзъятыеВозвращенные");
				Объект.Товары.Загрузить(Параметры.ПредыдущаяОперация.Товары.Выгрузить());
				Объект.Вставки.Загрузить(Параметры.ПредыдущаяОперация.Вставки.Выгрузить());
	            Объект.ДополнительныеМеталлы.Загрузить(Параметры.ПредыдущаяОперация.ДополнительныеМеталлы.Выгрузить());
	            Объект.ДополнительныеДокументыПравоПребыванияРФ.Загрузить(Параметры.ПредыдущаяОперация.ДополнительныеДокументыПравоПребыванияРФ.Выгрузить()); 
