&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если Объект.Проведен Тогда
		Сообщить("Для изменения даты документа необходимо отменить проведение!"); 
		Объект.Дата = ТекДата;
		Возврат;
	КонецЕсли;

	// Если выбрали дату до даты последней операции - отказ в изменении.
	Если ЗначениеЗаполнено(Объект.ПредыдущаяОперация) Тогда
		Если Объект.Дата < ПолучитьДатупредыдущейОперации() Тогда		
			Предупреждение("Дата текущей операции не может быть меньше даты залогового билета.", 60);
			Объект.Дата = ТекДата;
			Возврат;
		КонецЕсли;
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога") тогда  
	        Часы = (Объект.Дата - Объект.ПредыдущаяОперация.Дата)/3600;   
			Если Часы > 1 Тогда 
			   Предупреждение("Отмена залогового билета со времени выдачи которого прошло больше 1 часа невозможна.", 60); 
			   Объект.Дата = ТекДата;
			   Возврат;
			КонецЕсли;   
 		ИначеЕсли ЕстьОперацииСБолееПозднейДатой(Объект.ПредыдущаяОперация) Тогда 
				Предупреждение("У залогового билета есть операции с более поздней датой.", 60);
				Объект.Дата = ТекДата;
				Возврат;  
		КонецЕсли;	
	ИначеЕсли ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ЕстьОперацииСБолееПозднейДатой(Объект.Ссылка) Тогда 
			Предупреждение("У залогового билета есть операции с более поздней датой.", 60);
			Объект.Дата = ТекДата;
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	//// Проверка на 365 дней. Нельзя продлевать один билет через оплату процентов дольше года
	//Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда
	//	
