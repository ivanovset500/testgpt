&НаКлиенте
Процедура ОткрытьВыборДефектов()
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;   
	ОтборД = Новый Структура;
	ОтборД.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	СтрокиД = Объект.Дефекты.НайтиСтроки(ОтборД);
	Если НЕ СтрокиД.Количество() = 0 Тогда
		СписокДефектов = новый списокЗначений;
		ДругиеДефекты = "";
		Для каждого СтрД из СтрокиД Цикл 
			Если ТипЗнч(СтрД.Дефект) = Тип("СправочникСсылка.ЛБ_Дефекты") Тогда 
				СписокДефектов.Добавить(СтрД.Дефект);
			ИначеЕсли ТипЗнч(СтрД.Дефект) = Тип("Строка") Тогда
				ПараметрыФормы.Вставить("ДругиеДефекты", СтрД.Дефект);
	        КонецЕсли;
		Конеццикла;	 
		Если НЕ СписокДефектов.Количество() = 0 Тогда
		    ПараметрыФормы.Вставить("Дефекты", СписокДефектов);
		КонецЕсли;	 
	КонецЕсли;	
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДефектов",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ВыборДефектов", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыДефектыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьВыборДефектов();
КонецПроцедуры
  
 &НаКлиенте 
Процедура ПослеВыбораДефектов(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные; 
	ТекСтрока.Дефекты = "";
	ОтборД = Новый Структура;
	ОтборД.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	СтрокиД = Объект.Дефекты.НайтиСтроки(ОтборД);
	
	Для каждого стрД из СтрокиД Цикл 
		Объект.Дефекты.Удалить(СтрД);
	Конеццикла;	                   
	
	Для каждого Эл Из Результат.списокДефектов цикл 
		Если Эл.Пометка тогда 
			НоваяСтрД = Объект.Дефекты.Добавить();
			НоваяСтрД.Ключстроки = ТекСтрока.КлючСтроки; 
			НоваяСтрД.Дефект = Эл.Значение;
			
			ТекСтрока.Дефекты = ТекСтрока.Дефекты + ?(Пустаястрока(ТекСтрока.Дефекты), "", "; ") + сокрЛП(НоваяСтрД.Дефект);
		КонецЕсли;	
	Конеццикла;	 
	Если НЕ Пустаястрока(Результат.ДругиеДефекты) тогда 
		НоваяСтрД = Объект.Дефекты.Добавить();
		НоваяСтрД.Ключстроки = ТекСтрока.КлючСтроки; 
		НоваяСтрД.Дефект = Результат.ДругиеДефекты;
		
		ТекСтрока.Дефекты = ТекСтрока.Дефекты + ?(Пустаястрока(ТекСтрока.Дефекты), "", "; ") + сокрЛП(НоваяСтрД.Дефект);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕстьВставкиПриИзменении(Элемент)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные; 
	Если НЕ СтрокаТабличнойЧастиТовары.ЕстьВставки Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Строки = Объект.Вставки.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("У изделия есть вставки. Удалить вставки?", Режим, 0);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Для каждого стр из Строки Цикл 
					Объект.Вставки.Удалить(Стр);
				Конеццикла;	  
				ОбновитьДанныеТовары();
			Иначе
			    СтрокаТабличнойЧастиТовары.ЕстьВставки = Истина; 	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокДопМеталлов(Идентификатор)
	Стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	СписокПроб = Новый СписокЗначений;
    ОсновнойМеталл = Стр.Проба.Владелец; 
	
	ЗапросП = Новый Запрос;
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_Пробы.Ссылка КАК Проба
	                |ИЗ
	                |	Справочник.ЛБ_Пробы КАК ЛБ_Пробы
	                |ГДЕ
	                |	ЛБ_Пробы.Владелец = &Владелец
	                |	И ЛБ_Пробы.ПометкаУдаления = ЛОЖЬ
	                |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ОсновнойМеталл", ОсновнойМеталл);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДополнительныеМеталлыВИзделиях.ДополнительныйМеталл КАК ДополнительныйМеталл
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДополнительныеМеталлыВИзделиях КАК ЛБ_ДополнительныеМеталлыВИзделиях
	               |ГДЕ
	               |	ЛБ_ДополнительныеМеталлыВИзделиях.ОсновнойМеталл = &ОсновнойМеталл
	               |АВТОУПОРЯДОЧИВАНИЕ";  
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапросП.УстановитьПараметр("Владелец", Выборка.ДополнительныйМеталл); 
		ВыборкаП = ЗапросП.Выполнить().Выбрать();
		Пока ВыборкаП.Следующий() Цикл 
			СписокПроб.Добавить(ВыборкаП.Проба);
		Конеццикла;	
	Конеццикла;	 
	
	Возврат СписокПроб;
КонецФункции

&НаКлиенте
Процедура ТоварыЕстьДопМеталлыПриИзменении(Элемент)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные; 
	Если НЕ СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Строки = Объект.ДополнительныеМеталлы.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Вопрос("У изделия есть дополнительные металлы. Удалить доп. металлы?", Режим, 0);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Для каждого стр из Строки Цикл 
					Объект.ДополнительныеМеталлы.Удалить(Стр);
				Конеццикла;	  
			Иначе
			    СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы = Истина;  
			КонецЕсли;
		КонецЕсли;          
	КонецЕсли;
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
КонецПроцедуры

&НаКлиенте
Процедура Этикетка(Команда)  
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда 
		Если СтрокаТабличнойЧастиТовары.ЕстьЭтикетка Тогда 
			СсылкаНаЭтикетку = СтрокаТабличнойЧастиТовары.Этикетка; 
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЭтикетки",ЭтаФорма);
			Если ЗначениеЗаполнено(СсылкаНаЭтикетку) Тогда
				ПараметрыФормы = Новый Структура("Ключ", СсылкаНаЭтикетку);
			Иначе					
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Дата", Объект.Дата);
				ПараметрыФормы.Вставить("Залогодатель", Объект.Залогодатель);
			КонецЕсли;	
			ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЭтикетки",ЭтаФорма);  
			ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры   


&НаСервере  
Процедура СохранитьЭтикетку(ИдентификаторСтроки, Картинка)
	Стр = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки); 
	ОБ = РеквизитФормыВЗначение("Объект");
    СтрокаТ = ОБ.Товары.Найти(стр.КлючСтроки, "КлючСтроки");  		
	
	СтрокаТ.Этикетка = Новый ХранилищеЗначения(Картинка);
КонецПроцедуры	

&НаКлиенте 
Процедура ПослеВыбораЭтикетки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	ТекСтрока = Элементы.Товары.ТекущиеДанные;
	ТекСтрока.Этикетка = Результат;
	ТекСтрока.ЕстьФайл = истина;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕстьФайлНажатие(Элемент, СтандартнаяОбработка)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;  
	Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда
		СсылкаНаЭтикетку = ТекСтрока.Этикетка;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", СсылкаНаЭтикетку); 
		ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
		ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;	
КонецПроцедуры

&НаСервере  
Процедура УдалитьСканЭтикетки(Этикетка)
	ОбъектЭ = Этикетка.получитьОбъект();
	ОбъектЭ.УстановитьПометкуУдаления(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЭтикеткаУдалить(Команда)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;  
	Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда 
		УдалитьСканЭтикетки(ТекСтрока.Этикетка);
		ТекСтрока.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка");  
		ТекСтрока.ЕстьФайл = ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	Если Поле.Имя = "ТоварыЕстьФайл" тогда
		ТекСтрока = Элементы.Товары.ТекущиеДанные;  
		Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда
			СсылкаНаЭтикетку = ТекСтрока.Этикетка;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ", СсылкаНаЭтикетку); 
			ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
			ОткрытьФорму("Справочник.ЛБ_ХранилищеЭтикеток.ФормаОбъекта", Параметрыформы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		КонецЕсли;	 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕстьЭтикеткаПриИзменении(Элемент)
	ТекСтрока = Элементы.Товары.ТекущиеДанные;  
	Если ЗначениеЗаполнено(ТекСтрока.Этикетка) тогда 
		УдалитьСканЭтикетки(ТекСтрока.Этикетка);
		ТекСтрока.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка");  
		ТекСтрока.ЕстьФайл = ложь;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОценкуЗалогаИзъятие(Идентификатор) 
	СтрИ = Объект.ТоварыИзъятыеВозвращенные.НайтиПоИдентификатору(Идентификатор);  
	Отбор = новый Структура;
	Отбор.Вставить("ОбъектЗалога", СтрИ.ОбъектЗалога);
	СтрокиТ = Объект.ПредыдущаяОперация.Товары.НайтиСтроки(Отбор);
	Если СтрокиТ.Количество() = 0 тогда
		СтрИ.СуммаОценки = 0;
	Иначе  
		СтрИ.СуммаОценки = СтрокиТ.Получить(0).СуммаОценки;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыИзъятыеОбъектЗалогаПриИзменении(Элемент)
	ТекСтрока = Элементы.ТоварыИзъятые.ТекущиеДанные; 
	ЗаполнитьОценкуЗалогаИзъятие(ТекСтрока.ПолучитьИдентификатор());
