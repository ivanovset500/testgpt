		Объект.ДокументПредставителя = Параметры.ДокументЗалогодателя;
		ЗаполнитьИнформациюОДокументеПредставителя();
		ИнформацияОДокументеПредставителяВСтроку();
	КонецЕсли;	
	ЗаполнитьКонтакнуюИнформациюПредставителя();
	КонтактнаяИнформацияПредставителяВСтроку();
КонецПроцедуры

&НаСервере
Функция ПроверитьСлужебныйСтатус(Статус)  
	СтруктураРез = Новый Структура;
	СтруктураРез.Вставить("Запрет", ложь); 
	СтруктураРез.Вставить("Предупредить", "");
	ОтборС = Новый Структура("ВидОперации", Объект.ВидОперации);
	СтрокиС = Статус.ЗапретНаОперации.НайтиСтроки(ОтборС);
	Если НЕ СтрокиС.Количество() = 0 Тогда 
		СтруктураРез.Запрет = Истина; 
	КонецЕсли;	
	Если Статус.Предупредить Тогда
		Информация = Статус.ДопИнформация.Получить(); 
		СтруктураРез.Предупредить = Информация.ПолучитьТекст();
	КонецЕсли;	
	Возврат СтруктураРез;
КонецФункции

&НаСервере
Процедура ОбновитьДанныеТовары() 
	Для Каждого Стр Из Объект.Товары Цикл  
		Отбор = новый структура;
		Отбор.Вставить("КлючСтроки", Стр.КлючСтроки); 
		СтрокиВ = Объект.Вставки.НайтиСтроки(Отбор);
		Стр.КоличествоВ = СтрокиВ.Количество();
		Стр.ЕстьФайл = ?(ЗначениеЗаполнено(Стр.Этикетка), истина, ложь);
	Конеццикла;	
КонецПроцедуры 

&НаСервере
Функция ПроверкаНеОценивать(ВидВставки, КатегорияЗалога)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ВидКамня", ВидВставки); 
	Запрос.УстановитьПараметр("Категория", КатегорияЗалога);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ПараметрыОценкиВставокВОбъектахЗалога.Оценивается КАК Оценивается
	              |ИЗ
	              |	РегистрСведений.ЛБ_ПараметрыОценкиВставокВОбъектахЗалога КАК ЛБ_ПараметрыОценкиВставокВОбъектахЗалога
	              |ГДЕ
	              |	ЛБ_ПараметрыОценкиВставокВОбъектахЗалога.ВидКамня = &ВидКамня
	              |	И ЛБ_ПараметрыОценкиВставокВОбъектахЗалога.КатегорияОбъектаЗалога = &Категория"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат НЕ Выборка.Оценивается;
	КонецЕсли;	
	Возврат Истина;
КонецФункции	

&НаСервере
Процедура ОбновитьДанныеВставки() 
	Для Каждого СтрТовары Из Объект.Товары Цикл 
		Отбор = новый Структура;
		Отбор.Вставить("КлючСтроки", СтрТовары.КлючСтроки);
		Строки = Объект.Вставки.НайтиСтроки(Отбор);
		Для Каждого Стр Из Строки Цикл  
			Если Стр.Вид = Перечисления.ЛБ_ВидыКомплектующихИзделия.Вставка Тогда
				Если ЗначениеЗаполнено(Стр.ВидВставки) И Стр.ВидВставки.НеОценивается Тогда
					Стр.ПроверкаНеОценивать = Истина;
				ИначеЕсли ЗначениеЗаполнено(Стр.ВидОгранки) И Стр.ВидОгранки.НеОценивается Тогда
					Стр.ПроверкаНеОценивать = Истина;
				Иначе 
				    Стр.ПроверкаНеОценивать = ПроверкаНеОценивать(Стр.ВидВставки, СтрТовары.Категория);
				КонецЕсли;	
			КонецЕсли;	
		Конеццикла;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	// СтандартныеПодсистемы.ПодключаемыеКоманды 
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
	СписокСС = ПолучитьСлужебныеСтатусыКлиента(Объект.Залогодатель);
	Если НЕ СписокСС.Количество() = 0 Тогда 
		ПредупреждениеП = "";
		Для каждого Элемент из СписокСС Цикл 
			СтруктураВозврата = ПроверитьСлужебныйСтатус(Элемент.Значение);
			Если СтруктураВозврата.Запрет Тогда 
				Если НЕ Пустаястрока(СтруктураВозврата.Предупредить) Тогда
				    Предупреждение(СтруктураВозврата.Предупредить, 60, "Проверка служебных статусов клиента");
				КонецЕсли;	
				Отказ = Истина;
				Возврат;  
			Иначе
				ПредупреждениеП = СтруктураВозврата.Предупредить;
			КонецЕсли;	
		КонецЦикла;   
		Если НЕ ПустаяСтрока(ПредупреждениеП) Тогда
			Ответ = Вопрос(ПредупреждениеП + " Продолжить?", РежимДиалогаВопрос.ОКОтмена); 
			Если Ответ = КодВозвратаДиалога.Отмена Тогда  
				Отказ = Истина;
			    Возврат;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;   
	
	Если НЕ Объект.ДополнительныеДокументыПравоПребыванияРФ.Количество() = 0 Тогда
		Элементы.ГруппаПравоПребываниеРФ.Показать(); 
	КонецЕсли;
	ОбновитьДанныеТовары(); 
	ОбновитьДанныеВставки();		
	УстановитьОформление();
	Активизировать();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") тогда
		    ЗалоговыйБилет = Объект.Ссылка;
		Иначе 
			ЗалоговыйБилет = Объект.ПредыдущаяОперация;
		КонецЕсли;   
		Если ЕстьОперацииСБолееПозднейДатой(ЗалоговыйБилет) тогда
			Элементы.ОсновнаяПанель.ТолькоПросмотр = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда
	    Элементы.ГруппаТабличныеЧасти.ТолькоПросмотр = Истина; 
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаЗакладываемоеИмущество; 		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда
		Элементы.ГруппаДанныеПредставителя.Видимость = Истина;
	    Если ЗначениеЗаполнено(Объект.Представитель) Тогда
			Элементы.ГруппаДанныеПредставителя.Показать();
		КонецЕсли;   
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога") Тогда	
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаИзъятие;   
		ЗаполнитьСписокВыбораИзъятия();   
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога") Тогда	
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаВозврат;   
		ЗаполнитьСписокВыбораВозврат();	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога") Тогда	
	    Элементы.СтраницаЗалогодатель.ТолькоПросмотр = Истина; 
		Элементы.СтраницаЗакладываемоеИмущество.ТолькоПросмотр = Истина;
		Элементы.Организация.ТолькоПросмотр = Истина;
		Элементы.Ломбард.ТолькоПросмотр = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.ГруппаВставок.Доступность = ложь; 
		Элементы.ГруппаДопМеталлы.Доступность = ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформление()
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") ИЛИ 
	Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда 
		Элементы.ОтказОтВыкупа.Видимость = Истина;
	Иначе
		Элементы.ОтказОтВыкупа.Видимость = Ложь;
    КонецЕсли;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов") Тогда
		Элементы.ДекорацияИиформацияЗалогодатель.Заголовок = "Информация о плательщике";
		Элементы.СтраницаЗалогодатель.Заголовок = "Плательщик";
		Элементы.СуммаЗайма.Заголовок = "Долг по займу";
		Элементы.СуммаПроцентов.Заголовок = "Долг по процентам";
		Элементы.ИнформацияОЗалогодателе.Видимость = Истина;		
		Элементы.СтатусЗалогодателя.ТолькоПросмотр = Истина;
		Элементы.СхемаКредитования.ТолькоПросмотр = Истина;
		Элементы.ГруппаПараметрыВыкупаОплаты.Видимость = Истина;		
		Элементы.КнопкаРасчеты.Видимость = Истина; 
		Элементы.Промокод.Видимость = ложь;  
		Элементы.ТоварыСуммаОплаты.Видимость = Истина;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога") Тогда
		Элементы.ДекорацияИиформацияЗалогодатель.Заголовок = "Информация о получателе";
		Элементы.СтраницаЗалогодатель.Заголовок = "Получатель";
		Элементы.СуммаЗайма.Заголовок = "Долг по займу";
		Элементы.СуммаПроцентов.Заголовок = "Долг по процентам";
		Элементы.ИнформацияОЗалогодателе.Видимость = Истина;		
		Элементы.СтатусЗалогодателя.ТолькоПросмотр = Истина;
		Элементы.СхемаКредитования.ТолькоПросмотр = Истина;
		Элементы.ГруппаПараметрыВыкупаОплаты.Видимость = ложь;		
		Элементы.КнопкаРасчеты.Видимость = ложь;  
		Элементы.ДатаВыкупаЛьготная.Видимость = Ложь;
		Элементы.Промокод.Видимость = ложь;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда
		Элементы.ГруппаПереоформление.Видимость = Истина;  
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога") Тогда
	    Элементы.СтраницаИзъятие.Видимость = Истина;
		Элементы.СтраницаЗакладываемоеИмущество.Видимость = Ложь;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ВозвратОбъектовЗалога") Тогда
	    Элементы.СтраницаВозврат.Видимость = Истина;
		Элементы.СтраницаЗакладываемоеИмущество.Видимость = Ложь;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды 
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	ОбновитьДанныеТовары();
	ОбновитьДанныеВставки();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) 
	Возврат;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СуммаСсуды = Объект.Товары.Итог("СуммаСсуды");
		
	Если Параметры.Ключ.Пустая() тогда
		
		врДата = ТекущаяДата();
		
	Иначе
		
		врДата = Объект.Дата;
		
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		//Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда
			Отказ = НЕ ПроверкаЗаполнения();
		//КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ПроцентнаяСхема) Тогда 
			Если НЕ (СтатусЗБ = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Изъят") ИЛИ СтатусЗБ = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыЗалоговыхБилетов.Возвращен")) Тогда
				Сообщить("Не выбрана схема расчета процентов!");
				Отказ = Истина;  
			КонецЕсли;	
		ИначеЕсли НЕ СуммаЗайма = 0 Тогда	           
			Если НЕ ПСК = 0 Тогда
	            СуммаПСКГод = СуммаЗайма*ПСК/100;  
			Иначе
				СуммаПСКГод = 0;
			КонецЕсли;				
			Если НЕ (СуммаПСКГод = 0) Тогда 
				Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
			        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
				КонецЕсли;	
		    КонецЕсли;	 
		КонецЕсли;
		
		Если НЕ Объект.ДополнительныеМеталлы.Количество() = 0  Тогда 
			Для каждого Стр из объект.Товары Цикл 
				Если Стр.ЕстьДопМеталлы И НЕ Стр.ЕстьЭтикетка Тогда   
					Сообщить("В строке № " + Строка(Стр.НомерСтроки) + " есть дополнительные металлы, но нет этикетки!");
			        Отказ = Истина;
				КонецЕсли;	
			Конеццикла;
        КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
				
	КонецЕсли;	
		
	// Присвоение серий при проведении.
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") И 
		ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл						
			Результат = СоздатьОбъектЗалога(СтрокаТабличнойЧасти.ПолучитьИдентификатор());				
			Если НЕ Результат Тогда
				Сообщить("Не создан объект залога по строке № " + Строка(СтрокаТабличнойЧасти.НомерСтроки), Статуссообщения.Важное);
				Отказ = Истина;
				Прервать
			КонецЕсли;	
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьОбъектЗалога(Идентификатор)
	СтрокаТабличнойЧастиТовары = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	Возврат ЛБ_УправлениеЛомбардом.СоздатьОбъектЗалога(Объект, СтрокаТабличнойЧастиТовары);
КонецФункции	

&НаСервере
Процедура ПроверитьКлиентаПоПеречням(Отказ)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Объект.Залогодатель);  
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И СтатусКлиентаВПеречне = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыКлиентаВПеречнях.Включен)) КАК ЛБ_КлиентыВПеречняхСрезПоследних"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
			Сообщить("Клиент найден в перечне террористов. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
			Отказ = Истина;
		ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
			Сообщить("Клиент найден в перечне ФРОМУ. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
			Отказ = Истина;
        ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
			Сообщить("Клиент найден в списке МВК. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
			Отказ = Истина;	
		КонецЕсли;	
	Конеццикла;	
КонецПроцедуры	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 
	Возврат;
	Если ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления Тогда
		Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ПредыдущаяОперация) Тогда
			Сообщить("Не выбран документ переоформления займа!");
			Отказ = Истина;
		КонецЕсли;                                            
		Возврат;
	ИначеЕсли ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Тогда
		Если ТекущийОбъект.СуммаОплаты = 0 Тогда
			Сообщить("Не определена сумма оплаты! Документ не может быть записан.");
			Отказ = Истина;
		КонецЕсли;  
	ИначеЕсли ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
		Если НЕ ЗначениеЗаполнено(ПлательщикПереоформление) Тогда
			Если ЗначениеЗаполнено(Объект.ОперацияВыкупаПереоформление) Тогда 
				ПлательщикПереоформление = Объект.ОперацияВыкупаПереоформление.Залогодатель;
				ДоверенностьПлательщикаПереоформление = Объект.ОперацияВыкупаПереоформление.ДоверенностьПредставителя;
			КонецЕсли;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Объект.ПредыдущаяОперация) Тогда
			Сообщить("Не определен предыдущий залоговый билет для создания операции выкупа! Документ не может быть записан.");
			Отказ = Истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ПлательщикПереоформление) Тогда
			Сообщить("Не определен плательщик для создания операции выкупа! Документ не может быть записан.");
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Объект.ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(Объект.ДатаРождения);
	Если Объект.ВозрастЗалогодателя  < 18 Тогда
	    Сообщить("Клиенту " + Строка(Объект.ВозрастЗалогодателя) + " лет, выдача займов несовершеннолетним не осуществляется!", СтатусСообщения.Важное);
		Отказ = Истина;
	КонецЕсли;	
	
	ПроверитьКлиентаПоПеречням(Отказ);
	
	Если ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда  
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если ЗначениеЗаполнено(Объект.ОперацияВыкупаПереоформление) Тогда 
		         ДокОбъектВыкупа = Объект.ОперацияВыкупаПереоформление.ПолучитьОбъект();
				 ТекущийОбъект.ОперацияВыкупаПереоформление = Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка();
				 ОперацияВыкупа = СоздатьОперациюВыкупаЗалога(ДокОбъектВыкупа);
			Иначе	
			     ОперацияВыкупа = СоздатьОперациюВыкупаЗалога(); 
			КонецЕсли;	 
			Если ОперацияВыкупа = неопределено Тогда 
				Сообщить("Не создана операция выкупа залога", СтатусСообщения.Важное);
				Отказ = Истина;   
			Иначе
				ТекущийОбъект.ОперацияВыкупаПереоформление = ОперацияВыкупа;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	

	Если Отказ Тогда
		Возврат;
	КонецЕсли;      
	
	Если ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог Или ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
		Если  НЕ ЗначениеЗаполнено(ТекущийОбъект.НомерЗалоговогоБилета) Тогда
			НомерЗБ = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерЗалоговогоБилета(ТекущийОбъект.Ломбард);
			//Если НомерЗБ = неопределено Тогда
			//	Сообщить("Не определен номер залогового билета! Документ не может быть записан.");
			//	Отказ = Истина;
			//Иначе	
			//    ТекущийОбъект.НомерЗалоговогоБилета = НомерЗБ;
			//	//запишем залоговый билет в используемые
			//	НоваяЗапись = РегистрыСведений.ЛБ_ИспользованныеЗалоговыеБилеты.СоздатьМенеджерЗаписи();
			//    НоваяЗапись.Организация = Объект.Организация;
			//    НоваяЗапись.Ломбард = Объект.Ломбард;
			//	НоваяЗапись.Номер = НомерЗБ; 
			//	НоваяЗапись.Количество = 1;
			//    НоваяЗапись.Записать();
			//КонецЕсли;    
			Если ПустаяСтрока(НомерЗБ) Тогда
				Сообщить("Не определен номер залогового билета! Документ не может быть записан.");
				Отказ = Истина;
			Иначе	
			    ТекущийОбъект.НомерЗалоговогоБилета = НомерЗБ;
            КонецЕсли;
		КонецЕсли;
	КонецЕсли;       
	
	Если ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов И Объект.СхемаКредитования.ПризнакПримененияГибкогоПроцента Тогда
		//заполним новый график платежей если нужно
		Если НЕ Объект.СхемаКредитования.БезПродленияДоговора Тогда
			Если Объект.Выкуп Тогда
	            ПродлитьДоговорДни = 0;				
			Иначе	
				ПроцентДляПродленияДоговора = ?(СуммаПроцентов = 0, 0, Объект.СуммаОплатыПроценты/СуммаПроцентов);
				Если ПроцентДляПродленияДоговора >= 0.9 Тогда 
					//КолДней = (НачалоДня(Объект.Дата)-НачалоДня(ДатаНачалаРасчета)) / (60 * 60 * 24);
					//СуммаПроцентовДень = СуммаПроцентов/?(КолДней = 0, 1, КолДней); 
					//Коэфф = Объект.СуммаОплатыПроценты/СуммаПроцентовДень;
					//ПродлитьДоговорДни = Цел(Коэфф)+ ?(Коэфф = Цел(Коэфф), 0, 1); 
					КолДней = Окр(Объект.СрокЗалога*ПроцентДляПродленияДоговора, 3);
					Если Цел(КолДней) = КолДней тогда
						ПродлитьДоговорДни = КолДней;
					Иначе 
						ПродлитьДоговорДни = Цел(КолДней) + 1; 
					КонецЕсли;	
				Иначе      
					ПродлитьДоговорДни = 0;
				КонецЕсли;   
			КонецЕсли;	
		Иначе
			ПродлитьДоговорДни = 0;
		КонецЕсли;
		
		Если  НЕ (ПродлитьДоговорДни = 0) Тогда
			ПричинаПримененияНовая = ЛБ_УправлениеЛомбардом.ПолучитьПричинуПримененияГибкийПроцент(Объект.СхемаКредитования, Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Продлен);
			ОтборС = Новый структура;
			ОтборС.Вставить("Причина", ПричинаПримененияНовая);
			СтрокиС = Объект.ПредыдущаяОперация.ПроцентныеСтавкиПоПериодам.НайтиСтроки(ОтборС);
			ДатаНачала = НачалоДня(Объект.Дата) + (60 * 60 * 24);
			НоваяДатаВыкупа = Объект.ДатаВыкупа + ПродлитьДоговорДни*(60 * 60 * 24);
			Для сч = 0 По СтрокиС.Количество()-1 Цикл 
				СтрС = СтрокиС.Получить(сч); 
				Если СтрС.ДеньНачалаПрименения = 1 Тогда
					ДатаНач = ДатаНачала;
				Иначе 
					ДатаНач = НачалоДня(ДатаНачала + СтрС.ДеньНачалаПрименения*(60 * 60 * 24));
				КонецЕсли;	
				Если ДатаНач > НоваяДатаВыкупа Тогда 
			 		Прервать;
				КонецЕсли;	
				
				сч1 = сч + 1;
				Если сч1 >= СтрокиС.Количество() Тогда
					ДатаКон = НоваяДатаВыкупа; 
					ДеньКон = (НоваяДатаВыкупа - ДатаНач) / (60 * 60 * 24);
				Иначе   
					СтрС1 = СтрокиС.Получить(сч1);
					ДатаКонца = НачалоДня(ДатаНачала + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24)); 
					Если ДатаКонца > Объект.ДатаВыкупа Тогда
						ДатаКон = НоваяДатаВыкупа; 
					    ДеньКон = (НоваяДатаВыкупа - ДатаНач) / (60 * 60 * 24);
					Иначе
						ДатаКон = ДатаКонца; 
						ДеньКон = СтрС1.ДеньНачалаПрименения-1;
					КонецЕсли;	
				КонецЕсли;	
				
				Если НЕ (НачалоДня(ДатаКон) < НачалоДня(ДатаНач)) тогда		
					СтрП = Объект.ГрафикПлатежей.Добавить();   
					СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
					СтрП.ДатаНач = ДатаНач;
					СтрП.ДатаКон = ДатаКон;
					СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
					СтрП.ДеньКон = ДеньКон; 
					СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
					СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
					СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
					СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;  
					ОтборП = Новый Структура;
					ОтборП.Вставить("ДеньНач", СтрС.ДеньНачалаПрименения);
					СтрокиП = Объект.НачислениеПроцентовДетально.НайтиСтроки(ОтборП);
					Если НЕ СтрокиП.Количество() = 0 Тогда
		                СтрП.СуммаПроцентов = СтрокиП.Получить(0).СуммаПроцентов;
						СтрП.СуммаПроцентовДень = СтрокиП.Получить(0).СуммаПроцентовДень; 
					КонецЕсли;	
				КонецЕсли;	
			Конеццикла;	
		КонецЕсли;	
	КонецЕсли;

	
	Если ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов Или ТекущийОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
	    Константы.ЛБ_УсловиеПроверкиОперацииПоЗалогу.Установить(Истина);
	КонецЕсли;   
КонецПроцедуры

&НаСервере
Функция СоздатьОперациюВыкупаЗалога(ДокОбъектВыкупа = неопределено) 
	Если НЕ ДокОбъектВыкупа = неопределено Тогда 
		НовыйОбъект = ДокОбъектВыкупа;
	Иначе	
	    НовыйОбъект = Документы.ЛБ_ОперацияПоЗалогу.СоздатьДокумент(); 
	КонецЕсли;	
	НовыйОбъект.Дата = Объект.Дата-1;
	НовыйОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов;
	НовыйОбъект.ПредыдущаяОперация = Объект.ПредыдущаяОперация;
	НовыйОбъект.Залогодатель = ПлательщикПереоформление; 
	ЗаполнитьКонтакнуюИнформациюПлательщика(НовыйОбъект); 
	НовыйОбъект.ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(НовыйОбъект.ДатаРождения);
	НовыйОбъект.ДоверенностьПредставителя = ДоверенностьПлательщикаПереоформление;
	Если ПлательщикПереоформление = Объект.Залогодатель Тогда 
		НовыйОбъект.ДокументЗалогодателя = Объект.ДокументЗалогодателя; 
		НовыйОбъект.ДополнительныеДокументыПравоПребыванияРФ.Очистить();
		Отбор = Новый Структура;
		Отбор.Вставить("Клиент", Объект.Залогодатель);  
		Строки = Объект.ДополнительныеДокументыПравоПребыванияРФ.НайтиСтроки(Отбор);
		Для каждого стр Из Строки цикл  
			Новаястр = НовыйОбъект.ДополнительныеДокументыПравоПребыванияРФ.Добавить();
			Новаястр.Клиент = НовыйОбъект.Залогодатель;
			Новаястр.ВидДокумента = стр.ВидДокумента;
			Новаястр.ВидДокументаЗалогодателя = стр.ВидДокументаЗалогодателя; 
			Новаястр.ДокументГражданство = стр.ДокументГражданство;
			Новаястр.ДокументДатаВыдачи = стр.ДокументДатаВыдачи;
			Новаястр.ДокументЗалогодателя = стр.ДокументЗалогодателя; 
			Новаястр.ДокументКемВыдан = стр.ДокументКемВыдан;
			Новаястр.ДокументКодПодразделения = стр.ДокументКодПодразделения;
			Новаястр.ДокументНачалоДействия = стр.ДокументНачалоДействия;
			Новаястр.ДокументНомер = стр.ДокументНомер; 
			Новаястр.ДокументСерия = стр.ДокументСерия;
			Новаястр.ДокументСрокДействия = стр.ДокументСрокДействия;				
		КонецЦикла;		
	ИначеЕсли ПлательщикПереоформление = Объект.Представитель Тогда  
		НовыйОбъект.ДокументЗалогодателя = Объект.ДокументПредставителя;
		Отбор = Новый Структура;
		Отбор.Вставить("Клиент", Объект.Представитель);  
		Строки = Объект.ДополнительныеДокументыПравоПребыванияРФ.НайтиСтроки(Отбор);
		Для каждого стр Из Строки цикл  
			Новаястр = НовыйОбъект.ДополнительныеДокументыПравоПребыванияРФ.Добавить();
			Новаястр.Клиент = НовыйОбъект.Залогодатель;
			Новаястр.ВидДокумента = стр.ВидДокумента;
			Новаястр.ВидДокументаЗалогодателя = стр.ВидДокументаЗалогодателя; 
			Новаястр.ДокументГражданство = стр.ДокументГражданство;
			Новаястр.ДокументДатаВыдачи = стр.ДокументДатаВыдачи;
			Новаястр.ДокументЗалогодателя = стр.ДокументЗалогодателя; 
			Новаястр.ДокументКемВыдан = стр.ДокументКемВыдан;
			Новаястр.ДокументКодПодразделения = стр.ДокументКодПодразделения;
			Новаястр.ДокументНачалоДействия = стр.ДокументНачалоДействия;
			Новаястр.ДокументНомер = стр.ДокументНомер; 
			Новаястр.ДокументСерия = стр.ДокументСерия;
			Новаястр.ДокументСрокДействия = стр.ДокументСрокДействия;				
		КонецЦикла;		
	КонецЕсли;
	ЗаполнитьИнформациюОДокументеПлательщика(НовыйОбъект);
	
	НовыйОбъект.Товары.Загрузить(Объект.ПредыдущаяОперация.Товары.Выгрузить());
	НовыйОбъект.Вставки.Загрузить(Объект.ПредыдущаяОперация.Вставки.Выгрузить());
    НовыйОбъект.ДополнительныеМеталлы.Загрузить(Объект.ПредыдущаяОперация.ДополнительныеМеталлы.Выгрузить());
		   
	СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(НовыйОбъект, НовыйОбъект.ПредыдущаяОперация);
	НовыйОбъект.ДатаВыкупа = СтруктураРез.ДатаВыкупа;
	НовыйОбъект.ДатаВыкупаЛьготная = СтруктураРез.ДатаВыкупаЛьготныйСрок;
	НовыйОбъект.СуммаСсуды = СтруктураРез.СуммаЗайма;
	НовыйОбъект.СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента(ТекущаяДата(), НовыйОбъект.Залогодатель);
	НовыйОбъект.Акция = НовыйОбъект.ПредыдущаяОперация.Акция;	
	НовыйОбъект.НомерЗалоговогоБилета = НовыйОбъект.ПредыдущаяОперация.НомерЗалоговогоБилета;
	НовыйОбъект.Организация = НовыйОбъект.ПредыдущаяОперация.Организация;
	НовыйОбъект.Ломбард = Объект.Ломбард;
	НовыйОбъект.СхемаКредитования = НовыйОбъект.ПредыдущаяОперация.СхемаКредитования;  
	НовыйОбъект.ПроцентнаяСхема = НовыйОбъект.ПредыдущаяОперация.ПроцентнаяСхема; 
	НовыйОбъект.ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
	НовыйОбъект.ОтветственныйСотрудник    = ПараметрыСеанса.ТекущийСотрудник;
	НовыйОбъект.СуммаОплаты = СуммаОплатыПереоформление;
	НовыйОбъект.СуммаОплатыПроценты = СуммаОплатыПроцентыПереоформление;
	НовыйОбъект.СуммаОплатыСсуда = СуммаОплатыСсудаПереоформление;
	НовыйОбъект.Выкуп = Истина; 
	НовыйОбъект.ВыдачаЗалога = Истина; 	
		
	Попытка 
		НовыйОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат НовыйОбъект.Ссылка; 
	Исключение     
		Возврат неопределено;
	КонецПопытки;
КонецФункции    

&НаСервере
Процедура ЗаполнитьКонтакнуюИнформациюПлательщика(ДокументВыкупа)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Залогодатель", ДокументВыкупа.Залогодатель);
    Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Пол КАК Пол,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
                   |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
                   |ИЗ
                   |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументВыкупа.Фамилия = Выборка.Фамилия;
        ДокументВыкупа.Имя = Выборка.Имя;
        ДокументВыкупа.Отчество = Выборка.Отчество;		
		ДокументВыкупа.ДатаРождения = Выборка.ДатаРождения;		
		ДокументВыкупа.Гражданство = Выборка.Гражданство;
		ДокументВыкупа.Пол = Выборка.Пол;
    КонецЕсли;
КонецПроцедуры	   

&НаСервере
Процедура ЗаполнитьИнформациюОДокументеПлательщика(ДокументВыкупа)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("ДокументЗалогодателя", ДокументВыкупа.ДокументЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокументВыкупа.ДокументВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя;
		ДокументВыкупа.ДокументВид = Выборка.ВидДокумента;
		ДокументВыкупа.ДокументГражданство = Выборка.Гражданство;
		ДокументВыкупа.ДокументСерия = Выборка.ДокументСерия;
		ДокументВыкупа.ДокументНомер = Выборка.ДокументНомер;
		ДокументВыкупа.ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи;
		ДокументВыкупа.ДокументКемВыдан = Выборка.ДокументКемВыдан;
		ДокументВыкупа.ДокументКодПодразделения = Выборка.ДокументКодПодразделения;
		ДокументВыкупа.ДокументНачалоДействия = Выборка.ДокументНачалоДействия;
		ДокументВыкупа.ДокументСрокДействия = Выборка.ДокументСрокДействия;
	КонецЕсли;	
КонецПроцедуры	

