	//		
	//		Объект.Дата = ТекущаяДата();
	//		Сообщить("По данному залоговому билету невозможно продление - прошли 365 от даты залога (" + Формат(ЗалоговыйБилетОбъект.ДатаЗалога,"ДЛФ=ДД") + ")");
	//		
	//		Возврат;
	//		
	//	КонецЕсли;
	//	
	//КонецЕсли;
	ТекДата = Объект.Дата; 
	ДатаДок = Объект.Дата;
	ЗаполнитьИнформациюОКлиенте();  
		
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог") ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда		

		// пересчитаем цену металлов и камней
		//Для каждого СтрокаТабличнойЧастиТовары Из Объект.Товары Цикл
		//	ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
		//	
		//	ОтборВ = Новый Структура;
		//	ОтборВ.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		//	Строки = Объект.Вставки.НайтиСтроки(ОтборВ);
		//	Для каждого СтрокаТабличнойЧасти Из Строки Цикл		
		//	    ЦенаДрагоценногоКамня(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
		//	КонецЦикла;	
		//	СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = Объект.Вставки.Итог("Сумма");
		//	ПересчитатьСуммТовары(СтрокаТабличнойЧастиТовары); 
		//КонецЦикла;	   
		Объект.СтатусЗалогодателя = ПолучитьТекущийСтатусКлиента(ДатаДок, Объект.Залогодатель);
		ПолучитьДопСтатусыКлиента();  
		ЗаполнитьСписокЛьготныхСтатусов();
		СтатусыКлиентаВСтроку();

		ПолучитьДоступныеПроцентныеСхемыАкции();				
		Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда  
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", Объект.СхемаКредитования); 
			Отбор.Вставить("Акция", Объект.Акция);   
			СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(Отбор);
