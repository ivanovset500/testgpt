&НаКлиенте
Процедура ДополнительныеМеталлыВесПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ДополнительныеМеталлы.ТекущиеДанные;
	СтрокаТабличнойЧасти.СуммаОценкиМеталлы = СтрокаТабличнойЧасти.ВесЧистый * СтрокаТабличнойЧасти.Цена;
	//СтрокаТабличнойЧасти.ВесВПробеЧистоты = ПолучитьВесВЧистоте(СтрокаТабличнойЧасти.ВесЧистый,  СтрокаТабличнойЧасти.ПолучитьИдентификатор(), "ДополнительныеМеталлы");
КонецПроцедуры

&НаСервере
Процедура ВставкиВидПриИзмененииНаСервере(Идентификатор, ИдентификаторТовары)
	СтрокаТабличнойЧасти = Объект.Вставки.НайтиПоИдентификатору(Идентификатор);
	СтрокаТабличнойЧастиТовары = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТовары);
	Если СтрокаТабличнойЧасти.Вид = Перечисления.ЛБ_ВидыКомплектующихИзделия.Вставка Тогда
		СтрокаТабличнойЧасти.ВидВставки = Справочники.ЛБ_ДрагоценныеКамни.ПустаяСсылка();
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмеренияКамни;
	Иначе
		СтрокаТабличнойЧасти.ВидВставки = Справочники.ЛБ_КомплектующиеИзделия.ПустаяСсылка();
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтрокаТабличнойЧастиТовары.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.НеОценивать = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВставкиВидПриИзменении(Элемент)
	Идентификатор = Элементы.Вставки.ТекущиеДанные.ПолучитьИдентификатор();
	ИдентификаторТовары = Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор();

	ВставкиВидПриИзмененииНаСервере(Идентификатор, ИдентификаторТовары);
КонецПроцедуры

&НаКлиенте
Процедура ВставкиНеОцениватьПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Вставки.ТекущиеДанные;
	Если СтрокаТабличнойЧасти.НеОценивать Тогда
		СтрокаТабличнойЧасти.Цена = 0;
		СтрокаТабличнойЧасти.Сумма = 0;
	Иначе
		Если СтрокаТабличнойЧасти.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
			
			СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
			ЦенаДрагоценногоКамня(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
			
			Если СтрокаТабличнойЧасти.ЭтоВесовой Тогда
			    СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Вес, 2);
			Иначе
				СтрокаТабличнойЧасти.Сумма = окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество, 2);
			КонецЕсли;
        КонецЕсли;
	КонецЕсли;	
КонецПроцедуры


&НаСервере
Процедура ПослеВыбораДокументаПравоПребывания(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	НоваяСтр = Объект.ДополнительныеДокументыПравоПребыванияРФ.Добавить();
	НоваяСтр.ДокументЗалогодателя = Результат.ДокументЗалогодателя;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ДокументЗалогодателя", НоваяСтр.ДокументЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя.Владелец КАК Клиент,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		НоваяСтр.Клиент = Выборка.Клиент;
		НоваяСтр.ВидДокументаЗалогодателя = Выборка.ВидДокументаЗалогодателя;
		НоваяСтр.ВидДокумента = Выборка.ВидДокумента;
		НоваяСтр.ДокументГражданство = Выборка.Гражданство;
		НоваяСтр.ДокументСерия = Выборка.ДокументСерия;
		НоваяСтр.ДокументНомер = Выборка.ДокументНомер;
		НоваяСтр.ДокументДатаВыдачи = Выборка.ДокументДатаВыдачи;
		НоваяСтр.ДокументКемВыдан = Выборка.ДокументКемВыдан;
		НоваяСтр.ДокументКодПодразделения = Выборка.ДокументКодПодразделения;
		НоваяСтр.ДокументНачалоДействия = Выборка.ДокументНачалоДействия;
		НоваяСтр.ДокументСрокДействия = Выборка.ДокументСрокДействия;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДокументПравоПребывания(Команда)
	Если ЗначениеЗаполнено(Объект.Представитель) Тогда 
		СписокВыбораК = Новый СписокЗначений; 

		СписокВыбораК.Добавить(Объект.Залогодатель); 
		СписокВыбораК.Добавить(Объект.Представитель); 

		ВыбранноеЗначение = ВыбратьИзМеню(СписокВыбораК);  
		Если ВыбранноеЗначение = неопределено Тогда
			Возврат;
		КонецЕсли;
		Клиент = ВыбранноеЗначение.Значение;
	Иначе
		Клиент = Объект.Залогодатель; 
	КонецЕсли;	
    ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДокументаПравоПребывания",ЭтаФорма);
    ЗначениеОтбора = Новый Структура;
    ЗначениеОтбора.Вставить("Залогодатель", Клиент);
    ЗначениеОтбора.Вставить("ВидДокументаЗалогодателя", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДокументУдостоверяющийПравоПребыванияРФ"));
    ЗначениеОтбора.Вставить("Дата", ДатаДок);

    ОткрытьФорму("ОбщаяФорма.ЛБ_ПодборДокументовКлиента", ЗначениеОтбора, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

