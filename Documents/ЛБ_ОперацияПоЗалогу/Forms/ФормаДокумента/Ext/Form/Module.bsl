		ОбработатьИзменениеДатыОплата(ДатаДок);
		РассчитатьСуммуПроцентовОплата(); 
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога") Тогда
		Объект.ДатаИзъятия = НачалоДня(ДатаДок);   
		Объект.ДатаПротоколИзъятия = НачалоДня(ДатаДок);
	КонецЕсли;   
КонецПроцедуры     

&НаСервере
Процедура ОбработатьИзменениеДатыОплата(ДатаДок)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", Объект.ПредыдущаяОперация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();  
	Если Выборка.Следующий() Тогда
		ДатаНачалаРасчета = Выборка.ДатаНачалаРасчета; 
		Объект.ДатаВыкупа = Выборка.ДатаВыкупа;
		Объект.ДатаВыкупаЛьготная = Выборка.ДатаВыкупаЛьготныйСрок;   
		
		//НачисленоПроценты = ЛБ_УправлениеЛомбардом.ПолучитьНачисленныеПроцентыПоДоговору(Объект, Объект.ПредыдущаяОперация);
		СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(ДатаДок, Объект.Организация);
		Если НЕ СтруктураП = неопределено Тогда
		    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
			ПредельноеЗначениеПроцентов = СуммаЗайма*ПланкаПроцентов;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьСуммуПроцентов()
	Объект.ГрафикПлатежей.Очистить();
	Если НЕ Объект.ПроцентнаяСхема = 0 Тогда                                                                                                                
		СтруктураОкругления = новый Структура;
		СтруктураОкругления.Вставить("ОкруглятьЦены", ОкруглятьЦены);  
		СтруктураОкругления.Вставить("ВидОкругленияСуммыПроцентов", ВидОкругленияСуммыПроцентов);
		СтруктураОкругления.Вставить("ПорядокОкругления", ПорядокОкругления);  
		СтруктураОкругления.Вставить("ОкруглятьВБольшуюСторону", ОкруглятьВБольшуюСторону);  
		
		//ДатаНачала = НачалоДня(ДатаДок);  
		//Если НачислятьПроцентыЗаДеньЗалога Тогда  
		//	ДатаНачала = НачалоДня(ДатаНачала);
		//Иначе	
		//	ДатаНачала = НачалоДня(ДатаНачала + (60 * 60 * 24));
		//КонецЕсли;  
		ДатаНачала = ЛБ_УправлениеЛомбардом.ПолучитьДатуНачалаРасчетаПроцентов(Объект.Дата, Объект.СхемаКредитования);
		
		СуммаПроцентов = 0;
		Для сч = 0 По ТаблицаСтавок.Количество()-1 Цикл 
			СтрС = ТаблицаСтавок.Получить(сч); 
			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачала;
			Иначе 
				ДатаНач = НачалоДня(ДатаНачала + СтрС.ДеньНачалаПрименения*(60 * 60 * 24));
			КонецЕсли;	
			Если ДатаНач > Объект.ДатаВыкупа Тогда 
		 		Прервать;
			КонецЕсли;	
			
			сч1 = сч + 1;
			Если сч1 >= ТаблицаСтавок.Количество() Тогда
				ДатаКон = Объект.ДатаВыкупа; 
				ДеньКон = Объект.СрокЗалога;
			Иначе   
				СтрС1 = ТаблицаСтавок.Получить(сч1);
				ДатаКонца = НачалоДня(ДатаНачала + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24)); 
				Если ДатаКонца > Объект.ДатаВыкупа Тогда
					ДатаКон = Объект.ДатаВыкупа;
					ДеньКон = Объект.СрокЗалога;
				Иначе
					ДатаКон = ДатаКонца; 
					ДеньКон = СтрС1.ДеньНачалаПрименения-1;
				КонецЕсли;	
			КонецЕсли;	
			
			Если НЕ (НачалоДня(ДатаКон) < НачалоДня(ДатаНач)) тогда
				СтавкаП = СтрС.ПроцентнаяСтавка; 
				Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
					Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
					ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
						СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
				    КонецЕсли; 
				КонецЕсли;	
			    Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗайма, СтруктураОкругления);
				СуммаПроцентов = СуммаПроцентов + Результат.СуммаПроцентов; 
				Если СтрС.ДеньНачалаПрименения = 1 Тогда
		            СуммаПроцентовДень = Результат.СуммаПроцентовДень;				
				КонецЕсли;	
				СтрП = Объект.ГрафикПлатежей.Добавить();   
				СтрП.ВидПроцентнойСтавки = СтрС.ВидПроцентнойСтавки; 
				СтрП.ДатаНач = ДатаНач;
				СтрП.ДатаКон = ДатаКон;
				СтрП.ДеньНач = СтрС.ДеньНачалаПрименения;  
				СтрП.ДеньКон = ДеньКон; 
				СтрП.ПроцентнаяСтавкаБазовая = СтрС.ПроцентнаяСтавка;
				СтрП.ПроцентнаяСтавкаАкция = СтрС.ПроцентнаяСтавкаАкция;
				СтрП.ОтклонениеАкцияОтносительное = СтрС.ОтклонениеАкцияОтносительное; 
				СтрП.ОтклонениеАкцияАбсолютное = СтрС.ОтклонениеАкцияАбсолютное;
                СтрП.СуммаПроцентов = Результат.СуммаПроцентов;
				СтрП.СуммаПроцентовДень = СуммаПроцентовДень;
			КонецЕсли;	
		Конеццикла;	
	Иначе
		СуммаПроцентов = 0;
		СуммаПроцентовДень = 0;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьСуммуПроцентовПереоформление()  
	СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Объект, Объект.ПредыдущаяОперация); 
	ДатаНачалаРасчетаНач = СтруктураРез.ДатаНачалаРасчета; 
	СуммаОплатыСсудаПереоформление = СтруктураРез.СуммаЗайма;
		
	СуммаОплатыПроцентыПереоформление = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(Объект, Объект.ПредыдущаяОперация); 

	Если ЗначениеЗаполнено(Объект.ПредыдущаяОперация.ПроцентнаяСхема) Тогда 
		ПроцентнаяСхемаРезультат = Объект.ПредыдущаяОперация.ПроцентнаяСхема; 		
		ДатаНач = ДатаНачалаРасчетаНач;  
		ДатаКон = Объект.Дата;
		Если ОкруглятьЦены Тогда
	        СуммаПроцентовП = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, ПроцентнаяСхемаРезультат, СуммаОплатыСсудаПереоформление, ОкруглятьЦены, ВидОкругленияСуммыПроцентов, ПорядокОкругления, ОкруглятьВБольшуюСторону); 
		Иначе
			СуммаПроцентовП = ЛБ_ОбщийМодуль.РасчетПроцентов(ДатаНач, ДатаКон, ПроцентнаяСхемаРезультат, СуммаОплатыСсудаПереоформление, ОкруглятьЦены);
		КонецЕсли;	
	Иначе
		СуммаПроцентовП = 0;
	КонецЕсли;	
	СуммаОплатыПроцентыПереоформление = СуммаОплатыПроцентыПереоформление + СуммаПроцентовП;   
	СуммаОплатыПереоформление = СуммаОплатыСсудаПереоформление + СуммаОплатыПроцентыПереоформление;
	КВыдачеОплате = СуммаЗайма - СуммаОплатыПереоформление;
	Если КВыдачеОплате > 0 Тогда
	    Элементы.ДекорацияКВыдачеОплате.Заголовок = "К выдаче " + СокрЛП(Формат(КВыдачеОплате, "ЧЦ=15; ЧДЦ=2; ЧРД=,")) + " руб."; 
	Иначе     
		КВыдачеОплате = ?(КВыдачеОплате < 0, -КВыдачеОплате, КВыдачеОплате);
		Элементы.ДекорацияКВыдачеОплате.Заголовок = "К доплате " + СокрЛП(Формат(КВыдачеОплате, "ЧЦ=15; ЧДЦ=2; ЧРД=,")) + " руб.";
	КонецЕсли;	
КонецПроцедуры	 


&НаСервере
Процедура РассчитатьСуммуПроцентовОплата()  
	Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Изъят ИЛИ СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Возвращен Тогда
		СуммаПроцентов = ЛБ_ОбщийМодуль.ПолучитьОстатокПроцентов(Объект, Объект.ПредыдущаяОперация);
		
		Если НЕ СуммаПроцентов = 0 Тогда
			СтрП = Объект.НачислениеПроцентовДетально.Добавить();   
			СтрП.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая; 
			СтрП.ДатаНач = ДатаНачалаРасчета;
			СтрП.ДатаКон = Объект.Дата;
			СтрП.ДеньНач = 1;  
			СтрП.ДеньКон = (НачалоДня(СтрП.ДатаКон) - НачалоДня(СтрП.ДатаНач)) / (60 * 60 * 24) + 1; 
			СтрП.СуммаПроцентов = СуммаПроцентов;
			//СтрП.СуммаПроцентовДень = СуммаПроцентов/СтрП.ДеньКон; 
			//СтрП.ПроцентнаяСтавкаБазовая = СтрП.СуммаПроцентовДень/СтрП.СуммаПроцентов*100;
		КонецЕсли;
		Возврат;
	КонецЕсли;		
	
	Элементы.ДекорацияСообщениеПроценты.Заголовок = ""; 
			
	СтруктураОкругления = новый Структура;
	СтруктураОкругления.Вставить("ОкруглятьЦены", ОкруглятьЦены);  
	СтруктураОкругления.Вставить("ВидОкругленияСуммыПроцентов", ВидОкругленияСуммыПроцентов);
	СтруктураОкругления.Вставить("ПорядокОкругления", ПорядокОкругления);  
	СтруктураОкругления.Вставить("ОкруглятьВБольшуюСторону", ОкруглятьВБольшуюСторону);
	
	Установки = новый Структура; 
	Установки.Вставить("НеНачислятьПроцентыЗаПоследнийДень", НеНачислятьПроцентыЗаПоследнийДень);
	Установки.Вставить("СчитатьПроцентыДеньВыдачиРавенДеньВыкупа", СчитатьПроцентыДеньВыдачиРавенДеньВыкупа);  
		
	Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентовОплата(Объект, ДатаНачалаРасчета, ПредельноеЗначениеПроцентов, ПричинаПримененияПроцентнойСхемы, Установки, СтруктураОкругления);
	СуммаПроцентов = Результат.СуммаПроцентов;
	СуммаПроцентовДень = Результат.СуммаПроцентовДень;
	Если Результат.ПредельноеЗначениеПоДоговору Тогда
	    Элементы.ДекорацияСообщениеПроценты.Заголовок = "Достигнуто предельное значение суммы процентов по договору.";
    КонецЕсли;	
КонецПроцедуры    
	

