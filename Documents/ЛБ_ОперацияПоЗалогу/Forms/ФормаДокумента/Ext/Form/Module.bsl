&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	Если СтрокаТабличнойЧастиТовары <> Неопределено Тогда
		//Удалим объект залога
		Если ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.ОбъектЗалога) Тогда
			УдалитьОбъектЗалога(СтрокаТабличнойЧастиТовары.ОбъектЗалога);
		КонецЕсли;	

		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
		
		НайденныеСтроки = Объект.Вставки.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Объект.Вставки.Удалить(Строка);	
		КонецЦикла; 
		
		НайденныеСтроки = Объект.ДополнительныеМеталлы.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Объект.ДополнительныеМеталлы.Удалить(Строка);	
		КонецЦикла; 

	КонецЕсли; 
	
КонецПроцедуры

&НаСервере 
Процедура ОбработатьИзменениеСуммыЗайма() 
	РасчетСуммыОценкиИтоговой();  
	Если НЕ СуммаЗайма = 0 Тогда	           
		Если НЕ ПСК = 0 Тогда
            СуммаПСКГод = СуммаЗайма*ПСК/100;  
		Иначе
			СуммаПСКГод = 0;
		КонецЕсли;				
		Если НЕ (СуммаПСКГод = 0) Тогда 
			Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
		        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
			КонецЕсли;	
	    КонецЕсли;	 
    КонецЕсли;
		
	ПолучитьДоступныеПроцентныеСхемыАкции(); 
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("СхемаКредитования", Объект.СхемаКредитования); 
		Отбор.Вставить("Акция", Объект.Акция);   
		СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(Отбор);
		Если НЕ СтрокиСК.Количество() = 0 Тогда
			ЗаполнитьТаблицуСтавок();
		Иначе 
			СтрокаСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
			Объект.СхемаКредитования = СтрокаСК.СхемаКредитования;
			Объект.Акция = СтрокаСК.Акция; 
			ОбработатьСхемуКредитованияНаСервере(ДатаДок);
			ЗаполнитьТаблицуСтавок();
		КонецЕсли;	
	Иначе
		Объект.СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Объект.Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка");
		Объект.ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		Объект.ДатаВыкупа = Дата(1,1,1); 
		Объект.ДатаВыкупаЛьготная = Дата(1,1,1);  
		Объект.СрокЗалога = 0;
		Объект.ПроцентнаяСхема = 0;
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	
	   
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление") Тогда	        
	    РассчитатьСуммуПроцентовПереоформление();
	Иначе
		РассчитатьСуммуПроцентов(); 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	ОбработатьИзменениеСуммыЗайма();
КонецПроцедуры


&НаСервере
Процедура ЦенаДрагоценногоМеталла(Идентификатор, ИмяТабличнойЧасти = "Товары") 
	СтрокаТабличнойЧасти 			  = Объект[ИмяТабличнойЧасти].НайтиПоИдентификатору(Идентификатор);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Дата", Объект.Дата);
	СтруктураПараметров.Вставить("Ломбард", Объект.Ломбард);
	СтруктураПараметров.Вставить("СхемаКредитования", Объект.СхемаКредитования);
	СтруктураПараметров.Вставить("Проба", СтрокаТабличнойЧасти.Проба);
	СтруктураПараметров.Вставить("Категория", СтрокаТабличнойЧасти.Категория);
	СтруктураПараметров.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧасти.ЕдиницаИзмерения);

	СтрокаТабличнойЧасти.Цена = ЛБ_ОбщийМодуль.ПолучитьЦенуМеталлаИзПрейскуранта(СтруктураПараметров);
	СтрокаТабличнойЧасти.СуммаОценкиМеталлы = СтрокаТабличнойЧасти.ВесЧистый*СтрокаТабличнойЧасти.Цена; 

КонецПроцедуры

