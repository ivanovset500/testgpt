&НаКлиенте
Процедура ВставкиПослеУдаления(Элемент)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда
		СтруктураР = ПолучитьВесИСуммуВставокИзделия(СтрокаТабличнойЧастиТовары.КлючСтроки);
		СтрокаТабличнойЧастиТовары.ВесЧистый = Цел((СтрокаТабличнойЧастиТовары.Вес - СтруктураР.Вес)*100)/100;
		СтрокаТабличнойЧастиТовары.СуммаОценкиКамни = СтруктураР.Сумма;
		ПересчитатьСуммТовары();
	КонецЕсли;	
	
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли;	 
	ОбновитьДанныеТовары();
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеМеталлыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	Отказ = (СтрокаТабличнойЧастиТовары = Неопределено) ИЛИ Копирование; 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.Проба) Тогда  
		Сообщить("Не выбран основной металл в изделии!"); 
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	СписокПроб = ПолучитьСписокДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()); 
	Если СписокПроб.Количество() = 0 Тогда  
		Сообщить("Не определены дополнительные металлы для металла " + сокрЛП(СтрокаТабличнойЧастиТовары.Проба) + "!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;	 
	Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Очистить();
	Для каждого Эл Из СписокПроб цикл
	    Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Добавить(Эл.Значение);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеМеталлыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока и НЕ Копирование Тогда
		СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	    СтрокаТабличнойЧасти       = Элементы.ДополнительныеМеталлы.ТекущиеДанные;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмеренияМеталлы;
        СтрокаТабличнойЧасти.Категория = СтрокаТабличнойЧастиТовары.Категория;
	
	    ЗаполнитьКлючСтрокиВставки(СтрокаТабличнойЧасти,СтрокаТабличнойЧастиТовары); 
	Иначе
		Если Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Количество() = 0 тогда
			СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
			СписокПроб = ПолучитьСписокДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());
			Для каждого Эл Из СписокПроб цикл
			    Элементы.ДополнительныеМеталлыПроба.СписокВыбора.Добавить(Эл.Значение);
			КонецЦикла;	
		КонецЕсли;	
   	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьВесДопМеталлов(Идентификатор)
	СтрТовары = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	
	ВесОснМеталла = СтрТовары.Вес;
	
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", СтрТовары.КлючСтроки);
	Строки = Объект.ДополнительныеМеталлы.НайтиСтроки(Отбор);
	Для каждого Стр из Строки Цикл
		ВесОснМеталла = ВесОснМеталла - Стр.ВесЧистый;
	Конеццикла;	 
	
	ВсеОК = Истина;
	Для каждого Стр из Строки Цикл 
		Если Стр.ВесЧистый > ВесОснМеталла Тогда
			ВсеОК = Ложь;
		КонецЕсли;	
	Конеццикла;	                
	
	Возврат ВсеОК;
КонецФункции

&НаКлиенте
Процедура ДополнительныеМеталлыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;  
	СтрокаТабличнойЧасти = Элементы.ДополнительныеМеталлы.ТекущиеДанные;
	
	Если НЕ ПроверитьВесДопМеталлов(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор()) Тогда
		Сообщить("В раздел ""Дополнительные металлы"" заносится информация о металле, масса которого, в общей массе изделия, является наименьшей.");
		Отказ = Истина;
	КонецЕсли;	       
	
	Если Отказ тогда
		Возврат;
	конецЕсли;	
	
	Если НЕ СтрокаТабличнойЧастиТовары = неопределено Тогда
		ПересчитатьСуммТовары();
	КонецЕсли;	
	
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли;
КонецПроцедуры

