	Объект.ПроцентныеСтавкиПоПериодам.Очистить();
	ТаблицаСтавок.Очистить(); 
	ТаблицаС = ЛБ_ОбщийМодуль.ЗаполнитьТаблицуПроцентныхСтавок(Объект.Дата, Объект.Ломбард, Объект.СхемаКредитования, Объект.Акция, Объект.СтатусЗалогодателя, СписокДопСтатусов, Объект.СуммаСсуды);					
	Если НЕ ТаблицаС.Количество() = 0 Тогда  						
		Объект.ПроцентныеСтавкиПоПериодам.Загрузить(ТаблицаС);
		
		Отбор = Новый структура;
		Отбор.Вставить("ПричинаПрименения", ПричинаПримененияПроцентнойСхемы); 
		СтрокиП = Объект.ПроцентныеСтавкиПоПериодам.НайтиСтроки(Отбор); 
		Для каждого СтрП из строкиП цикл 
			НоваяСтр = ТаблицаСтавок.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрП);
		КонецЦикла;	
		
		ОтборС = Новый Структура;
		ОтборС.Вставить("ДеньНачалаПрименения", 1);
		СтрокиС = ТаблицаСтавок.НайтиСтроки(ОтборС); 
		Если НЕ СтрокиС.Количество() = 0 Тогда 
			СтрС = СтрокиС.Получить(0);	
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Базовая Тогда 
				Объект.ПроцентнаяСхема = СтрС.ПроцентнаяСтавка;
			ИначеЕсли СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда	
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда 
					Объект.ПроцентнаяСхема = СтрС.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					Объект.ПроцентнаяСхема = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда
					Объект.ПроцентнаяСхема = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры	  

&НаСервере
Функция РасчетПроцентовПоДоговоруГод()
	СтруктураОкругления = новый Структура;
	СтруктураОкругления.Вставить("ОкруглятьЦены", ОкруглятьЦены);  
	СтруктураОкругления.Вставить("ВидОкругленияСуммыПроцентов", ВидОкругленияСуммыПроцентов);
	СтруктураОкругления.Вставить("ПорядокОкругления", ПорядокОкругления);  
	СтруктураОкругления.Вставить("ОкруглятьВБольшуюСторону", ОкруглятьВБольшуюСторону);  
		
	ДатаНачала = ЛБ_УправлениеЛомбардом.ПолучитьДатуНачалаРасчетаПроцентов(Объект.Дата, Объект.СхемаКредитования);
		
	СуммаПроцентовГод = 0;
	ДеньКон = 1; 
	ДатаКон = ДатаНачала;
	СтавкаП = 0; 
	
	ОтборП = Новый Структура;
	ОтборП.Вставить("ПричинаПрименения", ПричинаПримененияПроцентнойСхемы);
	СтрокиП = Объект.ПроцентныеСтавкиПоПериодам.НайтиСтроки(ОтборП); 
	Если НЕ СтрокиП.Количество() = 0 Тогда
		Для сч = 0 По СтрокиП.Количество()-1 Цикл 
			СтрС = СтрокиП.Получить(сч);  
			СтавкаП = СтрС.ПроцентнаяСтавка;
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
			    КонецЕсли; 
			КонецЕсли;	

			Если СтрС.ДеньНачалаПрименения = 1 Тогда
				ДатаНач = ДатаНачала;
			Иначе 
				ДатаНач = НачалоДня(ДатаНачала + СтрС.ДеньНачалаПрименения*(60 * 60 * 24));
			КонецЕсли;		
			
			сч1 = сч + 1;
			Если сч1 >= СтрокиП.Количество() Тогда
				Прервать;
			КонецЕсли;  
			СтрС1 = СтрокиП.Получить(сч1);
			ДатаКонца = НачалоДня(ДатаНачала + (СтрС1.ДеньНачалаПрименения-1)*(60 * 60 * 24)); 
			ДатаКон = ДатаКонца; 
			ДеньКон = СтрС1.ДеньНачалаПрименения-1;
					
			Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗайма, СтруктураОкругления);
			СуммаПроцентовГод = СуммаПроцентовГод + Результат.СуммаПроцентов; 			
		Конеццикла;	
		Если ДеньКон  < 365 Тогда  
			ДатаНач = ДатаКон;
			ДатаКон = НачалоДня(ДатаНачала + 365*(60 * 60 * 24));
			СтрС = СтрокиП.Получить(СтрокиП.Количество()-1);  
			СтавкаП = СтрС.ПроцентнаяСтавка;
			Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
				Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавкаАкция;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
				ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
					СтавкаП = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
			    КонецЕсли; 
			КонецЕсли;	
			Результат = ЛБ_ОбщийМодуль.РассчитатьСуммуПроцентов(ДатаНач, ДатаКон, СтавкаП, СуммаЗайма, СтруктураОкругления);
			СуммаПроцентовГод = СуммаПроцентовГод + Результат.СуммаПроцентов; 
		КонецЕсли;	 
	КонецЕсли;	
	
	Возврат СуммаПроцентовГод;
КонецФункции

