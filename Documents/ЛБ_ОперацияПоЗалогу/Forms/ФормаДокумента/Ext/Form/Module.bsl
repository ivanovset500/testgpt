&НаКлиенте
Процедура ТоварыКатегорияПриИзменении(Элемент)	
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());

	ОтборВ = Новый Структура;
	ОтборВ.Вставить("КлючСтроки", СтрокаТабличнойЧастиТовары.КлючСтроки);
	Строки = Объект.ДополнительныеМеталлы.НайтиСтроки(ОтборВ);
	Для каждого СтрокаТабличнойЧасти Из Строки Цикл		
	    ЦенаДрагоценногоМеталла(СтрокаТабличнойЧасти.ПолучитьИдентификатор());
		СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы + СтрокаТабличнойЧасти.СуммаОценкиМеталлы;
	КонецЦикла;	
	//ПересчитатьСуммТовары(СтрокаТабличнойЧастиТовары); 
КонецПроцедуры

&НаКлиенте
Процедура СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары)
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		Если СтрокаТабличнойЧастиТовары.ЕстьВставки Тогда
			Элементы.ГруппаВставок.Показать();
			Элементы.ГруппаВставок.Доступность = Истина;
		Иначе
			Элементы.ГруппаВставок.Скрыть();
			Элементы.ГруппаВставок.Доступность = ложь;
		КонецЕсли;	
		
		Если СтрокаТабличнойЧастиТовары.ЕстьДопМеталлы Тогда
			Элементы.ГруппаДопМеталлы.Показать(); 
			Элементы.ГруппаДопМеталлы.Доступность = Истина;
			Элементы.ТоварыГруппаЭтикетка.Видимость = Истина;
			Элементы.ТоварыГруппаЭ.Доступность = Истина;
		Иначе
			Элементы.ГруппаДопМеталлы.Скрыть();
			Элементы.ГруппаДопМеталлы.Доступность = ложь;
			Если СтрокаТабличнойЧастиТовары.ЕстьЭтикетка тогда
				СтрокаТабличнойЧастиТовары.ЕстьЭтикетка = ложь;
			КонецЕсли;	   
			Если ЗначениеЗаполнено(СтрокаТабличнойЧастиТовары.Этикетка) тогда 
				УдалитьСканЭтикетки(СтрокаТабличнойЧастиТовары.Этикетка);
				СтрокаТабличнойЧастиТовары.Этикетка = ПредопределенноеЗначение("Справочник.ЛБ_ХранилищеЭтикеток.ПустаяСсылка"); 
			КонецЕсли;	
			Элементы.ТоварыГруппаЭтикетка.Видимость = ложь;  
			Элементы.ТоварыГруппаЭ.Доступность = ложь;
		КонецЕсли;	
	Иначе
		Элементы.ГруппаВставок.Скрыть();
		Элементы.ГруппаДопМеталлы.Скрыть(); 
		Элементы.ТоварыГруппаЭ.Доступность = ложь;
	КонецЕсли;	
КонецПроцедуры
	
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
		
	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;
	
	СвернутьРазвернутьПанелиВставкиДопМеталлы(СтрокаТабличнойЧастиТовары);
		
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиТовары.КлючСтроки);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.Вставки.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		Элементы.ДополнительныеМеталлы.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элемент.ТекущиеДанные.Количество = 1;
		Элемент.ТекущиеДанные.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмеренияМеталлы;
		Элемент.ТекущиеДанные.КлючСтроки = ЗаполнитьКлючСтрокиТоваров(); 
		Элемент.ТекущиеДанные.Именник = ПредопределенноеЗначение("Перечисление.ЛБ_Именник.Нет"); 
		Элемент.ТекущиеДанные.СостояниеИзделия = ПредопределенноеЗначение("Перечисление.ЛБ_СостояниеИзделия.БУ");
	КонецЕсли;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		Элемент.ТекущиеДанные.Авторасчет = Истина;
		
	КонецЕсли;
	
	Если НоваяСтрока И Копирование Тогда
		
		Элемент.ТекущиеДанные.ОбъектЗалога = ПредопределенноеЗначение("Справочник.ЛБ_ОбъектыЗалога.ПустаяСсылка");		
	КонецЕсли;
		
КонецПроцедуры

