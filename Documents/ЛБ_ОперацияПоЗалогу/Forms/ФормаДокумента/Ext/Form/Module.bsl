&НаСервере
Функция ПолучитьСлужебныеСтатусыКлиента(Клиент)
	СписокСлужебныхСтатусов = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Клиент", Клиент); 
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Статус КАК Статус,
	               |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Используется Тогда 
			СписокСлужебныхСтатусов.Добавить(Выборка.Статус);
		КонецЕсли;	
	КонецЦикла;	
	Возврат СписокСлужебныхСтатусов;
КонецФункции	

&НаСервере
Процедура ПроверитьВозможностьВыдачиЗалога() 
	Запрос = новый Запрос;   
	Запрос.УстановитьПараметр("ЗалоговыйБилет", Объект.ПредыдущаяОперация);
	Запрос.УстановитьПараметр("Дата", ДатаДок);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
	               |	СУММА(ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.СуммаРасход) КАК СуммаОплаты
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентамиПоОбъектамЗалога.Обороты(, &Дата, , ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиПоОбъектамЗалогаОбороты.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	Объект.ТоварыВыкупленные.Очистить();  
	Для каждого стр Из ТаблицаЗапроса цикл 
		Отбор = Новый структура;
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
		Отбор.Вставить("Ломбард", Объект.Ломбард);
		Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 тогда 
			СтатусОбъектаЗалога = ЛБ_УправлениеЛомбардом.ПолучитьСостояниеОбъектаЗалога(ДатаДок, Стр.ОбъектЗалога, Объект.ПредыдущаяОперация); 
			Если НЕ (СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Выкуплен) И НЕ (СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Изъят) Тогда
				НоваяСтр = Объект.ТоварыВыкупленные.Добавить(); 
				НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
				НоваяСтр.СуммаОплаты = Стр.СуммаОплаты; 
			КонецЕсли;	
		Иначе
			Отбор.Удалить("Ломбард");
			Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
			Если НЕ Строки.Количество() = 0 тогда 
				Сообщить("Объект залога " + сокрЛП(стр.ОбъектЗалога) + " находится в " + СокрЛП(Строки.Получить(0).Ломбард) + ", выдача не возможна.");
			Иначе
				Сообщить("Местонахождение объекта залога " + сокрЛП(стр.ОбъектЗалога) + " не определено, выдача не возможна.", СтатусСообщения.Важное);
            КонецЕсли;
		КонецЕсли;
	Конеццикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьИсториюЗБ()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
		ЗБ =  Объект.Ссылка;
	Иначе  
		ЗБ =  Объект.ПредыдущаяОперация.Ссылка;
	КонецЕсли;	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОборотыПоОперациямЗайма.Период КАК Дата,
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор КАК ДокументДвижения,
	               |	ЛБ_ОборотыПоОперациямЗайма.ВидОперации КАК ВидОперации,
	               |	ЛБ_ОборотыПоОперациямЗайма.Ломбард КАК Ломбард,
	               |	ЛБ_СостояниеЗалоговогоБилета.СтатусЗалоговогоБилета КАК СтатусЗБ,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготная,
	               |	ЛБ_ОборотыПоОперациямЗайма.Регистратор.ОтветственныйСотрудник КАК Ответственный,
	               |	ЛБ_ОборотыПоОперациямЗайма.СуммаСсуды КАК СуммаЗайма,
	               |	ЛБ_ОборотыПоОперациямЗайма.СуммаОплатыПроценты + ЛБ_ОборотыПоОперациямЗайма.СуммаОплатыЗайм КАК СуммаОплаты,
	               |	ЛБ_ОборотыПоОперациямЗайма.СуммаОплатыПроценты КАК СуммаОплатыПроценты,
	               |	ЛБ_ОборотыПоОперациямЗайма.СуммаОплатыЗайм КАК СуммаОплатыЗайм
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма КАК ЛБ_ОборотыПоОперациямЗайма
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |		ПО ЛБ_ОборотыПоОперациямЗайма.Регистратор = ЛБ_СостояниеЗалоговогоБилета.Регистратор
	               |ГДЕ
	               |	ЛБ_ОборотыПоОперациямЗайма.ЗалоговыйБилет = &ЗалоговыйБилет
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	_СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ПустаяСсылка();
	_ДатаВыкупа = Дата(1,1,1);
	_ДатаВыкупаЛьготная = Дата(1,1,1);
	Для каждого стр Из ТаблицаЗапроса Цикл  
		Если НЕ ЗначениеЗаполнено(Стр.СтатусЗБ) Тогда
			Стр.СтатусЗБ = _СтатусЗБ;
			Стр.ДатаВыкупа = _ДатаВыкупа;
			Стр.ДатаВыкупаЛьготная = _ДатаВыкупаЛьготная;
		Иначе  
			_СтатусЗБ = Стр.СтатусЗБ;
			_ДатаВыкупа = Стр.ДатаВыкупа;
			_ДатаВыкупаЛьготная = Стр.ДатаВыкупаЛьготная;
		КонецЕсли;	
	Конеццикла;	
	ТаблицаИсторииЗБ.Загрузить(ТаблицаЗапроса);
КонецПроцедуры	

&НаСервере
Функция ЗаполнитьСписокВыбораСК()   
	СхемаКредитованияСписокВыбора = Новый СписокЗначений; 
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда 
		Приоритет = ТаблицаВыбораСхемыКредитованияАкции.Получить(0).Приоритет;
		Для каждого Стр Из ТаблицаВыбораСхемыКредитованияАкции Цикл 
			Если Стр.Приоритет < Приоритет тогда
				Прервать;
			КонецЕсли;	
			СтрокаСК = сокрЛП(Стр.СхемаКредитования); 
			Если ЗначениеЗаполнено(Стр.Акция) Тогда
			    СтрокаСК = СтрокаСК + ", акция " + сокрЛП(Стр.Акция);
			КонецЕсли;
			СхемаКредитованияСписокВыбора.Добавить(Стр.НомерСтроки, СтрокаСК); 
		Конеццикла;
	КонецЕсли;	
	Возврат СхемаКредитованияСписокВыбора;
КонецФункции    

&НаКлиенте
Процедура ОтказОтВыкупаПриИзменении(Элемент)
	ПолучитьДоступныеПроцентныеСхемыАкции(); 
	Если НЕ ТаблицаВыбораСхемыКредитованияАкции.Количество() = 0 Тогда
	    СтрСК = ТаблицаВыбораСхемыКредитованияАкции.Получить(0);
		Объект.СхемаКредитования = СтрСК.СхемаКредитования;
		Объект.Акция = СтрСК.Акция;			
		ЗаполнитьТаблицуСтавок();
		ОбработатьСхемуКредитованияНаСервере(ДатаДок); 
		РасчетСуммыОценкиИтоговой();   
		Если НЕ ЗначениеЗаполнено(Объект.ПроцентнаяСхема) Тогда
            Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен."); 
		КонецЕсли;	
	Иначе     
		Объект.СхемаКредитования = ПредопределенноеЗначение("Справочник.ЛБ_СхемыКредитования.ПустаяСсылка");
		Объект.Акция = ПредопределенноеЗначение("Справочник.ЛБ_Акции.ПустаяСсылка"); 
		Объект.ДатаВыкупа = Дата(1,1,1); 
		Объект.ДатаВыкупаЛьготная = Дата(1,1,1); 
		Объект.СрокЗалога = 0;
		Объект.ПроцентныеСтавкиПоПериодам.Очистить();
		ТаблицаСтавок.Очистить();
		Объект.ПроцентнаяСхема = 0; 
		Сообщить("Не определена процентная схема! Расчет процентов по договору займа не возможен.");
	КонецЕсли;	
	Если НЕ СуммаЗайма = 0 Тогда	           
		Если НЕ ПСК = 0 Тогда
            СуммаПСКГод = СуммаЗайма*ПСК/100;  
		Иначе
			СуммаПСКГод = 0;
		КонецЕсли;				
		Если НЕ (СуммаПСКГод = 0) Тогда 
			Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
		        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
			КонецЕсли;	
	    КонецЕсли;	 	    
	КонецЕсли;	
    РассчитатьСуммуПроцентов();
КонецПроцедуры

&НаКлиенте
Процедура СхемаКредитованияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СписокВыбораСК = ЗаполнитьСписокВыбораСК(); 
	Если СписокВыбораСК.Количество() > 1 Тогда
		ВыбранноеЗначение = ВыбратьИзМеню(СписокВыбораСК, Элементы.СхемаКредитования); 
		Если НЕ ВыбранноеЗначение = неопределено Тогда
			НомерСтроки = ВыбранноеЗначение.Значение; 
			ОтборСК = Новый Структура("НомерСтроки", НомерСтроки);
			СтрокиСК = ТаблицаВыбораСхемыКредитованияАкции.НайтиСтроки(ОтборСК);
			Если НЕ СтрокиСК.Количество() = 0 Тогда 
				СтрСК = СтрокиСК.Получить(0);
				Объект.СхемаКредитования = СтрСК.СхемаКредитования;
				Объект.Акция = СтрСК.Акция;			
				ЗаполнитьТаблицуСтавок();
				ОбработатьСхемуКредитованияНаСервере(ДатаДок); 
				РасчетСуммыОценкиИтоговой(); 
				Если НЕ СуммаЗайма = 0 Тогда	           
					Если НЕ ПСК = 0 Тогда
			            СуммаПСКГод = СуммаЗайма*ПСК/100;  
					Иначе
						СуммаПСКГод = 0;
					КонецЕсли;				
					Если НЕ (СуммаПСКГод = 0) Тогда 
						Если РасчетПроцентовПоДоговоруГод() > СуммаПСКГод Тогда
					        Сообщить("Сумма процентов в год превышает предельную ставку кредитования!", СтатусСообщения.Важное);
						КонецЕсли;	
				    КонецЕсли;	 	
			    КонецЕсли;	 
				РассчитатьСуммуПроцентов();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДоступныеПроцентныеСхемыАкции() 
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьДоступныеПроцентныеСхемыАкции(Объект.Дата, Объект.Ломбард, объект.СтатусЗалогодателя, СуммаЗайма, Объект.ОтказОтВыкупа, ПричинаПримененияПроцентнойСхемы, СписокДопСтатусов, СписокЛьготныхСтатусов, Объект.Промокод, Объект.Предъявитель); 
	НомерСтроки = 0;                                                                                                                                                   
	ТаблицаВыбораСхемыКредитованияАкции.Очистить();  
	Если НЕ ТаблицаЗапроса = неопределено Тогда
		Для каждого стрЗ Из ТаблицаЗапроса Цикл
		    НоваяСтрСК = ТаблицаВыбораСхемыКредитованияАкции.Добавить();
			НоваяСтрСК.НомерСтроки = НомерСтроки; 
			НоваяСтрСК.СхемаКредитования = стрЗ.СхемаКредитования;
			НоваяСтрСК.Акция = стрЗ.Акция; 
			НоваяСтрСК.Приоритет = стрЗ.Приоритет; 
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;	  
		ТаблицаВыбораСхемыКредитованияАкции.Сортировать("Приоритет Убыв");  
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДопСтатусовКлиента() 		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыЗалогодателей.Ссылка КАК Статус
	               |ИЗ
	               |	Справочник.ЛБ_СтатусыЗалогодателей КАК ЛБ_СтатусыЗалогодателей
	               |ГДЕ
	               |	ЛБ_СтатусыЗалогодателей.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ЭтоГруппа = ЛОЖЬ
	               |	И ЛБ_СтатусыЗалогодателей.ДоступенДляВыбораВручную = ИСТИНА
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаДопСтатусов.Загрузить(ТаблицаЗапроса); 
	Новаястр = ТаблицаДопСтатусов.Добавить();
	НоваяСтр.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Почетный;  
КонецПроцедуры	

&НаСервере
Процедура ПолучитьДопСтатусыКлиента()  
	//очистим таблицу доп. статусов
	Для каждого Стр Из ТаблицаДопСтатусов Цикл 
		Стр.Используется = ложь;	
	КонецЦикла;	  
	
	Если ЗначениеЗаполнено(Объект.ПредыдущаяОперация) Тогда 
		Клиент = Объект.ПредыдущаяОперация.Залогодатель;
		ДатаРождения = Объект.ПредыдущаяОперация.ДатаРождения;
		Пол = Объект.ПредыдущаяОперация.Пол;
	Иначе  
		Клиент = Объект.Залогодатель;
		ДатаРождения = Объект.ДатаРождения;
		Пол = Объект.Пол;
	конецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
                   |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
                   |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется
                   |ИЗ
                   |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(
                   |			&Дата,
                   |			Залогодатель = &Залогодатель
                   |				И Статус = &Статус) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних";
	Для каждого Стр Из ТаблицаДопСтатусов Цикл 
		Запрос.УстановитьПараметр("Залогодатель", Клиент);  
	    Запрос.УстановитьПараметр("Дата", Объект.Дата); 
		Запрос.УстановитьПараметр("Статус", Стр.Статус);  
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр.Используется = Выборка.Используется;
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ЛБ_УправлениеЛомбардом.ПроверитьСтатусПочетный(ДатаРождения, Пол) Тогда 
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Справочники.ЛБ_СтатусыЗалогодателей.Почетный);
		СтрокиС = ТаблицаДопСтатусов.НайтиСтроки(Отбор);
		Если НЕ СтрокиС.Количество() = 0 Тогда
			СтрокиС.Получить(0).Используется = Истина;
		КонецЕсли;	
	КонецЕсли;   
	
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл
		Если СтрС.Используется Тогда
		    СписокДопСтатусов.Добавить(СтрС.Статус);
		КонецЕсли;	
	Конеццикла;	
КонецПроцедуры

&НаСервере
Процедура СтатусыКлиентаВСтроку()
	СтатусыКлиента = сокрЛП(Объект.СтатусЗалогодателя);
	Для каждого СтрС Из ТаблицаДопСтатусов Цикл 
		Если СтрС.Используется Тогда 
		    СтатусыКлиента = СтатусыКлиента + "; " + СокрЛП(СтрС.Статус);
		конецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Функция ПроверитьПодчиненный()
	ЗапросП = Новый Запрос; 
	ЗапросП.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_ОперацияПоЗалогу.Ссылка КАК Ссылка
	                |ИЗ
	                |	Документ.ЛБ_ОперацияПоЗалогу КАК ЛБ_ОперацияПоЗалогу
	                |ГДЕ
	                |	ЛБ_ОперацияПоЗалогу.ОперацияВыкупаПереоформление = &Ссылка";
	ВыборкаП = ЗапросП.Выполнить().Выбрать();
	Если ВыборкаП.Следующий() Тогда 
		Возврат Истина;
	КонецЕсли;         
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаполнитьДатуВыкупа() 
	Объект.ДатаВыкупа = НачалоДня(ДатаДок) + 86401*Объект.СрокЗалога;  
	Объект.ДатаВыкупа = ЛБ_УправлениеЛомбардом.ИсключитьДатаВыкупаПразничныйДень(Объект.ДатаВыкупа);
КонецПроцедуры

&НаСервере
Процедура ОбработатьСхемуКредитованияНаСервере(ДатаДок)	
	БезПродленияДоговора = Объект.СхемаКредитования.БезПродленияДоговора;
    ПризнакПримененияГибкогоПроцента = Объект.СхемаКредитования.ПризнакПримененияГибкогоПроцента;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ?(Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление, ДатаДок, Объект.ПредыдущаяОперация.Дата));
	Запрос.УстановитьПараметр("СхемаКредитования", Объект.СхемаКредитования);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_УсловияПредоставленияКредитаСрезПоследних.СрокЗалога КАК СрокЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, СхемаКредитования = &СхемаКредитования) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  
		СрокЗалога = Выборка.СрокЗалога;
		ЗаполнитьДатуВыкупа();
		ДатаВыкупаЛьготная = ПолучитьЛьготнуюДатуВыкупа();
	КонецЕсли;	  
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УсловияПредоставленияКредита.НачислятьПроцентыЗаДеньЗалога КАК НачислятьПроцентыЗаДеньЗалога,
	               |	УсловияПредоставленияКредита.НеНачислятьПроцентыЗаПоследнийДень КАК НеНачислятьПроцентыЗаПоследнийДень,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуПроценты КАК ОкруглятьПроценты,
	               |	УсловияПредоставленияКредита.ПорядокОкругленияПроценты КАК ПорядокОкругления,
	               |	УсловияПредоставленияКредита.ОкруглятьВБольшуюСторонуПроценты КАК ОкруглятьВБольшуюСторону,
	               |	УсловияПредоставленияКредита.ВидОкругленияСуммыПроцентов КАК ВидОкругленияСуммыПроцентов,
	               |	УсловияПредоставленияКредита.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа КАК СчитатьПроцентыДеньВыдачиРавенДеньВыкупа,
	               |	УсловияПредоставленияКредита.ОкруглятьСуммуОценка КАК ОкруглятьОценка
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкиЗаймаВерхнегоУровня.СрезПоследних(&Дата, Организация = &Организация) КАК УсловияПредоставленияКредита";
	Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда  
		НачислятьПроцентыЗаДеньЗалога = Выборка.НачислятьПроцентыЗаДеньЗалога;
		НеНачислятьПроцентыЗаПоследнийДень = Выборка.НеНачислятьПроцентыЗаПоследнийДень;
		СчитатьПроцентыДеньВыдачиРавенДеньВыкупа = Выборка.СчитатьПроцентыДеньВыдачиРавенДеньВыкупа;
		ОкруглятьПроценты = Выборка.ОкруглятьПроценты;
		ПорядокОкругления = Выборка.ПорядокОкругления;
        ОкруглятьВБольшуюСторону = Выборка.ОкруглятьВБольшуюСторону;
        ВидОкругленияСуммыПроцентов = Выборка.ВидОкругленияСуммыПроцентов;
		ОкруглятьЦены = Выборка.ОкруглятьОценка;
    КонецЕсли;

	Запрос.УстановитьПараметр("СтатусЗалогодателя", Объект.СтатусЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних.УвеличениеСтоимостиЗалога КАК УвеличениеСтоимостиЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			СтатусЗалогодателя = &СтатусЗалогодателя
	               |				И СхемаКредитования = &СхемаКредитования) КАК ЛБ_НастройкаУвеличенияЗалогаПоСтатусамЗалогодателейСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПроцентУвеличенияОценкиЗалога = Выборка.УвеличениеСтоимостиЗалога;
	Иначе
		ПроцентУвеличенияОценкиЗалога = 0;
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьСписокЛьготныхСтатусов() 
	СписокЛьготныхСтатусов.Очистить();
	
	//Проверим нового клиента
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Ссылка), Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая), ДатаДок));
	Запрос.УстановитьПараметр("Залогодатель", Объект.Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОперацииПоСистемеЛояльностиОбороты.КоличествоЗалоговОборот КАК КоличествоЗалогов
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОперацииПоСистемеЛояльности.Обороты(, &Дата, , Залогодатель = &Залогодатель) КАК ЛБ_ОперацииПоСистемеЛояльностиОбороты";   
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда   
		Если НЕ Выборка.КоличествоЗалогов = 0 Тогда
			СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.НовыйКлиент);
		КонецЕсли;	
	Иначе	
		СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.НовыйКлиент);
	КонецЕсли;

	
	//проверим пенсионер по возрасту 
	Объект.ВозрастЗалогодателя = ЛБ_ОбщийМодуль.ВычислитьВозраст(Объект.ДатаРождения);
	Если ЗначениеЗаполнено(Объект.ВозрастЗалогодателя) И ЗначениеЗаполнено(Объект.Пол) Тогда
		Если Объект.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда 
			Если Объект.ВозрастЗалогодателя  >= 55 Тогда  
				СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Пенсионер);
			КонецЕсли;	
		ИначеЕсли Объект.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
			Если Объект.ВозрастЗалогодателя  >= 60 Тогда  
				СписокЛьготныхСтатусов.Добавить(Перечисления.ЛБ_ЛьготныеСтатусыЗаемщика.Пенсионер);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	//проверим льготные документы   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеДокументовИЛьготныхСтатусов.СрезПоследних(&Дата, НеАктуально = ЛОЖЬ) КАК ЛБ_СоответствиеДокументовИЛьготныхСтатусовСрезПоследних";
	ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ДокументыЗалогодателя.ВидДокумента КАК ВидДокумента,
	              |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК СрокДействия
	              |ИЗ
	              |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛБ_ДокументыЗалогодателя КАК ЛБ_ДокументыЗалогодателя
	              |		ПО ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя = ЛБ_ДокументыЗалогодателя.Ссылка
	              |ГДЕ
	              |	ЛБ_ДокументыЗалогодателя.ПометкаУдаления = ЛОЖЬ
	              |	И ЛБ_ДокументыЗалогодателя.ВидДокументаЗалогодателя = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДокументовЗалогодателя.ДополнительныйДокумент)
	              |	И ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНеДействителен = ЛОЖЬ
	              |	И ЛБ_ДокументыЗалогодателя.Владелец = &Залогодатель";
	Выборка = Запрос.Выполнить().Выбрать();   
	ДатаПроверки = ДатаДок;
	Пока Выборка.Следующий() цикл
		Если НЕ (Выборка.СрокДействия = Дата(1,1,1)) Тогда
			Если Выборка.СрокДействия < ДатаПроверки Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Отбор = Новый структура;
		Отбор.Вставить("ВидДокумента", Выборка.ВидДокумента);
		Строки = ТаблицаСоответствия.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;     
		Стр = Строки.Получить(0);
		Если СписокЛьготныхСтатусов.НайтиПоЗначению(Стр.Статус) = неопределено  Тогда
			СписокЛьготныхСтатусов.Добавить(Стр.Статус);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьСписокВыбораИзъятия()
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда	  
		МоментДоДокумента = Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая);
		ДатаП = МоментДоДокумента; 
	Иначе	
	    ДатаП = Объект.Дата;		
	КонецЕсли;	

	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ДатаП);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", Объект.ПредыдущаяОперация); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И НЕ СтатусОбъектаЗалога = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалога.Изъят)) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать(); 
	Элементы.ТоварыИзъятыеОбъектЗалога.СписокВыбора.Очистить();
	Пока Выборка.Следующий() цикл       
		Отбор = новый Структура;
		Отбор.Вставить("ОбъектЗалога", Выборка.ОбъектЗалога);
		СтрокиТ = Объект.ТоварыИзъятыеВозвращенные.НайтиСтроки(Отбор);
		Если НЕ СтрокиТ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
	    Элементы.ТоварыИзъятыеОбъектЗалога.СписокВыбора.Добавить(Выборка.ОбъектЗалога); 
	Конеццикла;	
КонецПроцедуры	    

