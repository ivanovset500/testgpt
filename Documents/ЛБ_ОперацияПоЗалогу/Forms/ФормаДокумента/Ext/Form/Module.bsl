						Объект.Залогодатель = Параметры.Плательщик; 						   					
						ЗаполнитьСписокВыбораДоверенностейПлательщика();
						Если Элементы.ДоверенностьПлательщикаПолучателя.СписокВыбора.Количество() = 1 Тогда 
