	СуммаДолгПроцентыКоп = (ДолгПроценты - Цел(ДолгПроценты))*100;
    ОбластьМакета.Параметры.ДолгПроцентыРуб = Формат(СуммаДолгПроцентыРуб, "ЧЦ=15; ЧРГ=' '; ЧН=0"); 
	ОбластьМакета.Параметры.ДолгПроцентыКоп = Формат(СуммаДолгПроцентыКоп, "ЧЦ=2; ЧН=00; ЧВН=");
	ЕдиновременнаяОплата = "Единовременным платежом в день возврата займа:";                        
	СуммаЗаймаОст = СуммаЗайма - ТаблицаГрафикПлатежей.Итог("ОсновнойДолгОплачен");
	Оплатить = СуммаЗаймаОст + ПроцентыНачислить;
	СуммаОплатитьРуб = Цел(Оплатить);
	СуммаОплатитьКоп = (Оплатить - Цел(Оплатить))*100;
	
	ЕдиновременнаяОплата = ЕдиновременнаяОплата + Символы.ПС + "К оплате  на " + Формат(ДатаВыкупа, "ДФ=dd.MM.yyyy") + ": " + 
	        Формат(СуммаОплатитьРуб, "ЧЦ=15; ЧРГ=' '; ЧН=0") + " руб. " + Формат(СуммаОплатитьКоп, "ЧЦ=2; ЧН=00; ЧВН=") + " коп.";
	
	ОплатитьЗайм = СуммаЗаймаОст;
	СуммаОплатитьЗаймРуб = Цел(ОплатитьЗайм);
	СуммаОплатитьЗаймКоп = (ОплатитьЗайм - Цел(ОплатитьЗайм))*100;
	ЕдиновременнаяОплата = ЕдиновременнаяОплата + Символы.ПС + "в т.ч.: в погашение займа " +  
	   Формат(СуммаОплатитьЗаймРуб, "ЧЦ=15; ЧРГ=' '; ЧН=0") + " руб. " + Формат(СуммаОплатитьЗаймКоп, "ЧЦ=2; ЧН=00; ЧВН=") + " коп.";
	
	ОплатитьПроценты = ПроцентыНачислить;
	СуммаОплатитьПроцентыРуб = Цел(ОплатитьПроценты);
	СуммаОплатитьПроцентыКоп = (ОплатитьПроценты - Цел(ОплатитьПроценты))*100;
	ЕдиновременнаяОплата = ЕдиновременнаяОплата + Символы.ПС + "в оплату процентов " +  
	   Формат(СуммаОплатитьПроцентыРуб, "ЧЦ=15; ЧРГ=' '; ЧН=0") + " руб. " + Формат(СуммаОплатитьПроцентыКоп, "ЧЦ=2; ЧН=00; ЧВН=") + " коп.";
	
	ОбластьМакета.Параметры.ЕдиновременнаяОплата = ЕдиновременнаяОплата;
	
	ОбластьМакета.Параметры.ЛьготныйСрокНовый = Формат(ДатаВыкупаЛьготныйСрок, "ДФ=dd.MM.yyyy"); 		
	ОбластьМакета.Параметры.ЗалоговыйБилетСхемаКредитования = Ссылка.ПредыдущаяОперация.СхемаКредитования.НаименованиеДляПечати; 
	
	Если НЕ ТаблицаАнкета.Количество() = 0 Тогда
		СтрА = ТаблицаАнкета.Получить(0);
		ОбластьМакета.Параметры.ЗаемщикФинансовоеПоложение = ?(СтрА.ФинансовоеПоложениеСтабильное, "стабильное", "не стабильное");
		ОбластьМакета.Параметры.ЗаемщикДеловаяРепутация = ?(СтрА.ДеловаяРепутацияПоложительная, "положительная", "негативная");
		ОбластьМакета.Параметры.ЗаемщикИстДенСр = ?(ПустаяСтрока(СтрА.ИсточникПроисхожденияДенежныхСредств), СтрА.ИсточникПроисхожденияДенежныхСредствИной, СтрА.ИсточникПроисхожденияДенежныхСредств);
		ОбластьМакета.Параметры.ЗаемщикИстИмущ = ?(ПустаяСтрока(СтрА.ИсточникПроисхожденияИмущества), СтрА.ИсточникПроисхожденияИмуществаИной, СтрА.ИсточникПроисхожденияИмущества);
	КонецЕсли;	
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ГрафикШапка");
	ОбластьМакета.Параметры.ДополнительноеСоглашениеДата = Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ГрафикСтрока");   
	
	ПроцентыНачислены = 0; 	 
	ПроцентыОплачены = 0;  
	ОсновнойДолгОплачен = 0;
	Для Сч = 0 По ТаблицаГрафикПлатежей.Количество()-1 Цикл 
		ПроцентыНачислены = ПроцентыНачислены + ТаблицаГрафикПлатежей.Получить(сч).ПроцентыНачислены;
		ПроцентыОплачены = ПроцентыОплачены + ТаблицаГрафикПлатежей.Получить(сч).ПроцентыОплачены;
		ОсновнойДолгОплачен = ОсновнойДолгОплачен + ТаблицаГрафикПлатежей.Получить(сч).ОсновнойДолгОплачен;
	КонецЦикла;    
	Если ТаблицаГрафикПлатежей.Количество() = 0 Тогда
		ОстатокОсновнойДолг = СуммаЗайма;
		ОстатокПроценты = 0; 
		КонецРасчета = ДатаНачалаРасчета;
	Иначе      
		сч = ТаблицаГрафикПлатежей.Количество()-1; 
		ОстатокОсновнойДолг = ТаблицаГрафикПлатежей.Получить(сч).ОстатокОсновнойДолг;  
		ОстатокПроценты = ТаблицаГрафикПлатежей.Получить(сч).ОстатокПроценты;
		КонецРасчета = ТаблицаГрафикПлатежей.Получить(сч).Период;
	КонецЕсли;       
	НачалоРасчета = Ссылка.ПредыдущаяОперация.Дата;
    ОбластьМакета.Параметры.ГрафикПлатежейСуммаЗаймаОстатокНаНачало = Формат(СуммаЗайма, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");		            
    ОбластьМакета.Параметры.ГрафикПлатежейСуммаНачисления = Формат(ПроцентыНачислены, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '"); 
	ОбластьМакета.Параметры.ГрафикПлатежейСуммаОплатыВсего = Формат(ПроцентыОплачены + ОсновнойДолгОплачен, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
	ОбластьМакета.Параметры.ГрафикПлатежейСуммаОплатыПроценты = Формат(ПроцентыОплачены, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
	ОбластьМакета.Параметры.ГрафикПлатежейСуммаОплатыЗаем = Формат(ОсновнойДолгОплачен, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
    ОбластьМакета.Параметры.ГрафикПлатежейСуммаЗаймаОстатокНаКонец = Формат(ОстатокПроценты, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");  
	ОбластьМакета.Параметры.ГрафикПлатежейПериодНачисления = Формат(НачалоРасчета, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецРасчета, "ДФ=dd.MM.yyyy");
    ТабличныйДокумент.Вывести(ОбластьМакета); 
		
	ОбластьМакета = Макет.ПолучитьОбласть("КОплатеШапка");
	ОбластьМакета.Параметры.ДатаВозвратаНовая = Формат(ДатаВыкупа, "ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьМакета); 
	
	ОбластьМакета = Макет.ПолучитьОбласть("КОплатеСтрока");   
	Если ТаблицаГрафикПлатежей.Количество() = 0 Тогда  
		СуммаЗаймаКон = СуммаЗайма;
	Иначе	
	    СуммаЗаймаКон = ТаблицаГрафикПлатежей.Получить(ТаблицаГрафикПлатежей.Количество()-1).ОстатокОсновнойДолг; 
	КонецЕсли;	
	ОбластьМакета.Параметры.КОплатеСуммаЗаймаОстатокНаНачало = Формат(СуммаЗаймаКон, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
	ОбластьМакета.Параметры.КОплатеПериодНачисления = Формат(КонецДня(Ссылка.Дата) + 1, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаВыкупа, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.КОплатеСуммаНачисления = Формат(ПроцентыНачислить-ТекущийДолгПоПроцентам, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
	ОбластьМакета.Параметры.КОплатеПроцентыОстаток = Формат(ТекущийДолгПоПроцентам, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
	ОбластьМакета.Параметры.КОплатеВсего = Формат(СуммаЗаймаКон + ПроцентыНачислить, "ЧЦ=15; ЧДЦ=2; ЧН=0,00; ЧРГ=' '");
	ТабличныйДокумент.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("Подвал"); 
	ОбластьМакета.Параметры.ФИОЗаемщика = ФИО;
	Если Ссылка.Залогодатель = Ссылка.ПредыдущаяОперация.Залогодатель Тогда 
		ЭтоПредставитель = Ложь;
	    ОбластьМакета.Параметры.ЗаемщикПредставитель = "Заемщик";
		ОбластьМакета.Параметры.ОтИмени = "заемщика";
	Иначе      
		ЭтоПредставитель = Истина;
		ОбластьМакета.Параметры.ЗаемщикПредставитель = "Представитель заемщика";
		ОбластьМакета.Параметры.ОтИмени = "представителя заемщика";
	КонецЕсли;	
	ОбластьМакета.Параметры.ДополнительноеСоглашениеДата = Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.ЛьготныйСрокНовый = Формат(ДатаВыкупаЛьготныйСрок, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.Ответственный = Ссылка.ОтветственныйСотрудник;
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина; 
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	Подписи = Символы.ПС;
	Подписи = Подписи + "Выдал " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + " приемщик-оценщик ювелирных изделий:                                     Ознакомлен и согласен, " + ?(ЭтоПредставитель, "Представитель заемщика:    ", "Заемщик:    ") + Символы.ПС +
	                    "__________________________" + СокрЛП(Ссылка.ОтветственныйСотрудник) + "              МП                    "  +  "V__________________________" + СокрЛП(ФИОПодпись)+ Символы.ПС +
	                    "                  (Подпись)               (Фамилия и иницалы)                                                    (Подпись)                   (Фамилия и иницалы)"; 
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = Подписи;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	//ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Залоговый билет № " + СокрЛП(Ссылка.НомерЗалоговогоБилета) + " от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"); 
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;	
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 40;
	
	Возврат ТабличныйДокумент;

КонецФункции	

Функция ПечатьПКО(МассивОбъектов, ОбъектыПечати) Экспорт
	//+МАН 02.12.25 Добавил условие ранее было только //Ссылка = МассивОбъектов[0]//
	Если ТипЗнч(МассивОбъектов) = Тип("Массив") Тогда
		Ссылка = МассивОбъектов[0];
	ИначеЕсли ТипЗнч(МассивОбъектов) = Тип("Структура") Тогда
		Ссылка = МассивОбъектов;
		Ссылка.Вставить("Дата", МассивОбъектов.НачалоПериода);
	КонецЕсли;
	//-МАН
	
	НомерПКО = "";  
	СтруктураКС = ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(Ссылка.Дата, Ссылка.Организация, Ссылка.Ломбард);
	Если НЕ СтруктураКС = неопределено Тогда 
		НомерПКО = СтруктураКС.ПКОСводный.ПредставлениеНомераПКО;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Ссылка.Дата)); 
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Ссылка.Дата)); 
	Запрос.УстановитьПараметр("Организация", Ссылка.Организация);
	Запрос.УстановитьПараметр("Ломбард", Ссылка.Ломбард); 
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ЛБ_ПриходныйКассовыйОрдер.ПредставлениеНомераПКО КАК НомерПКО
	//               |ИЗ
	//               |	Документ.ЛБ_ПриходныйКассовыйОрдер КАК ЛБ_ПриходныйКассовыйОрдер
	//               |ГДЕ
	//               |	ЛБ_ПриходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНач И &ДатаКон
	//               |	И ЛБ_ПриходныйКассовыйОрдер.Организация = &Организация
	//               |	И ЛБ_ПриходныйКассовыйОрдер.Ломбард = &Ломбард
	//               |	И ЛБ_ПриходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПКО.СводныйПКО)
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	ЛБ_ПриходныйКассовыйОрдер.Дата УБЫВ";
	//Выборка = Запрос.Выполнить().Выбрать();
	//Если Выборка.Следующий() Тогда
	//	НомерПКО = Выборка.НомерПКО; 
	//КонецЕсли;	     
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиОбороты.ВидРасчета КАК ВидРасчета,
	               |	СУММА(ЛБ_РасчетыСКлиентамиОбороты.СуммаРасход) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентами.Обороты(&ДатаНач, &ДатаКон, Регистратор, Организация = &Организация) КАК ЛБ_РасчетыСКлиентамиОбороты
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентамиОбороты.Регистратор.Ломбард = &Ломбард
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиОбороты.ВидРасчета";
	ТаблицаРасчетов = Запрос.Выполнить().Выгрузить();
	Основание = "";
	Отбор = Новый Структура;
	Отбор.Вставить("ВидРасчета", Перечисления.ЛБ_ВидыРасчетов.ПоОсновномуДолгу);
	Строки = ТаблицаРасчетов.НайтиСтроки(Отбор);
	Если НЕ Строки.Количество() = 0 Тогда
		СтрР = строки.Получить(0);
		Основание = Основание + "Возврат займов в сумме " + СокрЛП(Формат(СтрР.Сумма, "ЧЦ=15; ЧДЦ=2"));
	КонецЕсли;	
	Отбор.Вставить("ВидРасчета", Перечисления.ЛБ_ВидыРасчетов.ПоПроцентам);
	Строки = ТаблицаРасчетов.НайтиСтроки(Отбор);
	Если НЕ Строки.Количество() = 0 Тогда
		СтрР = строки.Получить(0);
		Основание = Основание + ?(ПустаяСтрока(Основание), "Оплата процентов в сумме ", ", оплата процентов в сумме ") + СокрЛП(Формат(СтрР.Сумма, "ЧЦ=15; ЧДЦ=2"));
	КонецЕсли;	
	Основание = Основание + ?(ПустаяСтрока(Основание), "", " за " + Формат(КонецДня(Ссылка.Дата), "ДФ=dd.MM.yyyy"));

	СписокВО = новый СписокЗначений;
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийПКО.ОплатаПоЗайму);
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийПКО.ОплатаПоЗаймуПереоформление);
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийПКО.ОтменаОплатыПоЗаймуПереоформлению);
	Запрос.УстановитьПараметр("ВидыОперации", СписокВО);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДвиженияДенежныхСредств.Организация КАК Организация,
	               |	ЛБ_ДвиженияДенежныхСредств.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ДвиженияДенежныхСредств.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
	               |ГДЕ
	               |	ЛБ_ДвиженияДенежныхСредств.Организация = &Организация
	               |	И ЛБ_ДвиженияДенежныхСредств.Ломбард = &Ломбард
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДвиженияДС.Приход)
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидОперации В(&ВидыОперации)
	               |	И ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &ДатаНач И &ДатаКон
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ДвиженияДенежныхСредств.Ломбард,
	               |	ЛБ_ДвиженияДенежныхСредств.Организация";
	
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ПКО";  
	//+МАН 02.12.25 Добавил параметр
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	
	// Получаем макет
	Макет = ПолучитьОбщийМакет("ПФ_MXL_КО1");    
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ПредставлениеОрганизации = СокрЛП(Ссылка.Организация); 
	ОбластьМакета.Параметры.ОрганизацияПоОКПО = "4107218";
	//+МАН Изменилось наименование ломбарда. Берем наименование из полного. Заявка 2956
	//Было: ОбластьМакета.Параметры.ПредставлениеПодразделения = СокрЛП(Ссылка.Ломбард);
	ОбластьМакета.Параметры.ПредставлениеПодразделения = СокрЛП(Ссылка.Ломбард.НаименованиеПолное);
	//-МАН
	ОбластьМакета.Параметры.КодПодразделения = СокрЛП(Ссылка.Ломбард.НомерЛомбарда);
	ОбластьМакета.Параметры.ДатаДокумента = Формат(КонецДня(Ссылка.Дата), "ДФ=dd.MM.yyyy"); 
	ОбластьМакета.Параметры.НомерДокумента = НомерПКО;
	ОбластьМакета.Параметры.ПринятоОт = "Залогодателей с применением ККТ"; 
	ОбластьМакета.Параметры.Основание = Основание;
	ОбластьМакета.Параметры.Приложение = "Отчет о состоянии счетчиков ККТ с гашением за " + Формат(Ссылка.Дата, "ДЛФ=DD"); 
	ОбластьМакета.Параметры.ВТомЧисле = "НДС не предусмотрен"; 
	СтруктураКтДт = ЛБ_ОбщийМодуль.ЗаполнитьДтКт(Перечисления.ЛБ_ВидыОперацийПКО.ОплатаПоЗайму); 
	Если НЕ СтруктураКтДт = неопределено Тогда
	    ОбластьМакета.Параметры.КодДебета = СокрЛП(СтруктураКтДт.Дт); 
		ОбластьМакета.Параметры.СубСчет = СокрЛП(СтруктураКтДт.Кт); 
	КонецЕсли;	    
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	ОбластьМакета.Параметры.ФИОКассира = Ответственный; 
	ОбластьМакета.Параметры.ФИОГлавногоБухгалтера = Ответственный;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммаРуб = Цел(Выборка.Сумма);
		СуммаКоп = (Выборка.Сумма - Цел(Выборка.Сумма))*100;
		ОбластьМакета.Параметры.СуммаРубКоп = СокрЛП(Формат(СуммаРуб, "ЧЦ=15; ЧРГ=' '; ЧН=0")) + " руб. " + СокрЛП(Формат(СуммаКоп, "ЧЦ=2; ЧН=00; ЧВН=")) + " коп."; 
		
		ФормСтрока = "Л = ru_RU; ДП = Ложь";
	    ПарПредмета="рубль,рубля,рублей,м,копейка,копейки,копеек,м,2";
		ОбластьМакета.Параметры.СуммаПрописью = ЧислоПрописью(Выборка.Сумма, ФормСтрока, ПарПредмета); 
	    ОбластьМакета.Параметры.Сумма  = СокрЛП(Формат(Выборка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРГ="));
	КонецЕсли;	
	ТабличныйДокумент.Вывести(ОбластьМакета);

	Возврат ТабличныйДокумент;
КонецФункции

Функция ПечатьРКО(МассивОбъектов, ОбъектыПечати) Экспорт
	//+МАН 02.12.25 Добавил условие ранее было только //Ссылка = МассивОбъектов[0]//
	Если ТипЗнч(МассивОбъектов) = Тип("Массив") Тогда
		Ссылка = МассивОбъектов[0];
	ИначеЕсли ТипЗнч(МассивОбъектов) = Тип("Структура") Тогда
		Ссылка = МассивОбъектов;
		Ссылка.Вставить("Дата", МассивОбъектов.НачалоПериода);
	КонецЕсли;
	//-МАН
	
	НомерРКО = ""; 
	СтруктураКС = ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(Ссылка.Дата, Ссылка.Организация, Ссылка.Ломбард);
	Если НЕ СтруктураКС = неопределено Тогда 
		НомерРКО = СтруктураКС.РКОСводный.ПредставлениеНомераРКО;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Ссылка.Дата)); 
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Ссылка.Дата)); 
	Запрос.УстановитьПараметр("Организация", Ссылка.Организация);
	Запрос.УстановитьПараметр("Ломбард", Ссылка.Ломбард); 
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ЛБ_РасходныйКассовыйОрдер.ПредставлениеНомераРКО КАК НомерРКО
	//               |ИЗ
	//               |	Документ.ЛБ_РасходныйКассовыйОрдер КАК ЛБ_РасходныйКассовыйОрдер
	//               |ГДЕ
	//               |	ЛБ_РасходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНач И &ДатаКон
	//               |	И ЛБ_РасходныйКассовыйОрдер.Организация = &Организация
	//               |	И ЛБ_РасходныйКассовыйОрдер.Ломбард = &Ломбард
	//               |	И ЛБ_РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийРКО.СводныйРКО)
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	ЛБ_РасходныйКассовыйОрдер.Дата УБЫВ";
	//Выборка = Запрос.Выполнить().Выбрать();
	//Если Выборка.Следующий() Тогда
	//	НомерРКО = Выборка.НомерРКО; 
	//КонецЕсли;	     

	СписокВО = новый СписокЗначений;
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийРКО.ВыдачаЗайма);
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийРКО.ВыдачаЗаймаПереоформление);
	СписокВО.Добавить(Перечисления.ЛБ_ВидыОперацийРКО.ОтменаВыдачиЗайма);
	Запрос.УстановитьПараметр("ВидыОперации", СписокВО);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДвиженияДенежныхСредств.Организация КАК Организация,
	               |	ЛБ_ДвиженияДенежныхСредств.Ломбард КАК Ломбард,
	               |	СУММА(ЛБ_ДвиженияДенежныхСредств.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
	               |ГДЕ
	               |	ЛБ_ДвиженияДенежныхСредств.Организация = &Организация
	               |	И ЛБ_ДвиженияДенежныхСредств.Ломбард = &Ломбард
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидДвиженияДС = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДвиженияДС.Расход)
	               |	И ЛБ_ДвиженияДенежныхСредств.ВидОперации В(&ВидыОперации)
	               |	И ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &ДатаНач И &ДатаКон
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ДвиженияДенежныхСредств.Ломбард,
	               |	ЛБ_ДвиженияДенежныхСредств.Организация";
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_РКО";  
	//+МАН 02.12.25 Добавил параметр
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//-МАН
	
	// Получаем макет
	Макет = ПолучитьОбщийМакет("ПФ_MXL_КО2");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ПредставлениеОрганизации = СокрЛП(Ссылка.Организация);
	ОбластьМакета.Параметры.ОрганизацияПоОКПО = "4107218";
	//+МАН Изменилось наименование ломбарда. Берем наименование из полного. Заявка 2956
	//Было: ОбластьМакета.Параметры.ПредставлениеПодразделения = СокрЛП(Ссылка.Ломбард); 
	ОбластьМакета.Параметры.ПредставлениеПодразделения = СокрЛП(Ссылка.Ломбард.НаименованиеПолное);
	//-МАН
	ОбластьМакета.Параметры.КодПодразделения = СокрЛП(Ссылка.Ломбард.НомерЛомбарда);
	ОбластьМакета.Параметры.ДатаДокумента = Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.НомерДокумента = НомерРКО;
	ОбластьМакета.Параметры.ФИОПолучателя = "Залогодателям с применением ККТ"; 
	ОбластьМакета.Параметры.Основание = "Выдача денежных средств по договорам займа за " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.Приложение = "Отчет о состоянии счетчиков ККТ с гашением, "  + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"); 
	СтруктураКтДт = ЛБ_ОбщийМодуль.ЗаполнитьДтКт(Перечисления.ЛБ_ВидыОперацийРКО.ВыдачаЗайма); 
	Если НЕ СтруктураКтДт = неопределено Тогда
	    ОбластьМакета.Параметры.ДебетСубСчет = СокрЛП(СтруктураКтДт.Дт); 
		ОбластьМакета.Параметры.КредитСубСчет = СокрЛП(СтруктураКтДт.Кт); 
	КонецЕсли;	     
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
   		Ответственный = ТекПользователь;
	Иначе
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;	
	ОбластьМакета.Параметры.ФИОКассира = Ответственный;
	ОбластьМакета.Параметры.ФИОГлавногоБухгалтера = Ответственный;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
				
		СуммаРуб = Цел(Выборка.Сумма);
		СуммаКоп = (Выборка.Сумма - Цел(Выборка.Сумма))*100;
		СуммаРубКоп = СокрЛП(Формат(СуммаРуб, "ЧЦ=15; ЧРГ=' '; ЧН=0")) + " руб. " + СокрЛП(Формат(СуммаКоп, "ЧЦ=2; ЧН=00; ЧВН=")) + " коп."; 
		
		ФормСтрока = "Л = ru_RU; ДП = Ложь";
	    ПарПредмета="рубль,рубля,рублей,м,копейка,копейки,копеек,м,2";
		СуммаПрописью = ЧислоПрописью(Выборка.Сумма, ФормСтрока, ПарПредмета);	
		СуммаПрописьюПродолжение = "";
		Если СтрДлина(СуммаПрописью) > 92 Тогда
			н = 92;
			Пока н > 0 И Сред(СуммаПрописью, н, 1) <> " " Цикл
				н = н-1;
			КонецЦикла;
			
			СуммаПрописьюПродолжение = Сред(СуммаПрописью, н + 1);
			СуммаПрописью = Лев(СуммаПрописью, н);
		КонецЕсли;
		ОбластьМакета.Параметры.СуммаПрописью         = СуммаПрописью;
		ОбластьМакета.Параметры.СуммаПрописьюПродолжение = СуммаПрописьюПродолжение;
    	ОбластьМакета.Параметры.Сумма  = СуммаРубКоп;  
		ОбластьМакета.Параметры.ДатаДокументаПрописью = Формат(Ссылка.Дата, "ДФ='dd MMMM yyyy ""г.""'");   
	КонецЕсли;	
	ТабличныйДокумент.Вывести(ОбластьМакета);

	Возврат ТабличныйДокумент;
КонецФункции

