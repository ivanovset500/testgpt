КонецФункции	

Функция _ПечатьЗалоговогоБилетаПереоформление(МассивОбъектов, ОбъектыПечати) Экспорт
	Ссылка = МассивОбъектов[0];  
	
	Запрос = новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Ссылка.Дата);
	Запрос.УстановитьПараметр("Залогодатель", Ссылка.Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПропискеСтруктура КАК АдресПоПропискеСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдресСтруктура КАК ФактическийАдресСтруктура,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПропискеВручную КАК АдресПоПропискеВручную,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдресВручную КАК ФактическийАдресВручную
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	ТаблицаКИ = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ФинансовоеПоложениеСтабильное КАК ФинансовоеПоложениеСтабильное,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ДеловаяРепутацияПоложительная КАК ДеловаяРепутацияПоложительная,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмущества КАК ИсточникПроисхожденияИмущества,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмуществаИной КАК ИсточникПроисхожденияИмуществаИной,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредств КАК ИсточникПроисхожденияДенежныхСредств,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредствИной КАК ИсточникПроисхожденияДенежныхСредствИной,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ХарактерОтношений КАК ХарактерОтношений,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.УровеньРиска КАК УровеньРиска
	               |ИЗ
	               |	РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_АнкетаЗалогодателяСрезПоследних";  
	ТаблицаАнкета = Запрос.Выполнить().Выгрузить();
	
	Запрос.УстановитьПараметр("ДокументЗалогодателя", Ссылка.ДокументЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(&Дата, ДокументЗалогодателя = &ДокументЗалогодателя) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
	ТаблицаДок = Запрос.Выполнить().Выгрузить(); 
	
	ПроцентнаяСтавкаНач = 0;
	ОтборС = Новый Структура;
	ОтборС.Вставить("ДеньНачалаПрименения", 1);  
	ОтборС.Вставить("ПричинаПрименения", Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма);
    СтрокиС = Ссылка.ПроцентныеСтавкиПоПериодам.НайтиСтроки(ОтборС);
	Если НЕ СтрокиС.Количество() = 0 Тогда 
		СтрС = СтрокиС.Получить(0);  
		ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавка;
		Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
			Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
				ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавкаАкция;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
				ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
				ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
		    КонецЕсли; 
		КонецЕсли;
	КонецЕсли;	

	ОтборТех = Новый Структура;
	ОтборТех.Вставить("ВидПроцентнойСтавки", Перечисления.ЛБ_ВидыПроцентныхСтавок.Техническая);  
	ОтборТех.Вставить("ПричинаПрименения", Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма);
	СтрокиТех = Ссылка.ПроцентныеСтавкиПоПериодам.НайтиСтроки(ОтборТех);
	Если НЕ СтрокиТех.Количество() = 0 Тогда  
		СтрТех = СтрокиТех.Получить(0);
		ПроцентнаяСтавкаТехн = СтрТех.ПроцентнаяСтавка;
		ДеньНачалаПримененияТехн = СтрТех.ДеньНачалаПрименения;
	Иначе
		ПроцентнаяСтавкаТехн = 0;
		ДеньНачалаПримененияТехн = 1;
	КонецЕсли;	
	ТаблицаОбъектов = Ссылка.Товары.Выгрузить();
	
	СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(Ссылка.Дата, Ссылка.Организация); 
	ПланкаПроцентов = 0;
	Попытка
	    ПланкаПроцентов = СтруктураП.ПланкаПроцентов;
	Исключение
	КонецПопытки;	
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.АвтоМасштаб    = Истина;      
	
	// Получаем макет
	Макет = ПолучитьОбщийМакет("ПФ_MXL_Переоформление");	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка"); 
	СуммаПроцентов = Ссылка.ГрафикПлатежей.Итог("СуммаПроцентов");
	СрокРасчета = (Ссылка.ДатаВыкупа - НачалоДня(Ссылка.Дата))/(24*60*60);
	Если НЕ Ссылка.ПСК_LX = 0 Тогда
		ПСК = Ссылка.ПСК_LX;
	Иначе
		ПСК = ЛБ_УправлениеЛомбардом.РасчетПСКГод(Ссылка.Дата,СрокРасчета, Ссылка.СуммаСсуды, СуммаПроцентов);
	КонецЕсли;	
	ОбластьМакета.Параметры.ЗалоговыйБилетПСКПроценты = Формат(ПСК, "ЧЦ=10; ЧДЦ=3; ЧРГ=' '") + " %";
	ФормСтрока = "Л = ru_RU; ДП = Истина";
    ПарПредмета="целая,целых,целых,ж,тысячная,тысячных,тысячных,ж,3";
	ОбластьМакета.Параметры.ЗалоговыйБилетПСКПроцентыПрописью = ЧислоПрописью(ПСК, ФормСтрока, ПарПредмета) + " процента";  
	ПСКСумма = Ссылка.ГрафикПлатежей.Итог("СуммаПроцентов");
	ПСКСуммаРуб = Цел(ПСКСумма);
	ПСКСуммаКоп = (ПСКСумма - Цел(ПСКСумма))*100;
	ОбластьМакета.Параметры.ЗалоговыйБилетПСКРубли = Формат(ПСКСуммаРуб, "ЧЦ=15; ЧРГ=' '");
	ОбластьМакета.Параметры.ЗалоговыйБилетПСККоп = Формат(ПСКСуммаКоп, "ЧЦ=2; ЧН=00; ЧВН="); 
	ФормСтрока = "Л = ru_RU; ДП = Ложь";
    ПарПредмета="рубль,рубля,рублей,м,копейка,копейки,копеек,м,2";
	ОбластьМакета.Параметры.ЗалоговыйБилетПСКРублиПрописью = ЧислоПрописью(ПСКСумма, ФормСтрока, ПарПредмета); 
	
	ОбластьМакета.Параметры.ЗалоговыйБилетНомер = Ссылка.НомерЗалоговогоБилета; 
	ОбластьМакета.Параметры.ЗалоговыйБилетДата = Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"); 
	ОбластьМакета.Параметры.Организация = СокрЛП(Ссылка.Организация); 
	ОбластьМакета.Параметры.ОрганизацияИНН = СокрЛП(Ссылка.Организация.ИНН); 
	ОбластьМакета.Параметры.ОрганизацияОГРН = СокрЛП(Ссылка.Организация.ОГРН);   
	ОтборК = Новый Структура;
	ОтборК.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес); 
	ОтборК.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ЮридическийАдресОрганизации);
	СтрокиК = Ссылка.Организация.КонтактнаяИнформация.НайтиСтроки(ОтборК);
	Если НЕ СтрокиК.Количество() = 0 Тогда 
	    ОбластьМакета.Параметры.ОрганизацияЮрАдрес = СтрокиК.Получить(0).Представление;
	КонецЕсли;  
	ОтборК.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон); 
	ОтборК.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	СтрокиК = Ссылка.Организация.КонтактнаяИнформация.НайтиСтроки(ОтборК);
	Если НЕ СтрокиК.Количество() = 0 Тогда 
	    ОбластьМакета.Параметры.ОрганизацияОснТелефон = СтрокиК.Получить(0).Представление;
	КонецЕсли;
	ОтборК.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты); 
	ОтборК.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.EmailОрганизации);
	СтрокиК = Ссылка.Организация.КонтактнаяИнформация.НайтиСтроки(ОтборК);
	Если НЕ СтрокиК.Количество() = 0 Тогда 
	    ОбластьМакета.Параметры.ОрганизацияОснЭлАдрес = СтрокиК.Получить(0).АдресЭП; 
	КонецЕсли;	
	ОтборК.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.ВебСтраница); 
	ОтборК.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Web-cайт организации"));
	СтрокиК = Ссылка.Организация.КонтактнаяИнформация.НайтиСтроки(ОтборК);
	Если НЕ СтрокиК.Количество() = 0 Тогда 
	    ОбластьМакета.Параметры.ОрганизацияОснURL = СтрокиК.Получить(0).Представление; 
	КонецЕсли; 
	
	ОбластьМакета.Параметры.Ломбард = "Ломбард"; 
	ОбластьМакета.Параметры.ЛомбардНомер = Ссылка.Ломбард.НомерЛомбарда;
	
	ОтборК.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес); 
	ОтборК.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ФактАдресЛомбарда);
	СтрокиК = Ссылка.Ломбард.КонтактнаяИнформация.НайтиСтроки(ОтборК);
	Если НЕ СтрокиК.Количество() = 0 Тогда 
	    ОбластьМакета.Параметры.ЛомбардФактАдрес = СтрокиК.Получить(0).Представление;
	КонецЕсли;
	ОтборК.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон); 
	ОтборК.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонЛомбарда);
	СтрокиК = Ссылка.Ломбард.КонтактнаяИнформация.НайтиСтроки(ОтборК);
	Если НЕ СтрокиК.Количество() = 0 Тогда 
	    ОбластьМакета.Параметры.ЛомбардТелефон = СтрокиК.Получить(0).Представление; 
	КонецЕсли;		
	ОбластьМакета.Параметры.Приемщик = Ссылка.ОтветственныйСотрудник;  
	
    ТекстЗаемщик = ""; 
	ФИО = "";  
	ФИОПодпись = "";
	Если НЕ ТаблицаКИ.Количество() = 0 Тогда
		СтрКИ = ТаблицаКИ.Получить(0);
		ФИО = СокрЛП(СтрКИ.Фамилия) + " " + СокрЛП(СтрКИ.Имя) + ?(НЕ Пустаястрока(СтрКИ.Отчество), " " + СокрЛП(СтрКИ.Отчество), ""); 
		ФИОПодпись = СокрЛП(СтрКИ.Фамилия) + " " + СокрЛП(Лев(СтрКИ.Имя,1)) + "." + ?(НЕ Пустаястрока(СтрКИ.Отчество), " " + СокрЛП(Лев(СтрКИ.Отчество,1)) + ".", "");
		ДокументЗаемщика = "";
		Если НЕ ТаблицаДок.Количество() = 0 Тогда
			СтрДок = ТаблицаДок.Получить(0);
			ДокументЗаемщика = СокрЛП(СтрДок.ВидДокумента);
			ДокументЗаемщика = ДокументЗаемщика + ?(ЗначениеЗаполнено(СтрДок.ДокументСерия), " " + СокрЛП(СтрДок.ДокументСерия), "");
			ДокументЗаемщика = ДокументЗаемщика + ?(ЗначениеЗаполнено(СтрДок.ДокументНомер), " " + СокрЛП(СтрДок.ДокументНомер), "");
			ДокументЗаемщика = ДокументЗаемщика + ?(ЗначениеЗаполнено(СтрДок.ДокументКемВыдан), " выдан " + СокрЛП(СтрДок.ДокументКемВыдан), "");
			ДокументЗаемщика = ДокументЗаемщика + ?(ЗначениеЗаполнено(СтрДок.ДокументДатаВыдачи), " " + Формат(СтрДок.ДокументДатаВыдачи,"ДФ=dd.MM.yyyy"), "");
			ДокументЗаемщика = ДокументЗаемщика + ?(ЗначениеЗаполнено(СтрДок.ДокументКодПодразделения), " код подр. " + СокрЛП(СтрДок.ДокументКодПодразделения), "");
			ДокументЗаемщика = ДокументЗаемщика + ?(ЗначениеЗаполнено(СтрДок.ДокументСрокДействия), " действует по " + Формат(СтрДок.ДокументСрокДействия,"ДФ=dd.MM.yyyy"), "")
		КонецЕсли;	
	   
		Если НЕ ПустаяСтрока(СтрКИ.АдресПоПрописке) Тогда
			АдресПоПрописке = СокрЛП(СтрКИ.АдресПоПрописке);
			Если НЕ СтрКИ.Гражданство = Справочники.СтраныМира.Россия Тогда  
				Если НЕ СтрКИ.АдресПоПропискеВручную Тогда
					СтруктураАдреса = АдресныйКлассификаторСлужебный.КонтактнаяИнформацияВСтруктуруJSON(СтрКИ.АдресПоПропискеСтруктура);
					Страна = СокрЛП(СтруктураАдреса.Country);
				    Если ЗначениеЗаполнено(Страна) Тогда 
						Если Найти(ВРег(АдресПоПрописке), Врег(Страна)) = 0 Тогда 
							АдресПоПрописке = Страна + " " + АдресПоПрописке;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		Иначе   
			АдресПоПрописке = СокрЛП(СтрКИ.ФактическийАдрес);
			Если НЕ СтрКИ.Гражданство = Справочники.СтраныМира.Россия Тогда  
				Если НЕ СтрКИ.ФактическийАдресВручную Тогда
					СтруктураАдреса = АдресныйКлассификаторСлужебный.КонтактнаяИнформацияВСтруктуруJSON(СтрКИ.ФактическийАдресСтруктура);
					Страна = СокрЛП(СтруктураАдреса.Country);
				    Если ЗначениеЗаполнено(Страна) Тогда 
