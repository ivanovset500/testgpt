Процедура СформироватьШтрихкод(Область, Ссылка,  ИспользоватьШКДляБСО)
	
	ТребуетсяУдалитьРисунок = Ложь;
	ИмяКартинки 			= "ШТРИХКОД1";
	
	Если ИспользоватьШКДляБСО Тогда
		
		ШК = Ссылка.ЗалоговыйБилет.ШтрихкодБилета;
		
		ВнешняяКомпонента = УправлениеПечатью.ПодключитьКомпонентуПечатиШтрихкода();
				
		Если ЗначениеЗаполнено(ШК) И ВнешняяКомпонента <> Неопределено Тогда  			
			//формирует штрихкод для каждого рисунка области с именем, указанным в ИмяКартинки
			Для Каждого Рисунок Из Область.Рисунки Цикл						
				Если Врег(Рисунок.Имя) = ИмяКартинки Тогда   					
					Попытка
						//вывод через BARCODE
						Если НЕ Рисунок.Объект = Неопределено Тогда
							Рисунок.Объект.Сообщение = СокрЛП(ШК);
						Иначе
							Рисунок.Текст = СокрЛП(ШК);
						КонецЕсли;	   						
					Исключение						
						//СК добавила на всякий случай, чтобы не сорвать операцию по залогу
						Попытка
							ПараметрыШтрихкода = Новый Структура;
							ПараметрыШтрихкода.Вставить("Ширина",          Рисунок.Ширина);
							ПараметрыШтрихкода.Вставить("Высота",          Рисунок.Высота);
							ПараметрыШтрихкода.Вставить("Штрихкод",        СокрЛП(ШК));
							ПараметрыШтрихкода.Вставить("ТипКода",         Неопределено);
							ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
							ПараметрыШтрихкода.Вставить("РазмерШрифта",    12);     
							
							Рисунок.Картинка = УправлениеПечатью.ПолучитьКартинкуШтрихкода(ВнешняяКомпонента,
							ПараметрыШтрихкода); 
							
							Область.Параметры.ШтрихкодБилета = СокрЛП(ШК);
						Исключение
							ТребуетсяУдалитьРисунок = Истина;
						КонецПопытки;  												
					КонецПопытки; 					
					Прервать;     					
				КонецЕсли; 				
			КонецЦикла;			
		Иначе
			ТребуетсяУдалитьРисунок = Истина;
		КонецЕсли;
	Иначе
		ТребуетсяУдалитьРисунок = Истина;
	КонецЕсли;
	
	
	//Если ранее было определено, что рисунок нужно удалить - удаляем его
	Если ТребуетсяУдалитьРисунок Тогда
		
		//получим первоначальный массив рисунков таб документа.
		МассивРисунковТабДокумента = Новый Массив;
		Для Каждого Рисунок Из Область.Рисунки Цикл				
			Если Врег(Рисунок.Имя) = ИмяКартинки Тогда
				МассивРисунковТабДокумента.Добавить(Рисунок);
			КонецЕсли;
		КонецЦикла;
		
		//удалим все штрихкоды.
		Для Каждого Рисунок Из МассивРисунковТабДокумента Цикл				
			Попытка
				Область.Рисунки.Удалить(Рисунок);
			Исключение
			КонецПопытки;					
		КонецЦикла;
		
	КонецЕсли;
	//\

КонецПроцедуры

// Печатает условия договора о залоге
//
// Параметры
//  Нет
// 
// Возвращаемое значение
//  Табличный документ
//
Функция ПечатьУсловийДоговораОЗалоге(МассивОбъектов) Экспорт 

	Ссылка = МассивОбъектов[0].Ссылка;
	Макет = ПолучитьМакет("УсловияДоговораОЗалоге");

	ТабДокумент = Новый ТабличныйДокумент();
		
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Организация = Ссылка.ЗалоговыйБилет.Организация.Наименование + ", " + Ссылка.ЗалоговыйБилет.Филиал.Наименование;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабДокумент;

КонецФункции // ПечатьУсловийДоговораОЗалоге()

