	ОбластьМакета = Макет.ПолучитьОбласть("Раздел2Шапка");
	ТабличныйДокумент.Вывести(ОбластьМакета);
		
	НомПП = 0;     
	СуммаОценкиИтог = 0;
	Для каждого стр Из ТаблицаОбъектов Цикл 
		Если НЕ Стр.Переоформить Тогда
			Продолжить;
		КонецЕсли;	
		ОбластьМакета = Макет.ПолучитьОбласть("Раздел2Строка");
		НомПП = НомПП + 1;
		ОбластьМакета.Параметры.НомерПоПорядку = НомПП;
		СтруктураОписанияОЗ = ЛБ_УправлениеЛомбардом.ОписаниеОбъектаЗалогаДляПечати(Ссылка, Стр.ОбъектЗалога, 1);
	    ОбластьМакета.Параметры.ОбъектЗалога = СтруктураОписанияОЗ.Описание;
	    ОбластьМакета.Параметры.ОбъектЗалогаОценка = Формат(Стр.СуммаОценкиМаксимальная, "ЧЦ=15; ЧДЦ=2; ЧН=00; ЧРГ=' '");  
		СуммаОценкиИтог = СуммаОценкиИтог + Стр.СуммаОценкиМаксимальная;
		ТабличныйДокумент.Вывести(ОбластьМакета);
		Если НЕ ПустаяСтрока(СтруктураОписанияОЗ.ОписаниеВ) Тогда 
		    ОбластьМакетаВ = Макет.ПолучитьОбласть("Раздел2СтрокаВставки");
			ОбластьМакетаВ.Параметры.Вставки = СтруктураОписанияОЗ.ОписаниеВ;
			ТабличныйДокумент.Вывести(ОбластьМакетаВ);
		КонецЕсли;	
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Раздел2СтрокаИтог");  
	ОбластьМакета.Параметры.ЗалоговыйБилетСуммаОценки = Формат(СуммаОценкиИтог, "ЧЦ=15; ЧДЦ=2; ЧН=00; ЧРГ=' '"); 
	ФормСтрока = "Л = ru_RU; ДП = Ложь";
    ПарПредмета="рубль,рубля,рублей,м,копейка,копейки,копеек,м,2";
	ОбластьМакета.Параметры.ЗалоговыйБилетСуммаОценкиПрописью = ЧислоПрописью(СуммаОценкиИтог, ФормСтрока, ПарПредмета); 
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Раздел2Подвал");  
	Если ЗначениеЗаполнено(Ссылка.Представитель) Тогда  
		ЭтоПредставитель = Истина;
		ОбластьМакета.Параметры.ФИОЗаемщика = ФИОПредставитель;
		ОбластьМакета.Параметры.ОтИмени = "представителя заемщика";
	Иначе           
		ЭтоПредставитель = Ложь;
		ОбластьМакета.Параметры.ФИОЗаемщика = ФИО;
		ОбластьМакета.Параметры.ОтИмени = "заемщика";
	КонецЕсли;
	ОбластьМакета.Параметры.Дата =  Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"); 
	ОбластьМакета.Параметры.Ответственный = Ссылка.ОтветственныйСотрудник;
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина; 
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	Подписи = Символы.ПС;
	Подписи = Подписи + "Приемщик-оценщик ювелирных изделий:                                                               Ознакомлен и согласен, " + ?(ЭтоПредставитель, "Представитель заемщика:    ", "Заемщик:    ") +  Символы.ПС +
	                    "__________________________" + СокрЛП(Ссылка.ОтветственныйСотрудник) + "              МП                    "  +  "V__________________________" + СокрЛП(ФИОПодпись)+ Символы.ПС +
	                    "               (Подпись)               (Фамилия и иницалы)                                                                 Подпись)                   (Фамилия и иницалы)"; 
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = Подписи + Символы.ПС + " ";
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	//ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "Залоговый билет № " + СокрЛП(Ссылка.НомерЗалоговогоБилета) + " от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"); 
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;	
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 18; 
	ТабличныйДокумент.ПолеСверху = 10;
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;
	ТабличныйДокумент.ПолеСнизу = 18;
	
	Возврат ТабличныйДокумент;

КонецФункции	

Функция _ПечатьДопСоглашения(МассивОбъектов, ОбъектыПечати) Экспорт
	Ссылка = МассивОбъектов[0];
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Ссылка.Дата);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", Ссылка.ПредыдущаяОперация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаНачалаРасчета = Выборка.ДатаНачалаРасчета; 
		ДатаВыкупа = Выборка.ДатаВыкупа;
		ДатаВыкупаЛьготныйСрок = Выборка.ДатаВыкупаЛьготныйСрок;
		СуммаЗайма = Выборка.СуммаЗайма;
		СтатусЗБ = Выборка.СтатусЗалоговогоБилета; 
		ПричинаПрименения = Выборка.ПричинаПрименения; 
	Иначе	
		СтруктураРез = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилета(Ссылка.ПолучитьОбъект(), Ссылка.ПредыдущаяОперация);  
		ДатаНачалаРасчета = СтруктураРез.ДатаНачалаРасчета;                                                                  
		ДатаВыкупа = СтруктураРез.ДатаВыкупа; 
		ДатаВыкупаЛьготныйСрок = СтруктураРез.ДатаВыкупаЛьготныйСрок;
		СуммаЗайма = СтруктураРез.СуммаЗайма;  
		СтатусЗБ = СтруктураРез.СтатусЗалоговогоБилета; 
		ПричинаПрименения = СтруктураРез.ПричинаПрименения;  
	КонецЕсли;      
	                   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СостояниеЗалоговогоБилета.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчета,
	               |	ЛБ_СостояниеЗалоговогоБилета.НомерДопСоглашения КАК НомерДопСоглашения
	               |ИЗ
	               |	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета КАК ЛБ_СостояниеЗалоговогоБилета
	               |ГДЕ
	               |	ЛБ_СостояниеЗалоговогоБилета.Регистратор = &ЗалоговыйБилет
	               |	И ЛБ_СостояниеЗалоговогоБилета.ПричинаПрименения = ЗНАЧЕНИЕ(Перечисление.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_СостояниеЗалоговогоБилета.Период УБЫВ";
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаНачалаРасчетаЗБ = Выборка.ДатаНачалаРасчета;  
	Иначе	 
		ДатаНачалаРасчетаЗБ = НачалоДня(Ссылка.ПредыдущаяОперация.Дата); 
	КонецЕсли;      

	

	Запрос = новый Запрос;  
	Запрос.УстановитьПараметр("Дата", Ссылка.Дата);
	Запрос.УстановитьПараметр("Залогодатель", Ссылка.ПредыдущаяОперация.Залогодатель);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ДатаРождения КАК ДатаРождения,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Телефон КАК Телефон,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.АдресПоПрописке КАК АдресПоПрописке,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
	               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Email КАК Email
	               |ИЗ
	               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
	ТаблицаКИ = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ФинансовоеПоложениеСтабильное КАК ФинансовоеПоложениеСтабильное,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ДеловаяРепутацияПоложительная КАК ДеловаяРепутацияПоложительная,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмущества КАК ИсточникПроисхожденияИмущества,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияИмуществаИной КАК ИсточникПроисхожденияИмуществаИной,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредств КАК ИсточникПроисхожденияДенежныхСредств,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ИсточникПроисхожденияДенежныхСредствИной КАК ИсточникПроисхожденияДенежныхСредствИной,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.ХарактерОтношений КАК ХарактерОтношений,
	               |	ЛБ_АнкетаЗалогодателяСрезПоследних.УровеньРиска КАК УровеньРиска
	               |ИЗ
	               |	РегистрСведений.ЛБ_АнкетаЗалогодателя.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_АнкетаЗалогодателяСрезПоследних";  
	ТаблицаАнкета = Запрос.Выполнить().Выгрузить();
	
	//Запрос.УстановитьПараметр("ДокументЗалогодателя", Ссылка.ПредыдущаяОперация.ДокументЗалогодателя);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период КАК Период,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
	               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия
	               |ИЗ
	               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
	               |			&Дата,
	               |			ДокументЗалогодателя.Владелец = &Залогодатель
	               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	ТаблицаДок = Запрос.Выполнить().Выгрузить(); 
	
	ПроцентнаяСтавкаНач = 0;
	ОтборС = Новый Структура;
	ОтборС.Вставить("ДеньНачалаПрименения", 1);  
	ОтборС.Вставить("ПричинаПрименения", Перечисления.ЛБ_ПричиныПримененияПроцентнойСхемы.ВыдачаЗайма);
    СтрокиС = Ссылка.ПредыдущаяОперация.ПроцентныеСтавкиПоПериодам.НайтиСтроки(ОтборС);
	Если НЕ СтрокиС.Количество() = 0 Тогда 
		СтрС = СтрокиС.Получить(0);  
		ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавка;
		Если СтрС.ВидПроцентнойСтавки = Перечисления.ЛБ_ВидыПроцентныхСтавок.Акционная Тогда
			Если НЕ СтрС.ПроцентнаяСтавкаАкция = 0 Тогда
				ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавкаАкция;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияОтносительное = 0 Тогда	 
				ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавка + СтрС.ПроцентнаяСтавка*СтрС.ОтклонениеАкцияОтносительное/100;
			ИначеЕсли НЕ СтрС.ОтклонениеАкцияАбсолютное = 0 Тогда
				ПроцентнаяСтавкаНач = СтрС.ПроцентнаяСтавка + СтрС.ОтклонениеАкцияАбсолютное;
		    КонецЕсли; 
		КонецЕсли;
	КонецЕсли;	

	ОтборТех = Новый Структура;
	ОтборТех.Вставить("ВидПроцентнойСтавки", Перечисления.ЛБ_ВидыПроцентныхСтавок.Техническая);  
	ОтборТех.Вставить("ПричинаПрименения", ПричинаПрименения); 
	СтрокиТех = Ссылка.ПредыдущаяОперация.ПроцентныеСтавкиПоПериодам.НайтиСтроки(ОтборТех);
	Если НЕ СтрокиТех.Количество() = 0 Тогда  
		СтрТех = СтрокиТех.Получить(0);
		ПроцентнаяСтавкаТехн = СтрТех.ПроцентнаяСтавка;
		ДеньНачалаПримененияТехн = СтрТех.ДеньНачалаПрименения;
	Иначе
		ПроцентнаяСтавкаТехн = 0;
		ДеньНачалаПримененияТехн = 1;
	КонецЕсли;	
	
	ЗапросОст = Новый Запрос;
	ЗапросОст.УстановитьПараметр("ЗалоговыйБилет", Ссылка.ПредыдущаяОперация); 
	ЗапросОст.Текст = "ВЫБРАТЬ
	                  |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.ВидРасчета КАК ВидРасчета,
	                  |	СУММА(ЛБ_РасчетыСКлиентамиОстаткиИОбороты.СуммаКонечныйОстаток) КАК Остаток
	                  |ИЗ
	                  |	РегистрНакопления.ЛБ_РасчетыСКлиентами.ОстаткиИОбороты(, &ДатаОст, , , ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РасчетыСКлиентамиОстаткиИОбороты
	                  |
	                  |СГРУППИРОВАТЬ ПО
	                  |	ЛБ_РасчетыСКлиентамиОстаткиИОбороты.ВидРасчета"; 
	
	Запрос.УстановитьПараметр("ЗалоговыйБилет", Ссылка.ПредыдущаяОперация); 
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВложенныйЗапрос.ПроцентыНачислены КАК ПроцентыНачислены,
	               |	ВложенныйЗапрос.ПроцентыОплачены КАК ПроцентыОплачены,
	               |	ВложенныйЗапрос.ОсновнойДолгОплачен КАК ОсновнойДолгОплачен,
	               |	ВложенныйЗапрос.Период КАК Период,
	               |	ВложенныйЗапрос1.ДатаНачалаРасчета КАК ДатаНачалаРасчета
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СУММА(ВЫБОР
	               |				КОГДА ЛБ_РасчетыСКлиентами.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |					ТОГДА ЛБ_РасчетыСКлиентами.Сумма
	               |				ИНАЧЕ 0
	               |			КОНЕЦ) КАК ПроцентыНачислены,
	               |		СУММА(ВЫБОР
