Процедура УдалитьИзделияИзНакладнойНаОтгузку(ЗалоговыйБилет, ЭтоИзъятие = ложь) 
	Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Записывать = Истина;
	Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Записывать = Истина; 
	Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата-1); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет); 	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Организация КАК Организация,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.КоличествоОстаток КАК Количество,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ВесОстаток КАК Вес,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.СуммаОценкиОстаток КАК СуммаОценки
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();   
	Если  ТаблицаЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоИзъятие Тогда 
		УдСтроки = Новый СписокЗначений;
		Для каждого Стр Из ТаблицаЗапроса Цикл 
			Отбор = Новый Структура;
			Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
			Строки = ЭтотОбъект.ТоварыИзъятыеВозвращенные.НайтиСтроки(Отбор); 
			Если Строки.Количество() = 0 Тогда 
				УдСтроки.Добавить(Стр);
			КонецЕсли;	
		КонецЦикла;	                 
		
		Для каждого Эл Из УдСтроки Цикл
			ТаблицаЗапроса.Удалить(Эл.Значение);
		КонецЦикла;	
	КонецЕсли;	
	
	Накладная = ТаблицаЗапроса.Получить(0).НакладнаяНаОтгрузку;
	
	Запрос.УстановитьПараметр("ДатаДок", Дата-1);
	Запрос.УстановитьПараметр("Накладная", Накладная);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&ДатаДок, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних";
	ТаблицаСтатусовВНакладной = Запрос.Выполнить().Выгрузить();		
	
	КолИсключить = 0;
	ВесИсключить = 0;  
	СуммаОценкиИсключить = 0;
    Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл 
		Движение = Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Добавить();
		Движение.Период = Дата;
		Движение.Организация = СтрЗапроса.Организация; 
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Ломбард = СтрЗапроса.Ломбард;
		Движение.НакладнаяНаОтгрузку = СтрЗапроса.НакладнаяНаОтгрузку;
		Движение.ЗалоговыйБилет = СтрЗапроса.ЗалоговыйБилет;
		Движение.ОбъектЗалога = СтрЗапроса.ОбъектЗалога;
		Движение.Количество = СтрЗапроса.Количество; 
		Движение.Вес = СтрЗапроса.Вес; 
		Движение.СуммаОценки = СтрЗапроса.СуммаОценки; 
		
		Движение = Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Добавить();
		Движение.Период = Дата;
		Движение.ЗалоговыйБилет = СтрЗапроса.ЗалоговыйБилет; 
        Движение.НакладнаяНаОтгрузку = СтрЗапроса.НакладнаяНаОтгрузку;
		Движение.ОбъектЗалога = СтрЗапроса.ОбъектЗалога;
		Движение.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной;  
		
		Отбор = Новый Структура;
		Отбор.Вставить("НакладнаяНаОтгрузку", СтрЗапроса.НакладнаяНаОтгрузку); 
		Отбор.Вставить("ЗалоговыйБилет", СтрЗапроса.ЗалоговыйБилет);
        Отбор.Вставить("ОбъектЗалога", СтрЗапроса.ОбъектЗалога);

        Строки = ТаблицаСтатусовВНакладной.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.Получить(0);
			Стр.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной;
		КонецЕсли;	
	КонецЦикла;	  
	
	ВсеИсключенные = Истина; 
	Для каждого СтрС Из ТаблицаСтатусовВНакладной Цикл  
		Если НЕ СтрС.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной Тогда 
			ВсеИсключенные = Ложь;
			Продолжить;
		КонецЕсли;	   
	КонецЦикла;
	
	Если ВсеИсключенные Тогда
		ЗапросН = Новый Запрос; 
		ЗапросН.УстановитьПараметр("Дата", Дата-1); 
		ЗапросН.УстановитьПараметр("НакладнаяНаОтгрузку", Накладная);
		ЗапросН.Текст = "ВЫБРАТЬ
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НомерНакладной КАК НомерНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ДатаНакладной КАК ДатаНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ОтказОтВыкупа КАК ОтказОтВыкупа,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ПовышеннаяОценка КАК ПовышеннаяОценка,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.СтатусНакладной КАК СтатусНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Получатель КАК Получатель,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Инкассатор КАК Инкассатор,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Комментарий КАК Комментарий
		                |ИЗ
		                |	РегистрСведений.ЛБ_СтатусыНакладнойНаОтгрузку.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку) КАК ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних";
	    ВыборкаН = ЗапросН.Выполнить().Выбрать();
		Если ВыборкаН.Следующий() Тогда
			Движение = Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Добавить(); 
			Движение.Период = Дата;
			Движение.НакладнаяНаОтгрузку = ВыборкаН.НакладнаяНаОтгрузку; 
			Движение.НомерНакладной = ВыборкаН.НомерНакладной;
			Движение.ДатаНакладной = ВыборкаН.ДатаНакладной;
			Движение.ОтказОтВыкупа = ВыборкаН.ОтказОтВыкупа;
			Движение.ПовышеннаяОценка = ВыборкаН.ПовышеннаяОценка;
			Движение.СтатусНакладной = ВыборкаН.СтатусНакладной;
			Движение.Комментарий = ВыборкаН.Комментарий; 				
			Движение.ОтветственныйСотрудник = ЭтотОбъект.ОтветственныйСотрудник; 
			Движение.ОтветственныйПользователь = ЭтотОбъект.ОтветственныйПользователь;
			Движение.Пустой = Истина;
		КонецЕсли;		
	КонецЕсли;	
		
КонецПроцедуры	 

Процедура ВосстановитьИзделияВНакладнойНаОтгузку(ОтмененныйДокумент) 
	НаборЗаписей = РегистрыНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ОтмененныйДокумент);
	НаборЗаписей.Прочитать(); 
	
	Если  НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Записывать = Истина;
	Для каждого Запись Из НаборЗаписей Цикл  
		Движение = Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Запись.Организация; 
		Движение.ВидДвижения = Запись.ВидДвижения;
		Движение.Ломбард = Запись.Ломбард;
		Движение.НакладнаяНаОтгрузку = Запись.НакладнаяНаОтгрузку;
		Движение.ЗалоговыйБилет = Запись.ЗалоговыйБилет;
		Движение.ОбъектЗалога = Запись.ОбъектЗалога;
		Движение.Количество = -Запись.Количество; 
		Движение.Вес = -Запись.Вес; 
		Движение.СуммаОценки = -Запись.СуммаОценки;
	КонецЦикла;	  
	
	НаборЗаписей = РегистрыСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ОтмененныйДокумент);
	НаборЗаписей.Прочитать(); 
	
	Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Записывать = Истина;
	Для каждого Запись Из НаборЗаписей Цикл   
		Движение = Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Добавить();
		Движение.Период = Дата;
		Движение.ЗалоговыйБилет = Запись.ЗалоговыйБилет; 
        Движение.НакладнаяНаОтгрузку = Запись.НакладнаяНаОтгрузку;
		Движение.ОбъектЗалога = Запись.ОбъектЗалога;
		Движение.Статус = ЛБ_УправлениеЛомбардом.ПолучитьСтатусОбъектаЗалогаВНакладнойНаОтгрузку(ОтмененныйДокумент.Дата-1, Запись.НакладнаяНаОтгрузку, Запись.ЗалоговыйБилет, Запись.ОбъектЗалога);
	КонецЦикла;	   
	
	НаборЗаписей = РегистрыСведений.ЛБ_СтатусыНакладнойНаОтгрузку.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ОтмененныйДокумент);
	НаборЗаписей.Прочитать(); 
	
	Если НЕ НаборЗаписей.Количество() = 0 Тогда
		Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Записывать = Истина;
		ТаблицаН = НаборЗаписей.Выгрузить();
		Накладная = ТаблицаН.Получить(0).НакладнаяНаОтгрузку;
		
	    ЗапросН = Новый Запрос; 
		ЗапросН.УстановитьПараметр("Дата", ОтмененныйДокумент.Дата-1); 
		ЗапросН.УстановитьПараметр("НакладнаяНаОтгрузку", Накладная);
		ЗапросН.Текст = "ВЫБРАТЬ
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НомерНакладной КАК НомерНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ДатаНакладной КАК ДатаНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ОтказОтВыкупа КАК ОтказОтВыкупа,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ПовышеннаяОценка КАК ПовышеннаяОценка,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.СтатусНакладной КАК СтатусНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Получатель КАК Получатель,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Инкассатор КАК Инкассатор,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Комментарий КАК Комментарий
		                |ИЗ
		                |	РегистрСведений.ЛБ_СтатусыНакладнойНаОтгрузку.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку) КАК ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних";
	    ВыборкаН = ЗапросН.Выполнить().Выбрать();
		Если ВыборкаН.Следующий() Тогда
			Движение = Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Добавить(); 
			Движение.Период = Дата;
			Движение.НакладнаяНаОтгрузку = ВыборкаН.НакладнаяНаОтгрузку; 
			Движение.НомерНакладной = ВыборкаН.НомерНакладной;
			Движение.ДатаНакладной = ВыборкаН.ДатаНакладной;
			Движение.ОтказОтВыкупа = ВыборкаН.ОтказОтВыкупа;
			Движение.ПовышеннаяОценка = ВыборкаН.ПовышеннаяОценка;
			Движение.СтатусНакладной = ВыборкаН.СтатусНакладной;
			Движение.Комментарий = ВыборкаН.Комментарий; 				
			Движение.ОтветственныйСотрудник = ЭтотОбъект.ОтветственныйСотрудник; 
			Движение.ОтветственныйПользователь = ЭтотОбъект.ОтветственныйПользователь;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	 

Функция ФИОКлиента(Клиент, Дата) 
	Если ЗначениеЗаполнено(Клиент) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Клиент", Клиент); 
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
		               |ИЗ
		               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Выборка.Фамилия) + " " + СокрЛП(Выборка.Имя) + ?(НЕ ПустаяСтрока(Выборка.Отчество), " " + СокрЛП(Выборка.Отчество), "");
		КонецЕсли; 
	КонецЕсли;	
	Возврат "";
КонецФункции	

Функция ДокументКлиентаВСтроку(Документ)  
	Если ЗначениеЗаполнено(Документ) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата", Дата);  
		Запрос.УстановитьПараметр("ДокументЗалогодателя", Документ);
		Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
			               |ИЗ
			               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
			               |			&Дата,
			               |			ДокументЗалогодателя = &ДокументЗалогодателя
			               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Информация = "";
			Информация = СокрЛП(Выборка.ВидДокумента);
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументСерия), " " + СокрЛП(Выборка.ДокументСерия), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументНомер), " " + СокрЛП(Выборка.ДокументНомер), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументКемВыдан), " выдан " + СокрЛП(Выборка.ДокументКемВыдан), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументДатаВыдачи), " " + Формат(Выборка.ДокументДатаВыдачи,"ДФ=dd.MM.yyyy"), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументКодПодразделения), " код подр. " + СокрЛП(Выборка.ДокументКодПодразделения), "");
			Возврат Информация;
		КонецЕсли;  
	КонецЕсли;	
	Возврат	"";	
КонецФункции 

