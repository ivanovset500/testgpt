// Процедура - обработчик события "ОбработкаУдаленияПроведения".
//
Процедура ОбработкаУдаленияПроведения(Отказ)
		
	Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов И ЭтотОбъект.БезналичнаяОплата Тогда
		Сообщить("Снятие операции безналичной оплаты с проведения запрещено.");  
		Отказ = Истина;
		Возврат;   
	ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты И ЭтотОбъект.ОтмененныйДокумент.БезналичнаяОплата Тогда
		Сообщить("Снятие операции отмены безналичной оплаты с проведения запрещено.");  
		Отказ = Истина;
		Возврат;	
	КонецЕсли;
		
	ЗапросП = Новый Запрос;
	ЗапросП.УстановитьПараметр("Дата", ЭтотОбъект.Дата); 
	ЗапросП.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
		ЗапросП.УстановитьПараметр("ЗБ", Ссылка); 
		НомерЗБ = ЭтотОбъект.НомерЗалоговогоБилета; 
	Иначе	 
		ЗапросП.УстановитьПараметр("ЗБ", ЭтотОбъект.ПредыдущаяОперация);
		НомерЗБ = ЭтотОбъект.ПредыдущаяОперация.НомерЗалоговогоБилета; 
	КонецЕсли;	
	ЗапросП.Текст = "ВЫБРАТЬ
	                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор
	                |ИЗ
	                |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(&Дата, , Регистратор, ЗалоговыйБилет = &ЗБ) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
	                |ГДЕ
	                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор <> &Регистратор";
	ВыборкаП = ЗапросП.Выполнить().Выбрать();
	Если ВыборкаП.Следующий() тогда 
		Сообщить("По залоговому билету " + СокрЛП(НомерЗБ) + " есть более поздние операции. Снятие документа с проведения запрещено.");  
		Отказ = Истина;
		Возврат;
	КонецЕсли;                                        
		
КонецПроцедуры // ОбработкаУдаленияПроведения()

мСуммаПроцентовДень = 0;
мСуммаПроцентовСрок = 0;  
КассоваяСмена = Документы.ЛБ_ОперацииКассовойСмены.ПустаяСсылка();
