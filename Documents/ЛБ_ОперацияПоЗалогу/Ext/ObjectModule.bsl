// ОБРАБОТЧИКИ СОБЫТИЙ

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения) 
	//Если ЭтотОбъект.БезналичнаяОплата ИЛИ ЭтотОбъект.ОтмененныйДокумент.БезналичнаяОплата Тогда
	//	ДатаПереводаВИтоговыйСтатусБН = Дата(1,1,1);
	//	Запрос = Новый Запрос;
	//	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	//	Запрос.Текст = "ВЫБРАТЬ
	//	               |	ЛБ_РеестрБезначныхПлатежей.ДатаПеревода КАК ДатаПеревода
	//	               |ИЗ
	//	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей КАК ЛБ_РеестрБезначныхПлатежей
	//	               |ГДЕ
	//	               |	ЛБ_РеестрБезначныхПлатежей.Регистратор = &Регистратор";
	//	Выборка = Запрос.Выполнить().Выбрать();
	//	Если Выборка.Следующий() Тогда  
	//		ДатаПереводаВИтоговыйСтатусБН = Выборка.ДатаПеревода;
	//	КонецЕсли;	
	//КонецЕсли;	
    СкладЛомбарда = ЛБ_Общиймодуль.ПолучитьСклад(ЭтотОбъект.Ломбард, Перечисления.ЛБ_ВидыСкладов.Залоги); 
	Если НЕ ЗначениеЗаполнено(СкладЛомбарда) Тогда
		СкладЛомбарда = ЛБ_Общиймодуль.ПолучитьСклад(ЭтотОбъект.ПредыдущаяОперация.Ломбард, Перечисления.ЛБ_ВидыСкладов.Залоги);
	КонецЕсли;
	Если ПометкаУдаления Тогда
		ЗапросП = Новый Запрос;
		ЗапросП.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
		ЗапросП.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
			ЗапросП.УстановитьПараметр("ЗБ", Ссылка); 
			НомерЗБ = ЭтотОбъект.НомерЗалоговогоБилета; 
		Иначе	 
			ЗапросП.УстановитьПараметр("ЗБ", ЭтотОбъект.ПредыдущаяОперация);
			НомерЗБ = ЭтотОбъект.ПредыдущаяОперация.НомерЗалоговогоБилета; 
		КонецЕсли;	
		ЗапросП.Текст = "ВЫБРАТЬ
		                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор КАК Регистратор
		                |ИЗ
		                |	РегистрНакопления.ЛБ_ОборотыПоОперациямЗайма.Обороты(&Дата, , Регистратор, ЗалоговыйБилет = &ЗБ) КАК ЛБ_ОборотыПоОперациямЗаймаОбороты
		                |ГДЕ
		                |	ЛБ_ОборотыПоОперациямЗаймаОбороты.Регистратор <> &Регистратор";
		ВыборкаП = ЗапросП.Выполнить().Выбрать();
		Если ВыборкаП.Следующий() тогда 
			Сообщить("По залоговому билету " + СокрЛП(НомерЗБ) + " есть более поздние операции. Документ нельзя пометить на удаление.");  
			Отказ = Истина;
			Возврат;
		КонецЕсли;    
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	    Если ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ВыдачаЗалога Тогда	
			Запрос = новый Запрос;   
			Запрос.УстановитьПараметр("ЗалоговыйБилет", ЭтотОбъект.ПредыдущаяОперация);
			Запрос.УстановитьПараметр("Ломбард", ЭтотОбъект.Ломбард);
		    Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
			Запрос.УстановитьПараметр("Склад", СкладЛомбарда);
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
			               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
			               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество,
			               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток) КАК СуммаОценки
			               |ИЗ
			               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
			               |			&Дата,
			               |			ЗалоговыйБилет = &ЗалоговыйБилет
			               |				И Склад = &Склад) КАК ЛБ_ОбъектыЗалогаОстатки
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
			               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
		    ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
			
			ЕстьНеВыкупленные = ложь;
		   	Для каждого Стр Из ЭтотОбъект.ТоварыВыкупленные цикл   
				Отбор = Новый структура;
				Отбор.Вставить("Ломбард", ЭтотОбъект.Ломбард); 
				Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога); 
				
				Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
				Если Строки.Количество() = 0 Тогда
					ЕстьНеВыкупленные = Истина;
					ОбщегоНазначения.СообщитьПользователю("Объект залога " + СокрЛП(Стр.ОбъектЗалога) + " в ломбарде " + СокрЛП(ЭтотОбъект.Ломбард) + " не найден. Выдача невозможна!"); 
				КонецЕсли;
			КонецЦикла;	
            Если ЕстьНеВыкупленные тогда
				Отказ = Истина;
			КонецЕсли;
			
		ИначеЕсли ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога Тогда
	        Запрос = новый Запрос;   
			Запрос.УстановитьПараметр("ЗалоговыйБилет", ЭтотОбъект.ПредыдущаяОперация);
			Запрос.УстановитьПараметр("Ломбард", ЭтотОбъект.Ломбард);
		    Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);	
			Запрос.УстановитьПараметр("Склад", СкладЛомбарда); 
			ОтборСклад = "";
			Если  НЕ ЭтотОбъект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда 
				ОтборСклад = " И Склад = &Склад";
			КонецЕсли;	
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога КАК ОбъектЗалога,
			               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард КАК Ломбард,
			               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток) КАК Количество,
			               |	СУММА(ЛБ_ОбъектыЗалогаОстатки.СуммаОценкиОстаток) КАК СуммаОценки
			               |ИЗ
			               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(
			               |			&Дата,
			               |			ЗалоговыйБилет = &ЗалоговыйБилет";
			Запрос.Текст = Запрос.Текст + ОтборСклад + ") КАК ЛБ_ОбъектыЗалогаОстатки
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога,
			               |	ЛБ_ОбъектыЗалогаОстатки.Ломбард";
		    ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
			
			ЕстьОшибки = Ложь;
			Для каждого Стр Из ЭтотОбъект.ТоварыИзъятыеВозвращенные цикл  
				Отбор = Новый структура;
				Отбор.Вставить("Ломбард", ЭтотОбъект.Ломбард); 
				Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога); 
				
				Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
				Если Строки.Количество() = 0 Тогда
					ОбщегоНазначения.СообщитьПользователю("Объект залога " + СокрЛП(Стр.ОбъектЗалога) + " в ломбарде " + СокрЛП(ЭтотОбъект.Ломбард) + " не найден. Изъятие невозможно!"); 
					ЕстьОшибки = Истина;
				КонецЕсли;;
			КонецЦикла;                 
			Если ЕстьОшибки тогда
				Отказ = Истина;
			КонецЕсли;	
		КонецЕсли;	
		
		Если НЕ Отказ Тогда   
			Если ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог ИЛИ 
				 ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаЗалога ИЛИ  
				 ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление ИЛИ 
				 ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаПереоформления ИЛИ  
				 ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОплатаПроцентов ИЛИ 
				 ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ОтменаОплаты Тогда 
				РезультатКС = ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(Дата, Организация, Ломбард); 
				Если НЕ РезультатКС = неопределено Тогда 
				    КассоваяСмена = РезультатКС.КассоваяСмена;
					СводныйПКО = РезультатКС.ПКОСводный;  
					СводныйРКО = РезультатКС.РКОСводный;
				КонецЕсли;	  
   			КонецЕсли;	 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры // ПередЗаписью()

