Процедура ЗакрытьДоверенностиПоЗалоговомуБилету(Клиент, ЗалоговыйБилет) 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.УстановитьПараметр("Клиент", Клиент); 	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
	               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности,
	               |	ЛБ_ДоверенностиСрезПоследних.ВидОперации КАК ВидОперации,
	               |	ЛБ_ДоверенностиСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ДоверенностиСрезПоследних.Ответственный КАК Ответственный
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
	               |			&Дата,
	               |			ЗалоговыйБилет = &ЗалоговыйБилет
	               |				И Клиент = &Клиент) КАК ЛБ_ДоверенностиСрезПоследних";  
	Выборка = Запрос.Выполнить().Выбрать(); 
	Пока Выборка.Следующий() Цикл   
		Если НЕ Выборка.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДоверенностьОформлена Тогда
			Продолжить; 
		ИначеЕсли НЕ (Выборка.Доверенность.СрокДействияДоверенности = Дата(1,1,1)) И (Выборка.Доверенность.СрокДействияДоверенности < ЭтотОбъект.Дата) Тогда
			Продолжить;	
		КонецЕсли;	
		
		Движения.ЛБ_Доверенности.Записывать = Истина;
		Движение = Движения.ЛБ_Доверенности.Добавить();
        Движение.Период = Дата; 
		Движение.Доверенность = Выборка.Доверенность;
		Движение.Клиент = Клиент;
		Движение.ЗалоговыйБилет = ЗалоговыйБилет;  
		Движение.ВидОперации = Выборка.ВидОперации; 
		Движение.Ломбард = Выборка.Ломбард;
        Движение.Ответственный = Выборка.Ответственный;				
		Движение.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.ДействиеПрекращеноЗаймВыкуплен; 
	КонецЦикла;	
КонецПроцедуры

