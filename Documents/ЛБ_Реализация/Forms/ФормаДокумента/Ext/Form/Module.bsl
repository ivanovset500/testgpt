&НаСервере
Функция ПолучитьНовыйНомерРеализации()   
	СтруктураВозврата = Новый Структура;  
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	    НомерРеализации = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерРеализации(Объект.Дата, Объект.Организация, Объект.Ломбард, Объект.Ссылка); 
	Иначе   
		НомерРеализации = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерРеализации(Объект.Дата, Объект.Организация, Объект.Ломбард);
	КонецЕсли;	
	СтруктураВозврата.Вставить("НомерРеализации", НомерРеализации);	
	Если Объект.Ломбард = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис") Тогда
		ПредставлениеНомера = СокрЛП(НомерРеализации);
	Иначе	
        ПредставлениеНомера = СокрЛП(Объект.Ломбард.НомерЛомбарда) + "/" +  СокрЛП(НомерРеализации);  
	КонецЕсли;	  
	СтруктураВозврата.Вставить("ПредставлениеНомера", ПредставлениеНомера);
    Возврат СтруктураВозврата;
КонецФункции	

&НаСервере
Функция ПроверкаОстатков() 
	ЕстьОшибки = Ложь;
	ТаблицаОстатков = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбарда(Объект.Дата, Объект.Организация, Объект.Ломбард, Объект.Склад);   
		
	Для каждого Стр Из ТаблицаТоваров Цикл  
		Отбор = новый структура;
		Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
		СтрокиОст = ТаблицаОстатков.НайтиСтроки(Отбор);
		Если СтрокиОст.Количество() = 0 Тогда 
			Сообщить("Изделие с артикулом " + СокрЛП(Стр.Артикул) + " не найдено на складе " + СокрЛП(Объект.Склад));  
			ЕстьОшибки = Истина;  
		Иначе
			Стр.СуммаОценки = СтрокиОст.Получить(0).СуммаОценки;
		Конецесли;    
	Конеццикла;  
		
	Возврат ?(ЕстьОшибки, Ложь, Истина);
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 
	ТекущийОбъект.СуммаПродажи = ТекущийОбъект.Товары.Итог("ФактическаяЦена");    
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
		Если НЕ НачалоДня(ТекущийОбъект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Если НЕ ЭтоСуперпользователь Тогда 
				 Сообщить("Пользователь имеет право проводить документ только текущей датой. Измените дату документа.", статуссообщения.Важное);
			     Отказ = Истина;
				 Возврат;
			КонецЕсли;	
			Если ТекущийОбъект.СпособОплаты = Перечисления.ЛБ_СпособыОплаты.НаличныйРасчет Тогда
				Результат = ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(ТекущийОбъект.Дата, ТекущийОбъект.Организация, ТекущийОбъект.Ломбард); 
				Если Результат = неопределено Тогда  
					Сообщить("На дату документа не открыта кассовая смена в ломбарде!", статуссообщения.Важное);
			        Отказ = Истина; 
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли;	
		ПредельнаяСумма = ЛБ_УправлениеЛомбардом.ПолучитьПредельнуюСуммуДляИдентификацииКлиента(ТекущийОбъект.Дата, ТекущийОбъект.СпособОплаты); 
		Если ТаблицаТоваров.Итог("ФактическаяЦена") > ПредельнаяСумма Тогда
			Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Контрагент) тогда 
				Сообщить("Сумма продажи превышает предельное значение " + СокрЛП(Формат(ПредельнаяСумма, "ЧЦ=15; ЧДЦ=2")) + " руб., выбор контрагента обязателен.", статуссообщения.Важное);
		        Отказ = Истина; 
			КонецЕсли;	
		КонецЕсли;  
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)	
	Если ЗначениеЗаполнено(Объект.Ломбард) И (Объект.НомерРеализации = 0) Тогда
		Результат = ПолучитьНовыйНомерРеализации();
		Объект.НомерРеализации = Результат.НомерРеализации;
		Объект.ПредставлениеНомера = Результат.ПредставлениеНомера;
	КонецЕсли; 
	ЗаполнитьТаблицуДокумента();
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Если ТаблицаТоваров.Количество() = 0 Тогда
			Сообщить("Не выбраны изделия для реализации.", статуссообщения.Важное);
			Отказ = Истина; 
		Иначе
			Для каждого Стр Из ТаблицаТоваров Цикл
				Если Стр.ФактическаяЦена = 0 Тогда 
					Сообщить("Для изделия " + СокрЛП(Стр.Артикул) + " не установлена фактическая цена.", статуссообщения.Важное);
			        Отказ = Истина; 
					Прервать;
				КонецЕсли;	
			КонецЦикла;	 
		КонецЕсли;      
		Если НЕ Отказ Тогда
			Если НЕ ПроверкаОстатков() Тогда  
				Отказ = Истина; 
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи) 
	Для каждого Стр Из Объект.Товары Цикл
	    ЗаполнитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
	КонецЦикла;	
	УстановитьСостояниеДокумента(); 
	ЭтаФорма.Заголовок = "Реализация невостребованных залогов № " + СокрЛП(Объект.ПредставлениеНомера) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
КонецПроцедуры  

&НаСервере
Процедура ОчиститьУдаленныеЗалоги()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументРеализации", Объект.Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.ОбъектЗалога КАК ОбъектЗалога
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОбъектыЗалогаДобавленныеВРеализацию КАК ЛБ_ОбъектыЗалогаДобавленныеВРеализацию
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.ДокументРеализации = &ДокументРеализации";   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Отбор = Новый Структура;
		Отбор.Вставить("ЗалоговыйБилет", Выборка.ЗалоговыйБилет); 
		Отбор.Вставить("ОбъектЗалога", Выборка.ОбъектЗалога);  
		
		Строки  = Объект.Товары.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			УдалитьОбъектыЗалогаДобавленныеВРеализацию(Выборка.ЗалоговыйБилет, Выборка.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) 
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) тогда
		Для каждого Стр Из Объект.Товары Цикл		
		    УдалитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
		КонецЦикла;	 
	Иначе
		ОчиститьУдаленныеЗалоги();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтоги()
	ИтогКоличество = ТаблицаТоваров.Итог("Количество");
	ИтогВес = ТаблицаТоваров.Итог("ВесИзделия"); 
	ИтогВесМеталла = ТаблицаТоваров.Итог("ВесМеталла");
    ИтогСуммаОценки = ТаблицаТоваров.Итог("СуммаОценки");
	ИтогСуммаОценкиМакс = ТаблицаТоваров.Итог("СуммаОценкиМакс"); 
	ИтогСуммаОценкиМеталлы = ТаблицаТоваров.Итог("СуммаОценкиМеталлы");
	ИтогСуммаОценкиВставки = ТаблицаТоваров.Итог("СуммаОценкиВставки");
	ИтогСуммаСсуды = ТаблицаТоваров.Итог("СуммаСсуды"); 
	ИтогУчетнаяЦена = ТаблицаТоваров.Итог("УчетнаяЦена");
	ИтогФактическаяЦена = ТаблицаТоваров.Итог("ФактическаяЦена");
КонецПроцедуры	  

&НаСервере
Процедура ЗаполнитьТаблицуТоваров(Добавление = Ложь)  
	Запрос = Новый Запрос;  
	СписокОЗ = Новый СписокЗначений;
	СписокЗБ = Новый СписокЗначений;
	Для каждого Стр Из Объект.Товары Цикл 
		Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда 
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;	
		Если СписокОЗ.НайтиПоЗначению(Стр.ОбъектЗалога) = неопределено Тогда 
			СписокОЗ.Добавить(Стр.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	       
    Если Объект.Проведен Тогда
	    Запрос.УстановитьПараметр("Дата", Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	Иначе 
		Запрос.УстановитьПараметр("Дата", Объект.Дата);
	КонецЕсли;	 
	Запрос.УстановитьПараметр("ЗалоговыеБилеты", СписокЗБ); 
	Запрос.УстановитьПараметр("ОбъектыЗалога", СписокОЗ);  
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни КАК СуммаОценкиВставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды КАК СуммаСсуды,
	               |	1 КАК Количество,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа,
	               |	ЕСТЬNULL(ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Цена, 0) КАК УчетнаяЦена,
	               |	ЕСТЬNULL(ЛБ_ЦеныОбъектовЗалогаСрезПоследних.Цена, 0) КАК ФактическаяЦена,
	               |	ЗНАЧЕНИЕ(Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное) КАК ОтклонениеСкидки
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	               |			&Дата,
	               |			ОбъектЗалога В (&ОбъектыЗалога)
	               |				И ЗалоговыйБилет В (&ЗалоговыеБилеты)) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ЦеныОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ЦеныОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ЦеныОбъектовЗалогаСрезПоследних.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаТоваров.Загрузить(ТаблицаЗапроса); 
	Если НЕ Добавление Тогда
		Для каждого Стр Из Объект.Товары Цикл
			Отбор = Новый структура;
			Отбор.Вставить("ЗалоговыйБилет", стр.ЗалоговыйБилет); 
			Отбор.Вставить("ОбъектЗалога", стр.ОбъектЗалога);   
			
			СтрокиТ = ТаблицаТоваров.НайтиСтроки(Отбор);
			Если НЕ СтрокиТ.Количество() = 0 Тогда 
				СтрТ = СтрокиТ.Получить(0); 
				СтрТ.ФактическаяЦена = Стр.ФактическаяЦена; 
				Если ЗначениеЗаполнено(Стр.ОтклонениеСкидки) Тогда 
				   СтрТ.ОтклонениеСкидки = Стр.ОтклонениеСкидки;
				КонецЕсли;   
				СтрТ.Скидка = Стр.Скидка;
			КонецЕсли;	
		Конеццикла;	  
	КонецЕсли;	
	ЗаполнитьИтоги();
КонецПроцедуры	

&НаСервере
Функция ПолучитьЗаемщика(ЗБ) 
	Возврат ЗБ.Залогодатель;
КонецФункции

&НаКлиенте
Процедура ИсторияЗБ(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрока.ЗалоговыйБилет) Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", ПолучитьЗаемщика(ТекСтрока.ЗалоговыйБилет));
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);   
	КонецЕсли;	 
КонецПроцедуры


&НаКлиенте
Процедура Расчеты(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрока.ЗалоговыйБилет) Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", ПолучитьЗаемщика(ТекСтрока.ЗалоговыйБилет));
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);		
		ПараметрыФормы.Вставить("Дата", Объект.Дата);	 
		ПараметрыФормы.Вставить("Детально", Истина);
					
        ОткрытьФорму("Отчет.ЛБ_НачисленныеПроцентыПоДоговоруЗайма.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыЗалогаДобавленныеВРеализацию(ЗалоговыйБилет, ОбъектЗалога) 
	Запись = РегистрыСведений.ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.СоздатьМенеджерЗаписи();
	Запись.ОбъектЗалога = ОбъектЗалога;
	Запись.ЗалоговыйБилет = ЗалоговыйБилет;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда 
		Если НЕ ЗначениеЗаполнено(Запись.ДокументРеализации) Тогда
			Запись.ДокументРеализации = Объект.Ссылка;
			Запись.Записать(); 
		КонецЕсли;	
	Иначе	
		Запись.ЗалоговыйБилет = ЗалоговыйБилет;
		Запись.ОбъектЗалога = ОбъектЗалога;
		Запись.ДокументРеализации = Объект.Ссылка;
	    Запись.Ответственный = Объект.ОтветственныйСотрудник;
		Запись.Записать();   
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Процедура УдалитьОбъектыЗалогаДобавленныеВРеализацию(ЗалоговыйБилет, ОбъектЗалога)
	НаборЗаписей = РегистрыСведений.ЛБ_ОбъектыЗалогаДобавленныеВРеализацию.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.ЗалоговыйБилет.Установить(ЗалоговыйБилет); 
	НаборЗаписей.Отбор.ОбъектЗалога.Установить(ОбъектЗалога);
    НаборЗаписей.Записать(); 
КонецПроцедуры

&НаСервере
Процедура ПолучитьТоварыПоОстаткам()  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбарда(Объект.Дата, Объект.Организация, Объект.Ломбард, Объект.Склад);
	УдСтроки = Новый СписокЗначений;
	Для каждого СтрЗ Из ТаблицаЗапроса Цикл   
		 РезультатПроверки = ЛБ_УправлениеЛомбардом.ПроверитьОбъектЗалогаДобавленВРеализацию(СтрЗ.ЗалоговыйБилет, СтрЗ.ОбъектЗалога); 
		 Если НЕ РезультатПроверки = неопределено Тогда 
			 УдСтроки.Добавить(СтрЗ);    
			 Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Объект.Дата, СтрЗ.ЗалоговыйБилет, СтрЗ.ОбъектЗалога);
			 Если ЗначениеЗаполнено(РезультатПроверки.Регистратор) Тогда
			     ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ» № " + СокрЛП(РезультатПроверки.Регистратор.ПредставлениеНомера) + " от " + Формат(РезультатПроверки.Регистратор.Дата, "ДЛФ=");
			 Иначе 
			     ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ», ответственный " + СокрЛП(РезультатПроверки.Ответственный);
			 КонецЕсли;	 
			 ТекстСообщения = ТекстСообщения + ". Добавление в текущий документ невозможно.";
			 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		 КонецЕсли;	 
		 Если ЛБ_УправлениеЛомбардом.ПроверитьЗалоговыйБилетСогласованКОплате(Объект.Дата, СтрЗ.ЗалоговыйБилет) Тогда
		  	 УдСтроки.Добавить(СтрЗ); 
			 Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Объект.Дата, СтрЗ.ЗалоговыйБилет, СтрЗ.ОбъектЗалога);
			 ТекстСообщения = "Внимание! Залоговый билет № " + СокрЛП(СтрЗ.ЗалоговыйБилет.НомерЗалоговогоБилета) + " согласован к оплате, невостребованный залог с артикулом " + СокрЛП(Артикул) + " добавить в текущий документ невозможно.";
			 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		 КонецЕсли;	  
		 Если ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(Объект.Дата, СтрЗ.ЗалоговыйБилет) = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ГотовКОтправкеОХ Тогда  
			 УдСтроки.Добавить(СтрЗ);
			 Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Объект.Дата, СтрЗ.ЗалоговыйБилет, СтрЗ.ОбъектЗалога);
			 ТекстСообщения = "Внимание! Залоговый билет № " + СокрЛП(СтрЗ.ЗалоговыйБилет.НомерЗалоговогоБилета) + " выкуплен заемщиком, залог с артикулом " + СокрЛП(Артикул) + " добавить в текущий документ невозможно.";
			 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);      
		 КонецЕсли;	
	КонецЦикла;	 
	Для каждого Эл из УдСтроки Цикл 
		ТаблицаЗапроса.Удалить(Эл.Значение);
	КонецЦикла;	
	Объект.Товары.Загрузить(ТаблицаЗапроса); 
	Объект.Товары.Сортировать("ЗалоговыйБилет");
КонецПроцедуры	
	 
&НаКлиенте
Процедура Заполнить(Команда) 
	Если НЕ ЗначениеЗаполнено(Объект.Ломбард) Тогда  
		Сообщить("Выберите подразделение.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Склад) Тогда  
		Сообщить("Выберите склад.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;
	СписокТоваровДобавленоВРеализацию.Очистить();
	ПолучитьТоварыПоОстаткам();
	Для каждого Стр Из Объект.Товары Цикл
		ЗаполнитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
	Конеццикла;	   
	ЗаполнитьТаблицуТоваров(Истина); 
	УстановитьДоступностьКонтрагента();
КонецПроцедуры 

