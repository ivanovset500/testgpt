&НаСервере
Процедура ВыборСкладаНаСервере() 
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард Тогда
	     Объект.Склад = ЛБ_ОбщийМодуль.ПолучитьСклад(Объект.Ломбард, Перечисления.ЛБ_ВидыСкладов.Витрина);  
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница Тогда
	     Объект.Склад = ЛБ_ОбщийМодуль.ПолучитьСклад(Объект.Ломбард, Перечисления.ЛБ_ВидыСкладов.ВитринаЦО);  
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт Тогда
	     Объект.Склад = ЛБ_ОбщийМодуль.ПолучитьСклад(Объект.Ломбард, Перечисления.ЛБ_ВидыСкладов.ОбщийСкладЦО); 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент) 
	ВыборСкладаНаСервере();   
	Для каждого Стр Из ТаблицаТоваров Цикл
	    УдалитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога); 
	КонецЦикла;	
	ТаблицаТоваров.Очистить();   
	ЗаполнитьИтоги();
	УстановитьДоступностьКонтрагента();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоАртикулу(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ломбард) Тогда  
		Сообщить("Выберите подразделение.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Склад) Тогда  
		Сообщить("Выберите склад.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;	

	Артикул = "";
	Если ВвестиЗначение(Артикул, "Введите артикул") Тогда
	    СтрокаСообщение = ПолучитьТоварыПоОстаткамАртикул(Артикул);
		Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
			Предупреждение(СтрокаСообщение, 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоНомеруЗБ(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ломбард) Тогда  
		Сообщить("Выберите подразделение.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Склад) Тогда  
		Сообщить("Выберите склад.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;	

	НомерЗБ = "";
	Если ВвестиЗначение(НомерЗБ, "Введите номер ЗБ") Тогда
	    СтрокаСообщение = ПолучитьТоварыПоОстаткамНомерЗБ(НомерЗБ);
		Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
			Предупреждение(СтрокаСообщение, 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

