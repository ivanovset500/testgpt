
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;   
	Если УправлениеДоступом.ЕстьРоль("ЛБ_Суперпользователь") Тогда 
		ЭтоСуперпользователь = Истина;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда		
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
		Объект.Дата = ТекущаяДатаСеанса(); 
		Объект.ОтветственныйПользователь = ТекПользователь;	
		Объект.ОтветственныйСотрудник    = ПараметрыСеанса.ТекущийСотрудник;
			
		Если ЭтоСуперпользователь Тогда   
			Объект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;  
			Объект.Склад = ЛБ_ОбщийМодуль.ПолучитьСклад(Объект.Ломбард, Перечисления.ЛБ_ВидыСкладов.ВитринаЦО);
			Объект.СпособОплаты = Перечисления.ЛБ_СпособыОплаты.НаличныйРасчет;
			Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница; 
		ИначеЕсли ТекПользователь.ЭтоЛомбард Тогда  
			Объект.Ломбард = ПараметрыСеанса.ТекущийЛомбард;
			Объект.Склад = ЛБ_ОбщийМодуль.ПолучитьСклад(Объект.Ломбард, Перечисления.ЛБ_ВидыСкладов.Витрина);
			Объект.СпособОплаты = Перечисления.ЛБ_СпособыОплаты.НаличныйРасчет;
			Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард;
			Объект.Контрагент = ПредопределенноеЗначение("Справочник._ДемоКонтрагенты.РозничныйПокупатель");
		ИначеЕсли УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
			Объект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;  
			Объект.Склад = ЛБ_ОбщийМодуль.ПолучитьСклад(Объект.Ломбард, Перечисления.ЛБ_ВидыСкладов.ВитринаЦО);
			Объект.СпособОплаты = Перечисления.ЛБ_СпособыОплаты.НаличныйРасчет;
			Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница; 
			Объект.Контрагент = ПредопределенноеЗначение("Справочник._ДемоКонтрагенты.РозничныйПокупатель");
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Документ «Реализация невостребованных залогов» доступен только сотрудникам ЦО и сотрудникам ломбарда.");
			Отказ = Истина;  
		КонецЕсли;
		ЭтаФорма.Заголовок = "Реализация невостребованных залогов (создание)"; 
	Иначе
		ЭтаФорма.Заголовок = "Реализация невостребованных залогов № " + СокрЛП(Объект.ПредставлениеНомера) + " от " + Формат(Объект.Дата, "ДЛФ=DT"); 
	КонецЕсли;     
	Если ТекПользователь.ЭтоЛомбард Тогда		
		ЭтоЛомбард = Истина;
	КонецЕсли;	
	УстановитьСостояниеДокумента(); 
	УстановитьВидимость(); 
	УстановитьВыборОперации();
	ЗаполнитьТаблицуТоваров();  
	УстановитьДоступностьКонтрагента();
	
	Если НЕ ЭтоСуперпользователь Тогда
		//+МАН 12.12.25 Изменил условие
		//Если НЕ НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда  
		Если Объект.Проведен Тогда
			ЭтаФорма.ТолькоПросмотр = Истина;  
			Элементы.ТаблицаТоваров.ТолькоПросмотр = Истина;
			Элементы.ТаблицаТоваровДобавить.Доступность = Ложь; 
			Элементы.ТаблицаТоваровГруппаСкидки.Доступность = Ложь;
			//+МАН 26.11.25 Добавил
			Элементы.ТаблицаТоваровВыбратьДляРеализацииОпт.Доступность = Ложь;
			Элементы.ТаблицаТоваровДобавитьИзделие.Доступность = Ложь;
			//-МАН
		КонецЕсли;	
	КонецЕсли;
				
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	//ПоказатьСкрытьПечать();  
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьСкрытьПечать()   
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт тогда
		Элементы.ПодменюПечать.Видимость = Истина; 	
	иначе
		Элементы.ПодменюПечать.Видимость = Ложь;   
	КонецЕсли;	
КонецПроцедуры
 

&НаСервере
Процедура УстановитьВыборОперации()   
	Если ЭтоСуперпользователь Тогда 
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт);
	Иначе	
		Если ЭтоЛомбард Тогда 
			Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард);
		Иначе 
			Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница);
			Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт);
			//+МАН 09.12.25 У сотрудника ЦО не отображается вид операции когда открывается проведенный документ.
			Если Объект.Проведен Тогда
				Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард);
			КонецЕсли;
			//-МАН
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()  
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт Тогда
		Элементы.Основание.Видимость = Истина;          
		Объект.СпособОплаты = Перечисления.ЛБ_СпособыОплаты.РасчетныйСчет;
		Элементы.ВыборСпособаОплаты.ТолькоПросмотр = Истина;  
		Элементы.ТаблицаТоваровВыбратьДляРеализацииОпт.Видимость = Истина;  
		Элементы.ТаблицаТоваровДобавитьИзделие.Видимость = Истина;
		Элементы.ТаблицаТоваровДобавить.Видимость = Ложь; 
		Элементы.ТаблицаТоваровГруппаСкидки.Доступность = Ложь;
	Иначе                                    
		Элементы.ВыборСпособаОплаты.ТолькоПросмотр = Ложь;
		Элементы.Основание.Видимость = Ложь;
		Элементы.ТаблицаТоваровВыбратьДляРеализацииОпт.Видимость = Ложь;  
		Элементы.ТаблицаТоваровДобавитьИзделие.Видимость = Ложь;
		Элементы.ТаблицаТоваровДобавить.Видимость = Истина;   
		Элементы.ТаблицаТоваровГруппаСкидки.Доступность = Истина; 	
	КонецЕсли;	
	Контрагет = неопределено;              
	Если ЭтоСуперпользователь И Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард Тогда
	    Элементы.Ломбард.ТолькоПросмотр = Ложь; 
	КонецЕсли;	
КонецПроцедуры	 

&НаСервере
Процедура УстановитьДоступностьКонтрагента()  
	ПредельнаяСумма = ЛБ_УправлениеЛомбардом.ПолучитьПредельнуюСуммуДляИдентификацииКлиента(Объект.Дата, Объект.СпособОплаты); 
	Если ТаблицаТоваров.Итог("ФактическаяЦена") > ПредельнаяСумма Тогда
		Элементы.Контрагент.ТолькоПросмотр = Ложь;
	Иначе  
		Элементы.Контрагент.ТолькоПросмотр = Истина;
		Если ЗначениеЗаполнено(Объект.Контрагент) Тогда  
			Объект.Контрагент = неопределено;
		КонецЕсли;	
	КонецЕсли;	    
КонецПроцедуры	 

