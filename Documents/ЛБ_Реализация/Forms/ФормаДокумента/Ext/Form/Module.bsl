	КонецЕсли;	

	СтрокаСообщение = ПолучитьТоварыПоОстаткамДопМеталлы();
	Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
		Предупреждение(СтрокаСообщение, 60);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьТоварыПоОстаткамГруппа(Группа)  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбардаПоГруппе(Объект.Дата, Объект.Организация, Объект.Ломбард, Объект.Склад, Группа);
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
	    ДобавитьВТаблицуТоваров(ТаблицаЗапроса); 
		Возврат "";
	Иначе          
		Возврат "Изделия с группой " + сокрЛП(Группа) + " на складе не найдены.";
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоГруппе(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ломбард) Тогда  
		Сообщить("Выберите подразделение.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Склад) Тогда  
		Сообщить("Выберите склад.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;	

	Группа = ПредопределенноеЗначение("Справочник.ЛБ_ГруппыОбъектовЗалога.ПустаяСсылка");
	Если ВвестиЗначение(Группа, "Введите группу") Тогда
	    СтрокаСообщение = ПолучитьТоварыПоОстаткамГруппа(Группа);
		Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
			Предупреждение(СтрокаСообщение, 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСкидку()    
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард Тогда 
	    Возврат ЛБ_УправлениеЛомбардом.ПолучитьСкидку(Объект.Дата, Перечисления.ЛБ_СкидкаВДокументах.РеализацияЛомбард, Объект.Ломбард);
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница Тогда 
	    Возврат ЛБ_УправлениеЛомбардом.ПолучитьСкидку(Объект.Дата, Перечисления.ЛБ_СкидкаВДокументах.РеализацияРозница, Объект.Ломбард);
	Иначе
		Возврат неопределено;
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура СкидкаУстановить(Команда)
	РезультатС = ПолучитьСкидку(); 
	Если РезультатС = неопределено Тогда  
		Предупреждение("Для выбранной операции скидка не установлена", 60);
	Иначе	 
		Для каждого Стр Из ТаблицаТоваров Цикл 
			Если Стр.УчетнаяЦена = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Стр.ОтклонениеСкидки = РезультатС.Отклонение; 
			Стр.Скидка = РезультатС.Скидка;
			Если Стр.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное") Тогда  
				 Стр.ФактическаяЦена = Стр.УчетнаяЦена + Стр.Скидка;        
			ИначеЕсли Стр.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное") Тогда
				 Стр.ФактическаяЦена = Стр.УчетнаяЦена + Стр.УчетнаяЦена*Стр.Скидка/100;
			КонецЕсли;	
		КонецЦикла;	 
		ЗаполнитьИтоги();
		УстановитьДоступностьКонтрагента();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура СкидкаОтменить(Команда)
	Для каждого Стр Из ТаблицаТоваров Цикл 		
		Стр.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное"); 
		Стр.Скидка = 0;  
		Стр.ФактическаяЦена = Стр.УчетнаяЦена;
	КонецЦикла;	 
	ЗаполнитьИтоги();
	УстановитьДоступностьКонтрагента();
КонецПроцедуры


&НаКлиенте
Процедура ПересчитатьФактическуюЦену()
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		Если ТекСтрока.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное") Тогда  
			 ТекСтрока.ФактическаяЦена = ТекСтрока.УчетнаяЦена + ТекСтрока.Скидка;        
		ИначеЕсли ТекСтрока.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное") Тогда
			 ТекСтрока.ФактическаяЦена = ТекСтрока.УчетнаяЦена + ТекСтрока.УчетнаяЦена*ТекСтрока.Скидка/100;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровОтклонениеСкидкиПриИзменении(Элемент)
	ПересчитатьФактическуюЦену();
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаТоваровСкидкаПриИзменении(Элемент)
	ПересчитатьФактическуюЦену();
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьТаблицу(Команда)
	Для каждого Стр Из ТаблицаТоваров Цикл
	    УдалитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога); 
	КонецЦикла;	
	ТаблицаТоваров.Очистить();   
	ЗаполнитьИтоги();
	УстановитьДоступностьКонтрагента();
КонецПроцедуры  


&НаКлиенте
Процедура ТаблицаТоваровПослеУдаления(Элемент)
	ЗаполнитьТаблицуДокумента();
	ЗаполнитьИтоги(); 
	УстановитьДоступностьКонтрагента();
КонецПроцедуры


&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)    
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт") Тогда   
		Объект.Склад = ПолучитьСклад(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыСкладов.ОбщийСкладЦО")); 
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРеализация.РеализацияЦОРозница") Тогда 
		Объект.Склад = ПолучитьСклад(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыСкладов.ВитринаЦО"));
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРеализация.РеализацияЛомбард") Тогда  
		Объект.Склад = ПолучитьСклад(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыСкладов.Витрина"));
	КонецЕсли;	
	УстановитьВидимость(); 
	Для каждого Стр Из ТаблицаТоваров Цикл
	    УдалитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога); 
	КонецЦикла;	
	ТаблицаТоваров.Очистить();   
	ЗаполнитьИтоги();
	УстановитьДоступностьКонтрагента(); 
	Если Элементы.Контрагент.ТолькоПросмотр И НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда 
		Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт") Тогда
		    Объект.Контрагент = ПредопределенноеЗначение("Справочник._ДемоКонтрагенты.РозничныйПокупатель"); 
		КонецЕсли;	
	КонецЕсли;	 
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);

КонецПроцедуры


&НаКлиенте
Процедура ВыборСпособаОплатыПриИзменении(Элемент)
	УстановитьДоступностьКонтрагента();	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаТоваровПриИзменении(Элемент)  
	ЗаполнитьИтоги();
	УстановитьДоступностьКонтрагента();
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьДляРеализацииОпт(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ", Объект);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОпт",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыбораРеализацииОпт", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

 &НаСервере
Процедура ПослеВыбораОпт(Результат, ДопПараметры) Экспорт
    Если Результат = неопределено Тогда
        Возврат;
	КонецЕсли;    
	
	Для каждого стр Из Результат.Товары Цикл   
		Отбор = Новый Структура;
		Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет);
		Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);  
		Строки = Объект.Товары.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатПроверки = ЛБ_УправлениеЛомбардом.ПроверитьОбъектЗалогаДобавленВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога); 
		Если НЕ РезультатПроверки = неопределено Тогда     
			 Артикул = ЛБ_УправлениеЛомбардом.ПолучитьАртикулОЗ(Объект.Дата, Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
			 Если ЗначениеЗаполнено(РезультатПроверки.Регистратор) Тогда
			     ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ» № " + СокрЛП(РезультатПроверки.Регистратор.ПредставлениеНомера) + " от " + Формат(РезультатПроверки.Регистратор.Дата, "ДЛФ=");
			 Иначе 
				 ТекстСообщения = "Внимание! Невостребованный залог с артикулом " + СокрЛП(Артикул) + " уже добавлен в документ «Реализация НЗ», ответственный " + СокрЛП(РезультатПроверки.Ответственный);
			 КонецЕсли;	 
			 ТекстСообщения = ТекстСообщения + ". Добавление в текущий документ невозможно.";
			 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения); 
			 Продолжить;
		КонецЕсли;	 
		
	    НоваяСтр = Объект.Товары.Добавить();
		НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет; 
		НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
		НоваяСтр.Количество = Стр.Количество;
		НоваяСтр.ФактическаяЦена = Стр.ФактическаяЦена;
		ЗаполнитьОбъектыЗалогаДобавленныеВРеализацию(Стр.ЗалоговыйБилет, Стр.ОбъектЗалога);
	КонецЦикла;	  
	ЗаполнитьТаблицуТоваров();
	УстановитьДоступностьКонтрагента();
КонецПроцедуры


&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРеализация.РеализацияЦООпт") Тогда
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораКонтрагента",ЭтаФорма);
		ОткрытьФорму("Справочник._ДемоКонтрагенты.ФормаВыбора", , ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе   
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("БезДокументов", истина);
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалогодателя",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораЗалогодателя(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
