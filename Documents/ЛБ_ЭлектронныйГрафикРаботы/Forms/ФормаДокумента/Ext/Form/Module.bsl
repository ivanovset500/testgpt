&НаСервере
Процедура ПересчетИтоговЧасов() 
	тз = Объект.ДанныеОВремени.Выгрузить();
	
	тз.Свернуть("Сотрудник", СокрЛП(СтрокаСвертки));
	тз.Колонки.Добавить("Итого");
	Для каждого стр из тз Цикл 
		Итого = 0;
		Для инд = 1 по 31 Цикл 		
			Итого = Итого + Стр["Часов"+инд]; 
		КонецЦикла; 
		стр.Итого = Итого;
		
		отб = Новый Структура("Сотрудник", стр.Сотрудник); 
		
		НайденСтроки = Объект.ДанныеОВремени.НайтиСтроки(Отб);
		Для каждого СтрДокумента из НайденСтроки Цикл
			СтрДокумента.ИтогоЧасов = Итого;
		КонецЦикла;			
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеОВремениЛомбардНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	//СтандартнаяОбработка = Ложь;   
	Элемент.РежимВыбораИзСписка = Истина;
	
	Элемент.СписокВыбора.Очистить();
	
	массивЛомбардов = СформироватьМассивЛомбардов();    
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(массивЛомбардов);
КонецПроцедуры  

Функция СформироватьМассивЛомбардов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
	|ИЗ
	|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&НаДату, Отделение = &Отделение) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	|ГДЕ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт = Ложь";
	Запрос.УстановитьПараметр("НаДату", Объект.Дата); 
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ломбард");
	
КонецФункции

Функция СформироватьМассивОтделений() 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	|ИЗ
	|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	|			,
	|			Ломбард = &Ломбард
	|				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("Ломбард", ПараметрыСеанса.ТекущийЛомбард);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Отделение");
	
КонецФункции

Функция СформироватьМассивСотрудниковОтделения() 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	|ИЗ
	|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	|			&НаДату,
	|			Отделение = &Отделение
	|				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	
	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка");	
	
	
	Запрос2 = Новый Запрос; 
	Запрос2.Текст = "ВЫБРАТЬ
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард,
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия КАК ВидСобытия
	|ИЗ
	|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&НаДату, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	|ГДЕ
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	|	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЛомбарда";
	Запрос2.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	
	
	массив = Новый Массив;
	
	Выборка = Запрос2.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидСобытия = Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение Тогда
			Продолжить;
		КонецЕсли;
		массив.Добавить(Выборка.Сотрудник);
		
	КонецЦикла; 	
	
	Возврат Массив;
	
КонецФункции

