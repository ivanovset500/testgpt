&НаСервере
Процедура УстановитьСтатусДокумента()  
	Если Объект.Архив Тогда 
		ЭтаФорма.СтатусДокумента = "АРХИВ"; 
		Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный;
	Иначе 
		Если Объект.Проведен Тогда
			ЭтаФорма.СтатусДокумента = "ФАКТ"; 
			Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Зеленый;
		Иначе
			ЭтаФорма.СтатусДокумента = "ПРОЕКТ"; 
			Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ДанныеОВремениВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Объект.Проведен Тогда
		Возврат;
	КонецЕсли;
	Если СтрНайти(Поле.Имя, "ВремяПредставление") > 0 Тогда
		СтандартнаяОбработка = Ложь;
		НомерДня = СтрЗаменить(Поле.Имя, "ВремяПредставление", "");
		
		ТекСтрока = Элементы.ДанныеОВремени.ТекущиеДанные;  
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Сотрудник", 	ТекСтрока.Сотрудник);
		ПараметрыФормы.Вставить("Часов", 		ТекСтрока["Часов"+НомерДня]); 
		ПараметрыФормы.Вставить("ВидВремени", 	ТекСтрока["ВидВремени"+НомерДня]); 
		ПараметрыФормы.Вставить("Территория", 	ТекСтрока["Территория"+НомерДня]);
		ПараметрыФормы.Вставить("НомерДня", 	НомерДня);
		ПараметрыФормы.Вставить("ПолучитьЧасыИзГрафика", 	Истина);
		ПараметрыФормы.Вставить("ДатаРаботы",   Объект.ПериодРегистрации + НомерДня*86400);
		ПараметрыФормы.Вставить("Ломбард",      ТекСтрока.Ломбард);
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеОкончанииРедактированияДанныхОВремени", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ЛБ_РедактированиеДанныхУчетаВремениЗаДень", Параметрыформы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;
КонецПроцедуры

Функция ВернутьЧасыИзГрафика(Параметры)
	ВидВремени 		= Параметры.ВидВремени; 
	Часов 			= Параметры.Часов;
	НомерДня 		= Параметры.НомерДня;  
	Территория 		= Параметры.Территория; 
	Сотрудник 		= Параметры.Сотрудник; 
	ДатаРаботы     	= Параметры.ДатаРаботы;
	Ломбард     	= Параметры.Ломбард;  
	Текст           = Параметры.Текст; 
	
	ЧасыВведеныВручную = Ложь;
	
	Если нрег(Текст) = "х" тогда
		ВидВремени = "";
		Часов = 0;
		
		Рез = Новый Структура;
		Рез.Вставить("Часов",      Часов); 
		Рез.Вставить("НомерДня",   НомерДня); 
		Рез.Вставить("ВидВремени", ВидВремени); 
		Рез.Вставить("Территория", "");
		
		Возврат Рез;
		
	ИначеЕсли Текст = " " Тогда
		ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка;
		Территория = "";

		ЧасыВведеныВручную = Ложь;

	ИначеЕсли нрег(Текст) = "в" тогда 
		ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;  
		Территория = "";

		ЧасыВведеныВручную = Истина;

	ИначеЕсли нрег(Текст) = "б" тогда 
		ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Болезнь; 
		Территория = "";

		ЧасыВведеныВручную = Истина;

	ИначеЕсли нрег(Текст) = "о" тогда 
		ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ОсновнойОтпуск;  
		Территория = "";
		
		ЧасыВведеныВручную = Истина;

	ИначеЕсли нрег(Текст) = "у" тогда 
		ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение;
		Территория = "";

		ЧасыВведеныВручную = Истина;

	Иначе
		Если Текст = "" Тогда
			
		Иначе
			Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст) Тогда
				Часов = Число(Текст);
				ЧасыВведеныВручную = Истина;  
				Территория = "";

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	
	
	Если НЕ ЗначениеЗаполнено(ВидВремени) Тогда
		ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка;
	КонецЕсли;
	
	Если НЕ ЧасыВведеныВручную и Параметры.ПолучитьЧасыИзГрафика Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЛБ_РабочиеДниЛомбарда.РабочиеМинуты КАК РабочиеМинуты,
		|	ЛБ_РабочиеДниЛомбарда.Выходной КАК Выходной
		|ИЗ
		|	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
		|ГДЕ
		|	ЛБ_РабочиеДниЛомбарда.Ломбард = &Ломбард
		|	И ЛБ_РабочиеДниЛомбарда.Период = &ДатаРаботы";
		Запрос.УстановитьПараметр("Ломбард", Ломбард);
		Запрос.УстановитьПараметр("ДатаРаботы", ДатаРаботы);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Часов = Выборка.РабочиеМинуты/60; 
			Если Выборка.Выходной Тогда
				Если ВидВремени <> Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение Тогда
					ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;				
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидВремени) Тогда		
		Если ВидВремени.Целосменное Тогда
			Часов = 0;
		КонецЕсли;
	КонецЕсли;  
	
	ПД = СтруктураПраздничныхДней(ДатаРаботы);  
	
	Если ПД <> Неопределено Тогда
		
		Если ПД.ЧасовСокращено > 0 тогда
			Часов = Часов - ПД.ЧасовСокращено;
		ИначеЕсли ЗначениеЗаполнено(ПД.ВремяНачала) Тогда 
			Часов = (ПД.ВремяОкончания - ПД.ВремяНачала)/3600; 
		КонецЕсли;
	КонецЕсли;
 
	
	
	Рез = Новый Структура;
	Рез.Вставить("Часов", Часов); 
	Рез.Вставить("НомерДня", НомерДня); 
	Рез.Вставить("ВидВремени", ВидВремени); 
	Рез.Вставить("Территория", Территория);
	
	Возврат Рез
КонецФункции

&НаКлиенте
Процедура МесяцРегистрацииСтрокойПриИзменении(Элемент)
	ЗарплатаКадрыКлиент.ВводМесяцаПриИзменении(ЭтаФорма, "Объект.ПериодРегистрации", "МесяцРегистрацииСтрокой", Модифицированность);
	
	ПериодРегистрацииПриИзменении(); 
	
	ПроверитьДействующиеПриказы();
	
КонецПроцедуры

&НаСервере
Процедура ПериодРегистрацииПриИзменении()
	Для инд = 29 по 31 Цикл
		Элементы["ВремяПредставление"+СокрЛП(инд)].Видимость = Истина;
	КонецЦикла;
	
	КоличествоДнейвМесяце = День(КонецМесяца(Объект.ПериодРегистрации));
	Если КоличествоДнейвМесяце = 30 Тогда
		Элементы.ВремяПредставление31.Видимость = Ложь;
	ИначеЕсли КоличествоДнейвМесяце = 29 Тогда
		Элементы.ВремяПредставление31.Видимость = Ложь;
		Элементы.ВремяПредставление30.Видимость = Ложь; 
	ИначеЕсли КоличествоДнейвМесяце = 28 Тогда
		Элементы.ВремяПредставление31.Видимость = Ложь;
		Элементы.ВремяПредставление30.Видимость = Ложь; 
		Элементы.ВремяПредставление29.Видимость = Ложь; 
	КонецЕсли;  
	
	Объект.ДатаНачалаПериода = НачалоМесяца(Объект.ПериодРегистрации);
	Объект.ДатаОкончанияПериода =  КонецМесяца(Объект.ПериодРегистрации);  
КонецПроцедуры


&НаКлиенте
Процедура МесяцРегистрацииСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
