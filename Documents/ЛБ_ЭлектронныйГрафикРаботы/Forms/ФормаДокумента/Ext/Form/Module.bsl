КонецПроцедуры

&НаКлиенте
Процедура ПериодРегистрацииНачалоВыбораЗавершение(ЗначениеВыбрано, ДополнительныеПараметры) Экспорт
	
	ПериодРегистрацииПриИзменении();
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеОкончанииРедактированияДанныхОВремени(Результат, ДопПараметр) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	НомерДня = Результат.НомерДня;
	ТекСтрока = Элементы.ДанныеОВремени.ТекущиеДанные; 
	Если Результат.Часов > 12 Тогда
		Результат.Часов = 12;
	КонецЕсли;    
	
	
	ТекСтрока["Часов"+НомерДня] 				= Результат.Часов; 
	ТекСтрока["ВидВремени"+НомерДня] 			= Результат.ВидВремени;
	ТекСтрока["Территория"+НомерДня] 			= Результат.Территория;
	ТекСтрока["ВремяПредставление"+НомерДня] 	= СформируйПредставлениеВремени(Результат.ВидВремени, Результат.Часов, "");
	
	Отб = Новый Структура("Сотрудник", ТекСтрока.Сотрудник);
	
	Если Результат.Часов > 0 Тогда
		НайдСтроки = Объект.ДанныеОВремени.НайтиСтроки(Отб);
		Для каждого НСтрока из НайдСтроки Цикл
			Если НСтрока.НомерСтроки <> ТекСтрока.НомерСтроки Тогда 
				
				Если Результат.Часов > 0 Тогда
					НСтрока["Часов"+НомерДня] = 0;
					НСтрока["ВидВремени"+НомерДня] = "";
					НСтрока["Территория"+НомерДня] = ТекСтрока.Ломбард;
				КонецЕсли;
				//Если НСтрока["Часов"+НомерДня] > 0 Тогда 
				//	НСтрока["Часов"+НомерДня] = 0;
				//	НСтрока["Территория"+НомерДня] = ТекСтрока.Ломбард; 
				НСтрока["ВремяПредставление"+НомерДня] = СформируйПредставлениеВремени(Результат.ВидВремени, Результат.Часов, ТекСтрока.Ломбард);
				//КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.ПересчитыватьИтог Тогда
		ПересчетИтоговЧасов();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция СформируйПредставлениеВремени(ВидВремени, Часов, Территория)
	Возврат СформироватьПредставлениеВремени(ВидВремени, Часов, Территория);
КонецФункции 

&НаСервереБезКонтекста
Функция СформироватьПредставлениеВремени(ВидВремени, Часов, Территория) Экспорт
	Рез = "";
	Если ЗначениеЗаполнено(ВидВремени) Тогда
		Если ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка Тогда
			Если Часов > 0 Тогда
				Рез = СокрЛП(Часов);
			КонецЕсли;
		Иначе
			Рез = СокрЛП(ВидВремени.БуквенныйКод);
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Территория) Тогда
			Рез = Рез +" "+"л"+СокрЛП(Территория.НомерЛомбарда);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рез;	
КонецФункции

Функция СтруктураПраздничныхДней(Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПраздничныеСокращенныеДни.Дата КАК Дата,
	               |	ЛБ_ПраздничныеСокращенныеДни.Выходной КАК Выходной,
	               |	ЛБ_ПраздничныеСокращенныеДни.ВремяНачала КАК ВремяНачала,
	               |	ЛБ_ПраздничныеСокращенныеДни.ВремяОкончания КАК ВремяОкончания,
	               |	ЛБ_ПраздничныеСокращенныеДни.ЧасовСокращено КАК ЧасовСокращено,
	               |	ЛБ_ПраздничныеСокращенныеДни.РабочийДень КАК РабочийДень
	               |ИЗ
	               |	Справочник.ЛБ_ПраздничныеСокращенныеДни КАК ЛБ_ПраздничныеСокращенныеДни
	               |ГДЕ
	               |	ЛБ_ПраздничныеСокращенныеДни.ПометкаУдаления = Ложь
	               |	И ЛБ_ПраздничныеСокращенныеДни.Дата >= &ДатаНач
	               |	И ЛБ_ПраздничныеСокращенныеДни.Дата <= &ДатаКон";
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Дата)); 
	
	Рез = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Новый Структура;
		Рез.Вставить("Дата", 			Выборка.Дата);
		Рез.Вставить("Выходной", 		Выборка.Выходной);
		Рез.Вставить("ВремяНачала", 	Выборка.ВремяНачала);
		Рез.Вставить("ВремяОкончания", 	Выборка.ВремяОкончания);
		Рез.Вставить("ЧасовСокращено", 	Выборка.ЧасовСокращено); 
		Рез.Вставить("РабочийДень", 	Выборка.РабочийДень);
	КонецЕсли; 
	
	Возврат Рез;	
	
КонецФункции


&НаСервере
Процедура ЗаполнитьИзГрафикаНаСервере() 
	Объект.ДанныеОВремени.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	|ИЗ
	|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	|			&НаДату,
	|			Отделение = &Отделение
	|				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	
	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка");    
	
	ЗапросВых = Новый Запрос;
	ЗапросВых.Текст = "ВЫБРАТЬ
	|	ЛБ_РабочиеДниЛомбарда.Ломбард КАК Ломбард,
	|	ЛБ_РабочиеДниЛомбарда.Выходной КАК Выходной,
	|	ЛБ_РабочиеДниЛомбарда.ДеньНедели КАК ДеньНедели,
	|	ЛБ_РабочиеДниЛомбарда.НомерДня КАК НомерДня,
	|	ЛБ_РабочиеДниЛомбарда.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
	|ГДЕ
	|	ЛБ_РабочиеДниЛомбарда.Период МЕЖДУ &НачДата И &КонДата
	|	И ЛБ_РабочиеДниЛомбарда.Ломбард В(&Подразделение)
	|	И ЛБ_РабочиеДниЛомбарда.Выходной = ИСТИНА";	
	ЗапросВых.УстановитьПараметр("Подразделение", массивЛомб);
	ЗапросВых.УстановитьПараметр("НачДата", Объект.ДатаНачалаПериода);
	ЗапросВых.УстановитьПараметр("КонДата", КонецДня(Объект.ДатаОкончанияПериода));
	тзВых = ЗапросВых.Выполнить().Выгрузить();  
	
	ЗапросРабочиеДни = Новый Запрос;
	ЗапросРабочиеДни.Текст = "ВЫБРАТЬ
	|	ЛБ_РабочиеДниЛомбарда.Ломбард КАК Ломбард,
	|	СУММА(ЛБ_РабочиеДниЛомбарда.РабочиеМинуты) КАК РабочиеМинуты
	|ИЗ
	|	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
	|ГДЕ
	|	ЛБ_РабочиеДниЛомбарда.Период МЕЖДУ &НачДата И &КонДата
	|	И ЛБ_РабочиеДниЛомбарда.Ломбард В(&Подразделение)
	|	И ЛБ_РабочиеДниЛомбарда.Выходной = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЛБ_РабочиеДниЛомбарда.Ломбард";	
	ЗапросРабочиеДни.УстановитьПараметр("Подразделение", массивЛомб);
	ЗапросРабочиеДни.УстановитьПараметр("НачДата", Объект.ДатаНачалаПериода);
	ЗапросРабочиеДни.УстановитьПараметр("КонДата", КонецДня(Объект.ДатаОкончанияПериода));
	тзРабочиеДни = ЗапросРабочиеДни.Выполнить().Выгрузить(); 
	
	
	
	
	Запрос2 = Новый Запрос;
	
	Запрос2.Текст = "ВЫБРАТЬ
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард,
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия КАК ВидСобытия
	|ИЗ
	|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&НаДату, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	|ГДЕ
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	|	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЧисловой";
	Запрос2.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	
	
	КоличествоДнейвМесяце = День(КонецМесяца(Объект.ПериодРегистрации)); 
	
	ВидВремени_Выходной = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;  
	ВидВремени_Увольнение = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение;

	
	Выборка = Запрос2.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//Если Выборка.ВидСобытия = Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение Тогда
		//	Продолжить;
		//КонецЕсли; 
		
		Если ЛБ_ОбщегоНазначения.СотрудникЯвляетсяНачальникомОтделения(Выборка.Сотрудник, Объект.ДатаНачалаПериода) Тогда
			продолжить;
		КонецЕсли;
		
		ДатаУвольнения = ВернутьДатуУвольненияСотрудника(Выборка.Сотрудник, Объект.ДатаНачалаПериода, КонецДня(Объект.ДатаОкончанияПериода));

		
		НовСтроч = Объект.ДанныеОВремени.Добавить();
		НовСтроч.Сотрудник = Выборка.Сотрудник;
		НовСтроч.Ломбард   = Выборка.Ломбард; 
		строкаРабМинуты = тзРабочиеДни.Найти(Выборка.Ломбард, "Ломбард"); 
		Если строкаРабМинуты <> Неопределено Тогда
			НовСтроч.НормаПоПриказу = строкаРабМинуты.РабочиеМинуты/60;
		КонецЕсли;   
		
		
		
		Для номерДня = 1 по КоличествоДнейвМесяце Цикл
			промДата = Объект.ПериодРегистрации + (номерДня-1)*86400; 
			отбВых = Новый Структура;
			отбВых.Вставить("Ломбард", Выборка.Ломбард);
			отбВых.Вставить("Период", промДата);
			
			найдСтрВых = тзВых.НайтиСтроки(ОтбВых);
			Если найдСтрВых.Количество() > 0 Тогда  
				НовСтроч["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Выходной;
				НовСтроч["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Выходной, 0, "");
			КонецЕсли;
			
			ПД = СтруктураПраздничныхДней(промДата);
			Если ПД <> Неопределено Тогда
				Если ПД.Выходной = 2 Тогда 
					НовСтроч["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Выходной;
					НовСтроч["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Выходной, 0, ""); 
				ИначеЕсли ПД.Выходной = 1 и ПД.ЧасовСокращено > 0 тогда
					НовСтроч.НормаПоПриказу = НовСтроч.НормаПоПриказу - ПД.ЧасовСокращено;  			
				КонецЕсли;
			КонецЕсли;
			
			тзНеявка = НеявкаСотрудника(Выборка.Сотрудник, промДата); 
			Если тзНеявка.Количество() > 0 Тогда 			
				Для каждого стр из тзНеявка Цикл
					НовСтроч["ВидВремени"+СокрЛП(номерДня)] = стр.ВидВремени; 
					НовСтроч["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(стр.ВидВремени, 0, "");
				КонецЦикла;	
			КонецЕсли; 
			
			Если ДатаУвольнения <> Неопределено Тогда
				Если промДата >= ДатаУвольнения Тогда 
					НовСтроч["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Увольнение;
					НовСтроч["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Увольнение, 0, "");
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры


Функция НеявкаСотрудника(Сотр, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СостоянияСотрудников.Сотрудник КАК Сотрудник,
	|	ЛБ_СостоянияСотрудников.Период КАК НачалоНеявки,
	|	ЛБ_СостоянияСотрудников.ДействуетДо КАК КонецНеявки,
	|	ЛБ_СостоянияСотрудников.ВидВремени КАК ВидВремени
	|ИЗ
	|	РегистрСведений.ЛБ_СостоянияСотрудников КАК ЛБ_СостоянияСотрудников
	|ГДЕ
	|	ЛБ_СостоянияСотрудников.Сотрудник = &Сотрудник
	|	И ЛБ_СостоянияСотрудников.Период <= &НачалоНеявки
	|	И ЛБ_СостоянияСотрудников.ДействуетДо >= &КонецНеявки";  
	
	Запрос.УстановитьПараметр("Сотрудник", Сотр); 
	Запрос.УстановитьПараметр("НачалоНеявки", НачалоДня(Дата)); 
	Запрос.УстановитьПараметр("КонецНеявки", КонецДня(Дата));
	
	тз = Запрос.Выполнить().Выгрузить();
	
	Возврат тз;		
КонецФункции

