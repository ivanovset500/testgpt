&НаСервере
Процедура ЗаполнитьПервоначальныеДанныеПоСотруднику() 
	ИдентификаторСтроки = ЭтаФорма.Элементы.ДанныеОВремени.ТекущаяСтрока;
	ТекСтр = Объект.ДанныеОВремени.НайтиПоИдентификатору(ИдентификаторСтроки); 
	КоличествоДнейвМесяце = День(КонецМесяца(Объект.ПериодРегистрации)); 
	
	Если ЗначениеЗаполнено(ТекСтр.Сотрудник) и ЗначениеЗаполнено(ТекСтр.Ломбард) Тогда
		ТекСтр.ИтогоЧасов = 0;
		
		ЗапросВых = Новый Запрос;
		ЗапросВых.Текст = "ВЫБРАТЬ
		|	ЛБ_РабочиеДниЛомбарда.Ломбард КАК Ломбард,
		|	ЛБ_РабочиеДниЛомбарда.Выходной КАК Выходной,
		|	ЛБ_РабочиеДниЛомбарда.ДеньНедели КАК ДеньНедели,
		|	ЛБ_РабочиеДниЛомбарда.НомерДня КАК НомерДня,
		|	ЛБ_РабочиеДниЛомбарда.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
		|ГДЕ
		|	ЛБ_РабочиеДниЛомбарда.Период МЕЖДУ &НачДата И &КонДата
		|	И ЛБ_РабочиеДниЛомбарда.Ломбард = (&Подразделение)
		|	И ЛБ_РабочиеДниЛомбарда.Выходной = Истина";	
		ЗапросВых.УстановитьПараметр("Подразделение", ТекСтр.Ломбард);
		ЗапросВых.УстановитьПараметр("НачДата", Объект.ДатаНачалаПериода);
		ЗапросВых.УстановитьПараметр("КонДата", КонецДня(Объект.ДатаОкончанияПериода));
		
		тзВых = ЗапросВых.Выполнить().Выгрузить(); 
		
		ЗапросРабочиеДни = Новый Запрос;
		ЗапросРабочиеДни.Текст = "ВЫБРАТЬ
		|	ЛБ_РабочиеДниЛомбарда.Ломбард КАК Ломбард,
		|	СУММА(ЛБ_РабочиеДниЛомбарда.РабочиеМинуты) КАК РабочиеМинуты
		|ИЗ
		|	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
		|ГДЕ
		|	ЛБ_РабочиеДниЛомбарда.Период МЕЖДУ &НачДата И &КонДата
		|	И ЛБ_РабочиеДниЛомбарда.Ломбард = &Подразделение
		|	И ЛБ_РабочиеДниЛомбарда.Выходной = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_РабочиеДниЛомбарда.Ломбард";	
		ЗапросРабочиеДни.УстановитьПараметр("Подразделение", ТекСтр.Ломбард);
		ЗапросРабочиеДни.УстановитьПараметр("НачДата", Объект.ДатаНачалаПериода);
		ЗапросРабочиеДни.УстановитьПараметр("КонДата", КонецДня(Объект.ДатаОкончанияПериода));
		тзРабочиеДни = ЗапросРабочиеДни.Выполнить().Выгрузить(); 
		
		ТекСтр.НормаПоПриказу = 0;
		строкаРабМинуты = тзРабочиеДни.Найти(ТекСтр.Ломбард, "Ломбард"); 
		Если строкаРабМинуты <> Неопределено Тогда
			ТекСтр.НормаПоПриказу = строкаРабМинуты.РабочиеМинуты/60;
		КонецЕсли;
		

		ДатаУвольнения = ВернутьДатуУвольненияСотрудника(ТекСтр.Сотрудник, Объект.ДатаНачалаПериода, КонецДня(Объект.ДатаОкончанияПериода));
        
		
			
		ВидВремени_Выходной = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;  
		ВидВремени_Увольнение = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение;
		
		
		Для номерДня = 1 по КоличествоДнейвМесяце Цикл 
			промДата = Объект.ПериодРегистрации + (номерДня-1)*86400; 
			
			ТекСтр["ВидВремени"+СокрЛП(номерДня)] = "";
			ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = ""; 
			ТекСтр["Часов"+СокрЛП(номерДня)] = 0; 		
			
			
			отбВых = Новый Структура;
			отбВых.Вставить("Ломбард", ТекСтр.Ломбард);
			отбВых.Вставить("Период", промДата);
			
			найдСтрВых = тзВых.НайтиСтроки(ОтбВых);
			Если найдСтрВых.Количество() > 0 Тогда  
				ТекСтр["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Выходной;
				ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Выходной, 0, "");
			КонецЕсли;
			
			
			тзНеявка = НеявкаСотрудника(ТекСтр.Сотрудник, промДата); 
			Если тзНеявка.Количество() > 0 Тогда 			
				Для каждого стр из тзНеявка Цикл
					ТекСтр["ВидВремени"+СокрЛП(номерДня)] = стр.ВидВремени; 
					ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(стр.ВидВремени, 0, "");
				КонецЦикла;	
			КонецЕсли;  
			
			Если ДатаУвольнения <> Неопределено Тогда
				Если промДата >= ДатаУвольнения Тогда 
					ТекСтр["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Увольнение;
					ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Увольнение, 0, "");
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры 


Функция ВернутьДатуУвольненияСотрудника(Сотр, НачДата, КонДата)
	
	ЗапросУв = Новый Запрос;
	ЗапросУв.Текст = "ВЫБРАТЬ
	|	ЛБ_КадроваяИсторияСотрудников.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников КАК ЛБ_КадроваяИсторияСотрудников
	|ГДЕ
	|	ЛБ_КадроваяИсторияСотрудников.ВидСобытия = &ВидСобытия
	|	И ЛБ_КадроваяИсторияСотрудников.Период МЕЖДУ &НачДата И &КонДата
	|	И ЛБ_КадроваяИсторияСотрудников.Сотрудник = &Сотрудник";
	
	ЗапросУв.УстановитьПараметр("НачДата",    НачДата);
	ЗапросУв.УстановитьПараметр("КонДата",    КонДата); 
	ЗапросУв.УстановитьПараметр("Сотрудник",  Сотр);
	ЗапросУв.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение); 
	
	ДатаУвольнения = Неопределено;
	
	ВыборкаУв = ЗапросУв.Выполнить().Выбрать();
	Если ВыборкаУв.Следующий() Тогда
		ДатаУвольнения = ВыборкаУв.Период;
	КонецЕсли;
	
	Возврат ДатаУвольнения;
КонецФункции



