&НаКлиенте
Процедура ОтработатьПоНажатиюКлавиши(Элемент, Текст)
	Если СтрНайти(Элемент.Имя, "ВремяПредставление") > 0 Тогда
		НомерДня = СтрЗаменить(Элемент.Имя, "ВремяПредставление", ""); 
		
		ТекСтрока = Элементы.ДанныеОВремени.ТекущиеДанные;  
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Сотрудник", 	ТекСтрока.Сотрудник);
		ПараметрыФормы.Вставить("Часов", 		ТекСтрока["Часов"+НомерДня]); 
		ПараметрыФормы.Вставить("ВидВремени", 	ТекСтрока["ВидВремени"+НомерДня]); 
		ПараметрыФормы.Вставить("Территория", 	ТекСтрока["Территория"+НомерДня]);
		ПараметрыФормы.Вставить("НомерДня", 	НомерДня);
		ПараметрыФормы.Вставить("ПолучитьЧасыИзГрафика", 	Истина);
		ПараметрыФормы.Вставить("ДатаРаботы",   Объект.ПериодРегистрации + (НомерДня-1)*86400);
		ПараметрыФормы.Вставить("Ломбард",      ТекСтрока.Ломбард); 
		ПараметрыФормы.Вставить("Текст",        Текст);
		
		Рез = ВернутьЧасыИзГрафика(ПараметрыФормы);
		
		рез.Вставить("ПересчитыватьИтог", Истина);
		рез.Вставить("ДатаРаботы", Объект.ПериодРегистрации + (НомерДня-1)*86400);

		ПослеОкончанииРедактированияДанныхОВремени(Рез, Неопределено);  
	КонецЕсли;
КонецПроцедуры

