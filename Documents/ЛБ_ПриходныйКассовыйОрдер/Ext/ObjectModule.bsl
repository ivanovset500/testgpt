        Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ПредставлениеНомераПКО) Тогда 
			СписокНеЗаполненныхРеквизитов = СписокНеЗаполненныхРеквизитов + ?(ПустаяСтрока(СписокНеЗаполненныхРеквизитов), "", ", ") + "Номер ПКО";
