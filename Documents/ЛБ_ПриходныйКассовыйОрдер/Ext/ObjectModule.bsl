// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Результат = ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(Дата, Организация, Ломбард); 
	Если НЕ Результат = неопределено Тогда 
	     КассоваяСмена = Результат.КассоваяСмена;  
	Иначе	 
        Отказ = Истина;  
		ОбщегоНазначения.СообщитьПользователю("На дату документа не открыта кассовая смена!");
		Возврат;
	КонецЕсли;	   
	
	Движения.ЛБ_ДенежныеСредства.Записывать = Истина;
    Движения.ЛБ_ДвиженияДенежныхСредств.Записывать = Истина;

	Если НЕ ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.СводныйПКО И НЕ ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПоступленияОтПокупателейНевостребованныхЗалогов Тогда
		Движение = Движения.ЛБ_ДенежныеСредства.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Ломбард = Ломбард;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.ВидДенежныхСредств = Перечисления.ЛБ_ВидыДенежныхСредств.Наличные;	
		Движение.Сумма = ЭтотОбъект.Сумма;

		Движение = Движения.ЛБ_ДвиженияДенежныхСредств.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Ломбард = Ломбард; 
		Движение.КассоваяСмена = КассоваяСмена;
		Движение.КассоваяОперация = ЭтотОбъект.Ссылка;
		Движение.ФизическоеЛицо = ЭтотОбъект.ФизическоеЛицо;
		Движение.ВидДенежныхСредств = Перечисления.ЛБ_ВидыДенежныхСредств.Наличные;	
		Движение.Сумма = ЭтотОбъект.Сумма;      
		Движение.ВидОперации = ЭтотОбъект.ВидОперации; 
		Движение.ВидДвиженияДС = Перечисления.ЛБ_ВидыДвиженияДС.Приход;
		Движение.Номер = ЭтотОбъект.ПредставлениеНомераПКО;
		Движение.Дт = ЭтотОбъект.Дт;
		Движение.Кт = ЭтотОбъект.Кт;
		Движение.Контрагент = ЭтотОбъект.Контрагент;
		Движение.ФИО = ЭтотОбъект.ПринятоОт;  
		Движение.ДУЛ = ЭтотОбъект.ДУЛ;
		Движение.Основание = ЭтотОбъект.Основание;
		Движение.Приложение = ЭтотОбъект.Приложение;
		Движение.ДополнительнаяИнформация = ЭтотОбъект.ДополнительнаяИнформация; 
		Движение.БанковскаяКарта = ЭтотОбъект.БанковскаяКарта;    
	КонецЕсли;
КонецПроцедуры

КассоваяСмена = Документы.ЛБ_ОперацииКассовойСмены.ПустаяСсылка();
