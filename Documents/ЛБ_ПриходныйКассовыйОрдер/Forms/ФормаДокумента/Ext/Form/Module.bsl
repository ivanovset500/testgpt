&НаСервере
Функция ПолучитьЛомбардыОтделения() 
	Возврат ЛБ_ОбщийМодуль.ПолучитьЛомбардыВОтделении(?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДатаСеанса()), ОтделениеЛомбарда, Объект.Ломбард); 
КонецФункции

&НаСервере
Функция ТипКонтрагентаКлиент(Контрагент)
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.ЛБ_Залогодатели") Тогда
	    Возврат Истина;
	КонецЕсли;	       
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	СтандартнаяОбработка = Ложь; 
	Если НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		Предупреждение("Выберите вид операции!", 60);
		Возврат
	КонецЕсли;	
	 
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПлательщика",ЭтаФорма);
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеИзКассыДругогоЛомбарда") Или 
		 Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеИзЦентральнойКассы") Тогда
		Если ЗначениеЗаполнено(ОтделениеЛомбарда) И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеИзКассыДругогоЛомбарда") Тогда 
			СписокВыбора = ПолучитьЛомбардыОтделения(); 
			ВыбранноеЗначение = ВыбратьИзСписка(СписокВыбора, Элементы.Контрагент); 

			Если ВыбранноеЗначение <> Неопределено Тогда 
			   Объект.Контрагент = ВыбранноеЗначение.Значение;
			   ЗаполнитьДопРеквизиты();
			КонецЕсли;  
		Иначе	  
		    ОткрытьФорму("Справочник.ЛБ_Ломбарды.ФормаВыбора",,ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		КонецЕсли;	 
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО") ИЛИ
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПрочиеПриходныеОперацииПоСогласованиюСЦО") Тогда
		
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.Добавить(1, "Клиент");
		СписокВыбора.Добавить(2, "Физическое лицо");
		ВыбранноеЗначение = ВыбратьИзСписка(СписокВыбора, Элементы.Контрагент); 
		
		Если ВыбранноеЗначение <> Неопределено Тогда  
			Если ВыбранноеЗначение.Значение = 1 Тогда   
				ПараметрыФормы = Новый Структура;  
				Если ЗначениеЗаполнено(Объект.Контрагент) И ТипКонтрагентаКлиент(Объект.Контрагент) Тогда 
					ПараметрыФормы.Вставить("Залогодатель", Объект.Контрагент); 
				КонецЕсли;	
				ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
			ИначеЕсли ВыбранноеЗначение.Значение = 2 Тогда
				ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",,ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеСКорпоративнойКарты") ИЛИ
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ВозвратОтПодотчетника") или
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ВозвратЗарплатыПоОшибке") или
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеУщербаСотрудником") Тогда
		
		массивСотрудников = СформироватьМассивСотрудниковОтделения();    		
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ссылка", массивСотрудников);
		
		ПараметрФормы = Новый Структура;
		ПараметрФормы.Вставить("Отбор", СтруктураОтбора);

		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",ПараметрФормы,ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		

	//+МАН 23.04.25 Замена открытия спр физ. лиц на поиск клиента. Заявка 2956
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеУщербаУволеннымСотрудником")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиУволеннымСотрудником") Тогда
		
		ОткрытьФорму("ОбщаяФорма.ЛБ_ПоискЗалогодателя",, ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	//-МАН
	Иначе 
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",,ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;	 
КонецПроцедуры

Функция СформироватьМассивСотрудниковОтделения() 
	
	ТекДата = ТекущаяДата();
	массив = Новый Массив;
	
	Запрос0 = Новый Запрос;
	Запрос0.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&НаДату, ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	               |ГДЕ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард = &Ломбард"; 
	Запрос0.УстановитьПараметр("НаДату", ТекДата);
	Запрос0.УстановитьПараметр("Ломбард", Объект.Ломбард); 
	
	Отделен = Неопределено;
	Выборка = Запрос0.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отделен = Выборка.Отделение;
	КонецЕсли;  
	
	Если Отделен <> Неопределено Тогда
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	               |			&НаДату,
	               |			Отделение = &Отделение
	               |				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("НаДату", ТекДата);
	Запрос.УстановитьПараметр("Отделение", Отделен);

	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка");	
	
				   
	
	Запрос2 = Новый Запрос; 
	Запрос2.Текст = "ВЫБРАТЬ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия КАК ВидСобытия,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ФизическоеЛицо КАК ФизическоеЛицо
	                |ИЗ
	                |	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&НаДату, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	                |ГДЕ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	                |	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЛомбарда";
	Запрос2.УстановитьПараметр("НаДату", ТекДата);
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	         	

	Выборка = Запрос2.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидСобытия = Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение Тогда
			Продолжить;
		КонецЕсли;
		массив.Добавить(Выборка.ФизическоеЛицо);
		
	КонецЦикла;
	КонецЕсли;

	Возврат Массив;

КонецФункции


&НаСервере
Процедура ПослеВыбораПлательщика(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда 
		Объект.Контрагент = Результат.Залогодатель;
		Объект.ФизическоеЛицо = Результат.Залогодатель;
		Объект.ДокументКлиента = Результат.ДокументЗалогодателя; 
		//+МАН 23.04.25 Заполняем от кого принято. Заявка 2956
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеУщербаУволеннымСотрудником")
			ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиУволеннымСотрудником") Тогда

			Объект.ПринятоОт = СокрЛП(Результат.Залогодатель.Наименование);
		КонецЕсли;
		//-МАН
	Иначе	
		Объект.Контрагент = Результат;  
		Если ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
			Объект.ФизическоеЛицо = Результат;
			Объект.ПринятоОт = СокрЛП(Результат);
		КонецЕсли;	 
	КонецЕсли;	
	ЗаполнитьДопРеквизиты();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УстановитьСтатусДокумента(); 
КонецПроцедуры

&НаКлиенте
Процедура ПринятоОтНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеИзКассыДругогоЛомбарда") или 
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеИзЦентральнойКассы") Тогда
		
		массивСотрудников = СформироватьМассивСотрудниковОтделения();    		
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Ссылка", массивСотрудников);
		
		ПараметрФормы = Новый Структура;
		ПараметрФормы.Вставить("Отбор", СтруктураОтбора);
		
		ОбработкаВыбораФЛ = Новый ОписаниеОповещения("ПослеВыбораФЛ",ЭтаФорма);
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",ПараметрФормы,ЭтаФорма,,,, ОбработкаВыбораФЛ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ОбработкаВыбораФЛ = Новый ОписаниеОповещения("ПослеВыбораФЛ",ЭтаФорма);
		ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора",,ЭтаФорма,,,, ОбработкаВыбораФЛ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры  

&НаСервере
Процедура ПослеВыбораФЛ(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;	 
	
	Объект.ФизическоеЛицо = Результат;
	Объект.ПринятоОт = СокрЛП(Результат);    
	Элементы.ПринятоОт.РедактированиеТекста = Ложь; 
	ЗаполнитьДопРеквизиты();
КонецПроцедуры

&НаСервере
Функция ПолучитьОтделение()
	Возврат ЛБ_ОбщийМодуль.ПолучитьОтделениеЛомбарда(?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДатаСеанса()), Объект.Ломбард);
КонецФункции

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	ОтделениеЛомбарда = ПолучитьОтделение();
	СформироватьНомерДокумента(); 
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда  
		ЭтаФорма.Заголовок = "Приходный кассовый ордер № " + СокрЛП(Объект.ПредставлениеНомераПКО) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПринятоОтПриИзменении(Элемент)
	ЗаполнитьДопРеквизиты();
КонецПроцедуры

&НаКлиенте
Процедура ПринятоОтОчистка(Элемент, СтандартнаяОбработка)
	Объект.ФизическоеЛицо = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");  
	Элементы.ПринятоОт.РедактированиеТекста = Истина;
КонецПроцедуры

&НаСервере
Функция ПолучитьТекущуюДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции	

&НаКлиенте
Процедура БанковскаяКартаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработкаВыбораБК = Новый ОписаниеОповещения("ПослеВыбораБК",ЭтаФорма);
	ПараметрыФормы = Новый Структура; 
	Отделение = ПолучитьОтделение();
	Если Отделение = неопределено Тогда
		ПараметрыФормы.Вставить("ВыборОтделение", Ложь);
	Иначе	                    
		ПараметрыФормы.Вставить("ВыборОтделение", Истина);
	    ПараметрыФормы.Вставить("Отделение", Отделение);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ТекДата", ?(НовыйДокумент, ПолучитьТекущуюДатуСеанса(), Объект.Дата));
	ОткрытьФорму("Справочник.ЛБ_КорпоративныеКарты.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбораБК, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораБК(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;	 
	
	Объект.БанковскаяКарта = Результат;
КонецПроцедуры

&НаСервере
Процедура ОтменитьПроведение()  
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
	ЭтаФорма.ТолькоПросмотр = Ложь;
	ОтменитьПроведение();
	УстановитьСтатусДокумента(); 
	ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаРедактировать.Видимость = Ложь; 
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков") ИЛИ
	     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиСотрудником") Тогда 			                                            
	   Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		   Элементы.Контрагент.ТолькоПросмотр = Истина; 
		   Элементы.ПринятоОт.ТолькоПросмотр = Истина;  
	   КонецЕсли;	   
   КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяИнформацияПриИзменении(Элемент)
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеСКорпоративнойКарты") ИЛИ
		 Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеУщербаСотрудником") ИЛИ
		 Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеУщербаУволеннымСотрудником") Тогда
	    Объект.Приложение = Объект.ДополнительнаяИнформация;  
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентОткрытие(Элемент, СтандартнаяОбработка)
	Если (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО") ИЛИ 
		       Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПрочиеПриходныеОперацииПоСогласованиюСЦО")) И ТипКонтрагентаКлиент(Объект.Контрагент) Тогда
		СтандартнаяОбработка = Ложь; 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Залогодатель", Объект.Контрагент);
		ПараметрыФормы.Вставить("Дата", ?(НовыйДокумент, ПолучитьТекущуюДатуСеанса(), Объект.Дата));	
		ОткрытьФорму("ОбщаяФорма.ЛБ_КарточкаЗалогодателя", ПараметрыФормы, ЭтаФорма); 
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;	
КонецПроцедуры

//+МАН Выведена нестандартная кнопка печати. Заявка 2936
&НаКлиенте
Процедура Печать(Команда)
	Если Объект.Проведен Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИменаМакетов", "ПКО"); 
		ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_ПриходныйКассовыйОрдер");
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
	Иначе
		Предупреждение("Печать непроведенного документа запрещена!");
	КонецЕсли;	
КонецПроцедуры
