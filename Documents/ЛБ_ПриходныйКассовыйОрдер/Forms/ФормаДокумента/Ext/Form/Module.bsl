
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;

	Если Параметры.Свойство("КопироватьИзДокумента") Тогда 
		ЗаполнитьДокументКопированием(Параметры.КопироватьИзДокумента);
		Если НЕ ТекПользователь.ЭтоЛомбард Тогда
       		Объект.Ответственный = ТекПользователь;
		Иначе
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		КонецЕсли;	 		 
		НовыйДокумент = Истина;          	
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Ссылка) Тогда  
		Если Параметры.Свойство("Организация") Тогда 
			Объект.Организация = Параметры.Организация;
		Иначе	
		    Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
		КонецЕсли;	
		Если Параметры.Свойство("Ломбард") Тогда 
			Объект.Ломбард = Параметры.Ломбард;
		Иначе	
		     Объект.Ломбард = ЛБ_ОбщийМодуль.ПолучитьЛомбардПользователя(ПараметрыСеанса.ТекущийПользователь); 
		КонецЕсли;	   
	    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
       		Объект.Ответственный = ТекПользователь;
		Иначе
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		КонецЕсли;	 	 		 
		НовыйДокумент = Истина;  
	//Иначе
	//	ЭтаФорма.ИспользоватьРежимПроведения = ИспользованиеРежимаПроведения.Неоперативный;
	КонецЕсли;	 
	
	Если ПроверитьКассовыйДеньЗакрыт() Тогда
		Этаформа.ТолькоПросмотр = Истина;
	Иначе	
		Если Объект.Проведен Тогда  
			Этаформа.ТолькоПросмотр = Истина; 
			Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьОтменаКО(Объект.Ссылка) Тогда
				Если НЕ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков И 
					 НЕ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО Тогда 
					 
					Если ЛБ_ОбщийМодуль.КассовыеСменаСовпадаетСТекущей(Объект) Тогда
						Если ТекущаяДатаСеанса() - Объект.Дата < 3600 Тогда  
							ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаРедактировать.Видимость = Истина;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	  
			КонецЕсли;	
		КонецЕсли; 
	КонецЕсли;	
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	УстановитьВидимостьПоВидуОперации();  
	УстановитьСтатусДокумента(); 
	Если ЗначениеЗаполнено(Объект.Ломбард) Тогда  
		ОтделениеЛомбарда = ЛБ_ОбщийМодуль.ПолучитьОтделениеЛомбарда(?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДатаСеанса()), Объект.Ломбард); 
	КонецЕсли;	   
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков") ИЛИ
	     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиСотрудником") Тогда 			                                            
	   Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		   Элементы.Контрагент.ТолькоПросмотр = Истина; 
		   Элементы.ПринятоОт.ТолькоПросмотр = Истина;  
	   КонецЕсли;	   
   КонецЕсли;   
   
   Если НЕ ТекПользователь.ЭтоЛомбард Тогда
	   Если УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
		   СотрудникЦО = Истина;
	   КонецЕсли;
   КонецЕсли;	   
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьДокументКопированием(ИзДокумента);
	Для каждого Реквизит Из Метаданные.Документы.ЛБ_ПриходныйКассовыйОрдер.Реквизиты Цикл 
		Объект[Реквизит.Имя] = ИзДокумента[Реквизит.Имя];
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	Если НовыйДокумент Тогда
		СформироватьНомерДокумента(); 
		ЭтаФорма.Заголовок = "Приходный кассовый ордер (создание)";
	Иначе
		ЭтаФорма.Заголовок = "Приходный кассовый ордер № " + СокрЛП(Объект.ПредставлениеНомераПКО) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПКО.СводныйПКО") Тогда
			Элементы.ГруппаОсновная.Видимость = Ложь;
			Элементы.ГруппаРеквизиты.Видимость = ложь; 
			Элементы.ВидОперации.Видимость = Ложь;
			ЭтаФорма.ТолькоПросмотр = Истина;  
			ЭтаФорма.Заголовок = "Сводный приходный кассовый ордер № " + СокрЛП(Объект.ПредставлениеНомераПКО) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Функция ПолучитьОткрытуюКассовуюСмену()
	Возврат ЛБ_ОбщийМодуль.ПолучитьОткрытуюКассовуюСмену(?(НовыйДокумент И НЕ СотрудникЦО, ТекущаяДатаСеанса(), Объект.Дата), Объект.Организация, Объект.Ломбард);
КонецФункции      

&НаСервере
Функция ПроверитьКассовыйДеньЗакрыт()
	СтруктураКС = ЛБ_ОбщийМодуль.ПолучитьТекущийСтатусКассовойСмены(КонецДня(Объект.Дата), Объект.Организация, Объект.Ломбард);
	Если НЕ СтруктураКС = неопределено Тогда
		Если СтруктураКС.Статус = Перечисления.ЛБ_КассоваяСменаСтатус.КассовыйДеньЗакрыт Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда   
		СтруктураКС = ПолучитьОткрытуюКассовуюСмену();
		Если СтруктураКС = неопределено Тогда
			Отказ = Истина;
			Сообщить("Необходимо открыть кассовую смену в ломбарде!");
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервере
Процедура УстановитьСтатусДокумента()  
	Если Объект.Проведен Тогда 
		ЭтаФорма.СтатусДокумента = "ФАКТ"; 
		Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Зеленый;
	Иначе
		ЭтаФорма.СтатусДокумента = "ПРОЕКТ"; 
		Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура СформироватьНомерДокумента()  
	Объект.НомерПКО = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерПКО(Объект.Дата, Объект.Организация, Объект.Ломбард);
	Если Объект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда 
		Объект.ПредставлениеНомераПКО = Строка(Объект.НомерПКО);
	Иначе	
	    Объект.ПредставлениеНомераПКО = СокрЛП(Объект.Ломбард.НомерЛомбарда) + "/" + СокрЛП(Объект.НомерПКО);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоВидуОперации() 
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеСКорпоративнойКарты Тогда
		Элементы.БанковскаяКарта.Видимость = Истина;
	Иначе
		Элементы.БанковскаяКарта.Видимость = Ложь; 	
	КонецЕсли;	 
	
	//Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиУволеннымСотрудником ИЛИ 
	//	 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеУщербаУволеннымСотрудником ИЛИ
	//	 (Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО ИЛИ 
	//	 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПрочиеПриходныеОперацииПоСогласованиюСЦО И НЕ ТипКонтрагентаКлиент(Объект.Контрагент) Тогда
	//	Элементы.ДУЛ.РедактированиеТекста = Истина; 		
	//Иначе
	//	Элементы.ДУЛ.РедактированиеТекста = Ложь; 
	//КонецЕсли;	

	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзКассыДругогоЛомбарда ИЛИ
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзЦентральнойКассы ИЛИ  
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеСКорпоративнойКарты ИЛИ 
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков ИЛИ
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ВозвратОтПодотчетника ИЛИ  
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиСотрудником ИЛИ
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПоступленияОтПокупателейНевостребованныхЗалогов Тогда   
		Элементы.Основание.ТолькоПросмотр = Истина; 
	Иначе  
		Элементы.Основание.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПоступленияОтПокупателейНевостребованныхЗалогов Тогда 
		Элементы.ДополнительнаяИнформация.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзКассыДругогоЛомбарда Или 
		 Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзЦентральнойКассы Тогда
		Элементы.ПринятоОт.ТолькоПросмотр = Ложь; 
	Иначе
		Элементы.ПринятоОт.ТолькоПросмотр = Истина; 
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияПоУмолчанию() 
	Результат = ЛБ_ОбщийМодуль.ЗаполнитьДтКт(Объект.ВидОперации);
	Объект.Дт = Результат.Дт;
    Объект.Кт = Результат.Кт;
	
    Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзЦентральнойКассы Тогда
	   Объект.Контрагент = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;  
	   Элементы.Контрагент.ТолькоПросмотр = Истина;
    ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков ИЛИ
	          Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиСотрудником ИЛИ
			  Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПоступленияОтПокупателейНевостребованныхЗалогов Тогда 			  
       Объект.Контрагент = Объект.Ответственный.ФизическоеЛицо;                                        
	   Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		   Объект.ФизическоеЛицо = Объект.Контрагент;
		   Элементы.Контрагент.ТолькоПросмотр = Истина; 
		   Объект.ПринятоОт = СокрЛП(Объект.Контрагент);
		   Элементы.ПринятоОт.ТолькоПросмотр = Истина; 
       КонецЕсли;	   
    Иначе                                          
	   Элементы.Контрагент.ТолькоПросмотр = Ложь;
    КонецЕсли;
КонецПроцедуры    

&НаСервере
Функция ДокументФизЛица()   
	//+МАН 23.04.25 Приведение наименования к единому написанию. Заявка 2956
	//Было: Информация = "Паспорт РФ";
	Информация = "Паспорт гражданина РФ";
	//-МАН
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.ФизическоеЛицо); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФизическиеЛица.Гражданство КАК Гражданство,
	               |	ФизическиеЛица.СерияДокумента КАК СерияДокумента,
	               |	ФизическиеЛица.НомерДокумента КАК НомерДокумента,
	               |	ФизическиеЛица.КемВыданДокумент КАК КемВыданДокумент,
	               |	ФизическиеЛица.КодПодразделенияДокумента КАК КодПодразделенияДокумента,
	               |	ФизическиеЛица.ДатаВыдачиДокумента КАК ДатаВыдачиДокумента
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК ФизическиеЛица
	               |ГДЕ
	               |	ФизическиеЛица.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда		
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.СерияДокумента), " " + СокрЛП(Выборка.СерияДокумента), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.НомерДокумента), " " + СокрЛП(Выборка.НомерДокумента), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.КемВыданДокумент), " выдан " + СокрЛП(Выборка.КемВыданДокумент), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента), " " + Формат(Выборка.ДатаВыдачиДокумента,"ДФ=dd.MM.yyyy"), "");
		Информация = Информация + ?(ЗначениеЗаполнено(Выборка.КодПодразделенияДокумента), " код подр. " + СокрЛП(Выборка.КодПодразделенияДокумента), "");
	КонецЕсли;     
		
	Возврат Информация;
КонецФункции

&НаСервере
Функция ДокументКлиентаВСтроку(Документ)  
	Если ЗначениеЗаполнено(Документ) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата", ?(НовыйДокумент, ТекущаяДатаСеанса(), Объект.Дата));  
		Запрос.УстановитьПараметр("ДокументЗалогодателя", Документ);
		Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокументаЗалогодателя КАК ВидДокументаЗалогодателя,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ВидДокумента КАК ВидДокумента,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСерия КАК ДокументСерия,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНомер КАК ДокументНомер,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументНачалоДействия КАК ДокументНачалоДействия,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументСрокДействия КАК ДокументСрокДействия,
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Гражданство КАК Гражданство
			               |ИЗ
			               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
			               |			&Дата,
			               |			ДокументЗалогодателя = &ДокументЗалогодателя
			               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ЛБ_ДокументыЗалогодателейСрезПоследних.Период УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Информация = "";
			Информация = СокрЛП(Выборка.ВидДокумента);
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументСерия), " " + СокрЛП(Выборка.ДокументСерия), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументНомер), " " + СокрЛП(Выборка.ДокументНомер), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументКемВыдан), " выдан " + СокрЛП(Выборка.ДокументКемВыдан), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументДатаВыдачи), " " + Формат(Выборка.ДокументДатаВыдачи,"ДФ=dd.MM.yyyy"), "");
			Информация = Информация + ?(ЗначениеЗаполнено(Выборка.ДокументКодПодразделения), " код подр. " + СокрЛП(Выборка.ДокументКодПодразделения), "");
			Возврат Информация;
		КонецЕсли;  
	КонецЕсли;	
	Возврат	"";	
КонецФункции  

&НаСервере
Функция ФИО(Клиент) 
	Если ЗначениеЗаполнено(Клиент) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Клиент", Клиент); 
		Запрос.УстановитьПараметр("Дата", ?(НовыйДокумент, ТекущаяДатаСеанса(), Объект.Дата));
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Фамилия КАК Фамилия,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Имя КАК Имя,
		               |	ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних.Отчество КАК Отчество
		               |ИЗ
		               |	РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_КонтактнаяИнформацияЗалогодателейСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Выборка.Фамилия) + " " + СокрЛП(Выборка.Имя) + ?(НЕ ПустаяСтрока(Выборка.Отчество), " " + СокрЛП(Выборка.Отчество), "");
		КонецЕсли; 
	КонецЕсли;	
	Возврат "";
КонецФункции	

&НаСервере
Функция ПолучитьОсновнойДУЛ(Клиент) 
	Если ЗначениеЗаполнено(Клиент) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Клиент", Клиент); 
		Запрос.УстановитьПараметр("Дата", ?(НовыйДокумент, ТекущаяДатаСеанса(), Объект.Дата));
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ДокументыЗалогодателейСрезПоследних.ДокументЗалогодателя КАК ДокументЗалогодателя
		               |ИЗ
		               |	РегистрСведений.ЛБ_ДокументыЗалогодателей.СрезПоследних(
		               |			&Дата,
		               |			ДокументЗалогодателя.Владелец = &Клиент
		               |				И ОсновнойДУЛ = ИСТИНА) КАК ЛБ_ДокументыЗалогодателейСрезПоследних";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ДокументЗалогодателя;
		КонецЕсли;     
	КонецЕсли;	
	Возврат Справочники.ЛБ_ДокументыЗалогодателя.ПустаяСсылка();
КонецФункции      


&НаСервере
Процедура ЗаполнитьДопРеквизиты()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзЦентральнойКассы Тогда
        Объект.Основание = "Передача денежных средств между операционной и центральной кассами"; 
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "";
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеИзКассыДругогоЛомбарда Тогда  
		НомерЛомбарда = ?(ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.ЛБ_Ломбарды"), СокрЛП(Объект.Контрагент.НомерЛомбарда), "");
        Объект.Основание = "Передача денежных средств из кассы ломбарда № " + НомерЛомбарда + " на ссудно-залоговые операции"; 
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "";   
    ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПолучениеСКорпоративнойКарты Тогда
        Объект.Основание = "Получение наличных в банкомате для выдачи займов"; 
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "Чек № ____ от ________"; 
		Объект.ДополнительнаяИнформация = "Чек № ____ от ________";
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ОприходованиеИзлишков Тогда
        Объект.Основание = "Излишки по результатам пересчета денежных средств";
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "";	 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ВозвратОтПодотчетника Тогда
        Объект.Основание = "Возврат подотчетных средств";
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "";	  	
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ВозвратЗарплатыПоОшибке Тогда
        Объект.Основание = "Возврат ошибочно полученной суммы заработной платы за ________"; 
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "";
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеУщербаСотрудником Тогда
        Объект.Основание = "Погашение ущерба по акту"; 
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = "Возмещение ущерба по соглашению"; 
		Объект.ДополнительнаяИнформация = "Возмещение ущерба по соглашению"; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиСотрудником Тогда
        Объект.Основание = "Погашение недостачи по результатам пересчета денежных средств";
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Приложение = ""; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеУщербаУволеннымСотрудником Тогда
        Объект.Основание = "Погашение ущерба по акту"; 
	    Объект.Приложение = "Возмещение ущерба по соглашению";  
		//+МАН 23.04.25 Замена открытия спр физ. лиц на поиск клиента. Заявка 2956
		//Было: Объект.ДУЛ = ДокументФизЛица();
		Если Объект.Контрагент = Неопределено Тогда
			Объект.ДУЛ = "";
		Иначе
			Объект.ДУЛ = ДокументКлиентаВСтроку(Объект.ДокументКлиента);
		КонецЕсли;
		//-МАН
		Объект.ДополнительнаяИнформация = "Возмещение ущерба по соглашению";
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПогашениеНедостачиУволеннымСотрудником Тогда
        Объект.Основание = "Погашение недостачи по результатам пересчета денежных средств";  
		//+МАН 23.04.25 Замена открытия спр физ. лиц на поиск клиента. Заявка 2956
		//Было: Объект.ДУЛ = ДокументФизЛица();
		Если Объект.Контрагент = Неопределено Тогда
			Объект.ДУЛ = "";
		Иначе
			Объект.ДУЛ = ДокументКлиентаВСтроку(Объект.ДокументКлиента);
		КонецЕсли;
		//-МАН
	    Объект.Приложение = "";  
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПоступленияОтПокупателейНевостребованныхЗалогов Тогда 
		Объект.ПринятоОт = "Покупателей невостребованных залогов с применением ККТ";
		Объект.ДУЛ = ДокументФизЛица();
	    Объект.Основание = "Поступления от покупателей НЗ за " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
		Объект.Приложение = "Отчет о состоянии счетчиков ККТ с гашением, " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy"); 
		Объект.ДополнительнаяИнформация = Объект.Приложение;
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПриходныеОперацииПоСогласованиюСЦО ИЛИ 
		      Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПКО.ПрочиеПриходныеОперацииПоСогласованиюСЦО Тогда  
		Если ТипКонтрагентаКлиент(Объект.Контрагент) Тогда 
			Объект.ПринятоОт = ФИО(Объект.Контрагент);
	        Объект.Основание = ""; 
		    Объект.Приложение = "";
			Объект.ДУЛ = ДокументКлиентаВСтроку(Объект.ДокументКлиента); 
		Иначе	
	        Объект.Основание = ""; 
		    Объект.Приложение = "";
			Объект.ДУЛ = ДокументФизЛица(); 
		КонецЕсли;		
    КонецЕсли;	   
КонецПроцедуры

