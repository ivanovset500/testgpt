&НаСервере
Процедура ЗаполнитьПервоначальныеДанныеПоСотруднику(ТекСтр, табПротоколРаботы) 
	КоличествоДнейвМесяце = День(КонецМесяца(Объект.ПериодРегистрации)); 
	
	Если ЗначениеЗаполнено(ТекСтр.Сотрудник) и ЗначениеЗаполнено(ТекСтр.Ломбард) Тогда  
		
		ДатаУвольнения = ВернутьДатуУвольненияСотрудника(ТекСтр.Сотрудник, Объект.ДатаНачалаПериода, КонецДня(Объект.ДатаОкончанияПериода));
  		
		ВидВремени_Выходной = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;  
		ВидВремени_Увольнение = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение; 	
		
		минутОкр = 0;
		минутФикс = 0;

		ДанныеРабДни = ВернутьДанныеПоРабочимДнямЛомбарда(ТекСтр.День, ТекСтр.Ломбард);
		Если ДанныеРабДни <> Неопределено Тогда	
			НачДня = ДанныеРабДни.Начало;
			КонДня  = ДанныеРабДни.Окончание;
			ПерерывНачало = ДанныеРабДни.ПерерывНачало; 
			ПерерывОкончание = ДанныеРабДни.ПерерывОкончание;  
			
			 
				
			ПД = СтруктураПраздничныхДней(ТекСтр.День); 
			Если ПД <> Неопределено Тогда 
				Если ПД.Выходной = 0 и ЗначениеЗаполнено(ПД.ВремяНачала) Тогда 
					НачДня  = ПД.ВремяНачала;
					КонДня  = ПД.ВремяОкончания; 
					ПерерывНачало = ""; 
					ПерерывОкончание = "";  
				ИначеЕсли ПД.ЧасовСокращено > 0 Тогда
					КонДня = КонДня - ПД.ЧасовСокращено*3600;				
					
				КонецЕсли;				
			КонецЕсли;
					

			
			ОтбСтрок = Новый Структура("Сотрудник, Ломбард, День", ТекСтр.Сотрудник, ТекСтр.Ломбард, ТекСтр.День);
			НайдСтрокиПротокола = табПротоколРаботы.НайтиСтроки(ОтбСтрок);
			
			
			Для каждого стрТЗ из НайдСтрокиПротокола Цикл
				Если ТекСтр.День = стрТЗ.День Тогда
					Если стрТЗ.Действие = Перечисления.ЛБ_ДействияПользователя.Вход Тогда
						ДатаВремяВхода = НачалоДня(стрТЗ.Дата) + (НачДня - НачалоДня(НачДня));  
						Если стрТЗ.Дата < ДатаВремяВхода Тогда
							ДатаОтсчета = ДатаВремяВхода;
						Иначе
							ДатаОтсчета = стрТЗ.Дата;
						КонецЕсли;	
						ДатаОтсчетаФикс = стрТЗ.Дата;
					КонецЕсли;					
					Если стрТЗ.Действие = Перечисления.ЛБ_ДействияПользователя.Выход Тогда
						Если ДатаОтсчета <> Неопределено Тогда
						
						ДатаВремяОкончанияГрафик = НачалоДня(стрТЗ.Дата) + (КонДня - НачалоДня(КонДня)); 
						Если стрТЗ.Дата > ДатаВремяОкончанияГрафик Тогда
							минутОкр = минутОкр + (ДатаВремяОкончанияГрафик - ДатаОтсчета)/60;
						Иначе
							минутОкр = минутОкр + (стрТЗ.Дата - ДатаОтсчета)/60;
						КонецЕсли;
						
						минутФикс = минутФикс + (стрТЗ.Дата - ДатаОтсчетаФикс)/60; 
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ПерерывНачало) и ЗначениеЗаполнено(ПерерывОкончание) Тогда  
				Если минутОкр > 0 Тогда
					минутОкр = минутОкр - (ПерерывОкончание - ПерерывНачало)/60;	
				КонецЕсли;
			КонецЕсли;
			
			ЧасовФикс  = минутОкр/60;  
			
			Если ДанныеРабДни.Выходной Тогда 
				ЧасовФикс = -ЧасовФикс;
			КонецЕсли;
						
			ЧасовРежим = ДанныеРабДни.РабочиеМинуты/60; 
			
			Если ПД <> Неопределено Тогда
				Если ПД.Выходной = 1 и ПД.ЧасовСокращено > 0 тогда
					ЧасовРежим = ЧасовРежим - ПД.ЧасовСокращено; 
				ИначеЕсли ПД.Выходной = 0 и ПД.ЧасовСокращено > 0 тогда
					ЧасовРежим = ЧасовРежим - ПД.ЧасовСокращено; 
				ИначеЕсли ПД.Выходной = 1 и ЗначениеЗаполнено(ПД.ВремяНачала) тогда
					ЧасовРежим 		= (ПД.ВремяОкончания - ПД.ВремяНачала)/3600;
				ИначеЕсли ПД.Выходной = 0 и ЗначениеЗаполнено(ПД.ВремяНачала) тогда
					ЧасовРежим 		= (ПД.ВремяОкончания - ПД.ВремяНачала)/3600;				
				КонецЕсли;				
			КонецЕсли;
						
			НомерДня = СокрЛП(День(ТекСтр.День));  
			
			минут15 = 15;
			
			Если ЧасовФикс > ЧасовРежим Тогда
				ЧасовОкр = ЧасовРежим;
			Иначе       
				РазницаМинут = ДанныеРабДни.РабочиеМинуты - минутОкр;
				Если РазницаМинут < 15 Тогда
					ЧасовОкр = ЧасовРежим;  
					
				Иначе 
					Половинки = РазницаМинут/30;
					ОкрПоловинки = Окр(Половинки,0);
					ОкрПоловинки2 = ОкрПоловинки*2; 
					
					ЧасовОкр = (ДанныеРабДни.РабочиеМинуты - минут15*ОкрПоловинки2)/60;
					
				КонецЕсли;
			КонецЕсли;
			
			ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка;
			
			ТекСтр.ТРежим 		= ЧасовРежим;
			ТекСтр.ТОкр 		= ЧасовОкр;
			ТекСтр.ТТаб 		= ЧасовОкр;
			ТекСтр.ТФикс 		= ЧасовФикс;
			ТекСтр.ВидВремени 	= ВидВремени; 
			ТекСтр.ТОткл        = ЧасовОкр - ЧасовРежим;
			ТекСтр.ВремяПредставление 	= СформироватьПредставлениеВремени(ВидВремени, ЧасовОкр, "");  
		КонецЕсли;
			
		
	КонецЕсли;
КонецПроцедуры





&НаСервере
Функция ЗаполнитьСотрудникамиОрганизацииНаСервере()
	Объект.ДанныеОВремени.Очистить(); 
	тзПротокол.Очистить();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	               |			&НаДату,
	               |			Отделение = &Отделение
	               |				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);

	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка"); 
	
	
	//Сначала заполним НОЛ  
	Запрос2 = Новый Запрос;
	
	Запрос2.Текст = "ВЫБРАТЬ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия КАК ВидСобытия,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.Наименование КАК СотрудникНаименование,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЧисловой КАК НомерЧисловой
	                |ИЗ
	                |	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&НаДату, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	                |ГДЕ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	                |	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия";

	Запрос2.УстановитьПараметр("НаДату", 		Объект.Дата);
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", 	Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	
	
	КоличествоДнейвМесяце = День(КонецМесяца(Объект.ПериодРегистрации)); 
	
	ВидВремени_Выходной = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;  
	ВидВремени_Увольнение = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение; 
	
	
	Если Объект.ПериодВводаДанныхОВремени = Перечисления.ЛБ_ПериодыВводаДанныхОВремениПоловинки.ВтораяПоловинаТекущегоМесяца Тогда
		НачальныйДень = 16;
	Иначе
		НачальныйДень = 1;
	КонецЕсли;

	КоличествоДней = День(Объект.ДатаОкончанияПериода);   
	
	тзПр = Запрос2.Выполнить().Выгрузить();
	тзПр.Сортировать("СотрудникНаименование Возр, НомерЧисловой Возр"); 
	
	Для каждого Выборка из тзПр Цикл		
		Если ЛБ_ОбщегоНазначения.СотрудникЯвляетсяНачальникомОтделенияБезСовмещения(Выборка.Сотрудник, Объект.ДатаНачалаПериода) Тогда
			
			ДатаУвольнения = ВернутьДатуУвольненияСотрудника(Выборка.Сотрудник, Объект.ДатаНачалаПериода, КонецДня(Объект.ДатаОкончанияПериода));
			
			Для номерДня = НачальныйДень по КоличествоДней Цикл  
						
				промДата = Объект.ПериодРегистрации + (номерДня-1)*86400;  
				
				ПД = СтруктураПраздничныхДнейНОЛ(промДата); 
					
				НовСтроч = Объект.ДанныеОВремени.Добавить();
				НовСтроч.Сотрудник = Выборка.Сотрудник;
				НовСтроч.Ломбард   = Выборка.Ломбард; 
				НовСтроч.День      = промДата;
				
				
				Если ПД <> Неопределено Тогда
					Если ПД.Выходной > 0 Тогда 
						НовСтроч.ВидВремени 	= ВидВремени_Выходной; 
						НовСтроч.ВремяПредставление = СформироватьПредставлениеВремени(НовСтроч.ВидВремени, 0, "");
					ИначеЕсли ПД.РабочийДень > 0 Тогда 
						ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка;
						ЧасовРежим =  ПД.РабочийДень;
						НовСтроч.ТРежим 		= ЧасовРежим;
						НовСтроч.ТОкр 			= ЧасовРежим;
						НовСтроч.ТТаб 			= ЧасовРежим;
						НовСтроч.ТФикс 			= 0;
						НовСтроч.ВидВремени 	= ВидВремени; 
						НовСтроч.ТОткл          = 0;
						НовСтроч.ВремяПредставление 	= СформироватьПредставлениеВремени(ВидВремени, ЧасовРежим, "");
						
					КонецЕсли; 						
				Иначе 
					Если ДеньНедели(промДата) < 6 Тогда  
						ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка;
						ЧасовРежим = Выборка.Сотрудник.СтавкаЧас;
						НовСтроч.ТРежим 		= ЧасовРежим;
						НовСтроч.ТОкр 			= ЧасовРежим;
						НовСтроч.ТТаб 			= ЧасовРежим;
						НовСтроч.ТФикс 			= 0;
						НовСтроч.ВидВремени 	= ВидВремени; 
						НовСтроч.ТОткл          = 0;
						НовСтроч.ВремяПредставление 	= СформироватьПредставлениеВремени(ВидВремени, ЧасовРежим, "");
					Иначе  
						НовСтроч.ВидВремени 	= ВидВремени_Выходной; 
						НовСтроч.ВремяПредставление = СформироватьПредставлениеВремени(НовСтроч.ВидВремени, 0, "");
					КонецЕсли;
   
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;         
	
	
	
	
	ЗапросПротокол = Новый Запрос;
	ЗапросПротокол.Текст = "ВЫБРАТЬ
	                       |	ЛБ_ПротоколРаботы.Сотрудник КАК Сотрудник,
	                       |	ЛБ_ПротоколРаботы.Дата КАК Дата,
	                       |	ЛБ_ПротоколРаботы.Дата КАК Время,
	                       |	ЛБ_ПротоколРаботы.Дата КАК ДеньНедели,
	                       |	НАЧАЛОПЕРИОДА(ЛБ_ПротоколРаботы.Дата, ДЕНЬ) КАК День,
	                       |	ЛБ_ПротоколРаботы.Ломбард КАК Ломбард,
	                       |	ЛБ_ПротоколРаботы.Действие КАК Действие,
	                       |	ЛБ_ПротоколРаботы.Ломбард.НомерЧисловой КАК НомерЧисловой,
	                       |	ЛБ_ПротоколРаботы.Сотрудник.Наименование КАК СотрудникНаименование
	                       |ИЗ
	                       |	РегистрСведений.ЛБ_ПротоколРаботы КАК ЛБ_ПротоколРаботы
	                       |ГДЕ
	                       |	ЛБ_ПротоколРаботы.Ломбард В(&массивЛомб)
	                       |	И ЛБ_ПротоколРаботы.Дата МЕЖДУ &НачДата И &КонДата";
	ЗапросПротокол.УстановитьПараметр("массивЛомб", массивЛомб); 
	ЗапросПротокол.УстановитьПараметр("НачДата", Объект.ДатаНачалаПериода);
	ЗапросПротокол.УстановитьПараметр("КонДата", КонецДня(Объект.ДатаОкончанияПериода));   
	
	тз = ЗапросПротокол.Выполнить().Выгрузить();  
	
	
	
	НовТЗ = тз.Скопировать();
	НовТЗ.Очистить();
	
	тзСотр = тз.Скопировать();
	тзСотр.Свернуть("Сотрудник");
	
	тзСотрДни = тз.Скопировать();
	тзСотрДни.Свернуть("Сотрудник, День");
	
	Для каждого СтрокаСотр из тзСотр Цикл 
		отборСотр = Новый Структура;
		отборСотр.Вставить("Сотрудник", СтрокаСотр.Сотрудник);
		
		НайдСтрСотр = тзСотрДни.НайтиСтроки(ОтборСотр);
		Для каждого строкаСотрДни из НайдСтрСотр Цикл
			ОтборДень = Новый Структура;
			ОтборДень.Вставить("Сотрудник", строкаСотрДни.Сотрудник);
			ОтборДень.Вставить("День", строкаСотрДни.День);  
			
			
			НайдСтрочки = тз.НайтиСтроки(ОтборДень);
			
			ПоследнийВыход = ""; 
			первыйВход = Ложь; 
			строкаПоследнегоВыхода = Неопределено;
			
			Для каждого строка из НайдСтрочки Цикл
				Если строка.Действие = Перечисления.ЛБ_ДействияПользователя.Вход И НЕ ПервыйВход Тогда
					НовСтрокаТЗ = НовТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрокаТЗ, Строка);
					ПервыйВход = Истина;
				КонецЕсли;
				Если строка.Действие = Перечисления.ЛБ_ДействияПользователя.Выход Тогда
					строкаПоследнегоВыхода = строка;
				КонецЕсли;
			КонецЦикла; 
			
			Если строкаПоследнегоВыхода <> Неопределено Тогда
				НовСтрокаТЗ = НовТЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаТЗ, строкаПоследнегоВыхода);
			КонецЕсли;	
			
		КонецЦикла;				
	КонецЦикла;		
	НовТЗ.Сортировать("СотрудникНаименование, Время");
	тзПротокол.Загрузить(НовТЗ); 
	

	тзСотрДни = НовТЗ.Скопировать(); 
	тзСотр = НовТЗ.Скопировать(); 
	тзСотр.Свернуть("Сотрудник");  

	тзСотрДни.Свернуть("Сотрудник, Ломбард, НомерЧисловой, День"); 	
	тзСотрДни.Сортировать("Сотрудник, НомерЧисловой, День"); 
	Для каждого стр из тзСотрДни Цикл
		НовСтр = Объект.ДанныеОВремени.Добавить();
		НовСтр.Сотрудник = стр.Сотрудник;
		НовСтр.Ломбард = стр.Ломбард;
        НовСтр.День = стр.День;
		ЗаполнитьПервоначальныеДанныеПоСотруднику(НовСтр, НовТЗ);
	КонецЦикла; 
	
	ВидВремени_Выходной = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;    
	
	Если Объект.ПериодВводаДанныхОВремени = Перечисления.ЛБ_ПериодыВводаДанныхОВремениПоловинки.ВтораяПоловинаТекущегоМесяца Тогда
		НачальныйДень = 16;
	Иначе
		НачальныйДень = 1;
	КонецЕсли;

	КоличествоДней = День(Объект.ДатаОкончанияПериода);  
	Для каждого ТекСтр из тзСотр Цикл  	
		Для номерДня = НачальныйДень по КоличествоДней Цикл 
			промДата = Объект.ПериодРегистрации + (номерДня-1)*86400; 
			
			тзНеявка = НеявкаСотрудника(ТекСтр.Сотрудник, промДата); 
			Если тзНеявка.Количество() > 0 Тогда 			
				Для каждого стр из тзНеявка Цикл 
					НовСтр = Объект.ДанныеОВремени.Добавить();
					НовСтр.Сотрудник = стр.Сотрудник;  
					НовСтр.День = промДата; 		
					НовСтр.ВидВремени = стр.ВидВремени; 
					НовСтр.ВремяПредставление = СформироватьПредставлениеВремени(НовСтр.ВидВремени, 0, "");
				КонецЦикла;	
			КонецЕсли;
			
			ПД = СтруктураПраздничныхДней(промДата); 					
			
			нСтрочки = Объект.ДанныеОВремени.НайтиСтроки(Новый Структура("Сотрудник, День", ТекСтр.Сотрудник, промДата)); 
			
			Если нСтрочки.Количество() = 0 Тогда  
				
				СработалПД = Ложь;
				Если ПД <> Неопределено Тогда
					Если ПД.Выходной = 2 Тогда
						НовСтр = Объект.ДанныеОВремени.Добавить();
						НовСтр.Сотрудник 	= ТекСтр.Сотрудник; 
						НовСтр.День 		= промДата; 		
						НовСтр.ВидВремени 	= ВидВремени_Выходной; 
						НовСтр.ВремяПредставление = СформироватьПредставлениеВремени(НовСтр.ВидВремени, 0, "");
						Если ЗначениеЗаполнено(ПД.ВремяНачала) Тогда 
							НовСтр.ТРежим 		= (ПД.ВремяОкончания - ПД.ВремяНачала)/3600;
							НовСтр.ТОткл 		= -НовСтр.ТРежим; 
						КонецЕсли;
						СработалПД = Истина;
					ИначеЕсли ПД.Выходной = 1 и ЛБ_ОбщегоНазначения.СотрудникЯвляетсяНачальникомОтделенияБезСовмещения( ТекСтр.Сотрудник, промДата) Тогда 
						НовСтр = Объект.ДанныеОВремени.Добавить();
						НовСтр.Сотрудник 	= ТекСтр.Сотрудник; 
						НовСтр.День 		= промДата; 		
						НовСтр.ВидВремени 	= ВидВремени_Выходной; 
						НовСтр.ВремяПредставление = СформироватьПредставлениеВремени(НовСтр.ВидВремени, 0, "");  
						Если ЗначениеЗаполнено(ПД.ВремяНачала) Тогда 
							НовСтр.ТРежим 		= (ПД.ВремяОкончания - ПД.ВремяНачала)/3600;
							НовСтр.ТОткл 		= -НовСтр.ТРежим;   
							СработалВремяНачала = Истина;
						КонецЕсли; 
					КонецЕсли;
				КонецЕсли;
				
				
				Если НЕ СработалПД Тогда
					СтруктураГрафик = ВернутьСтруктуруПоГрафику(ТекСтр.Сотрудник, промДата);
					Если СтруктураГрафик.Часов > 0 Тогда
						НовСтр = Объект.ДанныеОВремени.Добавить();
						НовСтр.Сотрудник 	= ТекСтр.Сотрудник; 
						НовСтр.День 		= промДата; 
						НовСтр.Ломбард      = СтруктураГрафик.Ломбард; 
						
						отбН = Новый Структура;
						отбН.Вставить("Сотрудник", ТекСтр.Сотрудник);
						отбН.Вставить("День", промДата);
						отбН.Вставить("Ломбард", СтруктураГрафик.Ломбард);
						НайденСТрокиН = НовТЗ.НайтиСтроки(отбН); 
						Если НайденСТрокиН.Количество() = 0 Тогда
							НовСтр.ВидВремени 	= ВидВремени_Выходной; 
							НовСтр.ВремяПредставление = СформироватьПредставлениеВремени(НовСтр.ВидВремени, 0, "");
						Иначе
							НовСтр.ТРежим 		= СтруктураГрафик.Часов;
							НовСтр.ТОткл 		= -СтруктураГрафик.Часов;
							НовСтр.ВидВремени 	= ВидВремени_Выходной; 
							НовСтр.ВремяПредставление = СформироватьПредставлениеВремени(НовСтр.ВидВремени, 0, ""); 
						КонецЕсли;
					Иначе
						НовСтр = Объект.ДанныеОВремени.Добавить();
						НовСтр.Сотрудник 	= ТекСтр.Сотрудник; 
						НовСтр.День 		= промДата; 		
						НовСтр.ВидВремени 	= ВидВремени_Выходной; 
						НовСтр.ВремяПредставление = СформироватьПредставлениеВремени(НовСтр.ВидВремени, 0, ""); 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			
				
		КонецЦикла;
	КонецЦикла; 
	
	Объект.ДанныеОВремени.Сортировать("Сотрудник, День, Ломбард");
	
КонецФункции 


Функция СтруктураПраздничныхДней(Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПраздничныеСокращенныеДни.Дата КАК Дата,
	               |	ЛБ_ПраздничныеСокращенныеДни.Выходной КАК Выходной,
	               |	ЛБ_ПраздничныеСокращенныеДни.ВремяНачала КАК ВремяНачала,
	               |	ЛБ_ПраздничныеСокращенныеДни.ВремяОкончания КАК ВремяОкончания,
	               |	ЛБ_ПраздничныеСокращенныеДни.ЧасовСокращено КАК ЧасовСокращено,
	               |	ЛБ_ПраздничныеСокращенныеДни.РабочийДень КАК РабочийДень
	               |ИЗ
	               |	Справочник.ЛБ_ПраздничныеСокращенныеДни КАК ЛБ_ПраздничныеСокращенныеДни
	               |ГДЕ
	               |	ЛБ_ПраздничныеСокращенныеДни.ПометкаУдаления = Ложь
	               |	И ЛБ_ПраздничныеСокращенныеДни.Дата >= &ДатаНач
	               |	И ЛБ_ПраздничныеСокращенныеДни.Дата <= &ДатаКон";
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Дата)); 
	
	Рез = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Новый Структура;
		Рез.Вставить("Дата", 			Выборка.Дата);
		Рез.Вставить("Выходной", 		Выборка.Выходной);
		Рез.Вставить("ВремяНачала", 	Выборка.ВремяНачала);
		Рез.Вставить("ВремяОкончания", 	Выборка.ВремяОкончания);
		Рез.Вставить("ЧасовСокращено", 	Выборка.ЧасовСокращено); 
		Рез.Вставить("РабочийДень", 	Выборка.РабочийДень);
	КонецЕсли; 
	
	Возврат Рез;	
	
КонецФункции

Функция СтруктураПраздничныхДнейНОЛ(Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПраздничныеСокращенныеДни.Дата КАК Дата,
	               |	ЛБ_ПраздничныеСокращенныеДни.Выходной КАК Выходной,
	               |	ЛБ_ПраздничныеСокращенныеДни.РабочийДень КАК РабочийДень
	               |ИЗ
	               |	Справочник.ЛБ_ПраздничныеСокращенныеДни КАК ЛБ_ПраздничныеСокращенныеДни
	               |ГДЕ
	               |	ЛБ_ПраздничныеСокращенныеДни.ПометкаУдаления = ЛОЖЬ
	               |	И ЛБ_ПраздничныеСокращенныеДни.Дата >= &ДатаНач
	               |	И ЛБ_ПраздничныеСокращенныеДни.Дата <= &ДатаКон
	               |	И (ЛБ_ПраздничныеСокращенныеДни.Выходной > 0
	               |	ИЛИ ЛБ_ПраздничныеСокращенныеДни.РабочийДень > 0)";
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Дата)); 
	
	Рез = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Новый Структура;
		Рез.Вставить("Дата", 			Выборка.Дата);
		Рез.Вставить("Выходной", 		Выборка.Выходной);
		Рез.Вставить("РабочийДень", 	Выборка.РабочийДень);
	КонецЕсли; 
	
	Возврат Рез;	
	
