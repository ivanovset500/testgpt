Процедура РасчитатьИтоги()
ТабЧасть           = Объект.ДанныеОВремени; 

ТТабИтог   = 0;
ТРежимИтог = 0;
тФиксИтог  = 0; 
тОкрИтог   = 0;


Для каждого стр из ТабЧасть  цикл
	Если Элементы.ДанныеОВремени.ПроверитьСтроку(стр.ПолучитьИдентификатор()) тогда
		ТТабИтог = ТТабИтог + стр.ТТаб;
		ТРежимИтог = ТРежимИтог + стр.ТРежим;
		тФиксИтог  = тФиксИтог + стр.ТФикс;
		тОкрИтог   = тОкрИтог + стр.ТОкр;
	КонецЕсли;
КонецЦикла;

Элементы.ДанныеОВремениТТаб.ТекстПодвала    = ТТабИтог;
Элементы.ДанныеОВремениТФикс.ТекстПодвала   = тФиксИтог;
Элементы.ДанныеОВремениТОкр.ТекстПодвала    = тОкрИтог;
Элементы.ДанныеОВремениТРежим.ТекстПодвала  = ТРежимИтог;

КонецПроцедуры


