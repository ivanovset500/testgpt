&НаСервере
Процедура УстановитьСтатусДокумента()  
	Элементы.Номер.Доступность = Ложь;

	Если Объект.Контроль Тогда 
		ЭтаФорма.СтатусДокумента = "КОНТРОЛЬ"; 
		Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный;
		Элементы.кнУстановитьСтатусКонтроль.Видимость = Ложь; 
		Элементы.кнУстановитьСтатусФакт.Видимость = Истина;  
		Если Пользователь_ЭтоЛомбард() Тогда 
			Элементы.УстановитьСтатусПроект.Видимость = Ложь; 
			Элементы.ПериодВводаДанныхОВремени.Доступность = Ложь; 
			Элементы.Заполнить.Доступность = Ложь;
            Элементы.МесяцРегистрацииСтрокой.Доступность = Ложь;
            Элементы.Отделение.Доступность = Ложь; 
			Элементы.ДанныеОВремениТФакт.Доступность = Ложь; 

		КонецЕсли;
	Иначе 
		Если Объект.Проведен Тогда
			ЭтаФорма.СтатусДокумента = "ФАКТ"; 
			Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Зеленый;
			Элементы.УстановитьСтатусПроект.Видимость = Истина;
			Элементы.кнУстановитьСтатусФакт.Видимость = Ложь;
			ЭтаФорма.ТолькоПросмотр = Истина;
		Иначе
			ЭтаФорма.СтатусДокумента = "ПРОЕКТ"; 
			Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный; 
			Элементы.УстановитьСтатусПроект.Видимость = Ложь;
			Элементы.кнУстановитьСтатусФакт.Видимость = Истина;
			ЭтаФорма.ТолькоПросмотр = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Пользователь_ЭтоЛомбард() Тогда
		Элементы.кнУстановитьСтатусФакт.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
  
		Объект.ОтветственныйСотрудник    = ПараметрыСеанса.ТекущийСотрудник;
		Объект.ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
		Объект.Организация               = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
		Объект.Дата = ТекущаяДата();    
		Объект.Статус = Перечисления.ЛБ_СтатусыТабеля.Проект;
	Иначе    
		Если ЗначениеЗаполнено(Объект.Отделение) И ЗначениеЗаполнено(Объект.ДатаНачалаПериода) И ЗначениеЗаполнено(Объект.ДатаОкончанияПериода) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
			|ИЗ
			|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
			|			&НаДату,
			|			Отделение = &Отделение
			|				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
			Запрос.УстановитьПараметр("НаДату", Объект.Дата);
			Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
			
			тз = Запрос.Выполнить().Выгрузить(); 
			массивЛомб = тз.ВыгрузитьКолонку("Ссылка"); 
			
			ЗапросПротокол = Новый Запрос;
			ЗапросПротокол.Текст = "ВЫБРАТЬ
			                       |	ЛБ_ПротоколРаботы.Сотрудник КАК Сотрудник,
			                       |	ЛБ_ПротоколРаботы.Дата КАК Дата,
			                       |	ЛБ_ПротоколРаботы.Дата КАК Время,
			                       |	ЛБ_ПротоколРаботы.Дата КАК ДеньНедели,
			                       |	НАЧАЛОПЕРИОДА(ЛБ_ПротоколРаботы.Дата, ДЕНЬ) КАК День,
			                       |	ЛБ_ПротоколРаботы.Ломбард КАК Ломбард,
			                       |	ЛБ_ПротоколРаботы.Действие КАК Действие
			                       |ИЗ
			                       |	РегистрСведений.ЛБ_ПротоколРаботы КАК ЛБ_ПротоколРаботы
			                       |ГДЕ
			                       |	ЛБ_ПротоколРаботы.Ломбард В(&массивЛомб)
			                       |	И ЛБ_ПротоколРаботы.Дата МЕЖДУ &НачДата И &КонДата
			                       |
			                       |УПОРЯДОЧИТЬ ПО
			                       |	Дата,
			                       |	Время";
			ЗапросПротокол.УстановитьПараметр("массивЛомб", массивЛомб); 
			ЗапросПротокол.УстановитьПараметр("НачДата", Объект.ДатаНачалаПериода);
			ЗапросПротокол.УстановитьПараметр("КонДата", КонецДня(Объект.ДатаОкончанияПериода));   
			
			тз = ЗапросПротокол.Выполнить().Выгрузить();  
			
			НовТЗ = тз.Скопировать();
			НовТЗ.Очистить();
			
			тзСотр = тз.Скопировать();
			тзСотр.Свернуть("Сотрудник");
			
			тзСотрДни = тз.Скопировать();
			тзСотрДни.Свернуть("Сотрудник, День");
			
			Для каждого СтрокаСотр из тзСотр Цикл 
				отборСотр = Новый Структура;
				отборСотр.Вставить("Сотрудник", СтрокаСотр.Сотрудник);
				
				НайдСтрСотр = тзСотрДни.НайтиСтроки(ОтборСотр);
				Для каждого строкаСотрДни из НайдСтрСотр Цикл
					ОтборДень = Новый Структура;
					ОтборДень.Вставить("Сотрудник", строкаСотрДни.Сотрудник);
					ОтборДень.Вставить("День", строкаСотрДни.День);  
					
					
					НайдСтрочки = тз.НайтиСтроки(ОтборДень);
					
					ПоследнийВыход = ""; 
					первыйВход = Ложь; 
					строкаПоследнегоВыхода = Неопределено;
					
					Для каждого строка из НайдСтрочки Цикл
						Если строка.Действие = Перечисления.ЛБ_ДействияПользователя.Вход И НЕ ПервыйВход Тогда
							НовСтрокаТЗ = НовТЗ.Добавить();
							ЗаполнитьЗначенияСвойств(НовСтрокаТЗ, Строка);
							ПервыйВход = Истина;
						КонецЕсли;
						Если строка.Действие = Перечисления.ЛБ_ДействияПользователя.Выход Тогда
							строкаПоследнегоВыхода = строка;
						КонецЕсли;
					КонецЦикла; 
					
					Если строкаПоследнегоВыхода <> Неопределено Тогда
						НовСтрокаТЗ = НовТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтрокаТЗ, строкаПоследнегоВыхода);
					КонецЕсли;	
		
				КонецЦикла;				
			КонецЦикла;			
			
			тзПротокол.Загрузить(НовТЗ); 
			
		КонецЕсли;
		
	КонецЕсли;

	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Пользователь_ЭтоЛомбард() Тогда
		Элементы.ДанныеОВремениТТаб.ТолькоПросмотр = Истина;
	КонецЕсли; 
	
	УстановитьСтатусДокумента();
	
КонецПроцедуры

