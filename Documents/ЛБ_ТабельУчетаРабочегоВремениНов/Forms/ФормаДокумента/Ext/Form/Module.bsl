Процедура ПроставитьЯвкуНаСервере()
	ИдентификаторСтроки = ЭтаФорма.Элементы.ДанныеОВремени.ТекущаяСтрока;
	ТекСтр = Объект.ДанныеОВремени.НайтиПоИдентификатору(ИдентификаторСтроки); 
	
	Если ТекСтр.Ттаб = 0 Тогда
		ТекСтр.ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни; 
		ТекСтр.ВремяПредставление = СформироватьПредставлениеВремени(ТекСтр.ВидВремени, 0, "");  
	ИначеЕсли ТекСтр.Ттаб > 0 Тогда        
		ТекСтр.ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка; 
		ТекСтр.ВремяПредставление = СформироватьПредставлениеВремени(ТекСтр.ВидВремени, 0, "");
	КонецЕсли; 	
	
	ТекСтр.ТОткл = ТекСтр.ТТаб - ТекСтр.тРежим;

КонецПроцедуры 

Функция СформироватьМассивОтделений() 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	|ИЗ
	|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	|			,
	|			Ломбард = &Ломбард
	|				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("Ломбард", ПараметрыСеанса.ТекущийЛомбард);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Отделение");
	
КонецФункции

Функция СформироватьМассивСотрудниковОтделения() 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	|ИЗ
	|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	|			&НаДату,
	|			Отделение = &Отделение
	|				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	
	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка");	
	
	
	Запрос2 = Новый Запрос; 
	Запрос2.Текст = "ВЫБРАТЬ
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард,
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия КАК ВидСобытия
	|ИЗ
	|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&НаДату, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	|ГДЕ
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	|	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЛомбарда";
	Запрос2.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	
	
	массив = Новый Массив;
	
	Выборка = Запрос2.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидСобытия = Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение Тогда
			Продолжить;
		КонецЕсли; 
			
		//Если ЛБ_ОбщегоНазначения.СотрудникЯвляетсяНачальникомОтделения(Выборка.Сотрудник, Объект.Дата) Тогда
		//	продолжить;
		//КонецЕсли;

		массив.Добавить(Выборка.Сотрудник);
		
	КонецЦикла; 	
	
	Возврат Массив;
	
КонецФункции

&НаКлиенте
Процедура ОтделениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Если Пользователь_ЭтоЛомбард() Тогда
		
		Элементы.Отделение.РежимВыбораИзСписка = Истина;
		
		Элементы.Отделение.СписокВыбора.Очистить();
		
		массивОтделений = СформироватьМассивОтделений();    
		
		Элементы.Отделение.СписокВыбора.ЗагрузитьЗначения(массивОтделений); 
	Иначе
		Элементы.Отделение.РежимВыбораИзСписка = Ложь;
	КонецЕсли;
КонецПроцедуры

Функция Пользователь_ЭтоЛомбард()
	Возврат ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард;	
КонецФункции

&НаКлиенте
Процедура ОтборСотрудникНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Элемент.РежимВыбораИзСписка = Истина;
	
	//СтандартнаяОбработка = Ложь; 
	
	Элемент.СписокВыбора.Очистить();
	
	массивСотрудников = СформироватьМассивСотрудниковОтделения();    
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(массивСотрудников);

КонецПроцедуры

