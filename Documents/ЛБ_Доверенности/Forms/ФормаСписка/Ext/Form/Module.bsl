
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	Если Параметры.Свойство("Клиент") Тогда 
		Клиент = Параметры.Клиент;
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Клиент");
	    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ЭлементОтбора.Использование = Истина;
	    ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	    ЭлементОтбора.ПравоеЗначение = Клиент;
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " " + Клиент;
	КонецЕсли;
	Если Параметры.Свойство("ЗалоговыйБилет") Тогда 
		ЗалоговыйБилет = Параметры.ЗалоговыйБилет;
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЗалоговыйБилет");
	    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	    ЭлементОтбора.Использование = Истина;
	    ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	    ЭлементОтбора.ПравоеЗначение = ЗалоговыйБилет;   
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " залоговый билет №" + ЗалоговыйБилет.НомерЗалоговогоБилета;
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ПустаяДата", Дата(1,1,1));  
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	Список.Параметры.УстановитьЗначениеПараметра("НеДействует", Перечисления.ЛБ_СтатусыДоверенностей.ДействиеПрекращено); 
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоверенность(Команда)   
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Оформление"), "Оформление доверенности");
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Отзыв"), "Отзыв доверенности доверителем"); 
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Ошибка"), "Отмена доверенности по ошибке");
	
	ВыбЭлемент = ЭтаФорма.ВыбратьИзСписка(СписокВыбора, ЭтаФорма, 0);
	Если НЕ ВыбЭлемент = Неопределено Тогда
		ВидОперации = ВыбЭлемент.Значение;
	
		ПараметрыФормы = Новый Структура; 
		ПараметрыФормы.Вставить("ВидОперации", ВидОперации);
		ПараметрыФормы.Вставить("Клиент", Клиент);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ЗалоговыйБилет);
		ОткрытьФорму("Документ.ЛБ_Доверенности.ФормаОбъекта", ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры


// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
    ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры
&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Элементы.Список);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры


&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
