			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументЛБ_Доверенности.Ссылка КАК Ссылка,
	ДокументЛБ_Доверенности.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЛБ_Доверенности.Номер КАК Номер,
	ДокументЛБ_Доверенности.Дата КАК Дата,
	ДокументЛБ_Доверенности.Проведен КАК Проведен,
	ДокументЛБ_Доверенности.ВидДоверенности КАК ВидДоверенности,
	ДокументЛБ_Доверенности.ЗалоговыйБилет КАК ЗалоговыйБилет,
	ДокументЛБ_Доверенности.Ломбард КАК Ломбард,
	ДокументЛБ_Доверенности.Клиент КАК Клиент,
	ДокументЛБ_Доверенности.ПредставительКлиента КАК ПредставительКлиента,
	ДокументЛБ_Доверенности.НомерДоверенности КАК НомерДоверенности,
	ДокументЛБ_Доверенности.СерияДоверенности КАК СерияДоверенности,
	ДокументЛБ_Доверенности.ДатаДоверенности КАК ДатаДоверенности,
	ДокументЛБ_Доверенности.СрокДействияДоверенности КАК СрокДействияДоверенности,
	ДокументЛБ_Доверенности.Комментарий КАК Комментарий,
	ДокументЛБ_Доверенности.Ответственный КАК Ответственный,
	ДокументЛБ_Доверенности.ВидОперации КАК ВидОперации,
	ДокументЛБ_Доверенности.ОтзываемаяДоверенность КАК ОтзываемаяДоверенность,
	ДокументЛБ_Доверенности.МоментВремени КАК МоментВремени,
	НаличиеФайлов.ЕстьФайлы КАК ЕстьФайлы,
	ВЫБОР
		КОГДА НЕ ДокументЛБ_Доверенности.СрокДействияДоверенности = &amp;ПустаяДата
				И ДокументЛБ_Доверенности.СрокДействияДоверенности &lt; &amp;ТекущаяДата
			ТОГДА &amp;НеДействует
		ИНАЧЕ ЛБ_Доверенности.СтатусДоверенности
	КОНЕЦ КАК СтатусДоверенности,
	ДокументЛБ_Доверенности.МестоВыдачи КАК МестоВыдачи,
	ДокументЛБ_Доверенности.ФИОНотариуса КАК ФИОНотариуса
ИЗ
	Документ.ЛБ_Доверенности КАК ДокументЛБ_Доверенности
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ДокументЛБ_Доверенности.Ссылка = НаличиеФайлов.ОбъектСФайлами
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_Доверенности КАК ЛБ_Доверенности
		ПО ДокументЛБ_Доверенности.Ссылка = ЛБ_Доверенности.Регистратор</QueryText>
				<MainTable>Document.ЛБ_Доверенности</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
