// Сербаев 06.07.2023 Для выведения полного наименования реквизитов ДокументКлиента и ДокументПредставителяКлиента 
// созданы реквизиты формы с типом строка (ДокументКлиентаПолноеНаименование и ДокументПредставителяКлиентаПолноеНаименование).
	  
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Если Параметры.Свойство("ВидОперации") тогда    
			Объект.ВидОперации = Параметры.ВидОперации;
			Элементы.ВидОперации.ТолькоПросмотр = Истина;
		КонецЕсли;	                                                    
		Если Параметры.Свойство("Клиент") тогда
			Объект.Клиент = Параметры.Клиент;  			
		КонецЕсли;	 
		
		//+МАН 23.04.25 Решили, что должен подтягиваться текущий ломбард, в котором доверенность выдается или аннулируется. Заявка 2956
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			Объект.Ломбард = ПараметрыСеанса.ТекущийЛомбард;
		Иначе
			Объект.Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		КонецЕсли;
		//-МАН
		
		Если Параметры.Свойство("ЗалоговыйБилет") тогда
			Объект.ЗалоговыйБилет = Параметры.ЗалоговыйБилет;  
			//+МАН 23.04.25 Решили, что должен подтягиваться текущий ломбард, в котором доверенность выдается или аннулируется. Заявка 2956
			//Было: Объект.Ломбард = Объект.ЗалоговыйБилет.Ломбард;   
			//-МАН
			Объект.ДокументКлиента = Объект.ЗалоговыйБилет.ДокументЗалогодателя;
            // ++ Сербаев 06.07.2023
			ДокументКлиентаПолноеНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЗалоговыйБилет.ДокументЗалогодателя, "НаименованиеПолное");
            // -- Сербаев 06.07.2023
		КонецЕсли; 
		Если Параметры.Свойство("Доверенность") тогда
			Объект.ОтзываемаяДоверенность = Параметры.Доверенность;  
			УстановитьРеквизитыПоДоверенности();
			Элементы.ОтзываемаяДоверенность.ТолькоПросмотр = Истина;
        КонецЕсли;
	КонецЕсли;	
	Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда  		
		Элементы.ЗалоговыйБилет.ТолькоПросмотр = Истина;
	КонецЕсли;  
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		Элементы.Клиент.ТолькоПросмотр = Истина; 
		Если НЕ ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(Объект.Клиент, Объект.Дата) = неопределено Тогда 
			Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство;  
			Элементы.ВидОперации.ТолькоПросмотр = Истина;
		КонецЕсли;	
	КонецЕсли;   
	//Если ЗначениеЗаполнено(Объект.ДокументКлиента) Тогда
	//	Элементы.ДокументКлиента.ТолькоПросмотр = Истина;
	//КонецЕсли;  
	Если Параметры.ТолькоПросмотр = Истина тогда 
		Этаформа.ТолькоПросмотр = Параметры.ТолькоПросмотр;
	КонецЕсли;	

	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда  
		Объект.Дата = ТекущаяДата(); 
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
       		Объект.Ответственный = ТекПользователь;
		Иначе
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		КонецЕсли;	
		Объект.Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
      	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.ПустаяСсылка() Тогда
		    Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление;
		КонецЕсли;	   
		Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление Тогда
			Объект.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.Письменная;
			Объект.ДатаДоверенности = НачалоДня(Объект.Дата);
			Объект.СрокДействияДоверенности = ДобавитьМесяц(Объект.ДатаДоверенности, 13);   
		ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
	        Объект.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.СвидетельствоОСмерти;  
		КонецЕсли;
	КонецЕсли;
	
	УстановитьСостояниеДокумента(); 
	УстановитьДоступностьПоВидуОперации();
	УстановитьДоступность();
	ЛБ_РаботаСДиалогами.УстановитьЗаголовокФормыДокумента(, Объект, ЭтаФорма);   
	//Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление Тогда
	//    ИсторияДоверенности.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	//Иначе
	//	ИсторияДоверенности.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.ОтзываемаяДоверенность.Ссылка);
	//КонецЕсли;	   
	
	Запрос = Новый Запрос;  
	СрокОкончанияДействия = Дата(1,1,1); 
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда
        Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		СрокОкончанияДействия = Объект.СрокДействияДоверенности;
	Иначе
		Запрос.УстановитьПараметр("Ссылка", Объект.ОтзываемаяДоверенность.Ссылка);
	КонецЕсли;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Доверенности.Период КАК Дата,
	               |	ЛБ_Доверенности.СтатусДоверенности КАК Событие,
	               |	ЛБ_Доверенности.Ответственный КАК Ответственный
	               |ИЗ
	               |	РегистрСведений.ЛБ_Доверенности КАК ЛБ_Доверенности
	               |ГДЕ
	               |	ЛБ_Доверенности.Доверенность = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_Доверенности.Период";
	ИсторияДоверенности.Загрузить(Запрос.Выполнить().Выгрузить());
	Если НЕ СрокОкончанияДействия = Дата(1,1,1) И СрокОкончанияДействия < НачалоДня(ТекущаяДата()) Тогда 
		 СтрИ = ИсторияДоверенности.Добавить();
		 СтрИ.Дата = СрокОкончанияДействия;
		 СтрИ.Событие = "Срок действия доверенности окончен";
		 ИсторияДоверенности.Сортировать("Дата");
	КонецЕсли;	
	
	СформироватьЗаголовок();
	
	// Савранин, файлы
	ГиперссылкаФайлов = РаботаСФайлами.ГиперссылкаФайлов();
	ГиперссылкаФайлов.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ГиперссылкаФайлов);
	// Савранин, файлы
	
	// ++ Сербаев 09.06.2023 скрыл команду провести
	Элементы.ФормаКоманднаяПанель.ПодчиненныеЭлементы.ФормаПроведение.Видимость = Ложь;
    // -- Сербаев 09.06.2023       
	ПоказатьСкрытьПечать();  
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьСкрытьПечать()   
	
	Если Объект.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.Нотариальная тогда
		Элементы.ПодменюПечать.Видимость = Ложь; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство тогда
		Элементы.ПодменюПечать.Видимость = Ложь;	
	иначе
		Элементы.ПодменюПечать.Видимость = Истина;   
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаголовок()
	ЭтаФорма.Заголовок = "Доверенность";
	Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) тогда
        ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " к залоговому билету № " + СокрЛП(Объект.ЗалоговыйБилет.НомерЗалоговогоБилета);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ": Новый";
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДоступность()
	Если Объект.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.Письменная Тогда
		Элементы.ДатаДоверенности.ТолькоПросмотр = Истина;
		Элементы.СрокДействияДоверенности.ТолькоПросмотр = Истина;
		Элементы.СерияДоверенности.Видимость = Ложь;  
		Элементы.НомерДоверенности.Видимость = Ложь;
		Элементы.МестоВыдачи.Видимость = Ложь;
		Элементы.ФИОНотариуса.Видимость = Ложь;
	Иначе          
		Элементы.ДатаДоверенности.ТолькоПросмотр = ложь;
		Элементы.СрокДействияДоверенности.ТолькоПросмотр = ложь; 
		Элементы.СерияДоверенности.Видимость = Истина;  
		Элементы.НомерДоверенности.Видимость = Истина;
		Элементы.МестоВыдачи.Видимость = Истина;
		Элементы.ФИОНотариуса.Видимость = Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДоступностьПоВидуОперации()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление Тогда 
		Элементы.ГруппаЗалоговыйБилет.Доступность = Истина; 
		Элементы.ГруппаРеквизиты.Доступность = Истина; 
		Элементы.ГруппаДоверенность.Видимость = Ложь;  		
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Наследство Тогда  
		Элементы.ГруппаЗалоговыйБилет.Доступность = Истина; 
		Элементы.ГруппаРеквизиты.Доступность = Истина; 
		Элементы.ГруппаДоверенность.Видимость = Ложь;  
		Элементы.СрокДействияДоверенности.Доступность = Ложь;
		Элементы.ВидДоверенности.ТолькоПросмотр = Истина;
	Иначе  		
		Элементы.ГруппаЗалоговыйБилет.Доступность = ложь; 
		Элементы.ГруппаРеквизиты.Доступность = ложь;    
		Элементы.ГруппаДоверенность.Видимость = Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры

