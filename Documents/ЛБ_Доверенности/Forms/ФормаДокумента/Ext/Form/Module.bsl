Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ЗалоговыйБилетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка) 
	СтандартнаяОбработка = ложь;
	Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда 
		Сообщить("Не выбран клиент!");
		Возврат;
	КонецЕсли;	  
		
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Залогодатель", Объект.Клиент); 
	ПараметрыОтбора.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Залог"));
	 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЗалоговогоБилета",ЭтаФорма); 
	ОткрытьФорму("Документ.ЛБ_ОперацияПоЗалогу.ФормаВыбора",ПараметрыФормы,ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораЗалоговогоБилета(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;	 
	СтатусЗБ = ЛБ_УправлениеЛомбардом.ПолучитьСтатусЗалоговогоБилета(Объект.Дата, Результат);
	Если СтатусЗБ = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт тогда 
		Сообщить("Выбранный залоговый билет закрыт. Оформление доверенности не возможно.");
		Возврат;
	КонецЕсли;	

	Объект.ЗалоговыйБилет = Результат;  
	Если НЕ ЗначениеЗаполнено(Объект.Ломбард) тогда 
		Объект.Ломбард = Объект.ЗалоговыйБилет.Ломбард;
	КонецЕсли;	
	СформироватьЗаголовок();
КонецПроцедуры

&НаКлиенте
Процедура ВидДоверенностиПриИзменении(Элемент)
	Объект.ДатаДоверенности = Дата(1,1,1); 
	Объект.СрокДействияДоверенности = Дата(1,1,1);  
	Если Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.Письменная") Тогда
		Объект.НомерДоверенности = "";
		Объект.ДатаДоверенности = "";  
		Объект.ДатаДоверенности = НачалоДня(Объект.Дата);
		Объект.СрокДействияДоверенности = ДобавитьМесяц(Объект.ДатаДоверенности, 13);
	КонецЕсли;	
	УстановитьДоступность();
	ПоказатьСкрытьПечать();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)   
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Оформление") Тогда 
		Если Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.Письменная") Тогда 
			Объект.ДатаДоверенности = Объект.Дата;
			Объект.СрокДействияДоверенности = ДобавитьМесяц(Объект.ДатаДоверенности, 13) - 24*60*60;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьКлиентаПоПеречням(Клиент, ДоверенноеЛицо = Ложь)
	РезультатПроверки = Истина; 
	Если ДоверенноеЛицо Тогда 
		НачалоСтроки = "Доверенное лицо найдено ";
	Иначе
		НачалоСтроки = "Доверитель найден ";
	КонецЕсли;	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Залогодатель", Клиент);  
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.ВидПеречня КАК ВидПеречня,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.СтатусКлиентаВПеречне КАК СтатусКлиентаВПеречне,
	               |	ЛБ_КлиентыВПеречняхСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ЛБ_КлиентыВПеречнях.СрезПоследних(
	               |			&Дата,
	               |			Залогодатель = &Залогодатель
	               |				И ВидПеречня = &ВидПеречня) КАК ЛБ_КлиентыВПеречняхСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ"; 
	
	СписокПеречней = Новый СписокЗначений;
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.Террористы);  
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ФРОМУ);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.МВК);
	СписокПеречней.Добавить(Перечисления.ЛБ_ВидыПеречней.ООН);
	
	Для каждого Эл из СписокПеречней Цикл 
		Запрос.УстановитьПараметр("ВидПеречня", Эл.Значение);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда     
			Если Выборка.СтатусКлиентаВПеречне = Перечисления.ЛБ_СтатусыКлиентаВПеречнях.Включен Тогда
				Если Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.Террористы Тогда
					Сообщить(НачалоСтроки + "в перечне террористов. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ФРОМУ Тогда
					Сообщить(НачалоСтроки + "в перечне ФРОМУ. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
		        ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.МВК Тогда
					Сообщить(НачалоСтроки + "в списке МВК. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;
				ИначеЕсли Выборка.ВидПеречня = Перечисления.ЛБ_ВидыПеречней.ООН Тогда
					Сообщить(НачалоСтроки + "в перечне ООН. Операции с клиентом запрещены!", СтатусСообщения.Важное);  
					РезультатПроверки = Ложь;	
				КонецЕсли;	  
			КонецЕсли;
		КонецЕсли;	
	Конеццикла;
	Возврат РезультатПроверки;
КонецФункции	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)    
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Отзыв ИЛИ Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Ошибка Тогда
		Возврат;
	КонецЕсли;	 
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление Тогда
		Если НЕ ПроверитьКлиентаПоПеречням(Объект.Клиент) Тогда 
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;	

	Если ТекущийОбъект.ДатаДоверенности > НачалоДня(ТекущийОбъект.Дата) Тогда 
		Сообщить("Дата выдачи доверенности не может быть больше даты оформления документа доверенности!", СтатусСообщения.Важное);
		Отказ = Истина;	
	КонецЕсли;	  
	Если ТекущийОбъект.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.Письменная И ТекущийОбъект.ДатаДоверенности  < НачалоДня(ТекущийОбъект.ЗалоговыйБилет.Дата) Тогда 
		Сообщить("Дата выдачи письменной доверенности не может быть меньше даты оформления залогового билета!", СтатусСообщения.Важное);
		Отказ = Истина; 
	КонецЕсли;	     
	Если НЕ ТекущийОбъект.СрокДействияДоверенности = Дата(1,1,1) И (ТекущийОбъект.СрокДействияДоверенности < ТекущийОбъект.ДатаДоверенности) Тогда 
		Сообщить("Дата выдачи доверенности не может быть больше даты окончания действия доверенности!", СтатусСообщения.Важное);		
		Отказ = Истина;
	КонецЕсли;	
	Если НЕ ТекущийОбъект.СрокДействияДоверенности = Дата(1,1,1) И (ТекущийОбъект.СрокДействияДоверенности < НачалоДня(ТекущийОбъект.ЗалоговыйБилет.Дата)) Тогда 
		Сообщить("Срок действия доверенности не может быть меньше даты залогового билета!", СтатусСообщения.Важное);		
		Отказ = Истина;
	КонецЕсли;	 

	Если НЕ ПустаяСтрока(ТекущийОбъект.СерияДоверенности) Тогда 
		Если ЛБ_ОбщегоНазначения.ПроверкаВсеСимволыНули(ТекущийОбъект.СерияДоверенности) Тогда
			Сообщить("Серия доверенности не должна содержать только нули.");
            Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекущийОбъект.НомерДоверенности) Тогда 
		Если ЛБ_ОбщегоНазначения.ПроверкаВсеСимволыНули(ТекущийОбъект.НомерДоверенности) Тогда
			Сообщить("Номер доверенности не должен содержать только нули.");
            Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	//проверим пользователь = доверитель или доверенное лицо
	Запрос = Новый Запрос;      
	Сотрудник = ЛБ_ОбщийМодуль.ПолучитьСотрудника(ТекущийОбъект.Ответственный);
	Запрос.УстановитьПараметр("Ответственный", Сотрудник);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.Клиент КАК Клиент
	               |ИЗ
	               |	РегистрСведений.ЛБ_СоответствиеКлиентовИСотрудниковОрганизации КАК ЛБ_СоответствиеКлиентовИСотрудниковОрганизации
	               |ГДЕ
	               |	ЛБ_СоответствиеКлиентовИСотрудниковОрганизации.Сотрудник = &Ответственный";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
	    Отбор = Новый структура;
		Отбор.Вставить("Клиент", объект.Клиент);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
		Если НЕ строки.Количество() = 0 Тогда 
			Сообщить("Сотрудник, оформляющий документ не может быть доверителем!");
            Отказ = Истина;
		Иначе
			Отбор = Новый структура;
			Отбор.Вставить("Клиент", объект.ПредставительКлиента);
			
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если НЕ строки.Количество() = 0 Тогда 
				Сообщить("Сотрудник, оформляющий документ не может быть доверенным лицом!");
	            Отказ = Истина;
            КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	    
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийДоверенность.Оформление Тогда
		//проверим основные документы клиента
		РезультатПроверки = ЛБ_УправлениеЛомбардом.ПроверитьОсновныеДокументыЗалогодателя(Объект.Клиент, Объект.Дата);
		Если НЕ ПустаяСтрока(РезультатПроверки.ОшибкаДУЛ) Тогда
			Сообщить("Проверка основного ДУЛ доверителя: " + РезультатПроверки.ОшибкаДУЛ);
		    Отказ = Истина;
		КонецЕсли; 
		Если НЕ ПустаяСтрока(РезультатПроверки.ОшибкаДоп) Тогда
			Сообщить("Проверка основного документа на право пребывания РФ доверителя: " + РезультатПроверки.ОшибкаДоп);
		    Отказ = Истина;
		КонецЕсли;   
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПроверитьЕстьДатаСмерти(Клиент)
	Возврат ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(Клиент, Объект.Дата);
КонецФункции			

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) 
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Отзыв") ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Ошибка") Тогда
		Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;	
	Если Объект.Клиент = Объект.ПредставительКлиента Тогда 
		Сообщить("Доверитель не может быть одновременно своим доверенным лицом.", СтатусСообщения.Важное);
		Отказ = Истина;
	КонецЕсли;
	// ++ Сербаев 16.06.2023
	ВозрастДоверенногоЛица = ВозрастДоверенногоЛица(Объект.ПредставительКлиента);
	Если Не ВозрастДоверенногоЛица = Неопределено Тогда
		Если (ВозрастДоверенногоЛица < 18) И НЕ (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Наследство")) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Доверенное лицо не может быть моложе 18 лет!'"), , , "Объект.ПредставительКлиента");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	// -- Сербаев 16.06.2023
	Если Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.Нотариальная") Тогда
		Если НЕ ЗначениеЗаполнено(Объект.НомерДоверенности) Тогда
			// ++ Сербаев 13.06.2023
			//Сообщить("Не заполнен номер ноториальной доверенности.", СтатусСообщения.Важное);
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен номер нотариальной доверенности.'"), , , "Объект.НомерДоверенности");
			// -- Сербаев 13.06.2023
			Отказ = Истина; 
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Объект.СрокДействияДоверенности)  Тогда 
			ТекстВопроса = "Будет установлен срок действия доверенности один год. Продолжить?";
            Ответ = Вопрос(ТекстВопроса,РежимДиалогаВопрос.ДаНет,20,КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
            Если Не Ответ=КодВозвратаДиалога.Да Тогда
                Отказ = Истина;  
			Иначе
				 Объект.СрокДействияДоверенности = ДобавитьМесяц(Объект.ДатаДоверенности, 12);
			 КонецЕсли;
		 КонецЕсли;	 
		 // ++ Сербаев 13.06.2023
		 Если ЗначениеЗаполнено(Объект.СрокДействияДоверенности) Тогда
			 Если Объект.СрокДействияДоверенности < НачалоДня(Объект.Дата) Тогда
				 ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Срок окончания действия доверенности не может быть меньше текущей даты.'"), , , "Объект.СрокДействияДоверенности");
				 Отказ = Истина;
			 КонецЕсли;
		 КонецЕсли;
		 // -- Сербаев 13.06.2023  
	 ИначеЕсли Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.СвидетельствоОСмерти") Тогда   
		 Если НЕ ЗначениеЗаполнено(Объект.СерияДоверенности) Тогда
			// ++ Сербаев 13.06.2023
			//Сообщить("Не заполнен номер ноториальной доверенности.", СтатусСообщения.Важное);
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена серия.'"), , , "Объект.СерияДоверенности");
			// -- Сербаев 13.06.2023
			Отказ = Истина;      
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Объект.НомерДоверенности) Тогда
			// ++ Сербаев 13.06.2023
			//Сообщить("Не заполнен номер ноториальной доверенности.", СтатусСообщения.Важное);
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен номер.'"), , , "Объект.НомерДоверенности");
			// -- Сербаев 13.06.2023
			Отказ = Истина;      
		КонецЕсли;		 
	КонецЕсли;	
	Если НЕ Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.Письменная") Тогда
	    Если НЕ ЗначениеЗаполнено(Объект.МестоВыдачи) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено место выдачи нотариальной доверенности.'"), , , "Объект.МестоВыдачи");
			Отказ = Истина; 
		КонецЕсли;	
	    Если НЕ ЗначениеЗаполнено(Объект.ФИОНотариуса) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнены ФИО нотариуса, выдавшего нотариальную доверенность.'"), , , "Объект.ФИОНотариуса");
			Отказ = Истина;
		 КонецЕсли;
     КонецЕсли;
	 Если НЕ Объект.ВидОперации =  ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Наследство") Тогда
	     ДатаСмертиКлиента = ПроверитьЕстьДатаСмерти(Объект.Клиент);
		 Если НЕ ДатаСмертиКлиента = неопределено Тогда 
			Сообщить("Найдено свидетельство о смерти доверителя. Дата смерти " + Формат(ДатаСмертиКлиента, "ДЛФ=DD")); 
			Отказ = Истина;
		 КонецЕсли;	  
	 Иначе
		  ДатаСмертиКлиента = ПроверитьЕстьДатаСмерти(Объект.Клиент);
		  Если Объект.ДатаДоверенности < ДатаСмертиКлиента Тогда  
			  Сообщить("Дата выдачи свидетельства о праве на наследство не может быть меньше даты смерти клиента " + Формат(ДатаСмертиКлиента, "ДЛФ=DD")); 
			  Отказ = Истина;
		  КонецЕсли;	  
	 КонецЕсли;	
	 ДатаСмертиПредставителя = ПроверитьЕстьДатаСмерти(Объект.ПредставительКлиента);
	 Если НЕ ДатаСмертиПредставителя = неопределено Тогда 
		 Сообщить("Найдено свидетельство о смерти доверенного лица. Дата смерти " + Формат(ДатаСмертиПредставителя, "ДЛФ=DD")); 
		 Отказ = Истина;
	 КонецЕсли;	
КонецПроцедуры    

&НаСервере
Процедура ОчиститьРеквизиты()
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Оформление") Тогда
		Объект.ОтзываемаяДоверенность = Документы.ЛБ_Доверенности.ПустаяСсылка();
	Иначе
		Объект.ВидДоверенности = Перечисления.ЛБ_ВидыДоверенностей.ПустаяСсылка();		
		Объект.ЗалоговыйБилет = Документы.ЛБ_ОперацияПоЗалогу.ПустаяСсылка();
		Объект.Клиент = Справочники.ЛБ_Залогодатели.ПустаяСсылка();
		Объект.ПредставительКлиента = Справочники.ЛБ_Залогодатели.ПустаяСсылка();
		Объект.ДатаДоверенности = Дата(1,1,1);
		Объект.НомерДоверенности = "";
		Объект.СерияДоверенности = "";
		Объект.СрокДействияДоверенности = Дата(1,1,1);  
		Объект.Комментарий = ""; 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	УстановитьДоступностьПоВидуОперации();
	ОчиститьРеквизиты();
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитыПоДоверенности()
	Объект.ВидДоверенности              = Объект.ОтзываемаяДоверенность.ВидДоверенности;		
	Объект.ЗалоговыйБилет               = Объект.ОтзываемаяДоверенность.ЗалоговыйБилет; 
	Объект.Клиент                       = Объект.ОтзываемаяДоверенность.Клиент;
	Объект.ДокументКлиента              = Объект.ОтзываемаяДоверенность.ДокументКлиента;
	Объект.ПредставительКлиента         = Объект.ОтзываемаяДоверенность.ПредставительКлиента;
	Объект.ДокументПредставителяКлиента = Объект.ОтзываемаяДоверенность.ДокументПредставителяКлиента;
	// ++ Сербаев 06.07.2023
	ДокументКлиентаПолноеНаименование              = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОтзываемаяДоверенность.ДокументКлиента, "НаименованиеПолное");
	ДокументПредставителяКлиентаПолноеНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОтзываемаяДоверенность.ДокументПредставителяКлиента, "НаименованиеПолное");
    // -- Сербаев 06.07.2023
	Объект.ДатаДоверенности         = Объект.ОтзываемаяДоверенность.ДатаДоверенности;
	Объект.НомерДоверенности        = Объект.ОтзываемаяДоверенность.НомерДоверенности;
	Объект.СерияДоверенности        = Объект.ОтзываемаяДоверенность.СерияДоверенности;
	Объект.СрокДействияДоверенности = Объект.ОтзываемаяДоверенность.СрокДействияДоверенности;  
	Объект.Комментарий              = Объект.ОтзываемаяДоверенность.Комментарий; 
КонецПроцедуры

&НаКлиенте
Процедура ОтзываемаяДоверенностьПриИзменении(Элемент)
	УстановитьРеквизитыПоДоверенности();
КонецПроцедуры

&НаКлиенте
Процедура ОтзываемаяДоверенностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораДоверенности",ЭтаФорма);
		  	
	ПараметрыОтбора = Новый Структура;  
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
	    ПараметрыОтбора.Вставить("Клиент", Объект.Клиент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ЗалоговыйБилет) Тогда 
	    ПараметрыОтбора.Вставить("ЗалоговыйБилет", Объект.ЗалоговыйБилет);
	КонецЕсли;	
	
	Если ПараметрыОтбора.Количество() = 0 Тогда
		ОткрытьФорму("Документ.ЛБ_Доверенности.ФормаВыбора",,ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
		 
