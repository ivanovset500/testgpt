&НаКлиенте
Процедура ПослеВыбораКлиента(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Объект.Клиент = Результат.Залогодатель;  
	Объект.ДокументКлиента = Результат.ДокументЗалогодателя;
	// ++ Сербаев 06.07.2023
	ДокументКлиентаПолноеНаименование = ЗначениеРеквизитаОбъекта(Результат.ДокументЗалогодателя, "НаименованиеПолное");
    // -- Сербаев 06.07.2023   
	Если НЕ ПроверитьЕстьДатаСмерти(Объект.Клиент) = неопределено Тогда 
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Наследство");
		Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.СвидетельствоОСмерти"); 
		Элементы.ВидОперации.ТолькоПросмотр = Истина; 
		УстановитьДоступностьПоВидуОперации(); 
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Наследство") Тогда
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийДоверенность.Оформление");
		Объект.ВидДоверенности = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыДоверенностей.Письменная"); 
		Элементы.ВидОперации.ТолькоПросмотр = ложь; 
		УстановитьДоступностьПоВидуОперации(); 
	КонецЕсли;	
КонецПроцедуры

