	РезультатС = ПолучитьСкидку(); 
	Если РезультатС = неопределено Тогда  
		Предупреждение("Для документа «Установка цены» скидка не установлена", 60);
	Иначе	 
		Для каждого Стр Из ТаблицаТоваров Цикл 
			Если Стр.УчетнаяЦена = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Стр.ОтклонениеСкидки = РезультатС.Отклонение; 
			Стр.Скидка = РезультатС.Скидка;
			Если Стр.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное") Тогда  
				 Стр.ФактическаяЦена = Стр.УчетнаяЦена + Стр.Скидка;        
			ИначеЕсли Стр.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное") Тогда
				 Стр.ФактическаяЦена = Стр.УчетнаяЦена + Стр.УчетнаяЦена*Стр.Скидка/100;
			КонецЕсли;	
		КонецЦикла;	 
		ЗаполнитьИтоги();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура СкидкаОтменить(Команда)
	Для каждого Стр Из ТаблицаТоваров Цикл 		
		Стр.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.ПустаяСсылка"); 
		Стр.Скидка = 0;  
		Стр.ФактическаяЦена = Стр.УчетнаяЦена;
	КонецЦикла;	
	ЗаполнитьИтоги();
КонецПроцедуры


&НаКлиенте
Процедура ПересчитатьФактическуюЦену()
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если НЕ ТекСтрока = неопределено Тогда 
		Если ТекСтрока.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное") Тогда  
			 ТекСтрока.ФактическаяЦена = ТекСтрока.УчетнаяЦена + ТекСтрока.Скидка;        
		ИначеЕсли ТекСтрока.ОтклонениеСкидки = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное") Тогда
			 ТекСтрока.ФактическаяЦена = ТекСтрока.УчетнаяЦена + ТекСтрока.УчетнаяЦена*ТекСтрока.Скидка/100;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровОтклонениеСкидкиПриИзменении(Элемент)
	ПересчитатьФактическуюЦену();
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаТоваровСкидкаПриИзменении(Элемент)
	ПересчитатьФактическуюЦену();
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьТаблицу(Команда)   
	ТаблицаТоваров.Очистить();   
	ЗаполнитьИтоги();
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаТоваровПослеУдаления(Элемент)
	ЗаполнитьИтоги();
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаТоваровПриИзменении(Элемент)
	ЗаполнитьИтоги();
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьСостояниеДокумента(); 
	ЭтаФорма.Заголовок = "Установка цены объектов залога № " + СокрЛП(Объект.ПредставлениеНомера) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЭтаФорма.Заголовок = "Установка цены объектов залога № " + СокрЛП(Объект.ПредставлениеНомера) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
		Если НЕ НачалоДня(ТекущийОбъект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Если НЕ ЭтоСуперпользователь Тогда 
				 Сообщить("Пользователь имеет право проводить документ только текущей датой. Измените дату документа.", статуссообщения.Важное);
			     Отказ = Истина;
				 Возврат;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

