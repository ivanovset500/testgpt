
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;    
	Если УправлениеДоступом.ЕстьРоль("ЛБ_Суперпользователь") Тогда 
		ЭтоСуперпользователь = Истина;
	КонецЕсли;
	Если ТекПользователь.ЭтоЛомбард Тогда
		ОбщегоНазначения.СообщитьПользователю("Документ «Установка цены» доступен только сотрудникам ЦО.");
		Отказ = Истина;  
	ИначеЕсли НЕ УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") И НЕ ЭтоСуперпользователь Тогда 
		ОбщегоНазначения.СообщитьПользователю("Документ «Установка цены» доступен только сотрудникам ЦО.");
		Отказ = Истина; 
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ответственный = ТекПользователь;
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
		Объект.Дата = ТекущаяДатаСеанса(); 
		ЭтаФорма.Заголовок = "Установка цены объектов залога (создание)"; 
		Если Параметры.Свойство("Склад") Тогда
			Объект.Склад = Параметры.Склад;
			Объект.Ломбард = Объект.Склад.Владелец;  
			ПолучитьТоварыПоОстаткам();
		КонецЕсли;	
	Иначе
		ЭтаФорма.Заголовок = "Установка цены объектов залога № " + СокрЛП(Объект.ПредставлениеНомера) + " от " + Формат(Объект.Дата, "ДЛФ=DT"); 
	КонецЕсли;
	УстановитьСостояниеДокумента();    
	ЗаполнитьТаблицуТоваров();                
				
	Если Объект.Проведен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;   
		Элементы.ТаблицаТоваров.ТолькоПросмотр = Истина;
		Элементы.ТаблицаТоваровДобавить.Доступность = Ложь; 
		Элементы.ТаблицаТоваровГруппаСкидки.Доступность = Ложь;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
