// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	//ВалютаРегламентированногоУчета = Справочники.Валюты.НайтиПоКоду("643");
	//
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОтходовДМ") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктОтходовДМ",  "Акт инвентаризации отходов ДМ", 
		ПечатьАктаОтходовДМ(МассивОбъектов, ОбъектыПечати), , "Документ.ЛБ_ИнвентаризацияОтходовДМ.АктОтходовДМ");
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПустойАкт") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПустойАкт",  "Пустой акт инвентаризации отходов ДМ", 
		ПечатьПустойАкт(МассивОбъектов, ОбъектыПечати), , "Документ.ЛБ_ИнвентаризацияОтходовДМ.ПустойАкт");
	КонецЕсли;

КонецПроцедуры  

Функция ПечатьАктаОтходовДМ(МассивОбъектов, ОбъектыПечати)

	УстановитьПривилегированныйРежим(Истина);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
    ТабДокумент.ТолькоПросмотр = Истина;
	
	ПервыйДокумент = Истина;

	Для каждого Док из МассивОбъектов Цикл
		
		Выборка = ПолучитьДанныеДокумента(Док);		
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_ИнвентаризацияОтходовДМ.АктИнвентаризацииОтходов");
		
		Пока Выборка.Следующий() Цикл
			
			//Найдем все данные для последующего заполнения
			Если Не ПервыйДокумент Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			// Запомним номер строки, с которой начали выводить текущий документ.
			НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
			
			ЧленКомиссии = Выборка.ИнвентаризационнаяКомиссия.Выбрать();  
			
			Молы = Выборка.Молы.Выбрать();  
			МолыПодвал = Выборка.Молы.Выбрать();  

			//Приступаем к заполнению			
			ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакетаШапка.Параметры.Заполнить(Выборка);      
			ОбластьМакетаШапка.Параметры.ДатаСоставления = Формат(Выборка.ДатаСоставления, "ДФ=dd.MM.yyyy");
			ОбластьМакетаШапка.Параметры.ДокументОснованиеДата = Формат(Выборка.ДокументОснованиеДата, "ДФ=dd.MM.yyyy");
			ТабДокумент.Вывести(ОбластьМакетаШапка);
			
			ОбластьМакетаШапкаМОЛ = Макет.ПолучитьОбласть("ШапкаМОЛ");
			
			Нпп = 1;
			Пока Молы.Следующий() Цикл
				Если Нпп = 1 Тогда
					ОбластьМакетаШапкаМОЛ.Параметры.МОЛ = "Материально ответственное(ые) лицо(а)";
				Иначе
					ОбластьМакетаШапкаМОЛ.Параметры.МОЛ = "";
				КонецЕсли;
				ОбластьМакетаШапкаМОЛ.Параметры.КассирДолжность = Молы.Физлицо.Должность;
				ОбластьМакетаШапкаМОЛ.Параметры.ФИОКассира = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.ФизическоеЛицо.Наименование);
				ТабДокумент.Вывести(ОбластьМакетаШапкаМОЛ); 
				Нпп = Нпп + 1;
			КонецЦикла;    

			ОбластьМакетаТело = Макет.ПолучитьОбласть("Тело"); 
			//ОбластьМакетаТело.Параметры.Заполнить(Выборка);      
			ОбластьМакетаТело.Параметры.ДатаСоставления = Формат(Выборка.ДатаСоставления, "ДЛФ=DD");
			ОбластьМакетаТело.Параметры.УчБрутто = Формат(Выборка.УчБрутто, "ЧДЦ=2");
			ОбластьМакетаТело.Параметры.УчНетто = Формат(Выборка.УчНетто, "ЧДЦ=2");
			ОбластьМакетаТело.Параметры.ФактБрутто = Формат(Выборка.ФактБрутто, "ЧДЦ=2");
			ОбластьМакетаТело.Параметры.ФактНетто = Формат(Выборка.ФактНетто, "ЧДЦ=2");
			ТабДокумент.Вывести(ОбластьМакетаТело);

			ОбластьМакетаКомиссия = Макет.ПолучитьОбласть("ЧленыКомиссии");
			
			
			Инд = 1;
			Пока ЧленКомиссии.Следующий() Цикл
				Если ЧленКомиссии.Председатель Тогда
					ОбластьМакетаКомиссия.Параметры["ЗаголовокЧленаКомиссии"] = "Председатель комиссии";
					ОбластьМакетаКомиссия.Параметры["Должность"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакетаКомиссия.Параметры["НаименованиеЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.ФизическоеЛицо.Наименование);
					ТабДокумент.Вывести(ОбластьМакетаКомиссия); 
				КонецЕсли;
			КонецЦикла;
			
			инд = 0;
			ЧленКомиссии = Выборка.ИнвентаризационнаяКомиссия.Выбрать();   
			Пока ЧленКомиссии.Следующий() Цикл 
				Если инд < 3 Тогда
					Если НЕ ЧленКомиссии.Председатель Тогда 				
						Если инд = 0 Тогда
							ОбластьМакетаКомиссия.Параметры["ЗаголовокЧленаКомиссии"] = "Члены комиссии";
						Иначе
							ОбластьМакетаКомиссия.Параметры["ЗаголовокЧленаКомиссии"] = "";
						КонецЕсли;
						ОбластьМакетаКомиссия.Параметры["Должность"] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакетаКомиссия.Параметры["НаименованиеЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.ФизическоеЛицо.Наименование);
						ТабДокумент.Вывести(ОбластьМакетаКомиссия);  
						инд = инд + 1;   				
					КонецЕсли; 
				КонецЕсли;
			КонецЦикла;
			
			ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
			ТабДокумент.Вывести(ОбластьМакетаПодвал);
			
			ОбластьМакетаПодвалМОЛ = Макет.ПолучитьОбласть("ПодвалМОЛ");
			
			Нпп = 1;
			Пока МолыПодвал.Следующий() Цикл
				Если Нпп = 1 Тогда
					ОбластьМакетаПодвалМОЛ.Параметры.МОЛ = "Материально ответственное(ые) лицо(а)";
				Иначе
					ОбластьМакетаПодвалМОЛ.Параметры.МОЛ = "";
				КонецЕсли;
				ОбластьМакетаПодвалМОЛ.Параметры.КассирДолжность = МолыПодвал.Физлицо.Должность;
				ОбластьМакетаПодвалМОЛ.Параметры.ФИОКассира = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(МолыПодвал.ФИзлицо.ФизическоеЛицо.Наименование);
				ТабДокумент.Вывести(ОбластьМакетаПодвалМОЛ);
				Нпп = Нпп + 1;
			КонецЦикла;    
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

Функция ПолучитьДанныеДокумента(МассивОбъектов)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
					"ВЫБРАТЬ
					|	ЛБ_ИнвентаризацияОтходовДМ.Ссылка КАК Ссылка,
					|	ЛБ_ИнвентаризацияОтходовДМ.Номер КАК НомерДокумента,
					|	ЛБ_ИнвентаризацияОтходовДМ.Дата КАК ДатаСоставления,
					|	ЛБ_ИнвентаризацияОтходовДМ.НомерПриказа КАК ДокументОснованиеНомер,
					|	ЛБ_ИнвентаризацияОтходовДМ.ДатаПриказа КАК ДокументОснованиеДата,
					|	ЛБ_ИнвентаризацияОтходовДМ.Ответственный КАК Ответственный,
					|	ЛБ_ИнвентаризацияОтходовДМ.Организация КАК Организация,
					|	ЛБ_ИнвентаризацияОтходовДМ.Ломбард КАК Подразделение,
					|	ЛБ_ИнвентаризацияОтходовДМ.ИнвентаризационнаяКомиссия.(
					|		Ссылка КАК Ссылка,
					|		НомерСтроки КАК НомерСтроки,
					|		ФизЛицо КАК ФизЛицо,
					|		Председатель КАК Председатель,
					|		Дистанционно КАК Дистанционно
					|	) КАК ИнвентаризационнаяКомиссия,
					|	ЛБ_ИнвентаризацияОтходовДМ.МОЛы.(
					|		Ссылка КАК Ссылка,
					|		НомерСтроки КАК НомерСтроки,
					|		ФизЛицо КАК ФизЛицо
					|	) КАК МОЛы,
					|	ЛБ_ИнвентаризацияОтходовДМ.УчБрутто КАК УчБрутто,
					|	ЛБ_ИнвентаризацияОтходовДМ.УчНетто КАК УчНетто,
					|	ЛБ_ИнвентаризацияОтходовДМ.ФактБрутто КАК ФактБрутто,
					|	ЛБ_ИнвентаризацияОтходовДМ.ФактНетто КАК ФактНетто
					|ИЗ
					|	Документ.ЛБ_ИнвентаризацияОтходовДМ КАК ЛБ_ИнвентаризацияОтходовДМ
					|ГДЕ
					|	ЛБ_ИнвентаризацияОтходовДМ.Ссылка В(&МассивОбъектов)";

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ПечатьПустойАкт(МассивОбъектов, ОбъектыПечати)

	УстановитьПривилегированныйРежим(Истина);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	
	ПервыйДокумент = Истина;

	Для каждого Док из МассивОбъектов Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_ИнвентаризацияОтходовДМ.АктИнвентаризацииОтходовПустой");
		
		//Найдем все данные для последующего заполнения
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		//Приступаем к заполнению			
		ОбластьМакетаСтр = Макет.ПолучитьОбласть("Страница");
		//ОбластьМакетаСтр1.Параметры.Организация 	= Док.Организация;
		
		Ломбард = МассивОбъектов[0].Ломбард; //ПолучитьЛомбард(Пользователи.ТекущийПользователь());
		
		Если Ломбард <> Неопределено Тогда
			ОбластьМакетаСтр.Параметры.Подразделение = Ломбард;
		Иначе
			//Сообщить("Невыбран ломбард пользователя");
			ОбластьМакетаСтр.Параметры.Подразделение = "Невыбран ломбард пользователя";
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакетаСтр);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, Документы.ЛБ_ИнвентаризацияДС.ПустаяСсылка()); //Док);
		
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

