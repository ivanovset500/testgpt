Перем НовоеЗначение Экспорт;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата = ТекущаяДата();
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
		//Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
		//ЛомбардСсылка = ПолучитьСсылкуЛомбарда();
		//Объект.Должность = Пользователи.ТекущийПользователь().Сотрудник.Должность;
		
		//Если ЗначениеЗаполнено(ЛомбардСсылка) Тогда
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			Объект.Должность = ПараметрыСеанса.ТекущийСотрудник.Должность;
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
			Объект.Ломбард = ПараметрыСеанса.ТекущийЛомбард; //ЛомбардСсылка;
		Иначе
			Объект.Должность = Пользователи.ТекущийПользователь().Сотрудник.Должность;
			Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
			ЛомбардПользователя = РегистрыСведений.ЛБ_ТекущийЛомбардПользователя.Получить(Новый Структура("Пользователь", Пользователи.ТекущийПользователь()));
			Объект.Ломбард = ЛомбардПользователя.Ломбард;
		КонецЕсли;
		
		//+МАН 17.12.25
		ЗаполнитьСклады(Истина);
		//-МАН

		ДобавитьМОЛ();
		
		СтароеЗначение = Объект.Ломбард;
		
		ЗаполнитьУчетныеИфактическиеДанные();
		
		Модифицированность = Истина;
	КонецЕсли;

	Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		СотрудникЦО = Ложь;
	Иначе
		СотрудникЦО = Истина;
	КонецЕсли;
	
	ПроверитьНаличиеПредседателя();
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ТекущаяДатаДокумента = Объект.Дата;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
КонецПроцедуры  
   
&НаКлиенте
Процедура УстановитьВидимость()

	Если Объект.Проведен Тогда
		НеРедактировать = Истина;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
	Иначе
		НеРедактировать = Ложь;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
	КонецЕсли;

	//+МАН 17.12.25
	Если Элементы.Склад.СписокВыбора.Количество() > 1 Тогда
		Элементы.Склад.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Склад.ТолькоПросмотр = Истина;
	КонецЕсли;
	//-МАН
	
	Если СотрудникЦО Тогда
		Элементы.Ломбард.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Ломбард.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

