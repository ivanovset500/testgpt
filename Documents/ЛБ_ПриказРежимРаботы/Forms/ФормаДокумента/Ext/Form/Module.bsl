&НаСервере
Процедура ЗаполнитьИзПредыдущегоНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказРежимРаботы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЛБ_ПриказРежимРаботы КАК ЛБ_ПриказРежимРаботы
	               |ГДЕ
	               |	ЛБ_ПриказРежимРаботы.Отделение = &Отделение
	               |	И ЛБ_ПриказРежимРаботы.Архив = ЛОЖЬ
	               |	И ЛБ_ПриказРежимРаботы.Проведен = ИСТИНА
	               |	И ЛБ_ПриказРежимРаботы.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.РежимРаботы.Очистить();
		Для каждого стр из Выборка.Ссылка.РежимРаботы Цикл
			НовСтр = Объект.РежимРаботы.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, стр);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

