&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение и Объект.ВидПриказа = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПриказаРежимаРаботы.Постоянный") Тогда
		глПараметрыЗаписи = ПараметрыЗаписи;  
		
		
		Рез = ЕстьФактическийПриказ(); 
		
			
		
		Если ОтказатьВПроведении = Неопределено и Рез.Есть Тогда 
			ТекстВопр = "При вступлении в действие настоящего приказа постоянный приказ № "+ СокрЛП(Рез.Номер)+" от "+Формат(Рез.Дата,"ДФ=dd.MM.yy") + " будет переведен в архив";
			ДиалогСВопросом(ТекстВопр);
			Отказ=Истина; 
		Иначе 
			Отказ=ОтказатьВПроведении;
			ОтказатьВПроведении=Неопределено;
		КонецЕсли;
	КонецЕсли;  
КонецПроцедуры
 
&НаКлиенте
Процедура ДиалогСВопросом(ТекстВопр)
    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса",ЭтотОбъект); 
    ПоказатьВопрос(Оповещение,Строка(ТекстВопр),
                    РежимДиалогаВопрос.ДаНет,0,КодВозвратаДиалога.Да,"Продолжить проведение?");    
КонецПроцедуры
 
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ОтказатьВПроведении=Ложь; 
		ПеревестиПредыдущийПриказВАрхив();		
    Иначе
        ОтказатьВПроведении=Истина;
    КонецЕсли; 
    Записать(глПараметрыЗаписи);
КонецПроцедуры  

Процедура ПеревестиПредыдущийПриказВАрхив() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказРежимРаботы.Ссылка КАК Приказ
	               |ИЗ
	               |	Документ.ЛБ_ПриказРежимРаботы КАК ЛБ_ПриказРежимРаботы
	               |ГДЕ
	               |	ЛБ_ПриказРежимРаботы.Отделение = &Отделение
	               |	И ЛБ_ПриказРежимРаботы.Ссылка.Проведен = ИСТИНА
	               |	И ЛБ_ПриказРежимРаботы.Ссылка.Архив = ЛОЖЬ
	               |	И ЛБ_ПриказРежимРаботы.Ссылка <> &ТекПриказ
	               |	И ЛБ_ПриказРежимРаботы.Ссылка.ВидПриказа = &ВидПриказа
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ПриказРежимРаботы.Ссылка,
	               |	ЛБ_ПриказРежимРаботы.Отделение,
	               |	ЛБ_ПриказРежимРаботы.Номер,
	               |	ЛБ_ПриказРежимРаботы.Дата";
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыПриказовРежимРаботы.Архив);
	Запрос.УстановитьПараметр("ВидПриказа", Перечисления.ЛБ_ВидыПриказаРежимаРаботы.Постоянный);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	Запрос.УстановитьПараметр("ТекПриказ", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		Об = Выборка.Приказ.ПолучитьОбъект();
		//Об.Архив = Истина; 
		//Об.Статус = Перечисления.ЛБ_СтатусыПриказовРежимРаботы.Архив; 
		Если Не ЗначениеЗаполнено(Об.ДатаОкончания) Тогда
			Об.ДатаОкончания = НачалоДня(Объект.ДатаНачала) - 86400;
		КонецЕсли;
		Об.Записать();
	КонецЦикла;
	

КонецПроцедуры

