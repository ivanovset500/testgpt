Функция ПроверитьСтатусФактДругиеПриказы()
	тзЛомбарды = Объект.РежимРаботы.Выгрузить(,"Ломбард");
	тзЛомбарды.Свернуть("Ломбард");
	МассивЛомб = тзЛомбарды.ВыгрузитьКолонку("Ломбард");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка КАК Приказ,
	               |	ЛБ_ПриказРежимРаботыРежимРаботы.Ломбард КАК Ломбард
	               |ИЗ
	               |	Документ.ЛБ_ПриказРежимРаботы.РежимРаботы КАК ЛБ_ПриказРежимРаботыРежимРаботы
	               |ГДЕ
	               |	ЛБ_ПриказРежимРаботыРежимРаботы.Ломбард В(&Ломбарды)
				   |    И ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.Проведен = Истина
	               |	И ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.Статус <> &Архивный
	               |	И ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка <> &ТекПриказ
	               |	И ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка.ВидПриказа = &ВидПриказа
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ПриказРежимРаботыРежимРаботы.Ссылка,
	               |	ЛБ_ПриказРежимРаботыРежимРаботы.Ломбард";
	Запрос.УстановитьПараметр("Ломбарды", МассивЛомб);
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыПриказовРежимРаботы.Архив);
	Запрос.УстановитьПараметр("ВидПриказа", Перечисления.ЛБ_ВидыПриказаРежимаРаботы.Постоянный);
	
	Запрос.УстановитьПараметр("ТекПриказ", Объект.Ссылка);
	
	Рез = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез = Истина; 
		//Сообщить("Уже есть приказ со статусом Факт: Приказ № "+СокрЛП(Выборка.Приказ.Номер)+" от "+Формат(Выборка.Приказ.Дата,"ДФ=dd.MM.yy")+", по ломбарду: "+СокрЛП(Выборка.ломбард));
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции


Функция ЕстьФактическийПриказ()
	
	Рез = Новый Структура;
	Рез.Вставить("Есть", Ложь); 
	Рез.Вставить("Дата", "");
    Рез.Вставить("Номер", "");

	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказРежимРаботы.Ссылка КАК Приказ,
	               |	ЛБ_ПриказРежимРаботы.Отделение КАК Отделение,
	               |	ЛБ_ПриказРежимРаботы.Номер КАК Номер,
	               |	ЛБ_ПриказРежимРаботы.Дата КАК Дата
	               |ИЗ
	               |	Документ.ЛБ_ПриказРежимРаботы КАК ЛБ_ПриказРежимРаботы
	               |ГДЕ
	               |	ЛБ_ПриказРежимРаботы.Отделение = &Отделение
	               |	И ЛБ_ПриказРежимРаботы.Ссылка.Проведен = ИСТИНА
	               |	И ЛБ_ПриказРежимРаботы.Ссылка.Архив = ЛОЖЬ
	               |	И ЛБ_ПриказРежимРаботы.Ссылка <> &ТекПриказ
	               |	И ЛБ_ПриказРежимРаботы.Ссылка.ВидПриказа = &ВидПриказа
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_ПриказРежимРаботы.Ссылка,
	               |	ЛБ_ПриказРежимРаботы.Отделение,
	               |	ЛБ_ПриказРежимРаботы.Номер,
	               |	ЛБ_ПриказРежимРаботы.Дата";
	Запрос.УстановитьПараметр("Статус", Перечисления.ЛБ_СтатусыПриказовРежимРаботы.Архив);
	Запрос.УстановитьПараметр("ВидПриказа", Перечисления.ЛБ_ВидыПриказаРежимаРаботы.Постоянный);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	Запрос.УстановитьПараметр("ТекПриказ", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез.Вставить("Есть", Истина); 
		Рез.Вставить("Дата", Выборка.Дата);
    	Рез.Вставить("Номер", Выборка.Номер);

	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

