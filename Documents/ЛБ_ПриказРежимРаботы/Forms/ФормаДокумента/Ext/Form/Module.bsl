
&НаКлиенте
Перем ОтказатьВПроведении;
&НаКлиенте
Перем глПараметрыЗаписи;

Процедура ДобавитьСтрокуДня(День, НомерДня, Ломбард)
	НовСтр = Объект.РежимРаботы.Добавить();
	НовСтр.День     = День;
	НовСтр.НомерДня = НомерДня;
	НовСтр.Ломбард  = Ломбард;
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()  
	Если Объект.Архив Тогда 
		ЭтаФорма.СтатусДокумента = "АРХИВ"; 
		Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный;
	Иначе 
		Если Объект.Проведен Тогда
			ЭтаФорма.СтатусДокумента = "ФАКТ"; 
			Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Зеленый;
		Иначе
			ЭтаФорма.СтатусДокумента = "ПРОЕКТ"; 
			Элементы.СтатусДокумента.ЦветТекста = WebЦвета.Черный;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьДоступностьЭлементов() 
	Если Объект.Архив Или Объект.Проведен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.РежимРаботыДобавитьЛомбард.Доступность = Ложь; 
		Элементы.РежимРаботыУдалитьЛомбард.Доступность = Ложь;
		Элементы.РежимРаботыКнопкаСкопировать.Доступность = Ложь;
		Элементы.РежимРаботыБезПерерываВсеГалочки.Доступность = Ложь;
		Элементы.РежимРаботыБезПерерываСнятьГалочки.Доступность = Ложь; 
		Если НЕ Объект.Архив Тогда
			Элементы.ФормаКнопка2.Доступность = Истина; 
			Элементы.ФормаКнопка1.Доступность = Истина;
		Иначе
			Элементы.ФормаКнопка2.Доступность = Ложь;
			Элементы.ФормаКнопка1.Доступность = Ложь;
		КонецЕсли;  
	Иначе 
		//Элементы.РежимРаботыДобавитьЛомбард.Доступность = Истина; 
		//Элементы.РежимРаботыУдалитьЛомбард.Доступность = Ложь;
		Элементы.РежимРаботыКнопкаСкопировать.Доступность = Истина;
		Элементы.РежимРаботыБезПерерываВсеГалочки.Доступность = Истина;
		Элементы.РежимРаботыБезПерерываСнятьГалочки.Доступность = Истина; 

	КонецЕсли;		
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 

                                                                      
	Директор = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("Директор");
	ПервыйЗаместитель = ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ПервыйЗаместительДиректора");
	
	ДиректорСтр = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СокрЛП(Директор)); 
	ПервыйЗаместительСтр = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СокрЛП(ПервыйЗаместитель));
	
	Элементы.Подписант.СписокВыбора.Добавить(Директор, СокрЛП(ДиректорСтр) + " (Директор)"); 
	Элементы.Подписант.СписокВыбора.Добавить(ПервыйЗаместитель, СокрЛП(ПервыйЗаместительСтр) + " (Первый заместитель)");
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;
		Объект.ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;

		Объект.Дата = ТекущаяДата();
	КонецЕсли; 
	
	
	ЕслиВыходнойВремяНеРедактируем(Элементы.РежимРаботыНачало.Имя);
	ЕслиВыходнойВремяНеРедактируем(Элементы.РежимРаботыОкончание.Имя);
	ЕслиВыходнойВремяНеРедактируем(Элементы.РежимРаботыПерерывНачало.Имя);
	ЕслиВыходнойВремяНеРедактируем(Элементы.РежимРаботыПерерывОкончание.Имя); 
	ЕслиВыходнойВремяНеРедактируем(Элементы.РежимРаботыБезПерерыва.Имя);
	
	ЕслиБезПерерываВремяНеРедактируем(Элементы.РежимРаботыПерерывНачало.Имя);
	ЕслиБезПерерываВремяНеРедактируем(Элементы.РежимРаботыПерерывОкончание.Имя);  
	
	Если Объект.Проведен Тогда  
		Этаформа.ТолькоПросмотр = Истина; 
	КонецЕсли; 
	
	УстановитьСтатусДокумента();
	УстановитьДоступностьЭлементов();
КонецПроцедуры

Процедура ЕслиВыходнойВремяНеРедактируем(Элем) 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элем);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.РежимРаботы.Выходной");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);	
КонецПроцедуры

Процедура ЕслиБезПерерываВремяНеРедактируем(Элем) 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элем);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.РежимРаботы.БезПерерыва");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);	
КонецПроцедуры


&НаКлиенте
Процедура СкопироватьВНиз(Команда) 
	ТекСтр = Элементы.РежимРаботы.ТекущиеДанные; 
	ЗапомниСтр = ТекСтр.НомерСтроки;
	Для каждого стр из Объект.РежимРаботы Цикл 
		Если стр.НомерСтроки > ЗапомниСтр Тогда
			Если стр.Ломбард = ТекСтр.Ломбард Тогда
				
				Если стр.Выходной Тогда
					стр.Начало = "";
					стр.Окончание = ""; 
					стр.ПерерывНачало = "";
					стр.ПерерывОкончание = ""; 
				Иначе 				
					стр.Начало = ТекСтр.Начало;
					стр.Окончание = ТекСтр.Окончание;
					стр.ПерерывНачало = ТекСтр.ПерерывНачало;
					стр.ПерерывОкончание = ТекСтр.ПерерывОкончание; 
					стр.БезПерерыва = ТекСтр.БезПерерыва;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВидПриказаПриИзменении(Элемент)
	УстановитьВидимость();
	Если Объект.ВидПриказа = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПриказаРежимаРаботы.Постоянный") Тогда
		Объект.ДатаОкончания = "";
	КонецЕсли;
	ЗаполнитьЛомбардамиНаСервере();
КонецПроцедуры

&НаКлиенте	
Процедура УстановитьВидимость()  
	Если Объект.ВидПриказа = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПриказаРежимаРаботы.Постоянный") Тогда
		Элементы.ДатаОкончания.Видимость = Ложь;
		Элементы.РежимРаботыДобавитьЛомбард.Видимость = Ложь; 
		Элементы.РежимРаботыУдалитьЛомбард.Видимость = Ложь;   
		Элементы.РежимРаботыЗаполнитьИзПредыдущего.Видимость = Истина;
	Иначе 
		Элементы.ДатаОкончания.Видимость = Истина; 	
		Элементы.РежимРаботыДобавитьЛомбард.Видимость = Истина; 
		Элементы.РежимРаботыУдалитьЛомбард.Видимость = Истина; 
		Элементы.РежимРаботыЗаполнитьИзПредыдущего.Видимость = Ложь;

	КонецЕсли;
	
	Элементы.РежимРаботыПерерывНачало.Видимость = НЕ Объект.БезПерерыва;
	Элементы.РежимРаботыПерерывОкончание.Видимость = НЕ Объект.БезПерерыва;
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ОтделениеПриИзменении(Элемент)
	ЗаполнитьЛомбардамиНаСервере();
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьЛомбардамиНаСервере()  
	Объект.РежимРаботы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
	              |ИЗ
	              |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	              |ГДЕ
	              |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение = &Отделение
	              |	И ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт = ЛОЖЬ
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЧисловой";
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	Выборка = Запрос.Выполнить().Выбрать(); 
	Пока Выборка.Следующий() Цикл	
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Понедельник, 1, Выборка.Ломбард);
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Вторник, 2, Выборка.Ломбард);
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Среда, 3, Выборка.Ломбард);
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Четверг, 4, Выборка.Ломбард);
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Пятница, 5, Выборка.Ломбард);
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Суббота, 6, Выборка.Ломбард);
		ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Воскресенье, 7, Выборка.Ломбард);
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура РежимРаботыВыходнойПриИзменении(Элемент)
	ТекСтр = Элементы.РежимРаботы.ТекущиеДанные;
	Если ТекСтр.Выходной Тогда
		ТекСтр.Начало = "";
		ТекСтр.Окончание = ""; 
		ТекСтр.ПерерывНачало = "";
		ТекСтр.ПерерывОкончание = "";
		ТекСтр.БезПерерыва = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура БезПерерываПриИзменении(Элемент)
	УстановитьВидимость();
КонецПроцедуры


&НаКлиенте
Процедура РежимРаботыЛомбардНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.Отделение) Тогда
		//СтандартнаяОбработка = Ложь;
		Элемент.РежимВыбораИзСписка = Истина;
	
		Элемент.СписокВыбора.Очистить();
	
		массивЛомбардов = СформироватьМассивЛомбардов();    
	
		Элемент.СписокВыбора.ЗагрузитьЗначения(массивЛомбардов);
	КонецЕсли;
КонецПроцедуры


Функция СформироватьМассивЛомбардов()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(, Отделение = &Отделение) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
				   |ГДЕ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт = Ложь";
 
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ломбард");
	
КонецФункции 

Функция СформироватьМассивЛомбардовНетВДокументе()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	               |			,
	               |			Отделение = &Отделение
	               |				И НЕ Ломбард В (&МассивЛомбардов)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	               |ГДЕ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт = ЛОЖЬ";
 
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение); 
	масЛом  = МассивЛомбардовИзДокумента();
	Если масЛом.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("МассивЛомбардов",масЛом);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ Ломбард В (&МассивЛомбардов)","");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ломбард");
	
КонецФункции



&НаКлиенте
Процедура ДобавитьЛомбард(Команда)
	СтандартнаяОбработка = Ложь;

    НастройкиКД = Новый НастройкиКомпоновкиДанных;

    Отбор = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    Отбор.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Ссылка");
    Отбор.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
    Отбор.ПравоеЗначение   = СформироватьМассивЛомбардовНетВДокументе();
    Отбор.Использование    = Истина;
    Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
    // можно прописать не ограниченное количество отборов КД

    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("ФиксированныеНастройки", НастройкиКД);
	ПараметрыФормы.Вставить("ОтображениеТаблицы", ОтображениеТаблицы.Список);
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораЛомбарда", ЭтаФорма);

	ОткрытьФорму("Справочник.ЛБ_Ломбарды.ФормаВыбора",ПараметрыФормы,
	        ЭтаФорма, , , , ОбработкаВыбора);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораЛомбарда(Значение, ДопПараметры) Экспорт 
	Если Значение = Неопределено Тогда  
		Возврат;
	КонецЕсли;
	
	ДобавитьСтрокиЛомбарда(Значение);
	

	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораУдаленияЛомбарда(Значение, ДопПараметры) Экспорт 
	Если Значение = Неопределено Тогда  
		Возврат;
	КонецЕсли;
	
	УдалитьСтрокиЛомбарда(Значение); 

КонецПроцедуры  

Процедура УдалитьСтрокиЛомбарда(Ломб)
	СтруктураОтбора = Новый Структура("Ломбард", Ломб);
	
	МассивСтрок = Объект.РежимРаботы.НайтиСтроки(СтруктураОтбора);
	Для каждого ЭлементМассива Из МассивСтрок Цикл
		Объект.РежимРаботы.Удалить(ЭлементМассива);
	КонецЦикла;
КонецПроцедуры

&НаСервере  
Процедура ДобавитьСтрокиЛомбарда(ВыбЛомбард) 

	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Понедельник, 1, ВыбЛомбард);
	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Вторник, 2, ВыбЛомбард);
	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Среда, 3, ВыбЛомбард);
	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Четверг, 4, ВыбЛомбард);
	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Пятница, 5, ВыбЛомбард);
	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Суббота, 6, ВыбЛомбард);
	ДобавитьСтрокуДня(Перечисления.ЛБ_ДниНедели.Воскресенье, 7, ВыбЛомбард);
	              
    
КонецПроцедуры

