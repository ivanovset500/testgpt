Функция ПечатьПриложенияНаСервере() 
	
		Таб = Новый ТабличныйДокумент;
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_ПриказРежимРаботы.Приложение1"); 
		
		Обл = Макет.ПолучитьОбласть("Шапка");
		Обл.Параметры.Номер = Объект.Номер; 
		Обл.Параметры.Дата  = Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
		Обл.Параметры.ДатаНачала  = Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy");
		Таб.Вывести(Обл); 
		
		тзЛомб = Объект.РежимРаботы.Выгрузить();
		тзЛомб.Свернуть("Ломбард"); 
		
				
		Для каждого стрЛомб из тзЛомб Цикл  
			отбор = Новый Структура("Ломбард", стрЛомб.Ломбард);
			Обл = Макет.ПолучитьОбласть("Строка"); 
			Обл.Параметры.Ломбард = стрЛомб.Ломбард;
			
			НайденныеСтроки = Объект.РежимРаботы.НайтиСтроки(отбор);
			Для каждого стр из НайденныеСтроки Цикл
							
				Обл.Параметры["Начало"+СокрЛП(стр.НомерДня)] = Формат(стр.Начало, "ДФ=ЧЧ:мм"); 
				Обл.Параметры["Окончание"+СокрЛП(стр.НомерДня)] = Формат(стр.Окончание, "ДФ=ЧЧ:мм");
				
				Если стр.БезПерерыва Тогда
					Обл.Параметры["ПерерывНачало"+СокрЛП(стр.НомерДня)] = "Нет"; 
					Обл.Параметры["ПерерывОкончание"+СокрЛП(стр.НомерДня)] = "-";
				Иначе
					Обл.Параметры["ПерерывНачало"+СокрЛП(стр.НомерДня)] = Формат(стр.ПерерывНачало, "ДФ=ЧЧ:мм"); 
					Обл.Параметры["ПерерывОкончание"+СокрЛП(стр.НомерДня)] = Формат(стр.ПерерывОкончание, "ДФ=ЧЧ:мм");  
				КонецЕсли;
				
			КонецЦикла;	
				
			Таб.Вывести(Обл);
		КонецЦикла;  
		
		Таб.ТолькоПросмотр = Истина; 
		Таб.ОтображатьСетку = Ложь; 
		Таб.ОтображатьГруппировки = Ложь;
		Таб.ОтображатьЗаголовки = Ложь;
				
		Возврат Таб;	

	
КонецФункции  
	
	
