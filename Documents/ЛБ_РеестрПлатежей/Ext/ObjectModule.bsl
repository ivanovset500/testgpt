Перем ПроверятьНаличиеПлатежей Экспорт;

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения) 
	Если НЕ ЭтотОбъект.Проведен Тогда 
		ПроверятьНаличиеПлатежей = Истина;
	Иначе    
		ПроверятьНаличиеПлатежей = Ложь;
	КонецЕсли;	     
КонецПроцедуры // ПередЗаписью()

Функция ПроверитьПлатежБН(НомерРеестра, НомерПП, ДатаПлатежа, НомерЗБ)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("НомерРеестра", НомерРеестра);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);  
	Запрос.УстановитьПараметр("НомерПП", НомерПП);
    Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа КАК СтатусПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
	               |			&Дата,
	               |			РеестрПлатежей.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыБезналичныхПлатежей.РасчетыйСчет)
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И ИдентификаторПлатежа = &НомерПП
	               |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда   
		Если Выборка.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;	
    Возврат Истина;
КонецФункции  

Функция ПроверитьПлатежЛК(НомерРеестра, Идентификатор, ДатаПлатежа, НомерЗБ)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("НомерРеестра", НомерРеестра);
	Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);  
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
    Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.СтатусПлатежа КАК СтатусПлатежа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
	               |			&Дата,
	               |			РеестрПлатежей.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыБезналичныхПлатежей.ЛичныйКабинет)
	               |				И ДатаПлатежа = &ДатаПлатежа
	               |				И ИдентификаторПлатежа = &Идентификатор
	               |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда   
		Если Выборка.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;	
    Возврат Истина;
КонецФункции  

