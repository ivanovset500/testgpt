// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)  
	Движения.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.Записывать = Истина;
	Движение = Движения.ЛБ_НастройкиСозданияНакладныхНаОтгрузку.Добавить();
	Движение.Период = Дата;
    Движение.Организация = Организация; 
	Движение.ДеньНедели = ДеньНедели; 
	Если  ДеньНедели = 1 Тогда
		Движение.ДеньНеделиРасшифровка = "понедельник";
	ИначеЕсли  ДеньНедели = 2 Тогда
		Движение.ДеньНеделиРасшифровка = "вторник";
    ИначеЕсли  ДеньНедели = 3 Тогда
		Движение.ДеньНеделиРасшифровка = "среда";
    ИначеЕсли  ДеньНедели = 4 Тогда
		Движение.ДеньНеделиРасшифровка = "черверг";
	ИначеЕсли  ДеньНедели = 5 Тогда
		Движение.ДеньНеделиРасшифровка = "пятница";	
	ИначеЕсли  ДеньНедели = 6 Тогда
		Движение.ДеньНеделиРасшифровка = "суббота";	
	ИначеЕсли  ДеньНедели = 7 Тогда
		Движение.ДеньНеделиРасшифровка = "воскресенье";	
	КонецЕсли;	
	Движение.ЕстьОграничениеОценки = ЕстьОграничениеОценки;	    
	Движение.КоличествоДнейДоступнаОтгрузка = КоличествоДнейДоступнаОтгрузка;
	Движение.ПорядокВыбораДня = ПорядокВыбораДня;
	Если Движение.ПорядокВыбораДня = 0 Тогда
		Движение.ПорядокВыбораРасшифровка = "первый по окончании льготного срока";
	ИначеЕсли Движение.ПорядокВыбораДня = 1 Тогда
		Движение.ПорядокВыбораРасшифровка = "второй по окончании льготного срока";
    ИначеЕсли Движение.ПорядокВыбораДня = 2 Тогда
		Движение.ПорядокВыбораРасшифровка = "третий по окончании льготного срока";
	КонецЕсли;	
	Движение.СообщениеВключениеЗБ = СообщениеВключениеЗБ;
	Движение.СуммаОценки = СуммаОценки;
КонецПроцедуры	

// Процедура - обработчик события "ОбработкаУдаленияПроведения".
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	Если ЛБ_УправлениеЛомбардом.ЕстьНакладныеНаОтгрузу(ЭтотОбъект.Ссылка) Тогда
		ОбщегоНазначения.СообщитьПользователю("По этому документу есть созданные накладные! Отмена проведения документа запрещена.");
		Отказ = Истина;
    КонецЕсли;
КонецПроцедуры   

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения) 
	Если ПометкаУдаления Тогда
        Если ЛБ_УправлениеЛомбардом.ЕстьНакладныеНаОтгрузу(ЭтотОбъект.Ссылка) Тогда
			ОбщегоНазначения.СообщитьПользователю("По этому документу есть созданные накладные! Удаление документа запрещено.");
			Отказ = Истина;
		КонецЕсли; 
	КонецЕсли;	
КонецПроцедуры   
