				Движение.СуммаЗайма = Выборка.СуммаЗайма;
				Движение.СуммаПроцентовДень = Выборка.СуммаПроцентовДень;
		        Движение.СуммаПроцентовСрок = Выборка.СуммаПроцентовСрок;
				Движение.ПредельныйСрокЗайма = Выборка.ПредельныйСрокЗайма;
