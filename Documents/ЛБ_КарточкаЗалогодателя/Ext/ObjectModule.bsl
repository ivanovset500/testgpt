	    Движение.ПричинаИзменения = Стр.ПричинаИзменения;
		Движение.Изменения = Стр.ИзмененияДок;
		Движение.ДатаСмерти = Стр.ДатаСмерти;
		Движение.ОсновнойДУЛ = Стр.ОсновнойДУЛ;  
		Движение.ОсновнойДоп = Стр.ОсновнойДоп;
		
		Если Стр.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОСмерти И ЛБ_ОбщийМодуль.ПроверитьЕстьДатаСмерти(ЭтотОбъект.Залогодатель, ЭтотОбъект.Дата) = неопределено Тогда 			
			Запрос = Новый Запрос;
