			Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.Залогодатель); 			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_ДоверенностиСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
			               |	ЛБ_ДоверенностиСрезПоследних.Доверенность КАК Доверенность,
			               |	ЛБ_ДоверенностиСрезПоследних.Клиент КАК Клиент,
			               |	ЛБ_ДоверенностиСрезПоследних.ВидОперации КАК ВидОперации,
			               |	ЛБ_ДоверенностиСрезПоследних.Ломбард КАК Ломбард,
			               |	ЛБ_ДоверенностиСрезПоследних.Ответственный КАК Ответственный,
			               |	ЛБ_ДоверенностиСрезПоследних.СтатусДоверенности КАК СтатусДоверенности
			               |ИЗ
			               |	РегистрСведений.ЛБ_Доверенности.СрезПоследних(
			               |			&Дата,
			               |			Клиент = &Клиент
			               |				ИЛИ Доверенность.ПредставительКлиента = &Клиент) КАК ЛБ_ДоверенностиСрезПоследних
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ЛБ_ДоверенностиСрезПоследних.Период";  
			Выборка = Запрос.Выполнить().Выбрать(); 
