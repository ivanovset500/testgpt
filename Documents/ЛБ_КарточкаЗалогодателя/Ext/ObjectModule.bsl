				ВыборкаОЗ = ЗапросОЗ.Выполнить().Выбрать();
				Пока ВыборкаОЗ.Следующий() Цикл 
					Если НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Принят И
						 НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Продлен И   
						 НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную И
						 НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг И
						 НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение Тогда
						Продолжить;
					КонецЕсли;	
					Движения.ЛБ_СостояниеОбъектаЗалога.Записывать = Истина; 
					ДвижениеО = Движения.ЛБ_СостояниеОбъектаЗалога.Добавить();
	                ДвижениеО.Период = Дата;
                    ДвижениеО.ЗалоговыйБилет = Выборка.ЗалоговыйБилет;
					ДвижениеО.ОбъектЗалога = ВыборкаОЗ.ОбъектЗалога;
					ДвижениеО.СуммаОценки = ВыборкаОЗ.СуммаОценки; 
					ДвижениеО.СуммаОценкиНачальная = ВыборкаОЗ.СуммаОценкиНач; 
					ДвижениеО.СуммаЗайма = ВыборкаОЗ.СуммаЗайма;
					ДвижениеО.СуммаОплаты = ВыборкаОЗ.СуммаОплаты;
					ДвижениеО.СуммаДолгаЗайма = ВыборкаОЗ.СуммаДолгаЗайма;
					ДвижениеО.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Наследство;  					
				Конеццикла;	
				
				Если Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ВключенВНакладную ИЛИ
					 Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОбъявленТорг Тогда
					УдалитьИзделияИзНакладнойНаОтгузку(Выборка.ЗалоговыйБилет); 
				КонецЕсли;	 

            КонецЦикла;
		КонецЕсли;	
	Конеццикла;	   

	Если НЕ ЭтотОбъект.ДополнительныеСтатусы.Количество() = 0 Тогда  
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Статус КАК Статус,
		               |	ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних.Используется КАК Используется
		               |ИЗ
		               |	РегистрСведений.ЛБ_СтатусыЗалогодателейДополнительные.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_СтатусыЗалогодателейДополнительныеСрезПоследних";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		Движения.ЛБ_СтатусыЗалогодателейДополнительные.Записывать = Истина;				
		Для каждого Стр Из ЭтотОбъект.ДополнительныеСтатусы Цикл 
			Отбор = Новый Структура;
			Отбор.Вставить("Статус", Стр.Статус);  
			СтрокиС = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если НЕ СтрокиС.Количество() = 0 Тогда  
				СтрС = СтрокиС.Получить(0);
				Если Стр.Используется = СтрС.Используется Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;
			Движение = Движения.ЛБ_СтатусыЗалогодателейДополнительные.Добавить();
			Движение.Период = Дата; 
			Движение.Залогодатель = ЭтотОбъект.Залогодатель;
			Движение.Статус = Стр.Статус;
			Движение.Используется = Стр.Используется;
			Движение.СрокДействия = Стр.СрокДействия; 
			Движение.Комментарий = Стр.Комментарий;
		Конеццикла;
				
	КонецЕсли;  
	
	Если НЕ ЭтотОбъект.СлужебныеСтатусы.Количество() = 0 Тогда 
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("Залогодатель", Залогодатель);  
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Статус КАК Статус,
		               |	ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних.Используется КАК Используется
		               |ИЗ
		               |	РегистрСведений.ЛБ_СтатусыЗалогодателейСлужебные.СрезПоследних(&Дата, Залогодатель = &Залогодатель) КАК ЛБ_СтатусыЗалогодателейСлужебныеСрезПоследних";
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
		Движения.ЛБ_СтатусыЗалогодателейСлужебные.Записывать = Истина;
		Для каждого Стр Из ЭтотОбъект.СлужебныеСтатусы Цикл  
			Отбор = Новый Структура;
			Отбор.Вставить("Статус", Стр.Статус);  
			СтрокиС = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если НЕ СтрокиС.Количество() = 0 Тогда  
				СтрС = СтрокиС.Получить(0);
				Если Стр.Используется = СтрС.Используется Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;
			Движение = Движения.ЛБ_СтатусыЗалогодателейСлужебные.Добавить();
			Движение.Период = Дата; 
			Движение.Залогодатель = ЭтотОбъект.Залогодатель;
			Движение.Статус = Стр.Статус;
			Движение.Используется = Стр.Используется; 
			Движение.Комментарий = Стр.Комментарий;
		Конеццикла;	
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.СогласиеНаСМСРассылку = ЛБ_УправлениеЛомбардом.ПолучитьСогласиеНаСМСРассылки(ЭтотОбъект.Дата, ЭтотОбъект.Залогодатель) Тогда  
		Движения.ЛБ_СогласиеНаСМСРассылку.Записывать = Истина;
		Движение = Движения.ЛБ_СогласиеНаСМСРассылку.Добавить();
		Движение.Период = Дата; 
		Движение.Залогодатель = ЭтотОбъект.Залогодатель;
	    Движение.Согласен = ЭтотОбъект.СогласиеНаСМСРассылку;  
	КонецЕсли;	
	
	//+Мельников 02.07.24 Статус клиента "Банкрот"
	
	Отбор = Новый Структура;
	Отбор.Вставить("Статус", ПолучитьСсылкуНаСтатус()); //Справочники.ЛБ_СлужебныеСтатусыКлиентов.НайтиПоКоду("000000003"));
	Отбор.Вставить("Используется", Истина);
	
	мБанкрот = ЭтотОбъект.СлужебныеСтатусы.НайтиСтроки(Отбор);
	
	Если мБанкрот.Количество() > 0 Тогда 			
	
		ЗапросОЗ = Новый Запрос; 
		ЗапросОЗ.Текст = "ВЫБРАТЬ
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОплаты КАК СуммаОплаты,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаДолгаЗайма КАК СуммаДолгаЗайма,
						|	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОценкиНачальная КАК СуммаОценкиНач
						|ИЗ
						|	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних";
		ЗапросОЗ.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
		
		Запрос.Текст = "ВЫБРАТЬ
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерЗалоговогоБилета КАК НомерЗалоговогоБилета,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СхемаКредитования КАК СхемаКредитования,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПричинаПрименения КАК ПричинаПрименения,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СтатусЗалоговогоБилета КАК СтатусЗалоговогоБилета,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаНачалаРасчетаПроцентов КАК ДатаНачалаРасчетаПроцентов,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.НомерДопСоглашения КАК НомерДопСоглашения,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупа КАК ДатаВыкупа,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ДатаВыкупаЛьготныйСрок КАК ДатаВыкупаЛьготныйСрок,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовДень КАК СуммаПроцентовДень,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.СуммаПроцентовСрок КАК СуммаПроцентовСрок,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗайма КАК ПредельныйСрокЗайма,
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.ПредельныйСрокЗаймаДни КАК ПредельныйСрокЗаймаДни
						|ИЗ
						|	РегистрСведений.ЛБ_СостояниеЗалоговогоБилета.СрезПоследних(&Дата, Залогодатель = &Клиент) КАК ЛБ_СостояниеЗалоговогоБилетаСрезПоследних
						|
						|УПОРЯДОЧИТЬ ПО
						|	ЛБ_СостояниеЗалоговогоБилетаСрезПоследних.Период";

		Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
		Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.Залогодатель); 			

		Выборка = Запрос.Выполнить().Выбрать(); 
		Пока Выборка.Следующий() Цикл   
			Если Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Закрыт ИЛИ
				Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Отгружен ИЛИ
				Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.ОтказОтОформления ИЛИ
				Выборка.СтатусЗалоговогоБилета = Перечисления.ЛБ_СтатусыЗалоговыхБилетов.Реализован Тогда 
				Продолжить;
			КонецЕсли;	    
			
			ЗапросОЗ.УстановитьПараметр("ЗалоговыйБилет", Выборка.ЗалоговыйБилет);
			ВыборкаОЗ = ЗапросОЗ.Выполнить().Выбрать();
			Пока ВыборкаОЗ.Следующий() Цикл 
				Если НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Принят И
					НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Продлен И   
					НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную И
					НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг И
					НЕ ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение Тогда
					Продолжить;
				КонецЕсли;	
				Движения.ЛБ_СостояниеОбъектаЗалога.Записывать = Истина; 
				ДвижениеО = Движения.ЛБ_СостояниеОбъектаЗалога.Добавить();
				ДвижениеО.Период = Дата;
				ДвижениеО.ЗалоговыйБилет = Выборка.ЗалоговыйБилет;
				ДвижениеО.ОбъектЗалога = ВыборкаОЗ.ОбъектЗалога;
				ДвижениеО.СуммаОценки = ВыборкаОЗ.СуммаОценки; 
				ДвижениеО.СуммаОценкиНачальная = ВыборкаОЗ.СуммаОценкиНач; 
				ДвижениеО.СуммаЗайма = ВыборкаОЗ.СуммаЗайма;
				ДвижениеО.СуммаОплаты = ВыборкаОЗ.СуммаОплаты;
				ДвижениеО.СуммаДолгаЗайма = ВыборкаОЗ.СуммаДолгаЗайма;
				ДвижениеО.СтатусОбъектаЗалога = ПолучитьСтатусОЗ(Дата, ВыборкаОЗ.ОбъектЗалога, Выборка.ЗалоговыйБилет);  
				
				Если ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную ИЛИ
					ВыборкаОЗ.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг Тогда
					УдалитьИзделияИзНакладнойНаОтгузку(Выборка.ЗалоговыйБилет); 
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	//-Мельников		

	Движения.ЛБ_ДатыОбновленияАнкеты.Записывать = Истина;  
	Движение = Движения.ЛБ_ДатыОбновленияАнкеты.Добавить();
	Движение.Период = Дата;          
	Движение.Залогодатель = Залогодатель;
    Движение.ДатаАктуальности = Дата;
		
КонецПроцедуры

