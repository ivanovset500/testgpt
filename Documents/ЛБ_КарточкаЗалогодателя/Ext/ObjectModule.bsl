  
Процедура УдалитьИзделияИзНакладнойНаОтгузку(ЗалоговыйБилет)  
	Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Записывать = Истина;
	Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Записывать = Истина; 
    Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата); 
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Организация КАК Организация,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Ломбард КАК Ломбард,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.КоличествоОстаток КАК Количество,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ВесОстаток КАК Вес,
	               |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.СуммаОценкиОстаток КАК СуммаОценки
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Остатки(&Дата, ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Если ТаблицаЗапроса.Количество() = 0 Тогда		
	    Накладная = Документы.ЛБ_НакладнаяНаОтгрузку.ПустаяСсылка(); 
	Иначе  
		Накладная = ТаблицаЗапроса.Получить(0).НакладнаяНаОтгрузку; 
		Запрос.УстановитьПараметр("Накладная", Накладная);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус
		               |ИЗ
		               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних";
		ТаблицаСтатусовВНакладной = Запрос.Выполнить().Выгрузить();	
	КонецЕсли;
	
	Для каждого СтрЗапроса Из ТаблицаЗапроса Цикл  		
		Движение = Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Добавить();
		Движение.Период = Дата;
		Движение.Организация = СтрЗапроса.Организация; 
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Ломбард = СтрЗапроса.Ломбард;
		Движение.НакладнаяНаОтгрузку = СтрЗапроса.НакладнаяНаОтгрузку;
		Движение.ЗалоговыйБилет = СтрЗапроса.ЗалоговыйБилет;
		Движение.ОбъектЗалога = СтрЗапроса.ОбъектЗалога;
		Движение.Количество = СтрЗапроса.Количество;  
		Движение.Вес = СтрЗапроса.Вес; 
		Движение.СуммаОценки = СтрЗапроса.СуммаОценки; 
		
		Движение = Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Добавить();
		Движение.Период = Дата;
		Движение.ЗалоговыйБилет = СтрЗапроса.ЗалоговыйБилет; 
        Движение.НакладнаяНаОтгрузку = СтрЗапроса.НакладнаяНаОтгрузку;
		Движение.ОбъектЗалога = СтрЗапроса.ОбъектЗалога;
		Движение.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной;   
		
		Отбор = Новый Структура;
		Отбор.Вставить("НакладнаяНаОтгрузку", СтрЗапроса.НакладнаяНаОтгрузку); 
		Отбор.Вставить("ЗалоговыйБилет", СтрЗапроса.ЗалоговыйБилет);
        Отбор.Вставить("ОбъектЗалога", СтрЗапроса.ОбъектЗалога);

        Строки = ТаблицаСтатусовВНакладной.НайтиСтроки(Отбор);
		Если НЕ Строки.Количество() = 0 Тогда 
			Стр = строки.Получить(0);
			Стр.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной;
		КонецЕсли;	
	КонецЦикла;	 
	
	Если НЕ Накладная.Пустая() Тогда 
		ВсеИсключенные = Истина; 
		Для каждого СтрС Из ТаблицаСтатусовВНакладной Цикл  
			Если НЕ СтрС.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной Тогда 
				ВсеИсключенные = Ложь;
				Продолжить;
			КонецЕсли;	   
		КонецЦикла;
		
		Если ВсеИсключенные Тогда
			ЗапросН = Новый Запрос; 
			ЗапросН.УстановитьПараметр("Дата", ЭтотОбъект.Дата); 
			ЗапросН.УстановитьПараметр("НакладнаяНаОтгрузку", Накладная);
			ЗапросН.Текст = "ВЫБРАТЬ
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НомерНакладной КАК НомерНакладной,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ДатаНакладной КАК ДатаНакладной,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ОтказОтВыкупа КАК ОтказОтВыкупа,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ПовышеннаяОценка КАК ПовышеннаяОценка,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.СтатусНакладной КАК СтатусНакладной,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Получатель КАК Получатель,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Инкассатор КАК Инкассатор,
			                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Комментарий КАК Комментарий
			                |ИЗ
			                |	РегистрСведений.ЛБ_СтатусыНакладнойНаОтгрузку.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку) КАК ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних";
		    ВыборкаН = ЗапросН.Выполнить().Выбрать();
			Если ВыборкаН.Следующий() Тогда
				Движение = Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Добавить(); 
				Движение.Период = Дата;
				Движение.НакладнаяНаОтгрузку = ВыборкаН.НакладнаяНаОтгрузку; 
				Движение.НомерНакладной = ВыборкаН.НомерНакладной;
				Движение.ДатаНакладной = ВыборкаН.ДатаНакладной;
				Движение.ОтказОтВыкупа = ВыборкаН.ОтказОтВыкупа;
				Движение.ПовышеннаяОценка = ВыборкаН.ПовышеннаяОценка;
				Движение.СтатусНакладной = ВыборкаН.СтатусНакладной;
				Движение.Комментарий = ВыборкаН.Комментарий; 				
				//+МАН 03.04.26 Исправил. Заявка 3759
				//Движение.ОтветственныйСотрудник = ЭтотОбъект.ОтветственныйСотрудник; 
				Движение.ОтветственныйСотрудник = ЭтотОбъект.Ответственный; 
				//-МАН
				Движение.ОтветственныйПользователь = ЭтотОбъект.ОтветственныйПользователь;
				Движение.Пустой = Истина;
			КонецЕсли;		
		КонецЕсли;	

	КонецЕсли;	
КонецПроцедуры	

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ПрисвоитьНовыйСтатус = Ложь;
	Если ЭтотОбъект.ПричинаИзменения = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.НоваяКарточка Тогда
		ПрисвоитьНовыйСтатус = Истина;
	ИначеЕсли ЭтотОбъект.ПричинаИзменения = Справочники.ЛБ_ПричиныИзмененияКарточкиЗалогодателя.ЗагрузкаИзДругойБазы Тогда
		ТекСтатусКлиента = ЛБ_УправлениеЛомбардом.ПолучитьТекущийСтатусКлиента(Дата, Залогодатель);
		Если НЕ ЗначениеЗаполнено(ТекСтатусКлиента) Тогда   
			ПрисвоитьНовыйСтатус = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Если ПрисвоитьНовыйСтатус тогда
		Движения.ЛБ_СтатусыЗалогодателей.Записывать = Истина; 
		Движение = Движения.ЛБ_СтатусыЗалогодателей.Добавить();
		Движение.Период = Дата;
		Движение.Залогодатель = Залогодатель;
	    Движение.Статус = Справочники.ЛБ_СтатусыЗалогодателей.Сверхновый; 
	КонецЕсли;	

	
	// регистр ЛБ_КонтактнаяИнформацияЗалогодателей
	Если НЕ ПустаяСтрока(ЭтотОбъект.ИзмененияКИ) Тогда
		Движения.ЛБ_КонтактнаяИнформацияЗалогодателей.Записывать = Истина;
		
		//Блокировка = Новый БлокировкаДанных;
		//ЭлементБлокировки = Блокировка.Добавить();
		//ЭлементБлокировки.Область = "РегистрСведений.ЛБ_КонтактнаяИнформацияЗалогодателей";
		//ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		//ЭлементБлокировки.УстановитьЗначение("Залогодатель", Залогодатель);
		//Блокировка.Заблокировать();

		Движение = Движения.ЛБ_КонтактнаяИнформацияЗалогодателей.Добавить();
		Движение.Период = Дата;
		Движение.Залогодатель = Залогодатель;
		Движение.Фамилия = Фамилия;
		Движение.Имя = Имя;
		Движение.Отчество = Отчество;
		Движение.ДатаРождения = ДатаРождения;
		Движение.МестоРождения = МестоРождения;
		Движение.МестоРожденияСтрана = МестоРожденияСтрана;
		Движение.МестоРожденияОбласть = МестоРожденияОбласть;
		Движение.МестоРожденияРайон = МестоРожденияРайон;
		Движение.МестоРожденияНаселенныйПункт = МестоРожденияНаселенныйПункт;
		Движение.Гражданство = Гражданство;
		Движение.Пол = Пол;
		Движение.Телефон = Телефон;
		Движение.ТелефонСтруктура = ТелефонСтруктура;
		Движение.Email = Email;
		Движение.АдресПоПрописке = АдресПоПрописке;
		Движение.АдресПоПропискеСтруктура = АдресПоПропискеСтруктура;
		Движение.АдресПоПропискеВручную = АдресПоПропискеВручную;
		Движение.ФактическийАдрес = ФактическийАдрес;
		Движение.ФактическийАдресСтруктура = ФактическийАдресСтруктура;
		Движение.ФактическийАдресВручную = ФактическийАдресВручную;
		Движение.ПочтовыйАдрес = ПочтовыйАдрес;
		Движение.ПочтовыйАдресСтруктура = ПочтовыйАдресСтруктура;
		Движение.ПочтовыйАдресВручную = ПочтовыйАдресВручную;
		Движение.ТелефонДополнительный = ТелефонДополнительный;
		Движение.ТелефонДополнительныйСтруктура = ТелефонДополнительныйСтруктура;
		Движение.КонтактноеЛицо = КонтактноеЛицо;
		Движение.ТелефонКонтактногоЛица = ТелефонКонтактногоЛица;
		Движение.ТелефонКонтактногоЛицаСтруктура = ТелефонКонтактногоЛицаСтруктура;
		Движение.ИсточникИнформации = ИсточникИнформации;
		Движение.ИсточникИнформацииДругое = ИсточникИнформацииДругое;
		Движение.Ответственный = Ответственный;
		Движение.ОтветственныйЛомбард = ОтветственныйЛомбард;	//+++ МоисеевЕС 20250526
		Движение.ПричинаИзменения = ПричинаИзменения;
		Движение.Изменения = ЭтотОбъект.ИзмененияКИ;
		Движение.ДатаСмерти = ЭтотОбъект.ДатаСмерти;
		Движение.Комментарий = ЭтотОбъект.Комментарий;
		Движение.Фамилия_А = Фамилия_А;
		Движение.Имя_А = Имя_А;
		Движение.Отчество_А = Отчество_А;
		Движение.ПричинаИзмененияФИО = ПричинаИзмененияФИО;
		Движение.ОснованиеИзмененияФИО = ОснованиеИзмененияФИО; 
		Движение.СменилсяАдресПрописки = СменилсяАдресПрописки;
		Движение.СменилсяФактическийАдрес = СменилсяФактическийАдрес;
		Движение.СменилсяПочтовыйАдрес = СменилсяПочтовыйАдрес;  
		Движение.ПричинаИзмененияАдресаПоПрописке = ПричинаИзмененияАдресаПоПрописке;
		Движение.ПричинаИзмененияФактическогоАдреса = ПричинаИзмененияФактическогоАдреса;
		Движение.ПричинаИзмененияПочтовогоАдреса = ПричинаИзмененияПочтовогоАдреса;
		//+МАН 16.01.25
		//Движение.Резиденство = Резиденство;
		//-МАН
	КонецЕсли;	 
	
	// регистр ЛБ_АнкетаЗалогодателя
	Если НЕ ПустаяСтрока(ЭтотОбъект.ИзмененияАнкета) Тогда
		Движения.ЛБ_АнкетаЗалогодателя.Записывать = Истина;
		Движение = Движения.ЛБ_АнкетаЗалогодателя.Добавить();
		Движение.Период = Дата;
		Движение.Залогодатель = Залогодатель;
		Движение.ДатаОформленияАнкеты = ДатаОформленияАнкеты;
		Движение.ДеловаяРепутацияПоложительная = ДеловаяРепутацияПоложительная;
		Движение.ДолжностьДЛПМО_РДПЛ = ДолжностьДЛПМО_РДПЛ;
		Движение.ДолжностьИПДЛ = ДолжностьИПДЛ;
		Движение.ДопИнформацияДЛПМО_РДПЛ = ДопИнформацияДЛПМО_РДПЛ;
		Движение.ДопИнформацияИПДЛ = ДопИнформацияИПДЛ;
		Движение.ЗалогодательБенефициарныйВладелец = ЗалогодательБенефициарныйВладелец;
		Движение.ИНН = ИНН;  
		Движение.СНИЛС = СНИЛС;
		Движение.ИсточникПроисхожденияДенежныхСредств = ИсточникПроисхожденияДенежныхСредств;
		Движение.ИсточникПроисхожденияДенежныхСредствИной = ИсточникПроисхожденияДенежныхСредствИной;
		Движение.ИсточникПроисхожденияИмущества = ИсточникПроисхожденияИмущества;
		Движение.ИсточникПроисхожденияИмуществаИной = ИсточникПроисхожденияИмуществаИной;
		Движение.КатегорияДЛПМО_РДПЛ = КатегорияДЛПМО_РДПЛ;
		Движение.КатегорияКлиентаИПДЛ = КатегорияКлиентаИПДЛ;
		Движение.КатегорииФизЛица = КатегорииФизЛица;
		Движение.РаботодательДЛПМО_РДПЛ = РаботодательДЛПМО_РДПЛ;
		Движение.РаботодательИПДЛ = РаботодательИПДЛ;
		Движение.РазрешениеДЛПМО_РДПЛ = РазрешениеДЛПМО_РДПЛ;
		Движение.РазрешениеИПДЛ = РазрешениеИПДЛ; 
		Движение.ОтветственноеЛицоИПДЛ = ОтветственноеЛицоИПДЛ;
		Движение.ОтветственноеЛицоДЛПМО_РДПЛ = ОтветственноеЛицоДЛПМО_РДПЛ;
		Движение.ТипФизЛица = ТипФизЛица;
		Движение.УровеньРиска = УровеньРиска;
		Движение.ФинансовоеПоложениеСтабильное = ФинансовоеПоложениеСтабильное;
		Движение.ХарактерОтношений = ХарактерОтношений;
		Движение.ЯвляетсяДЛПМО_РДПЛ = ЯвляетсяДЛПМО_РДПЛ;
		Движение.ЯвляетсяИПДЛ = ЯвляетсяИПДЛ;           
		Движение.Ответственный = Ответственный; 
		
		Движение.ПричинаИзменения = ПричинаИзменения;
		Движение.Изменения = ЭтотОбъект.ИзмененияАнкета;  
		
		Если НЕ Бенефициары.Количество() = 0 Тогда 
