Функция ПолучитьСсылкуНаСтатус()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СлужебныеСтатусыКлиентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЛБ_СлужебныеСтатусыКлиентов КАК ЛБ_СлужебныеСтатусыКлиентов
		|ГДЕ
		|	ЛБ_СлужебныеСтатусыКлиентов.Несостоятельный";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	Иначе
		Возврат Справочники.ЛБ_СлужебныеСтатусыКлиентов.ПустаяСсылка();
	КонецЕсли;;
	
КонецФункции

Функция ПолучитьСтатусОЗ(Дата, ОЗ, ЗБ)
	
	СтатусОбъектаЗалога = Новый СписокЗначений;
	СтатусОбъектаЗалога.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.ВключенВНакладную);
	СтатусОбъектаЗалога.Добавить(Перечисления.ЛБ_СтатусыОбъектовЗалога.ОбъявленТорг);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛБ_СостояниеОбъектаЗалога.СтатусОбъектаЗалога КАК СтатусОЗ
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеОбъектаЗалога КАК ЛБ_СостояниеОбъектаЗалога
		|ГДЕ
		|	ЛБ_СостояниеОбъектаЗалога.ОбъектЗалога = &ОбъектЗалога
		|	И ЛБ_СостояниеОбъектаЗалога.ЗалоговыйБилет = &ЗалоговыйБилет
		|	И НЕ ЛБ_СостояниеОбъектаЗалога.СтатусОбъектаЗалога В (&СтатусОбъектаЗалога)
		|	И ЛБ_СостояниеОбъектаЗалога.Период <= &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_СостояниеОбъектаЗалога.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);
	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	Запрос.УстановитьПараметр("СтатусОбъектаЗалога", СтатусОбъектаЗалога);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтатусОЗ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;;

КонецФункции
//-Мельников