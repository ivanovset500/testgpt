					Движение.СтатусДоверенности = Перечисления.ЛБ_СтатусыДоверенностей.СмертьДоверенногоЛица; 
				КонецЕсли;	
			КонецЦикла; 
			
			ЗапросОЗ = Новый Запрос; 
			ЗапросОЗ.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
			ЗапросОЗ.Текст = "ВЫБРАТЬ
