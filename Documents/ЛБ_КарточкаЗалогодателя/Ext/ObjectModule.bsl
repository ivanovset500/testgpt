				Движение.ПричинаПрименения = Выборка.ПричинаПрименения;
				Движение.ДатаВыкупа = Выборка.ДатаВыкупа;
				Движение.ДатаВыкупаЛьготныйСрок = Выборка.ДатаВыкупаЛьготныйСрок;	
