
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ТолькоПросмотр = Истина;
	ЭтаФорма.Заголовок = "Данные клиента на " + Строка(Объект.Дата);
	
	Если ПустаяСтрока(Объект.Фамилия_А) И ПустаяСтрока(Объект.Имя_А) И ПустаяСтрока(Объект.Отчество_А) Тогда
		Элементы.ГруппаДопФИО.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры
