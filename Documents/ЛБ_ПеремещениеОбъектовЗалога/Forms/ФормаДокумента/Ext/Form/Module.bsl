&НаСервере
Функция ПолучитьНовыйНомерПеремещения()   
	СтруктураВозврата = Новый Структура;  
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	    НомерПеремещения = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерПеремещения(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.Ссылка); 
	Иначе   
		НомерПеремещения = ЛБ_УправлениеЛомбардом.ПолучитьНовыйНомерПеремещения(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда);
	КонецЕсли;	
	СтруктураВозврата.Вставить("НомерПеремещения", НомерПеремещения);	
	Если Объект.ЛомбардОткуда = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис") Тогда
		ПредставлениеНомера = СокрЛП(НомерПеремещения);
	Иначе	
        ПредставлениеНомера = СокрЛП(Объект.ЛомбардОткуда.НомерЛомбарда) + "/" +  СокрЛП(НомерПеремещения);  
	КонецЕсли;	  
	СтруктураВозврата.Вставить("ПредставлениеНомера", ПредставлениеНомера);
    Возврат СтруктураВозврата;
КонецФункции	

&НаСервере
Функция ПроверкаОстатков() 
	ЕстьОшибки = Ложь;
	Если Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно Тогда
		ТаблицаОстатков = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбарда(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель);   
		
		Для каждого Стр Из ТаблицаТоваров Цикл  
			Отбор = новый структура;
			Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
			Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
			СтрокиОст = ТаблицаОстатков.НайтиСтроки(Отбор);
			Если СтрокиОст.Количество() = 0 Тогда 
				Сообщить("Изделие с артикулом " + СокрЛП(Стр.Артикул) + " не найдено на складе " + СокрЛП(Объект.СкладОтправитель));  
				ЕстьОшибки = Истина;
			Конецесли;    
		Конеццикла;  
	ИначеЕсли Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Сумка Тогда 
		ТаблицаОстатковВСумке = ЛБ_УправлениеЛомбардом.ПолучитьТоварыВСумке(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель, Объект.НакладнаяНаОтгрузку);     
		
		Для каждого Стр Из ТаблицаТоваров Цикл  
			Отбор = новый структура;
			Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
			Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
			СтрокиОст = ТаблицаОстатковВСумке.НайтиСтроки(Отбор);
			Если СтрокиОст.Количество() = 0 Тогда 
				Сообщить("Изделие с артикулом " + СокрЛП(Стр.Артикул) + " не найдено в сумке на складе " + СокрЛП(Объект.СкладОтправитель));  
			    ЕстьОшибки = Истина;
			Конецесли;  
		Конеццикла;  	
	КонецЕсли;
	
	Возврат ?(ЕстьОшибки, Ложь, Истина);
КонецФункции

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ЗаполнитьТаблицуДокумента();
	Если ЗначениеЗаполнено(Объект.ЛомбардОткуда) И (Объект.НомерПеремещения = 0) Тогда
		Результат = ПолучитьНовыйНомерПеремещения();
		Объект.НомерПеремещения = Результат.НомерПеремещения;
		Объект.ПредставлениеНомераПеремещения = Результат.ПредставлениеНомера;
	КонецЕсли;
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Если ТаблицаТоваров.Количество() = 0 Тогда
			Сообщить("Не выбраны изделия для перемещения.", статуссообщения.Важное);
			Отказ = Истина;
		КонецЕсли;    
		Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту") Тогда 
			Если НЕ ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
				Сообщить("Не выбран склад-получатель.", статуссообщения.Важное);
				Отказ = Истина;
			КонецЕсли;	
		КонецЕсли;	
		Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВнутриПодразделения") Тогда 
			Если Объект.ЛомбардОткуда = Объект.ЛомбардКуда Тогда
				Сообщить("Для перемещения внутри подразделения используйте соответствующую операцию.", статуссообщения.Важное);
				Отказ = Истина; 	
			КонецЕсли;	  
			Если НЕ ЗначениеЗаполнено(Объект.Инкассатор) Тогда
				Сообщить("Не выбран инкассатор.", статуссообщения.Важное);
				Отказ = Истина; 
			КонецЕсли;
		КонецЕсли; 
		Если НЕ ПроверкаОстатков() Тогда  
			Отказ = Истина;
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли; 
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтоги()
	ИтогКоличество = ТаблицаТоваров.Итог("Количество");
	ИтогВес = ТаблицаТоваров.Итог("ВесИзделия"); 
	ИтогВесМеталла = ТаблицаТоваров.Итог("ВесМеталла");
    ИтогСуммаОценки = ТаблицаТоваров.Итог("СуммаОценки");
	ИтогСуммаОценкиМакс = ТаблицаТоваров.Итог("СуммаОценкиМакс"); 
	ИтогСуммаОценкиМеталлы = ТаблицаТоваров.Итог("СуммаОценкиМеталлы");
	ИтогСуммаОценкиВставки = ТаблицаТоваров.Итог("СуммаОценкиВставки");
	ИтогСуммаСсуды = ТаблицаТоваров.Итог("СуммаСсуды");
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуТоваров()  
	Запрос = Новый Запрос;  
	СписокОЗ = Новый СписокЗначений;
	СписокЗБ = Новый СписокЗначений;
	Для каждого Стр Из Объект.Товары Цикл 
		Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда 
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;	
		Если СписокОЗ.НайтиПоЗначению(Стр.ОбъектЗалога) = неопределено Тогда 
			СписокОЗ.Добавить(Стр.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);  
	Запрос.УстановитьПараметр("ЗалоговыеБилеты", СписокЗБ); 
	Запрос.УстановитьПараметр("ОбъектыЗалога", СписокОЗ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни КАК СуммаОценкиВставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды КАК СуммаСсуды,
	               |	1 КАК Количество,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	               |			&Дата,
	               |			ОбъектЗалога В (&ОбъектыЗалога)
	               |				И ЗалоговыйБилет В (&ЗалоговыеБилеты)) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	ТаблицаТоваров.Загрузить(ТаблицаЗапроса);
	ЗаполнитьИтоги();
КонецПроцедуры	

&НаСервере
Процедура ПолучитьТоварыПоОстаткам()  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбарда(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель);  
	Объект.Товары.Загрузить(ТаблицаЗапроса);
	Объект.Товары.Сортировать("ЗалоговыйБилет");
КонецПроцедуры	
	 
&НаКлиенте
Процедура Заполнить(Команда) 
	Если НЕ ЗначениеЗаполнено(Объект.ЛомбардОткуда) Тогда  
		Сообщить("Выберите подразделение откуда передаются товары.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда  
		Сообщить("Выберите склад откуда передаются товары.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;	
	ПолучитьТоварыПоОстаткам();
	ЗаполнитьТаблицуТоваров();
КонецПроцедуры 

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКатегорию()
    Если Объект.ЛомбардОткуда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис И НЕ Объект.ЛомбардКуда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис И ЗначениеЗаполнено(Объект.ЛомбардКуда) Тогда 
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;
		ЗаполнитьВыборКатегории(); 
		Элементы.ВыборКатегории.ТолькоПросмотр = Истина; 
	ИначеЕсли НЕ Объект.ЛомбардОткуда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис И ЗначениеЗаполнено(Объект.ЛомбардОткуда) И Объект.ЛомбардКуда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда  
		Если ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда  
			Если Объект.СкладОтправитель.ВидСклада = Перечисления.ЛБ_ВидыСкладов.Залоги Тогда
			    Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Сумка;  
				ЗаполнитьВыборКатегории(); 
			    Элементы.ВыборКатегории.ТолькоПросмотр = Истина; 
			ИначеЕсли Объект.СкладОтправитель.ВидСклада = Перечисления.ЛБ_ВидыСкладов.Витрина Тогда    
				Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;
				ЗаполнитьВыборКатегории(); 
			    Элементы.ВыборКатегории.ТолькоПросмотр = Истина;   
			Иначе
				Элементы.ВыборКатегории.ТолькоПросмотр = ложь; 
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		Элементы.ВыборКатегории.ТолькоПросмотр = Ложь;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимость()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВнутриПодразделения Тогда
		Элементы.Откуда.ТолькоПросмотр = Ложь;
		Элементы.Куда.ТолькоПросмотр = Истина; 
		Элементы.СкладПолучатель.Видимость = Истина;
		Элементы.Инкассатор.Видимость = Ложь; 
		Элементы.Куда.Заголовок = "Подразделение";    
		Элементы.ВыборКатегории.ТолькоПросмотр = Истина;
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение Тогда	
		Элементы.Откуда.ТолькоПросмотр = Ложь; 
		Элементы.Куда.ТолькоПросмотр = Ложь;
		Элементы.СкладПолучатель.Видимость = Истина;
		Элементы.Инкассатор.Видимость = Истина;    
		Элементы.Куда.Заголовок = "Подразделение"; 
		УстановитьКатегорию();
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту Тогда
		Элементы.Откуда.ТолькоПросмотр = Истина; 
		Элементы.Куда.ТолькоПросмотр = Ложь;
		Элементы.СкладПолучатель.Видимость = Ложь;
		Элементы.Инкассатор.Видимость = Истина;
		Элементы.Куда.Заголовок = "Контрагент";   
		Элементы.ВыборКатегории.ТолькоПросмотр = Истина;
	КонецЕсли;	   
	Если Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Сумка Тогда
		Элементы.ТаблицаТоваровГруппаКнопокОсновная.Видимость = Ложь; 
		Элементы.ТаблицаТоваровГруппаКнопокСумка.Видимость = Истина;
	Иначе
		Элементы.ТаблицаТоваровГруппаКнопокОсновная.Видимость = Истина; 
		Элементы.ТаблицаТоваровГруппаКнопокСумка.Видимость = Ложь;
	КонецЕсли;     
	//Если НЕ Объект.НомерПеремещения = 0 тогда 
	//	Элементы.Откуда.ТолькоПросмотр = Истина;
	//КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ИзменитьВидОперации()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВнутриПодразделения Тогда 
		Объект.ЛомбардКуда = Объект.ЛомбардОткуда; 		 
		Объект.Инкассатор = Справочники.ЛБ_Сотрудники.ПустаяСсылка(); 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение Тогда
		Если ТипЗнч(Объект.ЛомбардКуда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
			Объект.ЛомбардКуда = Справочники.ЛБ_Сотрудники.ПустаяСсылка();
		КонецЕсли;
		Объект.Инкассатор = неопределено;  		
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту Тогда
		Объект.ЛомбардОткуда = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
		Объект.ЛомбардКуда = Справочники._ДемоКонтрагенты.ПустаяСсылка(); 
		Объект.Инкассатор = неопределено; 
		Объект.СкладПолучатель = Справочники.ЛБ_Склады.ПустаяСсылка();
	КонецЕсли;	
	УстановитьВидимость();
	ТаблицаТоваров.Очистить();
КонецПроцедуры	

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	Если НЕ Объект.ВидОперации = ТекущийВидОперации Тогда
		ТекущийВидОперации = Объект.ВидОперации;
		ИзменитьВидОперации();
		Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Откуда"));
	    Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Куда")); 
		Объект.НомерПеремещения = 0;
		Объект.ПредставлениеНомераПеремещения = "";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОткудаПриИзменении(Элемент)
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВнутриПодразделения") Тогда 
		Объект.ЛомбардКуда = Объект.ЛомбардОткуда; 
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение") Тогда 
		УстановитьКатегорию();  
		УстановитьВидимость();
	КонецЕсли;	

	Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Откуда"));
	Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Куда")); 
	ТаблицаТоваров.Очистить(); 
	Объект.НомерПеремещения = 0;
	Объект.ПредставлениеНомераПеремещения = "";
КонецПроцедуры

&НаСервере
Функция ПолучитьТипКуда()
	Если ТипЗнч(Объект.ЛомбардКуда) = Тип("СправочникСсылка._ДемоКонтрагенты") Тогда
		Возврат 1;
	Иначе
		Возврат 0;
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура КудаПриИзменении(Элемент) 
	Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВнутриПодразделения") Тогда 
		Если ЗначениеЗаполнено(Объект.ЛомбардКуда) И Объект.ЛомбардОткуда = Объект.ЛомбардКуда Тогда
			Предупреждение("Для перемещения внутри подразделения используйте операцию внутреннего перемещения.", 60);
		КонецЕсли;			
	КонецЕсли;	     
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение") Тогда 
		УстановитьКатегорию(); 
		УстановитьВидимость();
	КонецЕсли;	

	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту") Тогда 
		Если НЕ ПолучитьТипКуда() = 1 Тогда
		    Объект.ЛомбардКуда = ПредопределенноеЗначение("Справочник._ДемоКонтрагенты.ПустаяСсылка");  
		КонецЕсли;	
	Иначе
		Если НЕ ПолучитьТипКуда() = 0 Тогда	
		    Объект.ЛомбардКуда = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка");
		КонецЕсли;	
	КонецЕсли;
	
	Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Откуда"));
	Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Куда"));
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораСкладов(Направление) 
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту") Тогда
	    ПроверятьКуда = Ложь; 
	Иначе 
		ПроверятьКуда = Истина;
	КонецЕсли;	
	Если ЗначениеЗаполнено(Объект.ВидОперации) И ЗначениеЗаполнено(Объект.ЛомбардОткуда) И ?(НЕ ПроверятьКуда, Истина, ЗначениеЗаполнено(Объект.ЛомбардКуда)) Тогда 
		Если Направление = "Откуда" Тогда
		    ВидСкладаНаправление = Объект.СкладПолучатель.ВидСклада;
		Иначе
			ВидСкладаНаправление = Объект.СкладОтправитель.ВидСклада;
		КонецЕсли;	
        Возврат ЛБ_Общиймодуль.ПолучитьСписокВыбораСкладовДляПеремещения(Объект.ВидОперации, Объект.ЛомбардОткуда, Объект.ЛомбардКуда, Направление, ВидСкладаНаправление); 
	Иначе                    
		Возврат Новый Массив;
	КонецЕсли;
КонецФункции	


&НаСервере
Процедура ДобавитьВТаблицуТоваров(ТаблицаОЗ)  
	Запрос = Новый Запрос;  
	СписокОЗ = Новый СписокЗначений;
	СписокЗБ = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаОЗ Цикл 
		Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда 
			СписокЗБ.Добавить(Стр.ЗалоговыйБилет);
		КонецЕсли;	
		Если СписокОЗ.НайтиПоЗначению(Стр.ОбъектЗалога) = неопределено Тогда 
			СписокОЗ.Добавить(Стр.ОбъектЗалога);
		КонецЕсли;	
	КонецЦикла;	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);  
	Запрос.УстановитьПараметр("ЗалоговыеБилеты", СписокЗБ); 
	Запрос.УстановитьПараметр("ОбъектыЗалога", СписокОЗ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ВесИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК ВесМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиКамни КАК СуммаОценкиВставки,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаСсуды КАК СуммаСсуды,
	               |	1 КАК Количество,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вставки КАК Вставки,
	               |	ЛБ_ГруппыОбъектовЗалогаСрезПоследних.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	               |			&Дата,
	               |			ОбъектЗалога В (&ОбъектыЗалога)
	               |				И ЗалоговыйБилет В (&ЗалоговыеБилеты)) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_ГруппыОбъектовЗалога.СрезПоследних(&Дата, ) КАК ЛБ_ГруппыОбъектовЗалогаСрезПоследних
	               |		ПО ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЗалоговыйБилет = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ЗалоговыйБилет
	               |			И ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога = ЛБ_ГруппыОбъектовЗалогаСрезПоследних.ОбъектЗалога";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТаблицаЗапроса Цикл 
		Отбор = Новый структура;
		Отбор.Вставить("ЗалоговыйБилет", стр.ЗалоговыйБилет);
		Отбор.Вставить("ОбъектЗалога", стр.ОбъектЗалога);
		СтрокиТ = ТаблицаТоваров.НайтиСтроки(Отбор);
		Если СтрокиТ.Количество() = 0 Тогда
		    НоваяСтр = ТаблицаТоваров.Добавить(); 
			НоваяСтр.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
			НоваяСтр.ОбъектЗалога = Стр.ОбъектЗалога;
			НоваяСтр.Артикул = Стр.Артикул;
			НоваяСтр.ВидИзделия = Стр.ВидИзделия;
			НоваяСтр.Проба = Стр.Проба;
			НоваяСтр.Категория = Стр.Категория;
			НоваяСтр.ВесИзделия = Стр.ВесИзделия;
			НоваяСтр.ВесМеталла = Стр.ВесМеталла;
			НоваяСтр.СуммаОценки = Стр.СуммаОценки;
			НоваяСтр.СуммаОценкиМакс = Стр.СуммаОценкиМакс;
			НоваяСтр.СуммаОценкиМеталлы = Стр.СуммаОценкиМеталлы;
			НоваяСтр.СуммаОценкиВставки = Стр.СуммаОценкиВставки;
			НоваяСтр.СуммаСсуды = Стр.СуммаСсуды;
			НоваяСтр.Количество = Стр.Количество;
			НоваяСтр.Вставки = Стр.Вставки;  
			НоваяСтр.Группа = Стр.Группа; 
		КонецЕсли;	
	Конеццикла;    
	ЗаполнитьИтоги();
КонецПроцедуры	

&НаСервере
Функция ПолучитьТоварыПоОстаткамАртикул(Артикул)  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбардаПоАртикулу(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель, Артикул);
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
	    ДобавитьВТаблицуТоваров(ТаблицаЗапроса); 
		Возврат "";
	Иначе          
		Возврат "Изделие с артикулом " + сокрЛП(Артикул) + " на складе-отправителе не найдено.";
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоАртикулу(Команда) 
	Если НЕ ЗначениеЗаполнено(Объект.ЛомбардОткуда) Тогда  
		Сообщить("Выберите подразделение откуда перемещаются изделия.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда  
		Сообщить("Выберите склад-отправитель.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;	

	Артикул = "";
	Если ВвестиЗначение(Артикул, "Введите артикул") Тогда
	    СтрокаСообщение = ПолучитьТоварыПоОстаткамАртикул(Артикул);
		Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
			Предупреждение(СтрокаСообщение, 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьТоварыПоОстаткамНомерЗБ(НомерЗБ)  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбардаПоНомеруЗБ(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель, НомерЗБ);
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
	    ДобавитьВТаблицуТоваров(ТаблицаЗапроса); 
		Возврат "";
	Иначе          
		Возврат "Изделия из залогогового билета № " + сокрЛП(НомерЗБ) + " на складе-отправителе не найдены.";
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоНомеруЗБ(Команда) 
	Если НЕ ЗначениеЗаполнено(Объект.ЛомбардОткуда) Тогда  
		Сообщить("Выберите подразделение откуда перемещаются изделия.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда  
		Сообщить("Выберите склад-отправитель.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;	

	НомерЗБ = "";
	Если ВвестиЗначение(НомерЗБ, "Введите номер ЗБ") Тогда
	    СтрокаСообщение = ПолучитьТоварыПоОстаткамНомерЗБ(НомерЗБ);
		Если НЕ ПустаяСтрока(СтрокаСообщение) Тогда
			Предупреждение(СтрокаСообщение, 60);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


&НаСервере
Функция ПолучитьТоварыПоОстаткамПроба(Проба)  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыНаСкладеЛомбардаПоПробе(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель, Проба);
	Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
	    ДобавитьВТаблицуТоваров(ТаблицаЗапроса); 
		Возврат "";
	Иначе          
		Возврат "Изделия из металла " + сокрЛП(Проба) + " на складе-отправителе не найдены.";
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоПробе(Команда)   
	Если НЕ ЗначениеЗаполнено(Объект.ЛомбардОткуда) Тогда  
		Сообщить("Выберите подразделение откуда перемещаются изделия.", СтатусСообщения.Внимание);
		Возврат; 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда  
