&НаСервере
Функция ПолучитьЗаемщика(ЗБ) 
	Возврат ЗБ.Залогодатель;
КонецФункции

&НаКлиенте
Процедура ИсторияЗБ(Команда)
	ТекСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрока.ЗалоговыйБилет) Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", ПолучитьЗаемщика(ТекСтрока.ЗалоговыйБилет));
		ПараметрыФормы.Вставить("ЗалоговыйБилет", ТекСтрока.ЗалоговыйБилет);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);   
	КонецЕсли;	 
КонецПроцедуры

&НаКлиенте
Процедура КудаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.СторонннемуКонтрагенту") Тогда
		ТипСтр = "СправочникСсылка._ДемоКонтрагенты";
	 ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение") Тогда
		ТипСтр = "СправочникСсылка.ЛБ_Ломбарды";
	КонецЕсли;	
	Элементы.Куда.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);
	Элементы.Куда.ВыбиратьТип = Ложь; 
КонецПроцедуры

&НаСервере
Процедура ПолучитьКатегорию() 
	Если ВыборКатегории = 0 Тогда
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;  
	Иначе
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Сумка;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте    
Процедура КатегорияПриИзменении(Элемент)
	ПолучитьКатегорию(); 
	УстановитьВидимость();   
	Если Объект.Категория = ПредопределенноеЗначение("Перечисление.ЛБ_КатегорииПоступленияОбъектовЗалога.Сумка") И 
		  ЗначениеЗаполнено(Объект.ЛомбардОткуда) И ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда     
		ПараметрыФормы = новый Структура;   
		ПараметрыФормы.Вставить("Документ", Объект);
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора",ЭтаФорма);
		ОткрытьФорму("Документ.ЛБ_ПеремещениеОбъектовЗалога.Форма.ФормаВыбораВСумке", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры     

&НаКлиенте
Процедура ПослеВыбора(Результат, ДопПараметры) Экспорт
	Если Результат = неопределено тогда  
		Возврат;
	КонецЕсли;	
	
	Объект.НакладнаяНаОтгрузку = Результат.НакладнаяНаОтгрузку; 
		
	ПолучитьТоварыВСумке();
	ЗаполнитьТаблицуТоваров()
КонецПроцедуры	

&НаСервере
Процедура ПолучитьТоварыВСумке()  
	ТаблицаЗапроса = ЛБ_УправлениеЛомбардом.ПолучитьТоварыВСумке(Объект.Дата, Объект.Организация, Объект.ЛомбардОткуда, Объект.СкладОтправитель, Объект.НакладнаяНаОтгрузку);  
	Объект.Товары.Загрузить(ТаблицаЗапроса);
	Объект.Товары.Сортировать("ЗалоговыйБилет");
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьВСумке(Команда)  
	Если ЗначениеЗаполнено(Объект.ЛомбардОткуда) И ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда     
		ПараметрыФормы = новый Структура;   
		ПараметрыФормы.Вставить("Документ", Объект);
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора",ЭтаФорма);
		ОткрытьФорму("Документ.ЛБ_ПеремещениеОбъектовЗалога.Форма.ФормаВыбораВСумке", ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	Иначе
	    Предупреждение("Необходимо выбрать подразделение и склад-отправитель.", 60);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение") Тогда 
		УстановитьКатегорию(); 
		УстановитьВидимость();
	КонецЕсли;	

	Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Куда"));  
	ТаблицаТоваров.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
	Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Откуда"));
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьСостояниеДокумента();
	ЭтаФорма.Заголовок = "Перемещение объектов залога № " + СокрЛП(Объект.ПредставлениеНомераПеремещения) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровПослеУдаления(Элемент)
	ЗаполнитьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЭтаФорма.Заголовок = "Перемещение объектов залога № " + СокрЛП(Объект.ПредставлениеНомераПеремещения) + " от " + Формат(Объект.Дата, "ДЛФ=DT");
КонецПроцедуры

	 







