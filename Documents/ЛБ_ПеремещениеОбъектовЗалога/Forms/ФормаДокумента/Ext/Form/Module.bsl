	   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
       		Объект.Ответственный = ТекПользователь;
		Иначе
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		КонецЕсли;	
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
		Объект.ВидОперации = Перечисления.ЛБ_ВидыПеремещенияОбъектовЗалога.ВДругоеПодразделение;  
		Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно;
		Объект.Дата = ТекущаяДатаСеанса();
		ЭтаФорма.Заголовок = "Перемещение объектов залога (создание)";
	Иначе
		//ВидОперацииСтрока = " (" + Строка(Объект.ВидОперации) + ")";
	    ЭтаФорма.Заголовок = "Перемещение объектов залога № " + СокрЛП(Объект.ПредставлениеНомераПеремещения) + " от " + Формат(Объект.Дата, "ДЛФ=DT"); 
	КонецЕсли;
	УстановитьСостояниеДокумента();
	ЗаполнитьВыборКатегории();
	УстановитьВидимость();     
	ЗаполнитьТаблицуТоваров();    
	ТекущийВидОперации = Объект.ВидОперации;
	Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Откуда"));
	Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов("Куда")); 
	
	Если Объект.Проведен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;	
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьВыборКатегории()  
	Если Объект.Категория = Перечисления.ЛБ_КатегорииПоступленияОбъектовЗалога.Поштучно Тогда
		ЭтаФорма.ВыборКатегории = 0;
	Иначе   
		ЭтаФорма.ВыборКатегории = 1;
	КонецЕсли;	
КонецПроцедуры


