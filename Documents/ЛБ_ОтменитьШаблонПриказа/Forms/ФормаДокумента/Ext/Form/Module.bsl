&НаСервере
Процедура ЗаполнитьСписокЛомбардов()
	Результат = "";
	Для каждого Стр Из Объект.Ломбарды Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + ?(НЕ ПустаяСтрока(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.Наименование));
	КонецЦикла;	
	СписокЛомбардов = Результат;
	Объект.СтрокаЛомбарды = Результат;
КонецПроцедуры	

 
&НаКлиенте
Процедура ПослеВыбораЛомбардов(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;

	Объект.Ломбарды.Очистить();
	КоличествоВыбрано = Результат.Количество;
	Для сч = 1 По КоличествоВыбрано Цикл
		НоваяСтр = Объект.Ломбарды.Добавить();
		НоваяСтр.Ломбард = Результат["Значение" + Строка(сч)];
	КонецЦикла;	
	
	ЗаполнитьСписокЛомбардов();
	
	Если НЕ Объект.Ломбарды.Количество() = 0 Тогда
		ПолучитьДокументШаблона();  
		Если НЕ ЗначениеЗаполнено(Объект.ШаблонПриказа) Тогда 
			Предупреждение("Документ установки шаблона приказа в выбранных ломбардах не определен.", 60);
		КонецЕсли;	
	Иначе	
	    Объект.ШаблонПриказа = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка"); 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиЭлементов(Элементы, Параметры) Экспорт
 
	Если Элементы <> Неопределено Тогда 
		Объект.Ломбарды.Очистить();
        Для Каждого Эл Из Элементы Цикл
			Если Эл.Пометка Тогда 
				НоваяСтр = Объект.Ломбарды.Добавить();
	            НоваяСтр.Ломбард = Эл.Значение;
            КонецЕсли;
		КонецЦикла; 
		ЗаполнитьСписокЛомбардов();
    КонецЕсли;
КонецПроцедуры

 
&НаКлиенте
Процедура ПослеВыбораЛомбарда(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;

	Объект.Ломбарды.Очистить();
	НоваяСтр = Объект.Ломбарды.Добавить();
	НоваяСтр.Ломбард = Результат;
	
	ЗаполнитьСписокЛомбардов();  
	
	ПолучитьДокументШаблона();  
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПриказа) Тогда 
		Предупреждение("Документ установки шаблона приказа в выбранных ломбардах не определен.", 60);
	КонецЕсли;	 
КонецПроцедуры

&НаСервере
Процедура ПолучитьДокументШаблона() 
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ?(НЕ ЗначениеЗаполнено(Объект.Ссылка), ТекущаяДатаСеанса(), Объект.Дата));
	СписокЛ = Новый СписокЗначений;
	Для каждого СтрЛ Из Объект.Ломбарды Цикл 
		СписокЛ.Добавить(СтрЛ.Ломбард);
	КонецЦикла;	
	Запрос.УстановитьПараметр("Ломбарды", СписокЛ);
	Запрос.УстановитьПараметр("ВидШаблона", Объект.ВидОперации);
	ДопОтбор = "";
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавки Тогда
         ДопОтбор = "И СхемаКредитования = &СхемаКредитования";  
		 Запрос.УстановитьПараметр("СхемаКредитования", Объект.СхемаКредитования);
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавкиАкция Тогда
         ДопОтбор = "И Акция = &Акция"; 
		 Запрос.УстановитьПараметр("Акция", Объект.Акция);
	КонецЕсли; 
	Запрос.Текст = "ВЫБРАТЬ   
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.ШаблонПриказа КАК ШаблонПриказа, 
				   |	ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних.Отменен КАК Отменен
	               |ИЗ
	               |	РегистрСведений.ЛБ_УстановкаОтменаШаблонаПриказа.СрезПоследних(
	               |			&Дата,
	               |			ВидШаблона = &ВидШаблона
	               |				И Ломбард В (&Ломбарды) " + ДопОтбор + ") КАК ЛБ_УстановкаОтменаШаблонаПриказаСрезПоследних"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();  
	Если ТаблицаЗапроса.Количество() = 0 Тогда 
		Объект.ШаблонПриказа = Документы.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка();
	Иначе	     
		Для каждого Эл Из СписокЛ Цикл  
			Отбор = Новый Структура;
			Отбор.Вставить("Ломбард", Эл.Значение);
			Строки = ТаблицаЗапроса.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 Тогда
				НоваяСтр = ТаблицаЗапроса.Добавить();
				НоваяСтр.Ломбард = Эл.Значение;  
			КонецЕсли;	
		КонецЦикла;	

		ТаблицаДокументов = ТаблицаЗапроса.Скопировать();
		ТаблицаДокументов.Свернуть("ШаблонПриказа");
		Если ТаблицаДокументов.Количество() = 1 Тогда
			Выборка = ТаблицаЗапроса.Получить(0);
			Если Выборка.Отменен Тогда
				Объект.ШаблонПриказа = Документы.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка();
			Иначе	
			    Объект.ШаблонПриказа = Выборка.ШаблонПриказа;
			КонецЕсли;	
		Иначе //разные шаблоны 
			ОбщегоНазначения.СообщитьПользователю("Для выбранных ломбардов установлены разные шаблоны приказа. Выбор шаблона для отмены неоднозначен."); 
			
			Для каждого СтрД Из ТаблицаДокументов Цикл 
				Отбор = Новый Структура;
				Отбор.Вставить("ШаблонПриказа", СтрД.ШаблонПриказа);  
				Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
				СтрокаЛомбарды = "";
				Для каждого стр Из строки Цикл 
					СтрокаЛомбарды = СтрокаЛомбарды + ?(ПустаяСтрока(СтрокаЛомбарды), "", ", ") + СокрЛП(Стр.Ломбард);
				КонецЦикла;	   
				Если ЗначениеЗаполнено(СтрД.ШаблонПриказа) Тогда
			        ОбщегоНазначения.СообщитьПользователю(СтрокаЛомбарды + " шаблон приказа " +  СокрЛП(СтрД.ШаблонПриказа)); 
				Иначе
					ОбщегоНазначения.СообщитьПользователю(СтрокаЛомбарды + " шаблон приказа не установлен");
				КонецЕсли;	
			КонецЦикла;
           		
			Объект.ШаблонПриказа = Документы.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура СписокЛомбардовОчистка(Элемент, СтандартнаяОбработка)
	Объект.Ломбарды.Очистить();
	СписокЛомбардов = "";
	Объект.СтрокаЛомбарды = "";
	Объект.ШаблонПриказа = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка");
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
		Если НЕ НачалоДня(ТекущийОбъект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Если НЕ ЭтоСуперпользователь Тогда 
				 Сообщить("Пользователь имеет право проводить документ только текущей датой. Измените дату документа.", статуссообщения.Важное);
			     Отказ = Истина;
				 Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьСостояниеДокумента();
	//+МАН 17.03.26 Изменение заголовка формы. Заявка 3654.
	УстановитьЗаголовокФормы();
	//-МАН
КонецПроцедуры

&НаКлиенте
Процедура СхемаКредитованияПриИзменении(Элемент)
	Если НЕ Объект.Ломбарды.Количество() = 0 Тогда
		ПолучитьДокументШаблона();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АкцияПриИзменении(Элемент)
	Если НЕ Объект.Ломбарды.Количество() = 0 Тогда
		ПолучитьДокументШаблона();
	КонецЕсли;
КонецПроцедуры

//+МАН 17.03.26 Изменение заголовка формы. Заявка 3654.
&НаСервере
Процедура УстановитьЗаголовокФормы()
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЭтаФорма.Заголовок = "Отмена шаблона приказа №" + Параметры.Ключ.НомерДокументаБезНулей + " от " + Параметры.Ключ.Дата;
	Иначе
		ЭтаФорма.Заголовок = "Отмена шаблона приказа (создание)";
	КонецЕсли;
КонецПроцедуры
//-МАН





