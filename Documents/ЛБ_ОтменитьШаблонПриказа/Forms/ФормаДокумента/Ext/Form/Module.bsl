&НаСервере
Процедура УстановитьВидимостьПоВидуОперации()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавки Тогда 
		Элементы.Акция.Видимость = Ложь;
		Элементы.СхемаКредитования.Видимость = Истина; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.Металлы Тогда 
		Элементы.Акция.Видимость = Ложь;
		Элементы.СхемаКредитования.Видимость = Ложь; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.Вставки Тогда
		Элементы.Акция.Видимость = Ложь;
		Элементы.СхемаКредитования.Видимость = Ложь; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавкиАкция Тогда
		Элементы.Акция.Видимость = Истина;
		Элементы.СхемаКредитования.Видимость = Ложь; 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	УстановитьВидимостьПоВидуОперации();      
	Если НЕ ТекущаяОперация = Объект.ВидОперации Тогда  
		ТекущаяОперация = Объект.ВидОперации;
	    Объект.ШаблонПриказа = ПредопределенноеЗначение("Документ.ЛБ_УстановитьШаблонПриказа.ПустаяСсылка"); 
		Если НЕ Объект.Ломбарды.Количество() = 0 Тогда
			ПолучитьДокументШаблона();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры          

&НаСервере
Функция ПолучитьСписокЛомбардов() 
	СписокЛ = Новый СписокЗначений; 
	Для каждого Стр Из Объект.ШаблонПриказа.Ломбарды Цикл
		Пометка = Ложь;
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", Стр.Ломбард);  
		Строки = Объект.Ломбарды.НайтиСтроки(Отбор); 
		Если НЕ Строки.Количество() = 0 Тогда
			Пометка = Истина;
		КонецЕсли;	
	    СписокЛ.Добавить(Стр.Ломбард,,Пометка);
	Конеццикла; 
    Возврат СписокЛ;
КонецФункции	
	
