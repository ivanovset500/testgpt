
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;   
	Если УправлениеДоступом.ЕстьРоль("ЛБ_Суперпользователь") Тогда 
		ЭтоСуперпользователь = Истина;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавки;    
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;	
	ЗаполнитьСписокЛомбардов();
	УстановитьВидимостьПоВидуОперации(); 
	УстановитьСостояниеДокумента();
	
	Если Объект.Проведен Тогда  
		ЭтаФорма.ТолькоПросмотр = Истина;  
		Элементы.СписокЛомбардов.ТолькоПросмотр = Истина;
	КонецЕсли;	

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	//+МАН 18.03.26 Убрал. Заявка 3654
	//ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	//-МАН
    ТекущаяОперация = Объект.ВидОперации;

	//+МАН 17.03.26 Изменение заголовка формы. Заявка 3654.
	УстановитьЗаголовокФормы();
	//-МАН
КонецПроцедуры

