	   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	    Если НЕ ТекПользователь.ЭтоЛомбард Тогда
       		Объект.Ответственный = ТекПользователь;
		Иначе
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		КонецЕсли;	
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); 
		Объект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис;
		Объект.Дата = ТекущаяДатаСеанса();
		ЭтаФорма.Заголовок = "Назначение группы объектам залога (создание)";
	Иначе
	    ЭтаФорма.Заголовок = "Назначение группы объектам залога № " + СокрЛП(Объект.ПредставлениеНомера) + " от " + Формат(Объект.Дата, "ДЛФ=DT"); 	
	КонецЕсли;
	УстановитьСостояниеДокумента();  
	УстановитьВидимость();
	ЗаполнитьТаблицуТоваров();    
	Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(ЗаполнитьСписокВыбораСкладов());
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
КонецПроцедуры   

