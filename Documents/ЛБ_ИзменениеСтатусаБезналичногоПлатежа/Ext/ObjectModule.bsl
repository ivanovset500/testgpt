	
// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения) 
	Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Записывать = Истина;
	Движения.ЛБ_РеестрБезначныхПлатежей.Записывать = Истина;  
	Движения.ЛБ_БезналичныеПлатежиКРаспределению.Записывать = Истина;   
	
	Если ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыИзмененийБезналичныхПлатежей.Изменение Тогда
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДокументОплаты) Тогда
			Движение = Движения.ЛБ_РеестрБезначныхПлатежей.Добавить();
			Движение.Период = Дата; 
			Движение.РеестрПлатежей = РеестрПлатежей;
			Движение.ДатаПлатежа = ДатаПлатежа;
			Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
			Движение.НомерЗБ = НомерЗБ;
			Движение.ЗалоговыйБилет = ЗалоговыйБилет;
			Движение.СуммаПлатежа = СуммаПлатежа;
			Движение.СтатусПлатежа = ЭтотОбъект.НовыйСтатусПлатежа; 
			Движение.Возврат = ?(ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено, СуммаПлатежа, 0);   
			Движение.Ответственный = ЭтотОбъект.Ответственный; 
			
			РезультатС = ЛБ_ОбщийМодуль.ПолучитьСостояниеБезналичногоПлатежа(Дата-1, РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ); 
			Если НЕ РезультатС.Переплата = 0 Тогда
			    Движение.Переплата = РезультатС.Переплата;
			КонецЕсли;	   
			   
			ТекущийСтатусПлатежа = ЛБ_ОбщийМодуль.ПолучитьИтоговыйСтатусБезналичногоПлатежа(Дата-1, РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ);
			Запрос = Новый Запрос; 
			Запрос.УстановитьПараметр("Дата", Дата-1);
			Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей); 
			Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
			Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
			Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
			Запрос.Текст =  "ВЫБРАТЬ
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.РеестрПлатежей КАК РеестрПлатежей,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.НомерЗБ КАК НомерЗБ,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ДатаПлатежа КАК ДатаПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.СуммаПлатежа КАК СуммаПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
			                |	СУММА(ЛБ_РаспределенныеБезналичныеПлатежиОбороты.КВозвратуОборот) КАК КВозврату,
			                |	СУММА(ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ДоВыясненияОборот) КАК ДоВыяснения,
			                |	СУММА(ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ПереплатаОборот) КАК Переплата
			                |ИЗ
			                |	РегистрНакопления.ЛБ_РаспределенныеБезналичныеПлатежи.Обороты(
			                |			,
			                |			&Дата,
			                |			,
			                |			РеестрПлатежей = &РеестрПлатежей
			                |				И ДатаПлатежа = &ДатаПлатежа
			                |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
			                |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РаспределенныеБезналичныеПлатежиОбороты
			                |
			                |СГРУППИРОВАТЬ ПО
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ИдентификаторПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.НомерЗБ,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.РеестрПлатежей,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ДатаПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ЗалоговыйБилет,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.СуммаПлатежа"; 
			ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
			Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
				Стр = ТаблицаЗапроса.Получить(0);
				Если ТекущийСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ДоВыяснения И НЕ (Стр.ДоВыяснения = 0) Тогда
					Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
					Движение.Период = Дата;                              
					Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
					Движение.ДатаПлатежа = ДатаПлатежа;
					Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
					Движение.НомерЗБ = НомерЗБ; 
					Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
					Движение.СуммаПлатежа = СуммаПлатежа; 
	                Движение.ДоВыяснения = -Стр.ДоВыяснения;				
				ИначеЕсли ТекущийСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.КВозврату И НЕ (Стр.КВозврату = 0) Тогда	  
					Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
					Движение.Период = Дата;                              
					Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
					Движение.ДатаПлатежа = ДатаПлатежа;
					Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
					Движение.НомерЗБ = НомерЗБ;      
					Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
					Движение.СуммаПлатежа = СуммаПлатежа; 
	                Движение.КВозврату = -Стр.КВозврату;
				КонецЕсли;	
				Если НЕ (Стр.Переплата = 0) Тогда	 
					Если НЕ ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.КВозврату И
						 НЕ ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.КВозврату Тогда
						Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
						Движение.Период = Дата;                              
						Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
						Движение.ДатаПлатежа = ДатаПлатежа;
						Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
						Движение.НомерЗБ = НомерЗБ;      
						Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
						Движение.СуммаПлатежа = СуммаПлатежа; 
					    Движение.Переплата = -Стр.Переплата;   
					КонецЕсли;	
				КонецЕсли;  
			КонецЕсли;	
			
			Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
			Движение.Период = Дата;                              
			Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
			Движение.ДатаПлатежа = ДатаПлатежа;
			Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
			Движение.НомерЗБ = НомерЗБ;  
			Движение.ЗалоговыйБилет = ЗалоговыйБилет;
			Движение.СуммаПлатежа = СуммаПлатежа; 
			Если ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.КВозврату Тогда
			    Движение.КВозврату = СуммаПлатежа;
			ИначеЕсли ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ДоВыяснения Тогда
			    Движение.ДоВыяснения = СуммаПлатежа;
			ИначеЕсли ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы Тогда
			    Движение.ВДоходы = СуммаПлатежа;
			ИначеЕсли ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено Тогда
			    Движение.Возвращено = СуммаПлатежа;	 	
			КонецЕсли;  
			
			Если ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Возвращено ИЛИ
				 ЭтотОбъект.НовыйСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ОтнесеноВДоходы Тогда 
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("Дата", Дата);
				Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей); 
				Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
				Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
				Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
				Запрос.Текст = "ВЫБРАТЬ
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.РеестрПлатежей КАК РеестрПлатежей,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.НомерЗБ КАК НомерЗБ,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ДатаПлатежа КАК ДатаПлатежа,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаПлатежа КАК СуммаПлатежа,
				               |	СУММА(ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаОстаток) КАК Сумма
				               |ИЗ
				               |	РегистрНакопления.ЛБ_БезналичныеПлатежиКРаспределению.Остатки(
				               |			&Дата,
				               |			РеестрПлатежей = &РеестрПлатежей
				               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
				               |				И НомерЗБ = &НомерЗБ
				               |				И ДатаПлатежа = &ДатаПлатежа) КАК ЛБ_БезналичныеПлатежиКРаспределениюОстатки
				               |
				               |СГРУППИРОВАТЬ ПО
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.НомерЗБ,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.РеестрПлатежей,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ДатаПлатежа,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.СуммаПлатежа,
				               |	ЛБ_БезналичныеПлатежиКРаспределениюОстатки.ИдентификаторПлатежа"; 
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда  
					Движение = Движения.ЛБ_БезналичныеПлатежиКРаспределению.ДобавитьРасход();
				    Движение.Период = Дата;   
					Движение.РеестрПлатежей = Выборка.РеестрПлатежей; 
					Движение.ДатаПлатежа = Выборка.ДатаПлатежа;
					Движение.ИдентификаторПлатежа = Выборка.ИдентификаторПлатежа;
					Движение.НомерЗБ = Выборка.НомерЗБ; 
					Движение.СуммаПлатежа = Выборка.СуммаПлатежа;
		            Движение.Сумма = Выборка.Сумма;
				КонецЕсли;   
			КонецЕсли;	
		Иначе //это оплата	  
			СуммаОплаты = ДокументОплаты.СуммаОплатыПроценты + ДокументОплаты.СуммаОплатыСсуда;
			Если СуммаПлатежа > СуммаОплаты Тогда  
				Переплата = ЭтотОбъект.СуммаПлатежа - СуммаОплаты;
			Иначе
				Переплата = 0;
			КонецЕсли;
			
			Движение = Движения.ЛБ_РеестрБезначныхПлатежей.Добавить();
			Движение.Период = Дата; 
			Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
			Движение.ДатаПлатежа = ДатаПлатежа;
			Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
			Движение.НомерЗБ = ЭтотОбъект.НомерЗБ;
			Движение.ЗалоговыйБилет = ДокументОплаты.ПредыдущаяОперация;
			Движение.СуммаПлатежа = СуммаПлатежа;
			Движение.СтатусПлатежа = ЭтотОбъект.НовыйСтатусПлатежа;
			Движение.ОплатаПроценты = ДокументОплаты.СуммаОплатыПроценты;
			Движение.ОплатаЗайм = ДокументОплаты.СуммаОплатыСсуда;
			Движение.Переплата = Переплата; 
			Движение.Ответственный = ЭтотОбъект.Ответственный; 
			Движение.ДокументОплаты = ЭтотОбъект.ДокументОплаты;  	 
				
			ТекущийСтатусПлатежа = ЛБ_ОбщийМодуль.ПолучитьИтоговыйСтатусБезналичногоПлатежа(Дата-1, РеестрПлатежей, ИдентификаторПлатежа, ДатаПлатежа, НомерЗБ);
			Запрос = Новый Запрос;   
			Запрос.УстановитьПараметр("Дата", Дата-1);
			Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей); 
			Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
			Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
			Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ);
			Запрос.Текст =  "ВЫБРАТЬ
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.РеестрПлатежей КАК РеестрПлатежей,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.НомерЗБ КАК НомерЗБ,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ДатаПлатежа КАК ДатаПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.СуммаПлатежа КАК СуммаПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
			                |	СУММА(ЛБ_РаспределенныеБезналичныеПлатежиОбороты.КВозвратуОборот) КАК КВозврату,
			                |	СУММА(ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ДоВыясненияОборот) КАК ДоВыяснения,
			                |	СУММА(ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ПереплатаОборот) КАК Переплата
			                |ИЗ
			                |	РегистрНакопления.ЛБ_РаспределенныеБезналичныеПлатежи.Обороты(
			                |			,
			                |			&Дата,
			                |			,
			                |			РеестрПлатежей = &РеестрПлатежей
			                |				И ДатаПлатежа = &ДатаПлатежа
			                |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
			                |				И НомерЗБ = &НомерЗБ) КАК ЛБ_РаспределенныеБезналичныеПлатежиОбороты
			                |
			                |СГРУППИРОВАТЬ ПО
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.РеестрПлатежей,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ЗалоговыйБилет,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ИдентификаторПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.ДатаПлатежа,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.НомерЗБ,
			                |	ЛБ_РаспределенныеБезналичныеПлатежиОбороты.СуммаПлатежа"; 
			ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
			Если НЕ ТаблицаЗапроса.Количество() = 0 Тогда
				Стр = ТаблицаЗапроса.Получить(0);
				Если ТекущийСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.ДоВыяснения И НЕ (Стр.ДоВыяснения = 0) Тогда
					Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
					Движение.Период = Дата;                              
					Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
					Движение.ДатаПлатежа = ДатаПлатежа;
					Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
					Движение.НомерЗБ = НомерЗБ;   
					Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
					Движение.СуммаПлатежа = СуммаПлатежа; 
