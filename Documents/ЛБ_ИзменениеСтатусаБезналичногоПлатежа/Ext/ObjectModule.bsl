							Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
							Движение.ДатаПлатежа = ДатаПлатежа;
							Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
							Движение.НомерЗБ = НомерЗБ;   
							Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
							Движение.СуммаПлатежа = СуммаПлатежа; 
			                Движение.ДоВыяснения = -Стр.ДоВыяснения;
						ИначеЕсли ТекущийСтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.КВозврату И НЕ (Стр.КВозврату = 0) Тогда	  
							Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
							Движение.Период = Дата;                              
							Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
							Движение.ДатаПлатежа = ДатаПлатежа;
							Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
							Движение.НомерЗБ = НомерЗБ;   
							Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
							Движение.СуммаПлатежа = СуммаПлатежа; 
			                Движение.КВозврату = -Стр.КВозврату;
						КонецЕсли;  
					КонецЕсли;
				КонецЕсли;	
				Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
				Движение.Период = Дата;                              
				Движение.РеестрПлатежей = ЭтотОбъект.РеестрПлатежей;
				Движение.ДатаПлатежа = ДатаПлатежа;
				Движение.ИдентификаторПлатежа = ИдентификаторПлатежа;
				Движение.НомерЗБ = НомерЗБ;
				Движение.СуммаПлатежа = СуммаПлатежа;   
				Движение.Отмена = СуммаПлатежа;
   			КонецЕсли;	
		Иначе   // это отмена оплаты   				
			Запрос = Новый Запрос; 
			Запрос.УстановитьПараметр("Дата", Дата-1);
			Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей); 
			Запрос.УстановитьПараметр("ДатаПлатежа", ДатаПлатежа);
			Запрос.УстановитьПараметр("ИдентификаторПлатежа", ИдентификаторПлатежа);
			Запрос.УстановитьПараметр("НомерЗБ", НомерЗБ); 
			Запрос.УстановитьПараметр("ДокументОплаты", ДокументОплаты); 
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.ДокументОплаты КАК ДокументОплаты,
			               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Регистратор КАК Регистратор,
			               |	ЛБ_РеестрБезначныхПлатежейСрезПоследних.Переплата КАК Переплата
			               |ИЗ
			               |	РегистрСведений.ЛБ_РеестрБезначныхПлатежей.СрезПоследних(
			               |			&Дата,
			               |			РеестрПлатежей = &РеестрПлатежей
			               |				И ДатаПлатежа = &ДатаПлатежа
			               |				И ИдентификаторПлатежа = &ИдентификаторПлатежа
			               |				И НомерЗБ = &НомерЗБ
			               |				И ДокументОплаты = &ДокументОплаты) КАК ЛБ_РеестрБезначныхПлатежейСрезПоследних";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда  
				ОтмененныйДокумент = Выборка.Регистратор;
				
				НаборЗаписей = РегистрыСведений.ЛБ_РеестрБезначныхПлатежей.СоздатьНаборЗаписей();
			    НаборЗаписей.Отбор.Регистратор.Установить(ОтмененныйДокумент);
			    НаборЗаписей.Прочитать(); 
				
				Для каждого Запись Из НаборЗаписей Цикл	 					
				    Движение = Движения.ЛБ_РеестрБезначныхПлатежей.Добавить();
					Движение.Период = Дата; 
					Движение.РеестрПлатежей = Запись.РеестрПлатежей;
					Движение.ДатаПлатежа = Запись.ДатаПлатежа;
					Движение.ИдентификаторПлатежа = Запись.ИдентификаторПлатежа;
					Движение.НомерЗБ = Запись.НомерЗБ;
					Движение.СуммаПлатежа = Запись.СуммаПлатежа; 
					Движение.СтатусПлатежа = Перечисления.ЛБ_СтатусыБезналичныхПлатежей.Отменен;
					Движение.ЗалоговыйБилет = Выборка.ДокументОплаты.ПредыдущаяОперация;
					Движение.ОплатаПроценты = 0;
					Движение.ОплатаЗайм = 0;
					Движение.Переплата = Выборка.Переплата; 
					Движение.Ответственный = ЭтотОбъект.Ответственный; 	 
					Движение.ДокументОплаты = Запись.ДокументОплаты;
				КонецЦикла;	 
				
				НаборЗаписей = РегистрыНакопления.ЛБ_РаспределенныеБезналичныеПлатежи.СоздатьНаборЗаписей();
			    НаборЗаписей.Отбор.Регистратор.Установить(ОтмененныйДокумент);
			    НаборЗаписей.Прочитать(); 

				Для каждого Запись Из НаборЗаписей Цикл	 
					Если Запись.ОплатаПроценты + Запись.ОплатаЗайм = 0 Тогда
						Продолжить;
					КонецЕсли;	
					Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
					Движение.Период = Дата;                              
					Движение.РеестрПлатежей = Запись.РеестрПлатежей;
					Движение.ДатаПлатежа = Запись.ДатаПлатежа;
					Движение.ИдентификаторПлатежа = Запись.ИдентификаторПлатежа;
					Движение.НомерЗБ = Запись.НомерЗБ;   
					Движение.ЗалоговыйБилет = Запись.ЗалоговыйБилет;
					Движение.СуммаПлатежа = Запись.СуммаПлатежа; 
	                Движение.ДоВыяснения = -Запись.ДоВыяснения;				
					Движение.КВозврату = -Запись.КВозврату;	
					Движение.ОплатаПроценты = -Запись.ОплатаПроценты;
					Движение.ОплатаЗайм = -Запись.ОплатаЗайм;
				    Движение.Переплата = -Запись.Переплата;
				КонецЦикла;	 
				
				Движение = Движения.ЛБ_РаспределенныеБезналичныеПлатежи.Добавить();
				Движение.Период = Дата;                              
				Движение.РеестрПлатежей = ОтмененныйДокумент.РеестрПлатежей;
				Движение.ДатаПлатежа = ДатаПлатежа;
				Движение.ИдентификаторПлатежа = ОтмененныйДокумент.ИдентификаторПлатежа;
				Движение.НомерЗБ = ОтмененныйДокумент.НомерЗБ;   
				Движение.ЗалоговыйБилет = Выборка.ДокументОплаты.ПредыдущаяОперация;
				Движение.СуммаПлатежа = ОтмененныйДокумент.СуммаПлатежа; 
	            Движение.Отмена = Движение.СуммаПлатежа;							
				
				НаборЗаписей = РегистрыНакопления.ЛБ_БезналичныеПлатежиКРаспределению.СоздатьНаборЗаписей();
			    НаборЗаписей.Отбор.Регистратор.Установить(ОтмененныйДокумент);
			    НаборЗаписей.Прочитать(); 

				Для каждого Запись Из НаборЗаписей Цикл
				    Движение = Движения.ЛБ_БезналичныеПлатежиКРаспределению.ДобавитьРасход();
				    Движение.Период = Дата;   
					Движение.РеестрПлатежей = Запись.РеестрПлатежей; 
					Движение.ДатаПлатежа = Запись.ДатаПлатежа;
					Движение.ИдентификаторПлатежа = Запись.ИдентификаторПлатежа;
					Движение.НомерЗБ = Запись.НомерЗБ; 
					Движение.СуммаПлатежа = Запись.СуммаПлатежа;
	                Движение.Сумма = -Запись.Сумма;  
				КонецЦикла;	
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры