
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата = ТекущаяДата();
		Объект.Организация = Справочники.Организации.НайтиПоКоду("ДМ-000003");
		Объект.Год = Год(ТекущаяДата());
		Объект.ДатаНачала = НачалоКвартала(ТекущаяДата());
		Объект.ДатаКонца = КонецКвартала(ТекущаяДата());
		
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		Иначе
			Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
		КонецЕсли;
		
		УстановитьДатыОтчета(Истина);
	КонецЕсли;
	
	УстановитьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()
	Если Объект.Проведен Тогда
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ЛимитыЗаполнить.Доступность = Ложь;
	Иначе
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		ЭтаФорма.ТолькоПросмотр = Ложь;
		Элементы.ЛимитыЗаполнить.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ВсеОк = ПроверкаЗаполненияПолей();
	
	Если ВсеОк Тогда
		Если СтрНайти(Объект.ОтделениеСтрока, "Екатеринбург") > 0 Тогда
			РассчитатьДляЕкатИЦО();
		Иначе
			РассчитатьДляОстальных();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияПолей()
	
	ВсеОк = Истина;
	
	Если Объект.ДатаНачала = Дата(1,1,1) Тогда
		Сообщить("Не выбрана дата начала период рассчета.");
		ВсеОк = Ложь;
		Возврат ВсеОк;
	КонецЕсли;
	
	//Если ПустаяСтрока(Объект.ОтделениеСтрока) И ПустаяСтрока(Объект.ЛомбардСтрока) Тогда
	//	Сообщить("Не выбрано отделение или ломбард.");
	//	ВсеОк = Ложь;
	//	Возврат ВсеОк;
	//КонецЕсли;
	
	Если Объект.Лимиты.Количество() > 0 Тогда
		
		Ответ = Вопрос("Список лимитов не пуст. При продолжении список будет очищен.
				|Продолжить?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			ВсеОк = Ложь;
			Возврат ВсеОк;
		Иначе
			Объект.Лимиты.Очистить();
			ВсеОк = Истина;
			Возврат ВсеОк;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВсеОк
КонецФункции

&НаСервере
Процедура РассчитатьДляЕкатИЦО()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвиженияДенежныхСредств.Ломбард КАК Ломбард,
		|	СУММА(ЛБ_ДвиженияДенежныхСредств.Сумма) КАК Сумма
		|ПОМЕСТИТЬ СуммаЗаймов
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
		|ГДЕ
		|	ЛБ_ДвиженияДенежныхСредств.Организация = &Организация
		|	И ЛБ_ДвиженияДенежныхСредств.Ломбард В(&Ломбард)
		|	И ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &ДатаНач И &ДатаКон
		|	И ЛБ_ДвиженияДенежныхСредств.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
		|	И (ЛБ_ДвиженияДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаЗайма)
		|			ИЛИ ЛБ_ДвиженияДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаЗаймаПереоформление)
		|			ИЛИ ЛБ_ДвиженияДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийРКО.ОтменаВыдачиЗайма))
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ДвиженияДенежныхСредств.Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ДвиженияДенежныхСредств.Ломбард КАК Ломбард,
		|	КОЛИЧЕСТВО(ЛБ_ДвиженияДенежныхСредств.ВидОперации) КАК КоличествоДнейСнятий
		|ПОМЕСТИТЬ КолСнятий
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвиженияДенежныхСредств КАК ЛБ_ДвиженияДенежныхСредств
		|ГДЕ
		|	ЛБ_ДвиженияДенежныхСредств.Организация = &Организация
		|	И ЛБ_ДвиженияДенежныхСредств.Ломбард В(&Ломбард)
		|	И ЛБ_ДвиженияДенежныхСредств.Период МЕЖДУ &ДатаНач И &ДатаКон
		|	И ЛБ_ДвиженияДенежныхСредств.ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыДенежныхСредств.Наличные)
		|	И ЛБ_ДвиженияДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПКО.ПолучениеСКорпоративнойКарты)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ДвиженияДенежныхСредств.Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ПротоколРаботы.Ломбард КАК Ломбард,
		|	НАЧАЛОПЕРИОДА(ЛБ_ПротоколРаботы.Дата, ДЕНЬ) КАК Дата
		|ПОМЕСТИТЬ ДниВхода
		|ИЗ
		|	РегистрСведений.ЛБ_ПротоколРаботы КАК ЛБ_ПротоколРаботы
		|ГДЕ
		|	ЛБ_ПротоколРаботы.Ломбард В(&Ломбард)
		|	И ЛБ_ПротоколРаботы.Действие = ЗНАЧЕНИЕ(Перечисление.ЛБ_ДействияПользователя.Вход)
		|	И ЛБ_ПротоколРаботы.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ПротоколРаботы.Ломбард,
		|	НАЧАЛОПЕРИОДА(ЛБ_ПротоколРаботы.Дата, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_РабочиеДниЛомбарда.Ломбард КАК Ломбард,
		|	СУММА(ВЫБОР
		|			КОГДА ЛБ_РабочиеДниЛомбарда.Выходной
		|					ИЛИ ЛБ_РабочиеДниЛомбарда.Период <> ДниВхода.Дата
		|				ТОГДА 0
		|			КОГДА ЛБ_РабочиеДниЛомбарда.Период = ДниВхода.Дата
		|				ТОГДА 1
		|		КОНЕЦ) КАК КоличествоРабочихДней
		|ПОМЕСТИТЬ КолРабДней
		|ИЗ
		|	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДниВхода КАК ДниВхода
		|		ПО ЛБ_РабочиеДниЛомбарда.Ломбард = ДниВхода.Ломбард
		|			И ЛБ_РабочиеДниЛомбарда.Период = ДниВхода.Дата
		|ГДЕ
		|	ЛБ_РабочиеДниЛомбарда.Ломбард В(&Ломбард)
		|	И ЛБ_РабочиеДниЛомбарда.Период МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_РабочиеДниЛомбарда.Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард,
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|ПОМЕСТИТЬ Отделения
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			&ДатаКон,
		|			Отделение В
		|				(ВЫБРАТЬ
		|					ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|				ИЗ
		|					РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&ДатаКон, Ломбард В (&Ломбард)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|ГДЕ
		|	НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_КассовыеЛимитыСрезПоследних.Ломбард КАК Ломбард,
		|	ЛБ_КассовыеЛимитыСрезПоследних.ФактическийЛимит КАК ФактическийЛимит
		|ПОМЕСТИТЬ ФактЛимит
		|ИЗ
		|	РегистрСведений.ЛБ_КассовыеЛимиты.СрезПоследних(&ДатаКон, Ломбард В (&Ломбард)) КАК ЛБ_КассовыеЛимитыСрезПоследних
		|ГДЕ
		|	ЛБ_КассовыеЛимитыСрезПоследних.Период >= &ДатаКон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СуммаЗаймов.Ломбард КАК Ломбард,
		|	СуммаЗаймов.Сумма КАК СуммаВыданныхЗаймов,
		|	ВЫБОР
		|		КОГДА (ВЫРАЗИТЬ(КолРабДней.КоличествоРабочихДней / КолСнятий.КоличествоДнейСнятий КАК ЧИСЛО(15, 0))) > 7
		|			ТОГДА 7
		|		ИНАЧЕ ВЫРАЗИТЬ(КолРабДней.КоличествоРабочихДней / КолСнятий.КоличествоДнейСнятий КАК ЧИСЛО(15, 0))
		|	КОНЕЦ КАК ПериодМеждуДнямиПолученияСредств,
		|	СуммаЗаймов.Сумма / КолРабДней.КоличествоРабочихДней КАК СуммаЗаймовНаКоличествоРабочихДней
		|ПОМЕСТИТЬ ПромежуточныеРассчеты
		|ИЗ
		|	СуммаЗаймов КАК СуммаЗаймов
		|		ЛЕВОЕ СОЕДИНЕНИЕ КолСнятий КАК КолСнятий
		|		ПО СуммаЗаймов.Ломбард = КолСнятий.Ломбард
		|		ЛЕВОЕ СОЕДИНЕНИЕ КолРабДней КАК КолРабДней
		|		ПО СуммаЗаймов.Ломбард = КолРабДней.Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Отделения.Отделение КАК Отделение,
		|	СуммаЗаймов.Ломбард КАК Ломбард,
		|	СуммаЗаймов.Ломбард.НомерЛомбарда КАК ЛомбардНомерЛомбарда,
		|	СуммаЗаймов.Сумма КАК СуммаВыданныхЗаймов,
		|	КолРабДней.КоличествоРабочихДней КАК КоличествоРабочихДней,
		|	КолСнятий.КоличествоДнейСнятий КАК КоличествоДнейСнятий,
		|	ПромежуточныеРассчеты.ПериодМеждуДнямиПолученияСредств КАК ПериодМеждуДнямиПолученияСредств,
		|	ВЫРАЗИТЬ(ПромежуточныеРассчеты.СуммаЗаймовНаКоличествоРабочихДней * ПромежуточныеРассчеты.ПериодМеждуДнямиПолученияСредств КАК ЧИСЛО(15, 2)) КАК РассчетныйЛимит,
		|	ВЫБОР
		|		КОГДА ФактЛимит.ФактическийЛимит ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ ФактЛимит.ФактическийЛимит
		|	КОНЕЦ КАК ФактическийЛимит
		|ПОМЕСТИТЬ Рассчеты
		|ИЗ
		|	СуммаЗаймов КАК СуммаЗаймов
		|		ЛЕВОЕ СОЕДИНЕНИЕ КолСнятий КАК КолСнятий
		|		ПО СуммаЗаймов.Ломбард = КолСнятий.Ломбард
		|		ЛЕВОЕ СОЕДИНЕНИЕ КолРабДней КАК КолРабДней
		|		ПО СуммаЗаймов.Ломбард = КолРабДней.Ломбард
		|		ЛЕВОЕ СОЕДИНЕНИЕ Отделения КАК Отделения
		|		ПО СуммаЗаймов.Ломбард = Отделения.Ломбард
		|		ЛЕВОЕ СОЕДИНЕНИЕ ФактЛимит КАК ФактЛимит
		|		ПО СуммаЗаймов.Ломбард = ФактЛимит.Ломбард
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПромежуточныеРассчеты КАК ПромежуточныеРассчеты
		|		ПО СуммаЗаймов.Ломбард = ПромежуточныеРассчеты.Ломбард
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(Рассчеты.РассчетныйЛимит) КАК СуммаРассчетныйЛимит
		|ПОМЕСТИТЬ СуммаРассчитанногоЛимита
		|ИЗ
		|	Рассчеты КАК Рассчеты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛБ_КассовыеЛимитыСрезПоследних.ФактическийЛимит КАК ФактическийЛимит
		|ПОМЕСТИТЬ ЛимитЦО
		|ИЗ
		|	РегистрСведений.ЛБ_КассовыеЛимиты.СрезПоследних(&ДатаКон, Ломбард = ЗНАЧЕНИЕ(Справочник.ЛБ_Ломбарды.ЦентральныйОфис)) КАК ЛБ_КассовыеЛимитыСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Рассчеты.Отделение КАК Отделение,
		|	Рассчеты.Ломбард КАК Ломбард,
		|	Рассчеты.ЛомбардНомерЛомбарда КАК НомерЛомбарда,
		|	Рассчеты.СуммаВыданныхЗаймов КАК СуммаВыданныхЗаймов,
		|	Рассчеты.КоличествоРабочихДней КАК КоличествоРабочихДней,
		|	Рассчеты.ПериодМеждуДнямиПолученияСредств КАК ПериодМеждуДнямиПолученияСредств,
		|	НАЧАЛОПЕРИОДА(&ДатаНач, ДЕНЬ) КАК ДатаНач,
		|	НАЧАЛОПЕРИОДА(&ДатаКон, ДЕНЬ) КАК ДатаКон,
		|	Рассчеты.РассчетныйЛимит КАК РассчетныйЛимит,
		|	ВЫРАЗИТЬ(Рассчеты.РассчетныйЛимит / СуммаРассчитанногоЛимита.СуммаРассчетныйЛимит * 100 КАК ЧИСЛО(6, 2)) КАК ПроцентРасп,
		|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(Рассчеты.РассчетныйЛимит / СуммаРассчитанногоЛимита.СуммаРассчетныйЛимит * 100 КАК ЧИСЛО(6, 2))) * ЛимитЦО.ФактическийЛимит / 100 КАК ЧИСЛО(15, 2)) КАК СуммаРасп,
		|	Рассчеты.РассчетныйЛимит - (ВЫРАЗИТЬ((ВЫРАЗИТЬ(Рассчеты.РассчетныйЛимит / СуммаРассчитанногоЛимита.СуммаРассчетныйЛимит * 100 КАК ЧИСЛО(6, 2))) * ЛимитЦО.ФактическийЛимит / 100 КАК ЧИСЛО(15, 2))) КАК ЛимитОстатка
		|ИЗ
		|	Рассчеты КАК Рассчеты,
		|	СуммаРассчитанногоЛимита КАК СуммаРассчитанногоЛимита,
		|	ЛимитЦО КАК ЛимитЦО
		|
		|УПОРЯДОЧИТЬ ПО
		|	Рассчеты.Ломбард.НомерЧисловой";
	
	ДатаКон = ?(Объект.ДатаКонца = Дата(1,1,1), ТекущаяДата(), Объект.ДатаКонца);
	
	Запрос.УстановитьПараметр("ДатаНач", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	
	Если НЕ ПустаяСтрока(Объект.ЛомбардСтрока) Тогда
		Запрос.УстановитьПараметр("Ломбард", Объект.ТаблицаЛомбардов.Выгрузить(, "Ломбард"));
	Иначе
		Запрос.УстановитьПараметр("Ломбард", ПолучитьСписокЛомбардов(ДатаКон, Объект.ТаблицаОтделений.Выгрузить(, "Отделение")));
	КонецЕсли;

	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		Объект.Лимиты.Загрузить(РезультатЗапроса);
		
		//СтруктураРезультата = ПолучитьСтрокиОтделенийИЛомбардов(РезультатЗапроса);
		//
		//Объект.ОтделениеСтрокаДляСписка = СтруктураРезультата.Отделения;
