	Объект.НастройкаОтклоненийОтБазовыхЦенМеталлы.Очистить();
	
	Для каждого Стр Из ТаблицаНастроек Цикл  
		 Отбор = новый Структура;
		 Отбор.Вставить("Металл", Стр.Металл);
