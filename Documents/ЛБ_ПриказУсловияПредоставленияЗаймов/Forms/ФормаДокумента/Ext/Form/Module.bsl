&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 	

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Если Параметры.Свойство("ВидОперации") Тогда
			Объект.ВидОперации = Параметры.ВидОперации; 
		Иначе
			Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый;
		КонецЕсли;  
		Объект.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Проект;
		Объект.Дата = ТекущаяДата();
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;                      
	ДатаДок = Объект.Дата; 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	УстановитьСостояниеДокумента();
	ЛБ_РаботаСДиалогами.УстановитьЗаголовокФормыДокумента(Объект.ВидОперации, Объект, ЭтаФорма);
	
	ОсновнаяЕдиницаИзмерения = Константы.ЛБ_ОсновнаяЕдиницаМеталлы.Получить();
	ЗаполнитьВыборЕдиницИзмерения();
	
	ОсновнаяЕдиницаИзмеренияВставки = Константы.ЛБ_ОсновнаяЕдиницаКамни.Получить();
	ЗаполнитьВыборЕдиницИзмеренияВставки(); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ДиапазоныСуммЗайма.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЛБ_ДиапазоныСуммЗайма КАК ЛБ_ДиапазоныСуммЗайма
	               |ГДЕ
	               |	ЛБ_ДиапазоныСуммЗайма.ЭтоГруппа = ЛОЖЬ
	               |	И ЛБ_ДиапазоныСуммЗайма.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ДиапазоныСуммЗайма.ПорядокСортировки";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	    Элементы.СтавкиПроцентовДиапазонСумм.СписокВыбора.Добавить(Выборка.Ссылка);  
		Элементы.УсловияСтавкиПроцентовДиапазонСумм.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;	 
	
	Элементы.СпособВыводаЛомбардовНаПечать.СписокВыбора.Очистить();  
	Элементы.СпособВыводаЛомбардовНаПечать.СписокВыбора.Добавить(0, "по ломбардам"); 
	Элементы.СпособВыводаЛомбардовНаПечать.СписокВыбора.Добавить(1, "по отделениям ломбардов");
	
	СпособВыводаЛомбардовНаПечать = Объект.ВыводитьЛомбарды;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьСписокСК();
	ЗаполнитьСписокЛомбардов();
	Элементы.СписокЛомбардов.Подсказка = Элементы.СписокЛомбардов.Заголовок;
	УстановитьВидимость();
КонецПроцедуры  

&НаКлиенте
Процедура УстановитьВидимость()
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийПриказы.Базовый") Тогда 
		Элементы.ГруппаСК.Видимость = Истина; 
		Элементы.ГруппаАкция.Видимость = ложь; 
		Элементы.ДатаОкончанияДействияПриказа.Видимость = Ложь;
		Элементы.ГруппаАкцииПроцентныеСтавки.Видимость = ложь;  
		Элементы.ГруппаАкцииМеталлы.Видимость = ложь;
	Иначе          
		Элементы.ГруппаАкция.Видимость = Истина; 
		Элементы.ГруппаСК.Видимость = ложь;
		Элементы.ГруппаЦеныМеталлы.Видимость = ложь;  
		Элементы.ГруппаЦеныВставки.Видимость = ложь;
		Элементы.ГруппаСтавки.Видимость = ложь;
	КонецЕсли;	
КонецПроцедуры  

&НаСервере
Функция ПроверитьПСК()
	ПСКДень = 0; 
	ВсеОК = Истина;
    СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(Объект.Дата, Константы.ЛБ_ОсновнаяОрганизация.Получить());  
	Если НЕ СтруктураП = неопределено Тогда		
	    ПСКДень = окр(СтруктураП.ПСКГод/365, 3); 
	КонецЕсли;  
	Если НЕ ПСКДень = 0 Тогда 
		Для каждого Стр Из Объект.СтавкиПроцентов Цикл  
			Если Стр.Ставка > ПСКДень Тогда 
				ВсеОК = ложь;
				Сообщить(СокрЛП(Стр.ПричинаПрименения) + " " + СокрЛП(Стр.СхемаКредитования) + ", статус клиента " + ?(ЗначениеЗаполнено(Стр.статусЗалогодателя),СокрЛП((Стр.статусЗалогодателя)), "любой") +
				         ": процентная ставка для займа в диапазоне " + СокрЛП(Стр.ДиапазонСумм) + " превышает предельный размер ставки кредитования в день.");
			КонецЕсли;	
		Конеццикла;	
	КонецЕсли;
	Если ВсеОК Тогда 
		Возврат Истина;
	Иначе   
		Возврат ложь;
	КонецЕсли;	
КонецФункции	  

&НаСервере
Функция ПроверитьПСКАкции()
	ПСКДень = 0; 
	ВсеОК = Истина;
    СтруктураП = ЛБ_УправлениеЛомбардом.ПолучитьПредельныеЗначенияПроцентов(Объект.Дата, Константы.ЛБ_ОсновнаяОрганизация.Получить());  
	Если НЕ СтруктураП = неопределено Тогда		
	    ПСКДень = окр(СтруктураП.ПСКГод/365, 3); 
	КонецЕсли;  
	Если НЕ ПСКДень = 0 Тогда 
		Для каждого Стр Из Объект.УсловияАкцииСтавки Цикл
			Если Стр.УстановитьЗначениеИлиОтклонение = Перечисления.ЛБ_УстановкаЗначенияИлиОтклонения.Значение Тогда
				Если Стр.Ставка > ПСКДень Тогда 
					ВсеОК = ложь;
					Сообщить(СокрЛП(Стр.ПричинаПрименения) + " " + СокрЛП(Стр.СхемаКредитования) + ", статус клиента " + ?(ЗначениеЗаполнено(Стр.статусЗалогодателя),СокрЛП((Стр.статусЗалогодателя)), "любой") +
					         ": процентная ставка по акции в диапазоне " + СокрЛП(Стр.ДиапазонСумм) + " превышает предельный размер ставки кредитования в день.");
				КонецЕсли;	
			КонецЕсли;	
		Конеццикла;	
	КонецЕсли;
	Если ВсеОК Тогда 
		Возврат Истина;
	Иначе   
		Возврат ложь;
	КонецЕсли;	
КонецФункции	


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписидокумента.Проведение Тогда		
		Если Объект.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Факт Тогда
			Если ТекущийОбъект.ДатаНачалаДействияПриказа < ТекущийОбъект.Дата Тогда
				Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
					Сообщить("Дата начала действия прейскуранта не может быть меньше даты документа!");
		            Отказ = Истина;	
				КонецЕсли;	
			КонецЕсли;	  
		КонецЕсли;	
		Если (Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый) И  НЕ (Объект.СтавкиПроцентов.Количество() = 0) тогда
			Если (Объект.СхемыКредитования.Количество() = 0) Тогда 
				Сообщить("Не выбраны схемы кредитования!");
			    Отказ = Истина;
			КонецЕсли;	
		КонецЕсли;			
		Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Акция Тогда 
			Если НЕ ЗначениеЗаполнено(Объект.Акция) Тогда   
				Сообщить("Не выбрана акция!"); 
				Отказ = Истина;	
			КонецЕсли;	
			Если Объект.ДатаОкончанияДействияПриказа = Дата(1,1,1) Тогда  
				Сообщить("Не заполнена дата окончания акции!"); 
				Отказ = Истина;	
			КонецЕсли;
			Если ТекущийОбъект.ДатаОкончанияДействияПриказа < ТекущийОбъект.ДатаНачалаДействияПриказа Тогда
				Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
					Сообщить("Дата начала окончания действия акции не может быть меньше даты начала действия!");
		            Отказ = Истина;	
				КонецЕсли;	
			КонецЕсли;
			Если НЕ Объект.УсловияАкцииСтавки.Количество() = 0 Тогда
				Если НЕ ПроверитьПСКАкции() Тогда
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;	
		ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый Тогда 
			Если НЕ Объект.СтавкиПроцентов.Количество() = 0 Тогда
				Если НЕ ПроверитьПСК() Тогда
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	ЛБ_УправлениеЛомбардом.ЗаполнитьДополнительныеРеквизитыПриказа(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЛБ_РаботаСДиалогами.УстановитьЗаголовокФормыДокумента(Объект.ВидОперации, Объект, ЭтаФорма);	
	УстановитьСостояниеДокумента();
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры

