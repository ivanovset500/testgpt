&НаКлиенте
Процедура СписокЛомбардовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	ПараметрыФормы = Новый Структура;    
	ПараметрыФормы.Вставить("Ломбарды", Объект.Ломбарды); 
	ПараметрыФормы.Вставить("ДатаДок", Объект.Дата);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЛомбардов",ЭтаФорма);
	
	ОткрытьФорму("Обработка.ЛБ_ВыборЛомбардовИзСписка.Форма", ПараметрыФормы, Элементы.СписокЛомбардов,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЛомбардов()
	Результат = "";
	Для каждого Стр Из Объект.Ломбарды Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + ?(НЕ ПустаяСтрока(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.Наименование));
	КонецЦикла;	
	СписокЛомбардов = Результат;
	Объект.СтрокаЛомбарды = Результат;
КонецПроцедуры	
 
&НаСервере
Процедура ПослеВыбораЛомбардов(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;

	Объект.Ломбарды.Очистить();
	КоличествоВыбрано = Результат.Количество;
	Для сч = 1 По КоличествоВыбрано Цикл
		НоваяСтр = Объект.Ломбарды.Добавить();
		НоваяСтр.Ломбард = Результат["Значение" + Строка(сч)];
	КонецЦикла;	
	
	ЗаполнитьСписокЛомбардов();
	Элементы.СписокЛомбардов.Подсказка = Элементы.СписокЛомбардов.Заголовок;
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьВыборЕдиницИзмерения()
	ТаблицаЕдиницИзмерения = ЛБ_ОбщийМодуль.ВыборЕдиницИзмеренияРасчетаЦенМеталлов();
	Элементы.ЦеныЕдиницаИзмерения.СписокВыбора.Очистить();		
	Для каждого Стр Из ТаблицаЕдиницИзмерения Цикл
		Элементы.ЦеныЕдиницаИзмерения.СписокВыбора.Добавить(Стр.ЕдиницаИзмерения);
	КонецЦикла;
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьВыборЕдиницИзмеренияВставки()
	ТаблицаЕдиницИзмерения = ЛБ_ОбщийМодуль.ВыборЕдиницИзмеренияРасчетаЦенКамней();
	Элементы.ЦеныВставкиЕдиницаИзмерения.СписокВыбора.Очистить();		
	Для каждого Стр Из ТаблицаЕдиницИзмерения Цикл
		Элементы.ЦеныВставкиЕдиницаИзмерения.СписокВыбора.Добавить(Стр.ЕдиницаИзмерения);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЦеныПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекСтрока = Элементы.Цены.ТекущиеДанные;
	Если НоваяСтрока Тогда		
		ТекСтрока.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмерения;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныМеталловПоСценариюНаСервере(ШаблонМеталлы)
	Объект.ЦеныМеталлы.Очистить();  
	ТаблицаЦен = Объект.ЦеныМеталлы.Выгрузить();
	Для каждого Стр Из Объект.СценарийОценкиМеталлов.БазовыеНастройки Цикл
		Для каждого СтрГруппа Из Стр.БазоваяПроба.Пробы Цикл
		    НоваяСтр = ТаблицаЦен.Добавить();
		    НоваяСтр.Металл = Стр.Металл;
		    НоваяСтр.Проба = СтрГруппа.Проба;
		    НоваяСтр.КатегорияОбъектаЗалога = Стр.БазоваяКатегория;
		    НоваяСтр.Цена = Стр.БазоваяЦена;
		    НоваяСтр.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмерения;
		КонецЦикла;
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", Стр.КлючСтроки);
		Строки =  Объект.СценарийОценкиМеталлов.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор);
		Для каждого СтрО Из Строки Цикл
			Если (СтрО.Проба = Стр.БазоваяПроба) И (СтрО.КатегорияОбъектаЗалога = Стр.БазоваяКатегория) Тогда 
			    Продолжить;
			КонецЕсли;	 
			Для каждого СтрГруппа Из СтрО.Проба.Пробы Цикл
			    НоваяСтр = ТаблицаЦен.Добавить();
			    НоваяСтр.Металл = Стр.Металл;
			    НоваяСтр.Проба = СтрГруппа.Проба;
			    НоваяСтр.КатегорияОбъектаЗалога = СтрО.КатегорияОбъектаЗалога;
			    НоваяСтр.Цена = ?(СтрО.ОклонениеОтБазовой = Перечисления.ЛБ_ОтклонениеОтБазовойЦены.Абсолютное, Стр.БазоваяЦена + СтрО.ЗначениеОтклонения, Стр.БазоваяЦена * (1+СтрО.ЗначениеОтклонения/100));
			    Если ЗначениеЗаполнено(СтрО.ПорядокОкругления) Тогда
			        НоваяСтр.Цена = ЛБ_ОбщийМодуль.ОкруглитьЦену(НоваяСтр.Цена, СтрО.ПорядокОкругления, СтрО.ОкруглятьВБольшуюСторону);
			    КонецЕсли;	 
			    НоваяСтр.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмерения;
			КонецЦикла;	
		КонецЦикла;
	Конеццикла;	    
	
	Для каждого Стр Из ШаблонМеталлы.Металлы Цикл
	     НоваяСтр = Объект.ЦеныМеталлы.Добавить();
		 НоваяСтр.Металл = Стр.Металл;
		 НоваяСтр.Проба = Стр.Проба;
		 НоваяСтр.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога;
		 
		 Отбор = новый Структура;
		 Отбор.Вставить("Металл", Стр.Металл);
		 Отбор.Вставить("Проба", Стр.Проба);
		 Отбор.Вставить("КатегорияОбъектаЗалога", Стр.КатегорияОбъектаЗалога);
		 
		 СтрокиЦен = ТаблицаЦен.НайтиСтроки(Отбор);
		 Если СтрокиЦен.Количество() = 0 Тогда
			 НоваяСтр.ЕдиницаИзмерения = ОсновнаяЕдиницаИзмерения;
		 Иначе
