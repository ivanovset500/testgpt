	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УсловияСтавкиПроцентовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТекСтрока = Элементы.УсловияСтавкиПроцентов.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекСтрока.СхемаКредитования) Тогда   
		ТекСтрока.УстановитьЗначениеИлиОтклонение = ПредопределенноеЗначение("Перечисление.ЛБ_УстановкаЗначенияИлиОтклонения.Значение");
		ТекСтрока.Отклонение = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.ПустаяСсылка"); 
		ТекСтрока.ЗначениеОтклонения = 0;
	КонецЕсли;	
КонецПроцедуры

&НаСервере 
Функция ВыбратьСК() 
	СК = Новый СписокЗначений;
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДата()));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_СхемыКредитования.Ссылка КАК СхемаКредитования
	               |ИЗ
	               |	Справочник.ЛБ_СхемыКредитования КАК ЛБ_СхемыКредитования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛБ_УсловияПредоставленияКредита.СрезПоследних(&Дата, ) КАК ЛБ_УсловияПредоставленияКредитаСрезПоследних
	               |		ПО (ЛБ_УсловияПредоставленияКредитаСрезПоследних.СхемаКредитования = ЛБ_СхемыКредитования.Ссылка)
	               |ГДЕ
	               |	ЛБ_СхемыКредитования.ПометкаУдаления = ЛОЖЬ";
	ТЗ = Запрос.Выполнить().Выгрузить();     
	Массив = ТЗ.ВыгрузитьКолонку("СхемаКредитования");//выгружаем таблицу значений в массив
    СК.ЗагрузитьЗначения(Массив);//загружаем массив в список значений  
	
	Для каждого Стр Из Объект.СхемыКредитования Цикл 
		Эл = СК.НайтиПоЗначению(Стр.СхемаКредитования);
		Если НЕ Эл = неопределено Тогда
	        Эл.Пометка = Истина; 
		КонецЕсли;
	Конеццикла;
	Возврат СК;
КонецФункции

&НаКлиенте
Процедура СписокСКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СК = ВыбратьСК();  
	
	// процедура ПослеОтметкиЭлементов определена чуть ниже
    ОповещениеПослеОтметкиЭлементов = Новый ОписаниеОповещения(
        "ПослеОтметкиЭлементов", ЭтотОбъект
    );	
 
    СК.ПоказатьОтметкуЭлементов(
        ОповещениеПослеОтметкиЭлементов,
        "Выберите схемы кредитования"
    );
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьСписокСК()
	Результат = "";
	Для каждого Стр Из Объект.СхемыКредитования Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + СокрЛП(Стр.СхемаКредитования.Наименование);
	КонецЦикла;	
	СписокСК = Результат; 
	Объект.СтрокаСхемыКредитования = Результат;
КонецПроцедуры	
 

&НаСервере
Процедура ПослеОтметкиЭлементов(Элементы, Параметры) Экспорт 	
	Если Элементы <> Неопределено Тогда   
		ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДата());
		ТаблицаСК = Объект.СхемыКредитования.Выгрузить();
		ТаблицаСтавок = Объект.СтавкиПроцентов.Выгрузить();
		Объект.СхемыКредитования.Очистить();
		Для Каждого Эл Из Элементы Цикл 
			Если Эл.Пометка Тогда    
				СписокЛ = Новый СписокЗначений; 
				СписокЛ.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка());
				Для каждого Стр Из Объект.Ломбарды цикл 
					СписокЛ.Добавить(Стр.Ломбард);
				Конеццикла;	

				ШаблонПриказа = ЛБ_ОбщийМодуль.ПолучитьТекущийШаблон(ДатаПроверки, Перечисления.ЛБ_ВидыПрейскурантов.ПроцентныеСтавки, СписокЛ, Эл.Значение);
				Если НЕ ШаблонПриказа = неопределено Тогда 
					НоваяСтр = Объект.СхемыКредитования.Добавить(); 
				    НоваяСтр.СхемаКредитования = Эл.Значение;
					НоваяСтр.ШаблонПроцентныеСтавки = ШаблонПриказа;
					
					Отбор = Новый Структура;
				    Отбор.Вставить("СхемаКредитования",Эл.Значение);
					Строки = ТаблицаСК.НайтиСтроки(Отбор);
					Если Строки.Количество() = 0 Тогда
						Для каждого СтрШ Из НоваяСтр.ШаблонПроцентныеСтавки.СтавкиПроцентов Цикл 
							НоваяСтрП = Объект.СтавкиПроцентов.Добавить();
							НоваяСтрП.СхемаКредитования = НоваяСтр.СхемаКредитования;
							НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
							НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;						
							НоваяСтрП.Ставка = 0;
						Конеццикла;	
					Иначе
						СтрокаСК = Строки.Получить(0);
						Если НЕ СтрокаСК.ШаблонПроцентныеСтавки = ШаблонПриказа Тогда 
							СтрокиУдалить = Объект.СтавкиПроцентов.НайтиСтроки(Отбор);  
							Для каждого Стр Из СтрокиУдалить Цикл
								Объект.СтавкиПроцентов.Удалить(Стр);
							КонецЦикла; 
							Для каждого СтрШ Из НоваяСтр.ШаблонПроцентныеСтавки.СтавкиПроцентов Цикл
	                            НоваяСтрП = Объект.СтавкиПроцентов.Добавить();
								НоваяСтрП.СхемаКредитования = НоваяСтр.СхемаКредитования;
								НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
								НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
								НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;
								
								ОтборП = Новый Структура;
					            ОтборП.Вставить("СхемаКредитования", НоваяСтрП.СхемаКредитования);
								ОтборП.Вставить("ПричинаПрименения", НоваяСтрП.ПричинаПрименения);
								ОтборП.Вставить("СтатусЗалогодателя", НоваяСтрП.СтатусЗалогодателя);
								ОтборП.Вставить("ДиапазонСумм", НоваяСтрП.ДиапазонСумм); 
								
								СтрокиП = ТаблицаСтавок.НайтиСтроки(ОтборП); 
								Если НЕ СтрокиП.Количество() = 0 Тогда
									СтрП = строкиП.Получить(0);
								    НоваяСтрП.Ставка = СтрП.ставка;
								Иначе  
								    НоваяСтрП.Ставка = 0;
								КонецЕсли;	
							КонецЦикла;	
						КонецЕсли;	
                    КонецЕсли;
				Иначе
					Сообщить("Для кредитной схемы " + СокрЛП(Эл.Значение) + " не установлен шаблон процентных ставок!");					
				КонецЕсли;	
			Иначе  
				Отбор = Новый Структура;
				Отбор.Вставить("СхемаКредитования",Эл.Значение); 
				Строки = ТаблицаСК.НайтиСтроки(Отбор);
				Если НЕ Строки.Количество() = 0 Тогда
					СтрокиУдалить = Объект.СтавкиПроцентов.НайтиСтроки(Отбор);  
					Для каждого Стр Из СтрокиУдалить Цикл
						Объект.СтавкиПроцентов.Удалить(Стр);
					КонецЦикла; 	 
				КонецЕсли;	
			КонецЕсли;				
		КонецЦикла; 
		ЗаполнитьСписокСК();
    КонецЕсли; 
КонецПроцедуры  

&НаСервере  
Функция ПолучитьШаблонПриказаПроцентныеставкиНасервере(ДатаПроверки, СК)  
	СписокЛ = Новый СписокЗначений; 
	СписокЛ.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка());
	Для каждого Стр Из Объект.Ломбарды цикл 
		СписокЛ.Добавить(Стр.Ломбард);
	Конеццикла;	
	Возврат ЛБ_ОбщийМодуль.ПолучитьТекущийШаблон(ДатаПроверки, Перечисления.ЛБ_ВидыПрейскурантов.ПроцентныеСтавки, СписокЛ, СК);
КонецФункции

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	Если Объект.Проведен Тогда
		Сообщить("Для изменения даты документа необходимо отменить проведение!"); 
		Объект.Дата = ДатаДок;
		Возврат;
	КонецЕсли;     
	
	Если НЕ Объект.СхемыКредитования.Количество() = 0 Тогда 
		ТекстВопроса = "";        
		ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДата());
		Для каждого стр Из Объект.СхемыКредитования цикл 
			ШаблонПриказа = ПолучитьШаблонПриказаПроцентныеставкиНасервере(ДатаПроверки, Стр.СхемаКредитования);  
			Если ШаблонПриказа = неопределено Тогда 
				ТекстВопроса = ТекстВопроса + ?(Пустаястрока(ТекстВопроса), "", Символы.ПС) + "Для кредитной схемы " + СокрЛП(Стр.СхемаКредитования) + " на выбранную дату не установлен шаблон процентных ставок, все настройки процентых ставок будут удалены.";
			ИначеЕсли НЕ ШаблонПриказа = Стр.ШаблонПроцентныеСтавки Тогда  
				ТекстВопроса = ТекстВопроса + ?(Пустаястрока(ТекстВопроса), "", Символы.ПС) + "Для кредитной схемы " + СокрЛП(Стр.СхемаКредитования) + " на выбранную дату установлен другой шаблон процентных ставок, процентные ставки будут перезаполнены.";
			КонецЕсли;	
		Конеццикла;	
		Если НЕ Пустаястрока(ТекстВопроса) Тогда  
			ТекстВопроса = ТекстВопроса + Символы.ПС + "Продолжить?";
		    Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтаФорма); 
            ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 0,  КодВозвратаДиалога.Нет); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры    

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Результат, Параметры) Экспорт 
	Если Результат = КодВозвратаДиалога.Да Тогда 
		ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, ТекущаяДата());
        ТаблицаСтавок = Объект.СтавкиПроцентов.Выгрузить();
		УдСтрокиСК = Новый СписокЗначений;
		Для каждого стр Из Объект.СхемыКредитования цикл 
			ШаблонПриказа = ПолучитьШаблонПриказаПроцентныеставкиНасервере(ДатаПроверки, Стр.СхемаКредитования);
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", Стр.СхемаКредитования);
			Если ШаблонПриказа = неопределено Тогда 
				УдСтрокиСК.Добавить(Стр);				 
				СтрокиУдалить = Объект.СтавкиПроцентов.НайтиСтроки(Отбор);  
				Для каждого СтрП Из СтрокиУдалить Цикл
					Объект.СтавкиПроцентов.Удалить(СтрП);
				КонецЦикла; 	 
			ИначеЕсли НЕ ШаблонПриказа = Стр.ШаблонПроцентныеСтавки Тогда 
				Стр.ШаблонПроцентныеСтавки = ШаблонПриказа;
				СтрокиУдалить = Объект.СтавкиПроцентов.НайтиСтроки(Отбор);  
				Для каждого Стр Из СтрокиУдалить Цикл
					Объект.СтавкиПроцентов.Удалить(Стр);
				КонецЦикла; 	
				Для каждого СтрШ Из Стр.ШаблонПроцентныеСтавки.СтавкиПроцентов Цикл
	                НоваяСтрП = Объект.СтавкиПроцентов.Добавить();
					НоваяСтрП.СхемаКредитования = Стр.СхемаКредитования;
					НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
					НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
					НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;
					
					ОтборП = Новый Структура;
		            ОтборП.Вставить("СхемаКредитования", НоваяСтрП.СхемаКредитования);
					ОтборП.Вставить("ПричинаПрименения", НоваяСтрП.ПричинаПрименения);
					ОтборП.Вставить("СтатусЗалогодателя", НоваяСтрП.СтатусЗалогодателя);
					ОтборП.Вставить("ДиапазонСумм", НоваяСтрП.ДиапазонСумм); 
					
					СтрокиП = ТаблицаСтавок.НайтиСтроки(ОтборП); 
					Если НЕ СтрокиП.Количество() = 0 Тогда
						СтрП = строкиП.Получить(0);
					    НоваяСтрП.Ставка = СтрП.ставка;
					Иначе  
					    НоваяСтрП.Ставка = 0;
					КонецЕсли;	
                Конеццикла;
			КонецЕсли;	
		Конеццикла;	 
		Для каждого Эл Из УдСтрокиСК Цикл
			Объект.СхемыКредитования.Удалить(Эл.Значение);
		КонецЦикла;	
	Иначе
       Объект.Дата = ДатаДок;	
    КонецЕсли;   
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВыбораВидовОгранки(Идентификатор)
	Стр = Объект.ЦеныВставки.НайтиПоИдентификатору(Идентификатор); 
	Возврат ЛБ_УправлениеЛомбардом.ПолучитьСписокВыбораВидовОгранки(Стр.ВидВставки, Стр.ФормаОгранки);
КонецФункции

&НаКлиенте
Процедура ЦеныВставкиВидОгранкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	ТекСтрока = Элементы.ЦеныВставки.ТекущиеДанные;
	СписокВ = ПолучитьСписокВыбораВидовОгранки(ТекСтрока.ПолучитьИдентификатор());
    ВыбЗначение = ВыбратьИзСписка(СписокВ, Элемент);
	Если НЕ ВыбЗначение = неопределено Тогда  
		ТекСтрока.ВидОгранки = ВыбЗначение.Значение;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьЕдиницуИзмерения(Идентификатор)
	Стр = Объект.ЦеныВставки.НайтиПоИдентификатору(Идентификатор); 
    Возврат Стр.ВидВставки.ЕдиницаИзмерения;
КонецФункции	

&НаКлиенте
Процедура ЦеныВставкиВидВставкиПриИзменении(Элемент)
	ТекСтрока = Элементы.ЦеныВставки.ТекущиеДанные; 
	ТекСтрока.ЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(ТекСтрока.ПолучитьИдентификатор());
КонецПроцедуры

&НаКлиенте
Процедура СпособВыводаЛомбардовНаПечатьПриИзменении(Элемент) 
	Объект.ВыводитьЛомбарды = СпособВыводаЛомбардовНаПечать;
КонецПроцедуры







