Процедура ЗаполнитьОтклоненияМеталлыПоНастрокамНаСервере()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ?(Не ЗначениеЗаполнено(Объект.Ссылка), ТекущаяДата(), Объект.Дата));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.Металл КАК Металл,
	               |	ЛБ_НастройкаРасчетаОценкиЗалогаСрезПоследних.Проба КАК Проба,
