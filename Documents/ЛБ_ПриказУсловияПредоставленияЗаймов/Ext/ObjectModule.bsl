		Движение.ДатаНачалаДействия = ДатаНачалаДействия;
		Движение.Ломбард = ТекСтрокаЦены.Ломбард;
		Движение.ВидВставки = ТекСтрокаЦены.ВидВставки;
		Движение.ФормаОгранки = ТекСтрокаЦены.ФормаОгранки;
		Движение.ВидОгранки = ТекСтрокаЦены.ВидОгранки;
		Движение.КачествоОгранки = ТекСтрокаЦены.КачествоОгранки;
		Движение.ВесоваяГруппа = ТекСтрокаЦены.ВесоваяГруппа;
		Движение.ЕдиницаИзмерения = ТекСтрокаЦены.ЕдиницаИзмерения;
		Движение.Цена = ТекСтрокаЦены.Цена;
	КонецЦикла;
	
	Движения.ЛБ_НастройкаОценкиДрагоценныхВставок.Записывать = Истина;
	Для Каждого ТекСтрокаН Из ТаблицаНастроекВставки Цикл
		Движение = Движения.ЛБ_НастройкаОценкиДрагоценныхВставок.Добавить();
		Движение.Период = Дата;
		Движение.ДатаНачалаДействия = ДатаНачалаДействия;
		Движение.Ломбард = ТекСтрокаН.Ломбард; 
		Движение.ВидВставки = ТекСтрокаН.ВидВставки;
		Движение.КатегорияОбъектаЗалога = ТекСтрокаН.КатегорияОбъектаЗалога;
		Движение.ОтклонениеОтБазовойЦены = ТекСтрокаН.ОтклонениеОтБазовойЦены;
		Движение.ЗначениеОтклонения = ТекСтрокаН.ЗначениеОтклонения;
	КонецЦикла;   		
	
	Движения.ЛБ_ПрейскурантПроцентныхСтавок.Записывать = Истина;
    Для Каждого ТекСтрокаС Из ТаблицаСтавок Цикл
		Движение = Движения.ЛБ_ПрейскурантПроцентныхСтавок.Добавить();
		Движение.Период = Дата;
		Движение.ДатаНачалаДействия = ДатаНачалаДействия;
		Движение.Ломбард = ТекСтрокаС.Ломбард;
		Движение.ПричинаПрименения = ТекСтрокаС.ПричинаПрименения;
		Движение.СхемаКредитования = ТекСтрокаС.СхемаКредитования;
		Движение.СтатусЗалогодателя = ТекСтрокаС.СтатусЗалогодателя;
        Движение.ДиапазонСуммЗайма = ТекСтрокаС.ДиапазонСумм;
		Движение.ДеньНачалаПрименения = ТекСтрокаС.ДеньНачалаПрименения;
		Движение.ПроцентнаяСтавка = ТекСтрокаС.Ставка;
	КонецЦикла;
		
КонецПроцедуры // ДвиженияПоРегистрам()

Процедура ДвиженияПоРегистрамАкция(РежимПроведения, ТаблицаЦенАкцияМеталлы, ТаблицаСтавокАкция, Отказ)  
	ДатаНачалаДействия = ?(ЭтотОбъект.ДатаНачалаДействияПриказа = Дата(1,1,1), Дата, ?(ДатаНачалаДействияПриказа < Дата, Дата, ДатаНачалаДействияПриказа));
	
    Движения.ЛБ_АкцииМеталлы.Записывать = Истина;
    Для Каждого ТекСтрокаЦены Из ТаблицаЦенАкцияМеталлы Цикл
		Движение = Движения.ЛБ_АкцииМеталлы.Добавить();
		Движение.Период = Дата;
		Движение.ДатаНачалаДействия = ДатаНачалаДействия;  
		Движение.ДатаОкончанияДействия = ЭтотОбъект.ДатаОкончанияДействияПриказа; 
		Движение.Акция = ТекСтрокаЦены.Акция;
		Движение.Ломбард = ТекСтрокаЦены.Ломбард;
		Движение.Проба = ТекСтрокаЦены.Проба;
		Движение.Категория = ТекСтрокаЦены.Категория;  
		Движение.СхемаКредитования = ТекСтрокаЦены.СхемаКредитования;
		Движение.ЕдиницаИзмерения = ТекСтрокаЦены.ЕдиницаИзмерения;
		Движение.Цена = ТекСтрокаЦены.Цена; 
		Движение.Отклонение = ТекСтрокаЦены.ОтклонениеОтЦены; 
		Движение.ЗначениеОтклонения = ТекСтрокаЦены.ЗначениеОтклонения;
	КонецЦикла;      
	
	Движения.ЛБ_АкцииПроцентныеСтавки.Записывать = Истина;
    Для Каждого ТекСтрокаС Из ТаблицаСтавокАкция Цикл
		Движение = Движения.ЛБ_АкцииПроцентныеСтавки.Добавить();
		Движение.Период = Дата;
		Движение.ДатаНачалаДействия = ДатаНачалаДействия;
		Движение.ДатаОкончанияДействия = ЭтотОбъект.ДатаОкончанияДействияПриказа; 
		Движение.Акция = ТекСтрокаС.Акция;
		Движение.Ломбард = ТекСтрокаС.Ломбард;
		Движение.ПричинаПрименения = ТекСтрокаС.ПричинаПрименения;
		Движение.СхемаКредитования = ТекСтрокаС.СхемаКредитования;
		Движение.СтатусЗалогодателя = ТекСтрокаС.СтатусЗалогодателя;
        Движение.ДиапазонСуммЗайма = ТекСтрокаС.ДиапазонСумм;
		Движение.ПроцентнаяСтавка = ТекСтрокаС.Ставка;   
		Движение.Отклонение = ТекСтрокаС.Отклонение; 
		Движение.ЗначениеОтклонения = ТекСтрокаС.ЗначениеОтклонения;
	КонецЦикла;

 КонецПроцедуры

#Область ОбработчикиСобытий
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Перем ТаблицаСтавок; 
	Перем ТаблицаЦенМеталлы, ТаблицаНастроекМеталлы;
	Перем ТаблицаЦенВставки, ТаблицаНастроекВставки;
	Перем ТаблицаЦенАкцияМеталлы;
	Перем ТаблицаСтавокАкция;
	
	Если ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый Тогда
		ПодготовитьТаблицыДокументаПроцентныеСтавки(ТаблицаСтавок); 
		ПодготовитьТаблицыДокументаМеталлы(ТаблицаЦенМеталлы, ТаблицаНастроекМеталлы); 
		ПодготовитьТаблицыДокументаВставки(ТаблицаЦенВставки, ТаблицаНастроекВставки);
				
		ДвиженияПоРегистрам(РежимПроведения, ТаблицаЦенМеталлы, ТаблицаНастроекМеталлы, ТаблицаЦенВставки, ТаблицаНастроекВставки, ТаблицаСтавок, Отказ);
	ИначеЕсли ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Акция Тогда
        ПодготовитьТаблицыДокументаАкцияМеталлы(ТаблицаЦенАкцияМеталлы);
		ПодготовитьТаблицыДокументаСтавкиАкция(ТаблицаСтавокАкция); 
		
		ДвиженияПоРегистрамАкция(РежимПроведения, ТаблицаЦенАкцияМеталлы, ТаблицаСтавокАкция, Отказ)
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = Пользователи.ТекущийПользователь();
	ЭтотОбъект.ВидПриказа = Перечисления.ЛБ_ВидыПриказа.Проект;
	ЭтотОбъект.ДатаНачалаДействияПриказа = Дата(1,1,1);
	ЭтотОбъект.ДатаОкончанияДействияПриказа = Дата(1,1,1);  
	
	//Проверим кредитные схемы и процентные ставки 
	Если ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.Базовый Тогда 
		Если НЕ ЭтотОбъект.СтавкиПроцентов.Количество() = 0 Тогда 
			ТаблицаСтавок = ЭтотОбъект.СтавкиПроцентов.Выгрузить();
			ЭтотОбъект.СтавкиПроцентов.Очистить();
			УдСтрокиСК = Новый СписокЗначений;
			Для каждого стр Из ЭтотОбъект.СхемыКредитования цикл
				СписокЛ = Новый СписокЗначений; 
				СписокЛ.Добавить(Справочники.ЛБ_Ломбарды.ПустаяСсылка());
				Для каждого СтрЛ Из ЭтотОбъект.Ломбарды цикл 
					СписокЛ.Добавить(СтрЛ.Ломбард);
				Конеццикла;	
				ШаблонПриказа = ЛБ_ОбщийМодуль.ПолучитьТекущийШаблон(Дата, Перечисления.ЛБ_ВидыПрейскурантов.ПроцентныеСтавки, СписокЛ, Стр.СхемаКредитования);
				Отбор = Новый Структура;
				Отбор.Вставить("СхемаКредитования", Стр.СхемаКредитования);
				Если ШаблонПриказа = неопределено Тогда 
					УдСтрокиСК.Добавить(Стр);				 
				    Сообщение = Новый СообщениеПользователю;
                    Сообщение.Текст = "Для кредитной схемы " + СокрЛП(Стр.СхемаКредитования) + " не установлен шаблон процентных ставок.";
                    Сообщение.Сообщить();				
				Иначе
					Если НЕ ШаблонПриказа = Стр.ШаблонПроцентныеСтавки Тогда
					    Сообщение = Новый СообщениеПользователю;
	                    Сообщение.Текст = "Для кредитной схемы " + СокрЛП(Стр.СхемаКредитования) + " установлен новый шаблон процентных ставок, данные таблицы будут перезаполнены";
	                    Сообщение.Сообщить();
						
						Стр.ШаблонПроцентныеСтавки = ШаблонПриказа;
						Для каждого СтрШ Из Стр.ШаблонПроцентныеСтавки.СтавкиПроцентов Цикл
			                НоваяСтрП = ЭтотОбъект.СтавкиПроцентов.Добавить();
							НоваяСтрП.СхемаКредитования = Стр.СхемаКредитования;
							НоваяСтрП.ПричинаПрименения = СтрШ.ПричинаПрименения;
							НоваяСтрП.СтатусЗалогодателя = СтрШ.СтатусЗалогодателя;
							НоваяСтрП.ДиапазонСумм = СтрШ.ДиапазонСумм;
							
							ОтборП = Новый Структура;
				            ОтборП.Вставить("СхемаКредитования", НоваяСтрП.СхемаКредитования);
							ОтборП.Вставить("ПричинаПрименения", НоваяСтрП.ПричинаПрименения);
							ОтборП.Вставить("СтатусЗалогодателя", НоваяСтрП.СтатусЗалогодателя);
							ОтборП.Вставить("ДиапазонСумм", НоваяСтрП.ДиапазонСумм); 
							
							СтрокиП = ТаблицаСтавок.НайтиСтроки(ОтборП); 
							Если НЕ СтрокиП.Количество() = 0 Тогда
								СтрП = строкиП.Получить(0);
								НоваяСтрП.ДеньНачалаПрименения = СтрП.ДеньНачалаПрименения;
							    НоваяСтрП.Ставка = СтрП.ставка;
							Иначе  
								НоваяСтрП.ДеньНачалаПрименения = 1;
							    НоваяСтрП.Ставка = 0;
							КонецЕсли;	
						Конеццикла;    
					Иначе 
						СтрокиП = ТаблицаСтавок.НайтиСтроки(Отбор);
						Для каждого СтрП из СтрокиП Цикл 
							НоваяСтрП = ЭтотОбъект.СтавкиПроцентов.Добавить();
							НоваяСтрП.СхемаКредитования = СтрП.СхемаКредитования;
							НоваяСтрП.ПричинаПрименения = СтрП.ПричинаПрименения;
							НоваяСтрП.СтатусЗалогодателя = СтрП.СтатусЗалогодателя;
							НоваяСтрП.ДиапазонСумм = СтрП.ДиапазонСумм;
                            НоваяСтрП.ДеньНачалаПрименения = СтрП.ДеньНачалаПрименения;
							НоваяСтрП.Ставка = СтрП.ставка;
						Конеццикла;	
					КонецЕсли;	
				КонецЕсли;	
			Конеццикла;	 
			Для каждого Эл Из УдСтрокиСК Цикл
				ЭтотОбъект.СхемыКредитования.Удалить(Эл.Значение);
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения) 
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ЭтотОбъект.ДатаНачалаДействияПриказа < ЭтотОбъект.Дата Тогда
		    ОбщегоНазначения.СообщитьПользователю("Дата начала действия приказа не может быть меньше даты прказа!"); 
			Отказ = Истина;
		КонецЕсли;			
		
		ВсеОК = Истина;
		//проверим минусовые значения в таблицах
		Для каждого Стр Из ЭтотОбъект.ЦеныМеталлы Цикл  
			Если стр.Цена < 0 Тогда  
				ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения цен металлов. Цена металла не может быть отрицательной!"); 
				ВсеОК = Ложь; 
				Прервать;
			КонецЕсли;	
		Конеццикла;	
		
		Для каждого Стр Из ЭтотОбъект.ЦеныВставки Цикл  
			Если стр.Цена < 0 Тогда  
				ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения цен вставок. Цена вставки не может быть отрицательной!"); 
				ВсеОК = Ложь; 
				Прервать;
			КонецЕсли;	
		Конеццикла;	  
		
		Для каждого Стр Из ЭтотОбъект.СтавкиПроцентов Цикл  
			Если стр.Ставка < 0 Тогда  
				ОбщегоНазначения.СообщитьПользователю("Ошибка заполнения процентых ставок. Процентая ставка не может быть отрицательной!"); 
				ВсеОК = Ложь; 
				Прервать;
			КонецЕсли;	
		Конеццикла;	
		
		Если Не ВсеОК тогда
			Отказ = Истина;  
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры // ПередЗаписью()

#КонецОбласти


#КонецЕсли
