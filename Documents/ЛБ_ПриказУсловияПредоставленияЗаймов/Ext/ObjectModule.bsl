// По результату запроса по шапке документа формируем движения по регистрам.
//
// Параметры: 
//  РежимПроведения           - режим проведения документа (оперативный или неоперативный),
//  СтруктураШапкиДокумента   - выборка из результата запроса по шапке документа,
//  ТаблицаПоТоварам          - таблица значений, содержащая данные для проведения и проверки ТЧ Товары,
//  ТаблицаПоСкидкам          - таблица значений, содержащая данные для проведения и проверки ТЧ Скидки,
//  ТаблицаПоУслугам          - таблица значений, содержащая данные для проведения и проверки ТЧ "Услуги",
//  Отказ                     - флаг отказа в проведении,
//  Заголовок                 - строка, заголовок сообщения об ошибке проведения.
//
Процедура ДвиженияПоРегистрам(РежимПроведения, ТаблицаЦенМеталлы, ТаблицаНастроекМеталлы, ТаблицаЦенВставки, ТаблицаНастроекВставки, ТаблицаСтавок, Отказ)
	ДатаНачалаДействия = ?(ЭтотОбъект.ДатаНачалаДействияПриказа = Дата(1,1,1), Дата, ?(ДатаНачалаДействияПриказа < Дата, Дата, ДатаНачалаДействияПриказа));
	
	Движения.ЛБ_ПрейскурантЦенНаМеталлы.Записывать = Истина;
    Для Каждого ТекСтрокаЦены Из ТаблицаЦенМеталлы Цикл
		Движение = Движения.ЛБ_ПрейскурантЦенНаМеталлы.Добавить();
		Движение.Период = Дата;
		Движение.ДатаНачалаДействия = ДатаНачалаДействия;
		Движение.Ломбард = ТекСтрокаЦены.Ломбард;
		Движение.Проба = ТекСтрокаЦены.Проба;
		Движение.Категория = ТекСтрокаЦены.Категория;
		Движение.ЕдиницаИзмерения = ТекСтрокаЦены.ЕдиницаИзмерения;
		Движение.Цена = ТекСтрокаЦены.Цена;
	КонецЦикла;   
	
	Движения.ЛБ_НастройкаРасчетаОценкиЗалога.Записывать = Истина;
	Для Каждого ТекСтрокаН Из ТаблицаНастроекМеталлы Цикл
		Движение = Движения.ЛБ_НастройкаРасчетаОценкиЗалога.Добавить();
		Движение.Период = Дата;
		Движение.ДатаНачалаДействия = ДатаНачалаДействия;
		Движение.Ломбард = ТекСтрокаН.Ломбард; 
		Движение.Металл = ТекСтрокаН.Металл;
		Движение.Проба = ТекСтрокаН.Проба;
		Движение.СхемаКредитования = ТекСтрокаН.СхемаКредитования;
		Движение.КатегорияОбъектаЗалога = ТекСтрокаН.КатегорияОбъектаЗалога;
		Движение.ОтклонениеОтБазовойЦены = ТекСтрокаН.ОтклонениеОтБазовойЦены;
		Движение.ЗначениеОтклонения = ТекСтрокаН.ЗначениеОтклонения;
	КонецЦикла;   		

	Движения.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Записывать = Истина;
    Для Каждого ТекСтрокаЦены Из ТаблицаЦенВставки Цикл
		Движение = Движения.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.Добавить();
