	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_Акция"; 
		
	ВыборкаДанныеДокументов = ПолучитьВыборкуДанныхДокумента(МассивОбъектов);
	
	НаименованияОрганизации = НаименованиеОрганизации();
	НаименованиеОрганизацииСокращенное = НаименованияОрганизации.НаименованиеСокращенное;
	НаименованиеОрганизацииПолное      = НаименованияОрганизации.НаименованиеПолное;
			
	Если ВыборкаДанныеДокументов.Следующий() Тогда  
		
		ТаблицаСтавок = ПолучитьВыборкуПрейскурантаСтавокАкция(ВыборкаДанныеДокументов.СсылкаНаДокумент);
		ТаблицаСК = ТаблицаСтавок.Скопировать();
		ТаблицаСК.Свернуть("СхемаКредитования");
		ТаблицаСК.Сортировать("СхемаКредитования");
		ТаблицаПоказатели = ТаблицаСтавок.Скопировать();
		ТаблицаПоказатели.Свернуть("СхемаКредитования, Категория, ПричинаПрименения");
		ТаблицаПоказатели.Сортировать("Категория, ПричинаПрименения");
		ТаблицаД = ТаблицаСтавок.Скопировать();
		ТаблицаД.Свернуть("ДиапазонСумм"); 
		
		СписокЛомбардов = Новый СписокЗначений;  
		Для каждого Стр Из ВыборкаДанныеДокументов.СсылкаНаДокумент.Ломбарды Цикл 
			СписокЛомбардов.Добавить(Стр.Ломбард);
		Конеццикла;	           
		Если ВыборкаДанныеДокументов.СсылкаНаДокумент.ВыводитьЛомбарды = 0 Тогда 
			ЛомбардыОтделения = "ломбардах";
		    СтрокаЛомбарды = ПолучитьСтрокуЛомбардов(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, СписокЛомбардов); 
		Иначе    
			ЛомбардыОтделения = "отделениях ломбардов";
			СтрокаЛомбарды = ПолучитьСтрокуОтделенийЛомбардов(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, СписокЛомбардов);
		КонецЕсли;	
		
		Макет = ПолучитьМакет("ПФ_MXL_Акция");
		ПриказНомер = ВыборкаДанныеДокументов.НомерПриказа;
		ПриказДата  = СтрШаблон("%1 г.", Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДЛФ=Д"));
		Ломбарды    = ВыборкаДанныеДокументов.СтрокаЛомбарды; 
		Акция = ВыборкаДанныеДокументов.Акция;
		ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
		ОбластьТекст  = Макет.ПолучитьОбласть("ТекстПриказаЧасть1"); 
		ОбластьТекст2  = Макет.ПолучитьОбласть("ТекстПриказаЧасть2"); 
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьШапка.Параметры.СокращенноеНаименованиеОрганизации = НаименованиеОрганизацииСокращенное;
		ОбластьШапка.Параметры.ПолноеНаименованиеОрганизации      = НаименованиеОрганизацииПолное; 
		ОбластьШапка.Параметры.НомерПриказа = ПриказНомер; 
		ОбластьШапка.Параметры.ДатаПриказа = ПриказДата;  
		ОбластьШапка.Параметры.Акция = Акция;
				
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ОбластьТекст.Параметры.Акция = Акция;
		ОбластьТекст.Параметры.ЛомбардыОтделения = ЛомбардыОтделения;
	    ОбластьТекст.Параметры.СписокЛомбардовСАдресами                    = СтрокаЛомбарды;
		ОбластьТекст.Параметры.ДатаПриказа   = ПриказДата; 
		ОбластьТекст.Параметры.НачальникОРБ = ВыборкаДанныеДокументов.СсылкаНаДокумент.НачальникОРБ; 
					
		ТабличныйДокумент.Вывести(ОбластьТекст);
		
		//процентные ставки  
		Если НЕ ТаблицаСтавок.Количество() = 0 Тогда
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			
			ОбластьШапкаОсн = Макет.ПолучитьОбласть("ШапкаОценкиСтавки|КолонкаОсновная");
			ОбластьШапкаДоп = Макет.ПолучитьОбласть("ШапкаОценкиСтавки|КолонкаДоп");	
			ОбластьШапкаСтавка = Макет.ПолучитьОбласть("ШапкаОценкиСтавки|КолонкаСтавка"); 
			
			ТабличныйДокумент.Вывести(ОбластьШапкаОсн);
			ОбластьШапкаДоп.Параметры.Показатель = "Причина применения";
			ТабличныйДокумент.Присоединить(ОбластьШапкаДоп);
							
			Для каждого СтрД из ТаблицаД Цикл
				ОбластьШапкаСтавка.Параметры.Диапазон = СтрД.ДиапазонСумм;
			    ТабличныйДокумент.Присоединить(ОбластьШапкаСтавка);
			Конеццикла;  
			
			НомерСтр = НомерСтр + 1;  
			НомерКолонкиНач = 4;
			НомерКолонкиКон = НомерКолонкиНач + ТаблицаД.Количество();
			ТабличныйДокумент.Область(НомерСтр, НомерКолонкиНач, НомерСтр, НомерКолонкиКон).Объединить(); 
						
			ОбластьЗайм = Макет.ПолучитьОбласть("Займ|КолонкаОсновная");
			ОбластьСтрокаОсн = Макет.ПолучитьОбласть("СтрокаСтавка|КолонкаОсновная");
			ОбластьСтрокаДоп = Макет.ПолучитьОбласть("СтрокаСтавка|КолонкаДоп");	
			ОбластьСтрокаСтавка = Макет.ПолучитьОбласть("СтрокаСтавка|КолонкаСтавка"); 
			
			Ном = 0;
			Для каждого СтрК из ТаблицаСК Цикл
				Ном = Ном + 1;
				ОбластьЗайм.Параметры.Ном = Строка(Ном);
				ОбластьЗайм.Параметры.Займ = СокрЛП(СтрК.СхемаКредитования);
				ТабличныйДокумент.Вывести(ОбластьЗайм);   
				
				НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
				НомерКолонкиКон = ТаблицаД.Количество() + 4; 
				ТабличныйДокумент.Область(НомерСтр, 2, НомерСтр, НомерКолонкиКон).Объединить();  
				
				Отбор = Новый Структура;
				Отбор.Вставить("СхемаКредитования", СтрК.СхемаКредитования);
				СтрокиП = ТаблицаПоказатели.НайтиСтроки(Отбор);
				Для каждого СтрП Из СтрокиП Цикл 
					ОбластьСтрокаОсн.Параметры.Категория = СтрП.Категория; 
					ТабличныйДокумент.Вывести(ОбластьСтрокаОсн);  
					
					ОбластьСтрокаДоп.Параметры.ЗначениеП = СтрП.ПричинаПрименения; 
					ТабличныйДокумент.Присоединить(ОбластьСтрокаДоп);
											
					Отбор.Вставить("Категория", СтрП.Категория);
					Отбор.Вставить("ПричинаПрименения", СтрП.ПричинаПрименения);
					Для каждого СтрД из ТаблицаД Цикл 
						Отбор.Вставить("ДиапазонСумм", СтрД.ДиапазонСумм); 
						Строки  = ТаблицаСтавок.НайтиСтроки(Отбор);
						Если Строки.Количество() = 0 Тогда
							Ставка = 0;
						Иначе     
							Ставка = Строки.Получить(0).Ставка;
						КонецЕсли;	
						ОбластьСтрокаСтавка.Параметры.Ставка = Ставка;
					    ТабличныйДокумент.Присоединить(ОбластьСтрокаСтавка);
					Конеццикла;  

				Конеццикла;	
			КонецЦикла;	
		КонецЕсли;	 
				
		ОбластьТекст2.Параметры.ДатаПриказа = ПриказДата;
		ОбластьТекст2.Параметры.ДатаНачалаДействияПриказа = СтрШаблон("%1 г.", Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy"));
		ОбластьТекст2.Параметры.ДатаОкончанияДействияПриказа = СтрШаблон("%1 г.", Формат(ВыборкаДанныеДокументов.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy"));  
		ОбластьТекст2.Параметры.ОтветственноеЛицоОРБ = ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтветственноеЛицоОРБ;
		ОбластьТекст2.Параметры.ОтветственноеЛицоРеклама = ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтветственноеЛицоРеклама; 
		ТабличныйДокумент.Вывести(ОбластьТекст2); 
		
		ОбластьПодвал.Параметры.ПодписантДолжность = ВыборкаДанныеДокументов.СсылкаНаДокумент.ПодписантДолжность;
		ОбластьПодвал.Параметры.ПодписантФИО = ВыборкаДанныеДокументов.СсылкаНаДокумент.ПодписантФИО;
		ТабличныйДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции     

Функция ПолучитьБазовыеЦеныМеталлы(Дата)
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Проба");
	СтруктураВозврата.Вставить("Категория");

    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлыСрезПоследних.Проба КАК Проба,
	               |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлыСрезПоследних.КатегорияОбъектаЗалога КАК Категория
	               |ИЗ
	               |	РегистрСведений.ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.СрезПоследних(&Дата, ) КАК ЛБ_БазовыеЦеныНаДрагоценныеМеталлыСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать(); 
	Если Выборка.Следующий() Тогда 
		СтруктураВозврата.Вставить("Проба", Выборка.Проба);
	    СтруктураВозврата.Вставить("Категория", Выборка.Категория);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
КонецФункции

Функция ПолучитьТаблицуРегистраторов(Регистратор)
	ТаблицаРегистраторов = Новый ТаблицаЗначений;
	ТаблицаРегистраторов.Колонки.Добавить("Ломбард"); 
	ТаблицаРегистраторов.Колонки.Добавить("Группа");
	ТаблицаРегистраторов.Колонки.Добавить("РегистраторМеталлы");
	ТаблицаРегистраторов.Колонки.Добавить("РегистраторВставки"); 
	ТаблицаРегистраторов.Колонки.Добавить("РегистраторСтавки");
		
	Ломбарды = Регистратор.Ломбарды.ВыгрузитьКолонку("Ломбард"); 
	Если Ломбарды.Количество() = 0 Тогда 
		ЗапросЛ = Новый Запрос;
		ЗапросЛ.Текст = "ВЫБРАТЬ
		                |	ЛБ_Ломбарды.Ссылка КАК Ссылка
		                |ИЗ
		                |	Справочник.ЛБ_Ломбарды КАК ЛБ_Ломбарды
		                |ГДЕ
		                |	ЛБ_Ломбарды.ЭтоГруппа = ЛОЖЬ
		                |	И ЛБ_Ломбарды.Закрыт = ЛОЖЬ";
		ВыборкаЛ = ЗапросЛ.Выполнить().Выбрать();
		Пока ВыборкаЛ.Следующий() Цикл 
			Ломбарды.Добавить(ВыборкаЛ.Ссылка);
		КонецЦикла;	
	КонецЕсли;	
		
	ЗапросЛ = Новый Запрос; 
	ЗапросЛ.УстановитьПараметр("Дата", Регистратор.Дата);
	ЗапросЛ.УстановитьПараметр("Ломбарды", Ломбарды);
	ЗапросЛ.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.ЛБ_ГруппыЛомбардов.СрезПоследних(&Дата, Ломбард В (&Ломбарды)) КАК ЛБ_ГруппыЛомбардовСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Период УБЫВ";
	ТаблицаЛомбардов = ЗапросЛ.Выполнить().Выгрузить();   
		
	Для каждого СтрЛ Из ТаблицаЛомбардов Цикл
	    НоваяСтр = ТаблицаРегистраторов.Добавить();
		НоваяСтр.Ломбард = СтрЛ.Ломбард; 
		НоваяСтр.Группа = СтрЛ.Группа;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Регистратор.Дата);
	Запрос.УстановитьПараметр("ДатаНачалаДействия", Регистратор.ДатаНачалаДействияПриказа);
	Запрос.УстановитьПараметр("Ломбарды", Ломбарды);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(
	               |			&Дата,
	               |			Ломбард В (&Ломбарды)
	               |				И ДатаНачалаДействия <= &ДатаНачалаДействия) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЭлементМассива Из Ломбарды Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", ЭлементМассива);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если НЕ строки.Количество() = 0 Тогда
		    Стр = Строки.Получить(0);
		    РегистраторМеталлы = Стр.Регистратор;
			
			СтрокиР = ТаблицаРегистраторов.НайтиСтроки(Отбор); 
			Если СтрокиР.Количество() = 0 Тогда
				СтрР = ТаблицаРегистраторов.Добавить();
				СтрР.Ломбард = ЭлементМассива; 
				СтрР.Группа = Справочники.ЛБ_ГруппыЛомбардов.ПустаяСсылка();
			Иначе	
			    СтрР = СтрокиР.Получить(0);
			КонецЕсли;	
		    СтрР.РегистраторМеталлы = РегистраторМеталлы;
		КонецЕсли;	
	Конеццикла;	     
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СрезПоследних(
	               |			&Дата,
	               |			Ломбард В (&Ломбарды)
	               |				И ДатаНачалаДействия <= &ДатаНачалаДействия) КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЭлементМассива Из Ломбарды Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", ЭлементМассива);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если НЕ строки.Количество() = 0 Тогда
		    Стр = Строки.Получить(0);
		    РегистраторВставки = Стр.Регистратор;
			
			СтрокиР = ТаблицаРегистраторов.НайтиСтроки(Отбор);  
			Если СтрокиР.Количество() = 0 Тогда
				СтрР = ТаблицаРегистраторов.Добавить();
				СтрР.Ломбард = ЭлементМассива; 
				СтрР.Группа = Справочники.ЛБ_ГруппыЛомбардов.ПустаяСсылка();
			Иначе	
			    СтрР = СтрокиР.Получить(0); 
			КонецЕсли;	
		    СтрР.РегистраторВставки = РегистраторВставки;
		КонецЕсли;	
	Конеццикла;	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок.СрезПоследних(
	               |			&Дата,
	               |			Ломбард В (&Ломбарды)
	               |				И ДатаНачалаДействия <= &ДатаНачалаДействия) КАК ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЭлементМассива Из Ломбарды Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", ЭлементМассива);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если НЕ строки.Количество() = 0 Тогда
		    Стр = Строки.Получить(0);
		    РегистраторСтавки = Стр.Регистратор;
			
			СтрокиР = ТаблицаРегистраторов.НайтиСтроки(Отбор); 
			Если СтрокиР.Количество() = 0 Тогда
				СтрР = ТаблицаРегистраторов.Добавить();
				СтрР.Ломбард = ЭлементМассива; 
				СтрР.Группа = Справочники.ЛБ_ГруппыЛомбардов.ПустаяСсылка();
			Иначе	
			    СтрР = СтрокиР.Получить(0);  
			КонецЕсли;	
		    СтрР.РегистраторСтавки = РегистраторСтавки;
		КонецЕсли;	
	Конеццикла;	

	Возврат ТаблицаРегистраторов;
КонецФункции

