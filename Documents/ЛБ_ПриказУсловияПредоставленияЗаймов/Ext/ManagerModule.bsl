Функция ПолучитьСтрокуЛомбардов(Дата, СписокЛ) 
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбарды", СписокЛ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.ЛБ_ГруппыЛомбардов.СрезПоследних(&Дата, Ломбард В (&Ломбарды)) КАК ЛБ_ГруппыЛомбардовСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();   
	
	ТаблицаЛомбардов = Новый ТаблицаЗначений;
	ТаблицаЛомбардов.Колонки.Добавить("Группа");
	ТаблицаЛомбардов.Колонки.Добавить("Ломбард");
	
	Для каждого Эл из СписокЛ Цикл 
		Отбор = новый структура;
		Отбор.Вставить("Ломбард", Эл.Значение);
		
		СтрокиЗапроса = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если СтрокиЗапроса.Количество() = 0 Тогда 
			СтрЛ = ТаблицаЛомбардов.Добавить(); 
			СтрЛ.Группа = "<...> (";
			СтрЛ.Ломбард = Эл.Значение;
		Иначе   
			СтрЗапроса = СтрокиЗапроса.Получить(0); 
			СтрЛ = ТаблицаЛомбардов.Добавить(); 
			СтрЛ.Группа = сокрЛП(СтрЗапроса.Группа) + " (";
			СтрЛ.Ломбард = СтрЗапроса.Ломбард;
		КонецЕсли;	
	Конеццикла;	                             
	ТаблицаЛомбардов.Сортировать("Группа, Ломбард");
	ТаблицаГрупп = ТаблицаЛомбардов.Скопировать(); 
	ТаблицаГрупп.Свернуть("Группа");
	
	СтрокаВозврата = ""; 
	Для каждого СтрГ из ТаблицаГрупп Цикл
		СтрокаВозврата = СтрокаВозврата + ?(ПустаяСтрока(СтрокаВозврата), "", "; ") + СтрГ.Группа;
		ОтборГ = новый структура;
		ОтборГ.Вставить("Группа", стрГ.Группа);   
		
		Строки = ТаблицаЛомбардов.НайтиСтроки(ОтборГ);
		Ном = 0;
		Для каждого Стр Из Строки Цикл
			СтрокаВозврата = СтрокаВозврата + ?(Ном = 0, "", ", ") + ?(ЗначениеЗаполнено(Стр.Ломбард.НомерЛомбарда), "№ "+ СокрЛП(Стр.Ломбард.НомерЛомбарда), СокрЛП(Стр.Ломбард)); 
			Ном = Ном + 1;
		Конеццикла;	    
		СтрокаВозврата = СтрокаВозврата + ")";
	Конеццикла;	
	
	Возврат СтрокаВозврата;
КонецФункции

Функция ПолучитьСтрокуОтделенийЛомбардов(Дата, СписокЛ) 
    Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбарды", СписокЛ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард В (&Ломбарды)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();   
	
	ТаблицаЛомбардов = Новый ТаблицаЗначений;
	ТаблицаЛомбардов.Колонки.Добавить("Отделение");
	ТаблицаЛомбардов.Колонки.Добавить("Ломбард");
	
	Для каждого Эл из СписокЛ Цикл 
		Отбор = новый структура;
		Отбор.Вставить("Ломбард", Эл.Значение);
		
		СтрокиЗапроса = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если СтрокиЗапроса.Количество() = 0 Тогда 
			СтрЛ = ТаблицаЛомбардов.Добавить(); 
			СтрЛ.Отделение = "<...>";
			СтрЛ.Ломбард = Эл.Значение;
		Иначе   
			СтрЗапроса = СтрокиЗапроса.Получить(0); 
			СтрЛ = ТаблицаЛомбардов.Добавить(); 
			СтрЛ.Отделение = сокрЛП(СтрЗапроса.Отделение);
			СтрЛ.Ломбард = СтрЗапроса.Ломбард;
		КонецЕсли;	
	Конеццикла;	                             
	ТаблицаЛомбардов.Сортировать("Отделение, Ломбард");
	ТаблицаОтд = ТаблицаЛомбардов.Скопировать(); 
	ТаблицаОтд.Свернуть("Отделение");
	
	СтрокаВозврата = ""; 
	Для каждого СтрГ из ТаблицаОтд Цикл
		СтрокаВозврата = СтрокаВозврата + ?(ПустаяСтрока(СтрокаВозврата), "", "; ") + СтрГ.Отделение;
	Конеццикла;	
	
	Возврат СтрокаВозврата;
КонецФункции	 

#КонецЕсли 

  














