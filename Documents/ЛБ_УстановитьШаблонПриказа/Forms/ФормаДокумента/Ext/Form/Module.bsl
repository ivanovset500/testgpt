	Объект.СтавкиПроцентовАкция.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ПомощникЗаполненияПроцентныхСтавокАкция(Команда)
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораСтавокСК",ЭтаФорма);
    ОткрытьФорму("Справочник.ЛБ_СхемыКредитования.ФормаВыбора",,ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресХранилищаАкция() 
	Возврат ПоместитьВоВременноеХранилище(Объект.СтавкиПроцентовАкция.Выгрузить(), УникальныйИдентификатор);
КонецФункции

&НаСервере
Функция ПолучитьНеПрименятьАкции(СК) 
	Возврат СК.НеПрименятьАкции;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСтавокСК(Результат, ДопПараметры) Экспорт
	 Если Результат = Неопределено Тогда
	    Возврат;
	КонецЕсли;   
	
	Если ПолучитьНеПрименятьАкции(Результат) Тогда  
		Предупреждение("Для выбранной схемы кредитования акции не применимы.", 60);
		Возврат;
	КонецЕсли;	
	
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтавокАкция",ЭтаФорма);  
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СхемаКредитования", Результат);
	ПараметрыФормы.Вставить("Акция", Истина);
	ПараметрыФормы.Вставить("АдресХранилища", ПолучитьАдресХранилищаАкция());
	ОткрытьФорму("Обработка.ЛБ_ПомощникЗаполненияПроцентныхСтавок.Форма", ПараметрыФормы, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораСтавокАкция(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	СК = Результат.СхемаКредитования; 
	Отбор = Новый структура;
	Отбор.Вставить("СхемаКредитования", СК);  
	Строки = Объект.СтавкиПроцентовАкция.НайтиСтроки(Отбор);
	Для каждого стр Из Строки Цикл
	    Объект.СтавкиПроцентовАкция.Удалить(Стр); 
	Конеццикла;	
	Для каждого Стр1 Из Результат.СтатусыКлиентов Цикл   
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Стр1.Статус); 
		Для каждого Стр2 Из Результат.ДниНачалаПрименения.НайтиСтроки(Отбор) Цикл 
			Для каждого Стр3 Из Результат.ДиапазоныСумм.НайтиСтроки(Отбор) Цикл 
				НоваяСтр = Объект.СтавкиПроцентовАкция.Добавить(); 
				НоваяСтр.СхемаКредитования = СК;
			    НоваяСтр.СтатусЗалогодателя = Стр1.Статус;
				НоваяСтр.ПричинаПрименения = Стр2.ПричинаПрименения; 
				НоваяСтр.ДиапазонСумм = Стр3.ДиапазонСумм;
			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненийОчистить(Команда)
	Объект.НастройкаОтклоненийОтБазовыхЦен.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненийОтБазовыхЦенПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущиеДанные;
	ТекСтрока = Элементы.НастройкаОтклоненийОтБазовыхЦен.ТекущиеДанные;
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекСтрока.КлючСтроки = СтрокаТабличнойЧасти.КлючСтроки; 
		ТекСтрока.Металл = СтрокаТабличнойЧасти.Металл;  
		ТекСтрока.ОтклонениеОтБазовойЦены  = СтрокаТабличнойЧасти.ОтклонениеОтБазовойПоУмолчанию;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненийОтБазовыхЦенПробаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	СтандартнаяОбработка = Ложь;    
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораПробы",ЭтаФорма);
	СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущиеДанные;
	ПараметрыОтбора = новый Структура("Металл", СтрокаТабличнойЧасти.Металл);
    ПараметрыФормы = Новый Структура("Отбор", ПараметрыОтбора);
    ОткрытьФорму("Справочник.ЛБ_ГруппыПроб.ФормаВыбора", ПараметрыФормы,ЭтаФорма,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры  

&НаКлиенте
Процедура ПослеВыбораПробы(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
