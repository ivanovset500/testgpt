	СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущаяСтрока;
	Если НЕ СтрокаТабличнойЧасти = неопределено Тогда
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораСК",ЭтаФорма);
	    ОткрытьФорму("Справочник.ЛБ_СхемыКредитования.ФормаВыбора",,ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;	
