&НаКлиенте
Процедура ПослеВыбораОтклонения(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	ЗаполнитьТаблицуОтборовМ(Результат);
	
	ТекСтрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	Для каждого СтрМ Из ТаблицаОтборовМеталл Цикл
		
		Отбор = Новый Структура; 
	    Отбор.Вставить("Металл", СтрМ.Металл);
	    Отбор.Вставить("Проба", СтрМ.Проба);
	    Отбор.Вставить("КатегорияОбъектаЗалога", СтрМ.Категория);
	 
	    Строки = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			//ЗаполнитьПоНастройкамНаСервере(ТекСтрока.ПолучитьИдентификатор(), СтрМ.ПолучитьИдентификатор());
			Если НЕ (СтрМ.Проба = ТекСтрока.БазоваяПроба И СтрМ.Категория = ТекСтрока.БазоваяКатегория) Тогда
				НоваяСтр = Объект.ОценкаПоБазовойКатегории.Добавить();
				НоваяСтр.Ключстроки = ТекСтрока.КлючСтроки;
				НоваяСтр.Металл = СтрМ.Металл;
				НоваяСтр.Проба = СтрМ.Проба;
				НоваяСтр.КатегорияОбъектаЗалога = СтрМ.Категория;
	            НоваяСтр.ЗначениеОтклонения = СтрМ.Отклонение;	
				НоваяСтр.ОклонениеОтБазовой = СтрМ.ВидОтклонения; 
				НоваяСтр.ПорядокОкругления = ТекСтрока.ПорядокОкругления; 
				НоваяСтр.ОкруглятьВБольшуюСторону = ТекСтрока.ОкруглятьВБольшуюСторону;
			КонецЕсли;	
	    Иначе
		   Для каждого Стр Из Строки Цикл	
			   Стр.ЗначениеОтклонения = СтрМ.Отклонение;	
			   Стр.ОклонениеОтБазовой = СтрМ.ВидОтклонения; 
		   КонецЦикла;	
	    КонецЕсли;  
	Конеццикла;  
	Объект.ОценкаПоБазовойКатегории.Сортировать("Металл, Проба, КатегорияОбъектаЗалога");  
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);
	Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтклоненияОсн(Команда)
	Объект.ОценкаПоБазовойКатегории.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура БазовыеНастройкиМеталлПриИзменении(Элемент)
	ТекСтрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	Отбор = новый структура;
	Отбор.Вставить("Металл", ТекСтрока.Металл);
	Строки = Объект.БазовыеНастройки.НайтиСтроки(Отбор);
	Если Строки.количество() > 1 Тогда 
		Сообщить("Металл " + СокрЛП(ТекСтрока.Металл) + " уже выбран в табличной части!", Статуссообщения.Внимание); 
		ТекСтрока.Металл = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеМеталлы.ПустаяСсылка");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура БазовыеНастройкиОтклонениеОтБазовойПоУмолчаниюПриИзменении(Элемент)
	//+МАН 11.03.25 Добавил проверку и условие. Заявка 3654
	Отбор = Новый Структура;
	Отбор.Вставить("Металл", ТекущийЭлемент.ТекущиеДанные.Металл);
	
