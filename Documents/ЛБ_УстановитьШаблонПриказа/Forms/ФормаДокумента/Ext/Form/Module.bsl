&НаКлиенте
Процедура ПослеВыбораВставки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Вставка", Результат); 
	ПараметрыФормы.Вставить("АдресХранилища", ПолучитьАдресХранилищаВставки());
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораХарактеристикВставки",ЭтаФорма);
    ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыбораХарактеристикВставки", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ПослеВыбораХарактеристикВставки(Результат, ДопПараметры) Экспорт
	 Если Результат = Неопределено Тогда
	    Возврат;
	КонецЕсли;  
	
	ТаблицаВ = ПолучитьИзВременногоХранилища(Результат.АдресХранилища);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Вставка", Результат.Вставка);
	Строки = Объект.Вставки.НайтиСтроки(Отбор); 
	Для каждого Стр Из Строки Цикл  
		Объект.Вставки.Удалить(стр);
	КонецЦикла;	
	
	Если НЕ ТаблицаВ.Количество() = 0 Тогда
		Запрос  = Новый Запрос;
		Запрос.УстановитьПараметр("Владелец", Результат.Вставка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ВесовыеГруппыДрагоценныхКамней.Ссылка КАК ВесоваяГруппа
		               |ИЗ
		               |	Справочник.ЛБ_ВесовыеГруппыДрагоценныхКамней КАК ЛБ_ВесовыеГруппыДрагоценныхКамней
		               |ГДЕ
		               |	ЛБ_ВесовыеГруппыДрагоценныхКамней.ВидДрагоценногоКамня = &Владелец
		               |	И ЛБ_ВесовыеГруппыДрагоценныхКамней.ПометкаУдаления = ЛОЖЬ";
		Выборка = Запрос.Выполнить().Выбрать(); 
		Если Выборка.Количество() = 0 Тогда 
			Для каждого стр Из ТаблицаВ Цикл
				НоваяСтр = Объект.Вставки.Добавить();
				НоваяСтр.Вставка = Результат.Вставка;
				НоваяСтр.ФормаОгранки = Стр.ФормаОгранки;
				НоваяСтр.ВидОгранки = Стр.ВидОгранки;
				НоваяСтр.КачествоОгранки = Стр.КачествоОгранки;
			КонецЦикла;	
		Иначе
			Пока Выборка.Следующий() Цикл
				Для каждого стр Из ТаблицаВ Цикл
					НоваяСтр = Объект.Вставки.Добавить();
					НоваяСтр.Вставка = Результат.Вставка;
					НоваяСтр.ФормаОгранки = Стр.ФормаОгранки;
					НоваяСтр.ВидОгранки = Стр.ВидОгранки;
					НоваяСтр.КачествоОгранки = Стр.КачествоОгранки;
					НоваяСтр.ВесоваяГруппа = Выборка.ВесоваяГруппа;
				КонецЦикла;	
			КонецЦикла;	 
		КонецЕсли;	
		Объект.Вставки.Сортировать("Вставка, ФормаОгранки, ВидОгранки, КачествоОгранки, ВесоваяГруппа");
    КонецЕсли;
КонецПроцедуры


