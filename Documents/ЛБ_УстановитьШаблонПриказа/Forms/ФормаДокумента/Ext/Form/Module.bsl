&НаСервере
Функция ПолучитьКлючСтроки()
	Возврат ЛБ_ОбщийМодуль.ПолучитьКлючСтроки(Объект, "БазовыеНастройки");
КонецФункции	

&НаКлиенте
Процедура БазовыеНастройкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущиеДанные;
		СтрокаТабличнойЧасти.КлючСтроки = ПолучитьКлючСтроки(); 
	КонецЕсли;	
КонецПроцедуры      

&НаКлиенте
Процедура БазовыеНастройкиБазоваяЦенаПоЗапросуПриИзменении(Элемент)
	ТекСтрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	Если ТекСтрока.БазоваяЦенаПоЗапросу Тогда
		ТекСтрока.БазоваяЦена = 0;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура БазовыеНастройкиПриАктивизацииСтроки(Элемент)
	СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущиеДанные;	
	
	Если СтрокаТабличнойЧасти <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧасти.КлючСтроки);
		Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
		Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура БазовыеНастройкиПередУдалением(Элемент, Отказ)
	СтрокаТабличнойЧастиНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;
	
	Если СтрокаТабличнойЧастиНастройки <> Неопределено Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиНастройки.КлючСтроки);
		
		НайденныеСтроки = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Объект.ОценкаПоБазовойКатегории.Удалить(Строка);	
		КонецЦикла; 
		
		НайденныеСтроки = Объект.НастройкаОтклоненийОтБазовыхЦен.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Объект.НастройкаОтклоненийОтБазовыхЦен.Удалить(Строка);	
		КонецЦикла; 
	КонецЕсли; 
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьПробыПоБазовой(Идентификатор) 
	СтрокаТабличнойЧастиНастройки = Объект.БазовыеНастройки.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТабличнойЧастиНастройки = неопределено Тогда
		Возврат;
	КонецЕсли;
	ЕстьОшибкиЗаполнения = ложь;
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.Металл) Тогда
		Сообщить("Строка № " + Строка(СтрокаТабличнойЧастиНастройки.НомерСтроки) + ": Не выбран металл!");
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяКатегория) Тогда
		Сообщить("Строка № " + Строка(СтрокаТабличнойЧастиНастройки.НомерСтроки) + ": Не определена базовая категория объектов залога!");
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяПроба) Тогда
		Сообщить("Строка № " + Строка(СтрокаТабличнойЧастиНастройки.НомерСтроки) + ":Не определена базовая проба (группа проб)!");
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;	 
	Если ЕстьОшибкиЗаполнения Тогда
		Возврат;
	КонецЕсли;	   
	
	ОтборК = Новый Структура;
	ОтборК.Вставить("КлючСтроки", СтрокаТабличнойЧастиНастройки.КлючСтроки);
	СтрокиК = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(ОтборК);
	Для каждого стрК из СтрокиК Цикл 
		Объект.ОценкаПоБазовойКатегории.Удалить(СтрК);
	КонецЦикла;	   
	
	СписокПроб = Новый СписокЗначений;
	СписокКатегорий = Новый СписокЗначений;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Металл", СтрокаТабличнойЧастиНастройки.Металл);
	СтрокиМ = Объект.Металлы.НайтиСтроки(Отбор);
	Для каждого СтрМ из СтрокиМ Цикл   
		ГруппаП = ЛБ_ОбщийМодуль.ПолучитьГруппуПроб(СтрМ.Проба);
		Если СписокПроб.НайтиПоЗначению(ГруппаП) = неопределено Тогда
			СписокПроб.Добавить(ГруппаП);
		КонецЕсли;	
		Если СписокКатегорий.НайтиПоЗначению(СтрМ.КатегорияОбъектаЗалога) = неопределено Тогда
			СписокКатегорий.Добавить(СтрМ.КатегорияОбъектаЗалога);
		КонецЕсли;	
	Конеццикла;	
	
	Для каждого Проба Из СписокПроб Цикл
		Для каждого Категория Из СписокКатегорий Цикл 
			 Если Проба.Значение = СтрокаТабличнойЧастиНастройки.БазоваяПроба И
				  Категория.Значение = СтрокаТабличнойЧастиНастройки.БазоваяКатегория Тогда
				 Продолжить;
			 КонецЕсли; 
			 
			 ЕстьЗаписьМеталлы = ложь;
			 ОтборМ = Новый Структура;
			 ОтборМ.Вставить("Металл", СтрокаТабличнойЧастиНастройки.Металл);
			 ОтборМ.Вставить("КатегорияОбъектаЗалога", Категория.Значение);  
			 Для каждого СтрП Из Проба.Значение.Пробы Цикл
				 ОтборМ.Вставить("Проба", СтрП.Проба); 
				 СтрокиМ = Объект.Металлы.НайтиСтроки(ОтборМ);
				 Если СтрокиМ.Количество() = 0 Тогда
					Продолжить; 
				 Иначе   
					ЕстьЗаписьМеталлы = Истина;
					Прервать;
				 КонецЕсли;	 
			 КонецЦикла;	
			 Если НЕ ЕстьЗаписьМеталлы Тогда
				Продолжить;
			 КонецЕсли;	
			 
			 НоваяСтр = Объект.ОценкаПоБазовойКатегории.Добавить();
			 НоваяСтр.КлючСтроки = СтрокаТабличнойЧастиНастройки.КлючСтроки;
			 НоваяСтр.КатегорияОбъектаЗалога = Категория.Значение;
			 НоваяСтр.Металл = СтрокаТабличнойЧастиНастройки.Металл;
			 НоваяСтр.Проба = Проба.Значение; 
			 НоваяСтр.ОклонениеОтБазовой = СтрокаТабличнойЧастиНастройки.ОтклонениеОтБазовойПоУмолчанию;
			 НоваяСтр.ПорядокОкругления = СтрокаТабличнойЧастиНастройки.ПорядокОкругления;
			 НоваяСтр.ОкруглятьВБольшуюСторону = СтрокаТабличнойЧастиНастройки.ОкруглятьВБольшуюСторону;
		 Конеццикла;	 
	 КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗаполнитьПоБазовой(Команда) 
	СтрокаТабличнойЧастиНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;
	Если СтрокаТабличнойЧастиНастройки = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.Металл) ИЛИ 
		   НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяПроба) ИЛИ
		     НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяКатегория) Тогда
		Сообщить("Перед заполнением в верхней таблице должны быть выбраны металл, базовая проба и базовая категория!", СтатусСообщения.Информация);	 
	КонецЕсли;	

	ЗаполнитьПробыПоБазовой(СтрокаТабличнойЧастиНастройки.ПолучитьИдентификатор()); 
		
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиНастройки.КлючСтроки);
	Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПроб(Металл) 
	Отбор= Новый Структура;
	Отбор.Вставить("Металл", Металл);
	Строки = Объект.Металлы.НайтиСтроки(Отбор); 
	СписокМ = Новый СписокЗначений;
	Для каждого Стр Из Строки Цикл 
		СписокМ.Добавить(Стр.Проба);
	КонецЦикла;
	Возврат СписокМ;
КонецФункции 

&НаСервере
Функция ПолучитьСписокКатегорий(Металл) 
	Отбор= Новый Структура;
	Отбор.Вставить("Металл",Металл);
	Строки = Объект.Металлы.НайтиСтроки(Отбор); 
	СписокК = Новый СписокЗначений;
	Для каждого Стр Из Строки Цикл 
		СписокК.Добавить(Стр.КатегорияОбъектаЗалога);
	КонецЦикла;	 
	Возврат СписокК;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗначениеОтклоненияМеталлы(Команда) 
	ТекСтрокаНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;  
	Если ТекСтрокаНастройки = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("Вид", 0);  
	Если НЕ Элементы.БазовыеНастройки.ТекущиеДанные = неопределено Тогда
	    ПараметрыФормы.Вставить("Металл", ТекСтрокаНастройки.Металл);  
		ПараметрыФормы.Вставить("ВидОтклонения", ТекСтрокаНастройки.ОтклонениеОтБазовойПоУмолчанию);  
		ПараметрыФормы.Вставить("СписокП", ПолучитьСписокПроб(ТекСтрокаНастройки.Металл));
		ПараметрыФормы.Вставить("СписокК", ПолучитьСписокКатегорий(ТекСтрокаНастройки.Металл));
	КонецЕсли;   
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОтклонения", ЭтаФорма);
	ОткрытьФорму("Документ.ЛБ_УстановитьШаблонПриказа.Форма.ФормаЗаполненияОтклонения", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьПоНастройкамНаСервере(ИдентификаторСтроки, ИдентификаторСтрокиОтбор) 
	СтрокаБазовая = Объект.БазовыеНастройки.НайтиПоИдентификатору(ИдентификаторСтроки);
	СтрокаН = ТаблицаОтборовМеталл.НайтиПоИдентификатору(ИдентификаторСтрокиОтбор);
	
	ОтборБ = Новый Структура;
    ОтборБ.Вставить("Металл", СтрокаН.Металл);
	ОтборБ.Вставить("Проба", СтрокаН.Проба);
    ОтборБ.Вставить("КатегорияОбъектаЗалога", СтрокаН.Категория);
	
	СтрокиБ = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(ОтборБ);
	Если СтрокиБ.Количество() = 0 Тогда 
		НоваяСтр = Объект.ОценкаПоБазовойКатегории.Добавить(); 
		НоваяСтр.КлючСтроки = СтрокаБазовая.КлючСтроки;
		НоваяСтр.Металл = СтрокаБазовая.Металл;
		НоваяСтр.Проба = ОтборБ.Проба; 
		НоваяСтр.КатегорияОбъектаЗалога = ОтборБ.КатегорияОбъектаЗалога;
		НоваяСтр.ЗначениеОтклонения = СтрокаН.Отклонение;
		НоваяСтр.ОклонениеОтБазовой = СтрокаН.ВидОтклонения;  
		НоваяСтр.ПорядокОкругления = СтрокаБазовая.ПорядокОкругления; 
		НоваяСтр.ОкруглятьВБольшуюСторону = СтрокаБазовая.ОкруглятьВБольшуюСторону; 
	Иначе	  
		Стр = СтрокиБ.Получить(0);
		Стр.ЗначениеОтклонения = СтрокаН.Отклонение;
		Стр.ОклонениеОтБазовой = СтрокаН.ВидОтклонения;  
	КонецЕсли;
КонецПроцедуры  

