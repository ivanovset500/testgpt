&НаКлиенте
Процедура ЗаполнитьЗначениеОтклоненияНастройки(Команда)
	ТекСтрокаН = Элементы.БазовыеНастройки.ТекущиеДанные; 
	Если ТекСтрокаН = неопределено Тогда
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("Вид", 1);  
	Если НЕ Элементы.БазовыеНастройки.ТекущиеДанные = неопределено Тогда
	    ПараметрыФормы.Вставить("Металл", ТекСтрокаН.Металл);  
		ПараметрыФормы.Вставить("ВидОтклонения", ТекСтрокаН.ОтклонениеОтБазовойПоУмолчанию);
		ПараметрыФормы.Вставить("СписокП", ПолучитьСписокПроб(ТекСтрокаН.Металл));
		ПараметрыФормы.Вставить("СписокК", ПолучитьСписокКатегорий(ТекСтрокаН.Металл));
	КонецЕсли;   
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОтклоненияНастройки", ЭтаФорма);
	ОткрытьФорму("Документ.ЛБ_УстановитьШаблонПриказа.Форма.ФормаЗаполненияОтклонения", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОтклоненияНастройки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	ЗаполнитьТаблицуОтборовМ(Результат);
	
	ТекСтрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	Для каждого СтрМ Из ТаблицаОтборовМеталл Цикл
		
		Отбор = Новый Структура; 
		Отбор.Вставить("СхемаКредитования", Результат.СхемаКредитования);
		Отбор.Вставить("Металл", СтрМ.Металл);
		Отбор.Вставить("Проба", СтрМ.Проба);
	    Отбор.Вставить("КатегорияОбъектаЗалога", СтрМ.Категория);
	    Строки = Объект.НастройкаОтклоненийОтБазовыхЦен.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			НоваяСтр = Объект.НастройкаОтклоненийОтБазовыхЦен.Добавить();  
			НоваяСтр.КлючСтроки = ТекСтрока.КлючСтроки;
			НоваяСтр.СхемаКредитования = Результат.СхемаКредитования; 
			НоваяСтр.КатегорияОбъектаЗалога = СтрМ.Категория;  
			НоваяСтр.Металл = СтрМ.Металл;
			НоваяСтр.Проба = СтрМ.Проба;
			НоваяСтр.ЗначениеОтклонения = СтрМ.Отклонение;	
			НоваяСтр.ОтклонениеОтБазовойЦены = СтрМ.ВидОтклонения; 
	    Иначе
		   Для каждого Стр Из Строки Цикл	
			   Стр.ЗначениеОтклонения = СтрМ.Отклонение;	
			   Стр.ОтклонениеОтБазовойЦены = СтрМ.ВидОтклонения; 
		   КонецЦикла;	
	    КонецЕсли;  
	Конеццикла;  
	Объект.НастройкаОтклоненийОтБазовыхЦен.Сортировать("СхемаКредитования, Металл, Проба, КатегорияОбъектаЗалога"); 
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);	
	Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);

КонецПроцедуры

