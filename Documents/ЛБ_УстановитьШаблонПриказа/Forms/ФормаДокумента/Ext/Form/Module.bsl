&НаКлиенте
Процедура ПослеВыбораСК(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	СтрокаТабличнойЧастиНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;
	СК = Результат;  
	ЗаполнитьНастройкиОтклоненийНаСервере(СК, СтрокаТабличнойЧастиНастройки.ПолучитьИдентификатор());
	
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", СтрокаТабличнойЧастиНастройки.КлючСтроки);
	Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкиОтклоненийНаСервере(СК, ИдентификаторСтроки) 
	СтрокаТабличнойЧастиНастройки = Объект.БазовыеНастройки.НайтиПоИдентификатору(ИдентификаторСтроки);
    ОтборК = Новый Структура;
	ОтборК.Вставить("КлючСтроки", СтрокаТабличнойЧастиНастройки.КлючСтроки);
	ОтборК.Вставить("СхемаКредитования", СК);
	СтрокиК = Объект.НастройкаОтклоненийОтБазовыхЦен.НайтиСтроки(ОтборК);
	Для каждого стрК из СтрокиК Цикл 
		Объект.НастройкаОтклоненийОтБазовыхЦен.Удалить(СтрК);
	КонецЦикла;	   
	
	СписокПроб = Новый СписокЗначений;
	СписокКатегорий = Новый СписокЗначений;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Металл", СтрокаТабличнойЧастиНастройки.Металл);
	СтрокиМ = Объект.Металлы.НайтиСтроки(Отбор);
	Для каждого СтрМ из СтрокиМ Цикл   
		ГруппаП = ЛБ_ОбщийМодуль.ПолучитьГруппуПроб(СтрМ.Проба);
		Если СписокПроб.НайтиПоЗначению(ГруппаП) = неопределено Тогда
			СписокПроб.Добавить(ГруппаП);
		КонецЕсли;	
		Если СписокКатегорий.НайтиПоЗначению(СтрМ.КатегорияОбъектаЗалога) = неопределено Тогда
			СписокКатегорий.Добавить(СтрМ.КатегорияОбъектаЗалога);
		КонецЕсли;	
	Конеццикла;	
	
	Для каждого Проба Из СписокПроб Цикл
		Для каждого Категория Из СписокКатегорий Цикл 
			 ЕстьЗаписьМеталлы = ложь;
			 ОтборМ = Новый Структура;
			 ОтборМ.Вставить("Металл", СтрокаТабличнойЧастиНастройки.Металл);
			 ОтборМ.Вставить("КатегорияОбъектаЗалога", Категория.Значение);  
			 Для каждого СтрП Из Проба.Значение.Пробы Цикл
				 ОтборМ.Вставить("Проба", СтрП.Проба); 
				 СтрокиМ = Объект.Металлы.НайтиСтроки(ОтборМ);
				 Если СтрокиМ.Количество() = 0 Тогда
					Продолжить; 
				 Иначе   
					ЕстьЗаписьМеталлы = Истина;
					Прервать;
				 КонецЕсли;	 
			 КонецЦикла;	
			 Если НЕ ЕстьЗаписьМеталлы Тогда
				Продолжить;
			 КонецЕсли;	

			 НоваяСтр = Объект.НастройкаОтклоненийОтБазовыхЦен.Добавить();
			 НоваяСтр.КлючСтроки = СтрокаТабличнойЧастиНастройки.КлючСтроки; 
			 НоваяСтр.СхемаКредитования = СК;
			 НоваяСтр.КатегорияОбъектаЗалога = Категория.Значение;
			 НоваяСтр.Металл = СтрокаТабличнойЧастиНастройки.Металл;
			 НоваяСтр.Проба = Проба.Значение; 
			 НоваяСтр.ОтклонениеОтБазовойЦены = СтрокаТабличнойЧастиНастройки.ОтклонениеОтБазовойПоУмолчанию;
		 Конеццикла;	 
	 КонецЦикла;	
КонецПроцедуры	

