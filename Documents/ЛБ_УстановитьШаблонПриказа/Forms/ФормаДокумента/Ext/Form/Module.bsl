&НаСервере
Процедура УстановитьВидимостьПоВидуОперации()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавки Тогда 
		Элементы.СтраницаМеталлы.Видимость = Ложь;
		Элементы.СтраницаВставки.Видимость = Ложь;
		Элементы.СтраницаСтавкиПроцентов.Видимость = Истина; 
		Элементы.СтраницаСтавкиПроцентовАкция.Видимость = Ложь;
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.Металлы Тогда 
		Элементы.СтраницаМеталлы.Видимость = Истина;
		Элементы.СтраницаВставки.Видимость = Ложь;
		Элементы.СтраницаСтавкиПроцентов.Видимость = Ложь; 
		Элементы.СтраницаСтавкиПроцентовАкция.Видимость = Ложь;
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.Вставки Тогда
		Элементы.СтраницаМеталлы.Видимость = Ложь;
		Элементы.СтраницаВставки.Видимость = Истина;
		Элементы.СтраницаСтавкиПроцентов.Видимость = Ложь;
		Элементы.СтраницаСтавкиПроцентовАкция.Видимость = Ложь; 
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавкиАкция Тогда
		Элементы.СтраницаМеталлы.Видимость = Ложь;
		Элементы.СтраницаВставки.Видимость = Ложь;
		Элементы.СтраницаСтавкиПроцентов.Видимость = Ложь;
		Элементы.СтраницаСтавкиПроцентовАкция.Видимость = Истина;	
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры          


&НаСервере
Процедура ОчиститьРеквизитыПоВидуОперации()
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавки Тогда
		Объект.Акция = Справочники.ЛБ_Акции.ПустаяСсылка();
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.Металлы Тогда 
		Объект.Акция = Справочники.ЛБ_Акции.ПустаяСсылка();
		Объект.СхемаКредитования = Справочники.ЛБ_СхемыКредитования.ПустаяСсылка();
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.Вставки Тогда
		Объект.Акция = Справочники.ЛБ_Акции.ПустаяСсылка(); 
		Объект.СхемаКредитования = Справочники.ЛБ_СхемыКредитования.ПустаяСсылка();
	ИначеЕсли Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийУстановитьШаблонПриказа.ПроцентныеСтавкиАкция Тогда
		Объект.СхемаКредитования = Справочники.ЛБ_СхемыКредитования.ПустаяСсылка();
	КонецЕсли;	
КонецПроцедуры

