&НаКлиенте
Процедура ДобавитьПоМеталлу(Команда)
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораМеталла",ЭтаФорма);
    ОткрытьФорму("Справочник.ЛБ_ДрагоценныеМеталлы.ФормаВыбора",,ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораМеталла(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Отбор = новый Структура;
	Отбор.Вставить("Металл", Результат);
	СтрокиМ = Объект.Металлы.НайтиСтроки(Отбор); 
	Для каждого стрМ Из СтрокиМ Цикл
		Объект.Металлы.Удалить(СтрМ);
	Конеццикла;
	
	Запрос  = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Результат);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_Пробы.Ссылка КАК Проба
	               |ИЗ
	               |	Справочник.ЛБ_Пробы КАК ЛБ_Пробы
	               |ГДЕ
	               |	ЛБ_Пробы.Владелец = &Владелец
	               |	И ЛБ_Пробы.ПометкаУдаления = ЛОЖЬ";
	ТаблицаПроб = Запрос.Выполнить().Выгрузить();
	
	ВыборкаСпр = Справочники.ЛБ_КатегорииОбъектовЗалога.Выбрать();
	Пока ВыборкаСпр.Следующий() Цикл
		Если ВыборкаСпр.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;	    
		Отбор = Новый Структура;
		Отбор.Вставить("КатегорияОбъектаЗалога", ВыборкаСпр.Ссылка);
		Для каждого стр Из ТаблицаПроб Цикл 
			Отбор.Вставить("Проба", Стр.Проба);  
			СтрокиМ = Объект.Металлы.НайтиСтроки(Отбор);
			Если СтрокиМ.Количество() = 0 Тогда
				НоваяСтр = Объект.Металлы.Добавить();
				НоваяСтр.Проба = Стр.Проба;
				НоваяСтр.Металл = Стр.Проба.Владелец;
			    НоваяСтр.КатегорияОбъектаЗалога = ВыборкаСпр.Ссылка;  
			КонецЕсли;	
		Конеццикла;	
	КонецЦикла;	
	Объект.Металлы.Сортировать("Металл, Проба, КатегорияОбъектаЗалога");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьМеталлы(Команда)
	Объект.Металлы.Очистить();
КонецПроцедуры

&НаСервере
Функция ПолучитьВыбранныеМеталлы()   
	ТаблицаМеталлов = Объект.Металлы.Выгрузить(, "Металл");   
	ТаблицаМеталлов.Свернуть("Металл");
	
	МассивМ = Новый Массив;
	Для каждого Стр Из ТаблицаМеталлов Цикл  
		МассивМ.Добавить(Стр.Металл);
	КонецЦикла;	                      
	Возврат МассивМ;
КонецФункции	

&НаКлиенте
Процедура СтраницыМПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "СтраницаМ2" Тогда
		Элементы.БазовыеНастройкиМеталл.СписокВыбора.ЗагрузитьЗначения(ПолучитьВыбранныеМеталлы()); 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура БазовыеНастройкиБазоваяПробаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Текстрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	ПараметрыОтбора = новый Структура("Металл", Текстрока.Металл);
	ПараметрыФормы = Новый Структура("Отбор", ПараметрыОтбора);   
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораГруппыМеталла",ЭтаФорма);
	ОткрытьФорму("Справочник.ЛБ_ГруппыПроб.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОбработкаВыбора);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораГруппыМеталла(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	Текстрока = Элементы.БазовыеНастройки.ТекущиеДанные;
