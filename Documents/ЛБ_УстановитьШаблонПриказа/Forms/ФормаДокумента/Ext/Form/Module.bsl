&НаСервере
Функция ПолучитьАдресХранилища() 
	Возврат ПоместитьВоВременноеХранилище(Объект.СтавкиПроцентов.Выгрузить(), УникальныйИдентификатор);
КонецФункции	

&НаКлиенте
Процедура ПомощникЗаполненияПроцентныхСтавок(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.СхемаКредитования) Тогда
		Сообщить("Не выбрана схема кредитования!");
		Возврат;
	КонецЕсли;	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтавок",ЭтаФорма);  
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СхемаКредитования", Объект.СхемаКредитования);
	ПараметрыФормы.Вставить("АдресХранилища", ПолучитьАдресХранилища());
	ОткрытьФорму("Обработка.ЛБ_ПомощникЗаполненияПроцентныхСтавок.Форма", ПараметрыФормы, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораСтавок(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Объект.СтавкиПроцентов.Очистить();
	Для каждого Стр1 Из Результат.СтатусыКлиентов Цикл   
		Отбор = Новый Структура;
		Отбор.Вставить("Статус", Стр1.Статус); 
		Для каждого Стр2 Из Результат.ДниНачалаПрименения.НайтиСтроки(Отбор) Цикл 
			Для каждого Стр3 Из Результат.ДиапазоныСумм.НайтиСтроки(Отбор) Цикл 
				НоваяСтр = Объект.СтавкиПроцентов.Добавить(); 
			    НоваяСтр.СтатусЗалогодателя = Стр1.Статус;
				НоваяСтр.ПричинаПрименения = Стр2.ПричинаПрименения; 
				НоваяСтр.ДеньНачалаПрименения = Стр2.ДеньНачалаПрименения;
				НоваяСтр.ДиапазонСумм = Стр3.ДиапазонСумм;
			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура СписокЛомбардовНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = ложь;
	
	ПараметрыФормы = Новый Структура;    
	ПараметрыФормы.Вставить("Ломбарды", Объект.Ломбарды); 
	ПараметрыФормы.Вставить("ДатаДок", Объект.Дата);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораЛомбардов",ЭтаФорма);
	
	ОткрытьФорму("Обработка.ЛБ_ВыборЛомбардовИзСписка.Форма", ПараметрыФормы, Элементы.СписокЛомбардов,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЛомбардов()
	Результат = "";
	Для каждого Стр Из Объект.Ломбарды Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + ?(НЕ ПустаяСтрока(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.НаименованиеПолное), СокрЛП(Стр.Ломбард.Наименование));
	КонецЦикла;	
	СписокЛомбардов = Результат;
	Объект.СтрокаЛомбарды = Результат;
КонецПроцедуры	
 
&НаСервере
Процедура ПослеВыбораЛомбардов(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;

	Объект.Ломбарды.Очистить();
	КоличествоВыбрано = Результат.Количество;
	Для сч = 1 По КоличествоВыбрано Цикл
		НоваяСтр = Объект.Ломбарды.Добавить();
		НоваяСтр.Ломбард = Результат["Значение" + Строка(сч)];
	КонецЦикла;	
	
	ЗаполнитьСписокЛомбардов();
КонецПроцедуры


