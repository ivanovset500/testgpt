&НаКлиенте
Процедура СхемаКредитованияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ТекущаяСК = Объект.СхемаКредитования;
КонецПроцедуры

&НаКлиенте
Процедура СхемаКредитованияПриИзменении(Элемент)
	Если НЕ ТекущаяСК = Объект.СхемаКредитования Тогда
		Объект.СтавкиПроцентов.Очистить();
		ТекущаяСК = Объект.СхемаКредитования;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
		Если НЕ НачалоДня(ТекущийОбъект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Если НЕ ЭтоСуперпользователь Тогда 
				 Сообщить("Пользователь имеет право проводить документ только текущей датой. Измените дату документа.", статуссообщения.Важное);
			     Отказ = Истина;
				 Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненийОтБазовыхЦенПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	ТекСтрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", ТекСтрока.КлючСтроки);	
	Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
КонецПроцедуры

&НаКлиенте
Процедура ВставкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	ТекСтрока = Элементы.Вставки.ТекущиеДанные;
	Если ТекСтрока = неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекСтрока.Вставка) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Вставка", ТекСтрока.Вставка); 
		ПараметрыФормы.Вставить("АдресХранилища", ПолучитьАдресХранилищаВставки());
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораХарактеристикВставки",ЭтаФорма);
	    ОткрытьФорму("ОбщаяФорма.ЛБ_ФормаВыбораХарактеристикВставки", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьСостояниеДокумента();
	//+МАН 17.03.26 Изменение заголовка формы. Заявка 3654.
	УстановитьЗаголовокФормы();
	//-МАН
КонецПроцедуры

//+МАН 17.03.26 Изменение заголовка формы. Заявка 3654.
&НаСервере
Процедура УстановитьЗаголовокФормы()
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЭтаФорма.Заголовок = "Установить шаблон приказа №" + Параметры.Ключ.НомерДокументаБезНулей + " от " + Параметры.Ключ.Дата;
	Иначе
		ЭтаФорма.Заголовок = "Установить шаблон приказа (создание)";
	КонецЕсли;
КонецПроцедуры
//-МАН



