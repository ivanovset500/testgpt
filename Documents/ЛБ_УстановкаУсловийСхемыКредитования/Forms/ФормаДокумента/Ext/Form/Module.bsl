
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;   
	Если УправлениеДоступом.ЕстьРоль("ЛБ_Суперпользователь") Тогда 
		ЭтоСуперпользователь = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда		 
		Объект.Дата = ТекущаяДатаСеанса(); 
		Объект.Ответственный = ТекПользователь;
		Если Параметры.Свойство("СхемаКредитования") Тогда  
			Объект.СхемаКредитования = Параметры.СхемаКредитования; 
			Элементы.СхемаКредитования.ТолькоПросмотр = Истина;
		КонецЕсли;
		Если Параметры.Свойство("ДокументКопирования") Тогда
			ЗаполнитьДокументКопированием(Параметры.ДокументКопирования);
			Элементы.СхемаКредитования.ТолькоПросмотр = Истина;
		КонецЕсли;	
	КонецЕсли;    
		
	УстановитьСостояниеДокумента(); 
	
	Если Объект.Проведен Тогда  
		ЭтаФорма.ТолькоПросмотр = Истина;  
		Элементы.Ссуда.ТолькоПросмотр = Истина;
		Элементы.ТехническиеСтавки.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьДокументКопированием(ДокументКопирования) 
	Объект.СрокЗалога = ДокументКопирования.СрокЗалога;
	Объект.СхемаКредитования = ДокументКопирования.СхемаКредитования;
	Объект.УчастиеВРасчетах = ДокументКопирования.УчастиеВРасчетах;  
	Объект.Ссуда.Загрузить(ДокументКопирования.Ссуда.Выгрузить()); 
	Объект.ТехническиеСтавки.Загрузить(ДокументКопирования.ТехническиеСтавки.Выгрузить());

КонецПроцедуры	

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = ОбщегоНазначенияБП.СостояниеДокумента(Объект);
	
КонецПроцедуры          


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда 
		Если НЕ НачалоДня(ТекущийОбъект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Если НЕ ЭтоСуперпользователь Тогда 
				 Сообщить("Пользователь имеет право проводить документ только текущей датой. Измените дату документа.", статуссообщения.Важное);
			     Отказ = Истина;
				 Возврат;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

