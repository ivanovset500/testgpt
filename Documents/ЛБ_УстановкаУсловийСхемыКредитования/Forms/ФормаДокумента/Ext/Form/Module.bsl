&НаКлиенте
Процедура СсудаСтатусЗалогодателяОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	Отбор = новый Структура;
	Отбор.Вставить("СтатусЗалогодателя", ВыбранноеЗначение); 
	Строки = Объект.Ссуда.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		Предупреждение("Статус " + СокрЛП(ВыбранноеЗначение) + " уже добавлен в таблицу!", 60);
	    ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.ЛБ_СтатусыЗалогодателей.ПустаяСсылка");  
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТехническиеСтавкиДеньНачалаПримененияОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Отбор = новый Структура;
	Отбор.Вставить("ДеньНачалаПрименения", число(Текст)); 
	Строки = Объект.ТехническиеСтавки.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		Предупреждение("В таблицу уже добавлена строка с днем начала примения технической ставки " + СокрЛП(Текст) + "!", 60);
	    Элементы.ТехническиеСтавки.ТекущиеДанные.ДеньНачалаПрименения = 0;  
	КонецЕсли;
КонецПроцедуры
