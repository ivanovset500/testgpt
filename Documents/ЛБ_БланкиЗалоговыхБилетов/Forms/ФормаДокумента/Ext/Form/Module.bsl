&НаКлиенте
Процедура ДобавитьСтрокуСНомером(Номер)
		
	Отбор = новый Структура("Номер",Номер);
	Массив = Объект.БланкиБилетов.НайтиСтроки(Отбор);
	Если Массив.Количество() =  0 тогда
		
		 НоваяСтрока = Объект.БланкиБилетов.Добавить();
		 НоваяСтрока.Номер = Номер;
		 НоваяСтрока.Количество = 1;
		 
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Функция СгенерироватьНомерБланка(Сч)

	НомерБланка = Префикс;

	СтрокаНомер = Формат(Сч, "ЧГ=0");
	
	Если НЕ ЗначениеЗаполнено(ДлинаНомера) Тогда
		
		НомерБланка = НомерБланка + СтрокаНомер;
		
	Иначе
		
		НомерБланка = НомерБланка + ДополнитьСтроку(СтрокаНомер, ДлинаНомера - СтрДлина(Префикс), СимволДополнения);
		
	КонецЕсли;


	Возврат НомерБланка;

КонецФункции

&НаКлиенте
Функция ДополнитьСтроку(Знач Стр, Длина, Чем=" ", Режим = 0) Экспорт
	
	СимволовДополнить = Длина -  СтрДлина(Стр);
	Добавок = "";
	Для Н=1 по СимволовДополнить Цикл
		Добавок =	Добавок + Чем;
	КонецЦикла;
	Возврат ?(Режим=0, Добавок + Стр, Стр + Добавок);
	
КонецФункции 

&НаКлиенте
Функция ДанныеКорректны(ВыводитьСообщения = Истина)
	
	Отказ = Ложь;

	Если НЕ ЗначениеЗаполнено(НачальныйНомер) Тогда
		
		Если ВыводитьСообщения Тогда
			
			Сообщить("Не указан начальный номер!");
			
		КонецЕсли;
		
		Отказ = Истина;
		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КонечныйНомер) Тогда
		
		Если ВыводитьСообщения Тогда
			Сообщить("Не указан конечный номер!");
			
		КонецЕсли;
		
		Отказ = Истина;
		
	КонецЕсли;

	Если ЗначениеЗаполнено(НачальныйНомер)
		И ЗначениеЗаполнено(КонечныйНомер) Тогда

		Если НачальныйНомер > КонечныйНомер Тогда
			
			Если ВыводитьСообщения Тогда
				
				Сообщить("Начальный номер не может быть больше конечного!");
				
			КонецЕсли;
			
			Отказ = Истина;
			
		КонецЕсли;

		Если ЗначениеЗаполнено(ДлинаНомера) Тогда
			
			Если Цел(Log10(КонечныйНомер)) + 1 > ДлинаНомера Тогда
				
				Если ВыводитьСообщения Тогда
					
					Сообщить("Длина конечного номера больше, чем параметр ""Длина номера""!");
					
				КонецЕсли;
				
				Отказ = Истина;
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;

	СуммДлинаНомера = СтрДлина(Префикс) + СтрДлина(Формат(КонечныйНомер, "ЧГ=0"));
	
	Если СуммДлинаНомера > ДлинаНомера Тогда
		
		Если ВыводитьСообщения Тогда
			
			Сообщить("Суммарная длина номера (" + СуммДлинаНомера + ") больше допустимой (" + ДлинаНомера + ")!");
			
		КонецЕсли;
		
		Отказ = Истина;
		
	КонецЕсли;

	Возврат НЕ Отказ;

КонецФункции // ДанныеКорректны()

&НаКлиенте
// Управляет видимостью элементов формы.
//
Процедура УстановитьВидимость()

	Если ДанныеКорректны(Ложь) Тогда
		
		КоличествоБилетов = КонечныйНомер - НачальныйНомер + 1;
		Пример            = СгенерироватьНомерБланка(Цел((НачальныйНомер + КонечныйНомер) / 2));
		
	Иначе
		
		КоличествоБилетов = 0;
		Пример            = "";
		
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ВидПриИзмененииНаСервере()
	
	Если Объект.ВидОперации = Перечисления.ЮС_ВидыОперацийОприходованиеБланков.Залог Тогда
		ЭтаФорма.Заголовок = "Оприходование бланков. Залог";
	КонецЕсли;
	
КонецПроцедуры

