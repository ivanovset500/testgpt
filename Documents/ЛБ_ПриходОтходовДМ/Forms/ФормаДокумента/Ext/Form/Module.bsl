
&НаКлиенте
Перем НеРедактировать Экспорт;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ВидОперации.СписокВыбора.Очистить();
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийОтходыДМ.Оприходовать);
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийОтходыДМ.ПринятьПеремещение);
	
	Если НЕ ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Объект.Дата = ТекущаяДата();
		
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		Иначе
			Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
		КонецЕсли;
		
		Если Параметры.Свойство("Ломбард") Тогда
			Объект.Ломбард = Параметры.Ломбард;
		Иначе
			Объект.Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		КонецЕсли;
		
		//+МАН 17.12.25
		ЗаполнитьСклады(Истина);
		
		Если Параметры.Свойство("Склад") Тогда
			Объект.Склад = Параметры.Склад;
		КонецЕсли;
		//-МАН
		
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
		
		ЕстьДействующие = ПолучитьДейтствующиюТару(Объект.Ломбард);
		
		Если ЕстьДействующие.Дуствующая <> Неопределено Тогда
			Объект.ВесТары = ЕстьДействующие.Ссылка.ВесТары;
			Объект.Тара = ЕстьДействующие.Ссылка;
		КонецЕсли;

		Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОтходыДМ.Оприходовать;
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОтходыДМ.ПринятьПеремещение Тогда
		ЗаполнитьЛомбардыОтправители(Объект.Дата, Объект.Ломбард, Объект.Склад);
	КонецЕсли;

	//+МАН 17.12.25
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЗаполнитьСклады();
	КонецЕсли;
	//-МАН
	
	Если Объект.Склад.ВидСклада = Перечисления.ЛБ_ВидыСкладов.ОтходыДМЦО Тогда
		Элементы.ВидОперации.СписокВыбора.Очистить();
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийОтходыДМ.Оприходовать);
	КонецЕсли;
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДейтствующиюТару(Ломбард)

	Результат = Новый Структура("Ссылка, Дуствующая");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_Тара.Ссылка КАК Ссылка,
		|	ЛБ_Тара.ДейстующаяТара КАК ДейстующаяТара
		|ИЗ
		|	Справочник.ЛБ_Тара КАК ЛБ_Тара
		|ГДЕ
		|	ЛБ_Тара.Ломбард = &Ломбард
		|	И ЛБ_Тара.ДейстующаяТара = ИСТИНА";
	
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Результат.Ссылка = РезультатЗапроса.Ссылка;
		Результат.Дуствующая = РезультатЗапроса.ДейстующаяТара;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

