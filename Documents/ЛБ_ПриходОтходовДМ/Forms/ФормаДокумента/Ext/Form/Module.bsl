КонецПроцедуры

&НаСервере
Процедура РасчитатьВес()
	Если Объект.БезТары Тогда
		Объект.ВесБезТары = Объект.ВесОбщий;
	Иначе
		Объект.ВесБезТары = Объект.ВесОбщий - Объект.ВесТары;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(Объект.Тара) И НЕ Объект.БезТары Тогда
		Предупреждение("Внимание! Для оприходования отходов ДМ необходимо добавить действующую тару в «Справочник тары»!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ВесОбщий = 0 Тогда
		Предупреждение("Не указан вес!
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ВесОбщий > 0 И Объект.ВесБезТары = 0 Тогда
		Предупреждение("Вес нетто не может быть равен нулю.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	//+МАН 17.12.25
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Предупреждение("Не выбран склад получатель.
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОтходыДМ.ПринятьПеремещение") Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ЛомбардОтправитель) Тогда
			Предупреждение("Не выбран ломбард отправитель.
			|Проведение документа невозможно.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
			Предупреждение("Не выбран склад отправитель.
			|Проведение документа невозможно.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//-МАН
	
	УстановитьПользователя();

КонецПроцедуры

&НаСервере
Процедура УстановитьПользователя()
	Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	Иначе
		Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()

	Если Объект.Проведен Тогда
		НеРедактировать = Истина;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
		//+МАН 15.01.25
		Элементы.ВыбратьДокументПеремещения.Доступность = Ложь;
		//-МАН
	Иначе
		НеРедактировать = Ложь;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
		//+МАН 15.01.25
		Элементы.ВыбратьДокументПеремещения.Доступность = Истина;
		//-МАН
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЭтаФорма.Заголовок = "Приход отходов ДМ " + Объект.НомерДокумента + " от " + Объект.Дата;
	Иначе
		ЭтаФорма.Заголовок = "Приход отходов ДМ";
	КонецЕсли;
	
	//+МАН 17.12.25
	Если Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОтходыДМ.Оприходовать Тогда
		Элементы.ГруппаПеремещения.Видимость = Ложь;
		//Элементы.ГруппаПриходПеремещения.Видимость = Ложь;
		Элементы.ВесОбщий.ТолькоПросмотр = Ложь;
		Элементы.БезТары.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.ГруппаПеремещения.Видимость = Истина;
		//Элементы.ГруппаПриходПеремещения.Видимость = Истина;
		Элементы.ВесОбщий.ТолькоПросмотр = Истина;
		Элементы.БезТары.ТолькоПросмотр = Истина;
	КонецЕсли;

	Если Объект.БезТары Тогда
		Элементы.ВесТары.Видимость = Ложь;
		Элементы.ВесОбщий.Заголовок = "Вес без тары, гр";
	Иначе
		Элементы.ВесТары.Видимость = Истина;
		Элементы.ВесОбщий.Заголовок = "Вес с тарой, гр";
	КонецЕсли;
	//-МАН
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьВидимость();
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		ИЛИ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Оповестить("Проведение_ЛБ_ПриходОтходовДМ", "ОбновитьСписок", Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

//+МАН 17.12.25
&НаСервере
Функция ЗаполнитьСписокВыбораСкладов(Ломбард)

	МассивСкладов = Новый Массив;
	
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_Склады.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛБ_Склады КАК ЛБ_Склады
		               |ГДЕ
		               |	ЛБ_Склады.Владелец = &Владелец
		               |	И (ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМ)
		               |			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМЦО)
		               |			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМОбщий))";
		Запрос.УстановитьПараметр("Владелец", Ломбард);

		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивСкладов.Добавить(Выборка.Ссылка);
		Конеццикла;
	КонецЕсли;
	
	Возврат МассивСкладов;
КонецФункции

&НаСервере
Процедура ЗаполнитьСклады(НовыйДокумент = Ложь)
	Если ЗначениеЗаполнено(Объект.Ломбард) Тогда
		Склады = ЗаполнитьСписокВыбораСкладов(Объект.Ломбард);
		
		Если Склады.Количество() > 1 Тогда
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(Склады);
		ИначеЕсли Склады.Количество() = 1 Тогда
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.Добавить(Склады[0]);
			
			Если НЕ НовыйДокумент Тогда
				Объект.Склад = Склады[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЛомбардОтправитель) Тогда
		Склады = ЗаполнитьСписокВыбораСкладов(Объект.ЛомбардОтправитель);
		
		Если Склады.Количество() > 1 Тогда
			Элементы.СкладОтправитель.СписокВыбора.Очистить();
			Элементы.СкладОтправитель.СписокВыбора.ЗагрузитьЗначения(Склады);
		ИначеЕсли Склады.Количество() = 1 Тогда
			Элементы.СкладОтправитель.СписокВыбора.Очистить();
			Элементы.СкладОтправитель.СписокВыбора.Добавить(Склады[0]);

			Если НЕ НовыйДокумент Тогда
				Объект.СкладОтправитель = Склады[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Объект.БезТары = Истина;
	
	УстановитьВидимость();
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийОтходыДМ.ПринятьПеремещение") Тогда
		ЗаполнитьЛомбардыОтправители(Объект.Дата, Объект.Ломбард, Объект.Склад);
	Иначе
		Объект.ЛомбардОтправитель = ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ПустаяСсылка");
		Объект.СкладОтправитель = ПредопределенноеЗначение("Справочник.ЛБ_Склады.ПустаяСсылка");
		СброситьДанныеПеремещения();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛомбардыОтправители(Дата, Ломбард, Склад)

	Элементы.ЛомбардОтправитель.СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтходыДМВПутиОстатки.ЛомбардОтправитель КАК ЛомбардОтправитель
		|ИЗ
		|	РегистрНакопления.ЛБ_ОтходыДМВПути.Остатки(
		|			&Дата,
		|			ЛомбардПолучатель = &ЛомбардПолучатель
		|				И Организация = &Организация
		|				И СкладПолучатель = &Склад
		|				И 111 = 111) КАК ЛБ_ОтходыДМВПутиОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛБ_ОтходыДМВПутиОстатки.ЛомбардОтправитель
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛомбардОтправитель УБЫВ";
	
	Если Ломбард <> Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "ЛомбардОтправитель В
		|					(ВЫБРАТЬ
		|						ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|					ИЗ
		|						РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, ВЫБОР
		|							КОГДА Отделение В
		|									(ВЫБРАТЬ
		|										ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|									ИЗ
		|										РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &ЛомбардПолучатель) КАК ЛБ_ОтделенияЛомбардовСрезПоследних)
		|								ТОГДА ИСТИНА
		|							ИНАЧЕ ЛОЖЬ
		|						КОНЕЦ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|					ГДЕ
		|						НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		|						И НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.ПометкаУдаления)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЛомбардПолучатель", Ломбард);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Если Результат.ЛомбардОтправитель = Ломбард Тогда
			Продолжить;
		КонецЕсли;
		Элементы.ЛомбардОтправитель.СписокВыбора.Добавить(Результат.ЛомбардОтправитель);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЛомбардОтправительПриИзменении(Элемент)
	ЗаполнитьСклады();
	
	//Если ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
	//	ПолучитьДоступныйОстаток();
	//КонецЕсли;
	
	СброситьДанныеПеремещения();

КонецПроцедуры

Процедура ПолучитьДоступныйОстаток();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтходыДМВПутиОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
		|ИЗ
		|	РегистрНакопления.ЛБ_ОтходыДМВПути.Остатки(
		|			&Дата,
		|			ЛомбардПолучатель = &ЛомбардПолучатель
		|				И Организация = &Организация
		|				И ЛомбардОтправитель = &ЛомбардОтправитель
		|				И СкладОтправитель = &СкладОтправитель
		|				И СкладПолучатель = &Склад) КАК ЛБ_ОтходыДМВПутиОстатки";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("ЛомбардПолучатель", Объект.Ломбард);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ЛомбардОтправитель", Объект.ЛомбардОтправитель);
	Запрос.УстановитьПараметр("СкладОтправитель", Объект.СкладОтправитель);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Объект.ВесОбщий = Результат.ВесНеттоОстаток;
		Объект.ВесБезТары = Результат.ВесНеттоОстаток;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
	//ПолучитьДоступныйОстаток()
	СброситьДанныеПеремещения();
КонецПроцедуры

&НаКлиенте
Процедура СброситьДанныеПеремещения()
	Объект.ДокументПеремещения = ПредопределенноеЗначение("Документ.ЛБ_РасходОтходовДМ.ПустаяСсылка");
	Объект.ВесОбщий = 0;
	Объект.ВесБезТары = 0;
	Объект.НомерНакладнойПеремещения = "";
	Объект.ДатаДокументаПеремещения = Дата(1,1,1);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументПеремещения(Команда)
	
	Если ЗначениеЗаполнено(Объект.ЛомбардОтправитель) И ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЛомбардПолучатель", Объект.Ломбард);
		ПараметрыФормы.Вставить("СкладПолучатель", Объект.Склад);
		ПараметрыФормы.Вставить("ЛомбардОтправитель", Объект.ЛомбардОтправитель);
		ПараметрыФормы.Вставить("СкладОтправитель", Объект.СкладОтправитель);
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("Форма", "Документ");
		
		ОписаниеОповещенияПослеВыбораДокумента = Новый ОписаниеОповещения("ПослеВыбораДокумента", ЭтотОбъект);
		
		ОткрытьФорму("Документ.ЛБ_ПриходОтходовДМ.Форма.ФормаВПути", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещенияПослеВыбораДокумента, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Сообщить("Невыбран ломбард или склад отправитель");
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораДокумента(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДокументПеремещения = Результат;
	Объект.ВесОбщий = Результат.ВесБезТары;
	Объект.ВесБезТары = Результат.ВесБезТары;
	Объект.НомерНакладнойПеремещения = Результат.НомерНакладной;
	Объект.ДатаДокументаПеремещения = Результат.Дата;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардОтправительНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Если Элемент.СписокВыбора.Количество() = 0 Тогда
		Предупреждение("Нет перещений для оприходования");
		Возврат
	КонецЕсли;
КонецПроцедуры
