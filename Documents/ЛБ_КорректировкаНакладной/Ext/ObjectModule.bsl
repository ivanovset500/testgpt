			Движение.ЗалоговыйБилет = ЗалоговыйБилет;
	        Движение.Залогодатель = ЗалоговыйБилет.Залогодатель;
	        Движение.Организация = Организация;   
			СтрДок = Строки.Получить(0);
			Движение.Ломбард = СтрДок.Ломбард;  
			ДатаБлокировки = ПолучитьДатуПоследнейБлокировки(ЗалоговыйБилет);
			Движение.Комментарий = "Отмена блокировки" + ?(ДатаБлокировки = неопределено, "", " до " + Формат(ДатаБлокировки, "ДФ=dd.MM.yyyy")) +
			    ?(НЕ ПустаяСтрока(СтрДок.ОснованиеБлокировки), ", основание: " + СтрДок.ОснованиеБлокировки, "");  
			Движение.ОтменаБлокировки = Истина;	
				
			Движение = Движения.ЛБ_ЗалоговыеБилетыЗаблокированные.Добавить(); 
			Движение.Период = Дата;
            Движение.ЗалоговыйБилет = ЗалоговыйБилет;
			Движение.Статус = Перечисления.ЛБ_СтатусыБлокировкиЗБ.ОтменаБлокировки; 
		КонецЦикла;	              
		
	ИначеЕсли ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ОтменаОтгрузкиНакладных Тогда	
