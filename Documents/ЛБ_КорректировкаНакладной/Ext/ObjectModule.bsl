			КонецЕсли;;                      
		Конеццикла;	
		
		ЗапросОтгрузки = Новый Запрос;  
		ЗапросОтгрузки.УстановитьПараметр("Дата", Дата); 
		ЗапросОтгрузки.Текст = "ВЫБРАТЬ
		                       |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Регистратор КАК Регистратор,
		                       |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Период КАК Период
		                       |ИЗ
		                       |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке
		                       |ГДЕ
		                       |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Период < &Дата
		                       |	И ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку
		                       |	И ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		                       |
		                       |УПОРЯДОЧИТЬ ПО
		                       |	Период УБЫВ";  		
		
		Запрос = Новый Запрос; 
