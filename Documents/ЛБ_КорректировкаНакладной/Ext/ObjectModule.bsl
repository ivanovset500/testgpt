		Запрос.УстановитьПараметр("Накладные", СписокН);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
		               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус
		               |ИЗ
		               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&Дата, НакладнаяНаОтгрузку В (&Накладные)) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних"; 
		ТаблицаСтатусовВНакладных = Запрос.Выполнить().Выгрузить();  
		
		Запрос.Текст = "ВЫБРАТЬ
