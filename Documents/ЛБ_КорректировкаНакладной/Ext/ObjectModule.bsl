				ДвижениеН.НакладнаяНаОтгрузку = ВыборкаН.НакладнаяНаОтгрузку; 
				ДвижениеН.НомерНакладной = ВыборкаН.НомерНакладной;
				ДвижениеН.ДатаНакладной = ВыборкаН.ДатаНакладной;
				ДвижениеН.ОтказОтВыкупа = ВыборкаН.ОтказОтВыкупа;
				ДвижениеН.ПовышеннаяОценка = ВыборкаН.ПовышеннаяОценка;
