	 
	 
Функция ПолучитьДатуПоследнейБлокировки(ЗалоговыйБилет)   
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Дата", Дата);  
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗалоговыйБилет);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.ДатаБлокировки КАК ДатаБлокировки
	               |ИЗ
	               |	РегистрСведений.ЛБ_ЗалоговыеБилетыЗаблокированные КАК ЛБ_ЗалоговыеБилетыЗаблокированные
	               |ГДЕ
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.Статус = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыБлокировкиЗБ.Блокировка)
	               |	И ЛБ_ЗалоговыеБилетыЗаблокированные.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ЛБ_ЗалоговыеБилетыЗаблокированные.Период < &Дата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ЗалоговыеБилетыЗаблокированные.Период УБЫВ"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ДатаБлокировки;
	КонецЕсли;	               
	Возврат неопределено;
КонецФункции	
	 
// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения) 
	Если ЭтотОбъект.ВидОперации = Перечисления.ЛБ_ВидыКорректировкиНакладной.ИсключениеЗБИзНакладной Тогда  
		ТаблицаНакладных = ЭтотОбъект.ЗалоговыеБилеты.Выгрузить();
		ТаблицаНакладных.Свернуть("НакладнаяНаОтгрузку"); 
		Для каждого стрН Из ТаблицаНакладных Цикл    
			Отбор = Новый Структура;
			Отбор.Вставить("НакладнаяНаОтгрузку", стрН.НакладнаяНаОтгрузку);
			СписокОЗ = Новый СписокЗначений; 
			СписокЗБ = Новый СписокЗначений;
			Строки = ЗалоговыеБилеты.НайтиСтроки(Отбор);
			Для каждого стр Из Строки Цикл 
				Если СписокОЗ.НайтиПоЗначению(Стр.ОбъектЗалога) = неопределено Тогда
				    СписокОЗ.Добавить(Стр.ОбъектЗалога);  
				КонецЕсли;	
				Если СписокЗБ.НайтиПоЗначению(Стр.ЗалоговыйБилет) = неопределено Тогда
				    СписокЗБ.Добавить(Стр.ЗалоговыйБилет);  
				КонецЕсли;
			КонецЦикла;	
			//МоментДоДокумента = Новый Граница(Новый МоментВремени(стрН.НакладнаяНаОтгрузку.Дата, стрН.НакладнаяНаОтгрузку), ВидГраницы.Исключая);
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Дата", стрН.НакладнаяНаОтгрузку.Дата-1);
			Запрос.УстановитьПараметр("ОбъектыЗалога", СписокОЗ);
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОценкиНачальная КАК СуммаОценкиНачальная,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОценки КАК СуммаОценки,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаЗайма КАК СуммаЗайма,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаОплаты КАК СуммаОплаты,
			               |	ЛБ_СостояниеОбъектаЗалогаСрезПоследних.СуммаДолгаЗайма КАК СуммаДолгаЗайма
			               |ИЗ
			               |	РегистрСведений.ЛБ_СостояниеОбъектаЗалога.СрезПоследних(&Дата, ОбъектЗалога В (&ОбъектыЗалога)) КАК ЛБ_СостояниеОбъектаЗалогаСрезПоследних";
			ТаблицаОЗ = Запрос.Выполнить().Выгрузить();  			
			
			Запрос.УстановитьПараметр("ДатаДок", Дата);
			Запрос.УстановитьПараметр("Накладная", СтрН.НакладнаяНаОтгрузку);
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
			               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ЗалоговыйБилет КАК ЗалоговыйБилет,
			               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
			               |	ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних.Статус КАК Статус
			               |ИЗ
			               |	РегистрСведений.ЛБ_СтатусыОбъектовЗалогаВНакладной.СрезПоследних(&ДатаДок, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_СтатусыОбъектовЗалогаВНакладнойСрезПоследних";
			ТаблицаСтатусовВНакладной = Запрос.Выполнить().Выгрузить();  
			
			Запрос.Текст ="ВЫБРАТЬ
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Ломбард КАК Ломбард,
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет КАК ЗалоговыйБилет,
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога КАК ОбъектЗалога,
			              |	СУММА(ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.КоличествоОстаток) КАК Количество,
			              |	СУММА(ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ВесОстаток) КАК Вес,
			              |	СУММА(ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.СуммаОценкиОстаток) КАК СуммаОценки
			              |ИЗ
			              |	РегистрНакопления.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Остатки(&ДатаДок, НакладнаяНаОтгрузку = &Накладная) КАК ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки
			              |
			              |СГРУППИРОВАТЬ ПО
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ЗалоговыйБилет,
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.ОбъектЗалога,
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.НакладнаяНаОтгрузку,
			              |	ЛБ_ОбъектыЗалогаПодлежащиеОтгрузкеОстатки.Ломбард";
            ТаблицаПодлежитОтгрузке = Запрос.Выполнить().Выгрузить(); 
		
			Движения.ЛБ_СостояниеОбъектаЗалога.Записывать = Истина;
			Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Записывать = Истина;
			Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Записывать = Истина;
			КолИсключить = 0;
			ВесИсключить = 0;  
			СуммаОценкиИсключить = 0;

			Для каждого Стр Из Строки Цикл			
				Движение = Движения.ЛБ_СостояниеОбъектаЗалога.Добавить();
		        Движение.Период = Дата;
				Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
				Движение.ОбъектЗалога = Стр.ОбъектЗалога;
				Отбор = Новый структура;
				Отбор.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
				Отбор.Вставить("ОбъектЗалога", Стр.ОбъектЗалога);
	            СтрокиОЗ = ТаблицаОЗ.НайтиСтроки(Отбор); 
				Если НЕ СтрокиОЗ.Количество() = 0 Тогда
					СтрОЗ = СтрокиОЗ.Получить(0);
					Движение.СтатусОбъектаЗалога = СтрОЗ.СтатусОбъектаЗалога;
					Движение.СуммаОценкиНачальная = СтрОЗ.СуммаОценкиНачальная; 
					Движение.СуммаЗайма = СтрОЗ.СуммаЗайма; 
					Движение.СуммаДолгаЗайма = СтрОЗ.СуммаДолгаЗайма;
					Движение.СуммаОплаты = СтрОЗ.СуммаОплаты;
					Движение.СуммаОценки = СтрОЗ.СуммаОценки; 
				КонецЕсли;
				
				Движение = Движения.ЛБ_СтатусыОбъектовЗалогаВНакладной.Добавить();
				Движение.Период = Дата;
				Движение.ЗалоговыйБилет = Стр.ЗалоговыйБилет;
				Движение.ОбъектЗалога = Стр.ОбъектЗалога;
		       	Движение.НакладнаяНаОтгрузку = Стр.НакладнаяНаОтгрузку;
				Движение.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной;
				
				ОтборС = Новый структура;
				ОтборС.Вставить("ЗалоговыйБилет", Стр.ЗалоговыйБилет); 
				ОтборС.Вставить("ОбъектЗалога", Стр.ОбъектЗалога); 
	            ОтборС.Вставить("НакладнаяНаОтгрузку", СтрН.НакладнаяНаОтгрузку); 
				СтрокиС = ТаблицаСтатусовВНакладной.НайтиСтроки(ОтборС);
				Если НЕ СтрокиС.Количество() = 0 Тогда
					СтрС = СтрокиС.Получить(0);
					СтрС.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной; 
					
					Отбор = Новый структура;
					Отбор.Вставить("ЗалоговыйБилет", СтрС.ЗалоговыйБилет); 
					Отбор.Вставить("ОбъектЗалога", СтрС.ОбъектЗалога); 
					
					СтрокиДок = СтрН.НакладнаяНаОтгрузку.Залоги.НайтиСтроки(Отбор);
					Для каждого СтрДок Из СтрокиДок Цикл
						КолИсключить = КолИсключить + СтрДок.Количество;  
						ВесИсключить = ВесИсключить + СтрДок.Вес;
						СуммаОценкиИсключить = СуммаОценкиИсключить + СтрДок.СуммаОценки;
					КонецЦикла	
				КонецЕсли;    
				
				СтрокиПО = ТаблицаПодлежитОтгрузке.НайтиСтроки(Отбор);
				Если НЕ СтрокиПО.Количество() = 0 Тогда 
					СтрПО = СтрокиПО.Получить(0);
					Движение = Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Добавить();
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
					Движение.Период = Дата;
				    Движение.Организация = ЭтотОбъект.Организация; 
					Движение.Ломбард = СтрПО.Ломбард;   
					Движение.НакладнаяНаОтгрузку = СтрПО.НакладнаяНаОтгрузку;
					Движение.ЗалоговыйБилет = СтрПО.ЗалоговыйБилет;
					Движение.ОбъектЗалога = СтрПО.ОбъектЗалога;
					Движение.Количество = СтрПО.Количество; 
					Движение.Вес = СтрПО.Вес;
					Движение.СуммаОценки = СтрПО.СуммаОценки;
                КонецЕсли;
			Конеццикла;	  
		
			//Если все изделия из накланой исключены 
			Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Записывать = Истина;
			ВсеИсключенные = Истина; 
			Для каждого СтрС Из ТаблицаСтатусовВНакладной Цикл  
				Если НЕ СтрС.Статус = Перечисления.ЛБ_СтатусыОбъектовЗалогаНакладнойНаОтгрузку.ИсключенИзНакладной Тогда 
					ВсеИсключенные = Ложь;
					Продолжить;
				КонецЕсли;	   
			КонецЦикла;
			
			Если ВсеИсключенные Тогда
				ЗапросН = Новый Запрос; 
				ЗапросН.УстановитьПараметр("Дата", Дата-1); 
				ЗапросН.УстановитьПараметр("НакладнаяНаОтгрузку", СтрН.НакладнаяНаОтгрузку);
				ЗапросН.Текст = "ВЫБРАТЬ
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НомерНакладной КАК НомерНакладной,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ДатаНакладной КАК ДатаНакладной,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ОтказОтВыкупа КАК ОтказОтВыкупа,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ПовышеннаяОценка КАК ПовышеннаяОценка,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.СтатусНакладной КАК СтатусНакладной,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Получатель КАК Получатель,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Инкассатор КАК Инкассатор,
				                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Комментарий КАК Комментарий
				                |ИЗ
				                |	РегистрСведений.ЛБ_СтатусыНакладнойНаОтгрузку.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку) КАК ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних";
			    ВыборкаН = ЗапросН.Выполнить().Выбрать();
				Если ВыборкаН.Следующий() Тогда
					Движение = Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Добавить(); 
					Движение.Период = Дата;
					Движение.НакладнаяНаОтгрузку = ВыборкаН.НакладнаяНаОтгрузку; 
					Движение.НомерНакладной = ВыборкаН.НомерНакладной;
					Движение.ДатаНакладной = ВыборкаН.ДатаНакладной;
					Движение.ОтказОтВыкупа = ВыборкаН.ОтказОтВыкупа;
					Движение.ПовышеннаяОценка = ВыборкаН.ПовышеннаяОценка;
					Движение.СтатусНакладной = ВыборкаН.СтатусНакладной;
					Движение.Комментарий = ВыборкаН.Комментарий; 				
					Движение.ОтветственныйСотрудник = ПараметрыСеанса.ТекущийСотрудник;
					Движение.ОтветственныйПользователь = ПараметрыСеанса.ТекущийПользователь;
					Движение.Пустой = Истина;
				КонецЕсли;	
			КонецЕсли;	
			
			Движения.ЛБ_ОборотыПоОперациямЗайма.Записывать = Истина; 			
			Движения.ЛБ_СостояниеЗалоговогоБилета.Записывать = Истина; 
			Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Записывать = Истина;
			Для каждого Элемент Из СписокЗБ Цикл
				ЗалоговыйБилет = Элемент.Значение;				
				Отбор = Новый структура;
				Отбор.Вставить("ЗалоговыйБилет", ЗалоговыйБилет);  
				Строки = ЭтотОбъект.ЗалоговыеБилеты.НайтиСтроки(Отбор);
				
				Движение = Движения.ЛБ_ОборотыПоОперациямЗайма.Добавить();
				Движение.Период = Дата;   
				Движение.ВидОперации = строка(ЭтотОбъект.ВидОперации);
				Движение.ЗалоговыйБилет = ЗалоговыйБилет;
		        Движение.Залогодатель = ЗалоговыйБилет.Залогодатель;
		        Движение.Организация = Организация;
				Движение.Ломбард = Строки.Получить(0).Ломбард; 
				Движение.НакладнаяНаОтгрузку = Строки.Получить(0).НакладнаяНаОтгрузку;  
				Если  Строки.Получить(0).Заблокировать Тогда
				    Движение.Комментарий = "Блокировка до " + Формат(Строки.Получить(0).ДатаБлокировки, "ДФ=dd.MM.yyyy");
				КонецЕсли;	
				
				Движение = Движения.ЛБ_СостояниеЗалоговогоБилета.Добавить(); 
				Движение.Период = Дата;
				Движение.ЗалоговыйБилет = ЗалоговыйБилет;
				Движение.Залогодатель = ЗалоговыйБилет.Залогодатель;
				Движение.НомерЗалоговогоБилета = ЗалоговыйБилет.НомерЗалоговогоБилета; 
				Движение.СхемаКредитования = ЗалоговыйБилет.СхемаКредитования; 
				СтруктураЗБ = ЛБ_ОбщийМодуль.ПолучитьСостояниеЗалоговогоБилетаДоНакладной(СтрН.НакладнаяНаОтгрузку, ЗалоговыйБилет);
				Если НЕ СтруктураЗБ = неопределено Тогда
				    Движение.СуммаЗайма = СтруктураЗБ.СуммаЗайма; 
					Движение.ДатаНачалаРасчетаПроцентов = СтруктураЗБ.ДатаНачалаРасчета;
					Движение.ДатаВыкупа = СтруктураЗБ.ДатаВыкупа;
					Движение.ДатаВыкупаЛьготныйСрок = СтруктураЗБ.ДатаВыкупаЛьготныйСрок;
					Движение.НомерДопСоглашения = СтруктураЗБ.НомерДопСоглашения;
