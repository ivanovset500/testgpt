			Движение.ЗалоговыйБилет = Выборка.ЗалоговыйБилет;
			Движение.ОбъектЗалога = Выборка.ОбъектЗалога;
	       	Движение.НакладнаяНаОтгрузку = Выборка.НакладнаяНаОтгрузку;
			Движение.Статус = НовыйСтаусОбъектаЗалогаВНакладной;
		КонецЦикла; 
		
		ЗапросН = Новый Запрос; 
		ЗапросН.УстановитьПараметр("Дата", Дата-1); 
		ЗапросН.Текст = "ВЫБРАТЬ
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НакладнаяНаОтгрузку КАК НакладнаяНаОтгрузку,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.НомерНакладной КАК НомерНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ДатаНакладной КАК ДатаНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ОтказОтВыкупа КАК ОтказОтВыкупа,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.ПовышеннаяОценка КАК ПовышеннаяОценка,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.СтатусНакладной КАК СтатусНакладной,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Получатель КАК Получатель,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Инкассатор КАК Инкассатор,
		                |	ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних.Комментарий КАК Комментарий
		                |ИЗ
		                |	РегистрСведений.ЛБ_СтатусыНакладнойНаОтгрузку.СрезПоследних(&Дата, НакладнаяНаОтгрузку = &НакладнаяНаОтгрузку) КАК ЛБ_СтатусыНакладнойНаОтгрузкуСрезПоследних";

		Движения.ЛБ_ОбъектыЗалогаПодлежащиеОтгрузке.Записывать = Истина;
		Движения.ЛБ_СтатусыНакладнойНаОтгрузку.Записывать = Истина;
		Для каждого Эл Из СписокН Цикл 
			Накладная = Эл.Значение;  
			ЗапросН.УстановитьПараметр("НакладнаяНаОтгрузку", Накладная);
