&НаСервере
Процедура ЗаполнитьСклады(НовыйДокумент = Ложь)
	Если ЗначениеЗаполнено(Объект.Ломбард) Тогда
		Склады = ЗаполнитьСписокВыбораСкладов(Объект.Ломбард);
		
		Если Склады.Количество() > 1 Тогда
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.ЗагрузитьЗначения(Склады);
		ИначеЕсли Склады.Количество() = 1 Тогда
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.Добавить(Склады[0]);
			
			Если НовыйДокумент Тогда
				Объект.Склад = Склады[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Получатель) Тогда
		Склады = ЗаполнитьСписокВыбораСкладов(Объект.Получатель, Истина);
		
		Если Склады.Количество() > 1 Тогда
			Элементы.СкладПолучатель.СписокВыбора.Очистить();
			Элементы.СкладПолучатель.СписокВыбора.ЗагрузитьЗначения(Склады);
		ИначеЕсли Склады.Количество() = 1 Тогда
			Элементы.СкладПолучатель.СписокВыбора.Очистить();
			Элементы.СкладПолучатель.СписокВыбора.Добавить(Склады[0]);

			Если НовыйДокумент Тогда
				Объект.СкладПолучатель = Склады[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	ДоступныйВес = ПолучитьВесДляРасхода(Объект.Дата, Объект.Ломбард, Объект.Склад);
	Объект.ВесБезТары = ДоступныйВес;
КонецПроцедуры

&НаСервере
Функция ПроверитьДоступныйВес(Ломбард, Склад, Вес, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвижениеОтходовОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвижениеОтходов.Остатки(
		|			&Дата,
		|			Ломбард = &Ломбард
		|				И Склад = &Склад) КАК ЛБ_ДвижениеОтходовОстатки";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ВесНеттоОстаток >= Вес;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
//-МАН



