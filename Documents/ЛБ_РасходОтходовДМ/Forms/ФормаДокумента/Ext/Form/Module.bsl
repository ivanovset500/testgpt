
&НаКлиенте
Перем НеРедактировать Экспорт;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоНовыйДокумент = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Объект.Дата = ТекущаяДата();
		
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
		Иначе
			Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
		КонецЕсли;
		
		Если Параметры.Свойство("Ломбард") Тогда
			Объект.Ломбард = Параметры.Ломбард;
		Иначе
			Объект.Ломбард = ЛБ_УправлениеЛомбардом.ПолучитьОсновнойЛомбардПользователя();
		КонецЕсли;
		
		//+МАН 17.12.25
		ЗаполнитьСклады(Истина);
		
		Если Параметры.Свойство("Склад") Тогда
			Объект.Склад = Параметры.Склад;
		КонецЕсли;
		//-МАН
		
		Если Параметры.Свойство("Вес") Тогда
			Объект.ВесБезТары = Параметры.Вес;
		КонецЕсли;

		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить();
	КонецЕсли;
	
	ЗаполнитьПолучателей(Объект.Дата, Объект.Ломбард);
	ЗаполнитьИнкассаторов(Объект.Дата, Объект.Ломбард);
	
	//+МАН 17.12.25
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЗаполнитьСклады();
	КонецЕсли;
	
	Элементы.ВидОперации.СписокВыбора.Очистить();
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ЛБ_ВидыОперацийОтходыДМ.Переместить);

	Объект.ВидОперации = Перечисления.ЛБ_ВидыОперацийОтходыДМ.Переместить;
	//-МАН
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ВесБезТары = 0 Тогда
		Предупреждение("Не указан вес!
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//+МАН 17.12.25
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Предупреждение("Не выбран склад отправитель!
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	//-МАН
	
	Если НЕ ЗначениеЗаполнено(Объект.Получатель) Тогда
		Предупреждение("Не выбран получатель!
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//+МАН 17.12.25
	Если НЕ ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
		Предупреждение("Не выбран склад получатель!
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	//-МАН
	
	Если НЕ ЗначениеЗаполнено(Объект.Инкассатор)
		И Объект.Получатель <> ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис") Тогда
		Предупреждение("Не выбран инкассатор!
		|Проведение документа невозможно.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЕстьВесДляРасхода = ПроверитьДоступныйВес(Объект.Ломбард, Объект.Склад, Объект.ВесБезТары, ТекущаяДата());
	
	Если НЕ ЕстьВесДляРасхода Тогда
		Предупреждение("Недостаточно веса чтобы провести документ!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	УстановитьПользователя();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПользователя()
	Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	Иначе
		Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()

	Если Объект.Проведен Тогда
		НеРедактировать = Истина;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
	Иначе
		НеРедактировать = Ложь;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
	КонецЕсли;

	Если НЕ НеРедактировать И УправлениеДоступом.ЕстьРоль("ЛБ_СотрудникЦО") Тогда
		Элементы.ВесБезТары.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.ВесБезТары.ТолькоПросмотр = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЭтаФорма.Заголовок = "Расход отходов ДМ " + Объект.НомерДокумента + " от " + Объект.Дата;
	Иначе
		ЭтаФорма.Заголовок = "Расход отходов ДМ";
	КонецЕсли;
	
	Если Объект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
		Элементы.Инкассатор.Видимость = Ложь;
	Иначе
		Элементы.Инкассатор.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьВидимость();
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		ИЛИ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Оповестить("ОтменаПроведения_ЛБ_РасходОтходовДМ", "ОбновитьСписок", Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПолучателей(Дата, Ломбард)
	
	Элементы.Получатель.СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
		|			&Дата,
		|			ВЫБОР
		|				КОГДА Отделение В
		|						(ВЫБРАТЬ
		|							ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|						ИЗ
		|							РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|ГДЕ
		|	НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.НомерЛомбарда";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Если Результат.Ломбард = Ломбард Тогда
			Продолжить;
		КонецЕсли;
		Элементы.Получатель.СписокВыбора.Добавить(Результат.Ломбард);
	КонецЦикла;

	Элементы.Получатель.СписокВыбора.Добавить(Справочники.ЛБ_Ломбарды.ЦентральныйОфис);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнкассаторов(Дата, Ломбард)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(
		|			&Дата,
		|			Подразделение В
		|				(ВЫБРАТЬ
		|					ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ломбард
		|				ИЗ
		|					РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Отделение В
		|						(ВЫБРАТЬ
		|							ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|						ИЗ
		|							РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних)) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|				ГДЕ
		|					НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт)) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
		|ГДЕ
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыКадровыхСобытий.Увольнение)
		|	И (ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяНачальникомОтделения
		|			ИЛИ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяЗаместителемНачальникаОтделения
		|			ИЛИ ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.ЯвляетсяУправляющимЛомбарда)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Должность.Наименование УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Элементы.Инкассатор.СписокВыбора.Добавить(Результат.Сотрудник);
	КонецЦикла;
	
	Если Элементы.Инкассатор.СписокВыбора.Количество() > 0 Тогда
		Объект.Инкассатор = Элементы.Инкассатор.СписокВыбора.Получить(0).Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВесДляРасхода(Дата, Ломбард, Склад)
	
	Запрос = Новый Запрос;
	//+МАН 17.12.25 Изменил запрос
	//Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	ЛБ_ДвижениеОтходовОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
	//	|ИЗ
	//	|	РегистрНакопления.ЛБ_ДвижениеОтходов.Остатки(&Дата, Ломбард = &Ломбард) КАК ЛБ_ДвижениеОтходовОстатки";
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ДвижениеОтходовОстатки.ВесНеттоОстаток КАК ВесНеттоОстаток
		|ИЗ
		|	РегистрНакопления.ЛБ_ДвижениеОтходов.Остатки(
		|			&Дата,
		|			Ломбард = &Ломбард
		|				И Склад = &Склад) КАК ЛБ_ДвижениеОтходовОстатки";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	//+МАН 17.12.25
	Запрос.УстановитьПараметр("Склад", Склад);
	//-МАН
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ВесНеттоОстаток;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВесБезТарыПриИзменении(Элемент)
	
	//+МАН 17.12.25 Изменил
	ДоступныйВес = ПолучитьВесДляРасхода(Объект.Дата, Объект.Ломбард, Объект.Склад);
	//-МАН
	
	Если Объект.ВесБезТары > ДоступныйВес Тогда
		Предупреждение("Вес превышает допустимый!");
		Объект.ВесБезТары = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	Если Объект.Проведен Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИменаМакетов", "РасходнаяНакладная"); 
		ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_РасходОтходовДМ");
		
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("ЗаголовокФормы", "Расход отходов ДМ " + Объект.НомерДокумента + " от " + Объект.Дата);		
		
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		
		ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
		ПараметрыФормы.Вставить("ПараметрыПечати", ПараметрыПечати);
		
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,);   
	Иначе
		Предупреждение("Перед печатью необходимо провести документ!");
	КонецЕсли;	
КонецПроцедуры

