&НаСервере
Функция ЗаполнитьСписокВыбораСкладов(Ломбард, Получатель = Ложь)

	МассивСкладов = Новый Массив;
	
	Если ЗначениеЗаполнено(Ломбард) И ТипЗнч(Ломбард) = Тип("СправочникСсылка.ЛБ_Ломбарды") Тогда
		Запрос = новый Запрос;
		
		Если Объект.Ломбард = Справочники.ЛБ_Ломбарды.ЦентральныйОфис Тогда
			Запрос.Текст = "ВЫБРАТЬ
							|	ЛБ_Склады.Ссылка КАК Ссылка
							|ИЗ
							|	Справочник.ЛБ_Склады КАК ЛБ_Склады
							|ГДЕ
							|	ЛБ_Склады.Владелец = &Владелец
							|	И (ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМЦО)
							|			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМОбщий))
							|	И 111 = 111";
			
			Если Получатель Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "НЕ ЛБ_Склады.Ссылка = &Склад");
			КонецЕсли;
		Иначе
			Запрос.Текст = "ВЫБРАТЬ
							|	ЛБ_Склады.Ссылка КАК Ссылка
							|ИЗ
							|	Справочник.ЛБ_Склады КАК ЛБ_Склады
							|ГДЕ
							|	ЛБ_Склады.Владелец = &Владелец
							|	И (ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМ)
							|			ИЛИ 111 = 111";
			Если Получатель Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМОбщий))");
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "111 = 111", "ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМЦО)
				|			ИЛИ ЛБ_Склады.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыСкладов.ОтходыДМОбщий))");
			КонецЕсли;
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Владелец", Ломбард);
		Запрос.УстановитьПараметр("Склад", Объект.Склад);

		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивСкладов.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСкладов;
КонецФункции

