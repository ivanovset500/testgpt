Функция ПолучитьОтделение(Дата, Ломбард)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
		|ИЗ
		|	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&Дата, Ломбард = &Ломбард) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
		|ГДЕ
		|	НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.Закрыт
		|	И НЕ ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Отделение;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьГород(Ломбард)
	ОтборКИ = Новый Структура;
	ОтборКИ.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес); 
	ОтборКИ.Вставить("Вид", справочники.ВидыКонтактнойИнформации.ФактАдресЛомбарда);
	СтрокиКИ = Ломбард.КонтактнаяИнформация.НайтиСтроки(ОтборКИ);
	Если строкиКИ.Количество() = 0 Тогда 
		Возврат "Адрес ломбарда заполнен строкой, а не по муниципальному или административному делению.";
	Иначе
		Возврат СтрокиКИ.Получить(0).Город;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьДатуОХ(Дата, ОЗ, НомерЗБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор КАК Регистратор,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ВидОперации КАК РегистраторВидОперации,
		|	ЛБ_СостояниеОбъектаЗалога.Период КАК Период,
		|	ЛБ_СостояниеОбъектаЗалога.СтатусОбъектаЗалога КАК СтатусОбъектаЗалога
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеОбъектаЗалога КАК ЛБ_СостояниеОбъектаЗалога
		|ГДЕ
		|	ЛБ_СостояниеОбъектаЗалога.Период <= &Дата
		|	И ЛБ_СостояниеОбъектаЗалога.ОбъектЗалога = &ОбъектЗалога
		|	И (ЛБ_СостояниеОбъектаЗалога.СтатусОбъектаЗалога = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалога.ОтвественноеХранение)
		|			ИЛИ ЛБ_СостояниеОбъектаЗалога.СтатусОбъектаЗалога = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалога.Наследство))
		|	И ЛБ_СостояниеОбъектаЗалога.Регистратор.ОтмененныйДокумент = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
		|	И ЛБ_СостояниеОбъектаЗалога.Регистратор.ДокументОтмены = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
		|	И НЕ ЛБ_СостояниеОбъектаЗалога.Регистратор В
		|				(ВЫБРАТЬ
		|					ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
		|				ИЗ
		|					РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Дата, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|				ГДЕ
		|					ЛБ_ОтменыОперацийЗБСрезПоследних.НомерЗалоговогоБилета ПОДОБНО ""%"" + &НомерЗалоговогоБилета + ""%"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_СостояниеОбъектаЗалога.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	Запрос.УстановитьПараметр("НомерЗалоговогоБилета", НомерЗБ);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Период;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПроверитьНаличиеИзменений(Колонки, Строка)
	Для каждого Элем Из Колонки Цикл
		КолонкаФакт = Колонки.Найти(Элем.Имя + "Факт");
		Если КолонкаФакт <> Неопределено Тогда
			Если Строка[Элем.Имя] <> Строка[Элем.Имя + "Факт"] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

Функция ПолучитьОписаниеОЗ(Дата, ОЗ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога.Код КАК ОбъектЗалогаКод,
		|	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ОписаниеОЗ КАК ОписаниеОЗ
		|ИЗ
		|	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(&Дата, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ОписаниеОЗ;
	Иначе
		Возврат "";
	КонецЕсли;
	
