Функция ПолучитьВставкиВыбывших(ОЗ, МассивОбъектов)
	
	СтруктураВозврата = Новый Структура("Камни, Металлы");

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИнвентаризацияВставкиФакт.ВидВставки КАК ВидВставки,
		|	ЛБ_ИнвентаризацияВставкиФакт.ФормаОгранки КАК ФормаОгранки,
