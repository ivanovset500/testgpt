КонецФункции

Функция ПечатьИНВ19(МассивОбъектов, ОбъектыПечати, Вид)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Шапка = ПолучитьВыборкуШапок_Инв19(МассивОбъектов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ЛБ_Инвентаризация_ИНВ19";
	
	СисИнфо = Новый СистемнаяИнформация;
	Если ПустаяСтрока(СисИнфо.ИнформацияПрограммыПросмотра) Тогда 
		ТабДокумент.ПолеСлева          = 0;
	Иначе
		ТабДокумент.ПолеСлева          = 20;
		ТабДокумент.ПолеСправа         = 0;
	КонецЕсли;

	
	// Получение областей макета.
	Если Вид = "Недостача" Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ19_Недостача");
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ19");
	КонецЕсли;
	ПервыйДокумент = Истина;

	ГраницаНет = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	
	Пока Шапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВыполненныйЗапрос = ПолучитьСтрокиДокумента_Инв19(МассивОбъектов);
		
		ВыборкаСтрокТовары = ВыполненныйЗапрос.Выбрать();
		КолонкиСтрокТоваров = ВыполненныйЗапрос.Колонки;
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();
		
		ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");

		// Вывод шапки документа.
		ОбластьМакетаШапка.Параметры.Заполнить(Шапка);
		
		ОбластьМакетаШапка.Параметры.Подразделение = Шапка.Ломбард.НомерЛомбарда; 
		
		ТабДокумент.Вывести(ОбластьМакетаШапка);
		
		Молы = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование);
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПодвал");
		ОбластьМакета.Параметры.ДатаНачалаИнвентаризации = Формат(Шапка.ДатаНачалаИнвентаризации, "ДЛФ=DD");	
		ТабДокумент.Вывести(ОбластьМакета);		

		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

		НомерСтраницы   = 2;
		ИтогоСуммаОценки = 0;
		ИтогоОстатокЗайма = 0;
		ИтогоКоличество = 0;
		ИтогоОбщийВес = 0;
		ИтогоЧистыйВес = 0;
		СуммаРасхождений = 0;

		// Вывод заголовка таблицы.
		ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ТабДокумент.Вывести(ЗаголовокТаблицы);
		
		Ном = 0;
		// Вывод многострочной части докмента.
		ПодвалНомСтр = Макет.ПолучитьОбласть("СтрокаНомерСтраницы");

		Пока ВыборкаСтрокТовары.Следующий() Цикл
			
			Если Вид = "Новое" И НЕ ПроверитьНаличиеИзменений(КолонкиСтрокТоваров, ВыборкаСтрокТовары) Тогда
				Продолжить;
			ИначеЕсли Вид = "Недостача" И НЕ ВыборкаСтрокТовары.Количество > ВыборкаСтрокТовары.КоличествоФакт Тогда
				Продолжить;
			КонецЕсли;
			
			Ном = Ном + 1;
			
			СтрокаТаблицы = Макет.ПолучитьОбласть("Строка");
			СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары);
			СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", "" + ВыборкаСтрокТовары.Комментарий,
				"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
			
			Если Вид = "Новое" ИЛИ Вид = "Полная" Тогда
				СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.ОбъектЗалога.Наименование) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";
				//СтрокаТаблицы.Параметры.Приемщик = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаСтрокТовары.Приемщик.Сотрудник.Наименование);
				СтрокаТаблицы.Параметры.Приемщик = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаСтрокТовары.Приемщик.Наименование);
				
				СуммаРазность = ВыборкаСтрокТовары.СуммаОценкиФакт - ВыборкаСтрокТовары.СуммаОценки;
				СуммаРасхождений = СуммаРасхождений + СуммаРазность;
				
				СтрокаТаблицы.Параметры.Сумма = СуммаРазность;
			Иначе
				СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.ОбъектЗалога.Наименование) + " " + ВыборкаСтрокТовары.Проба.Наименование;
				СтрокаТаблицы.Параметры.КоличествоФакт = 0;
				СтрокаТаблицы.Параметры.ОбщаяМассаФакт = 0;
				СтрокаТаблицы.Параметры.МассаМеталлаФакт = 0;
				СтрокаТаблицы.Параметры.ПробаФакт = "-";				
				СтрокаТаблицы.Параметры.Проба = ВыборкаСтрокТовары.Проба.Проба;
				
				ИтогоСуммаОценки = ИтогоСуммаОценки + ВыборкаСтрокТовары.СуммаОценки;
				ИтогоОстатокЗайма = ИтогоОстатокЗайма + ВыборкаСтрокТовары.ОстатокЗайма;
				ИтогоКоличество = ИтогоКоличество + ВыборкаСтрокТовары.Количество;
				ИтогоОбщийВес = ИтогоОбщийВес + ВыборкаСтрокТовары.ОбщаяМасса;
				ИтогоЧистыйВес = ИтогоЧистыйВес + ВыборкаСтрокТовары.МассаМеталла;
			КонецЕсли;
			
			СтруктураВставки = ПолучитьВставкиДокумента_АктПроверки(ВыборкаСтрокТовары.ОбъектЗалога, Шапка.Ссылка);
			
			// Проверка вывода.
			СтрокаСПодвалом = Новый Массив;
			СтрокаСПодвалом.Добавить(СтрокаТаблицы);

			//Проверяем влазиет ли строка с описание вставок на один лист
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.Проба);
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			//

			СтрокаСПодвалом.Добавить(ПодвалНомСтр);
			
			Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда

				ОбластьНомерСтраницы = Макет.ПолучитьОбласть("СтрокаНомерСтраницы");
				ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;

				//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
				
				ТабДокумент.Вывести(ОбластьНомерСтраницы);

				НомерСтраницы = НомерСтраницы + 1;
				
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

				ТабДокумент.Вывести(ЗаголовокТаблицы);
			КонецЕсли;

			Если СтруктураВставки.Камни <> Неопределено ИЛИ СтруктураВставки.Металлы <> Неопределено Тогда
				СтрокаТаблицы.Области.Строка.ГраницаСнизу = ГраницаНет;
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.Номер = Ном;
			ТабДокумент.Вывести(СтрокаТаблицы);
			
			КоличествоВставок = 0;

			Если СтруктураВставки.Камни <> Неопределено Тогда
				КоличествоВставок = СтруктураВставки.Камни.Количество();
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				КоличествоВставок = КоличествоВставок + СтруктураВставки.Металлы.Количество();
			КонецЕсли;
			
			ПорядковыйНомерВставки = 1;
			
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрВ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					Если Вид = "Недостача" Тогда
						СтрокаВставки.Параметры.КоличествоФакт = 0;
						СтрокаВставки.Параметры.ВесФакт = 0;
						СтрокаВставки.Параметры.ВидВставкиФакт = "-";
					КонецЕсли;
					
					ТабДокумент.Вывести(СтрокаВставки);
					
					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;

			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрМ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.Проба);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					Если Вид = "Недостача" Тогда
						СтрокаВставки.Параметры.КоличествоФакт = 0;
						СтрокаВставки.Параметры.ВесФакт = 0;
						СтрокаВставки.Параметры.ВидВставкиФакт = "-";
					КонецЕсли;
					
					ТабДокумент.Вывести(СтрокаВставки);

					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;

		КонецЦикла;
		
 		ПодвалОписи = Макет.ПолучитьОбласть("ПодвалОписи");
		ПодвалИтоговМОЛ = Макет.ПолучитьОбласть("ПодвалОписиМол");
		ПодвалНомСтр = Макет.ПолучитьОбласть("СтрокаНомерСтраницы");
		ПодвалИтоги = Макет.ПолучитьОбласть("ПодвалИтоги");
		
		Если Вид = "Недостача" Тогда
			ПодвалБух = Макет.ПолучитьОбласть("ПодвалБух");
		КонецЕсли;
		
		ПодвалНедостача = Макет.ПолучитьОбласть("ПодвалНедостача");
		
		ПодвалИтоговДокум = Новый Массив;
		ПодвалИтоговДокум.Добавить(ПодвалИтоги);
		ПодвалИтоговДокум.Добавить(ПодвалНедостача);
		ПодвалИтоговДокум.Добавить(ПодвалОписи);
		ПодвалИтоговДокум.Добавить(ПодвалИтоговМОЛ);
		
		Молы = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ПодвалИтоговМОЛНаим = Макет.ПолучитьОбласть("СтрокаМол");		
			ПодвалИтоговМОЛНаим.Параметры.ДолжностьМОЛ = Молы.ФИзлицо.Должность;
			ПодвалИтоговМОЛНаим.Параметры.ФИОМОЛ = Молы.ФИзлицо;
			ПодвалИтоговДокум.Добавить(ПодвалИтоговМОЛНаим);
		КонецЦикла;
		
		ПодвалИтоговДокум.Добавить(ПодвалНомСтр);
		
		Если НЕ ТабДокумент.ПроверитьВывод(ПодвалИтоговДокум) Тогда
			
			ОбластьНомерСтраницы = Макет.ПолучитьОбласть("СтрокаНомерСтраницы");
			ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
			
			//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
			
			ТабДокумент.Вывести(ОбластьНомерСтраницы);
			
			НомерСтраницы = НомерСтраницы + 1;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ТабДокумент.Вывести(ЗаголовокТаблицы);
		КонецЕсли;
		
		ОбластьПодвалИтоги = Макет.ПолучитьОбласть("ПодвалИтоги");
		Если Вид = "Новое" ИЛИ Вид = "Полная" Тогда
			ОбластьПодвалИтоги.Параметры.СуммаРасхождений = СуммаРасхождений;
		Иначе
			ОбластьПодвалИтоги.Параметры.ИтогоСуммаОценки = ИтогоСуммаОценки;
			ОбластьПодвалИтоги.Параметры.ИтогоОстатокЗайма = ИтогоОстатокЗайма;
			ОбластьПодвалИтоги.Параметры.ИтогоКоличество = ИтогоКоличество;
			ОбластьПодвалИтоги.Параметры.ИтогоОбщийВес = ИтогоОбщийВес;
			ОбластьПодвалИтоги.Параметры.ИтогоЧистыйВес = ИтогоЧистыйВес;
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьПодвалИтоги);
		
		Если Вид = "Недостача" Тогда
			ПараметрыПредметаИсчисленияВеса = "целая, целых, целых, ж, сотая, сотых, сотых, ж, 2";
			ПараметрыПредметаИсчисленияСуммы = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
			ФорматнаяСтрока = "Л=ru_RU";
			
			МассивПрописи = ПолучитьСклоненияСтрокиПоЧислу("штука", ИтогоКоличество, "", "Л=ru_RU; ЧС=Количественное", "ПД=Родительный; ПЧ=ЧислоПрописью");
			
			ОбластьПодвалНедостача = Макет.ПолучитьОбласть("ПодвалНедостача");
			ОбластьПодвалНедостача.Параметры.ИтогоСуммаОценки = НРег(ЧислоПрописью(ИтогоСуммаОценки, ФорматнаяСтрока, ПараметрыПредметаИсчисленияСуммы));
			ОбластьПодвалНедостача.Параметры.ИтогоОстатокЗайма = НРег(ЧислоПрописью(ИтогоОстатокЗайма, ФорматнаяСтрока, ПараметрыПредметаИсчисленияСуммы));
			ОбластьПодвалНедостача.Параметры.ИтогоКоличество = НРег(МассивПрописи.Получить(0));
			ОбластьПодвалНедостача.Параметры.ИтогоОбщийВес = НРег(ЧислоПрописью(ИтогоОбщийВес, ФорматнаяСтрока, ПараметрыПредметаИсчисленияВеса));
			
			ТабДокумент.Вывести(ОбластьПодвалНедостача);
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
		
		Инд = 1;
		Пока ЧленКомиссии.Следующий() Цикл
						
			Если Инд <= 4 Тогда
				Если ЧленКомиссии.Председатель Тогда
					ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОПредседателя"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование); //ЧленКомиссии.ФизЛицо;
					
					Если ЧленКомиссии.Дистанционно Тогда
						ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
					КонецЕсли;
				Иначе
					Если Инд <> 1 Тогда //Времено. Исправить
						ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование); //ЧленКомиссии.ФизЛицо;
						
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;		
			Иначе
				ТабДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
		       	ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
				ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование); //ЧленКомиссии.ФизЛицо;
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
		
		ТабДокумент.Вывести(ОбластьМакета);
			
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОл");
		ТабДокумент.Вывести(ОбластьМакета);
		
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование);
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		Если Вид = "Недостача" Тогда
			ОбластьПодвалБух = Макет.ПолучитьОбласть("ПодвалБух");
			ТабДокумент.Вывести(ОбластьПодвалБух);
		КонецЕсли;
		
		ОбластьНомерСтраницы = Макет.ПолучитьОбласть("СтрокаНомерСтраницы");
		ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
		
		//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
		
		ТабДокумент.Вывести(ОбластьНомерСтраницы);
		
		//Добавляем колонтитул
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
		Иначе
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
		КонецЕсли;
		
		Если Вид = "Полная" Тогда
			НаимПечФормы = "ИНВ-19 Сличительная ведомость итогов инвентаризации (полная)";
		ИначеЕсли Вид = "Новое" Тогда
			НаимПечФормы = "ИНВ-19 Сличительная ведомость итогов инвентаризации (новые)";
		ИначеЕсли Вид = "Недостача" Тогда
			НаимПечФормы = "ИНВ-19 Сличительная ведомость итогов инвентаризации (недостача)";
		КонецЕсли;
		
		//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
		ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 2;
		ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 7,, Истина);
		
		ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
		+ "                                                                                                " //отступ
		+ НаимПечФормы + " № " + Шапка.НомерДокумента + " от " + Формат(Шапка.ДатаДокумента, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
		+ "                                                                                                " //отступ
		+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
		ТабДокумент.НижнийКолонтитул.Выводить = Истина;
		//

		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;

	Возврат ТабДокумент;

КонецФункции

Функция ПечатьИНВ22(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаПечати = ВалютаРегламентированногоУчета;
	Шапка = ПолучитьВыборкуШапок(МассивОбъектов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_ИНВ22";
	
	// Получение областей макета.
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИНВ22");
	ПервыйДокумент = Истина;

	Пока Шапка.Следующий() Цикл
	
		ЗаголовокРазделаПодписей = Новый Структура();
		ЗаголовокРазделаПодписей.Вставить("ПредседательКомиссии", "Председатель комиссии");
		ЗаголовокРазделаПодписей.Вставить("ЧленыКомиссии",        "Члены комиссии");
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВыборкаСтрокТовары = Шапка.Товары.Выбрать();
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();
	
		// Получаем области макета для вывода в табличный документ
		ШапкаОтчета   = Макет.ПолучитьОбласть("Шапка");
		Подпись = Макет.ПолучитьОбласть("Подпись");
		Подвал  = Макет.ПолучитьОбласть("Подвал");
		
		// Выведем шапку документа
		СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
		
		ШапкаОтчета.Параметры.Заполнить(Шапка);
		
		// ++ Сербаев 10.05.2023
		//ШапкаОтчета.Параметры.Организация          = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбОрганизации);
		// -- Сербаев 10.05.2023
		
		ШапкаОтчета.Параметры.ОрганизацияКодПоОКПО = СведенияОбОрганизации.КодПоОКПО;
		
		ШапкаОтчета.Параметры.НомерДокумента = Шапка.ДокументОснованиеНомер;
		ШапкаОтчета.Параметры.ДатаДокумента  = Шапка.ДокументОснованиеДата;
		
		ШапкаОтчета.Параметры.НаименованиеИмуществаОбязательств = "";
		ШапкаОтчета.Параметры.Подразделение = Шапка.Склад;
		
		ТабДокумент.Вывести(ШапкаОтчета);
		
		// Выведем подпись председателя инвентаризационной комиссии
		ПредседательКомиссии = Неопределено;
		Если ЧленКомиссии.Следующий() Тогда
			Если ЧленКомиссии.Председатель Тогда
				ПредседательКомиссии = ЧленКомиссии;
			КонецЕсли;	// 
		КонецЕсли;
		
		Если НЕ (ПредседательКомиссии = Неопределено) Тогда
			
			// ++ Сербаев 10.05.2023
			//ДанныеПредседателя = ОбщегоНазначенияБПВызовСервера.ДанныеФизЛица(Шапка.Организация, ПредседательКомиссии.ФизЛицо, Шапка.Дата);
			// -- Сербаев 10.05.2023
				
			Подпись.Параметры.ЗаголовокРазделаПодписей = ЗаголовокРазделаПодписей.ПредседательКомиссии;
			
			// ++ Сербаев 10.05.2023
			//Подпись.Параметры.Должность                = ДанныеПредседателя.Должность;
			// -- Сербаев 10.05.2023
			
		    Подпись.Параметры.НаименованиеЧленаКомисси = ПредседательКомиссии.ФизЛицо.Наименование;
			
		Иначе
			
			Подпись.Параметры.ЗаголовокРазделаПодписей = ЗаголовокРазделаПодписей.ПредседательКомиссии;
			Подпись.Параметры.Должность                = "";
			Подпись.Параметры.НаименованиеЧленаКомисси = "";
			
		КонецЕсли;
			
		ТабДокумент.Вывести(Подпись);
		
		// Выведем подписи членов комиссии
		ВыводитьЗаголовок = Истина;
		
		КоличествоЧленовКомиссии = 0;
		
		// Сначала выведем членов комиссии из выборки
		Пока ЧленКомиссии.Следующий() Цикл
			
			Если ЧленКомиссии.Председатель Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДокумент, Подпись) Тогда
				
				// Выведем разрыв страницы
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ВыводитьЗаголовок = Истина; // на новой странице выведем заголовок набора подписей
			
			КонецЕсли;
			
			КоличествоЧленовКомиссии = КоличествоЧленовКомиссии + 1;
			
			// ++ Сербаев 10.05.2023
			//ДанныеЧленаКомиссии = ОбщегоНазначенияБПВызовСервера.ДанныеФизЛица(Шапка.Организация, ЧленКомиссии.ФизЛицо, Шапка.Дата);
			// -- Сербаев 10.05.2023
			
			Подпись.Параметры.ЗаголовокРазделаПодписей = ?(ВыводитьЗаголовок, 
			                                               ЗаголовокРазделаПодписей.ЧленыКомиссии,
														   "");
			// ++ Сербаев 10.05.2023											   
			//Подпись.Параметры.Должность                = ДанныеЧленаКомиссии.Должность; 
			// -- Сербаев 10.05.2023
			
	    	Подпись.Параметры.НаименованиеЧленаКомисси = ЧленКомиссии.ФизЛицо.Наименование;
			
			ТабДокумент.Вывести(Подпись);
			
			ВыводитьЗаголовок = Ложь; // в следующей итерации вывод заголовка не нужен
			
		КонецЦикла;
		
		// Затем выведем пустые места для подписей (чтобы в итоге получилось не менее 3-х
		// подписей, как в форме, утвержденной Госкомстатом)
		Если КоличествоЧленовКомиссии < 3 Тогда
			
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДокумент, Подпись) Тогда
				
				// Выведем разрыв страницы
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ВыводитьЗаголовок = Истина; // на новой странице выведем заголовок набора подписей
			
			КонецЕсли;
			
			Для Итератор = (КоличествоЧленовКомиссии + 1) По 3 Цикл
				
				Подпись.Параметры.ЗаголовокРазделаПодписей = ?(ВыводитьЗаголовок, 
				                                               ЗаголовокРазделаПодписей.ЧленыКомиссии,
															   "");
				Подпись.Параметры.Должность                = "";
			    Подпись.Параметры.НаименованиеЧленаКомисси = "";
				
				ТабДокумент.Вывести(Подпись);
				
				ВыводитьЗаголовок = Ложь; // в следующей итерации вывод заголовка не нужен
				
			КонецЦикла;
		
		КонецЕсли;
		
		// Выведем подвал приказа
		Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДокумент, Подвал) Тогда
			
			// Выведем разрыв страницы
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;
		
		Подвал.Параметры.НаименованиеИмуществаОбязательств = "";
		Подвал.Параметры.ДатаНачалаИнвентаризации          = Формат(Шапка.ДатаНачалаИнвентаризации, "ДЛФ=DD");
		Подвал.Параметры.ДатаОкончанияИнвентаризации       = Формат(Шапка.ДатаОкончанияИнвентаризации, "ДЛФ=DD");
		Подвал.Параметры.ПричинаПроведенияИнвентаризации   = Шапка.ПричинаПроведенияИнвентаризации;
		
		//Руководители = ОтветственныеЛицаБП.ОтветственныеЛица(Шапка.Организация, Шапка.Дата);
		//
		//Подвал.Параметры.ДолжностьРуководителя          = Руководители.РуководительДолжностьПредставление;
		//Подвал.Параметры.РасшифровкаПодписиРуководителя = Руководители.РуководительПредставление;
		
		ТабДокумент.Вывести(Подвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;	//Шапки.Следующий() 

	Возврат ТабДокумент;

КонецФункции

Функция ПечатьИнв8(МассивОбъектов, ОбъектыПечати, Пустая, ВсеВставки)

	УстановитьПривилегированныйРежим(Истина);
	
	Шапка = ПолучитьВыборкуШапок_Инв8(МассивОбъектов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_ИНВ8";
	ТабДокумент.ТолькоПросмотр = Истина;
	ТабДокумент.Защита = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ8");
	ПервыйДокумент = Истина;

	ТЧСтруктура = Новый Структура;
	ТЧСтруктура.Вставить("ТЧКамни", "ВставкиФакт");
	ТЧСтруктура.Вставить("ТЧМеталл", "ВставкиМеталла");
	
	Пока Шапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВыборкаСтрокТовары = Шапка.Товары.Выбрать();
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();

		//////////////////////////////////////////////////////////////////////
		// 1-я страница формы

		// Выводим шапку накладной
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ОбластьМакета.Параметры.Подразделение = Шапка.Ломбард.НомерЛомбарда;	
		
		ОбластьМакета.Параметры.ДатаДокумента            = Шапка.Дата;
		ОбластьМакета.Параметры.НомерДокумента           = Шапка.Номер; //ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер, Истина, Ложь);
		ОбластьМакета.Параметры.ДокументОснованиеНомер = Шапка.НомерПриказа;
		ОбластьМакета.Параметры.ДокументОснованиеДата = Шапка.ДатаПриказа;
		ТабДокумент.Вывести(ОбластьМакета); 
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование); //Молы.Физлицо;
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПодвал");
		ОбластьМакета.Параметры.ДатаНачалаИнвентаризации = Формат(Шапка.ДатаНачалаИнвентаризации, "ДЛФ=DD");	
		ТабДокумент.Вывести(ОбластьМакета);		

		
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

		//////////////////////////////////////////////////////////////////////
		// 2-я страница формы

		ИтогФактКоличество = 0;
		ИтогФактСумма      = 0;
		ИтогФактСуммаВсего = 0;
		ИтогБухКоличество  = 0;
		ИтогБухСумма       = 0;

		КолвоСтрокПоСтранице = 0;
		КолвоПоСтранице      = 0;
		СуммаЛиста           = 0;
		ИтогоКолво           = 0; 
		
		ИтогоОстатокЗаймаСтраница 	= 0;
		ИтогоКоличествоСтраница   	= 0;
		ИтогоОбщаяМассаСтраница   	= 0;
		ИтогоМассаМеталлаСтраница 	= 0;
		ИтогоОценкаСтраница		 	= 0;
		ИтогоКоличествоФактСтраница = 0; 
		ИтогоОбщаяМассаФактСтраница	= 0;
		ИтогоМассаМеталлаФактСтраница = 0;
		ИтогоОценкаФактСтраница		= 0;
		
		ИтогоОстатокЗаймаНакопительный 	= 0;
		ИтогоКоличествоНакопительный   	= 0;
		ИтогоОбщаяМассаНакопительный   	= 0;
		ИтогоМассаМеталлаНакопительный 	= 0;
		ИтогоОценкаНакопительный		= 0;
		ИтогоКоличествоФактНакопительный = 0; 
		ИтогоОбщаяМассаФактНакопительный = 0;
		ИтогоМассаМеталлаФактНакопительный = 0;
		ИтогоОценкаФактНакопительный	= 0;
		
		НомерСтраницы = 1;
	    Ном = 0;

		// Выводим заголовок таблицы
		ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
//		ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы; 
		ТабДокумент.Вывести(ЗаголовокТаблицы);

		// Выводим многострочную часть документа
		ПодвалСтраницы  = Макет.ПолучитьОбласть("ПодвалСтраницы");	
			
		Пока ВыборкаСтрокТовары.Следующий() Цикл

			СтруктураВставки = ПолучитьВставки(ВыборкаСтрокТовары.ОбъектЗалога, Шапка.Ссылка, ТЧСтруктура, ВсеВставки);
			
			Ном = Ном + 1;
			СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
			СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары); 
			
			СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", ?(ВыборкаСтрокТовары.Комментарий = "", "-", "" + ВыборкаСтрокТовары.Комментарий),
				"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
			СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.Наименование) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";
			
			Если Пустая Тогда
				СтрокаТаблицы.Параметры.КоличествоФакт = "";
				СтрокаТаблицы.Параметры.ПробаФакт = "";
				СтрокаТаблицы.Параметры.ОбщаяМассаФакт = "";
				СтрокаТаблицы.Параметры.МассаМеталлаФакт = "";
				СтрокаТаблицы.Параметры.ОценкаФакт = "";
				СтрокаТаблицы.Параметры.Отклонения = "";
			КонецЕсли;
			
			СтрокаСПодвалом = Новый Массив;
			СтрокаСПодвалом.Добавить(СтрокаТаблицы);
			СтрокаСПодвалом.Добавить(ПодвалСтраницы);
			
			//Проверяем влазиет ли строка с описание вставок на один лист
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			//
			
			ГраницаНет = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ГраницаЕсть = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
			
			Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда

				ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
				ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры;

				//ПараметрыОбласти.ИтогоФактКоличество = ИтогФактКоличество;
				//ПараметрыОбласти.ИтогоФактСумма      = ИтогФактСумма;
				//ПараметрыОбласти.ИтогоБухКоличество  = ИтогБухКоличество;
				//ПараметрыОбласти.ИтогоБухСумма       = ИтогБухСумма;

				ПараметрыОбласти.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(КолвоСтрокПоСтранице, ,",,,,,,,,0");
				ПараметрыОбласти.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоКоличествоФактСтраница, ,",,,,,,,,0"));
				
				ПараметрыПредметаИсчисления = "целая, целых, целых, ж, сотая, сотых, сотых, ж, 2";
				//ФорматнаяСтрока = "Л=ru_RU; ДП=Истина"; 
				ФорматнаяСтрока = "Л=ru_RU"; 

