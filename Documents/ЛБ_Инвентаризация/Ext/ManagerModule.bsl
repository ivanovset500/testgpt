// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// ++ Сербаев 05.05.2023
	//ВалютаРегламентированногоУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	ВалютаРегламентированногоУчета = Справочники.Валюты.НайтиПоКоду("643");
	// -- Сербаев 05.05.2023
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнвентаризацияТоваровНаСкладе") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИнвентаризацияТоваровНаСкладе", "Инвентаризация товаров на складе", 
			ПечатьИнвентаризации(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета), , "Документ.ИнвентаризацияТоваровНаСкладе.ПФ_MXL_ИнвентаризацияТоваровНаСкладе");
	КонецЕсли;
	//Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ3") Тогда
	//	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ3", "ИНВ-3 (Инвентаризационная опись товаров)", 
	//		ПечатьИнв3(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета), , "Документ.ИнвентаризацияТоваровНаСкладе.ПФ_MXL_ИНВ3");
	//КонецЕсли;
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ8") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ8", "ИНВ-8 (Акт инвентаризации драгметаллов и камней)", 
			ПечатьИнв8(МассивОбъектов, ОбъектыПечати, Ложь, Ложь), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ8");
	КонецЕсли; 
		
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ8Черновик") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ8Черновик", "ИНВ-8 (Акт инвентаризации драгметаллов и камней)", 
			ПечатьИнв8(МассивОбъектов, ОбъектыПечати, Ложь, Истина), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ8");
	КонецЕсли;
		
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ8Пустая") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ8Пустая", "ИНВ-8 (Акт инвентаризации драгметаллов и камней)", 
			ПечатьИнв8(МассивОбъектов, ОбъектыПечати, Истина, Ложь), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ8");
		КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ5") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ5", "ИНВ-5 (Акт инвентаризации драгметаллов и камней на ОХ)", 
			ПечатьИнв5(МассивОбъектов, ОбъектыПечати, Ложь), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ5");
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ5Пустая") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ5Пустая", "ИНВ-5 (Акт инвентаризации драгметаллов и камней на ОХ)", 
			ПечатьИнв5(МассивОбъектов, ОбъектыПечати, Истина), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ5");
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОписьПоступивших") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ОписьПоступивших", "Опись поступивших", 
			ПечатьОписиПоступивших(МассивОбъектов, ОбъектыПечати, Ложь), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ОписьПоступивших");
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОписьВыбывших") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ОписьВыбывших", "Опись выбывших", 
			ПечатьОписиПоступивших(МассивОбъектов, ОбъектыПечати, Истина), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ОписьПоступивших");
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ19Полная") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ19Полная",  "ИНВ-19 (Сличительная ведомость)", 
		ПечатьИНВ19(МассивОбъектов, ОбъектыПечати, "Полная"), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ19");
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИНВ19Новое") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИНВ19Новое",  "ИНВ-19 (Сличительная ведомость)", 
		ПечатьИНВ19(МассивОбъектов, ОбъектыПечати, "Новое"), , "Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ19");
	КонецЕсли;
	
