	    ОбластьМакета.Параметры.ДатаДокумента 	= Шапка.Дата;

		НомерСтраницы = НомерСтраницы + 1;
		//ОбластьМакета.Параметры.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);

		ТабДокумент.Вывести(ОбластьМакета);	

		//Добавляем колонтитул
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
		Иначе
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
		КонецЕсли;
			
		Если ВсеВставки Тогда
			НаимПечФормы = "ИНВ-8 Акт инвентаризации ДМ и изделий из них (черновик)";
		ИначеЕсли Пустая Тогда
			НаимПечФормы = "ИНВ-8 Акт инвентаризации ДМ и изделий из них (пустая)";
		Иначе
			НаимПечФормы = "ИНВ-8 Акт инвентаризации ДМ и изделий из них";
		КонецЕсли;
		
		//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
		ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 2;
		ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 7,, Истина);
		//ТабДокумент.НижнийКолонтитул.ТекстСлева = "[&Дата] [&Время]" + " " + ТекСотрудник;
		
		ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
		+ "                                                                                                " //отступ
		+ НаимПечФормы + " № " + Шапка.Номер + " от " + Формат(Шапка.Дата, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
		+ "                                                                                                " //отступ
		+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
		//ТабДокумент.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
		ТабДокумент.НижнийКолонтитул.Выводить = Истина;
		//
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;	//Шапки.Следующий() 

	Возврат ТабДокумент;

КонецФункции

Функция ПечатьИнв5(МассивОбъектов, ОбъектыПечати, Пустая)

	УстановитьПривилегированныйРежим(Истина);
	
	Шапка = ПолучитьВыборкуШапок_Инв5(МассивОбъектов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_ИНВ5";
	ТабДокумент.ТолькоПросмотр = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ5");
	ПервыйДокумент = Истина;

	ТЧСтруктура = Новый Структура;
	ТЧСтруктура.Вставить("ТЧКамни", "ВставкиКамнейНаОХ");
	ТЧСтруктура.Вставить("ТЧМеталл", "ВставкиМеталлаНаОХ");

	Пока Шапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВыборкаСтрокТовары = Шапка.Товары.Выбрать();
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();

		//////////////////////////////////////////////////////////////////////
		// 1-я страница формы

		// Выводим шапку накладной
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ОбластьМакета.Параметры.ДатаДокумента            = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy");
		ОбластьМакета.Параметры.Подразделение            = Шапка.Ломбард.НомерЛомбарда;
		ОбластьМакета.Параметры.НомерДокумента           = Шапка.Номер; //ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер, Истина, Ложь);
		ОбластьМакета.Параметры.ДокументОснованиеНомер = Шапка.НомерПриказа;
		ОбластьМакета.Параметры.ДокументОснованиеДата = Шапка.Датаприказа;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		Молы = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование); //Молы.Физлицо;
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЦикла;

		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПодвал");
		ОбластьМакета.Параметры.ДатаНачалаИнвентаризации = Формат(Шапка.ДатаНачалаИнвентаризации, "ДЛФ=DD");
		ТабДокумент.Вывести(ОбластьМакета);
	
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

		//////////////////////////////////////////////////////////////////////
		// 2-я страница формы

		ИтогФактКоличество = 0;
		ИтогФактСумма      = 0;
		ИтогФактСуммаВсего = 0;
		ИтогБухКоличество  = 0;
		ИтогБухСумма       = 0;

		КолвоСтрокПоСтранице = 0;
		КолвоПоСтранице      = 0;
		СуммаЛиста           = 0;
		ИтогоКолво           = 0; 
		
		//ИтогоОстатокЗаймаСтраница 	= 0;
		ИтогоКоличествоСтраница   	= 0;
		ИтогоОбщаяМассаСтраница   	= 0;
		ИтогоМассаМеталлаСтраница 	= 0;
		ИтогоОценкаСтраница		 	= 0;
		ИтогоКоличествоФактСтраница = 0; 
		ИтогоОбщаяМассаФактСтраница	= 0;
		ИтогоМассаМеталлаФактСтраница = 0;
		ИтогоОценкаФактСтраница		= 0;
		
		//ИтогоОстатокЗаймаНакопительный 	= 0;
		ИтогоКоличествоНакопительный   	= 0;
		ИтогоОбщаяМассаНакопительный   	= 0;
		ИтогоМассаМеталлаНакопительный 	= 0;
		ИтогоОценкаНакопительный		= 0;
		ИтогоКоличествоФактНакопительный = 0; 
		ИтогоОбщаяМассаФактНакопительный = 0;
		ИтогоМассаМеталлаФактНакопительный = 0;
		ИтогоОценкаФактНакопительный	= 0;
		
		НомерСтраницы = 1;
	    Ном = 0;

		// Выводим заголовок таблицы
		ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
//		ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы; 
		ТабДокумент.Вывести(ЗаголовокТаблицы);

		// Выводим многострочную часть документа
		ПодвалСтраницы  = Макет.ПолучитьОбласть("ПодвалСтраницы");	
			
		Пока ВыборкаСтрокТовары.Следующий() Цикл

			СтруктураВставки = ПолучитьВставки(ВыборкаСтрокТовары.ОбъектЗалога, Шапка.Ссылка, ТЧСтруктура, Ложь);
			
			ДатаОХ = ПолучитьДатуОХ(НачалоДня(Шапка.ДатаНачалаИнвентаризации), ВыборкаСтрокТовары.ОбъектЗалога, ВыборкаСтрокТовары.ОперацияЗайма.НомерЗалоговогоБилета);
			
			Ном = Ном + 1;
			СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
			СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары); 
			СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.ОбъектЗалога.Наименование) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";
			СтрокаТаблицы.Параметры.ДатаИсполнения = ДатаОХ;
			СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", "" + ВыборкаСтрокТовары.Комментарий,
				"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
			
			Если Пустая Тогда
				СтрокаТаблицы.Параметры.КоличествоФакт = "";
				СтрокаТаблицы.Параметры.ПробаФакт = "";
				СтрокаТаблицы.Параметры.ОбщаяМассаФакт = "";
				СтрокаТаблицы.Параметры.МассаМеталлаФакт = "";
				СтрокаТаблицы.Параметры.СуммаОценкиФакт = "";
				СтрокаТаблицы.Параметры.Отклонения = "";
			КонецЕсли;
			
			СтрокаСПодвалом = Новый Массив;
			СтрокаСПодвалом.Добавить(СтрокаТаблицы);
			СтрокаСПодвалом.Добавить(ПодвалСтраницы);
			
			//Проверяем влазиет ли строка с описание вставок на один лист
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			//
			
			ГраницаНет = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			
			Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда

				ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
				ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры;

				//ПараметрыОбласти.ИтогоФактКоличество = ИтогФактКоличество;
				//ПараметрыОбласти.ИтогоФактСумма      = ИтогФактСумма;
				//ПараметрыОбласти.ИтогоБухКоличество  = ИтогБухКоличество;
				//ПараметрыОбласти.ИтогоБухСумма       = ИтогБухСумма;

				ПараметрыОбласти.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(КолвоСтрокПоСтранице, ,",,,,,,,,0");
				ПараметрыОбласти.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоКоличествоФактСтраница, ,",,,,,,,,0"));
				
				ПараметрыПредметаИсчисления = "целая, целых, целых, ж, сотая, сотых, сотых, ж, 2";
				//ФорматнаяСтрока = "Л=ru_RU; ДП=Истина";  	
				ФорматнаяСтрока = "Л=ru_RU";
				ПараметрыОбласти.СуммаФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоМассаМеталлаФактСтраница,ФорматнаяСтрока,ПараметрыПредметаИсчисления));
				
				ПараметрыОбласти.ИтогоКоличествоСтраница   		= ИтогоКоличествоСтраница;
				ПараметрыОбласти.ИтогоОбщаяМассаСтраница   		= ИтогоОбщаяМассаСтраница;
				ПараметрыОбласти.ИтогоМассаМеталлаСтраница 		= ИтогоМассаМеталлаСтраница;
				ПараметрыОбласти.ИтогоОценкаСтраница		 	= ИтогоОценкаСтраница;
				ПараметрыОбласти.ИтогоКоличествоФактСтраница 	= ?(Пустая, "" , ИтогоКоличествоФактСтраница);
				ПараметрыОбласти.ИтогоОбщаяМассаФактСтраница	= ?(Пустая, "" , ИтогоОбщаяМассаФактСтраница);
				ПараметрыОбласти.ИтогоМассаМеталлаФактСтраница 	= ?(Пустая, "" , ИтогоМассаМеталлаФактСтраница);
				ПараметрыОбласти.ИтогоОценкаФактСтраница		= ?(Пустая, "" , ИтогоОценкаФактСтраница);
				
				//ПараметрыОбласти.ИтогоОстатокЗаймаНакопительный 	= ИтогоОстатокЗаймаНакопительный;
				ПараметрыОбласти.ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный;
				ПараметрыОбласти.ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный;
				ПараметрыОбласти.ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный;
				ПараметрыОбласти.ИтогоОценкаНакопительный			= ИтогоОценкаНакопительный;
				ПараметрыОбласти.ИтогоКоличествоФактНакопительный 	= ?(Пустая, "" , ИтогоКоличествоФактНакопительный);
				ПараметрыОбласти.ИтогоОбщаяМассаФактНакопительный 	= ?(Пустая, "" , ИтогоОбщаяМассаФактНакопительный);
				ПараметрыОбласти.ИтогоМассаМеталлаФактНакопительный = ?(Пустая, "" , ИтогоМассаМеталлаФактНакопительный);
				ПараметрыОбласти.ИтогоОценкаФактНакопительный		= ?(Пустая, "" , ИтогоОценкаФактНакопительный);
				
				НомерСтраницы = НомерСтраницы + 1;
				//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
				ПараметрыОбласти.НомерСтр = СокрЛП(НомерСтраницы);
				
				ТабДокумент.Вывести(ОбластьИтоговПоСтранице);
				
				//НомерСтраницы = НомерСтраницы + 1;
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

//				ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы;
				ТабДокумент.Вывести(ЗаголовокТаблицы);

				ИтогФактКоличество = 0;
				ИтогФактСумма      = 0;
				ИтогБухКоличество  = 0;
				ИтогБухСумма       = 0;

				КолвоСтрокПоСтранице = 0;
				КолвоПоСтранице      = 0;
				СуммаЛиста           = 0;
				
				//ИтогоОстатокЗаймаСтраница 	= 0;
				ИтогоКоличествоСтраница   	= 0;
				ИтогоОбщаяМассаСтраница   	= 0;
				ИтогоМассаМеталлаСтраница 	= 0;
				ИтогоОценкаСтраница		 	= 0;
				ИтогоКоличествоФактСтраница = 0; 
				ИтогоОбщаяМассаФактСтраница	= 0;
				ИтогоМассаМеталлаФактСтраница = 0;
				ИтогоОценкаФактСтраница		= 0;
			КонецЕсли;

			Если СтруктураВставки.Камни <> Неопределено ИЛИ СтруктураВставки.Металлы <> Неопределено Тогда
				СтрокаТаблицы.Области.Строка.ГраницаСнизу = ГраницаНет;
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.Номер = Ном;
			ТабДокумент.Вывести(СтрокаТаблицы);

			КоличествоВставок = 0;

			Если СтруктураВставки.Камни <> Неопределено Тогда
				КоличествоВставок = СтруктураВставки.Камни.Количество();
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				КоличествоВставок = КоличествоВставок + СтруктураВставки.Металлы.Количество();
			КонецЕсли;
			
			ПорядковыйНомерВставки = 1;
			
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрВ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					Если Пустая Тогда
						СтрокаВставки.Параметры.КоличествоФакт = "";
						СтрокаВставки.Параметры.ВидВставкиФакт = "";
						СтрокаВставки.Параметры.ВесФакт = "";
						СтрокаВставки.Параметры.СуммаФакт = "";
					КонецЕсли;
					
					ТабДокумент.Вывести(СтрокаВставки);
					
					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;

			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрМ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					Если Пустая Тогда
						СтрокаВставки.Параметры.КоличествоФакт = "";
						СтрокаВставки.Параметры.ВидВставкиФакт = "";
						СтрокаВставки.Параметры.ВесФакт = "";
						СтрокаВставки.Параметры.СуммаФакт = "";
					КонецЕсли;
					
					ТабДокумент.Вывести(СтрокаВставки);

					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;

			КолвоСтрокПоСтранице = КолвоСтрокПоСтранице + 1;
			КолвоПоСтранице      = КолвоПоСтранице      + ВыборкаСтрокТовары.КоличествоФакт;
			//СуммаЛиста           = СуммаЛиста           + ВыборкаСтрокТовары.Сумма; 
			
//			ИтогоОстатокЗаймаСтраница 	= ИтогоОстатокЗаймаСтраница + ВыборкаСтрокТовары.ОстатокЗайма;
			ИтогоКоличествоСтраница   	= ИтогоКоличествоСтраница + ВыборкаСтрокТовары.Количество;
			ИтогоОбщаяМассаСтраница   	= ИтогоОбщаяМассаСтраница + ВыборкаСтрокТовары.ОбщаяМасса;
			ИтогоМассаМеталлаСтраница 	= ИтогоМассаМеталлаСтраница + ВыборкаСтрокТовары.МассаМеталла;
			ИтогоОценкаСтраница		 	= ИтогоОценкаСтраница + ВыборкаСтрокТовары.СуммаОценки;
			ИтогоКоличествоФактСтраница = ИтогоКоличествоФактСтраница + ВыборкаСтрокТовары.КоличествоФакт; 
			ИтогоОбщаяМассаФактСтраница	= ИтогоОбщаяМассаФактСтраница + ВыборкаСтрокТовары.ОбщаяМассаФакт;
			ИтогоМассаМеталлаФактСтраница = ИтогоМассаМеталлаФактСтраница + ВыборкаСтрокТовары.МассаМеталлаФакт;
			ИтогоОценкаФактСтраница		= ИтогоОценкаФактСтраница + ВыборкаСтрокТовары.СуммаОценкиФакт;
			
			ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный + ВыборкаСтрокТовары.Количество;
			ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный + ВыборкаСтрокТовары.ОбщаяМасса;
			ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный + ВыборкаСтрокТовары.МассаМеталла;
			ИтогоОценкаНакопительный			= ИтогоОценкаНакопительный + ВыборкаСтрокТовары.СуммаОценки;
			ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный + ВыборкаСтрокТовары.КоличествоФакт; 
			ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный + ВыборкаСтрокТовары.ОбщаяМассаФакт;
			ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный + ВыборкаСтрокТовары.МассаМеталлаФакт;
			ИтогоОценкаФактНакопительный		= ИтогоОценкаФактНакопительный + ВыборкаСтрокТовары.СуммаОценкиФакт;
		КонецЦикла;

		// Выводим итоги по последней странице
		ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
		ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры;
		
		ПараметрыОбласти.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(КолвоСтрокПоСтранице, ,",,,,,,,,0");
		ПараметрыОбласти.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоКоличествоФактСтраница, ,",,,,,,,,0"));
		
		ПараметрыПредметаИсчисления = "целая, целых, целых, ж, сотая, сотых, сотых, ж, 2";
		//ФорматнаяСтрока = "Л=ru_RU; ДП=Истина";  	
		ФорматнаяСтрока = "Л=ru_RU";
		ПараметрыОбласти.СуммаФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоМассаМеталлаФактСтраница,ФорматнаяСтрока,ПараметрыПредметаИсчисления));
		
		ПараметрыОбласти.ИтогоКоличествоСтраница   		= ИтогоКоличествоСтраница;
		ПараметрыОбласти.ИтогоОбщаяМассаСтраница   		= ИтогоОбщаяМассаСтраница;
		ПараметрыОбласти.ИтогоМассаМеталлаСтраница 		= ИтогоМассаМеталлаСтраница;
		ПараметрыОбласти.ИтогоОценкаСтраница		 	= ИтогоОценкаСтраница;
		ПараметрыОбласти.ИтогоКоличествоФактСтраница 	= ?(Пустая, "" , ИтогоКоличествоФактСтраница);
		ПараметрыОбласти.ИтогоОбщаяМассаФактСтраница	= ?(Пустая, "" , ИтогоОбщаяМассаФактСтраница);
		ПараметрыОбласти.ИтогоМассаМеталлаФактСтраница 	= ?(Пустая, "" , ИтогоМассаМеталлаФактСтраница);
		ПараметрыОбласти.ИтогоОценкаФактСтраница		= ?(Пустая, "" , ИтогоОценкаФактСтраница);
		
		//ПараметрыОбласти.ИтогоОстатокЗаймаНакопительный 	= ИтогоОстатокЗаймаНакопительный;
		ПараметрыОбласти.ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный;
		ПараметрыОбласти.ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный;
		ПараметрыОбласти.ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный;
		ПараметрыОбласти.ИтогоОценкаНакопительный			= ИтогоОценкаНакопительный;
		ПараметрыОбласти.ИтогоКоличествоФактНакопительный 	= ?(Пустая, "" , ИтогоКоличествоФактНакопительный);
		ПараметрыОбласти.ИтогоОбщаяМассаФактНакопительный 	= ?(Пустая, "" , ИтогоОбщаяМассаФактНакопительный);
		ПараметрыОбласти.ИтогоМассаМеталлаФактНакопительный = ?(Пустая, "" , ИтогоМассаМеталлаФактНакопительный);
		ПараметрыОбласти.ИтогоОценкаФактНакопительный		= ?(Пустая, "" , ИтогоОценкаФактНакопительный);
		
		НомерСтраницы = НомерСтраницы + 1;
		//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
		ПараметрыОбласти.НомерСтр = СокрЛП(НомерСтраницы);
				
		ТабДокумент.Вывести(ОбластьИтоговПоСтранице);

		// Выводим подвал документа
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		
		ОбластьМакета.Параметры.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоКоличествоФактНакопительный, ,",,,,,,,,0"));
		ОбластьМакета.Параметры.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(Ном, ,",,,,,,,,0");
		                	
		//ПараметрыПредметаИсчисления = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
		ОбластьМакета.Параметры.СуммаФактическиНаСтраницеПрописью = ?(Пустая, "" , ЧислоПрописью(ИтогоМассаМеталлаФактНакопительный,ФорматнаяСтрока ,ПараметрыПредметаИсчисления));
	           	
		Инд = 1;
		Пока ЧленКомиссии.Следующий() Цикл
			Если Инд <= 4 Тогда
				Если ЧленКомиссии.Председатель Тогда
					ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОПредседателя"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
					
					Если ЧленКомиссии.Дистанционно Тогда
						ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
					КонецЕсли;
				Иначе
					Если Инд <> 1 Тогда //Времено. Исправить
						ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
						
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;		
			Иначе
				ТабДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
		       	ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
				ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОЛ");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ОбластьМакета.Параметры.НачальныйНомерПоПорядку = 1;
		ОбластьМакета.Параметры.НомерКонца              = Ном;
	
		ТабДокумент.Вывести(ОбластьМакета); 
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФИзлицо.Наименование);
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОЛДата");
	    ОбластьМакета.Параметры.ДатаДокумента 	= Шапка.Дата;

		НомерСтраницы = НомерСтраницы + 1;
		//ОбластьМакета.Параметры.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);

		ТабДокумент.Вывести(ОбластьМакета);	

		//Добавляем колонтитул
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
		Иначе
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
		КонецЕсли;
			
		НаимПечФормы = "ИНВ-5 Акт инвентаризации ДМ на ОХ";
		
		//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
		ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 2;
		ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 7,, Истина);
		
		ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
		+ "                                                                                                " //отступ
		+ НаимПечФормы + " № " + Шапка.Номер + " от " + Формат(Шапка.Дата, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
		+ "                                                                                                " //отступ
		+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
		ТабДокумент.НижнийКолонтитул.Выводить = Истина;
		//
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;	//Шапки.Следующий() 

	Возврат ТабДокумент;

КонецФункции

Функция ВернутьДатуВыкупаИзделия(ОЗ, ЗБ, ДатаС, ДатаПо, ДокИнв, ДатаВыкупа)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОбороты.Период КАК Период,
	               |	ЛБ_ОбъектыЗалогаОбороты.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Обороты(
	               |			&ДатаС,
	               |			&ДатаПо,
	               |			Регистратор,
	               |			ОбъектЗалога = &ОбъектЗалога
	               |				И Ломбард = &Ломбард
	               |				И Склад = &Склад) КАК ЛБ_ОбъектыЗалогаОбороты
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалогаОбороты.КоличествоРасход > 0
	               |	И ЛБ_ОбъектыЗалогаОбороты.ЗалоговыйБилет = &ЗалоговыйБилет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";

	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Запрос.УстановитьПараметр("Ломбард", ДокИнв.Ломбард);
	Запрос.УстановитьПараметр("Склад", ДокИнв.Склад);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Период;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ВернутьДокументВыкупаИзделия(ОЗ, ЗБ, ДатаС, ДатаПо, ДокИнв)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОбъектыЗалогаОбороты.Период КАК Период,
	               |	ЛБ_ОбъектыЗалогаОбороты.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Обороты(
	               |			&ДатаС,
	               |			&ДатаПо,
	               |			Регистратор,
	               |			ОбъектЗалога = &ОбъектЗалога
	               |				И Ломбард = &Ломбард
	               |				И Склад = &Склад) КАК ЛБ_ОбъектыЗалогаОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&ДатаПо, ) КАК ЛБ_ОбъектыЗалогаОстатки
	               |		ПО ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога = ЛБ_ОбъектыЗалогаОстатки.ОбъектЗалога
	               |ГДЕ
	               |	ЛБ_ОбъектыЗалогаОбороты.КоличествоРасход > 0
	               |	И ЛБ_ОбъектыЗалогаОбороты.ЗалоговыйБилет = &ЗалоговыйБилет
	               |	И ВЫБОР
	               |			КОГДА ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток = 0
	               |				ТОГДА ИСТИНА
	               |			КОГДА ЛБ_ОбъектыЗалогаОстатки.КоличествоОстаток ЕСТЬ NULL
	               |				ТОГДА ИСТИНА
	               |			КОГДА ЛБ_ОбъектыЗалогаОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление)
	               |					ИЛИ ЛБ_ОбъектыЗалогаОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога)
	               |				ТОГДА ИСТИНА
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";

	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Запрос.УстановитьПараметр("Ломбард", ДокИнв.Ломбард);
	Запрос.УстановитьПараметр("Склад", ДокИнв.Склад);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Регистратор;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПечатьОписиПоступивших(МассивОбъектов, ОбъектыПечати, Выбывшие)

	УстановитьПривилегированныйРежим(Истина);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_ОписьПоступивших";
	ТабДокумент.ТолькоПросмотр = Истина;
	
	ПервыйДокумент = Истина;

	ТЧСтруктура = Новый Структура;
	
	Если НЕ Выбывшие Тогда
		ТЧСтруктура.Вставить("ТЧКамни", "ВставкиКамнейНовыеОЗ");
		ТЧСтруктура.Вставить("ТЧМеталл", "ВставкиМеталлаНовыеОЗ");
	Иначе
		
	КонецЕсли;
	
	Для каждого Док из МассивОбъектов Цикл
		
		Если НЕ Выбывшие Тогда
			Шапка = ПолучитьВыборкуШапокПоступивших(Док);
		Иначе
			Шапка = ПолучитьВыборкуШапокБезТоваров(Док);
		КонецЕсли;
		
		Если НЕ Выбывшие Тогда
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ОписьПоступивших");
		Иначе
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ОписьВыбывших");
		КонецЕсли;
		
		Пока Шапка.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			// Запомним номер строки, с которой начали выводить текущий документ.
			НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
			
	   		Если НЕ Выбывшие Тогда
				ВыборкаСтрокТовары = Шапка.НовыеОЗ.Выбрать();
			Иначе
				ВыборкаСтрокТовары = ПолучитьСтрокиВыбывших(Док);
			КонецЕсли;
			
			ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();
			
			//////////////////////////////////////////////////////////////////////
			// 1-я страница формы
			
			// Выводим шапку накладной
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			
			Если НЕ Выбывшие Тогда
				ОбластьМакета.Параметры.Заголовок = "поступивших";
			Иначе
				ОбластьМакета.Параметры.Заголовок = "выбывших";
			КонецЕсли;
			
			ОбластьМакета.Параметры.ДатаПриказа  = Формат(Шапка.ДатаПриказа, "ДФ=dd.MM.yyyy");
			ОбластьМакета.Параметры.ДатаС  = Формат(Шапка.ДатаНачалаИнвентаризации, "ДФ=dd.MM.yyyy");
			ОбластьМакета.Параметры.ДатаПо = Формат(Шапка.ДатаОкончанияИнвентаризации, "ДФ=dd.MM.yyyy"); 
			ОбластьМакета.Параметры.ВремяОкончания = Формат(Шапка.ДатаОкончанияИнвентаризации, "ДЛФ=DT");
			ОбластьМакета.Параметры.Подразделение = Шапка.Ломбард.НомерЛомбарда;
			//ОбластьМакета.Параметры.НомерПриказа = Шапка.ДокументОснованиеНомер;
			ОбластьМакета.Параметры.Отделение = ПолучитьОтделение(НачалоДня(Шапка.ДатаДокумента), Шапка.Ломбард);
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			//////////////////////////////////////////////////////////////////////
			// 2-я страница формы
			
			ИтогоКоличествоНакопительный   	= 0;
			ИтогоОбщаяМассаНакопительный   	= 0;
			ИтогоМассаМеталлаНакопительный 	= 0;
			ИтогоКоличествоФактНакопительный = 0; 
			ИтогоОбщаяМассаФактНакопительный = 0;
			ИтогоМассаМеталлаФактНакопительный = 0;
			
			НомерСтраницы = 1;
			Ном = 0;
			
			// Выводим заголовок таблицы
			ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ТабДокумент.Вывести(ЗаголовокТаблицы);
			
			// Выводим многострочную часть документа
			ПодвалСтраницы  = Макет.ПолучитьОбласть("ПодвалСтраницы");	
			ПодвалНомСтр = Макет.ПолучитьОбласть("НомерСтраницы");
			
			ГраницаНет = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			
			//ПредыдущийОЗ = "";
			
			Пока ВыборкаСтрокТовары.Следующий() Цикл 

				ДатаС = НачалоДня(Шапка.ДатаНачалаИнвентаризации);
				ДадаПо = ?(Шапка.ДатаОкончанияИнвентаризации = Дата(1,1,1), ТекущаяДата(), Шапка.ДатаОкончанияИнвентаризации);
				
				Если НЕ Выбывшие Тогда
					ДатаВыкупа = ВернутьДатуВыкупаИзделия(ВыборкаСтрокТовары.ОбъектЗалога, ВыборкаСтрокТовары.ОперацияЗайма, ДатаС, ДадаПо, Док, Истина);
					СтруктураВставки = ПолучитьВставки(ВыборкаСтрокТовары.ОбъектЗалога, Шапка.Ссылка, ТЧСтруктура, Ложь);
				Иначе
					//Если ПредыдущийОЗ = ВыборкаСтрокТовары.ОбъектЗалога Тогда
					//	Продолжить;
					//КонецЕсли;

					//ПредыдущийОЗ = ВыборкаСтрокТовары.ОбъектЗалога;
					
					Если ВыборкаСтрокТовары.СтатусОбъектаЗалога = Перечисления.ЛБ_СтатусыОбъектовЗалога.Возвращен Тогда
						Продолжить;
					КонецЕсли;
					
					ДокументВыбытия = ВернутьДокументВыкупаИзделия(ВыборкаСтрокТовары.ОбъектЗалога, ВыборкаСтрокТовары.ОперацияЗайма, ДатаС, ДадаПо, Док);
					СтруктураВставки = ПолучитьВставкиВыбывших(ВыборкаСтрокТовары.ОбъектЗалога, Док);
					
					Если ДокументВыбытия = "" Тогда
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				Ном = Ном + 1;
				СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
				СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары); 
				СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.ОбъектЗалога.Наименование) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";
				СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", "" + ВыборкаСтрокТовары.Комментарий,
					"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
				
				Если ЗначениеЗаполнено(ВыборкаСтрокТовары.Приемщик) Тогда
					//СтрокаТаблицы.Параметры.Приемщик = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СокрЛП(ВыборкаСтрокТовары.Приемщик.Сотрудник.Наименование)); 
					СтрокаТаблицы.Параметры.Приемщик = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СокрЛП(ВыборкаСтрокТовары.Приемщик.Наименование)); 
				КонецЕсли;
				
				
				КоличествоФакт = ВыборкаСтрокТовары.Количество;
				ОбщаяМассаФакт = ВыборкаСтрокТовары.ОбщаяМасса; 
				МассаМеталлаФакт = ВыборкаСтрокТовары.МассаМеталла;
				
				Если НЕ Выбывшие И ДатаВыкупа <> "" Тогда
					СтрокаТаблицы.Параметры.ДатаВыкупа = ДатаВыкупа;
					СтрокаТаблицы.Параметры.ПробаФакт  = "-";
					КоличествоФакт = 0; 
					ОбщаяМассаФакт = 0; 
					МассаМеталлаФакт = 0;
					//СтрокаТаблицы.Параметры.Отклонения = "Выкуплено " + Формат(ДатаВыкупа, "ДФ=dd.MM.yyyy");
				ИначеЕсли Выбывшие Тогда
					Если ТипЗнч(ДокументВыбытия) = Тип("ДокументСсылка.ЛБ_ОперацияПоЗалогу") Тогда
						Если ВыборкаСтрокТовары.ОперацияЗайма.НомерЗалоговогоБилета = ДокументВыбытия.НомерЗалоговогоБилета Тогда
							Если ДокументВыбытия.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога Тогда
								СтрокаТаблицы.Параметры.Отклонения = "Изъятие. Залоговый билет № " + ДокументВыбытия.НомерЗалоговогоБилета;
							Иначе
								СтрокаТаблицы.Параметры.Отклонения = "Залоговый билет № " + ДокументВыбытия.НомерЗалоговогоБилета;
							КонецЕсли;
						Иначе
							Если ДокументВыбытия.ВидОперации = Перечисления.ЛБ_ВидыОперацийОперацияПоЗалогу.Переоформление Тогда
								СтрокаТаблицы.Параметры.Отклонения = "Переоформление. Залоговый билет № " + ДокументВыбытия.НомерЗалоговогоБилета;
							Иначе
								СтрокаТаблицы.Параметры.Отклонения = "Залоговый билет № " + ВыборкаСтрокТовары.ОперацияЗайма.НомерЗалоговогоБилета;
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ТипЗнч(ДокументВыбытия) = Тип("ДокументСсылка.ЛБ_ИзменениеСтатусаНакладной") Тогда
						СтрокаТаблицы.Параметры.Отклонения = "Накладная на отгрузку № " + ДокументВыбытия.НакладнаяНаОтгрузку.ПредставлениеНомераНакладной
						+ " от " + Формат(ДокументВыбытия.НакладнаяНаОтгрузку.Дата, "ДФ=dd.MM.yyyy");
					ИначеЕсли ТипЗнч(ДокументВыбытия) = Тип("ДокументСсылка.ЛБ_ПеремещениеОбъектовЗалога") Тогда
						СтрокаТаблицы.Параметры.Отклонения = "Накладная перемещения № " + ДокументВыбытия.ПредставлениеНомераПеремещения
						+ " от " + Формат(ДокументВыбытия.Дата, "ДФ=dd.MM.yyyy");
					ИначеЕсли ТипЗнч(ДокументВыбытия) = Тип("ДокументСсылка.ЛБ_Реализация") Тогда
						СтрокаТаблицы.Параметры.Отклонения = "Реализация № " + ДокументВыбытия.ПредставлениеНомера
						+ " от " + Формат(ДокументВыбытия.Дата, "ДФ=dd.MM.yyyy");
					КонецЕсли;
					
					СтрокаТаблицы.Параметры.ДатаВыкупа = ДокументВыбытия.Дата;
				КонецЕсли;
				
				СтрокаТаблицы.Параметры.КоличествоФакт   = КоличествоФакт; 
				СтрокаТаблицы.Параметры.ОбщаяМассаФакт   = ОбщаяМассаФакт; 
				СтрокаТаблицы.Параметры.МассаМеталлаФакт = МассаМеталлаФакт; 				
				
				//Проверяем влазиет ли строка с описание вставок на один лист
				СтрокаСПодвалом = Новый Массив;
				СтрокаСПодвалом.Добавить(СтрокаТаблицы);
				
				Если СтруктураВставки.Камни <> Неопределено Тогда
					Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
						СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
						
						СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
						
						СтрокаСПодвалом.Добавить(СтрокаВставки);
					КонецЦикла;
				КонецЕсли;
				
				Если СтруктураВставки.Металлы <> Неопределено Тогда
					Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
						СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
						
						СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
						СтрокаСПодвалом.Добавить(СтрокаВставки);
					КонецЦикла;
				КонецЕсли;
				//
				
				СтрокаСПодвалом.Добавить(ПодвалСтраницы);
				СтрокаСПодвалом.Добавить(ПодвалНомСтр);
				
				Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда
					
					ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
					ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры;
					
					ПараметрыОбласти.ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный;
					ПараметрыОбласти.ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный;
					ПараметрыОбласти.ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный;
					ПараметрыОбласти.ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный; 
					ПараметрыОбласти.ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный;
					ПараметрыОбласти.ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный;
					
					ТабДокумент.Вывести(ОбластьИтоговПоСтранице);
					
					//НомерСтраницы = НомерСтраницы + 1;
					ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
					//ОбластьНомерСтраницы.Параметры.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
					
					НомерСтраницы = НомерСтраницы + 1;
					
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					
					//				ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы;
					ТабДокумент.Вывести(ЗаголовокТаблицы);
				КонецЕсли;
				
				Если СтруктураВставки.Камни <> Неопределено ИЛИ СтруктураВставки.Металлы <> Неопределено Тогда
					СтрокаТаблицы.Области.Строка.ГраницаСнизу = ГраницаНет;
				КонецЕсли;
				
				СтрокаТаблицы.Параметры.Номер = Ном;
				ТабДокумент.Вывести(СтрокаТаблицы);
				
				КоличествоВставок = 0;
				
				Если СтруктураВставки.Камни <> Неопределено Тогда
					КоличествоВставок = СтруктураВставки.Камни.Количество();
				КонецЕсли;
				
				Если СтруктураВставки.Металлы <> Неопределено Тогда
					КоличествоВставок = КоличествоВставок + СтруктураВставки.Металлы.Количество();
				КонецЕсли;
				
				ПорядковыйНомерВставки = 1;
				
				Если СтруктураВставки.Камни <> Неопределено Тогда
					Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
						СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
						
						СтрокаВставки.Параметры.Заполнить(СтрВ);
						СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
						
						Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
							СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
						КонецЕсли;
						
						Если ДатаВыкупа <> "" Тогда
							СтрокаВставки.Параметры.КоличествоФакт = 0;
							СтрокаВставки.Параметры.ВидВставкиФакт = "-";
							СтрокаВставки.Параметры.ВесФакт = 0;
						КонецЕсли;
						
						ТабДокумент.Вывести(СтрокаВставки);
						
						ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
					КонецЦикла;				
				КонецЕсли;
				
				Если СтруктураВставки.Металлы <> Неопределено Тогда
					Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
						СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
						
						СтрокаВставки.Параметры.Заполнить(СтрМ);
						СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
						
						Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
							СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
						КонецЕсли;
						
						Если ДатаВыкупа <> "" Тогда
							СтрокаВставки.Параметры.КоличествоФакт = 0;
							СтрокаВставки.Параметры.ВидВставкиФакт = "-";
							СтрокаВставки.Параметры.ВесФакт = 0;
						КонецЕсли;
						
						ТабДокумент.Вывести(СтрокаВставки);
						
						ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
					КонецЦикла;				
				КонецЕсли;
				
				ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный + ВыборкаСтрокТовары.Количество;
				ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный + ВыборкаСтрокТовары.ОбщаяМасса;
				ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный + ВыборкаСтрокТовары.МассаМеталла;
				ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный + КоличествоФакт; 
				ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный + ОбщаяМассаФакт;
				ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный + МассаМеталлаФакт;
			КонецЦикла;
			
			ПодвалИтогов = Макет.ПолучитьОбласть("ПодвалОписи");
			ПодвалИтоговМОЛ = Макет.ПолучитьОбласть("ПодвалОписиМол");
			ПодвалНомСтр = Макет.ПолучитьОбласть("НомерСтраницы");
			
			ПодвалИтоговДокум = Новый Массив;
			ПодвалИтоговДокум.Добавить(ПодвалИтогов);
			ПодвалИтоговДокум.Добавить(ПодвалИтоговМОЛ);
			
			Молы = Шапка.Молы.Выбрать();
			Пока Молы.Следующий() Цикл 		
				ПодвалИтоговМОЛНаим = Макет.ПолучитьОбласть("СтрокаМол");		
				ПодвалИтоговМОЛНаим.Параметры.ДолжностьМОЛ            = Молы.ФИзлицо.Должность;
				ПодвалИтоговМОЛНаим.Параметры.ФИОМОЛ                  = Молы.ФИзлицо;
				ПодвалИтоговДокум.Добавить(ПодвалИтоговМОЛНаим);
			КонецЦикла;
			
			ПодвалИтоговДокум.Добавить(ПодвалНомСтр);
			
			Если НЕ ТабДокумент.ПроверитьВывод(ПодвалИтоговДокум) Тогда
				
				ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
				ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
				
				//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
				
				ТабДокумент.Вывести(ОбластьНомерСтраницы);
				
				НомерСтраницы = НомерСтраницы + 1;
				
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
				ТабДокумент.Вывести(ЗаголовокТаблицы);
			КонецЕсли;
			
			// Выводим итоги по последней странице
			ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
			ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры;
			
			ПараметрыОбласти.ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный;
			ПараметрыОбласти.ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный;
			ПараметрыОбласти.ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный;
			ПараметрыОбласти.ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный; 
			ПараметрыОбласти.ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный;
			ПараметрыОбласти.ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный;  	
			
			ТабДокумент.Вывести(ОбластьИтоговПоСтранице);
			
			// Выводим подвал документа
			//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
			ОбластьМакета.Параметры.Заполнить(Шапка);
			
			Инд = 1;
			Пока ЧленКомиссии.Следующий() Цикл
				Если Инд <= 4 Тогда
					Если ЧленКомиссии.Председатель Тогда
						ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОПредседателя"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
						
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
						КонецЕсли;
					Иначе
						Если Инд <> 1 Тогда //Времено. Исправить
							ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
							
							Если ЧленКомиссии.Дистанционно Тогда
								ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				Иначе
					ТабДокумент.Вывести(ОбластьМакета);
					
					ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
					ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
				КонецЕсли;
				Инд = Инд + 1;
			КонецЦикла;
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОЛ");
			ОбластьМакета.Параметры.Заполнить(Шапка);
			
			ТабДокумент.Вывести(ОбластьМакета);  
			
			Молы = Шапка.Молы.Выбрать();
			Пока Молы.Следующий() Цикл 		
				ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
				ОбластьМакета.Параметры.ДолжностьМОЛ = Молы.Физлицо.Должность;
				ОбластьМакета.Параметры.ФИОМОЛ = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование);
				ТабДокумент.Вывести(ОбластьМакета);			
			КонецЦикла;
			
			ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
			ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
			
			НомерСтраницы = НомерСтраницы;
			//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
			
			ТабДокумент.Вывести(ОбластьНомерСтраницы);
			
			//Добавляем колонтитул
			Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
				ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
			Иначе
				ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
			КонецЕсли;
			
			Если Выбывшие Тогда
				НаимПечФормы = "Опись ценностей, выбывших во время инвентаризации";
			Иначе
				НаимПечФормы = "Опись ценностей, поступивших во время инвентаризации";
			КонецЕсли;
			
			//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
			ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
			ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 7,, Истина);
			
			ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
			+ "                                                                                                " //отступ
			+ НаимПечФормы + " № " + Шапка.НомерДокумента + " от " + Формат(Шапка.ДатаДокумента, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
			+ "                                                                                                " //отступ
			+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
			ТабДокумент.НижнийКолонтитул.Выводить = Истина;
			//
			
			// В табличном документе зададим имя области, в которую был 
			// выведен объект. Нужно для возможности печати покомплектно.
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
			
		КонецЦикла;	//Шапки.Следующий()
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

Функция ПечатьОписиВыбывших(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета)

	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаПечати = ВалютаРегламентированногоУчета; 
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_ОписьВыбывших";

	
	ПервыйДокумент = Истина;

	Для каждого Док из МассивОбъектов Цикл
		
		Шапка = ПолучитьВыборкуШапокБезТоваров(Док);
		
		Товары = ПолучитьВыбывшиеТовары(Док); 
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ОписьВыбывших");
		
		Пока Шапка.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			// Запомним номер строки, с которой начали выводить текущий документ.
			НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
			
		ВыборкаСтрокТовары = Товары;
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();

		//////////////////////////////////////////////////////////////////////
		// 1-я страница формы

		// Выводим шапку накладной
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);      
		ОбластьМакета.Параметры.ДатаПриказа  = Формат(Шапка.ДатаПриказа, "ДФ=dd.MM.yy");
		ОбластьМакета.Параметры.ДатаС  = Формат(Шапка.ДатаС, "ДФ=dd.MM.yy");
		ОбластьМакета.Параметры.ДатаПо = Формат(Шапка.ДатаПо, "ДФ=dd.MM.yy"); 
		ОбластьМакета.Параметры.ВремяОкончания = Шапка.ДатаПо;
		ОбластьМакета.Параметры.Ломбард = Шапка.Ломбард;
		
			
		ТабДокумент.Вывести(ОбластьМакета);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

		//////////////////////////////////////////////////////////////////////
		// 2-я страница формы

		ИтогФактКоличество = 0;
		ИтогФактСумма      = 0;
		ИтогФактСуммаВсего = 0;
		ИтогБухКоличество  = 0;
		ИтогБухСумма       = 0;

		КолвоСтрокПоСтранице = 0;
		КолвоПоСтранице      = 0;
		СуммаЛиста           = 0;
		ИтогоКолво           = 0; 
		
		ИтогоОстатокЗаймаСтраница 	= 0;
		ИтогоКоличествоСтраница   	= 0;
		ИтогоОбщаяМассаСтраница   	= 0;
		ИтогоМассаМеталлаСтраница 	= 0;
		ИтогоОценкаСтраница		 	= 0;
		ИтогоКоличествоФактСтраница = 0; 
		ИтогоОбщаяМассаФактСтраница	= 0;
		ИтогоМассаМеталлаФактСтраница = 0;
		ИтогоОценкаФактСтраница		= 0;
		
		ИтогоОстатокЗаймаНакопительный 	= 0;
		ИтогоКоличествоНакопительный   	= 0;
		ИтогоОбщаяМассаНакопительный   	= 0;
		ИтогоМассаМеталлаНакопительный 	= 0;
		ИтогоОценкаНакопительный		= 0;
		ИтогоКоличествоФактНакопительный = 0; 
		ИтогоОбщаяМассаФактНакопительный = 0;
		ИтогоМассаМеталлаФактНакопительный = 0;
		ИтогоОценкаФактНакопительный	= 0;
		
		НомерСтраницы = 1;
	    Ном = 0;

		// Выводим заголовок таблицы
		ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
//		ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы; 
		ТабДокумент.Вывести(ЗаголовокТаблицы);

		// Выводим многострочную часть документа
		ПодвалСтраницы  = Макет.ПолучитьОбласть("ПодвалСтраницы");	
			
		Пока ВыборкаСтрокТовары.Следующий() Цикл 
			//ДатаВыкупа = "";
			//Если ВыборкаСтрокТовары.КоличествоРасход > 0 Тогда
			//	ДатаВыкупа = ВернутьДатуВыкупаИзделия(ВыборкаСтрокТовары.ОбъектЗалога);
			//КонецЕсли;
				
			Ном = Ном + 1;
			СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
			СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары); 
			СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.ВидИзделия) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";
			СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", "" + ВыборкаСтрокТовары.Комментарий,
				"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
			
			КоличествоФакт = ВыборкаСтрокТовары.Количество;
			ОбщаяМассаФакт = ВыборкаСтрокТовары.ОбщаяМасса; 
			МассаМеталлаФакт = ВыборкаСтрокТовары.МассаМеталла;

			//Если ДатаВыкупа <> "" Тогда
			//	СтрокаТаблицы.Параметры.ДатаВыкупа = Формат(ДатаВыкупа, "ДФ=dd.MM.yy"); 
			//	СтрокаТаблицы.Параметры.ПробаФакт  = "-";
			//	КоличествоФакт = 0; 
			//	ОбщаяМассаФакт = 0; 
			//	МассаМеталлаФакт = 0;
			//КонецЕсли;
			
			СтрокаТаблицы.Параметры.КоличествоФакт   = КоличествоФакт; 
			СтрокаТаблицы.Параметры.ОбщаяМассаФакт   = ОбщаяМассаФакт; 
			СтрокаТаблицы.Параметры.МассаМеталлаФакт = МассаМеталлаФакт; 				
			
			СтрокаСПодвалом = Новый Массив;
			СтрокаСПодвалом.Добавить(СтрокаТаблицы);
			СтрокаСПодвалом.Добавить(ПодвалСтраницы);
			
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДокумент, СтрокаСПодвалом) Тогда

				ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
				ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры;

				//ПараметрыОбласти.ИтогоФактКоличество = ИтогФактКоличество;
				//ПараметрыОбласти.ИтогоФактСумма      = ИтогФактСумма;
				//ПараметрыОбласти.ИтогоБухКоличество  = ИтогБухКоличество;
				//ПараметрыОбласти.ИтогоБухСумма       = ИтогБухСумма;

				//ПараметрыОбласти.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(КолвоСтрокПоСтранице, ,",,,,,,,,0");
				//ПараметрыОбласти.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ЧислоПрописью(ИтогоКоличествоФактСтраница, ,",,,,,,,,0");
				
				
//				ПараметрыОбласти.ИтогоКоличествоСтраница   		= ИтогоКоличествоСтраница;
				//ПараметрыОбласти.ИтогоОбщаяМассаСтраница   		= ИтогоОбщаяМассаСтраница;
				//ПараметрыОбласти.ИтогоМассаМеталлаСтраница 		= ИтогоМассаМеталлаСтраница;
				//ПараметрыОбласти.ИтогоОценкаСтраница		 	= ИтогоОценкаСтраница;
				//ПараметрыОбласти.ИтогоКоличествоФактСтраница 	= ИтогоКоличествоФактСтраница; 
				//ПараметрыОбласти.ИтогоОбщаяМассаФактСтраница	= ИтогоОбщаяМассаФактСтраница;
				//ПараметрыОбласти.ИтогоМассаМеталлаФактСтраница 	= ИтогоМассаМеталлаФактСтраница;
				//ПараметрыОбласти.ИтогоОценкаФактСтраница		= ИтогоОценкаФактСтраница; 
				
				//ПараметрыОбласти.ИтогоОстатокЗаймаНакопительный 	= ИтогоОстатокЗаймаНакопительный;
				ПараметрыОбласти.ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный;
				ПараметрыОбласти.ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный;
				ПараметрыОбласти.ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный;
				//ПараметрыОбласти.ИтогоОценкаНакопительный			= ИтогоОценкаНакопительный;
				ПараметрыОбласти.ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный; 
				ПараметрыОбласти.ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный;
				ПараметрыОбласти.ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный;
				//ПараметрыОбласти.ИтогоОценкаФактНакопительный		= ИтогоОценкаФактНакопительный;
				
				НомерСтраницы = НомерСтраницы + 1;
				ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
				
				
				
				ТабДокумент.Вывести(ОбластьИтоговПоСтранице);
				
				//НомерСтраницы = НомерСтраницы + 1;
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

//				ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы;
				ТабДокумент.Вывести(ЗаголовокТаблицы);

				ИтогФактКоличество = 0;
				ИтогФактСумма      = 0;
				ИтогБухКоличество  = 0;
				ИтогБухСумма       = 0;

				КолвоСтрокПоСтранице = 0;
				КолвоПоСтранице      = 0;
				СуммаЛиста           = 0;
				
				ИтогоОстатокЗаймаСтраница 	= 0;
				ИтогоКоличествоСтраница   	= 0;
				ИтогоОбщаяМассаСтраница   	= 0;
				ИтогоМассаМеталлаСтраница 	= 0;
				ИтогоОценкаСтраница		 	= 0;
				ИтогоКоличествоФактСтраница = 0; 
				ИтогоОбщаяМассаФактСтраница	= 0;
				ИтогоМассаМеталлаФактСтраница = 0;
				ИтогоОценкаФактСтраница		= 0;
			КонецЕсли;

			СтрокаТаблицы.Параметры.Номер = Ном;
			ТабДокумент.Вывести(СтрокаТаблицы);


			КолвоСтрокПоСтранице = КолвоСтрокПоСтранице + 1;
			КолвоПоСтранице      = КолвоПоСтранице      + КоличествоФакт;
			//СуммаЛиста           = СуммаЛиста           + ВыборкаСтрокТовары.Сумма; 
			
//			ИтогоОстатокЗаймаСтраница 	= ИтогоОстатокЗаймаСтраница + ВыборкаСтрокТовары.ОстатокЗайма;
			ИтогоКоличествоСтраница   	= ИтогоКоличествоСтраница + ВыборкаСтрокТовары.Количество;
			ИтогоОбщаяМассаСтраница   	= ИтогоОбщаяМассаСтраница + ВыборкаСтрокТовары.ОбщаяМасса;
			ИтогоМассаМеталлаСтраница 	= ИтогоМассаМеталлаСтраница + ВыборкаСтрокТовары.МассаМеталла;
//			ИтогоОценкаСтраница		 	= ИтогоОценкаСтраница + ВыборкаСтрокТовары.Оценка;
			ИтогоКоличествоФактСтраница = ИтогоКоличествоФактСтраница + КоличествоФакт; 
			ИтогоОбщаяМассаФактСтраница	= ИтогоОбщаяМассаФактСтраница + ОбщаяМассаФакт;
			ИтогоМассаМеталлаФактСтраница = ИтогоМассаМеталлаФактСтраница + МассаМеталлаФакт;
//			ИтогоОценкаФактСтраница		= ИтогоОценкаФактСтраница + ВыборкаСтрокТовары.ОценкаФакт;
			
			ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный + ВыборкаСтрокТовары.Количество;
			ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный + ВыборкаСтрокТовары.ОбщаяМасса;
			ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный + ВыборкаСтрокТовары.МассаМеталла;
			//ИтогоОценкаНакопительный			= ИтогоОценкаНакопительный + ВыборкаСтрокТовары.Оценка;
			ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный + ВыборкаСтрокТовары.КоличествоФакт; 
			ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный + ВыборкаСтрокТовары.ОбщаяМассаФакт;
			ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный + ВыборкаСтрокТовары.МассаМеталлаФакт;
			//ИтогоОценкаФактНакопительный		= ИтогоОценкаФактНакопительный + ВыборкаСтрокТовары.ОценкаФакт;
		КонецЦикла;

		// Выводим итоги по последней странице
		ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ПодвалСтраницы");
		ПараметрыОбласти = ОбластьИтоговПоСтранице.Параметры; 
		
		ПараметрыОбласти.ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный;
		ПараметрыОбласти.ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный;
		ПараметрыОбласти.ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный;
		//ПараметрыОбласти.ИтогоОценкаНакопительный			= ИтогоОценкаНакопительный;
		ПараметрыОбласти.ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный; 
		ПараметрыОбласти.ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный;
		ПараметрыОбласти.ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный;
		
//		ПараметрыОбласти.ИтогоФактКоличество  = ИтогФактКоличество;
//		ПараметрыОбласти.ИтогоФактСумма       = ИтогФактСумма;
//		ПараметрыОбласти.ИтогоБухКоличество   = ИтогБухКоличество;
//		ПараметрыОбласти.ИтогоБухСумма        = ИтогБухСумма;
//		ПараметрыОбласти.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(КолвоСтрокПоСтранице, ,",,,,,,,,0");
//		ПараметрыОбласти.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ОбщегоНазначенияБПВызовСервера.КоличествоПрописью(КолвоПоСтранице);
//		ПараметрыОбласти.СуммаФактическиНаСтраницеПрописью                 = ОбщегоНазначенияБПВызовСервера.СформироватьСуммуПрописью(СуммаЛиста, ВалютаПечати);
		ТабДокумент.Вывести(ОбластьИтоговПоСтранице);

		// Выводим подвал документа
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		
		Инд = 1;
		Пока ЧленКомиссии.Следующий() Цикл
			Если Инд <= 4 Тогда
				Если ЧленКомиссии.Председатель Тогда
					ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОПредседателя"] = ЧленКомиссии.ФизЛицо;
					
					Если ЧленКомиссии.Дистанционно Тогда
						ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
					КонецЕсли;
				Иначе
					Если Инд <> 1 Тогда //Времено. Исправить
						ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо;
						
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;		
			Иначе
				ТабДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
		       	ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
				ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ЧленКомиссии.ФизЛицо;
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОЛ");
		ОбластьМакета.Параметры.Заполнить(Шапка);
//		ОбластьМакета.Параметры.НачальныйНомерПоПорядку = 1;
//		ОбластьМакета.Параметры.НомерКонца              = ВыборкаСтрокТовары.Количество();
		
		ТабДокумент.Вывести(ОбластьМакета);  
		
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = Молы.ФИзлицо;
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		  	
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

		КонецЦикла;	//Шапки.Следующий()
		КонецЦикла;

	Возврат ТабДокумент;

КонецФункции

Функция ПечатьАктаПроверки(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета)

	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаПечати = ВалютаРегламентированногоУчета;  
	
	Шапка = ПолучитьВыборкуШапок_АктПроверки(МассивОбъектов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_АктПроверки";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_АктПроверки");
	ПервыйДокумент = Истина;

	ГраницаНет = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	
	Пока Шапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВыборкаСтрокТовары = ПолучитьСтрокиДокумента_АктПроверки(МассивОбъектов);
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать(); 
          	
		//////////////////////////////////////////////////////////////////////
		// 1-я страница формы

		// Выводим шапку накладной
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка); 	
		
		ОбластьМакета.Параметры.ДатаДокумента            = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy");
		ОбластьМакета.Параметры.НомерДокумента           = Шапка.Номер; //ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер, Истина, Ложь);
		ОбластьМакета.Параметры.Подразделение = Шапка.Ломбард.НомерЛомбарда;
		ОбластьМакета.Параметры.Город = ПолучитьГород(Шапка.Ломбард);
		ОбластьМакета.Параметры.Отделение = ПолучитьОтделение(Шапка.Дата, Шапка.Ломбард);
			
		ТабДокумент.Вывести(ОбластьМакета); 
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.ФИзлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование);
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПодвал");
		//ОбластьМакета.Параметры.Заполнить(Шапка);
		ОбластьМакета.Параметры.ДатаДокумента = Формат(Шапка.Дата, "ДЛФ=DD");
		ОбластьМакета.Параметры.ВидИнвентаризации = НРег(Шапка.ВидИнвентаризации);
		ТабДокумент.Вывести(ОбластьМакета);		
		
		//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

		//////////////////////////////////////////////////////////////////////
		// 2-я страница формы

		ИтогФактКоличество = 0;
		ИтогФактСумма      = 0;
		ИтогФактСуммаВсего = 0;
		ИтогБухКоличество  = 0;
		ИтогБухСумма       = 0;

		КолвоСтрокПоСтранице = 0;
		КолвоПоСтранице      = 0;
		СуммаЛиста           = 0;
		ИтогоКолво           = 0; 
		
		ИтогоОстатокЗаймаНакопительный 	= 0;
		ИтогоКоличествоНакопительный   	= 0;
		ИтогоОбщаяМассаНакопительный   	= 0;
		ИтогоМассаМеталлаНакопительный 	= 0;
		ИтогоКоличествоФактНакопительный = 0; 
		ИтогоОбщаяМассаФактНакопительный = 0;
		ИтогоМассаМеталлаФактНакопительный = 0;
		
		НомерСтраницы = 1;
	    Ном = 0;

		// Выводим заголовок таблицы
		ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
//		ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы; 
		ТабДокумент.Вывести(ЗаголовокТаблицы);

		// Выводим многострочную часть документа
		ПодвалНомСтр = Макет.ПолучитьОбласть("НомерСтраницы");

		Пока ВыборкаСтрокТовары.Следующий() Цикл 

			Ном = Ном + 1;
			СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
			СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары);
			СтрокаТаблицы.Параметры.Залогодатель = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаСтрокТовары.Залогодатель.Наименование);
			//СтрокаТаблицы.Параметры.Приемщик = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаСтрокТовары.Приемщик.Сотрудник.Наименование);
			СтрокаТаблицы.Параметры.Приемщик = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаСтрокТовары.Приемщик.Наименование);
			СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", "" + ВыборкаСтрокТовары.Комментарий,
				"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
			
			ОписаниеОЗ = ПолучитьОписаниеОЗ(НачалоДня(Шапка.Дата), ВыборкаСтрокТовары.ОбъектЗалога);
			ИнформацияИменника = ?(ВыборкаСтрокТовары.Именник = Перечисления.ЛБ_Именник.Нет, "", ВыборкаСтрокТовары.ДанныеИменника);
			ИнформацияДефекты = ?(ВыборкаСтрокТовары.Дефекты = "", "", ", " + ВыборкаСтрокТовары.Дефекты);
			ИнформацияОписаниеОЗ = ?(ОписаниеОЗ = "", "", ", " + ОписаниеОЗ);
			
			Описание = ?(ИнформацияИменника = "", "" + ВыборкаСтрокТовары.СостояниеИзделия, "" +  ИнформацияИменника + ", " + ВыборкаСтрокТовары.СостояниеИзделия);
			Описание = ?(ИнформацияДефекты = "", "" +  Описание + ИнформацияОписаниеОЗ, "" +  Описание + ИнформацияДефекты + ИнформацияОписаниеОЗ);
			
			СтрокаТаблицы.Параметры.ОписаниеОЗ = Описание;

			СтруктураВставки = ПолучитьВставкиДокумента_АктПроверки(ВыборкаСтрокТовары.ОбъектЗалога, Шапка.Ссылка);
						
			СтрокаСПодвалом = Новый Массив;
			СтрокаСПодвалом.Добавить(СтрокаТаблицы);

			//Проверяем влазиет ли строка с описание вставок на один лист
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.Проба);
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			//

			СтрокаСПодвалом.Добавить(ПодвалНомСтр);
			
			Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда

				ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
				ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;

				//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
				
				ТабДокумент.Вывести(ОбластьНомерСтраницы);

				НомерСтраницы = НомерСтраницы + 1;
				
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

				ТабДокумент.Вывести(ЗаголовокТаблицы);
			КонецЕсли;

			Если СтруктураВставки.Камни <> Неопределено ИЛИ СтруктураВставки.Металлы <> Неопределено Тогда
				СтрокаТаблицы.Области.Строка.ГраницаСнизу = ГраницаНет;
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.Номер = Ном;
			ТабДокумент.Вывести(СтрокаТаблицы);


			КоличествоВставок = 0;

			Если СтруктураВставки.Камни <> Неопределено Тогда
				КоличествоВставок = СтруктураВставки.Камни.Количество();
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				КоличествоВставок = КоличествоВставок + СтруктураВставки.Металлы.Количество();
			КонецЕсли;
			
			ПорядковыйНомерВставки = 1;
			
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрВ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					ТабДокумент.Вывести(СтрокаВставки);
					
					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;

			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрМ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.Проба);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					ТабДокумент.Вывести(СтрокаВставки);

					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;
			
			КолвоСтрокПоСтранице = КолвоСтрокПоСтранице + 1;
			КолвоПоСтранице      = КолвоПоСтранице      + ВыборкаСтрокТовары.КоличествоФакт;
			
			ИтогоОстатокЗаймаНакопительный = ИтогоОстатокЗаймаНакопительный + ВыборкаСтрокТовары.ОстатокЗайма;
			ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный + ВыборкаСтрокТовары.Количество;
			ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный + ВыборкаСтрокТовары.ОбщаяМасса;
			ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный + ВыборкаСтрокТовары.МассаМеталла;
			ИтогоКоличествоФактНакопительный 	= ИтогоКоличествоФактНакопительный + ВыборкаСтрокТовары.КоличествоФакт; 
			ИтогоОбщаяМассаФактНакопительный 	= ИтогоОбщаяМассаФактНакопительный + ВыборкаСтрокТовары.ОбщаяМассаФакт;
			ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный + ВыборкаСтрокТовары.МассаМеталлаФакт;
		КонецЦикла;

 		ПодвалИтогов = Макет.ПолучитьОбласть("ПодвалОписи");
		ПодвалИтоговМОЛ = Макет.ПолучитьОбласть("ПодвалОписиМол");
		ПодвалНомСтр = Макет.ПолучитьОбласть("НомерСтраницы");
		ПодвалИтоги = Макет.ПолучитьОбласть("ПодвалИтоги");
		ПодвалИтогиСтрока = Макет.ПолучитьОбласть("ПодвалСтрока");

		ПодвалИтоговДокум = Новый Массив;
		ПодвалИтоговДокум.Добавить(ПодвалИтогов);
		ПодвалИтоговДокум.Добавить(ПодвалИтоговМОЛ);
		
		Молы = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ПодвалИтоговМОЛНаим = Макет.ПолучитьОбласть("СтрокаМол");		
			ПодвалИтоговМОЛНаим.Параметры.ДолжностьМОЛ            = Молы.ФИзлицо.Должность;
			ПодвалИтоговМОЛНаим.Параметры.ФИОМОЛ                  = Молы.ФИзлицо;
			ПодвалИтоговДокум.Добавить(ПодвалИтоговМОЛНаим);
		КонецЦикла;
		
		ПодвалИтоговДокум.Добавить(ПодвалНомСтр);
		
		Если НЕ ТабДокумент.ПроверитьВывод(ПодвалИтоговДокум) Тогда
			
			ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
			ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
			
			//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
			
			ТабДокумент.Вывести(ОбластьНомерСтраницы);
			
			НомерСтраницы = НомерСтраницы + 1;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ТабДокумент.Вывести(ЗаголовокТаблицы);
		КонецЕсли;

		// Выводим подвал документа
		ОбластьПодвалИтоги = Макет.ПолучитьОбласть("ПодвалИтоги");
		ОбластьПодвалИтоги.Параметры.ИтогоОстатокЗаймаНакопительный = ИтогоОстатокЗаймаНакопительный;
		ОбластьПодвалИтоги.Параметры.ИтогоКоличествоНакопительный = ИтогоКоличествоНакопительный;
		ОбластьПодвалИтоги.Параметры.ИтогоКоличествоФактНакопительный = ИтогоКоличествоФактНакопительный;
		ОбластьПодвалИтоги.Параметры.ИтогоОбщаяМассаНакопительный = ИтогоОбщаяМассаНакопительный;
		ОбластьПодвалИтоги.Параметры.ИтогоОбщаяМассаФактНакопительный = ИтогоОбщаяМассаФактНакопительный;
		ОбластьПодвалИтоги.Параметры.ИтогоМассаМеталлаНакопительный = ИтогоМассаМеталлаНакопительный;
		ОбластьПодвалИтоги.Параметры.ИтогоМассаМеталлаФактНакопительный = ИтогоМассаМеталлаФактНакопительный;
		
		ТабДокумент.Вывести(ОбластьПодвалИтоги);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
		ОбластьМакета.Параметры.Заполнить(Шапка);  
		
		ОбластьМакета.Параметры.ОбщееКоличествоЕдиницФактическиНаСтраницеПрописью = ЧислоПрописью(ИтогоКоличествоФактНакопительный, ,",,,ж,,,,,0");		
		ОбластьМакета.Параметры.КоличествоПорядковыхНомеровНаСтраницеПрописью     = ЧислоПрописью(Ном, ,",,,,,,,,0");
		ФорматСтроки = "L=ru_RU";
		ПараметрыСтроки = "целая, целых, целых, ж, сотая, сотых, сотых, ж, 2";
		ОбластьМакета.Параметры.ИтогоМассаМеталлаФактНакопительный = ЧислоПрописью(ИтогоМассаМеталлаФактНакопительный, ФорматСтроки, ПараметрыСтроки);
		ОбластьМакета.Параметры.ИтогоОбщаяМассаФактНакопительный = ЧислоПрописью(ИтогоОбщаяМассаФактНакопительный, ФорматСтроки, ПараметрыСтроки);
		ОбластьМакета.Параметры.НачальныйНомерПоПорядку = 1;
		ОбластьМакета.Параметры.НомерКонца              = Ном;
		
		Инд = 1;
		Пока ЧленКомиссии.Следующий() Цикл
			Если Инд <= 4 Тогда
				Если ЧленКомиссии.Председатель Тогда
					ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОПредседателя"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
					
					Если ЧленКомиссии.Дистанционно Тогда
						ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
					КонецЕсли;
				Иначе
					Если Инд <> 1 Тогда //Времено. Исправить
						ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
						
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;		
			Иначе
				ТабДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
		       	ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
				ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		ПодвалИтогиСтрока = Макет.ПолучитьОбласть("ПодвалСтрока");
		ТабДокумент.Вывести(ПодвалИтогиСтрока);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОЛ");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование);
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
		ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
		
		НомерСтраницы = НомерСтраницы;
		//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);

		ТабДокумент.Вывести(ОбластьНомерСтраницы);
		
		//Добавляем колонтитул
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
		Иначе
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
		КонецЕсли;
			
		НаимПечФормы = "Акт проверки предметов залога";
		
		//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
		ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
		ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 7,, Истина);
		
		ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
		+ "                                                                                                " //отступ
		+ НаимПечФормы + " № " + Шапка.Номер + " от " + Формат(Шапка.Дата, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
		+ "                                                                                                " //отступ
		+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
		ТабДокумент.НижнийКолонтитул.Выводить = Истина;
		//
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;	//Шапки.Следующий() 

	Возврат ТабДокумент;

КонецФункции

Функция ПечатьПосылки(МассивОбъектов, ОбъектыПечати)

	УстановитьПривилегированныйРежим(Истина);
	
	Шапка = ПолучитьВыборкуШапок_Посылки(МассивОбъектов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_НеРаспакованныеПосылки";
	ТабДокумент.ТолькоПросмотр = Истина;
	ТабДокумент.Защита = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.НеРаспакованныеПосылки");
	ПервыйДокумент = Истина;

	ТЧСтруктура = Новый Структура;
	ТЧСтруктура.Вставить("ТЧКамни", "ВставкиКамнейСумкаЗакрыта");
	ТЧСтруктура.Вставить("ТЧМеталл", "ВставкиМеталлаСумкаЗакрыта");
	
	Пока Шапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВыборкаСтрокТовары = Шапка.Товары.Выбрать();
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();

		//////////////////////////////////////////////////////////////////////
		// 1-я страница формы

		// Выводим шапку накладной
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);
		ОбластьМакета.Параметры.Подразделение = Шапка.Ломбард.НомерЛомбарда;	
		ТабДокумент.Вывести(ОбластьМакета); 
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ                  = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование); //Молы.Физлицо;
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПодвал");
		ОбластьМакета.Параметры.ДатаНачалаИнвентаризации = Формат(Шапка.ДатаНачалаИнвентаризации, "ДЛФ=DD");	
		ТабДокумент.Вывести(ОбластьМакета);		

		//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

		//////////////////////////////////////////////////////////////////////
		// 2-я страница формы

		ИтогоКоличествоНакопительный   	= 0;
		ИтогоОбщаяМассаНакопительный   	= 0;
		ИтогоМассаМеталлаНакопительный 	= 0;
		
		НомерСтраницы = 1;
	    Ном = 0;

		// Выводим заголовок таблицы
		ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ТабДокумент.Вывести(ЗаголовокТаблицы);

		// Выводим многострочную часть документа
		Пока ВыборкаСтрокТовары.Следующий() Цикл

			СтруктураВставки = ПолучитьВставки(ВыборкаСтрокТовары.ОбъектЗалога, Шапка.Ссылка, ТЧСтруктура, Ложь);
			
			Ном = Ном + 1;
			СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
			СтрокаТаблицы.Параметры.Заполнить(ВыборкаСтрокТовары); 
			
			СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.Наименование) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";
			
			СтрокаСПодвалом = Новый Массив;
			СтрокаСПодвалом.Добавить(СтрокаТаблицы);
			
			//Проверяем влазиет ли строка с описание вставок на один лист
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
					СтрокаСПодвалом.Добавить(СтрокаВставки);
				КонецЦикла;
			КонецЕсли;
			//
		
			ГраницаНет = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ГраницаЕсть = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
			
			Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

				ТабДокумент.Вывести(ЗаголовокТаблицы);
			КонецЕсли;

			Если СтруктураВставки.Камни <> Неопределено ИЛИ СтруктураВставки.Металлы <> Неопределено Тогда
				СтрокаТаблицы.Области.Строка.ГраницаСнизу = ГраницаНет;
			КонецЕсли;

			СтрокаТаблицы.Параметры.Номер = Ном;
			ТабДокумент.Вывести(СтрокаТаблицы);

			КоличествоВставок = 0;

			Если СтруктураВставки.Камни <> Неопределено Тогда
				КоличествоВставок = СтруктураВставки.Камни.Количество();
			КонецЕсли;
			
			Если СтруктураВставки.Металлы <> Неопределено Тогда
				КоличествоВставок = КоличествоВставок + СтруктураВставки.Металлы.Количество();
			КонецЕсли;
			
			ПорядковыйНомерВставки = 1;
			
			Если СтруктураВставки.Камни <> Неопределено Тогда
				Для Каждого СтрВ Из СтруктураВставки.Камни Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрВ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрВ.ВидВставки) + " " + СокрЛП(СтрВ.ВидОгранки) + " " + СокрЛП(СтрВ.КачествоОгранки);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;
					
					ТабДокумент.Вывести(СтрокаВставки);
					
					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;

			Если СтруктураВставки.Металлы <> Неопределено Тогда
				Для Каждого СтрМ Из СтруктураВставки.Металлы Цикл
					СтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки");
					
					СтрокаВставки.Параметры.Заполнить(СтрМ);
					СтрокаВставки.Параметры.Наименование = "- " + СокрЛП(СтрМ.ВидВставки);
					
					Если ПорядковыйНомерВставки <> КоличествоВставок Тогда
						СтрокаВставки.Области.СтрокаВставки.ГраницаСнизу = ГраницаНет;
					КонецЕсли;

					ТабДокумент.Вывести(СтрокаВставки);

					ПорядковыйНомерВставки = ПорядковыйНомерВставки + 1;
				КонецЦикла;				
			КонецЕсли;
			
			ИтогоКоличествоНакопительный   	= ИтогоКоличествоНакопительный + ВыборкаСтрокТовары.Количество;
			ИтогоОбщаяМассаНакопительный   	= ИтогоОбщаяМассаНакопительный + ВыборкаСтрокТовары.ОбщаяМасса;
			ИтогоМассаМеталлаНакопительный 	= ИтогоМассаМеталлаНакопительный + ВыборкаСтрокТовары.МассаМеталла;
		КонецЦикла;

		ПодвалИтого  = Макет.ПолучитьОбласть("ПодвалИтого");
		ПодвалОписи  = Макет.ПолучитьОбласть("ПодвалОписи");
		
		СтрокиСПодваломОписи = Новый Массив;
		СтрокиСПодваломОписи.Добавить(ПодвалИтого);
		СтрокиСПодваломОписи.Добавить(ПодвалОписи);
		
		Молы = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьПодвалМолНаим = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьПодвалМолНаим.Параметры.ДолжностьМОЛ = Молы.Физлицо.Должность;
			ОбластьПодвалМолНаим.Параметры.ФИОМОЛ = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование); //Молы.Физлицо;
			СтрокиСПодваломОписи.Добавить(ОбластьПодвалМолНаим);			
		КонецЦикла;
		
		Если НЕ ТабДокумент.ПроверитьВывод(СтрокиСПодваломОписи) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ТабДокумент.Вывести(ЗаголовокТаблицы);
		КонецЕсли;
		
		// Выводим итоги по последней странице
		ОбластьПодвалИтогов = Макет.ПолучитьОбласть("ПодвалИтого");
		ПараметрыОбласти = ОбластьПодвалИтогов.Параметры;
		
		ПараметрыОбласти.ОбщееКоличество   	= ИтогоКоличествоНакопительный;
		ПараметрыОбласти.ОбщаяМасса   	= ИтогоОбщаяМассаНакопительный;
		ПараметрыОбласти.ОбщаяМассаМеталла 	= ИтогоМассаМеталлаНакопительный;
                       	
		ТабДокумент.Вывести(ОбластьПодвалИтогов);

		// Выводим подвал документа
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
		ОбластьМакета.Параметры.Заполнить(Шапка);  
		
		Инд = 1;
		Пока ЧленКомиссии.Следующий() Цикл
						
			Если Инд <= 4 Тогда
				Если ЧленКомиссии.Председатель Тогда
					ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОПредседателя"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование); //ЧленКомиссии.ФизЛицо;
					
					Если ЧленКомиссии.Дистанционно Тогда
						ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
					КонецЕсли;
				Иначе
					Если Инд <> 1 Тогда //Времено. Исправить
						ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование); //ЧленКомиссии.ФизЛицо;
						
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;		
			Иначе
				ТабДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
		       	ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
				ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование); //ЧленКомиссии.ФизЛицо;
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		Молы         = Шапка.Молы.Выбрать();
		Пока Молы.Следующий() Цикл 		
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
			ОбластьМакета.Параметры.ДолжностьМОЛ         = Молы.Физлицо.Должность;
			ОбластьМакета.Параметры.ФИОМОЛ               = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование); //Молы.ФИзлицо;
			ТабДокумент.Вывести(ОбластьМакета);			
		КонецЦикла;
		
		//Добавляем колонтитул
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
		Иначе
			ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
		КонецЕсли;
			
		НаимПечФормы = "Опись не распакованных посылок с ценностями";
		
		//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
		ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
		ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 8,, Истина);
		
		ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
		+ "                     " //отступ
		+ НаимПечФормы + " № " + Шапка.НомерДокумента + " от " + Формат(Шапка.ДатаДокумента, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
		+ "                     " //отступ
		+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
		ТабДокумент.НижнийКолонтитул.Выводить = Истина;
		//
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;	//Шапки.Следующий() 

	Возврат ТабДокумент;

КонецФункции

Функция ВернутьОтделение(Ломбард, НаДату)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Отделение КАК Отделение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(&НаДату, ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних
	               |ГДЕ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард = &Ломбард";
	Запрос.УстановитьПараметр("Ломбард", Ломбард); 
	Запрос.УстановитьПараметр("НаДату", НаДату);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Отделение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПечатьИзъятых(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета)

	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаПечати = ВалютаРегламентированногоУчета; 
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_Изъятые";

	
	ПервыйДокумент = Истина;

	Для каждого Док из МассивОбъектов Цикл
		
		Шапка = ПолучитьВыборкуШапокИзъятые(Док);
		
		//Товары = ПолучитьИзъятыеТовары(Док); 
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.Изъятые");
		
		Пока Шапка.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			// Запомним номер строки, с которой начали выводить текущий документ.
			НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
			
			ВыборкаСтрокТовары = Шапка.Изъятые.Выбрать(); //Товары;
			ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();
			
			//////////////////////////////////////////////////////////////////////
			// 1-я страница формы
			
			// Выводим шапку накладной
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(Шапка);      
			ОбластьМакета.Параметры.ДатаДокумента  = Формат(Шапка.ДатаДокумента, "ДЛФ=DD");
			ОбластьМакета.Параметры.НомерЛомбарда = Шапка.Ломбард.НомерЛомбарда;
			ОбластьМакета.Параметры.Отделение = ВернутьОтделение(Шапка.Ломбард, Док.Дата);
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			//////////////////////////////////////////////////////////////////////
			// 2-я страница формы
			
			НомерСтраницы = 1;
			Ном = 0;
			
			// Выводим заголовок таблицы
			ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ТабДокумент.Вывести(ЗаголовокТаблицы);
			
			// Выводим многострочную часть документа
			НомСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
			ПодвалОписиЧК = Макет.ПолучитьОбласть("ПодвалОписи");
			ПодвалОписиМОЛ = Макет.ПолучитьОбласть("ПодвалОписиМОЛ");
			
			Пока ВыборкаСтрокТовары.Следующий() Цикл 
				
				ДанныеОЗ = ПолучитьДанныеПоОЗ(НачалоДня(Шапка.ДатаНачалаИнвентаризации), ВыборкаСтрокТовары.ОбъектЗалога, ВыборкаСтрокТовары.ОперацияЗайма.НомерЗалоговогоБилета);
				ДанныеОЗСуммы = ПолучитьСуммыПоОЗ(ДанныеОЗ.Регистратор.Дата, ВыборкаСтрокТовары.ОперацияЗайма);
				
				Ном = Ном + 1;
				СтрокаТаблицы   = Макет.ПолучитьОбласть("Строка");
				СтрокаТаблицы.Параметры.Заполнить(ДанныеОЗ);

				СтрокаТаблицы.Параметры.Наименование = СокрЛП(ВыборкаСтрокТовары.ОбъектЗалога.Наименование) + " ["+СокрЛП(ВыборкаСтрокТовары.Категория)+"]";			
				СтрокаТаблицы.Параметры.Артикул = ВыборкаСтрокТовары.Артикул;
				СтрокаТаблицы.Параметры.Металл = ВыборкаСтрокТовары.Металл;
				СтрокаТаблицы.Параметры.Проба = ВыборкаСтрокТовары.Проба.Проба;
				СтрокаТаблицы.Параметры.СуммаТребования = ДанныеОЗСуммы.ПоОсновномуДолгу + ДанныеОЗСуммы.ПоПроцентам;
				СтрокаТаблицы.Параметры.СуммаПроцентов = ДанныеОЗСуммы.ПоПроцентам;
				СтрокаТаблицы.Параметры.Залогодатель = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СокрЛП(ВыборкаСтрокТовары.Залогодатель)); 
				СтрокаТаблицы.Параметры.НомерПротокола = Формат(ДанныеОЗ.ДатаПротоколаИзъятия, "ДФ=dd.MM.yy");
				
				СтрокаТаблицы.Параметры.Количество   = ВыборкаСтрокТовары.Количество; 
				СтрокаТаблицы.Параметры.ОбщаяМасса   = ВыборкаСтрокТовары.ОбщаяМасса; 
				//СтрокаТаблицы.Параметры.Отклонения = ?(ВыборкаСтрокТовары.Отклонения = "", "" + ВыборкаСтрокТовары.Комментарий,
				//	"" + ВыборкаСтрокТовары.Отклонения + Символы.ПС + ВыборкаСтрокТовары.Комментарий);
				
				СтрокаСПодвалом = Новый Массив;
				СтрокаСПодвалом.Добавить(СтрокаТаблицы);
				СтрокаСПодвалом.Добавить(НомСтраницы);
				
				Если НЕ ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда
					//НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДокумент, СтрокаСПодвалом) Тогда
					
					ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
					ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
					
					//НомерСтраницы = НомерСтраницы + 1;
					//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
					
					ТабДокумент.Вывести(ОбластьНомерСтраницы);
					
					НомерСтраницы = НомерСтраницы + 1;
					
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					
					ТабДокумент.Вывести(ЗаголовокТаблицы);
				КонецЕсли;
				
				СтрокаТаблицы.Параметры.Номер = Ном;
				ТабДокумент.Вывести(СтрокаТаблицы);
			КонецЦикла;
			
			// Выводим итоги по последней странице

			ОбластьНомерСтраницы = Макет.ПолучитьОбласть("НомерСтраницы");
			ПараметрыОбласти = ОбластьНомерСтраницы.Параметры;
			
			//ПараметрыОбласти.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);

			СтрокиСПодваломОписи = Новый Массив;
			СтрокиСПодваломОписи.Добавить(ПодвалОписиЧК);
			СтрокиСПодваломОписи.Добавить(ПодвалОписиМОЛ);
			СтрокиСПодваломОписи.Добавить(НомСтраницы);
			
			Если НЕ ТабДокумент.ПроверитьВывод(СтрокиСПодваломОписи) Тогда
				ТабДокумент.Вывести(ОбластьНомерСтраницы);
				НомерСтраницы = НомерСтраницы + 1;
				
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			//ТабДокумент.Вывести(ОбластьНомерСтраницы);
			
			// Выводим подвал документа
			//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписи");
			ОбластьМакета.Параметры.Заполнить(Шапка);
			
			Инд = 1;
			Пока ЧленКомиссии.Следующий() Цикл
				Если Инд <= 4 Тогда
					Если ЧленКомиссии.Председатель Тогда
						ОбластьМакета.Параметры["ДолжностьПредседателя"] = ЧленКомиссии.ФизЛицо.Должность;
						ОбластьМакета.Параметры["ФИОПредседателя"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
					
						Если ЧленКомиссии.Дистанционно Тогда
							ОбластьМакета.Параметры["ФИОПредседателя"] = ОбластьМакета.Параметры["ФИОПредседателя"] + " (дистанционно)";
						КонецЕсли;
					Иначе
						Если Инд <> 1 Тогда //Времено. Исправить
							ОбластьМакета.Параметры["ДолжностьЧленаКомиссии" + Инд] = ЧленКомиссии.ФизЛицо.Должность;
							ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
							
							Если ЧленКомиссии.Дистанционно Тогда
								ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] = ОбластьМакета.Параметры["ФИОЧленаКомиссии" + Инд] + " (дистанционно)";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;		
				Иначе
					ТабДокумент.Вывести(ОбластьМакета);
					
					ОбластьМакета = Макет.ПолучитьОбласть("ДопЧленКомиссии");
					ОбластьМакета.Параметры["ДолжностьЧленаКомиссии"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["ФИОЧленаКомиссии"] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧленКомиссии.ФизЛицо.Наименование);
				КонецЕсли;
				Инд = Инд + 1;
			КонецЦикла;
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодвалОписиМОЛ");
			ОбластьМакета.Параметры.Заполнить(Шапка);
			
			ПорядковыйНомер = 1;
			
			Молы = Шапка.Молы.Выбрать();
			
			Пока Молы.Следующий() Цикл 		
				ОбластьМакета.Параметры["ДолжностьМОЛ" + ПорядковыйНомер] = Молы.Физлицо.Должность;
				ОбластьМакета.Параметры["ФИОМОЛ" + ПорядковыйНомер] = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Молы.ФизЛицо.Наименование);
				ПорядковыйНомер = ПорядковыйНомер + 1;
			КонецЦикла;

			//ТабДокумент.Вывести(ОбластьМакета);  
			//
			//ОбластьМакета = Макет.ПолучитьОбласть("НомерСтраницы");
			
			//НомерСтраницы = НомерСтраницы + 1;
			//ОбластьМакета.Параметры.НомерСтраницы = "Страница "+СокрЛП(НомерСтраницы);
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			//Добавляем колонтитул
			Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
				ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПараметрыСеанса.ТекущийСотрудник.Наименование);
			Иначе
				ТекСотрудник = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Сотрудник.Наименование);
			КонецЕсли;
			
			НаимПечФормы = "Акт проверки документов, подтверждающих изъятие";
			
			//Т.к. при двусторонней печати левый и правый текст пемяются местами пришлось писать все в центр
			ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
			ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			ТабДокумент.НижнийКолонтитул.Шрифт = Новый Шрифт("Times New Roman", 7,, Истина);
			
			ТабДокумент.НижнийКолонтитул.ТекстВЦентре = "[&Дата] [&Время]" + " " + ТекСотрудник //Левый край
			+ "                                                                                                " //отступ
			+ НаимПечФормы + " № " + Шапка.НомерДокумента + " от " + Формат(Шапка.ДатаДокумента, "ДФ=dd.MM.yyyy") + " Ломбард № " + Шапка.Ломбард.НомерЛомбарда // Центр
			+ "                                                                                                " //отступ
			+ "Страница [&НомерСтраницы] из [&СтраницВсего]"; //Правый край
			
			ТабДокумент.НижнийКолонтитул.Выводить = Истина;
			//
			// В табличном документе зададим имя области, в которую был 
			// выведен объект. Нужно для возможности печати покомплектно.
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
			
		КонецЦикла;	//Шапки.Следующий()
	КонецЦикла;

	Возврат ТабДокумент;

КонецФункции

Функция ПечатьАктаНаличныхДС(МассивОбъектов, ОбъектыПечати, ВалютаРегламентированногоУчета)

	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаПечати = ВалютаРегламентированногоУчета; 
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияТоваровНаСкладе_ПФ_MXL_ИНВ15";

	
	ПервыйДокумент = Истина;

	Для каждого Док из МассивОбъектов Цикл
		
		Шапка = ПолучитьВыборкуШапокБезТоваров(Док);
		

		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЛБ_Инвентаризация.ПФ_MXL_ИНВ15");
		
		Пока Шапка.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			// Запомним номер строки, с которой начали выводить текущий документ.
			НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
			
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();  
		
		Молы         	= Шапка.Молы.Выбрать();  
		КассирДолжность = "";
		ФИОКассира      = "";

		Пока Молы.Следующий() Цикл
			КассирДолжность = Молы.Физлицо.Должность;
			ФИОКассира      = Молы.ФИзлицо;
			Прервать;
		КонецЦикла;    
		
		СуммаПоФакту = 118535.06; 
		СуммаПоФактуРубли = Цел(СуммаПоФакту);
		СуммаПоФактуКопейки = (СуммаПоФакту - СуммаПоФактуРубли)*100; 
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Шапка);      
		ОбластьМакета.Параметры.ДатаДокумента  = Формат(Шапка.Дата, "ДФ=dd.MM.yy; ДЛФ=DD");
 
		
		ОбластьМакета.Параметры.Организация 	= ЛБ_ОбщийМодуль.ПолучитьЗначениеДопНастройки("ОсновнаяОрганизация");
		ОбластьМакета.Параметры.Подразделение  	= Шапка.Ломбард;  
		ОбластьМакета.Параметры.КассирДолжность = КассирДолжность; 
		ОбластьМакета.Параметры.ФИОКассира  	= ФИОКассира;  	
		ТабДокумент.Вывести(ОбластьМакета);
		
		
		ОбластьМакета = Макет.ПолучитьОбласть("СтрокаНаличныхДенег"); 
		ОбластьМакета.Параметры.НомерПоПорядку = 1; 
		ОбластьМакета.Параметры.НаименованиеЦенности = "наличных денег";
		ОбластьМакета.Параметры.СуммаПоФактуРубли = СуммаПоФактуРубли;
		ОбластьМакета.Параметры.СуммаПоФактуКопейки = СуммаПоФактуКопейки;
		ТабДокумент.Вывести(ОбластьМакета);

        		
		ОбластьМакета = Макет.ПолучитьОбласть("Итоги");
		ОбластьМакета.Параметры.Заполнить(Шапка); 
		
		
		ОбластьМакета.Параметры.СуммаПоФактуРеглПрописью = ЧислоПрописью(
          СуммаПоФакту,,
          "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
		
		ТабДокумент.Вывести(ОбластьМакета); 
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПоследниеНомера");
		ОбластьМакета.Параметры.Заполнить(Шапка);  
		ТабДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ЧленыКомиссии");

			
		Инд = 1;
		Пока ЧленКомиссии.Следующий() Цикл
			Если ЧленКомиссии.Председатель Тогда
				ОбластьМакета.Параметры["ЗаголовокЧленаКомиссии"] = "Председатель комиссии";
				ОбластьМакета.Параметры["Должность"] = ЧленКомиссии.ФизЛицо.Должность;
				ОбластьМакета.Параметры["НаименованиеЧленаКомиссии"] = ЧленКомиссии.ФизЛицо; 
				ТабДокумент.Вывести(ОбластьМакета); 
			КонецЕсли;
			Прервать;
		КонецЦикла;
		
		инд = 0;
		ЧленКомиссии = Шапка.ИнвентаризационнаяКомиссия.Выбрать();   
		Пока ЧленКомиссии.Следующий() Цикл 
			Если инд < 3 Тогда
				Если НЕ ЧленКомиссии.Председатель Тогда 				
					ОбластьМакета.Параметры["ЗаголовокЧленаКомиссии"] = "Член комиссии"; 
					ОбластьМакета.Параметры["Должность"] = ЧленКомиссии.ФизЛицо.Должность;
					ОбластьМакета.Параметры["НаименованиеЧленаКомиссии"] = ЧленКомиссии.ФизЛицо; 
					ТабДокумент.Вывести(ОбластьМакета);  
					инд = инд + 1;   				
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;

		
		ТабДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.КассирДолжность = КассирДолжность; 
		ОбластьМакета.Параметры.ФИОКассира  	= ФИОКассира;
		ТабДокумент.Вывести(ОбластьМакета);  
		
		
		//Молы         = Шапка.Молы.Выбрать();
		//Пока Молы.Следующий() Цикл 		
		//	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаМол");		
		//	ОбластьМакета.Параметры.ДолжностьМОЛ            = Молы.Физлицо.Должность;
		//	ОбластьМакета.Параметры.ФИОМОЛ                  = Молы.ФИзлицо;
		//	ТабДокумент.Вывести(ОбластьМакета);			
		//КонецЦикла;
		  	
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

		КонецЦикла;	//Шапки.Следующий()
		КонецЦикла;

	Возврат ТабДокумент;

КонецФункции

Функция ПолучитьВставки(ОЗ, Док, ТЧВставки, ВсеВставки)
	
	СтруктураВозврата = Новый Структура("Камни, Металлы");
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	Запрос.УстановитьПараметр("Ссылка", Док);
	
	Запрос.Текст = 
		"ВЫБРАТЬ //РАЗЛИЧНЫЕ
		|	ЛБ_Инвентаризация111.ОбъектЗалога КАК ОбъектЗалога,
		|	ЛБ_Инвентаризация111.ВидВставки КАК ВидВставки,
		|	ЛБ_Инвентаризация111.ВидВставкиФакт КАК ВидВставкиФакт,
		|	ЛБ_Инвентаризация111.ВидОгранки КАК ВидОгранки,
		|	ЛБ_Инвентаризация111.ВидОгранкиФакт КАК ВидОгранкиФакт,
		|	ЛБ_Инвентаризация111.КачествоОгранки КАК КачествоОгранки,
		|	ЛБ_Инвентаризация111.КачествоОгранкиФакт КАК КачествоОгранкиФакт,
		|	ЛБ_Инвентаризация111.Количество КАК Количество,
		|	ЛБ_Инвентаризация111.КоличествоФакт КАК КоличествоФакт,
		|	ВЫБОР
		|		КОГДА ВидВставки <> ЗНАЧЕНИЕ(Справочник.ЛБ_ДрагоценныеКамни.Бриллиант)
		//|		КОГДА ЛБ_Инвентаризация111.Вид = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыКомплектующихИзделия.Комплектующее)
		|			ТОГДА ЛБ_Инвентаризация111.ВесГраммы
		|		ИНАЧЕ ЛБ_Инвентаризация111.Вес
		|	КОНЕЦ КАК Вес,
		|	ВЫБОР
		|		КОГДА ВидВставки <> ЗНАЧЕНИЕ(Справочник.ЛБ_ДрагоценныеКамни.Бриллиант)
		//|		КОГДА ЛБ_Инвентаризация111.Вид = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыКомплектующихИзделия.Комплектующее)
		|			ТОГДА ЛБ_Инвентаризация111.ВесГраммыФакт
		|		ИНАЧЕ ЛБ_Инвентаризация111.ВесФакт
		|	КОНЕЦ КАК ВесФакт,
		//|	ЛБ_Инвентаризация111.Вес КАК Вес,
		//|	ЛБ_Инвентаризация111.ВесФакт КАК ВесФакт,
		|	ЛБ_Инвентаризация111.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЛБ_Инвентаризация111.ЕдиницаИзмеренияФакт КАК ЕдиницаИзмеренияФакт,
		|	ЛБ_Инвентаризация111.Сумма КАК Сумма,
		|	ЛБ_Инвентаризация111.СуммаФакт КАК СуммаФакт
		|ИЗ
		|	Документ.ЛБ_Инвентаризация.111 КАК ЛБ_Инвентаризация111
		|ГДЕ
		|	ЛБ_Инвентаризация111.ОбъектЗалога = &ОбъектЗалога
		|	И ЛБ_Инвентаризация111.Ссылка = &Ссылка
		|	И 100 = 100";
	
	Если НЕ ВсеВставки Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", "ЛБ_Инвентаризация111.ВидВставки = ЗНАЧЕНИЕ(Справочник.ЛБ_ДрагоценныеКамни.Бриллиант)");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "111", ТЧВставки.ТЧКамни);
	
	РезультатК = Запрос.Выполнить().Выгрузить();
	
	Если РезультатК.Количество() > 0 Тогда
		СтруктураВозврата.Камни = РезультатК;
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ //РАЗЛИЧНЫЕ
		|	ЛБ_Инвентаризация111.Проба КАК ВидВставки,
		|	ЛБ_Инвентаризация111.ПробаФакт КАК ВидВставкиФакт,
		|	ЛБ_Инвентаризация111.Вес КАК Вес,
		|	ЛБ_Инвентаризация111.ВесФакт КАК ВесФакт,
		|	ЛБ_Инвентаризация111.СуммаОценки КАК Сумма,
		|	ЛБ_Инвентаризация111.СуммаОценкиФакт КАК СуммаФакт
		|ИЗ
		|	Документ.ЛБ_Инвентаризация.111 КАК ЛБ_Инвентаризация111
		|ГДЕ
		|	ЛБ_Инвентаризация111.ОбъектЗалога = &ОбъектЗалога
		|	И ЛБ_Инвентаризация111.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "111", ТЧВставки.ТЧМеталл);
	
	РезультатМ = Запрос.Выполнить().Выгрузить();
	
	Если РезультатМ.Количество() > 0 Тогда
		СтруктураВозврата.Металлы = РезультатМ;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьСуммыПоОЗ(Дата, ЗБ)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты.ЗалоговыйБилет КАК ЗалоговыйБилет,
	               |	СУММА(ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты.СуммаОборот) КАК Сумма,
	               |	ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты.ВидРасчета КАК ВидРасчета
	               |ИЗ
	               |	РегистрНакопления.ЛБ_РасчетыСКлиентамиБУ.ОстаткиИОбороты(, , Регистратор, , ЗалоговыйБилет = &ЗалоговыйБилет) КАК ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты
	               |ГДЕ
	               |	ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты.Период <= &Дата
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты.ЗалоговыйБилет,
	               |	ЛБ_РасчетыСКлиентамиБУОстаткиИОбороты.ВидРасчета";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЗалоговыйБилет", ЗБ);

	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураВозврата = Новый Структура("ПоПроцентам, ПоОсновномуДолгу", 0, 0);

	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидРасчета = Перечисления.ЛБ_ВидыРасчетов.ПоПроцентам Тогда
			СтруктураВозврата.ПоПроцентам = Выборка.Сумма;
		ИначеЕсли Выборка.ВидРасчета = Перечисления.ЛБ_ВидыРасчетов.ПоОсновномуДолгу Тогда
			СтруктураВозврата.ПоОсновномуДолгу = Выборка.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураВозврата;

КонецФункции

Функция ПолучитьДанныеПоОЗ(Дата, ОЗ, НомерЗБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор КАК Регистратор,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ГосОрганИзъятие КАК Орган,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ДатаИзъятия КАК ДатаИзъятия,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ФИОДолжностьИзъятие КАК ДолжностноеЛицо,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ФИОДолжностьСудьи КАК ФИОДолжностьСудьи,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ДатаПротоколИзъятия КАК ДатаПротоколаИзъятия,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ДокументИзъятияНаименование КАК ДокументИзъятияНаименование,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ДокументИзъятияДатаВыдачи КАК ДокументИзъятияДатаВыдачи,
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ДокументИзъятияКемВыдан КАК ДокументИзъятияКемВыдан
		|ИЗ
		|	РегистрСведений.ЛБ_СостояниеОбъектаЗалога КАК ЛБ_СостояниеОбъектаЗалога
		|ГДЕ
		|	ЛБ_СостояниеОбъектаЗалога.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийОперацияПоЗалогу.ИзъятиеОбъектовЗалога)
		|	И ЛБ_СостояниеОбъектаЗалога.СтатусОбъектаЗалога = ЗНАЧЕНИЕ(Перечисление.ЛБ_СтатусыОбъектовЗалога.Изъят)
		|	И ЛБ_СостояниеОбъектаЗалога.Период <= &Дата
		|	И ЛБ_СостояниеОбъектаЗалога.ОбъектЗалога = &ОЗ
		|	И ЛБ_СостояниеОбъектаЗалога.Регистратор.ОтмененныйДокумент = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
		|	И ЛБ_СостояниеОбъектаЗалога.Регистратор.ДокументОтмены = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
		|	И НЕ ЛБ_СостояниеОбъектаЗалога.Регистратор В
		|				(ВЫБРАТЬ
		|					ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
		|				ИЗ
		|					РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&Дата, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
		|				ГДЕ
		|					ЛБ_ОтменыОперацийЗБСрезПоследних.НомерЗалоговогоБилета ПОДОБНО ""%"" + &НомерЗалоговогоБилета + ""%"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛБ_СостояниеОбъектаЗалога.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОЗ", ОЗ);
	Запрос.УстановитьПараметр("НомерЗалоговогоБилета", НомерЗБ);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("Регистратор", Результат.Регистратор);
		СтруктураВозврата.Вставить("Орган", Результат.Орган);
		СтруктураВозврата.Вставить("ДатаИзъятия", Результат.ДатаИзъятия);
		СтруктураВозврата.Вставить("ДолжностноеЛицо", Результат.ДолжностноеЛицо);
		СтруктураВозврата.Вставить("ФИОДолжностьСудьи", Результат.ФИОДолжностьСудьи);
		СтруктураВозврата.Вставить("ДатаПротоколаИзъятия", Результат.ДатаПротоколаИзъятия);
		СтруктураВозврата.Вставить("ДокументИзъятияНаименование", Результат.ДокументИзъятияНаименование);
		СтруктураВозврата.Вставить("ДокументИзъятияДатаВыдачи", Результат.ДокументИзъятияДатаВыдачи);
		СтруктураВозврата.Вставить("ДокументИзъятияКемВыдан", Результат.ДокументИзъятияКемВыдан);
		
		Возврат СтруктураВозврата;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции



