Функция ПолучитьПоступившиеТовары(Док)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ломбард", Док.Ломбард);
	Запрос.УстановитьПараметр("Нач", Док.ДатаНачалаИнвентаризации);
	Запрос.УстановитьПараметр("Кон", Док.ДатаОкончанияИнвентаризации);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛБ_ОбъектыЗалогаОбороты.ОбъектЗалога КАК ОбъектЗалога,
	|	ЛБ_ОбъектыЗалогаОбороты.КоличествоПриход КАК Количество,
