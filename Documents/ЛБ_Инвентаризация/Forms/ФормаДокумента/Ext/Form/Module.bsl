&НаСервере
Функция КоличествоЗагруженныхВставок(ОЗ, ТЧ)
	
	ТЗ = Объект[ТЧ].Выгрузить(, "ОбъектЗалога");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнешнийИсточник.ОбъектЗалога КАК ОбъектЗалога
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ОбъектЗалога КАК ОбъектЗалога
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.ОбъектЗалога = &ОбъектЗалога";
	
	Запрос.УстановитьПараметр("ВнешнийИсточник", ТЗ);
	Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат	Результат.Количество();
	
КонецФункции

&НаСервере
Функция ПолучитьРеквизитыПоОЗ(ОбъектЗалога, ПолучитьКолонки = Ложь)
	
	//Получаем реквизиты по ОЗ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Артикул КАК Артикул,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВидИзделия КАК ВидИзделияФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК Проба,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба КАК ПробаФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК Категория,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Категория КАК КатегорияФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ОбщаяМасса,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес КАК ОбщаяМассаФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК МассаМеталла,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ВесЧистый КАК МассаМеталлаФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба.Владелец КАК Металл,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Проба.Владелец КАК МеталлФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Клеймо КАК Клеймо,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Клеймо КАК КлеймоФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Именник КАК Именник,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Именник КАК ИменникФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ДанныеИменника КАК ДанныеИменника,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.ДанныеИменника КАК ДанныеИменникаФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМеталлы КАК СуммаОценкиМеталлыФакт,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.НомерСтрокиТаблицы КАК НомерСтрокиТаблицы,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СостояниеИзделия КАК СостояниеИзделия,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Дефекты КАК Дефекты,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Вес30 КАК Вес30,
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.СуммаОценкиМакс КАК СуммаОценкиМакс,
			   	//+МАН 25.11.24 Закомментировал т.к. вернул старый запрос.
	               //|	ИСТИНА КАК ОтказОтВыкупа
				//-МАН
	               |ИЗ
	               |	РегистрСведений.ЛБ_РеквизитыОбъектаЗалога.СрезПоследних(
	               |			&НаДату,
	               |			Регистратор.ДокументОтмены = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
	               |				И Регистратор.ОтмененныйДокумент = ЗНАЧЕНИЕ(Документ.ЛБ_ОперацияПоЗалогу.ПустаяСсылка)
	               |				И НЕ Регистратор В(ВЫБРАТЬ
				   |										ЛБ_ОтменыОперацийЗБСрезПоследних.ОтмененныйДокумент КАК ОтмененныйДокумент
				   |									ИЗ
				   |										РегистрСведений.ЛБ_ОтменыОперацийЗБ.СрезПоследних(&НаДату, ) КАК ЛБ_ОтменыОперацийЗБСрезПоследних
				   |									ГДЕ
				   |										ЛБ_ОтменыОперацийЗБСрезПоследних.Регистратор В (Регистратор))
	               |				И ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_РеквизитыОбъектаЗалогаСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_РеквизитыОбъектаЗалогаСрезПоследних.Период УБЫВ";
	
	Если ПолучитьКолонки Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
		
		МассивКолонок = Новый Массив;
		
		Для каждого СтрКолонок Из СхемаЗапроса.ПакетЗапросов[0].Колонки Цикл
			МассивКолонок.Добавить(СтрКолонок.Псевдоним)
		КонецЦикла;
		
		Возврат МассивКолонок;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НаДату", НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);

	Если Объект.ВидИнвентаризации = Перечисления.ЛБ_ВидИнвентаризации.Выборочная Тогда
		Если Объект.ФильтрВидыИзделий.Количество() > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "100 = 100", "РеквизитыОбъектаЗалога.ВидИзделия В (&ВидИзделия)");
			Массив = ВернутьМассивИзФильтра(Объект.ФильтрВидыИзделий, "ВидИзделия");
			Запрос.УстановитьПараметр("ВидИзделия", Массив);
		КонецЕсли;
		
		Если Объект.ФильтрКатегории.Количество() > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "200 = 200", "РеквизитыОбъектаЗалога.Категория В (&Категории)");
			Массив = ВернутьМассивИзФильтра(Объект.ФильтрКатегории, "Категория");
			Запрос.УстановитьПараметр("Категории", Массив);
		КонецЕсли;
		
		Если Объект.ФильтрПробы.Количество() > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "300 = 300", "РеквизитыОбъектаЗалога.Проба В (&Пробы)");
			Массив = ВернутьМассивИзФильтра(Объект.ФильтрПробы, "Проба");
			Запрос.УстановитьПараметр("Пробы", Массив);
		КонецЕсли;
		
		Если Объект.ОтборОбщаяМассаОт > 0 И Объект.ОтборОбщаяМассаДо > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "700 = 700", "РеквизитыОбъектаЗалога.Вес МЕЖДУ &ОтборОбщаяМассаОт И &ОтборОбщаяМассаДо");
			Запрос.УстановитьПараметр("ОтборОбщаяМассаОт", Объект.ОтборОбщаяМассаОт);
			Запрос.УстановитьПараметр("ОтборОбщаяМассаДо", Объект.ОтборОбщаяМассаДо);
		КонецЕсли;
		
		Если Объект.ОтборМассаМеталлаОт > 0 И Объект.ОтборМассаМеталлаДо > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "900 = 900", "РеквизитыОбъектаЗалога.Вес МЕЖДУ &ОтборМассаМеталлаОт И &ОтборМассаМеталлаДо");
			Запрос.УстановитьПараметр("ОтборМассаМеталлаОт", Объект.ОтборМассаМеталлаОт);
			Запрос.УстановитьПараметр("ОтборМассаМеталлаДо", Объект.ОтборМассаМеталлаДо);
		КонецЕсли;	

		//+15.05.24 Добавлен фильтр по именнику
		Если Объект.ОтборИменник Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "600 = 600", "РеквизитыОбъектаЗалога.Именник = &ОтборИменник");
			Запрос.УстановитьПараметр("ОтборИменник", ПредопределенноеЗначение("Перечисление.ЛБ_Именник.Да"));
		КонецЕсли;
		
	КонецЕсли;

	ЗапросВыкуп = Новый Запрос;
	ЗапросВыкуп.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ЛБ_ОбъектыЗалогаОстатки.ОтказОтВыкупа КАК ОтказОтВыкупа
		               |ИЗ
		               |	РегистрНакопления.ЛБ_ОбъектыЗалога.Остатки(&НаДату, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_ОбъектыЗалогаОстатки
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЛБ_ОбъектыЗалогаОстатки.ЗалоговыйБилет.Дата УБЫВ";
	
	ЗапросВыкуп.УстановитьПараметр("НаДату", НачалоДня(Объект.Дата));
	ЗапросВыкуп.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);

	РезультатРеквизиты = Запрос.Выполнить().Выгрузить();
	
	Если РезультатРеквизиты.Количество() > 0 Тогда
		//+МАН 25.11.24 Закомментировал т.к. вернул старый запрос.
		//РезультатВыкуп = ЗапросВыкуп.Выполнить().Выгрузить();
		//
		//МассивИменКолонок = Новый Массив;
		//МассивИменКолонок.Добавить("ОтказОтВыкупа");
		//
		//Для Каждого ИмяКолонки Из МассивИменКолонок Цикл
		//	РезультатРеквизиты.ЗагрузитьКолонку(РезультатВыкуп.ВыгрузитьКолонку(ИмяКолонки), ИмяКолонки);
		//КонецЦикла;
		
		Возврат РезультатРеквизиты;
		//-МАН
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьОтклонениеПоОЗ(ОбъектЗалога)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ИнвентаризацияТовары.Отклонения КАК Отклонения
		|ИЗ
		|	Документ.ЛБ_Инвентаризация КАК ЛБ_Инвентаризация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЛБ_Инвентаризация.Товары КАК ЛБ_ИнвентаризацияТовары
		|		ПО ЛБ_Инвентаризация.Ссылка = ЛБ_ИнвентаризацияТовары.Ссылка
		|ГДЕ
		|	ЛБ_Инвентаризация.Проведен
		|	И НЕ ЛБ_Инвентаризация.ПометкаУдаления
		|	И ЛБ_ИнвентаризацияТовары.ОбъектЗалога <> ЗНАЧЕНИЕ(Справочник.ЛБ_ОбъектыЗалога.ПустаяСсылка)
		|	И ЛБ_ИнвентаризацияТовары.ОбъектЗалога = &ОбъектЗалога
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛБ_ИнвентаризацияНовыеОЗ.Отклонения
		|ИЗ
		|	Документ.ЛБ_Инвентаризация КАК ЛБ_Инвентаризация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЛБ_Инвентаризация.НовыеОЗ КАК ЛБ_ИнвентаризацияНовыеОЗ
		|		ПО ЛБ_Инвентаризация.Ссылка = ЛБ_ИнвентаризацияНовыеОЗ.Ссылка
		|ГДЕ
		|	ЛБ_Инвентаризация.Проведен
		|	И НЕ ЛБ_Инвентаризация.ПометкаУдаления
		|	И ЛБ_ИнвентаризацияНовыеОЗ.ОбъектЗалога <> ЗНАЧЕНИЕ(Справочник.ЛБ_ОбъектыЗалога.ПустаяСсылка)
		|	И ЛБ_ИнвентаризацияНовыеОЗ.ОбъектЗалога = &ОбъектЗалога";
	
	Запрос.УстановитьПараметр("ОбъектЗалога", ОбъектЗалога);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Отклонения;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ВернутьМассивИзФильтра(Фильтр, НазваниеКолонки)
	Массив = Новый Массив;
	Для каждого стр из Фильтр Цикл
		Массив.Добавить(стр[НазваниеКолонки]);
	КонецЦикла;
	
	Возврат Массив;	
КонецФункции

