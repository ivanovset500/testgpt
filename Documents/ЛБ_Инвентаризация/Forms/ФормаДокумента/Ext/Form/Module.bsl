&НаСервере
Процедура ЦенаДрагоценногоКамня(Идентификатор, ИдентификаторТовары, ТЧ) 
	СтрокаТабличнойЧастиВставки = Объект[ТЧ.ВставкаК].НайтиПоИдентификатору(Идентификатор);
	СтрокаТабличнойЧастиТовары = Объект[ТЧ.Основная].НайтиПоИдентификатору(ИдентификаторТовары);
	
	Если СтрокаТабличнойЧастиВставки.НеОценивать Тогда
        СтрокаТабличнойЧастиВставки.ЦенаФакт  = 0;
		СтрокаТабличнойЧастиВставки.СуммаФакт = 0;
	Иначе           
		СтруктураВставки = новый Структура; 
		СтруктураВставки.Вставить("Дата", НачалоДня(СтрокаТабличнойЧастиТовары.ОперацияЗайма.Дата)); //+Мельников 27.04.24 изменил Было: Объект.Дата); 
		СтруктураВставки.Вставить("Ломбард", Объект.Ломбард);
		СтруктураВставки.Вставить("ВидВставки", СтрокаТабличнойЧастиВставки.ВидВставкиФакт);
		СтруктураВставки.Вставить("ФормаОгранки", СтрокаТабличнойЧастиВставки.ФормаОгранкиФакт);
        СтруктураВставки.Вставить("ВидОгранки", СтрокаТабличнойЧастиВставки.ВидОгранкиФакт);
        СтруктураВставки.Вставить("КачествоОгранки", СтрокаТабличнойЧастиВставки.КачествоОгранкиФакт);
        СтруктураВставки.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт);
        СтруктураВставки.Вставить("Вес", ?(СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт.Код = "162", СтрокаТабличнойЧастиВставки.ВесФакт, СтрокаТабличнойЧастиВставки.ВесГраммыФакт));
		//+Мельников 16.10.24 Инвентаризация. Заявка 2464
		СтруктураВставки.Вставить("СхемаКредитования", СтрокаТабличнойЧастиТовары.ОперацияЗайма.СхемаКредитования);
		СтруктураВставки.Вставить("Залогодатель", СтрокаТабличнойЧастиТовары.ОперацияЗайма.Залогодатель);
		//-Мельников
		
		Результат = ЛБ_ОбщийМодуль.ПолучитьЦенуДрагоценногоКамняИзПрейскуранта(СтруктураВставки);
	    СтрокаТабличнойЧастиВставки.ЦенаФакт = Результат.Цена;
        СтрокаТабличнойЧастиВставки.СуммаФакт = окр(СтрокаТабличнойЧастиВставки.ЦенаФакт * ?(НЕ СтрокаТабличнойЧастиВставки.ЭтоВесовойФакт, СтрокаТабличнойЧастиВставки.КоличествоФакт, СтрокаТабличнойЧастиВставки.ВесФакт), 2);
	КонецЕсли;	
