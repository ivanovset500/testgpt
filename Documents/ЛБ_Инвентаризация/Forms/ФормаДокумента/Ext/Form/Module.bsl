// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	Если Команда.Имя = "ПодменюПечатьОбычное_АктПроверки"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.КонтрольнаяПроверка") Тогда
		Сообщить("""Акт проверки"" можно распечатать только по ""Контрольной проверке""");
		Возврат;
	КонецЕсли;
	
	Если Команда.Имя = "ПодменюПечатьОбычное_ИНВ8"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""ИНВ-8 Акт инвентаризации ДМ и изделий из них"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;

	Если Команда.Имя = "ПодменюПечатьОбычное_ИНВ8Черновик"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""ИНВ-8 Акт инвентаризации ДМ и изделий из них (черновик)"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;

	Если Команда.Имя = "ПодменюПечатьОбычное_ИНВ8Пустая"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""ИНВ-8 Акт инвентаризации ДМ и изделий из них (пустой)"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;
	
	Если Команда.Имя = "ПодменюПечатьОбычное_ИНВ5"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""ИНВ-5 Акт инвентаризации ДМ на ОХ"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;

	Если Команда.Имя = "ПодменюПечатьОбычное_ИНВ5Пустая"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""ИНВ-5 Акт инвентаризации ДМ на ОХ (пустой)"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;
	
	Если Команда.Имя = "ПодменюПечатьОбычное_Изъятые"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""Акт проверки документов, подтверждающих изъятие"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;

	Если Команда.Имя = "ПодменюПечатьОбычное_ОписьПоступивших"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""Опись ценностей, поступивших во время инвентаризации"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;

	Если Команда.Имя = "ПодменюПечатьОбычное_ОписьВыбывших"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""Опись ценностей, выбывших во время инвентаризации"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;

	Если Команда.Имя = "ПодменюПечатьОбычное_Посылки"
		И Объект.ТипИнвентаризации <> ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
		
		Сообщить("""Опись не распакованных посылок с ценностями"" можно распечатать только по полной или выборочной инвентаризации");
		Возврат;
	КонецЕсли;
	
	//ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

