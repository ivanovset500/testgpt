// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ФОРМЫ

&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Предупреждение("Невыбран склад!");
		Возврат;
	КонецЕсли;

	Если Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Выборочная") Тогда
		УстановленыФильтры = ПроверитьФильтры();
		Если НЕ УстановленыФильтры Тогда
			Предупреждение("Фильтры не установлены. Для проведения выборочной инвентаризации установите фильтры.");
			Возврат;
		КонецЕсли;

		Если Объект.ОтборОбщаяМассаОт <> 0 И Объект.ОтборОбщаяМассаДо = 0 Тогда
			Предупреждение("Фильтр по весу изделия заполнен некорректно. Заполните значение ""До""");
			Возврат;
		КонецЕсли;

		Если Объект.ОтборМассаМеталлаОт <> 0 И Объект.ОтборМассаМеталлаДо = 0 Тогда
			Предупреждение("Фильтр по весу металла заполнен некорректно. Заполните значение ""До""");
			Возврат;
		КонецЕсли;

		Если Объект.ОтборСуммаОценкиОт <> 0 И Объект.ОтборСуммаОценкиДо = 0 Тогда
			Предупреждение("Фильтр по макс. оценке заполнен некорректно. Заполните значение ""До""");
			Возврат;
		КонецЕсли;

		Если ЗначениеЗаполнено(Объект.ОтборДатаЗаймаОт) И НЕ ЗначениеЗаполнено(Объект.ОтборДатаЗаймаДо) Тогда
			Предупреждение("Фильтр по дате займа заполнен некорректно. Заполните значение ""По""");
			Возврат;
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ОтборДатаЗаймаОт) И ЗначениеЗаполнено(Объект.ОтборДатаЗаймаДо) Тогда
			Предупреждение("Фильтр по дате займа заполнен некорректно. Заполните значение ""С""");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТекущийЭлемент.Имя = "Товары" ИЛИ ТекущийЭлемент.Имя = "ТоварыЗаполнитьПоОстаткам1" Тогда 
		Если Объект.Товары.Количество() > 0 Тогда
			ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'");
			Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОстаткамЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Заголовок);
		Иначе
			ЗаполнитьДокументНаКлиенте("Заполнить");
			Модифицированность = Истина;
		КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя = "НовыеОЗ" Тогда
		Если Объект.НовыеОЗ.Количество() > 0 Тогда
			ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'");
			Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОстаткамЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Заголовок);
		Иначе
			ЗаполнитьДокументНаКлиенте("Заполнить");
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьФильтры()
	
	Если Объект.ФильтрВидыИзделий.Количество() > 0 ИЛИ Объект.ФильтрКатегории.Количество() > 0
		ИЛИ Объект.ФильтрПробы.Количество() > 0 ИЛИ Объект.ФильтрКамни.Количество() > 0
		ИЛИ Объект.ФильтрПриемщики.Количество() > 0 ИЛИ Объект.ФильтрЗалогодатели.Количество() > 0
		ИЛИ Объект.ФильтрСтатусыЗалогодателя.Количество() > 0 ИЛИ Объект.ФильтрСтатусы.Количество() > 0
		ИЛИ (Объект.ОтборОбщаяМассаОт <> 0 ИЛИ Объект.ОтборОбщаяМассаДо <> 0)
		ИЛИ (Объект.ОтборМассаМеталлаОт <> 0 ИЛИ Объект.ОтборМассаМеталлаДо <> 0)
		ИЛИ (Объект.ОтборСуммаОценкиОт <> 0 ИЛИ Объект.ОтборСуммаОценкиДо <> 0)
		ИЛИ (Объект.ОтборДатаЗаймаОт <> Дата(1, 1, 1) ИЛИ Объект.ОтборДатаЗаймаДо <> Дата(1, 1, 1))
		ИЛИ Объект.ОтборИменник ИЛИ Объект.ОтборБезВставок ИЛИ Объект.ОтборВставкаМеталл ИЛИ Объект.ОтборВставкаКомплектующие Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ПерезаполнитьУчетныеДанные(Команда)
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Перезаполнить учетные количества и суммы? %ПредупреждениеОЗаписиДокумента%'");
	ТекстВопроса = СтрЗаменить(ТекстВопроса, "%ПредупреждениеОЗаписиДокумента%", 
		?(Модифицированность, Символы.ПС + НСтр("ru='(Перед заполнением документ будет записан!)'"), 
		""));
	Оповещение = Новый ОписаниеОповещения("ВопросПерезаполнитьУчетныеДанныеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Заголовок);
	
КонецПроцедуры

