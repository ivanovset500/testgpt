		ПараметрыФормы.Вставить("ФормаОгранкиФакт", СтрокаТабличнойЧастиВставки.ФормаОгранкиФакт);
		ПараметрыФормы.Вставить("ВидОгранкиФакт", СтрокаТабличнойЧастиВставки.ВидОгранкиФакт);
		ПараметрыФормы.Вставить("КачествоОгранкиФакт", СтрокаТабличнойЧастиВставки.КачествоОгранкиФакт); 
		ПараметрыФормы.Вставить("ДиаметрФакт", СтрокаТабличнойЧастиВставки.ДиаметрФакт);
		ПараметрыФормы.Вставить("Диаметр1Факт", СтрокаТабличнойЧастиВставки.Диаметр1Факт);
		ПараметрыФормы.Вставить("Диаметр2Факт", СтрокаТабличнойЧастиВставки.Диаметр2Факт); 
		ПараметрыФормы.Вставить("ДлинаФакт", СтрокаТабличнойЧастиВставки.ДлинаФакт);  
		ПараметрыФормы.Вставить("ШиринаФакт", СтрокаТабличнойЧастиВставки.ШиринаФакт);
		ПараметрыФормы.Вставить("ВысотаФакт", СтрокаТабличнойЧастиВставки.ВысотаФакт);
		ПараметрыФормы.Вставить("ВесФакт", СтрокаТабличнойЧастиВставки.ВесФакт);
		ПараметрыФормы.Вставить("ВесграммыФакт", СтрокаТабличнойЧастиВставки.ВесГраммыФакт);
		ПараметрыФормы.Вставить("ЦенаФакт", СтрокаТабличнойЧастиВставки.ЦенаФакт);
		ПараметрыФормы.Вставить("НеОцениватьФакт", СтрокаТабличнойЧастиВставки.НеОцениватьФакт);
		//+Мельников 17.10.24 Заявка 2464
		ПараметрыФормы.Вставить("ТЧ", ТЧ);
		ПараметрыФормы.Вставить("ОбъектЗалога", СтрокаТабличнойЧастиТовары.ОбъектЗалога);
		ПараметрыФормы.Вставить("ОбщаяМассаФакт", СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт);
		ПараметрыФормы.Вставить("ТолькоПросмотр", Объект.Проведен);
		//-Мельников
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораВставки", ЭтаФорма, ТЧ);
		ОткрытьФорму("Документ.ЛБ_Инвентаризация.Форма.КорректировкаВставки", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	//+Мельников 15.10.24
	ИначеЕсли СтрокаТабличнойЧастиВставки.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Комплектующее") Тогда
		ПараметрыФормы.Вставить("ВидВставки", СтрокаТабличнойЧастиВставки.ВидВставки);
		ПараметрыФормы.Вставить("Количество", СтрокаТабличнойЧастиВставки.Количество);
		ПараметрыФормы.Вставить("ВесГраммы", СтрокаТабличнойЧастиВставки.ВесГраммы);
		ПараметрыФормы.Вставить("ВидВставкиФакт", СтрокаТабличнойЧастиВставки.ВидВставкиФакт);
		ПараметрыФормы.Вставить("КоличествоФакт", СтрокаТабличнойЧастиВставки.КоличествоФакт);
		ПараметрыФормы.Вставить("ВесГраммыФакт", СтрокаТабличнойЧастиВставки.ВесГраммыФакт);
		ПараметрыФормы.Вставить("ТЧ", ТЧ);
		ПараметрыФормы.Вставить("ОбъектЗалога", СтрокаТабличнойЧастиТовары.ОбъектЗалога);
		ПараметрыФормы.Вставить("ОбщаяМассаФакт", СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт);
		ПараметрыФормы.Вставить("ТолькоПросмотр", Объект.Проведен);

		ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораВставки", ЭтаФорма, ТЧ);
		ОткрытьФорму("Документ.ЛБ_Инвентаризация.Форма.КорректировкаКомплектующего", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	//-Мельников

КонецПроцедуры

