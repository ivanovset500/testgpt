	Если Элемент.Имя = "ОтборОбщаяМассаОт" Тогда
		Если Текст <> "0,00" ИЛИ Объект.ОтборОбщаяМассаДо <> 0 Тогда
			Элементы.ОчиститьОбщиеМассы.Доступность = Истина;
		Иначе 
			Элементы.ОчиститьОбщиеМассы.Доступность = Ложь;
		КонецЕсли;
	ИначеЕсли Элемент.Имя = "ОтборОбщаяМассаДо" Тогда
		Если Текст <> "0,00" ИЛИ Объект.ОтборОбщаяМассаОт <> 0 Тогда
			Элементы.ОчиститьОбщиеМассы.Доступность = Истина;
		Иначе 
			Элементы.ОчиститьОбщиеМассы.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

