&НаКлиенте
Процедура ОткрытьФормуОтклоненияВставки(ТЧ)
	
	СтрокаТабличнойЧастиТовары = Элементы[ТЧ.Основная].ТекущиеДанные;
	СтрокаТабличнойЧастиВставки = Элементы[ТЧ.ВставкаК].ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;

	//+Мельников 15.10.24 Добавлена проверка вставка или комплектующее Заявка 2464.
	Если СтрокаТабличнойЧастиВставки.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка") Тогда
		ПараметрыФормы.Вставить("КатегорияОбъектаЗалога", СтрокаТабличнойЧастиТовары.Категория); 
		ПараметрыФормы.Вставить("Именник", СтрокаТабличнойЧастиТовары.Именник);
		ПараметрыФормы.Вставить("Количество", СтрокаТабличнойЧастиВставки.Количество); 
		ПараметрыФормы.Вставить("ВидВставки", СтрокаТабличнойЧастиВставки.ВидВставки); 
