//+Мельников 21.05.24 Добавлен третий параметр ПолеДанных
&НаСервере
Процедура УсловноеОформлениеКолонки(НазваниеКолонки, СЧемСравнить, ПолеДанных)
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,10,Истина));
	//+Мельников 21.05.24 Добавим цвета в эту серость
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0)); //Красный
	//-Мельников
	
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ПолеДанных + НазваниеКолонки); //Было: ("Объект.Товары."+НазваниеКолонки);
	ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементУсловия.ПравоеЗначение = Новый ПолеКомпоновкиДанных(ПолеДанных + СЧемСравнить); //Было: ("Объект.Товары."+СЧемСравнить);
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрЗаменить(СтрЗаменить(ПолеДанных, "Объект.", ""), ".", "") + НазваниеКолонки); //Было: ("Товары"+НазваниеКолонки);
КонецПроцедуры 

