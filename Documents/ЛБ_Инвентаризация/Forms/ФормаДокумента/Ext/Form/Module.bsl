&НаКлиенте
Процедура НайтиВставки(ТЧ)
	СтрокаТабличнойЧастиТовары = Элементы[ТЧ.Основная].ТекущиеДанные;
	
	ЭлементВставкиК = Элементы[ТЧ.ВставкаК]; 
	ЭлементВставкиМ = Элементы[ТЧ.ВставкаМ];
	
	Если СтрокаТабличнойЧастиТовары <> неопределено Тогда		
		Отбор = Новый Структура;
		Отбор.Вставить("ОбъектЗалога",СтрокаТабличнойЧастиТовары.ОбъектЗалога);

		ЕстьВставка = Объект[ТЧ.ВставкаК].НайтиСтроки(Отбор).Количество() > 0;
		ЕстьВставкаМеталла = Объект[ТЧ.ВставкаМ].НайтиСтроки(Отбор).Количество() > 0;

		Если ЕстьВставка Тогда
			ЭлементВставкиК.Видимость = Истина;
			ЭлементВставкиК.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
		Иначе
			ЭлементВставкиК.Видимость = Ложь;
		КонецЕсли;
					
		Если ЕстьВставкаМеталла Тогда
			ЭлементВставкиМ.Видимость = Истина;
			ЭлементВставкиМ.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
		Иначе
			ЭлементВставкиМ.Видимость = Ложь;
		КонецЕсли;
	Иначе 	
		Отбор = Новый Структура;
		Отбор.Вставить("ОбъектЗалога",Неопределено);
		
		ЭлементВставкиК.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);		
		ЭлементВставкиМ.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
		
		ЭлементВставкиК.Видимость = ЭлементВставкиК.ТекущиеДанные <> Неопределено;
		ЭлементВставкиМ.Видимость = ЭлементВставкиМ.ТекущиеДанные <> Неопределено;
	КонецЕсли;

КонецПроцедуры

