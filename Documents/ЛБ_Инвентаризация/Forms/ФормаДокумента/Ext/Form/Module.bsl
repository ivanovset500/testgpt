Процедура СформироватьСтрокуОтклонения(ТЧ) 
	Идентификатор = Элементы[ТЧ.Основная].ТекущаяСтрока;
	ДанныеТекСтр  = Объект[ТЧ.Основная].НайтиПоИдентификатору(Идентификатор);

	ВставкаК = ПолучитьВставкуКамняПоОЗ(ДанныеТекСтр.ОбъектЗалога, ТЧ, Объект.Ссылка);
	//ВставкаК = ПолучитьВставкуМеталлаПоОЗ(ДанныеТекСтр.ОбъектЗалога, ТЧ);
	
	//печОткл = "";
	печОткл = ПолучитьОтклонениеПоОЗ(ДанныеТекСтр.ОбъектЗалога);

	//++ООВ 26.03.2026 Заявка 3757	
	//Если ДанныеТекСтр.Приемщик.Сотрудник.Наименование = "" Тогда		
		Если ДанныеТекСтр.Приемщик.Наименование = "" Тогда
	//--ООВ 26.03.2026 Заявка 3757

		ПользовательКраткоеИмя = "";
	Иначе
		ПользовательКраткоеИмя = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ДанныеТекСтр.Приемщик.Наименование);
	КонецЕсли;

	//ПользовательКраткоеИмя = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Пользователи.ТекущийПользователь().Наименование);
	
	Если ДанныеТекСтр.ВидИзделия <> ДанныеТекСтр.ВидИзделияФакт ИЛИ ДанныеТекСтр.Проба <> ДанныеТекСтр.ПробаФакт ИЛИ
		ДанныеТекСтр.Категория <> ДанныеТекСтр.КатегорияФакт ИЛИ ДанныеТекСтр.МассаМеталла <> ДанныеТекСтр.МассаМеталлаФакт ИЛИ
		ДанныеТекСтр.ОбщаяМасса <> ДанныеТекСтр.ОбщаяМассаФакт ИЛИ ДанныеТекСтр.Количество <> ДанныеТекСтр.КоличествоФакт 
		ИЛИ ВставкаК.Количество() > 0 Тогда
		
		печОткл = ?(печОткл = "", печОткл + ПользовательКраткоеИмя + ":", печОткл + ";");
		
		Если ДанныеТекСтр.ВидИзделия <> ДанныеТекСтр.ВидИзделияФакт Тогда
			НаимФакт = СтрЗаменить(ДанныеТекСтр.ОбъектЗалога.Наименование, ДанныеТекСтр.ВидИзделия, ДанныеТекСтр.ВидИзделияФакт);
			печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " Наим: " + НаимФакт, печОткл + ", Наим: " + НаимФакт);
		КонецЕсли;
		
		Если ДанныеТекСтр.Категория <> ДанныеТекСтр.КатегорияФакт Тогда
			печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл),
			печОткл + " " + ДанныеТекСтр.Категория.Наименование + Символ(8594) + ДанныеТекСтр.КатегорияФакт.Наименование,
			печОткл + ДанныеТекСтр.Категория.Наименование + Символ(8594) + ДанныеТекСтр.КатегорияФакт.Наименование);
		КонецЕсли;
		
		Если ДанныеТекСтр.Металл <> ДанныеТекСтр.МеталлФакт Тогда
			печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " Мет", печОткл + ", Мет");
		КонецЕсли;

		Если ДанныеТекСтр.Проба <> ДанныеТекСтр.ПробаФакт Тогда
			печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " Проба", печОткл + ", Проба");
		КонецЕсли;

		Если ДанныеТекСтр.Количество <> ДанныеТекСтр.КоличествоФакт Тогда
			печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " Шт", печОткл + ", Шт");
		КонецЕсли;
		
		ИзмВставкиБр = Ложь;
		ИзмВставкиНеБр = Ложь;
		
		Если ВставкаК <> Неопределено И ВставкаК.Количество() > 0 Тогда
			Для каждого СтрВст Из ВставкаК Цикл
				Для каждого СтрКолонка Из ВставкаК.Колонки Цикл
					
					ЭлементФакт = СтрНайти(СтрКолонка.Имя, "Факт");

					Если ЭлементФакт = 0 Тогда
						Если СтрВст[СтрКолонка.Имя] <> СтрВст[СтрКолонка.Имя + "Факт"] Тогда
							Если СтрВст.ВидВставки = Справочники.ЛБ_ДрагоценныеКамни.Бриллиант Тогда
								печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " Оц.бр.", печОткл + ", Оц.бр.");
								ИзмВставкиБр = Истина;
							Иначе
								печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " ВесМет", печОткл + ", ВесМет");
								ИзмВставкиНеБр = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		Если ДанныеТекСтр.ОбщаяМасса <> ДанныеТекСтр.ОбщаяМассаФакт Тогда
			печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " ВесОбщ", печОткл + ", ВесОбщ");
			
			Если ДанныеТекСтр.МассаМеталла <> ДанныеТекСтр.МассаМеталлаФакт И НЕ ИзмВставкиНеБр Тогда
				печОткл = ?(СтрНайти(печОткл, ";", НаправлениеПоиска.СКонца) = СтрДлина(печОткл), печОткл + " ВесМет", печОткл + ", ВесМет");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//КодСимвола("→") Символ(8594)
	
	печОткл = ?(СтрНайти(печОткл, ",") = 1, Сред(печОткл, 3), печОткл); 
	
	ДанныеТекСтр.Отклонения = печОткл;
	
	
КонецПроцедуры

