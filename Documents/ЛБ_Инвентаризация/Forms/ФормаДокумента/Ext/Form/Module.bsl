&НаКлиенте
Процедура ВидИнвентаризацииПриИзменении(Элемент)
	//+Мельников 27.04.24
	Если ТекЗначение <> Строка(НовЗначение) Тогда
		Если Объект.Товары.Количество() > 0 Тогда
			
			Оповещение = Новый ОписаниеОповещения("ОчиститьТЧТовары", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, "Список объектов залога не пуст.
			|При продолжении список будет очищен!
			|Продолжить?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
		КонецЕсли;
	Иначе
		Если НовЗначение = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная") Тогда
			Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная");
		Иначе
			Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Выборочная");
		КонецЕсли;
	КонецЕсли;

	Если Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Выборочная") Тогда
		ЗаполнитьСписокВыбораКамней();
		ЗаполнитьСписокВыбораЗалогодателей();
	КонецЕсли;

	УстановитьВидимость();
	//-Мельников
КонецПроцедуры

