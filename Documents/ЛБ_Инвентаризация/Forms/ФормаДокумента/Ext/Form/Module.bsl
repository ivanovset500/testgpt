&НаКлиенте
Процедура ОткрытьФормуДобавленияВставкиМеталла(ТЧ)

	//Необходимо убрать отбор иначе не добавляется новая строка
	//Элементы[ТЧ.ВставкаМ].ОтборСтрок = Неопределено; // Новый ФиксированнаяСтруктура(Отбор);
	//
	
	НоваяСтрокаТЧ = Истина;
	
	НоваяСтрока = Объект[ТЧ.ВставкаМ].Добавить();
	Элементы[ТЧ.ВставкаМ].ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();

	СтрокаТабличнойЧастиТовары = Элементы[ТЧ.Основная].ТекущиеДанные;
    СтрокаТабличнойЧастиВставки = Элементы[ТЧ.ВставкаМ].ТекущиеДанные;

    //СтрокаТабличнойЧастиВставки.ОбъектЗалога = СтрокаТабличнойЧастиТовары.ОбъектЗалога;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Категория", СтрокаТабличнойЧастиТовары.КатегорияФакт); 
	ПараметрыФормы.Вставить("ОсновнойМеталл", СтрокаТабличнойЧастиТовары.Проба);
	ПараметрыФормы.Вставить("ОперацияЗайма", СтрокаТабличнойЧастиТовары.ОперацияЗайма);
	ПараметрыФормы.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧастиТовары.ЕдиницаИзмерения); //СтрокаТабличнойЧастиВставки.ЕдиницаИзмерения); 
	ПараметрыФормы.Вставить("НоваяСтрокаТЧ", НоваяСтрокаТЧ);
	ПараметрыФормы.Вставить("ИДНоваяСтрокаТЧ", НоваяСтрока.ПолучитьИдентификатор());
	ПараметрыФормы.Вставить("ОбъектЗалога", СтрокаТабличнойЧастиТовары.ОбъектЗалога); 
	ПараметрыФормы.Вставить("ТЧ", ТЧ); 
	ПараметрыФормы.Вставить("ОбщаяМассаФакт", СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт);

	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораВставкиМеталла", ЭтаФорма, ТЧ);
    ОткрытьФорму("Документ.ЛБ_Инвентаризация.Форма.КорректировкаВставкиМеталла", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

