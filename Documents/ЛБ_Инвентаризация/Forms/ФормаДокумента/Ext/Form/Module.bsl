&НаКлиенте
Процедура ИсторияЗалоговогоБилета(Команда)
	ТекСтрока = Элементы[ТекСтр].ТекущиеДанные; //Было: Элементы.Товары.ТекущиеДанные; 
	
	Если НЕ ТекСтрока = неопределено Тогда
		Результат = ПолучитьЗБ(ТекСтрока.ПолучитьИдентификатор(), ТекСтр);
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Клиент", Результат.Залогодатель);
		ПараметрыФормы.Вставить("ЗалоговыйБилет", Результат.ЗБ);	 
								
		ОткрытьФорму("Отчет.ЛБ_ИсторияЗалоговогоБилета.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗБ(Идентификатор, ТЧ) 
	Стр = Объект[ТЧ].НайтиПоИдентификатору(Идентификатор); 
	СтруктураВ = Новый Структура;
	СтруктураВ.Вставить("ЗБ", Стр.ОперацияЗайма);
	СтруктураВ.Вставить("Залогодатель", Стр.ОперацияЗайма.Залогодатель);
	Возврат СтруктураВ;
КонецФункции	

