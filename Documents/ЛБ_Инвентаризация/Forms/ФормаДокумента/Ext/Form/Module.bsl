	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	// ++ Сербаев 05.05.2023
	//ИспользоватьПодключаемоеОборудование = МенеджерОборудованияВызовСервераПереопределяемый.ИспользоватьПодключаемоеОборудование();
	// -- Сербаев 05.05.2023
	
	Если Параметры.Ключ.Пустая() Тогда
		ВидИнвентаризации = Перечисления.ЛБ_ВидИнвентаризации.Полная;
	КонецЕсли;

	//+Мельников 26.04.24 Указываем организацию для перефиксации номера документа и др. поля.
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Организация = Константы.ЛБ_ОсновнаяОрганизация.Получить(); //Справочники.Организации.НайтиПоКоду("ДМ-000003");
		//Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
		//ЛомбардСсылка = ПолучитьСсылкуЛомбарда();
		//Объект.Должность = Пользователи.ТекущийПользователь().Сотрудник.Должность;
		
		//Если ЗначениеЗаполнено(ЛомбардСсылка) Тогда
		Если ПараметрыСеанса.ТекущийПользователь.ЭтоЛомбард Тогда
			Объект.Должность = ПараметрыСеанса.ТекущийСотрудник.Должность;
			Объект.Ответственный = ПараметрыСеанса.ТекущийСотрудник;
			Объект.Ломбард = ПараметрыСеанса.ТекущийЛомбард; //ЛомбардСсылка;
		Иначе
			Объект.Должность = Пользователи.ТекущийПользователь().Сотрудник.Должность;
			Объект.Ответственный = Пользователи.ТекущийПользователь().Сотрудник;
			ЛомбардПользователя = РегистрыСведений.ЛБ_ТекущийЛомбардПользователя.Получить(Новый Структура("Пользователь", Пользователи.ТекущийПользователь()));
			Объект.Ломбард = ЛомбардПользователя.Ломбард;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаИнвентаризации) Тогда
			Объект.ДатаНачалаИнвентаризации = ТекущаяДата();
		КонецЕсли;
		
		//+МАН 27.03.25
		ЗаполнитьТЧ();
		ДобавитьМОЛ();
		//-МАН
	КонецЕсли;
	//-Мельников

	//+МАН 17.12.25
	Если Параметры.Ключ.Пустая() Тогда
		ЗаполнитьСклады(Истина);
	Иначе
		ЗаполнитьСклады();
	КонецЕсли;
	//-МАН
	
	Если Объект.ВидИнвентаризации = Перечисления.ЛБ_ВидИнвентаризации.Выборочная Тогда
		ЗаполнитьСписокВыбораКамней();
		ЗаполнитьСписокВыбораЗалогодателей();
	КонецЕсли;

	Если СтрНайти(Объект.Склад, "Витрина") > 0 Тогда
		Элементы.ТипИнвентаризации.СписокВыбора.Очистить();
		Элементы.ТипИнвентаризации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация"));
	Иначе
		Элементы.ТипИнвентаризации.СписокВыбора.Очистить();
		Элементы.ТипИнвентаризации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация"));
		Элементы.ТипИнвентаризации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.КонтрольнаяПроверка"));
	КонецЕсли;

	УстановитьВидимостьСчетовУчета();
	
	УстановитьУсловноеОформление();
	
	ПроверитьНаличиеПредседателя();
	
	ИдентификаторыСобытийПриОткрытии = "ПриОткрытии";
	
	//++ИВВ 02.2026, вычеты для часов
	ОбновитьПредставлениеВидВставки();
    //--ИВВ
КонецПроцедуры

