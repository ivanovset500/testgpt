&НаКлиенте
Функция СформироватьСтруктуруТабличныхЧастей(ТЧ)

	Если ТЧ = "Товары" Тогда
		
		ТЧ = Новый Структура;
		ТЧ.Вставить("Основная", "Товары");
		ТЧ.Вставить("ВставкаК", "ВставкиФакт");
		ТЧ.Вставить("ВставкаМ", "ВставкиМеталла");
		
		Возврат ТЧ;
	ИначеЕсли ТЧ = "НовыеОЗ" Тогда 

		ТЧ = Новый Структура;
		ТЧ.Вставить("Основная", "НовыеОЗ");
		ТЧ.Вставить("ВставкаК", "ВставкиКамнейНовыеОЗ");
		ТЧ.Вставить("ВставкаМ", "ВставкиМеталлаНовыеОЗ");
		
		Возврат ТЧ;
	ИначеЕсли ТЧ = "НаОХ" Тогда 

		ТЧ = Новый Структура;
		ТЧ.Вставить("Основная", "НаОХ");
		ТЧ.Вставить("ВставкаК", "ВставкиКамнейНаОХ");
		ТЧ.Вставить("ВставкаМ", "ВставкиМеталлаНаОХ");
		
		Возврат ТЧ;
	ИначеЕсли ТЧ = "Изъятые" Тогда 

		ТЧ = Новый Структура;
		ТЧ.Вставить("Основная", "Изъятые");
		ТЧ.Вставить("ВставкаК", "ВставкиКамнейИзъятые");
		ТЧ.Вставить("ВставкаМ", "ВставкиМеталлаИзъятые");
		
		Возврат ТЧ;
	ИначеЕсли ТЧ = "СумкаЗакрыта" Тогда 

		ТЧ = Новый Структура;
		ТЧ.Вставить("Основная", "СумкаЗакрыта");
		ТЧ.Вставить("ВставкаК", "ВставкиКамнейСумкаЗакрыта");
		ТЧ.Вставить("ВставкаМ", "ВставкиМеталлаСумкаЗакрыта");
		
		Возврат ТЧ;
	КонецЕсли;
	
КонецФункции

