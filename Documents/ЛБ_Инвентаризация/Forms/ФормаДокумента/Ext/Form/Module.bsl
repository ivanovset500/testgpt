&НаКлиенте
Процедура ОткрытиеФормыОтклоненияОЗ(ТЧ)
	
	СтрокаТабличнойЧастиТовары = Элементы[ТЧ.Основная].ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Категория", СтрокаТабличнойЧастиТовары.Категория); 
	ПараметрыФормы.Вставить("Именник", СтрокаТабличнойЧастиТовары.Именник);
	ПараметрыФормы.Вставить("ДанныеИменника", СтрокаТабличнойЧастиТовары.ДанныеИменника);
	ПараметрыФормы.Вставить("ВидИзделия", СтрокаТабличнойЧастиТовары.ВидИзделия);
	ПараметрыФормы.Вставить("Клеймо", СтрокаТабличнойЧастиТовары.Клеймо);
	ПараметрыФормы.Вставить("Количество", СтрокаТабличнойЧастиТовары.Количество);
	ПараметрыФормы.Вставить("МассаМеталла", СтрокаТабличнойЧастиТовары.МассаМеталла);
	ПараметрыФормы.Вставить("ОбщаяМасса", СтрокаТабличнойЧастиТовары.ОбщаяМасса);
	ПараметрыФормы.Вставить("Проба", СтрокаТабличнойЧастиТовары.Проба);
	ПараметрыФормы.Вставить("Дата", ПолучитьДанныеИзДокументаОперацииЗайма(СтрокаТабличнойЧастиТовары.ОперацияЗайма,, Истина));
	ПараметрыФормы.Вставить("Ломбард", Объект.Ломбард);
	ПараметрыФормы.Вставить("СхемаКредитования", ПолучитьДанныеИзДокументаОперацииЗайма(СтрокаТабличнойЧастиТовары.ОперацияЗайма, Истина));
	ПараметрыФормы.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧастиТовары.ЕдиницаИзмерения);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Объект.Проведен);
	ПараметрыФормы.Вставить("Артикул", СтрокаТабличнойЧастиТовары.Артикул);
	
	//Фактические
	ПараметрыФормы.Вставить("КатегорияФакт", СтрокаТабличнойЧастиТовары.КатегорияФакт); 
	ПараметрыФормы.Вставить("ИменникФакт", СтрокаТабличнойЧастиТовары.ИменникФакт);
	ПараметрыФормы.Вставить("ДанныеИменникаФакт", СтрокаТабличнойЧастиТовары.ДанныеИменникаФакт);
	ПараметрыФормы.Вставить("ВидИзделияФакт", СтрокаТабличнойЧастиТовары.ВидИзделияФакт);
	ПараметрыФормы.Вставить("КлеймоФакт", СтрокаТабличнойЧастиТовары.КлеймоФакт);
	ПараметрыФормы.Вставить("КоличествоФакт", СтрокаТабличнойЧастиТовары.КоличествоФакт);
	ПараметрыФормы.Вставить("МассаМеталлаФакт", СтрокаТабличнойЧастиТовары.МассаМеталлаФакт);
	ПараметрыФормы.Вставить("ОбщаяМассаФакт", СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт);
	ПараметрыФормы.Вставить("ПробаФакт", СтрокаТабличнойЧастиТовары.ПробаФакт);
	ПараметрыФормы.Вставить("ВесКамней", ПолучитьДанныеПоВставкам(СтрокаТабличнойЧастиТовары.ОбъектЗалога, "ВставкиФакт",, Истина));;
	ПараметрыФормы.Вставить("ВесВставокМеталлов", ПолучитьДанныеПоВставкам(СтрокаТабличнойЧастиТовары.ОбъектЗалога, "ВставкиМеталла",, Истина));
	
	ТЧ.Вставить("Форма", "КорректировкаОЗ");
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОЗ", ЭтаФорма, ТЧ);
	ОткрытьФорму("Документ.ЛБ_Инвентаризация.Форма.КорректировкаОЗ", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьДанныеИзДокументаОперацииЗайма(ОперацияЗайма, СхемаКредитования = Ложь, ДатаДокумента = Ложь) Экспорт  
	Если СхемаКредитования Тогда
		Возврат ОперацияЗайма.СхемаКредитования;
	ИначеЕсли ДатаДокумента Тогда
		Возврат НачалоДня(ОперацияЗайма.Дата);
	КонецЕсли;		
КонецФункции

&НаСервере
Функция ПолучитьДанныеПоВставкам(ОбъектЗалога, ТЧ, Сумма = Ложь, Вес = Ложь) Экспорт  
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОбъектЗалога", ОбъектЗалога);
	
	МассивВставок = Объект[ТЧ].НайтиСтроки(Отбор);

	Если Сумма Тогда
		
		СуммаВставок = 0;
		
		Если ТЧ = "ВставкиМеталла" Тогда
			Для каждого СтрМ Из МассивВставок Цикл
				СуммаВставок = СуммаВставок + СтрМ.СуммаОценкиФакт;
			КонецЦикла;
		Иначе
			Для каждого СтрМ Из МассивВставок Цикл
				СуммаВставок = СуммаВставок + СтрМ.СуммаФакт;
			КонецЦикла;
		КонецЕсли;
		
		Возврат СуммаВставок;
	ИначеЕсли Вес Тогда
		
		ВесВставок = 0;
		
		Если ТЧ = "ВставкиМеталла" Тогда
			Для каждого СтрМ Из МассивВставок Цикл
				ВесВставок = ВесВставок + СтрМ.ВесФакт;
			КонецЦикла;
		Иначе
			Для каждого СтрМ Из МассивВставок Цикл
				ВесВставок = ВесВставок + СтрМ.ВесГраммыФакт;
			КонецЦикла;
		КонецЕсли;
		
		Возврат ВесВставок;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораОЗ(Результат, ДопПараметры) Экспорт  
	
	СтрокаТабличнойЧастиТовары	= Элементы[ДопПараметры.Основная].ТекущиеДанные;

	НоваяСтрокаТЧ = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") И Результат.Отмена И Результат.НоваяСтрокаТЧ Тогда
		
		Объект[ДопПараметры.Основная].Удалить(Элементы[ДопПараметры.Основная].ТекущиеДанные.НомерСтроки - 1);
		
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") И НЕ Результат.Отмена И Результат.НоваяСтрокаТЧ Тогда
		
		НаличиеОЗВТЧ = ПроверитьОЗНаНаличиеВТЧ(Результат.ОбъектЗалога);
		
		Если НаличиеОЗВТЧ Тогда
			Предупреждение("Выбранный объект залога уже присутствует в таблице.");
		Иначе
			НоваяСтрокаТЧ = Результат.НоваяСтрокаТЧ;
			ДобавляемыйОЗ = Результат.ОбъектЗалога;
			УдалитьВставкиПоОЗ(Результат.ОбъектЗалога, ДопПараметры);
			//+МАН 22.11.24
			ЗаполнитьПоОстаткамОбъектовЗалога(Истина);
			//-МАН
		КонецЕсли;
		
		Объект[ДопПараметры.Основная].Удалить(Элементы[ДопПараметры.Основная].ТекущиеДанные.НомерСтроки - 1);
		
	Иначе
	
		СтрокаТабличнойЧастиТовары.ВидИзделияФакт = Результат.ВидИзделияФакт;
		СтрокаТабличнойЧастиТовары.ИменникФакт = Результат.ИменникФакт;
		СтрокаТабличнойЧастиТовары.ДанныеИменникаФакт = Результат.ДанныеИменникаФакт;
		СтрокаТабличнойЧастиТовары.КатегорияФакт = Результат.КатегорияФакт;
		СтрокаТабличнойЧастиТовары.КлеймоФакт = Результат.КлеймоФакт;
		СтрокаТабличнойЧастиТовары.ПробаФакт = Результат.ПробаФакт;
		СтрокаТабличнойЧастиТовары.КоличествоФакт = Результат.КоличествоФакт;
		СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт = Результат.ОбщаяМассаФакт;
		СтрокаТабличнойЧастиТовары.МассаМеталлаФакт = Результат.МассаМеталлаФакт; 
		
		//++ООВ 26.03.2026 Заявка 3757
		Если Результат.КоличествоФакт = 0 Тогда
			СтрокаТабличнойЧастиТовары.Комментарий = "Изделие отсутствует";
			СтрокаТабличнойЧастиТовары.СтатусОбъектаЗалога = ПредопределенноеЗначение("Перечисление.ЛБ_СтатусыОбъектовЗалога.Недостача");
		КонецЕсли;
		//--ООВ 26.03.2026 Заявка 3757
		
		СформироватьСтрокуОтклонения(ДопПараметры);
		
		Модифицированность = Истина; 
		
		//++ООВ 06.04.2026 Заявка 3757
		Если СтрокаТабличнойЧастиТовары.Количество <> СтрокаТабличнойЧастиТовары.КоличествоФакт Тогда
			СтрокаТабличнойЧастиТовары.СуммаОценкиФакт = 0;
			СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлыФакт = 0;
		Иначе
			//--ООВ 06.04.2026 Заявка 3757
			
			Если СтрокаТабличнойЧастиТовары.Категория <> СтрокаТабличнойЧастиТовары.КатегорияФакт ИЛИ
				//СтрокаТабличнойЧастиТовары.Проба <> СтрокаТабличнойЧастиТовары.ПробаФакт ИЛИ
				//СтрокаТабличнойЧастиТовары.Количество <> СтрокаТабличнойЧастиТовары.КоличествоФакт ИЛИ 
				
				//++ООВ 06.04.2026 Заявка 3757 
				(СтрокаТабличнойЧастиТовары.Проба <> СтрокаТабличнойЧастиТовары.ПробаФакт 
				И СтрокаТабличнойЧастиТовары.Количество = СтрокаТабличнойЧастиТовары.КоличествоФакт) ИЛИ
				//--ООВ 06.04.2026 Заявка 3757
				
				СтрокаТабличнойЧастиТовары.ОбщаяМасса <> СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт ИЛИ
				СтрокаТабличнойЧастиТовары.МассаМеталла <> СтрокаТабличнойЧастиТовары.МассаМеталлаФакт Тогда
				
				ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор(), ДопПараметры.Основная, ДопПараметры);
			Иначе
				СтрокаТабличнойЧастиТовары.СуммаОценкиФакт = СтрокаТабличнойЧастиТовары.СуммаОценки;
				СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлыФакт = СтрокаТабличнойЧастиТовары.СуммаОценкиМеталлы;			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	
	ОбщееКоличествоОЗВДокументе();
КонецПроцедуры

&НаКлиенте
Процедура ВставкиМеталлаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ТекущийЭлемент.Имя = "Товары" ИЛИ ТекущийЭлемент.Имя = "ВставкиФакт" ИЛИ ТекущийЭлемент.Имя = "ВставкиМеталла" Тогда
		ОткрытьФормуОтклоненияВставкиМеталла(СформироватьСтруктуруТабличныхЧастей("Товары"));
	ИначеЕсли ТекущийЭлемент.Имя = "НовыеОЗ" ИЛИ ТекущийЭлемент.Имя = "ВставкиКамнейНовыеОЗ" ИЛИ ТекущийЭлемент.Имя = "ВставкиМеталлаНовыеОЗ" Тогда
		ОткрытьФормуОтклоненияВставкиМеталла(СформироватьСтруктуруТабличныхЧастей("НовыеОЗ"));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоследнююТекущуюСтроку()
    Элементы.ВставкиМеталла.ТекущаяСтрока=?(Объект.ВставкиМеталла.Количество()=0,0,Объект.ВставкиМеталла.Количество()-1);
КонецПроцедуры

&НаКлиенте
Процедура ВставкиФактПередУдалением(Элемент, Отказ)
	Если Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная") Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВставкиМеталлаПередУдалением(Элемент, Отказ)
	Если Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная") Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

