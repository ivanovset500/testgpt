	Для каждого СтрОЗВставкаМеталла Из ТЧВставкиМеталла Цикл //ТзВствкиМеталла Цикл
	
		Отбор = Новый Структура;
		Отбор.Вставить("ОбъектЗалога",СтрОЗВставкаМеталла.ОбъектЗалога);
		
		//+МАН 25.11.24
		Если Остатки Тогда
			НайденныйОЗ = Объект.Товары.НайтиСтроки(Отбор);
		ИначеЕсли НаОХ Тогда
			НайденныйОЗ = Объект.НаОХ.НайтиСтроки(Отбор);
		ИначеЕсли Изъятые Тогда
			НайденныйОЗ = Объект.Изъятые.НайтиСтроки(Отбор);
		ИначеЕсли СумкаЗакрыта Тогда
			НайденныйОЗ = Объект.СумкаЗакрыта.НайтиСтроки(Отбор);
		ИначеЕсли НовыеОЗ ИЛИ ОбновитьНовыеОЗ Тогда
			НайденныйОЗ = Объект.НовыеОЗ.НайтиСтроки(Отбор);
		КонецЕсли;
		//-МАН
		
		Для каждого СтрОЗНайденный Из НайденныйОЗ Цикл
			СтрОЗНайденный.Вставка = ?(СтрОЗНайденный.Вставка = "", СтрОЗНайденный.Вставка, СтрОЗНайденный.Вставка + ", ") + СтрОЗВставкаМеталла.Проба.Наименование;
		КонецЦикла;
	КонецЦикла;
	//-Мельников
	
	//+МАН 25.11.24
	Если Остатки Тогда
		ЗаполнитьПоОстаткамОбъектовЗалога(,Истина);
		ЗаполнитьПоОстаткамОбъектовЗалога(,,Истина);
		ЗаполнитьПоОстаткамОбъектовЗалога(,,,Истина);
	КонецЕсли;
	//-МАН
	
КонецПроцедуры
//-МАН
#КонецОбласти //СтарыеПроцедурыЗаполненияОстатков

&НаСервере
Функция КоличествоВставок(ОЗ, Дата, НовыеОЗ = Ложь)
	
	Если НЕ НовыеОЗ Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЛБ_ВставкиОбъектаЗалогаСрезПоследних.НомерСтрокиТаблицы) КАК НомерСтрокиТаблицы
		|ИЗ
		|	РегистрСведений.ЛБ_ВставкиОбъектаЗалога.СрезПоследних(&НаДату, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_ВставкиОбъектаЗалогаСрезПоследних";
		
		Запрос.УстановитьПараметр("НаДату", Дата);
		Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			Возврат Результат.НомерСтрокиТаблицы;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЛБ_ВставкиОбъектаЗалогаСрезПоследних.НомерСтрокиТаблицы) КАК НомерСтрокиТаблицы
		|ИЗ
		|	РегистрСведений.ЛБ_ВставкиОбъектаЗалога.СрезПоследних(&ПоДату, ОбъектЗалога = &ОбъектЗалога) КАК ЛБ_ВставкиОбъектаЗалогаСрезПоследних
		|ГДЕ
		|	ЛБ_ВставкиОбъектаЗалогаСрезПоследних.Период МЕЖДУ &СДаты И &ПоДату";
		
		Запрос.УстановитьПараметр("СДаты", Дата);    
		Запрос.УстановитьПараметр("ПоДату", ТекущаяДата());    
		Запрос.УстановитьПараметр("ОбъектЗалога", ОЗ);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			Возврат Результат.НомерСтрокиТаблицы;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

