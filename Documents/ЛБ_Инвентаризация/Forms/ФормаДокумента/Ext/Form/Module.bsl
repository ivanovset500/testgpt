#КонецОбласти

&НаКлиенте
Процедура ОчиститьТЧТовары(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.Товары.Очистить();
		Объект.ВставкиФакт.Очистить();
		Объект.ВставкиМеталла.Очистить();
		Объект.НовыеОЗ.Очистить();
		Объект.ВставкиКамнейНовыеОЗ.Очистить();
		Объект.ВставкиМеталлаНовыеОЗ.Очистить();
		Объект.НаОХ.Очистить();
		Объект.ВставкиКамнейНаОХ.Очистить();
		Объект.ВставкиМеталлаНаОХ.Очистить();
		Объект.Изъятые.Очистить();
		Объект.ВставкиКамнейИзъятые.Очистить();
		Объект.ВставкиМеталлаИзъятые.Очистить();
		Объект.СумкаЗакрыта.Очистить();
		Объект.ВставкиКамнейСумкаЗакрыта.Очистить();
		Объект.ВставкиМеталлаСумкаЗакрыта.Очистить();
	Иначе
		Если НовЗначение = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная") Тогда
			Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Выборочная");
		Иначе
			Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная");
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
КонецПроцедуры

//+Мельников 27.04.24
&НаКлиенте
Процедура УстановитьВидимость(ТекСклад = Неопределено)

	СкладВитринаНеЦО = ?(ТекСклад = Неопределено, СтрНайти(Объект.Склад, "Витрина") > 0, СтрНайти(ТекСклад, "Витрина") > 0) И Объект.Ломбард <> ПредопределенноеЗначение("Справочник.ЛБ_Ломбарды.ЦентральныйОфис");

	СкладВитрина = ?(ТекСклад = Неопределено, СтрНайти(Объект.Склад, "Витрина") > 0, СтрНайти(ТекСклад, "Витрина") > 0);
	
	Если ЗначениеЗаполнено(Объект.ВидИнвентаризации) И ЗначениеЗаполнено(Объект.ТипИнвентаризации) Тогда
		
		Элементы.ГруппаПроведениеИнвентаризации.Видимость = ?(Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Полная"), Ложь, Истина);
		Элементы.ГруппаТовары.Видимость = Истина;
		//Элементы.ДокументОснование.Видимость = Истина;
		Элементы.ДокументОснованиеВид.Видимость = Истина;
		Элементы.НомерПриказа.Видимость = Истина;
		Элементы.ДатаПриказа.Видимость = Истина;
		Элементы.Инициатор.Видимость = Истина;
		//+МАН 17.10.24 Заявка 2464
		Элементы.ГруппаНовыеОЗ.Видимость = Истина;
		//+МАН 25.11.24
		Если СкладВитринаНеЦО Тогда
			Элементы.ГруппаНаОХ.Видимость = Ложь;
			Элементы.ГруппаИзъятые.Видимость = Ложь;
			Элементы.ГруппаСумкаЗакрыта.Видимость = Ложь;
		Иначе
			Элементы.ГруппаНаОХ.Видимость = Истина;
			Элементы.ГруппаИзъятые.Видимость = Истина;
			Элементы.ГруппаСумкаЗакрыта.Видимость = Истина;
		КонецЕсли;
		//-МАН
		Если Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.Выборочная") Тогда
			Элементы.ТоварыДобавитьОЗ.Видимость = Истина;
		Иначе
			Элементы.ТоварыДобавитьОЗ.Видимость = Ложь;
		КонецЕсли;
		
	Иначе 
		Элементы.ГруппаПроведениеИнвентаризации.Видимость = Ложь;
		Элементы.ГруппаТовары.Видимость = Ложь;
		//Элементы.ДокументОснование.Видимость = Ложь;
		Элементы.ДокументОснованиеВид.Видимость = Ложь;
		Элементы.НомерПриказа.Видимость = Ложь;
		Элементы.ДатаПриказа.Видимость = Ложь;
		Элементы.Инициатор.Видимость = Ложь;
		//+МАН 17.10.24 Заявка 2464
		Элементы.ГруппаНовыеОЗ.Видимость = Ложь;
		//+МАН 25.11.24
		Элементы.ГруппаНаОХ.Видимость = Ложь;
		Элементы.ГруппаИзъятые.Видимость = Ложь;
		Элементы.ГруппаСумкаЗакрыта.Видимость = Ложь;
		//-МАН
	КонецЕсли;

	Если Объект.Проведен Тогда
		НеРедактировать = Истина;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Факт"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноБордовый;  
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.ТусклоРозовый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
	Иначе
		НеРедактировать = Ложь;
		Элементы.ДекорацияСтатусДокумента.Заголовок = "Проект"; 
		Элементы.ДекорацияСтатусДокумента.ЦветТекста = WebЦвета.ТемноЗеленый;
		Элементы.ДекорацияСтатусДокумента.ЦветФона = WebЦвета.СветлоЗеленый;
		ЭтотОбъект.ТолькоПросмотр = НеРедактировать;
	КонецЕсли;

	//ЛомбардСсылка = ПолучитьСсылкуЛомбарда();
	ЭтоЛомбард = ПользовательЛомбард();
	
	//Если ЗначениеЗаполнено(ЛомбардСсылка) Тогда
	Если ЭтоЛомбард Тогда
		Элементы.Ломбард.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Ломбард.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Если Объект.ФильтрСтатусы.Количество() > 0 Тогда
		Элементы.ФильтрСтатусыОчиститьСтатусыЗБ.Доступность = Истина;
	Иначе 
		Элементы.ФильтрСтатусыОчиститьСтатусыЗБ.Доступность = Ложь;
	КонецЕсли;
	
	Если Объект.ФильтрПробы.Количество() > 0 Тогда
		Элементы.ФильтрПробыОчиститьПробы.Доступность = Истина;
	Иначе 
		Элементы.ФильтрПробыОчиститьПробы.Доступность = Ложь;
	КонецЕсли;
	
	Если Объект.ФильтрКатегории.Количество() > 0 Тогда
		Элементы.ФильтрКатегорииОчиститьКатегории.Доступность = Истина;
	Иначе 
		Элементы.ФильтрКатегорииОчиститьКатегории.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ФильтрВидыИзделий.Количество() > 0 Тогда
		Элементы.ФильтрВидыИзделийОчиститьВидыИзделия.Доступность = Истина;
	Иначе 
		Элементы.ФильтрВидыИзделийОчиститьВидыИзделия.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ФильтрСтатусыЗалогодателя.Количество() > 0 Тогда
		Элементы.ФильтрСтатусыЗалогодателяОчиститьСтатусыЗалогодателя.Доступность = Истина;
	Иначе 
		Элементы.ФильтрСтатусыЗалогодателяОчиститьСтатусыЗалогодателя.Доступность = Ложь;
	КонецЕсли;
	
	Если Объект.ФильтрЗалогодатели.Количество() > 0 Тогда
		Элементы.ФильтрЗалогодателиОчиститьЗалогодателей.Доступность = Истина;
	Иначе 
		Элементы.ФильтрЗалогодателиОчиститьЗалогодателей.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ФильтрПриемщики.Количество() > 0 Тогда
		Элементы.ФильтрПриемщикиОчиститьПриемщиков.Доступность = Истина;
	Иначе 
		Элементы.ФильтрПриемщикиОчиститьПриемщиков.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ФильтрКамни.Количество() > 0 Тогда
		Элементы.ФильтрКамниОчиститьВставки.Доступность = Истина;
	Иначе 
		Элементы.ФильтрКамниОчиститьВставки.Доступность = Ложь;
	КонецЕсли;
	
	Если Объект.ОтборБезВставок Тогда
		Элементы.ФильтрКамни.Доступность = Ложь;
		Элементы.ОтборВставкаМеталл.Доступность = Ложь;
		Элементы.ОтборВставкаКомплектующие.Доступность = Ложь;
	Иначе 
		Элементы.ФильтрКамни.Доступность = Истина;
		Элементы.ОтборВставкаМеталл.Доступность = Истина;
		Элементы.ОтборВставкаКомплектующие.Доступность = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборДатаЗаймаОт) ИЛИ ЗначениеЗаполнено(Объект.ОтборДатаЗаймаДо) Тогда
		Элементы.ОчиститьДатыЗайма.Доступность = Истина;
	Иначе
		Элементы.ОчиститьДатыЗайма.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ОтборСуммаОценкиОт <> 0 ИЛИ Объект.ОтборСуммаОценкиДо <> 0 Тогда
		Элементы.ОчиститьСуммыОценки.Доступность = Истина;
	Иначе
		Элементы.ОчиститьСуммыОценки.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ОтборОбщаяМассаОт <> 0 ИЛИ Объект.ОтборОбщаяМассаДо <> 0 Тогда
		Элементы.ОчиститьОбщиеМассы.Доступность = Истина;
	Иначе
		Элементы.ОчиститьОбщиеМассы.Доступность = Ложь;
	КонецЕсли;

	Если Объект.ОтборМассаМеталлаОт <> 0 ИЛИ Объект.ОтборМассаМеталлаДо <> 0 Тогда
		Элементы.ОчиститьМассыМеталла.Доступность = Истина;
	Иначе
		Элементы.ОчиститьМассыМеталла.Доступность = Ложь;
	КонецЕсли;

	//+Мельников 17.10.24 Заявка 2464
	Если Объект.Товары.Количество() = 0 Тогда
		Элементы.ВставкиФактДобавитьВставку.Доступность = Ложь;
		Элементы.ВставкиМеталлаДобавитьВставкуМеталла.Доступность = Ложь;
		Элементы.ТоварыОтклоненияОЗ.Доступность = Ложь;
		Элементы.ТоварыОчиститьТЧОЗ.Доступность = Ложь;
	Иначе
		Элементы.ВставкиФактДобавитьВставку.Доступность = Истина;
		Элементы.ВставкиМеталлаДобавитьВставкуМеталла.Доступность = Истина;
		Элементы.ТоварыОтклоненияОЗ.Доступность = Истина;
		Элементы.ТоварыОчиститьТЧОЗ.Доступность = Истина;
	КонецЕсли;
	
	Если Объект.НовыеОЗ.Количество() = 0 Тогда
		Элементы.ВставкиКамнейНовыеОЗДобавитьВставку.Доступность = Ложь;
		Элементы.ВставкиМеталлаНовыеОЗДобавитьВставкуМеталла.Доступность = Ложь;
		Элементы.ТоварыОтклоненияОЗНовыеОЗ.Доступность = Ложь;
	Иначе
		Элементы.ВставкиКамнейНовыеОЗДобавитьВставку.Доступность = Истина;
		Элементы.ВставкиМеталлаНовыеОЗДобавитьВставкуМеталла.Доступность = Истина;
		Элементы.ТоварыОтклоненияОЗНовыеОЗ.Доступность = Истина;
	КонецЕсли;
	//-Мельников

	Если СкладВитрина Тогда
		Если Объект.ТипИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
			Элементы.ФормаПечатьИНВ8.Видимость = Истина;
			Элементы.ФормаПечатьИНВ8Черновик.Видимость = Истина;
			Элементы.ФормаПечатьИНВ8Пустой.Видимость = Истина;
			Элементы.ФормаПечатьИНВ5.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ5Пустой.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ19Полная.Видимость = Истина;
			Элементы.ФормаПечатьИНВ19Новые.Видимость = Истина;
			Элементы.ФормаПечатьИНВ19Недостача.Видимость = Истина;
			Элементы.ФормаПечатьАктПроверкиДокументов.Видимость = Ложь;
			Элементы.ФормаПечатьОписьПосылок.Видимость = Ложь;
			Элементы.ФормаПечатьОписьПоступивших.Видимость = Истина;
			Элементы.ФормаПечатьОписьВыбывших.Видимость = Истина;
			Элементы.ФормаПечатьАктПроверкиОЗ.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Если Объект.ТипИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.КонтрольнаяПроверка") Тогда
			Элементы.ФормаПечатьИНВ8.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ8Черновик.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ8Пустой.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ5.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ5Пустой.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ19Полная.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ19Новые.Видимость = Ложь;
			Элементы.ФормаПечатьИНВ19Недостача.Видимость = Ложь;
			Элементы.ФормаПечатьАктПроверкиДокументов.Видимость = Ложь;
			Элементы.ФормаПечатьОписьПосылок.Видимость = Ложь;
			Элементы.ФормаПечатьОписьПоступивших.Видимость = Ложь;
			Элементы.ФормаПечатьОписьВыбывших.Видимость = Ложь;
			Элементы.ФормаПечатьАктПроверкиОЗ.Видимость = Истина;
		ИначеЕсли Объект.ТипИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
			Элементы.ФормаПечатьИНВ8.Видимость = Истина;
			Элементы.ФормаПечатьИНВ8Черновик.Видимость = Истина;
			Элементы.ФормаПечатьИНВ8Пустой.Видимость = Истина;
			Элементы.ФормаПечатьИНВ5.Видимость = Истина;
			Элементы.ФормаПечатьИНВ5Пустой.Видимость = Истина;
			Элементы.ФормаПечатьИНВ19Полная.Видимость = Истина;
			Элементы.ФормаПечатьИНВ19Новые.Видимость = Истина;
			Элементы.ФормаПечатьИНВ19Недостача.Видимость = Истина;
			Элементы.ФормаПечатьАктПроверкиДокументов.Видимость = Истина;
			Элементы.ФормаПечатьОписьПосылок.Видимость = Истина;
			Элементы.ФормаПечатьОписьПоступивших.Видимость = Истина;
			Элементы.ФормаПечатьОписьВыбывших.Видимость = Истина;
			Элементы.ФормаПечатьАктПроверкиОЗ.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Элементы.ГруппаКомиссия.Доступность = Истина;
	Иначе
		Элементы.ГруппаКомиссия.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

