		ИначеЕсли Склады.Количество() = 1 Тогда
			Элементы.Склад.СписокВыбора.Очистить();
			Элементы.Склад.СписокВыбора.Добавить(Склады[0]);
			
			Если НовыйДокумент Тогда
				Объект.Склад = Склады[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкладОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	Если СтрНайти(ВыбранноеЗначение, "Витрина") > 0 Тогда
		Элементы.ТипИнвентаризации.СписокВыбора.Очистить();
		Элементы.ТипИнвентаризации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация"));
	Иначе
		Элементы.ТипИнвентаризации.СписокВыбора.Очистить();
		Элементы.ТипИнвентаризации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация"));
		Элементы.ТипИнвентаризации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.КонтрольнаяПроверка"));
	КонецЕсли;
	
	Объект.ТипИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.ПустаяСсылка");
	Объект.ВидИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидИнвентаризации.ПустаяСсылка");
	
	УстановитьВидимость(ВыбранноеЗначение);
	ТекущийЭлемент = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.ГруппаКомиссия;
	ТекСтр = "МОЛы";
	
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СкладНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Если Объект.Товары.Количество() > 0 ИЛИ Объект.НаОХ.Количество() > 0 ИЛИ Объект.Изъятые.Количество() > 0 ИЛИ Объект.СумкаЗакрыта.Количество() > 0
			ИЛИ Объект.НовыеОЗ.Количество() > 0 Тогда
			
			Ответ = Вопрос("При изменении склада очистятся все списки с объектами залога.
			|Изменить склад?", РежимДиалогаВопрос.ДаНет);
			
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Объект.Товары.Очистить();
				Объект.ВставкиФакт.Очистить();
				Объект.ВставкиМеталла.Очистить();
				Объект.НовыеОЗ.Очистить();
				Объект.ВставкиКамнейНовыеОЗ.Очистить();
				Объект.ВставкиМеталлаНовыеОЗ.Очистить();
				Объект.НаОХ.Очистить();
				Объект.ВставкиКамнейНаОХ.Очистить();
				Объект.ВставкиМеталлаНаОХ.Очистить();
				Объект.Изъятые.Очистить();
				Объект.ВставкиКамнейИзъятые.Очистить();
				Объект.ВставкиМеталлаИзъятые.Очистить();
				Объект.СумкаЗакрыта.Очистить();
				Объект.ВставкиКамнейСумкаЗакрыта.Очистить();
				Объект.ВставкиМеталлаСумкаЗакрыта.Очистить();
			Иначе
				СтандартнаяОбработка = Ложь;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛомбардПриИзменении(Элемент)
	ЗаполнитьСклады(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПечатьДокумента(Команда)
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_Инвентаризация");

		ПараметрыПечати = Новый Структура;

		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		
	Если НЕ Модифицированность Тогда
		Если СтрНайти(Команда.Имя, "ИНВ8") > 0 Тогда
			Если СтрНайти(Команда.Имя, "Черновик") > 0 Тогда
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ8Черновик");
				//ПараметрыПечати.Вставить("ЗаголовокФормы", "Инвентаризация ОЗ " + Объект.Номер + " от " + Объект.Дата);		
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-8 Акт инвентаризации ДМ и изделий из них (черновик)");		
			ИначеЕсли СтрНайти(Команда.Имя, "Пустой") > 0 Тогда
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ8Пустая");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-8 Акт инвентаризации ДМ и изделий из них (пустой)");		
			Иначе
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ8");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-8 Акт инвентаризации ДМ и изделий из них");		
			КонецЕсли;
		ИначеЕсли СтрНайти(Команда.Имя, "ИНВ5") > 0 Тогда
			Если СтрНайти(Команда.Имя, "Пустой") > 0 Тогда
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ5Пустая");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-5 Акт инвентаризации ДМ на ОХ (пустой)");		
			Иначе
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ5");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-5 Акт инвентаризации ДМ на ОХ");		
			КонецЕсли;
		ИначеЕсли СтрНайти(Команда.Имя, "ИНВ19") > 0 Тогда
			Если СтрНайти(Команда.Имя, "Полная") > 0 Тогда
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ19Полная");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-19 Сличительная ведомость итогов инвентаризации (полная)");		
			ИначеЕсли СтрНайти(Команда.Имя, "Новые") > 0 Тогда
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ19Новое");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-19 Сличительная ведомость итогов инвентаризации (новые)");		
			Иначе
				ПараметрыФормы.Вставить("ИменаМакетов", "ИНВ19Недостача");
				ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-19 Сличительная ведомость итогов инвентаризации (недостача)");		
			КонецЕсли;
		ИначеЕсли СтрНайти(Команда.Имя, "АктПроверкиДокументов") > 0 Тогда
			ПараметрыФормы.Вставить("ИменаМакетов", "Изъятые");
			ПараметрыПечати.Вставить("ЗаголовокФормы", "Акт проверки документов, подтверждающих изъятие");		
		ИначеЕсли СтрНайти(Команда.Имя, "ОписьПосылок") > 0 Тогда
			ПараметрыФормы.Вставить("ИменаМакетов", "Посылки");
			ПараметрыПечати.Вставить("ЗаголовокФормы", "ИНВ-19 Опись не распакованных посылок с ценностями");		
		ИначеЕсли СтрНайти(Команда.Имя, "ОписьПоступивших") > 0 Тогда
			ПараметрыФормы.Вставить("ИменаМакетов", "ОписьПоступивших");
			ПараметрыПечати.Вставить("ЗаголовокФормы", "Опись ценностей, поступивших во время инвентаризации");		
		ИначеЕсли СтрНайти(Команда.Имя, "ОписьВыбывших") > 0 Тогда
			ПараметрыФормы.Вставить("ИменаМакетов", "ОписьВыбывших");
			ПараметрыПечати.Вставить("ЗаголовокФормы", "Опись ценностей, выбывших во время инвентаризации");		
		ИначеЕсли СтрНайти(Команда.Имя, "АктПроверкиОЗ") > 0 Тогда
			ПараметрыФормы.Вставить("ИменаМакетов", "АктПроверки");
			ПараметрыПечати.Вставить("ЗаголовокФормы", "Акт проверки предметов залога");		
		КонецЕсли;
	Иначе
		Сообщить("Были внесены изменения. Необходимо записать документ!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
	ПараметрыФормы.Вставить("ПараметрыПечати", ПараметрыПечати);
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,);   
КонецПроцедуры
