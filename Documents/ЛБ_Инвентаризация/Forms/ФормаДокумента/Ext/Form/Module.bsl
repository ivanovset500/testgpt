&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	ВсеЗаполнено = ПроверитьЗаполнениеТЧ();
	Если НЕ ВсеЗаполнено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ПараметрыЗаписи.РежимЗаписи = ПредопределенноеЗначение("РежимЗаписиДокумента.Проведение") Тогда
		КлючеваяОперация = "ПроведениеИнвентаризацияТоваровНаСкладе";
		//+Мельников 06.05.24
		//ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина, КлючеваяОперация);

		//ВсеЗаполнено = ПроверитьЗаполнениеТЧ();
		//Если НЕ ВсеЗаполнено Тогда
		//	Отказ = Истина;
		//	Возврат;
		//КонецЕсли;
		
		Объект.ДатаОкончанияИнвентаризации = ТекущаяДата();

		//++ООВ 26.03.2026 Заявка 3757 При наличии недостачи - вывод другого сообщения 
		СтрокиНедостачи = Объект.Товары.НайтиСтроки(Новый Структура("КоличествоФакт", 0));
		Если СтрокиНедостачи.Количество() > 0 Тогда  
			СтрокиВывода = Новый Массив;
			Для Каждого Стр Из СтрокиНедостачи Цикл
				Если ЗначениеЗаполнено(Стр.Вставка) Тогда
					Вставка = "да";
				Иначе
					Вставка = "нет"; 
				КонецЕсли;
				СтрокаМассива = СтрШаблон("%1) артикул: %2, %3, %4, %5, вес изделия: %6, вес металла: %7, вставки: %8", 
				СтрокиНедостачи.Найти(Стр)+1, Стр.Артикул, Стр.ВидИзделия, Стр.Проба, Стр.Категория, Стр.ОбщаяМасса, Стр.МассаМеталла, Вставка);
				СтрокиВывода.Добавить(СтрокаМассива);
			КонецЦикла;	
			Текст = СтрСоединить(СтрокиВывода, Символы.ПС);
			
			ТекстВопроса = СтрШаблон("Фиксируется недостача по %1 позициям:
			|%2 
			|
			|После проведения документа отменить изменения будет невозможно.
			|Провести документ?", СтрокиВывода.Количество(), Текст);
			
			Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет); 
		Иначе 
			//--ООВ 26.03.2026 Заявка 3757 
			
			Ответ = Вопрос("После проведения документа отмена изменений будет невозможна.
			|Провести документ?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Отказ = Ложь;
			Иначе
				Отказ = Истина;
			КонецЕсли;
			//-Мельников
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

