&НаКлиенте
Процедура ОткрытьФормуОтклоненияВставкиМеталла(ТЧ)
	
	СтрокаТабличнойЧастиТовары	= Элементы[ТЧ.Основная].ТекущиеДанные;
	СтрокаТабличнойЧастиВставки	= Элементы[ТЧ.ВставкаМ].ТекущиеДанные;  
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Проба", СтрокаТабличнойЧастиВставки.Проба); 
	ПараметрыФормы.Вставить("Вес", СтрокаТабличнойЧастиВставки.Вес);
	ПараметрыФормы.Вставить("ВесВПробеЧистоты", СтрокаТабличнойЧастиВставки.ВесВПробеЧистоты); 
	ПараметрыФормы.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧастиВставки.ЕдиницаИзмерения); 
	ПараметрыФормы.Вставить("СуммаОценки", СтрокаТабличнойЧастиВставки.СуммаОценки);
	ПараметрыФормы.Вставить("ОсновнойМеталл", СтрокаТабличнойЧастиТовары.Проба);
	ПараметрыФормы.Вставить("ОперацияЗайма", СтрокаТабличнойЧастиТовары.ОперацияЗайма);
	ПараметрыФормы.Вставить("Категория", СтрокаТабличнойЧастиТовары.КатегорияФакт); 
	ПараметрыФормы.Вставить("ОбъектЗалога", СтрокаТабличнойЧастиТовары.ОбъектЗалога); 
	ПараметрыФормы.Вставить("ТолькоПросмотр", Объект.Проведен);
	//Фактические
	ПараметрыФормы.Вставить("ПробаФакт", СтрокаТабличнойЧастиВставки.ПробаФакт); 
	ПараметрыФормы.Вставить("ВесФакт", СтрокаТабличнойЧастиВставки.ВесФакт);
	ПараметрыФормы.Вставить("ВесВПробеЧистотыФакт", СтрокаТабличнойЧастиВставки.ВесВПробеЧистотыФакт); 
	ПараметрыФормы.Вставить("ЕдиницаИзмеренияФакт", СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт); 
	ПараметрыФормы.Вставить("СуммаОценкиФакт", СтрокаТабличнойЧастиВставки.СуммаОценкиФакт); 
	ПараметрыФормы.Вставить("ТЧ", ТЧ);
	ПараметрыФормы.Вставить("ОбщаяМассаФакт", СтрокаТабличнойЧастиТовары.ОбщаяМассаФакт);
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораВставкиМеталла", ЭтаФорма, ТЧ);
	ОткрытьФорму("Документ.ЛБ_Инвентаризация.Форма.КорректировкаВставкиМеталла", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВставкиМеталла(Результат, ДопПараметры) Экспорт  
	
	СтрокаТабличнойЧастиТовары	= Элементы[ДопПараметры.Основная].ТекущиеДанные;
	СтрокаТабличнойЧастиВставки	= Элементы[ДопПараметры.ВставкаМ].ТекущиеДанные; 

	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") И Результат.НоваяСтрокаТЧ И Результат.Отмена Тогда
		Если Элементы[ДопПараметры.ВставкаМ].ТекущиеДанные <> Неопределено Тогда
			//+МАН 30.05.25 Изменил удаление пустой строки.
			//Объект[ДопПараметры.ВставкаМ].Удалить(Элементы[ДопПараметры.ВставкаМ].ТекущиеДанные.НомерСтроки - 1);
			Объект[ДопПараметры.ВставкаМ].Удалить(Результат.ИДНоваяСтрокаТЧ);
			//-МАН
		КонецЕсли;
	Иначе
		Если Результат.НоваяСтрокаТЧ Тогда
			СтрокаТабличнойЧастиВставки = Объект[ДопПараметры.ВставкаМ].НайтиПоИдентификатору(Результат.ИДНоваяСтрокаТЧ);
		КонецЕсли;
		
		СтрокаТабличнойЧастиВставки.ПробаФакт = Результат.ПробаФакт;
		СтрокаТабличнойЧастиВставки.ВесФакт = Результат.ВесФакт;
		СтрокаТабличнойЧастиВставки.ВесВПробеЧистотыФакт = Результат.ВесВПробеЧистотыФакт;
		СтрокаТабличнойЧастиВставки.СуммаОценкиФакт = Результат.СуммаОценкиФакт;
		СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт = Результат.ЕдиницаИзмерения;
		СтрокаТабличнойЧастиВставки.ЦенаФакт = Результат.ЦенаФакт;
		
		Если Результат.НоваяСтрокаТЧ Тогда
			СтрокаТабличнойЧастиВставки.ОбъектЗалога = Результат.ОбъектЗалога;
		КонецЕсли;
		
		СформироватьСтрокуОтклонения(ДопПараметры);
		Модифицированность = Истина;
		
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("ОбъектЗалога",СтрокаТабличнойЧастиТовары.ОбъектЗалога);

	Элементы[ДопПараметры.ВставкаМ].ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);

	ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор(), ДопПараметры.Основная, ДопПараметры);
	НайтиВставки(СформироватьСтруктуруТабличныхЧастей(ДопПараметры.Основная));

КонецПроцедуры 

&НаКлиенте
