&НаКлиенте
Процедура ПослеВыбораВставки(Результат, ДопПараметры) Экспорт  
	//+Мельников 23.05.24 Перенес ниже
	//Если Результат = неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	//-Мельников
	
	СтрокаТабличнойЧастиТовары = Элементы[ДопПараметры.Основная].ТекущиеДанные;
	СтрокаТабличнойЧастиВставки = Элементы[ДопПараметры.ВставкаК].ТекущиеДанные; 
	
	//Объект.ВставкиФакт.НайтиПоИдентификатору(Результат.ИДНоваяСтрокаТЧ)
	
	//+Мельников 21.05.24 Изменил на запись в фактические данные. Старое закомментировал.	
	//СтрокаТабличнойЧасти.Количество = Результат.Количество; 
	//СтрокаТабличнойЧасти.ВидВставки = Результат.ВидВставки;
	//СтрокаТабличнойЧасти.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения;
	//СтрокаТабличнойЧасти.ФормаОгранки = Результат.ФормаОгранки;
	//СтрокаТабличнойЧасти.ВидОгранки = Результат.ВидОгранки;
	//СтрокаТабличнойЧасти.КачествоОгранки = Результат.КачествоОгранки; 
	//СтрокаТабличнойЧасти.Диаметр = Результат.Диаметр;
	//СтрокаТабличнойЧасти.Диаметр1 = Результат.Диаметр1;
	//СтрокаТабличнойЧасти.Диаметр2 = Результат.Диаметр2; 
	//СтрокаТабличнойЧасти.Длина = Результат.Длина;  
	//СтрокаТабличнойЧасти.Ширина = Результат.Ширина;
	//СтрокаТабличнойЧасти.Высота = Результат.Высота;
	//СтрокаТабличнойЧасти.Вес = Результат.Вес; 
	//СтрокаТабличнойЧасти.ВесГраммы = Результат.ВесГраммы;
	//СтрокаТабличнойЧасти.ОписаниеРазмера = Результат.ОписаниеРазмера;  
	//СтрокаТабличнойЧасти.ЭтоВесовой = ПроверитьВесовой(СтрокаТабличнойЧасти.ЕдиницаИзмерения);

	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") И Результат.НоваяСтрокаТЧ И Результат.Отмена Тогда
		Если Элементы[ДопПараметры.ВставкаК].ТекущиеДанные <> Неопределено Тогда
			//+МАН 30.05.25 Изменил удаление пустой строки.
			//Объект[ДопПараметры.ВставкаК].Удалить(Элементы[ДопПараметры.ВставкаК].ТекущиеДанные.НомерСтроки - 1);
			Объект[ДопПараметры.ВставкаК].Удалить(Результат.ИДНоваяСтрокаТЧ);
			//-МАН
		КонецЕсли;
	Иначе
		Если Результат.НоваяСтрокаТЧ Тогда
			СтрокаТабличнойЧастиВставки = Объект[ДопПараметры.ВставкаК].НайтиПоИдентификатору(Результат.ИДНоваяСтрокаТЧ);
		КонецЕсли;
		
		//+Мельников 15.10.24 Добавил проверку на комплектующее Заявка 2464
		Если НЕ Результат.Свойство("Комплектующее") Тогда
			СтрокаТабличнойЧастиВставки.КоличествоФакт = Результат.КоличествоФакт;
			СтрокаТабличнойЧастиВставки.ВидВставкиФакт = Результат.ВидВставкиФакт;
			СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт = Результат.ЕдиницаИзмеренияФакт;
			СтрокаТабличнойЧастиВставки.ФормаОгранкиФакт = Результат.ФормаОгранкиФакт;
			СтрокаТабличнойЧастиВставки.ВидОгранкиФакт = Результат.ВидОгранкиФакт;
			СтрокаТабличнойЧастиВставки.КачествоОгранкиФакт = Результат.КачествоОгранкиФакт;
			СтрокаТабличнойЧастиВставки.ДиаметрФакт = Результат.ДиаметрФакт;
			СтрокаТабличнойЧастиВставки.Диаметр1Факт = Результат.Диаметр1Факт;
			СтрокаТабличнойЧастиВставки.Диаметр2Факт = Результат.Диаметр2Факт;
			СтрокаТабличнойЧастиВставки.ДлинаФакт = Результат.ДлинаФакт;
			СтрокаТабличнойЧастиВставки.ШиринаФакт = Результат.ШиринаФакт;
			СтрокаТабличнойЧастиВставки.ВысотаФакт = Результат.ВысотаФакт;
			//+МАН 25.03.25
			Если СтрокаТабличнойЧастиВставки.ВидВставкиФакт = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") Тогда
				СтрокаТабличнойЧастиВставки.ВесФакт = Результат.ВесФакт;
			Иначе
				СтрокаТабличнойЧастиВставки.ВесФакт = 0;
			КонецЕсли;
			//-МАН
			СтрокаТабличнойЧастиВставки.ВесГраммыФакт = Результат.ВесГраммыФакт;
			СтрокаТабличнойЧастиВставки.ОписаниеРазмера = Результат.ОписаниеРазмераФакт;
			СтрокаТабличнойЧастиВставки.ЭтоВесовойФакт = ПроверитьВесовой(СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт);
			СтрокаТабличнойЧастиВставки.НеОцениватьФакт = Результат.НеОцениватьФакт;
		//+Мельников 15.10.24 Заявка 2464	
		Иначе
			СтрокаТабличнойЧастиВставки.КоличествоФакт = Результат.КоличествоФакт;
			СтрокаТабличнойЧастиВставки.ВидВставкиФакт = Результат.ВидВставкиФакт;
			СтрокаТабличнойЧастиВставки.ЕдиницаИзмеренияФакт = Результат.ЕдиницаИзмеренияФакт;
			СтрокаТабличнойЧастиВставки.ВесГраммыФакт = Результат.ВесГраммыФакт;
			СтрокаТабличнойЧастиВставки.НеОцениватьФакт = Истина;
		КонецЕсли;
		//-Мельников
		
		Если Результат.НоваяСтрокаТЧ Тогда
			СтрокаТабличнойЧастиВставки.ОбъектЗалога = Результат.ОбъектЗалога;
			//+Мельников 17.10.24 Заявка 2464
			Если Результат.Свойство("Комплектующее") Тогда
				СтрокаТабличнойЧастиВставки.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Комплектующее");
			ИначеЕсли Результат.Свойство("Вставка") Тогда
				СтрокаТабличнойЧастиВставки.Вид = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыКомплектующихИзделия.Вставка");
			КонецЕсли;
			//-Мельников
		КонецЕсли;

		Если СтрокаТабличнойЧастиВставки.НеОцениватьФакт Тогда
			СтрокаТабличнойЧастиВставки.ЦенаФакт = 0;
			СтрокаТабличнойЧастиВставки.СуммаФакт = 0;
			ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор(), ДопПараметры.Основная, ДопПараметры);
		Иначе	
			ЦенаДрагоценногоКамня(СтрокаТабличнойЧастиВставки.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор(), ДопПараметры);
			ЦенаДрагоценногоМеталла(СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор(), ДопПараметры.Основная, ДопПараметры);
			
			//Если СтрокаТабличнойЧастиВставки.ЭтоВесовойФакт Тогда
			//	СтрокаТабличнойЧастиВставки.СуммаФакт = окр(СтрокаТабличнойЧастиВставки.ЦенаФакт * СтрокаТабличнойЧастиВставки.ВесФакт, 2);
			//Иначе
			//	СтрокаТабличнойЧастиВставки.СуммаФакт = окр(СтрокаТабличнойЧастиВставки.ЦенаФакт * СтрокаТабличнойЧастиВставки.КоличествоФакт, 2);
			//КонецЕсли;
		КонецЕсли;
		
		СформироватьСтрокуОтклонения(ДопПараметры);
		Модифицированность = Истина;

	КонецЕсли;

	//ПроверкаОценкиВставки(СтрокаТабличнойЧасти.ПолучитьИдентификатор(), СтрокаТабличнойЧастиТовары.ПолучитьИдентификатор());

	Отбор = Новый Структура;
	Отбор.Вставить("ОбъектЗалога",СтрокаТабличнойЧастиТовары.ОбъектЗалога);

	Элементы[ДопПараметры.ВставкаК].ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);

	НайтиВставки(СформироватьСтруктуруТабличныхЧастей(ДопПараметры.Основная));
	
КонецПроцедуры 

