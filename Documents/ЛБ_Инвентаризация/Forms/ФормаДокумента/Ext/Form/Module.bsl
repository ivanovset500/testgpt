&НаКлиенте
Процедура ОткрытьФормуДобавленияОЗ(ТЧ)
	
	НоваяСтрокаТЧ = Истина;
	
	НоваяСтрока = Объект.Товары.Добавить();
	Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();

	СтрокаТабличнойЧастиТовары = Элементы.Товары.ТекущиеДанные;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НоваяСтрокаТЧ", НоваяСтрокаТЧ); 
	ПараметрыФормы.Вставить("ИДНоваяСтрокаТЧ", НоваяСтрока.ПолучитьИдентификатор());
	ПараметрыФормы.Вставить("Ломбард", Объект.Ломбард);
	ПараметрыФормы.Вставить("ДатаИнвентаризации", НачалоДня(Объект.Дата));
	
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОЗ", ЭтаФорма, ТЧ);
	ОткрытьФорму("Документ.ЛБ_Инвентаризация.Форма.ФормаПоискаОЗ", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаСервере
Процедура УдалитьВставкиПоОЗ(ОбъектЗалога, ТЧ)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОбъектЗалога", ОбъектЗалога);
	
	МассивВставки = Объект[ТЧ.ВставкаК].НайтиСтроки(Отбор);
	МассивВставкиМеталла = Объект[ТЧ.ВставкаМ].НайтиСтроки(Отбор);
	
	Если МассивВставки.Количество() > 0 Тогда
		Для каждого СтрМ Из МассивВставки Цикл
			Объект[ТЧ.ВставкаК].Удалить(СтрМ.НомерСтроки - 1);
		КонецЦикла;
	КонецЕсли;

	Если МассивВставкиМеталла.Количество() > 0 Тогда
		Для каждого СтрМ Из МассивВставкиМеталла Цикл
			Объект[ТЧ.ВставкаМ].Удалить(СтрМ.НомерСтроки - 1);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Функция ПроверитьОЗНаНаличиеВТЧ(ОбъектЗалога)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОбъектЗалога", ОбъектЗалога);
	
	МассивОЗ = Объект.Товары.НайтиСтроки(Отбор);
	
	Если МассивОЗ.Количество() > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УдалитьПустуюСтрокуФильтра(Фильтр, Спр, НаименованиеСтолбца, Тип)

	Если Фильтр <> Неопределено И Спр <> Неопределено И НаименованиеСтолбца <> Неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить(НаименованиеСтолбца, ?(Тип = "Перечисление", Перечисления[Спр].ПустаяСсылка(), Справочники[Спр].ПустаяСсылка()));
		
		Стр = Объект[Фильтр].НайтиСтроки(Отбор);
		
		Если Стр.Количество() > 0 Тогда
			Объект[Фильтр].Удалить(Стр[0].НомерСтроки - 1);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

