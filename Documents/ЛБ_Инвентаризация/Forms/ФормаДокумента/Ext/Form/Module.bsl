		ПараметрыФормы.Вставить("ВидОгранки", СтрокаТабличнойЧастиВставки.ВидОгранки);
		ПараметрыФормы.Вставить("КачествоОгранки", СтрокаТабличнойЧастиВставки.КачествоОгранки); 
		ПараметрыФормы.Вставить("Диаметр", СтрокаТабличнойЧастиВставки.Диаметр);
		ПараметрыФормы.Вставить("Диаметр1", СтрокаТабличнойЧастиВставки.Диаметр1);
		ПараметрыФормы.Вставить("Диаметр2", СтрокаТабличнойЧастиВставки.Диаметр2); 
		ПараметрыФормы.Вставить("Длина", СтрокаТабличнойЧастиВставки.Длина);  
		ПараметрыФормы.Вставить("Ширина", СтрокаТабличнойЧастиВставки.Ширина);
		ПараметрыФормы.Вставить("Высота", СтрокаТабличнойЧастиВставки.Высота);
		ПараметрыФормы.Вставить("ВесКар", СтрокаТабличнойЧастиВставки.Вес);
		ПараметрыФормы.Вставить("Весграммы", СтрокаТабличнойЧастиВставки.ВесГраммы);
		ПараметрыФормы.Вставить("НеОценивать", СтрокаТабличнойЧастиВставки.НеОценивать);
		//Фактические
		ПараметрыФормы.Вставить("КатегорияОбъектаЗалогаФакт", СтрокаТабличнойЧастиТовары.КатегорияФакт); 
		ПараметрыФормы.Вставить("ИменникФакт", СтрокаТабличнойЧастиТовары.ИменникФакт);
		ПараметрыФормы.Вставить("КоличествоФакт", СтрокаТабличнойЧастиВставки.КоличествоФакт); 
