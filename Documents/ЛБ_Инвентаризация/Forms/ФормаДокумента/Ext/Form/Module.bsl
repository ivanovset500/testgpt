		Отказ = Истина;
	Иначе
		УдалитьВставкиПоОЗ(Элемент.ТекущиеДанные.ОбъектЗалога, СформироватьСтруктуруТабличныхЧастей("Товары"));
		ОбщееКоличествоОЗВДокументе();
	КонецЕсли;
