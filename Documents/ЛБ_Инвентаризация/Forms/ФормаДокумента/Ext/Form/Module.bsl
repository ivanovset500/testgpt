&НаКлиенте
Процедура ПроверитьДубли(ТЧ, Столбец, ВыбранноеЗначение)
	Отбор = Новый Структура;
	Отбор.Вставить(Столбец, ВыбранноеЗначение);
	
	НайденныеСтр = Объект[ТЧ].НайтиСтроки(Отбор);
	
	Если НайденныеСтр.Количество() > 0 Тогда
		Объект[ТЧ].Удалить(Объект[ТЧ].Количество() - 1);
	КонецЕсли;
КонецПроцедуры

