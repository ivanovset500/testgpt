&НаКлиенте
Процедура ЛомбардНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если Объект.Товары.Количество() > 0 ИЛИ Объект.МОЛы.Количество() > 0 ИЛИ Объект.ИнвентаризационнаяКомиссия.Количество() > 0 Тогда
		
		Ответ = Вопрос("При изменении ломбарда очистятся все списки с объектами залога, список МОЛ и список членов комиссии.
					   |Изменить ломбард?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Объект.Товары.Очистить();
			Объект.ВставкиФакт.Очистить();
			Объект.ВставкиМеталла.Очистить();
			Объект.НовыеОЗ.Очистить();
			Объект.ВставкиКамнейНовыеОЗ.Очистить();
			Объект.ВставкиМеталлаНовыеОЗ.Очистить();
			Объект.НаОХ.Очистить();
			Объект.ВставкиКамнейНаОХ.Очистить();
			Объект.ВставкиМеталлаНаОХ.Очистить();
			Объект.Изъятые.Очистить();
			Объект.ВставкиКамнейИзъятые.Очистить();
			Объект.ВставкиМеталлаИзъятые.Очистить();
			Объект.СумкаЗакрыта.Очистить();
			Объект.ВставкиКамнейСумкаЗакрыта.Очистить();
			Объект.ВставкиМеталлаСумкаЗакрыта.Очистить();
			Объект.МОЛы.Очистить();
			Объект.ИнвентаризационнаяКомиссия.Очистить();
			ЗаполнитьТЧ();
			ДобавитьМОЛ();
		Иначе
            СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

