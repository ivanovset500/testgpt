Процедура ЗаполнитьДокументНаКлиенте(НазваниеДействия)
	
	НоваяСтрокаТЧ = Ложь;

	Если ТекущийЭлемент.Имя = "Товары" ИЛИ ТекущийЭлемент.Имя = "ТоварыЗаполнитьПоОстаткам1" Тогда 
		//+МАН 22.11.24
		ЗаполнитьПоОстаткамОбъектовЗалога(Истина);
		//-МАН
	ИначеЕсли ТекущийЭлемент.Имя = "НовыеОЗ" Тогда
		//ЗаполнитьПоОстаткамНовыеОбъектыЗалога();
		ЗаполнитьПоОстаткамОбъектовЗалога(,,,,Истина);
	КонецЕсли;
		
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.ГруппаПроведениеИнвентаризации Тогда
		ТекущийЭлемент = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.ГруппаТовары;
		ТекСтр = СтрЗаменить(Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.ГруппаТовары.Имя, "Группа", "");
