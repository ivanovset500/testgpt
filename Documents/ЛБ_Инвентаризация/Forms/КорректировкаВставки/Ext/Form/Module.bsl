Функция УдалитьНули(Текст)
	Текст = СокрЛП(Текст);
	Пока Прав(Текст, 1) = "0" цикл
		Текст = Лев(Текст, стрДлина(Текст) - 1);
	Конеццикла;	
	Возврат Текст;
КонецФункции	

