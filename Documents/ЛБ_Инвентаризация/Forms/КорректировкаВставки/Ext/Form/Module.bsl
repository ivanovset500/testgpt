				Элементы.КачествоОгранкиФакт.СписокВыбора.Добавить(Выборка.КачествоОгранки);
			Иначе
				Элементы.КачествоОгранки.СписокВыбора.Добавить(Выборка.КачествоОгранки);
			КонецЕсли;
		Конеццикла;
	КонецЕсли;	 
