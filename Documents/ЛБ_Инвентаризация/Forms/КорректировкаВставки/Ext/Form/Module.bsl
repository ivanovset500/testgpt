			КонецЕсли;
		Конеццикла;
	Иначе    
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Владелец", ?(Факт, ВидВставкиФакт, ВидВставки));
		Запрос.Текст = "ВЫБРАТЬ
						|	ЛБ_КачествоОгранки.Ссылка КАК КачествоОгранки
						|ИЗ
						|	Справочник.ЛБ_КачествоОгранки КАК ЛБ_КачествоОгранки
						|ГДЕ
