		СписокВО.Добавить(Справочники.ЛБ_ВидыОгранки.ПустаяСсылка());
		
		Если ?(Факт, ЗначениеЗаполнено(ВидОгранкиФакт), ЗначениеЗаполнено(ВидОгранки)) Тогда
			СписокВО.Добавить(?(Факт, ВидОгранкиФакт, ВидОгранки));
