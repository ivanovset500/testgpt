&НаКлиенте
Перем Сохранить Экспорт;
  
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТолькоПросмотр") Тогда
		//+МАН 14.11.24 Добавлено условие. Заявка 2464
		Если Параметры.ТолькоПросмотр <> Неопределено Тогда
			Элементы.СохранитьИЗакрыть.Доступность = НЕ Параметры.ТолькоПросмотр;
		КонецЕсли;
		//-МАН
	КонецЕсли;
	
	Если Параметры.Свойство("ВидВставки") Тогда 
		ВидВставки = Параметры.ВидВставки;
	КонецЕсли;
	
	Если Параметры.Свойство("ФормаОгранки") Тогда 
		ФормаОгранки = Параметры.ФормаОгранки;
	КонецЕсли;
	
	Если Параметры.Свойство("ВидОгранки") Тогда 
		ВидОгранки = Параметры.ВидОгранки;
	КонецЕсли;
	
	Если Параметры.Свойство("КачествоОгранки") Тогда 
		КачествоОгранки = Параметры.КачествоОгранки;
	КонецЕсли;
	
	Если Параметры.Свойство("Диаметр") Тогда 
		Диаметр = Параметры.Диаметр;
	КонецЕсли; 
	
	Если Параметры.Свойство("Диаметр1") Тогда 
		Диаметр1 = Параметры.Диаметр1;
	КонецЕсли;
	
    Если Параметры.Свойство("Диаметр2") Тогда 
		Диаметр2 = Параметры.Диаметр2;
	КонецЕсли;
	
	Если Параметры.Свойство("Длина") Тогда 
		Длина = Параметры.Длина;
	КонецЕсли;
	
    Если Параметры.Свойство("Ширина") Тогда 
		Ширина1 = Параметры.Ширина;
	КонецЕсли;
	
    Если Параметры.Свойство("Высота") Тогда 
		Высота1 = Параметры.Высота;
	КонецЕсли;
	
	Если Параметры.Свойство("Сторона") Тогда 
		Сторона = Параметры.Сторона;
	КонецЕсли;
	
    Если Параметры.Свойство("Количество") Тогда 
		Количество = Параметры.Количество;
	КонецЕсли; 
	
	Если Параметры.Свойство("ВесКар") Тогда 
		Вес = Параметры.ВесКар;
		ВесШт = ?(Количество = 0, 0, Вес/Количество);
	КонецЕсли;
	
	Если Параметры.Свойство("ВесГраммы") Тогда 
		ВесГраммы = Параметры.ВесГраммы; 
		ВесГраммыШт = ?(Количество = 0, 0, ВесГраммы/Количество);
	КонецЕсли;
	
	Если Параметры.Свойство("Именник") Тогда 
		Именник = Параметры.Именник;
	КонецЕсли;
	
    Если Параметры.Свойство("КатегорияОбъектаЗалога") Тогда 
		КатегорияОбъектаЗалога = Параметры.КатегорияОбъектаЗалога;
	КонецЕсли;
	
	Если Параметры.Свойство("ВесВручную") Тогда 
		ВесВручную = Параметры.ВесВручную;
	КонецЕсли;
	
	Если Параметры.Свойство("НоваяСтрокаТЧ") Тогда 
		НоваяСтрока = Параметры.НоваяСтрокаТЧ;
	Иначе
		НоваяСтрока = Ложь;
	КонецЕсли;
	
	//+Мельников 20.05.24 Фактические данные
	Если Параметры.Свойство("ВидВставкиФакт") Тогда 
		ВидВставкиФакт = Параметры.ВидВставкиФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("ФормаОгранкиФакт") Тогда 
		ФормаОгранкиФакт = Параметры.ФормаОгранкиФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("ВидОгранкиФакт") Тогда 
		ВидОгранкиФакт = Параметры.ВидОгранкиФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("КачествоОгранкиФакт") Тогда 
		КачествоОгранкиФакт = Параметры.КачествоОгранкиФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("ДиаметрФакт") Тогда 
		ДиаметрФакт = Параметры.ДиаметрФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("Диаметр1Факт") Тогда 
		Диаметр1Факт = Параметры.Диаметр1Факт;
	КонецЕсли;
	
    Если Параметры.Свойство("Диаметр2Факт") Тогда 
		Диаметр2Факт = Параметры.Диаметр2Факт;
	КонецЕсли;
	
	Если Параметры.Свойство("ДлинаФакт") Тогда 
		ДлинаФакт = Параметры.ДлинаФакт;
	КонецЕсли;
	
    Если Параметры.Свойство("ШиринаФакт") Тогда 
		ШиринаФакт = Параметры.ШиринаФакт;
	КонецЕсли;
	
    Если Параметры.Свойство("ВысотаФакт") Тогда 
		ВысотаФакт = Параметры.ВысотаФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("СторонаФакт") Тогда 
		СторонаФакт = Параметры.СторонаФакт;
	КонецЕсли;
	
    Если Параметры.Свойство("КоличествоФакт") Тогда 
		КоличествоФакт = Параметры.КоличествоФакт;
	КонецЕсли;
	
	Если Параметры.Свойство("ВесФакт") Тогда 
		ВесФакт = Параметры.ВесФакт;
		ВесШтФакт = ?(КоличествоФакт = 0, 0, ВесФакт/КоличествоФакт);
	КонецЕсли;
	
	Если Параметры.Свойство("ВесГраммыФакт") Тогда 
		ВесГраммыФакт = Параметры.ВесГраммыФакт; 
		ВесГраммыШтФакт = ?(КоличествоФакт = 0, 0, ВесГраммыФакт/КоличествоФакт);
	КонецЕсли;
	
	Если Параметры.Свойство("ИменникФакт") Тогда 
		ИменникФакт = Параметры.ИменникФакт;
	КонецЕсли;
	
    Если Параметры.Свойство("КатегорияОбъектаЗалогаФакт") Тогда 
		КатегорияОбъектаЗалогаФакт = Параметры.КатегорияОбъектаЗалогаФакт;
	КонецЕсли;   

    Если Параметры.Свойство("ИДНоваяСтрокаТЧ") Тогда 
		ИДНоваяСтрокаТЧ = Параметры.ИДНоваяСтрокаТЧ;
	КонецЕсли;   

    Если Параметры.Свойство("ОбъектЗалога") Тогда 
		ОбъектЗалога = Параметры.ОбъектЗалога;
	КонецЕсли;   

	Если Параметры.Свойство("НеОценивать") Тогда 
		НеОценивать = Параметры.НеОценивать;
	КонецЕсли;   

	Если Параметры.Свойство("НеОцениватьФакт") Тогда 
		НеОцениватьФакт = Параметры.НеОцениватьФакт;
	КонецЕсли;   
	
	//+Мельников 17.10.24 Завяка 2464.
	Если Параметры.Свойство("ТЧ") Тогда
		ТЧВставкаК = Параметры.ТЧ.ВставкаК;
		ТЧВставкаМ = Параметры.ТЧ.ВставкаМ;
		ТЧОсновная = Параметры.ТЧ.Основная;
	КонецЕсли;

	Если Параметры.Свойство("ОбщаяМассаФакт") Тогда
		ОбщаяМассаФакт = Параметры.ОбщаяМассаФакт;
	КонецЕсли;
	//-Мельников
	
	//Если ЗначениеЗаполнено(ВидВставки) Тогда  
	//	ЕдиницаИзмерения = ПолучитьЕдиницуРасчета();
	//	ЗаполнитьСписокВыбораКачестваОгранки();
	//	ПроверитьФормуОгранки(, ФормаОгранки); 	
	//	ЗаполнитьСписокВыбораВидовОгранки();
	//КонецЕсли;
	
	//+Мельников 21.05.24
	Если ЗначениеЗаполнено(ВидВставкиФакт) Тогда
		ЕдиницаИзмеренияФакт = ПолучитьЕдиницуРасчета(Истина);
		ЗаполнитьСписокВыбораКачестваОгранки(Истина);
		ПроверитьФормуОгранки(Истина, ФормаОгранкиФакт);
		ЗаполнитьСписокВыбораВидовОгранки(Истина);
	КонецЕсли;
	УстановитьВидимость(Истина);
	ПолучитьСпособРасчетаВеса(Истина);
	УстановитьДоступность(Истина);
	//-Мельников
	
    УстановитьВидимость();
	ПолучитьСпособРасчетаВеса();
	УстановитьДоступность();   
	//+МАН 24.03.25 Закомментировал
	//Если СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоТаблице Тогда
	//	РассчитатьВесКамняПоТаблице();  
	//ИначеЕсли СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоФормуле Тогда
	//	РассчитатьВесКамняПоФормуле();  	
	//КонецЕсли;	

	////+Мельников 21.05.24
	//Если СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоТаблице Тогда
	//	РассчитатьВесКамняПоТаблице(Истина);  
	//ИначеЕсли СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоФормуле Тогда
	//	РассчитатьВесКамняПоФормуле(Истина);  	
	//КонецЕсли;	
	//-МАН
	//-Мельников

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Сохранить = Ложь;
КонецПроцедуры


//+Мельников 21.05.24 Добавлен параметр "Факт".
&НаСервере
Процедура УстановитьВидимость(Факт = Ложь)
	//Элементы.ГруппаД0.Видимость = Ложь; 
	//Элементы.ГруппаД1.Видимость = Ложь;
	//Элементы.ГруппаД2.Видимость = Ложь;
	//Элементы.ГруппаД.Видимость = Ложь;
	//Элементы.ГруппаШ.Видимость = Ложь;
	//Элементы.ГруппаВ.Видимость = Ложь; 
	//Элементы.ГруппаС.Видимость = Ложь;
	
	//+Мельников 21.05.24 Во всей процедуре добавлены проверки условия на "Факт" "?(".
	Если НоваяСтрока Тогда
		Элементы.ГруппаУчетныхДанных.Видимость = Ложь;
	КонецЕсли;
	
    Если Факт Тогда
		Элементы.ГруппаД0Факт.Видимость = Ложь; 
		Элементы.ГруппаД1Факт.Видимость = Ложь;
		Элементы.ГруппаД2Факт.Видимость = Ложь;
		Элементы.ГруппаДФакт.Видимость = Ложь;
		Элементы.ГруппаШФакт.Видимость = Ложь;
		Элементы.ГруппаВФакт.Видимость = Ложь; 
		Элементы.ГруппаСФакт.Видимость = Ложь;
		//+МАН 18.10.24
		Элементы.ГруппаДопФакт.Видимость = Ложь;
		Элементы.КачествоОгранкиФакт.Видимость = Ложь;
		//-МАН
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ВидКамня", ?(Факт, ВидВставкиФакт, ВидВставки)); 
	СписокФО = Новый СписокЗначений;
	СписокФО.Добавить(Справочники.ЛБ_ФормыОгранки.ПустаяСсылка());
	Если ?(Факт, ЗначениеЗаполнено(ФормаОгранкиФакт), ЗначениеЗаполнено(ФормаОгранки)) Тогда     
		СписокФО.Добавить(?(Факт, ФормаОгранкиФакт, ФормаОгранки));
	КонецЕсли;	
	Запрос.УстановитьПараметр("ФормаОгранки", СписокФО);
	Запрос.УстановитьПараметр("ВидОгранки", ?(Факт, ВидОгранкиФакт, ВидОгранки));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_НастройкаВыводаРазмеровДрагоценныхКамней.Размер КАК Размер
	               |ИЗ
	               |	РегистрСведений.ЛБ_НастройкаВыводаРазмеровДрагоценныхКамней КАК ЛБ_НастройкаВыводаРазмеровДрагоценныхКамней
	               |ГДЕ
	               |	ЛБ_НастройкаВыводаРазмеровДрагоценныхКамней.ВидКамня = &ВидКамня
	               |	И ЛБ_НастройкаВыводаРазмеровДрагоценныхКамней.ФормаОгранки В(&ФормаОгранки)
	               |	И ЛБ_НастройкаВыводаРазмеровДрагоценныхКамней.ВидОгранки = &ВидОгранки";
	ТаблицаРазмеров = Запрос.Выполнить().Выгрузить();
	Для каждого стр из ТаблицаРазмеров Цикл
		Если Факт Тогда
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Диаметр Тогда
				Элементы.ГруппаД0Факт.Видимость = Истина;  
			КонецЕсли;
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Диаметр1 Тогда
				Элементы.ГруппаД1Факт.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Диаметр2 Тогда
				Элементы.ГруппаД2Факт.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Длина Тогда
				Элементы.ГруппаДФакт.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Ширина Тогда
				Элементы.ГруппаШФакт.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Высота Тогда
				Элементы.ГруппаВФакт.Видимость = Истина;
			КонецЕсли;
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Сторона Тогда
				Элементы.ГруппаСФакт.Видимость = Истина;
			КонецЕсли;
		Иначе
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Диаметр Тогда
				Элементы.ГруппаД0.Видимость = Истина;  
			КонецЕсли;
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Диаметр1 Тогда
				Элементы.ГруппаД1.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Диаметр2 Тогда
				Элементы.ГруппаД2.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Длина Тогда
				Элементы.ГруппаД.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Ширина Тогда
				Элементы.ГруппаШ.Видимость = Истина;
			КонецЕсли;	
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Высота Тогда
				Элементы.ГруппаВ.Видимость = Истина;
			КонецЕсли;
			Если стр.Размер = Перечисления.ЛБ_РазмерыДрагоценныхКамней.Сторона Тогда
				Элементы.ГруппаС.Видимость = Истина;
			КонецЕсли;
		КонецЕсли;
	Конеццикла;	 
	
	Если Факт Тогда
		Если НЕ Элементы.ГруппаД0Факт.Видимость И НЕ (ДиаметрФакт = 0) Тогда 
			ДиаметрФакт = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаД1Факт.Видимость И НЕ (Диаметр1Факт = 0) Тогда
			Диаметр1Факт = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаД2Факт.Видимость И НЕ (Диаметр2Факт = 0) Тогда
			Диаметр2Факт = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаДФакт.Видимость И НЕ (ДлинаФакт = 0) Тогда 
			ДлинаФакт = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаШФакт.Видимость И НЕ (ШиринаФакт = 0) Тогда 
			ШиринаФакт = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаВФакт.Видимость И НЕ (ВысотаФакт = 0) Тогда 
			ВысотаФакт = 0;
		КонецЕсли;	
	    Если НЕ Элементы.ГруппаСФакт.Видимость И НЕ (СторонаФакт = 0) Тогда 
			СторонаФакт = 0;
		КонецЕсли;
	Иначе
		Если НЕ Элементы.ГруппаД0.Видимость И НЕ (Диаметр = 0) Тогда 
			Диаметр = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаД1.Видимость И НЕ (Диаметр1 = 0) Тогда
			Диаметр1 = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаД2.Видимость И НЕ (Диаметр2 = 0) Тогда
			Диаметр2 = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаД.Видимость И НЕ (Длина = 0) Тогда 
			Длина = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаШ.Видимость И НЕ (Ширина1 = 0) Тогда 
			Ширина1 = 0;
		КонецЕсли;	
		Если НЕ Элементы.ГруппаВ.Видимость И НЕ (Высота1 = 0) Тогда 
			Высота1 = 0;
		КонецЕсли;	
	    Если НЕ Элементы.ГруппаС.Видимость И НЕ (Сторона = 0) Тогда 
			Сторона = 0;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

//+Мельников 21.05.24 Добавлен параметр "Факт".
&НаСервере
Процедура УстановитьДоступность(Факт = Ложь) 
	//+Мельников 21.05.24 Добавлена проверка условия
	Если Факт Тогда
		
		Если СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную Тогда
			Элементы.ВесШтФакт.Доступность = Истина; 
			Элементы.ВесГраммыШтФакт.Доступность = Истина;
		Иначе
			Элементы.ВесШтФакт.Доступность = Ложь;
			Элементы.ВесГраммыШтФакт.Доступность = Ложь;
		КонецЕсли;
		
		Если СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоФормуле Тогда 
			Элементы.ГруппаФормулаФакт.Видимость = Истина;
		Иначе
			Элементы.ГруппаФормулаФакт.Видимость = Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидВставкиФакт) И НЕ ЗначениеЗаполнено(ФормаОгранкиФакт) И
			НЕ ЗначениеЗаполнено(ВидОгранкиФакт) И НЕ ЗначениеЗаполнено(КачествоОгранкиФакт) Тогда
			
			Элементы.ФормаОгранкиФакт.Доступность = Истина;
			Элементы.ВидОгранкиФакт.Доступность = Ложь;
			Элементы.КачествоОгранкиФакт.Доступность = Ложь;
			
		ИначеЕсли ЗначениеЗаполнено(ВидВставкиФакт) И ЗначениеЗаполнено(ФормаОгранкиФакт) И
			НЕ ЗначениеЗаполнено(ВидОгранкиФакт) И НЕ ЗначениеЗаполнено(КачествоОгранкиФакт) Тогда
			
			Элементы.ФормаОгранкиФакт.Доступность = Истина;
			Элементы.ВидОгранкиФакт.Доступность = Истина;
			Элементы.КачествоОгранкиФакт.Доступность = Ложь;
		
		ИначеЕсли ЗначениеЗаполнено(ВидВставкиФакт) И ЗначениеЗаполнено(ФормаОгранкиФакт) И
			ЗначениеЗаполнено(ВидОгранкиФакт) И НЕ ЗначениеЗаполнено(КачествоОгранкиФакт) Тогда
			
			Элементы.ФормаОгранкиФакт.Доступность = Истина;
			Элементы.ВидОгранкиФакт.Доступность = Истина;
			Элементы.КачествоОгранкиФакт.Доступность = Истина;
		КонецЕсли;
			
	Иначе
		
		Если СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную Тогда
			Элементы.ВесШт.Доступность = Истина; 
			Элементы.ВесГраммыШт.Доступность = Истина;
		Иначе
			Элементы.ВесШт.Доступность = ложь; 
			Элементы.ВесГраммыШт.Доступность = ложь;
		КонецЕсли;
		
		Если СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.ПоФормуле Тогда 
			Элементы.ГруппаФормула.Видимость = Истина;
		Иначе
			Элементы.ГруппаФормула.Видимость = ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		
		Элементы.ВесФакт.ТолькоПросмотр = Ложь;
		Элементы.ВесГраммыФакт.ТолькоПросмотр = Ложь;
		
		Если ЗначениеЗаполнено(ВидВставкиФакт) И ЗначениеЗаполнено(ФормаОгранкиФакт) И
			ЗначениеЗаполнено(ВидОгранкиФакт) Тогда //И ЗначениеЗаполнено(КачествоОгранкиФакт) Тогда
			
			Элементы.ГруппаДопФакт.Доступность = Истина;
		Иначе
			Элементы.ГруппаДопФакт.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//Элементы.ГруппаУчетныхДанных.Доступность = НЕ Элементы.ГруппаФактическихДанных.Доступность;
	
 	//Если вес вручную то размеры не видно
	Если ВесВручную Тогда
		Элементы.ГруппаРазмерыФакт.Доступность = Ложь;
	Иначе
		Элементы.ГруппаРазмерыФакт.Доступность = Истина;
	КонецЕсли;
	
	//Если вес вручную и категория 3 или 4 то доступен ввод общего веса в каратах
	Если ВесВручнуюФакт И КатегорияОбъектаЗалогаФакт.ПониженноеКачество Тогда
		Элементы.ВесФакт.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.ВесФакт.ТолькоПросмотр = Истина;
	КонецЕсли;

	//Доступность "Качество огранки" и других параметров.
	Если ЗначениеЗаполнено(ВидВставкиФакт) И ВидВставкиФакт = Справочники.ЛБ_ДрагоценныеКамни.Бриллиант Тогда
		Если Элементы.КачествоОгранкиФакт.СписокВыбора.Количество() > 0 Тогда
			Элементы.КачествоОгранкиФакт.Видимость = Истина;
			Элементы.ГруппаДопФакт.Видимость = Ложь;
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Ложь; //Видимость надписи если не заполнен "Вид огранки".
		ИначеЕсли ЗначениеЗаполнено(ВидВставкиФакт) И ВидВставкиФакт = Справочники.ЛБ_ДрагоценныеКамни.Бриллиант И 
			ЗначениеЗаполнено(ФормаОгранкиФакт) И ЗначениеЗаполнено(ВидОгранкиФакт) И
			Элементы.КачествоОгранкиФакт.СписокВыбора.Количество() = 0 Тогда
			
			Элементы.КачествоОгранкиФакт.Видимость = Ложь;
			Элементы.ГруппаДопФакт.Видимость = Истина;
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Ложь; //Видимость надписи если не заполнен "Вид огранки".
		Иначе			
			Элементы.КачествоОгранкиФакт.Видимость = Ложь;
			Элементы.ГруппаДопФакт.Видимость = Ложь;
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Истина; //Видимость надписи если не заполнен "Вид огранки".
		КонецЕсли;
		
		Если Элементы.КачествоОгранкиФакт.Видимость = Истина И ЗначениеЗаполнено(КачествоОгранкиФакт) Тогда
			Элементы.ГруппаДопФакт.Видимость = Истина;
		ИначеЕсли Элементы.КачествоОгранкиФакт.Видимость = Истина И НЕ ЗначениеЗаполнено(КачествоОгранкиФакт) Тогда
			Элементы.ГруппаДопФакт.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.ВесФакт.Видимость = Истина;
		Элементы.ВесШтФакт.Видимость = Истина;
		//+МАН 25.03.25
		Элементы.Вес.Видимость = Истина;
		Элементы.ВесШт.Видимость = Истина;
		//-МАН
		
	ИначеЕсли ЗначениеЗаполнено(ВидВставкиФакт) И ВидВставкиФакт <> Справочники.ЛБ_ДрагоценныеКамни.Бриллиант Тогда
		Если ЗначениеЗаполнено(ВидВставкиФакт) И ЗначениеЗаполнено(ФормаОгранкиФакт)
			И (Элементы.ВидОгранкиФакт.СписокВыбора.Количество() > 0 И ЗначениеЗаполнено(ВидОгранкиФакт)) Тогда
			Элементы.ГруппаДопФакт.Видимость = Истина;
		ИначеЕсли ЗначениеЗаполнено(ВидВставкиФакт) И ЗначениеЗаполнено(ФормаОгранкиФакт)
			И Элементы.ВидОгранкиФакт.СписокВыбора.Количество() = 0 Тогда
			Элементы.ГруппаДопФакт.Видимость = Истина;
		Иначе
			Элементы.ГруппаДопФакт.Видимость = Ложь;
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Истина; //Видимость надписи если не заполнен "Вид огранки".
		КонецЕсли;

		//Если ВесВручнуюФакт Тогда
		//	Элементы.Группа1Факт.Доступность = Истина;
		//	Элементы.ГруппаВес1Факт.Доступность = Истина;
		//	Элементы.ГруппаВес2Факт.Доступность = Истина;
		//Иначе
		//	Элементы.Группа1Факт.Доступность = Ложь;
		//	Элементы.ГруппаВес1Факт.Доступность = Ложь;
		//	Элементы.ГруппаВес2Факт.Доступность = Ложь;
		//КонецЕсли;

		Элементы.КачествоОгранкиФакт.Видимость = Ложь;
		Элементы.ВесФакт.Видимость = Ложь;
		Элементы.ВесШтФакт.Видимость = Ложь;
		//+МАН 25.03.25
		Элементы.Вес.Видимость = Ложь;
		Элементы.ВесШт.Видимость = Ложь;
		НеОцениватьФакт = Истина;
		Элементы.НеОцениватьФакт.Доступность = Ложь;
		//-МАН

		//Видимость надписи если не заполнен "Вид огранки".
		Если Элементы.ВидОгранкиФакт.СписокВыбора.Количество() > 0 И ЗначениеЗаполнено(ВидОгранкиФакт) Тогда
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Ложь;
		ИначеЕсли Элементы.ВидОгранкиФакт.СписокВыбора.Количество() > 0 И НЕ ЗначениеЗаполнено(ВидОгранкиФакт) Тогда
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Истина;
		ИначеЕсли Элементы.ВидОгранкиФакт.СписокВыбора.Количество() = 0 Тогда
			Элементы.ДекорацияВидОгранкиФакт.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ВесВручнуюФакт Тогда
		//Элементы.Группа1Факт.Доступность = Истина;
		Элементы.ГруппаВес1Факт.Доступность = Истина;
		Элементы.ГруппаВес2Факт.Доступность = Истина;
		Элементы.ГруппаРазмерыФакт.Доступность = Ложь;
	Иначе
		//Элементы.Группа1Факт.Доступность = Ложь;
		Элементы.ГруппаВес1Факт.Доступность = Ложь;
		Элементы.ГруппаВес2Факт.Доступность = Ложь;
		Элементы.ГруппаРазмерыФакт.Доступность = Истина;
	КонецЕсли;

Конецпроцедуры	

//+Мельников 21.05.24 Добавлен параметр "Факт".
&НаСервере
Процедура ПолучитьСпособРасчетаВеса(Факт = Ложь)  
	//+Мельников 21.05.24 Добавлена проверка условия
	Если Факт Тогда
		Если ВесВручнуюФакт Тогда
			ФормулаФакт = "";
			СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную;
		Иначе	
			Если ЗначениеЗаполнено(ВидОгранкиФакт) Тогда 
				Запрос = Новый Запрос;  
				Запрос.УстановитьПараметр("ВидКамня", ВидВставкиФакт); 
				Запрос.УстановитьПараметр("ФормаОгранки", ФормаОгранкиФакт); 
				Запрос.УстановитьПараметр("ВидОгранки", ВидОгранкиФакт);
			    Запрос.Текст = "ВЫБРАТЬ
			                   |	ЛБ_НастройкаДопустимыхВидовОгранки.Формула КАК Формула,
			                   |	ЛБ_НастройкаДопустимыхВидовОгранки.СпособРасчетаВеса КАК СпособРасчетаВеса
			                   |ИЗ
			                   |	РегистрСведений.ЛБ_НастройкаДопустимыхВидовОгранки КАК ЛБ_НастройкаДопустимыхВидовОгранки
			                   |ГДЕ
			                   |	ЛБ_НастройкаДопустимыхВидовОгранки.ВидКамня = &ВидКамня
			                   |	И ЛБ_НастройкаДопустимыхВидовОгранки.ФормаОгранки = &ФормаОгранки
			                   |	И ЛБ_НастройкаДопустимыхВидовОгранки.ВидОгранки = &ВидОгранки
			                   |АВТОУПОРЯДОЧИВАНИЕ";
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					ФормулаФакт = Выборка.Формула;
				    СпособРасчетаВесаФакт = Выборка.СпособРасчетаВеса; 
					Элементы.ДекорацияФормулаФакт.Заголовок = "Формула расчета веса: " + ФормулаФакт;
				Иначе 
					ФормулаФакт = "";
				    СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную;
				КонецЕсли;	
			Иначе        
				ФормулаФакт = "";
				СпособРасчетаВесаФакт = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную;
			КонецЕсли;   
		КонецЕсли;	
	Иначе
		Если ВесВручную Тогда
			Формула = "";
			СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную;
		Иначе	
			Если ЗначениеЗаполнено(ВидОгранки) Тогда 
				Запрос = Новый Запрос;  
				Запрос.УстановитьПараметр("ВидКамня", ?(Факт, ВидВставкиФакт, ВидВставки)); 
				Запрос.УстановитьПараметр("ФормаОгранки", ФормаОгранки); 
				Запрос.УстановитьПараметр("ВидОгранки", ВидОгранки);
			    Запрос.Текст = "ВЫБРАТЬ
			                   |	ЛБ_НастройкаДопустимыхВидовОгранки.Формула КАК Формула,
			                   |	ЛБ_НастройкаДопустимыхВидовОгранки.СпособРасчетаВеса КАК СпособРасчетаВеса
			                   |ИЗ
			                   |	РегистрСведений.ЛБ_НастройкаДопустимыхВидовОгранки КАК ЛБ_НастройкаДопустимыхВидовОгранки
			                   |ГДЕ
			                   |	ЛБ_НастройкаДопустимыхВидовОгранки.ВидКамня = &ВидКамня
			                   |	И ЛБ_НастройкаДопустимыхВидовОгранки.ФормаОгранки = &ФормаОгранки
			                   |	И ЛБ_НастройкаДопустимыхВидовОгранки.ВидОгранки = &ВидОгранки
			                   |АВТОУПОРЯДОЧИВАНИЕ";
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Формула = Выборка.Формула;
				    СпособРасчетаВеса = Выборка.СпособРасчетаВеса; 
					Элементы.ДекорацияФормула.Заголовок = "Формула расчета веса: " + Формула;
				Иначе 
					Формула = "";
				    СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную;
				КонецЕсли;	
			Иначе        
				Формула = "";
				СпособРасчетаВеса = Перечисления.ЛБ_СпособыРасчетаВесаДрагоценныхКамней.Вручную;
			КонецЕсли;   
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//+Мельников 21.05.24 Добавлен параметр "Факт".
&НаСервере
Процедура РассчитатьВесКамняПоТаблице(Факт = Ложь) 

	//+Мельников 07.10.24 Вставки. Заявка 2736. При изменении значения вначале приводим вес к нулю.
	ВесШтФакт = 0;
	ВесГраммыШтФакт = 0;
	ВесФакт = 0;
	ВесГраммыФакт = 0;
	//-Мельников

	//+Мельников 21.05.24 Добавлена проверка условия
	Если Факт Тогда
		Размер1Факт = 0;
		Если Элементы.ГруппаД0Факт.Видимость Тогда
			Размер1Факт = ДиаметрФакт;
		иначеЕсли Элементы.ГруппаДФакт.Видимость Тогда
			Размер1Факт = ДлинаФакт;
		иначеЕсли Элементы.ГруппаСФакт.Видимость Тогда
			Размер1Факт = СторонаФакт;
		КонецЕсли;	
		
		РезультатФакт = ЛБ_ОбщийМодуль.РассчитатьВесДрагоценногоКамня(ВидВставкиФакт, ФормаОгранкиФакт, ВидОгранкиФакт, КачествоОгранкиФакт, Размер1Факт, ШиринаФакт, ВысотаФакт); 
		
		Если НЕ РезультатФакт = неопределено Тогда
			Если РезультатФакт.ЕдиницаИзмерения.Код = "162" тогда
				ВесШтФакт = РезультатФакт.Вес;
				ВесГраммыШтФакт = ЛБ_ОбщегоНазначения.ПересчетИзКаратовВГраммы(ВесШтФакт);
			ИначеЕсли РезультатФакт.ЕдиницаИзмерения.Код = "163" тогда  
				ВесГраммыШтФакт = РезультатФакт.Вес;
				ВесШтФакт = ЛБ_ОбщегоНазначения.ПересчетИзГраммовВКараты(ВесГраммыШтФакт);
			КонецЕсли;
			РассчитатьОбщийВес(Истина);
		КонецЕсли;
	Иначе
		Размер1 = 0;
		Если Элементы.ГруппаД0.Видимость Тогда
			Размер1 = Диаметр;
		иначеЕсли Элементы.ГруппаД.Видимость Тогда
			Размер1 = Длина; 
		иначеЕсли Элементы.ГруппаС.Видимость Тогда
			Размер1 = Сторона;   		
		КонецЕсли;	
		Результат = ЛБ_ОбщийМодуль.РассчитатьВесДрагоценногоКамня(ВидВставки, ФормаОгранки, ВидОгранки, КачествоОгранки, Размер1, Ширина1, Высота1); 
		Если НЕ Результат = неопределено Тогда
			Если Результат.ЕдиницаИзмерения.Код = "162" тогда
				ВесШт = Результат.Вес;
				ВесГраммыШт = ЛБ_ОбщегоНазначения.ПересчетИзКаратовВГраммы(ВесШт);
			ИначеЕсли Результат.ЕдиницаИзмерения.Код = "163" тогда  
				ВесГраммыШт = Результат.Вес;
				ВесШт = ЛБ_ОбщегоНазначения.ПересчетИзГраммовВКараты(ВесГраммыШт);
			КонецЕсли;
			РассчитатьОбщийВес();
		КонецЕсли;
	КонецЕсли;
