Процедура РассчитатьВесКамняПоФормуле(Факт = Ложь)    

	//+Мельников 07.10.24 Вставки. Заявка 2736. При изменении значения вначале приводим вес к нулю.
	ВесШтФакт = 0;
	ВесГраммыШтФакт = 0;
	ВесФакт = 0;
	ВесГраммыФакт = 0;
	//-Мельников

	//+Мельников 21.05.24 Добавлена проверка условия
	Если Факт Тогда
		Если НЕ ПустаяСтрока(ФормулаФакт) Тогда
			ФормулаРасчетаФакт = ФормулаФакт;
			ЗначениеВесаФакт = ЛБ_УправлениеЛомбардом.РассчитатьПоФормуле(ФормулаРасчетаФакт, ДиаметрФакт, Диаметр1Факт, Диаметр2Факт, ДлинаФакт, ШиринаФакт, ВысотаФакт, СторонаФакт);
		Иначе
			ЗначениеВесаФакт = 0;
		КонецЕсли;
		
		Если ЕдиницаИзмеренияФакт.Код = "162" Тогда
			ВесШтФакт = ЗначениеВесаФакт;
			ВесГраммыШтФакт = ЛБ_ОбщегоНазначения.ПересчетИзКаратовВГраммы(ВесШтФакт);
		ИначеЕсли ЕдиницаИзмеренияФакт.Код = "163" Тогда
			ВесГраммыШтФакт = ЗначениеВесаФакт;
			ВесШтФакт = ЛБ_ОбщегоНазначения.ПересчетИзГраммовВКараты(ВесГраммыШтФакт);
		КонецЕсли;    
		РассчитатьОбщийВес(Истина);
	Иначе
		Если НЕ ПустаяСтрока(Формула) Тогда  
			ФормулаРасчета = Формула;
			ЗначениеВеса = ЛБ_УправлениеЛомбардом.РассчитатьПоФормуле(ФормулаРасчета, Диаметр, Диаметр1, Диаметр2, Длина, Ширина1, Высота1, Сторона);  
		Иначе  
			ЗначениеВеса = 0;
		КонецЕсли;	
		Если ЕдиницаИзмерения.Код = "162" тогда  
			ВесШт = ЗначениеВеса;   
			ВесГраммыШт = ЛБ_ОбщегоНазначения.ПересчетИзКаратовВГраммы(ВесШт);
		ИначеЕсли ЕдиницаИзмерения.Код = "163" тогда 
			ВесГраммыШт = ЗначениеВеса;
			ВесШт = ЛБ_ОбщегоНазначения.ПересчетИзГраммовВКараты(ВесГраммыШт);
		КонецЕсли;    
		РассчитатьОбщийВес();
	КонецЕсли;
КонецПроцедуры

