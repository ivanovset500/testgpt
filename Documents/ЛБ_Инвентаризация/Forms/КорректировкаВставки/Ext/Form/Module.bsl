	ВсеОК = Истина;
	Если НЕ ЗначениеЗаполнено(ВидВставкиФакт) Тогда
		Сообщить("Не выбран вид вставки");
		ВсеОК = Ложь;
	КонецЕсли;
	Если КоличествоФакт = 0 Тогда
		Сообщить("Не задано количество");
		ВсеОК = Ложь;
	КонецЕсли;
	//Если ВесГраммыФакт = 0 Тогда
	//	Сообщить("Не задан вес в каратах");
	//	ВсеОК = Ложь;
	//КонецЕсли;
	//Если ВесГраммыФакт = 0 Тогда
	//	Сообщить("Не задан вес в граммах");
	//	ВсеОК = Ложь;
	//КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ВидОгранкиФакт) И ВидВставкиФакт <> ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") Тогда
		Сообщить("Для расчета веса необходимо выбрать ""Вид огранки"".");
		ВсеОК = Ложь;
	КонецЕсли;

	//+Мельников 21.08.24 Изменена проверка заполнения элементов и вывод соответствующего сообщения. Заявка 2736
	Если (ВидВставкиФакт = ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И ВесШтФакт = 0)
		ИЛИ (ВидВставкиФакт <> ПредопределенноеЗначение("Справочник.ЛБ_ДрагоценныеКамни.Бриллиант") И ВесГраммыШтФакт = 0) Тогда
		
		Сообщить("Необходимо внести размеры вставки или указать вес вручную.");
		ВсеОК = Ложь;
	КонецЕсли;
	//-Мельников

	ДокументОбъект = ЭтотОбъект.ВладелецФормы.Объект;
	
	Если ПроверитьОбщийВес(ДокументОбъект) Тогда
		Сообщить("Общий вес изделия не может быть меньше общего веса вставки/ доп.металла/ комплектующего!");
		ВсеОК = Ложь;
	КонецЕсли;

	Возврат ВсеОК;

КонецФункции

&НаСервере
Функция ПроверитьОбщийВес(ДокументОбъект)
	Отбор = Новый Структура;
	Отбор.Вставить("ОбъектЗалога", ОбъектЗалога);
	
	СтрокиВ = ДокументОбъект[ТЧВставкаК].НайтиСтроки(Отбор);
	
	ВесК = 0;
	ВесМ = 0;
		
	Для каждого СтрВК Из СтрокиВ Цикл
		ВесК = ВесК + СтрВК.ВесГраммыФакт;
	КонецЦикла;

	СтрокиВМ = ДокументОбъект[ТЧВставкаМ].НайтиСтроки(Отбор);
	
	Для каждого СтрВМ Из СтрокиВМ Цикл
		ВесМ = ВесМ + СтрВМ.ВесФакт;
	КонецЦикла;
	
	ВесК = ВесК - ВесГраммы + ВесГраммыФакт;

	Результат = ?(Цел((ОбщаяМассаФакт - (ВесК + ВесМ))*100)/100 <= 0, Истина, Ложь);

	Возврат Результат;
КонецФункции

