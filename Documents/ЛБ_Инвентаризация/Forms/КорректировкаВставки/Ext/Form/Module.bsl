&НаКлиенте
Функция ПроверитьНаличиеИзменений()
	Для каждого Элем Из ЭтаФорма.Элементы Цикл
		Если ТипЗнч(Элем) = Тип("ПолеФормы") Тогда
			
			ЭлементФакт = СтрНайти(Элем.Имя, "Факт");
			
			Если ЭлементФакт = 0 Тогда
				Если ЭтотОбъект[Элем.Имя] <> ЭтотОбъект[Элем.Имя + "Факт"] Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции
