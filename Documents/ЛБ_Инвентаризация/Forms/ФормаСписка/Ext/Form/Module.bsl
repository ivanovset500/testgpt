	Если СкладВитрина Тогда
		Если Элементы.Список.ТекущиеДанные.ТипИнвентаризации = ПредопределенноеЗначение("Перечисление.ЛБ_ТипИнвентаризации.Инвентаризация") Тогда
			Элементы.ФормаПечатьИНВ8.Видимость = Истина;
			Элементы.ФормаПечатьИНВ8Черновик.Видимость = Истина;
