&НаКлиенте
Процедура ВыбратьОЗ(Команда)
	Если ОбъектыЗалога.Количество() > 0 Тогда
		ОкончаниеВыбораОЗ();
	Иначе
		Сообщить("Не выбран объект залога");
		Возврат
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЗалогаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ОбъектыЗалога.Количество() > 0 Тогда
		ОкончаниеВыбораОЗ();
	Иначе
		Сообщить("Не выбран объект залога");
		Возврат
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВыбораОЗ()

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Отмена", Ложь);
	СтруктураВозврата.Вставить("НоваяСтрокаТЧ", НоваяСтрока);
	СтруктураВозврата.Вставить("ИДНоваяСтрокаТЧ", ИДНоваяСтрока);
	//Элементы.ОбъектыЗалога.ТекущаяСтрока = 1;
	СтруктураВозврата.Вставить("ОбъектЗалога", Элементы.ОбъектыЗалога.ТекущиеДанные.ОбъектЗалога);
	
	Этаформа.Закрыть(?(НоваяСтрока, СтруктураВозврата, Неопределено));
	
КонецПроцедуры

&НаКлиенте
Процедура НомерПриИзменении(Элемент)
	
	НайтиОЗПоАртикулу();
	
	Если ОбъектыЗалога.Количество() > 0 Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.ОбъектыЗалога;
		ЭтаФорма.ТекущийЭлемент.ТекущаяСтрока = 0;
		
		//ОбъектShell = Новый COMОбъект("Wscript.Shell");
		//ОбъектShell.SendKeys("{DOWN}");
	КонецЕсли;
КонецПроцедуры
