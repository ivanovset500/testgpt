&НаКлиенте
Процедура Заполнить(Команда) Экспорт  
	
	Если Объект.ДанныеОВремени.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'");
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьИзГрафикаЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, Заголовок);
	Иначе
		ЗаполнитьСотрудникамиОрганизацииНаСервере(); 
	КонецЕсли;
	
КонецПроцедуры

