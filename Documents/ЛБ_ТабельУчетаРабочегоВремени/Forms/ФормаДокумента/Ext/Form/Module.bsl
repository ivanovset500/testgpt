&НаСервере
Функция ЗаполнитьСотрудникамиОрганизацииНаСервере()
	Объект.ДанныеОВремени.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтделенияЛомбардовСрезПоследних.Ломбард КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтделенияЛомбардов.СрезПоследних(
	               |			&НаДату,
	               |			Отделение = &Отделение
	               |				И Ломбард.Закрыт = ЛОЖЬ) КАК ЛБ_ОтделенияЛомбардовСрезПоследних"; 
	Запрос.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос.УстановитьПараметр("Отделение", Объект.Отделение);

	тз = Запрос.Выполнить().Выгрузить(); 
	массивЛомб = тз.ВыгрузитьКолонку("Ссылка");
	
				   
	
	Запрос2 = Новый Запрос;

	Запрос2.Текст = "ВЫБРАТЬ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Ломбард
	                |ИЗ
	                |	РегистрСведений.ЛБ_КадроваяИсторияСотрудников.СрезПоследних(&НаДату, ) КАК ЛБ_КадроваяИсторияСотрудниковСрезПоследних
	                |ГДЕ
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение В(&Подразделение)
	                |	И ЛБ_КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> &ВидСобытия
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Сотрудник,
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ЛБ_КадроваяИсторияСотрудниковСрезПоследних.Подразделение.НомерЛомбарда";
	Запрос2.УстановитьПараметр("НаДату", Объект.Дата);
	Запрос2.УстановитьПараметр("Подразделение", массивЛомб); 
	Запрос2.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение);
	

	
	Выборка = Запрос2.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтроч = Объект.ДанныеОВремени.Добавить();
		НовСтроч.Сотрудник = Выборка.Сотрудник;
		НовСтроч.Ломбард   = Выборка.Ломбард;		
	КонецЦикла; 	
КонецФункции

Функция НеявкаСотрудника(Сотр, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛБ_СостоянияСотрудников.Сотрудник КАК Сотрудник,
	|	ЛБ_СостоянияСотрудников.Период КАК НачалоНеявки,
	|	ЛБ_СостоянияСотрудников.ДействуетДо КАК КонецНеявки,
	|	ЛБ_СостоянияСотрудников.ВидВремени КАК ВидВремени
	|ИЗ
	|	РегистрСведений.ЛБ_СостоянияСотрудников КАК ЛБ_СостоянияСотрудников
	|ГДЕ
	|	ЛБ_СостоянияСотрудников.Сотрудник = &Сотрудник
	|	И ЛБ_СостоянияСотрудников.Период <= &НачалоНеявки
	|	И ЛБ_СостоянияСотрудников.ДействуетДо >= &КонецНеявки";  
	
	Запрос.УстановитьПараметр("Сотрудник", Сотр); 
	Запрос.УстановитьПараметр("НачалоНеявки", НачалоДня(Дата)); 
	Запрос.УстановитьПараметр("КонецНеявки", КонецДня(Дата));
	
	тз = Запрос.Выполнить().Выгрузить();
	
	Возврат тз;		
КонецФункции

Функция ВернутьДатуУвольненияСотрудника(Сотр, НачДата, КонДата)
	
	ЗапросУв = Новый Запрос;
	ЗапросУв.Текст = "ВЫБРАТЬ
	|	ЛБ_КадроваяИсторияСотрудников.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЛБ_КадроваяИсторияСотрудников КАК ЛБ_КадроваяИсторияСотрудников
	|ГДЕ
	|	ЛБ_КадроваяИсторияСотрудников.ВидСобытия = &ВидСобытия
	|	И ЛБ_КадроваяИсторияСотрудников.Период МЕЖДУ &НачДата И &КонДата
	|	И ЛБ_КадроваяИсторияСотрудников.Сотрудник = &Сотрудник";
	
	ЗапросУв.УстановитьПараметр("НачДата",    НачДата);
	ЗапросУв.УстановитьПараметр("КонДата",    КонДата); 
	ЗапросУв.УстановитьПараметр("Сотрудник",  Сотр);
	ЗапросУв.УстановитьПараметр("ВидСобытия", Перечисления.ЛБ_ВидыКадровыхСобытий.Увольнение); 
	
	ДатаУвольнения = Неопределено;
	
	ВыборкаУв = ЗапросУв.Выполнить().Выбрать();
	Если ВыборкаУв.Следующий() Тогда
		ДатаУвольнения = ВыборкаУв.Период;
	КонецЕсли;
	
	Возврат ДатаУвольнения;
КонецФункции


&НаСервере
Процедура ЗаполнитьПервоначальныеДанныеПоСотруднику() 
	ИдентификаторСтроки = ЭтаФорма.Элементы.ДанныеОВремени.ТекущаяСтрока;
	ТекСтр = Объект.ДанныеОВремени.НайтиПоИдентификатору(ИдентификаторСтроки); 
	КоличествоДнейвМесяце = День(КонецМесяца(Объект.ПериодРегистрации)); 
	
	Если ЗначениеЗаполнено(ТекСтр.Сотрудник) и ЗначениеЗаполнено(ТекСтр.Ломбард) Тогда  
		
		ДатаУвольнения = ВернутьДатуУвольненияСотрудника(ТекСтр.Сотрудник, Объект.ДатаНачалаПериода, КонецДня(Объект.ДатаОкончанияПериода));
  		
		ВидВремени_Выходной = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.ВыходныеДни;  
		ВидВремени_Увольнение = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Увольнение; 	
		
		Для номерДня = 1 по КоличествоДнейвМесяце Цикл 
			промДата = Объект.ПериодРегистрации + (номерДня-1)*86400; 
			
			ТекСтр["ВидВремени"+СокрЛП(номерДня)] = "";
			ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = ""; 
			ТекСтр["Часов"+СокрЛП(номерДня)] = 0; 	
			
			
			//отбВых = Новый Структура;
			//отбВых.Вставить("Ломбард", ТекСтр.Ломбард);
			//отбВых.Вставить("Период", промДата);
			//
			//найдСтрВых = тзВых.НайтиСтроки(ОтбВых);
			//Если найдСтрВых.Количество() > 0 Тогда  
			//	ТекСтр["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Выходной;
			//	ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Выходной, 0, "");
			//КонецЕсли;
			
			
			тзНеявка = НеявкаСотрудника(ТекСтр.Сотрудник, промДата); 
			Если тзНеявка.Количество() > 0 Тогда 			
				Для каждого стр из тзНеявка Цикл
					ТекСтр["ВидВремени"+СокрЛП(номерДня)] = стр.ВидВремени; 
					ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(стр.ВидВремени, 0, "");
				КонецЦикла;	
			КонецЕсли;  
			
			Если ДатаУвольнения <> Неопределено Тогда
				Если промДата >= ДатаУвольнения Тогда 
					ТекСтр["ВидВремени"+СокрЛП(номерДня)] = ВидВремени_Увольнение;
					ТекСтр["ВремяПредставление"+СокрЛП(номерДня)] = СформироватьПредставлениеВремени(ВидВремени_Увольнение, 0, "");
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла; 

		      		
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛБ_ПротоколРаботы.Сотрудник КАК Сотрудник,
		               |	ЛБ_ПротоколРаботы.Дата КАК ДатаВремя,
		               |	ЛБ_ПротоколРаботы.Ломбард КАК Ломбард,
		               |	ЛБ_ПротоколРаботы.Действие КАК Действие,
		               |	НАЧАЛОПЕРИОДА(ЛБ_ПротоколРаботы.Дата, ДЕНЬ) КАК Дата
		               |ИЗ
		               |	РегистрСведений.ЛБ_ПротоколРаботы КАК ЛБ_ПротоколРаботы
		               |ГДЕ
		               |	ЛБ_ПротоколРаботы.Сотрудник = &Сотрудник
		               |	И ЛБ_ПротоколРаботы.Дата МЕЖДУ &НачДата И &КонДата
		               |	И ЛБ_ПротоколРаботы.Ломбард = &Ломбард
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ДатаВремя";
		Запрос.УстановитьПараметр("Сотрудник", ТекСтр.Сотрудник); 
		Запрос.УстановитьПараметр("Ломбард",   ТекСтр.Ломбард); 
		Запрос.УстановитьПараметр("НачДата",   Объект.ДатаНачалаПериода);
		Запрос.УстановитьПараметр("КонДата",   КонецДня(Объект.ДатаОкончанияПериода));
		
		тзПротокол = Запрос.Выполнить().Выгрузить(); 
		
		тзДни = тзПротокол.Скопировать();
		тзДни.Свернуть("Дата");
		тзДни.Сортировать("Дата Возр");
		
		Для каждого стрДни из тзДни Цикл 
			минут = 0;
			ДанныеРабДни = ВернутьДанныеПоРабочимДнямЛомбарда(стрДни.Дата, ТекСтр.Ломбард);
			Если ДанныеРабДни <> Неопределено Тогда	
				НачДня = ДанныеРабДни.Начало;
				КонДня  = ДанныеРабДни.Окончание;
				ПерерывНачало = ДанныеРабДни.ПерерывНачало; 
				ПерерывОкончание = ДанныеРабДни.ПерерывОкончание;
				
				Для каждого стрТЗ из тзПротокол Цикл					
					Если стрТЗ.Действие = Перечисления.ЛБ_ДействияПользователя.Вход Тогда
						ДатаВремяВхода = НачалоДня(стрТЗ.Дата) + (НачДня - НачалоДня(НачДня));  
						Если стрТЗ.ДатаВремя < ДатаВремяВхода Тогда
							ДатаОтсчета = ДатаВремяВхода;
						Иначе
							ДатаОтсчета = стрТЗ.ДатаВремя;
						КонецЕсли;								
					КонецЕсли;					
					Если стрТЗ.Действие = Перечисления.ЛБ_ДействияПользователя.Выход Тогда 
						ДатаВремяОкончанияГрафик = НачалоДня(стрТЗ.Дата) + (КонДня - НачалоДня(КонДня)); 
						Если стрТЗ.ДатаВремя > ДатаВремяОкончанияГрафик Тогда
							минут = минут + (ДатаВремяОкончанияГрафик - ДатаОтсчета)/60;
						Иначе
							минут = минут + (стрТЗ.ДатаВремя - ДатаОтсчета)/60;
						КонецЕсли;
					КонецЕсли;					
				КонецЦикла;
				
				Если ЗначениеЗаполнено(ПерерывНачало) и ЗначениеЗаполнено(ПерерывОкончание) Тогда
					минут = минут - (ПерерывОкончание - ПерерывНачало)/60;					
				КонецЕсли;
						
				
				НомерДня = СокрЛП(День(стрДни.Дата)); 
							
				
				Половинки = минут/30;
				ОкрПоловинки = Окр(Половинки,0);
				Часов = ОкрПоловинки/2;				
								
				ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка;
				Территория = "";
				
				ТекСтр["Часов"+НомерДня] 		= Часов; 
				ТекСтр["ВидВремени"+НомерДня] 	= ВидВремени;
				ТекСтр["Территория"+НомерДня] 	= Территория;
				ТекСтр["ВремяПредставление"+НомерДня] 	= СформироватьПредставлениеВремени(ВидВремени, Часов, Территория);  
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ВернутьДанныеПоРабочимДнямЛомбарда(Дата, Ломбард)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_РабочиеДниЛомбарда.Период КАК Период,
	               |	ЛБ_РабочиеДниЛомбарда.Ломбард КАК Ломбард,
	               |	ЛБ_РабочиеДниЛомбарда.Начало КАК Начало,
	               |	ЛБ_РабочиеДниЛомбарда.Окончание КАК Окончание,
	               |	ЛБ_РабочиеДниЛомбарда.ПерерывНачало КАК ПерерывНачало,
	               |	ЛБ_РабочиеДниЛомбарда.ПерерывОкончание КАК ПерерывОкончание,
	               |	ЛБ_РабочиеДниЛомбарда.РабочиеМинуты КАК РабочиеМинуты,
	               |	ЛБ_РабочиеДниЛомбарда.Выходной КАК Выходной,
	               |	ЛБ_РабочиеДниЛомбарда.ДеньНедели КАК ДеньНедели,
	               |	ЛБ_РабочиеДниЛомбарда.НомерДня КАК НомерДня,
	               |	ЛБ_РабочиеДниЛомбарда.Приказ КАК Приказ
	               |ИЗ
	               |	РегистрСведений.ЛБ_РабочиеДниЛомбарда КАК ЛБ_РабочиеДниЛомбарда
	               |ГДЕ
	               |	ЛБ_РабочиеДниЛомбарда.Период = &Период
	               |	И ЛБ_РабочиеДниЛомбарда.Ломбард = &Ломбард";
	Запрос.УстановитьПараметр("Ломбард", Ломбард);
	Запрос.УстановитьПараметр("Период", НачалоДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Структ = Новый Структура;
		Структ.Вставить("Начало", Выборка.Начало);
		Структ.Вставить("Окончание", Выборка.Окончание);
		Структ.Вставить("ПерерывНачало", Выборка.ПерерывНачало); 
		Структ.Вставить("ПерерывОкончание", Выборка.ПерерывОкончание);
		Структ.Вставить("РабочиеМинуты", Выборка.РабочиеМинуты);
		Структ.Вставить("Выходной", Выборка.Выходной); 
		
		Возврат Структ;
	КонецЕсли;
	
	Возврат Неопределено;	
КонецФункции 

