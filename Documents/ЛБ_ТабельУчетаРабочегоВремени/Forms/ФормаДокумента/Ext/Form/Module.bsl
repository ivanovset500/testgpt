&НаКлиенте
Процедура ДанныеОВремениВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если СтрНайти(Поле.Имя, "ВремяПредставление") > 0 Тогда
		НомерДня = СтрЗаменить(Поле.Имя, "ВремяПредставление", "");
		
    	ТекСтрока = Элементы.ДанныеОВремени.ТекущиеДанные;  
    	ПараметрыФормы = Новый Структура;
    	ПараметрыФормы.Вставить("Сотрудник", 	ТекСтрока.Сотрудник);
    	ПараметрыФормы.Вставить("Часов", 		ТекСтрока["Часов"+НомерДня]); 
    	ПараметрыФормы.Вставить("ВидВремени", 	ТекСтрока["ВидВремени"+НомерДня]); 
    	ПараметрыФормы.Вставить("Территория", 	ТекСтрока["Территория"+НомерДня]);
		ПараметрыФормы.Вставить("НомерДня", 	НомерДня);  
		ПараметрыФормы.Вставить("ДатаРаботы",   (Объект.ПериодРегистрации + НомерДня-1)*86400);
		ПараметрыФормы.Вставить("Ломбард",      ТекСтрока.Ломбард); 
		ПараметрыФормы.Вставить("ПолучитьЧасыИзГрафика",     Ложь); 
				               
    	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеОкончанииРедактированияДанныхОВремени", ЭтотОбъект);
    	ОткрытьФорму("ОбщаяФорма.ЛБ_РедактированиеДанныхУчетаВремениЗаДень", Параметрыформы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПослеОкончанииРедактированияДанныхОВремени(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;  
	
	НомерДня = Результат.НомерДня;
	ТекСтрока = Элементы.ДанныеОВремени.ТекущиеДанные;
	ТекСтрока["Часов"+НомерДня] 				= Результат.Часов; 
	ТекСтрока["ВидВремени"+НомерДня] 			= Результат.ВидВремени;
	ТекСтрока["Территория"+НомерДня] 			= Результат.Территория;
	ТекСтрока["ВремяПредставление"+НомерДня] 	= СформируйПредставлениеВремени(Результат.ВидВремени, Результат.Часов, Результат.Территория);

	
КонецПроцедуры 

&НаСервере
Функция СформируйПредставлениеВремени(ВидВремени, Часов, Территория)
	Возврат ЛБ_ОбщегоНазначения.СформироватьПредставлениеВремени(ВидВремени, Часов, Территория);
КонецФункции 

Функция СформироватьПредставлениеВремени(ВидВремени, Часов, Территория)
	Рез = "";
	Если ЗначениеЗаполнено(ВидВремени) Тогда
		Если ВидВремени = Справочники.ЛБ_ВидыИспользованияРабочегоВремени.Явка Тогда
			Если Часов > 0 Тогда
				Рез = СокрЛП(Часов);
			КонецЕсли;
		Иначе
			Рез = СокрЛП(ВидВремени.БуквенныйКод);
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Территория) Тогда
			Рез = Рез +" "+"л"+СокрЛП(Территория.НомерЛомбарда);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рез;	
КонецФункции


&НаКлиенте
Процедура ДанныеОВремениСотрудник1ПриИзменении(Элемент)
	ТекСтр = Элементы.ДанныеОВремени.ТекущиеДанные; 
	Ошибка = Ложь; 
	
	Для каждого стр из Объект.ДанныеОВремени Цикл
		Если стр <> ТекСтр и ТекСтр.Ломбард = Стр.Ломбард и ТекСтр.Сотрудник = Стр.Сотрудник Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Сотрудник указан дважды в одном ломбарде";   
			Сообщение.Поле = "Объект.ДанныеОВремени["+СокрЛП(Стр.НомерСтроки-1)+"].Сотрудник";
			Сообщение.Сообщить(); 
		
			Ошибка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Ошибка Тогда
		Объект.ДанныеОВремени.Удалить(Элементы.ДанныеОВремени.ТекущиеДанные.НомерСтроки - 1);
	Иначе
		ЗаполнитьПервоначальныеДанныеПоСотруднику();
	КонецЕсли;

КонецПроцедуры




