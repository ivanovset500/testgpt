&НаСервере
Процедура ОтменитьПроведение()  
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
	ЭтаФорма.ТолькоПросмотр = Ложь;
	ОтменитьПроведение();
	УстановитьСтатусДокумента(); 
	ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаРедактировать.Видимость = Ложь;  
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.Инкассация") ИЛИ
	     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.Недостача") Тогда 
        Если ЗначениеЗаполнено(Объект.Контрагент) Тогда 
		   Элементы.Контрагент.ТолькоПросмотр = Истина; 
		   Элементы.Выдано.ТолькоПросмотр = Истина;
	   КонецЕсли;	   
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяИнформацияПриИзменении(Элемент) 
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаДляЗачисленияНаКорпоративнуюКарту") ИЛИ
		 Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаДляСдачиНаРасчетныйСчет") ИЛИ
		 Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ЛБ_ВидыОперацийРКО.ВыдачаПодОтчет") Тогда
	    Объект.Приложение = Объект.ДополнительнаяИнформация;  
	КонецЕсли;	
КонецПроцедуры

//+МАН Выведена нестандартная кнопка печати. Заявка 2936
&НаКлиенте
Процедура Печать(Команда)
	Если Объект.Проведен Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИменаМакетов", "РКО"); 
		ПараметрыФормы.Вставить("ИмяМенеджераПечати", "Документ.ЛБ_РасходныйКассовыйОрдер");
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		ПараметрыФормы.Вставить("ПараметрКоманды", МассивОбъектов);
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыФормы, ЭтаФорма,,,,,); 
	Иначе
		Предупреждение("Печать непроведенного документа запрещена!");
	КонецЕсли;	
КонецПроцедуры
