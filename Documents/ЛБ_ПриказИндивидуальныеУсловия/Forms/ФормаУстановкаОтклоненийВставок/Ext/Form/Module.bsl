&НаКлиенте
Функция ПроверитьЗаполнениеТЧ()
	
	Результат = Новый Структура;
	Результат.Вставить("Заполнено", Истина);
	
	//+МАН 20.03.25
	Текст = "";
	//-МАН
	
	Ном = 1;
	Для каждого Стр Из НастройкаОтклонения Цикл
		Если НЕ ЗначениеЗаполнено(Стр.ВидВставки) Тогда
			//+МАН 20.03.25
			//Было: Текст = "В строке № " + Ном + " не выбрана вставка.";
			Текст = Текст + "В строке № " + Ном + " не выбрана вставка." + Символы.ПС;
			//-МАН
			Результат.Вставить("Заполнено", Ложь);
			Результат.Вставить("Текст", Текст);
			//Было: Возврат Результат;
		КонецЕсли;
			
		//+МАН 19.02.25 Заявка 2792
		Если НЕ ЗначениеЗаполнено(Стр.ОтклонениеОтБазовойЦены) Тогда
			//+МАН 20.03.25
			//Было: Текст = "В строке № " + Ном + " не заполнен вид отклонения.";
			Текст = Текст + "В строке № " + Ном + " не заполнен вид отклонения." + Символы.ПС;
			//-МАН
			Результат.Вставить("Заполнено", Ложь);
			Результат.Вставить("Текст", Текст);
			//Было: Возврат Результат;
		КонецЕсли;
		//-МАН
		
		Если НЕ ЗначениеЗаполнено(Стр.ЗначениеОтклонения) Тогда
			//+МАН 20.03.25
			//Было: Текст = "В строке № " + Ном + " не заполнено значние отклонения.";
			Текст = Текст +  "В строке № " + Ном + " не заполнено значние отклонения." + Символы.ПС;
			//-МАН
			Результат.Вставить("Заполнено", Ложь);
			Результат.Вставить("Текст", Текст);
			//Было: Возврат Результат;
		КонецЕсли;
		
		Ном = Ном + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НастройкаОтклоненияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекСтрокаН = Элементы.НастройкаОтклонения.ТекущиеДанные;
	Если НоваяСтрока Тогда 
		ТекСтрокаН.ОтклонениеОтБазовойЦены = ПредопределенноеЗначение("Перечисление.ЛБ_ОтклонениеОтБазовойЦены.Относительное");
	КонецЕсли;	
КонецПроцедуры

//+МАН 04.03.25
&НаКлиенте
Процедура НастройкаОтклоненияПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	ТекСтрокаН = Элементы.НастройкаОтклонения.ТекущиеДанные;
	
	//+МАН 20.03.25
	//Было: Отбор = Новый Структура("СхемаКредитования, ВидВставки, ВидОгранки, КачествоОгранки, ОтклонениеОтБазовойЦены");
	Отбор = Новый Структура("СхемаКредитования, ВидВставки, ВидОгранки, КачествоОгранки");
	//-МАН
	ЗаполнитьЗначенияСвойств(Отбор, ТекСтрокаН);
	
	МассивСтрок = НастройкаОтклонения.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() > 1 Тогда
		Предупреждение("Строка с выбранными условиями уже есть в списке.");
		Если НоваяСтрока Тогда
			НастройкаОтклонения.Удалить(НастройкаОтклонения.Количество() - 1);
		Иначе
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//+МАН 19.03.25
&НаКлиенте
Процедура НастройкаОтклоненияВидВставкиОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	ТекСтрока = Элементы.НастройкаОтклонения.ТекущиеДанные;
	
	Если Элемент.ТекстРедактирования <> Строка(ВыбранноеЗначение) Тогда
		ТекСтрока.ВидОгранки = ПредопределенноеЗначение("Справочник.ЛБ_ВидыОгранки.ПустаяСсылка");
		ТекСтрока.КачествоОгранки = ПредопределенноеЗначение("Справочник.ЛБ_КачествоОгранки.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

