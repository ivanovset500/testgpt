Процедура НастройкаОтклоненияВидОгранкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.НастройкаОтклонения.ТекущиеДанные;
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура("ВидВставки", ТекСтрока.ВидВставки);
	
	ОткрытьФорму("Документ.ЛБ_ПриказИндивидуальныеУсловия.Форма.ФормаВыбораВидаОгранки",ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненияВидОгранкиОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	ТекСтрока = Элементы.НастройкаОтклонения.ТекущиеДанные;
	
	Если Элемент.ТекстРедактирования <> Строка(ВыбранноеЗначение) Тогда
		ТекСтрока.КачествоОгранки = ПредопределенноеЗначение("Справочник.ЛБ_КачествоОгранки.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненияКачествоОгранкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.НастройкаОтклонения.ТекущиеДанные;
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбора", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура("ВидВставки, ВидОгранки", ТекСтрока.ВидВставки, ТекСтрока.ВидОгранки);
		
	ОткрытьФорму("Документ.ЛБ_ПриказИндивидуальныеУсловия.Форма.ФормаВыбораКачестваОгранки",ПараметрыФормы,,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбора(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.НастройкаОтклонения.ТекущиеДанные;
	
	Если Результат.Свойство("ВидОгранки") Тогда
		Если ТипЗнч(Результат.ВидОгранки) = Тип("СправочникСсылка.ЛБ_ВидыОгранки") Тогда
			Если Результат.ВидОгранки <> ТекСтрока.ВидОгранки Тогда
				ТекСтрока.КачествоОгранки = ПредопределенноеЗначение("Справочник.ЛБ_КачествоОгранки.ПустаяСсылка");
			КонецЕсли;
			ТекСтрока.ВидОгранки = Результат.ВидОгранки;
		КонецЕсли;
	КонецЕсли;

	Если Результат.Свойство("КачествоОгранки") Тогда
		Если ТипЗнч(Результат.КачествоОгранки) = Тип("СправочникСсылка.ЛБ_КачествоОгранки") Тогда
			ТекСтрока.КачествоОгранки = Результат.КачествоОгранки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьВидОгранки(ВидКамня, ВидОгранки)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛБ_НастройкаДопустимыхВидовОгранки.ВидОгранки КАК ВидОгранки
		|ИЗ
		|	РегистрСведений.ЛБ_НастройкаДопустимыхВидовОгранки КАК ЛБ_НастройкаДопустимыхВидовОгранки
		|ГДЕ
		|	НЕ ЛБ_НастройкаДопустимыхВидовОгранки.ВидОгранки.ПометкаУдаления
		|	И НЕ ЛБ_НастройкаДопустимыхВидовОгранки.ВидКамня.ПометкаУдаления
		|	И НЕ ЛБ_НастройкаДопустимыхВидовОгранки.ФормаОгранки.ПометкаУдаления
		|	И ЛБ_НастройкаДопустимыхВидовОгранки.ВидОгранки = &ВидОгранки
		|	И ЛБ_НастройкаДопустимыхВидовОгранки.ВидКамня = &ВидКамня";
	
	Запрос.УстановитьПараметр("ВидКамня", ВидКамня);
	Запрос.УстановитьПараметр("ВидОгранки", ВидОгранки);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
