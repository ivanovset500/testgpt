

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Приказ = Параметры.Документ.Ссылка;
	ЦеныМеталлы.Загрузить(Приказ.Ссылка.ЦеныМеталлы.Выгрузить()); 
	Если Параметры.ТолькоПросмотр Тогда
		Просмотр = Истина;   
		Элементы.ФормаСохранить.Доступность =ложь;
		Элементы.ВыбратьСхемыКредитования.Доступность = Ложь;
	КонецЕсли;	
	
	МассивСК = Параметры.МассивСК;
	СхемыКредитования.Загрузить(ЛБ_УправлениеЛомбардом.ПреобразованиеМассивВТаблицуЗначений(МассивСК));
	
	Если НЕ СхемыКредитования.Количество() = 0 Тогда 
		Номер = 0;
		Для Каждого Стр Из СхемыКредитования Цикл  
			Номер = Номер + 1;
			Стр.НомерЦвета = Номер;
			ДобавитьКолонкуЦен(Стр.СхемаКредитования, Стр.НомерЦвета);
			ЗаполнитьДопКолонкуМеталлы(Стр.СхемаКредитования);
		КонецЦикла;  
	//+МАН 05.03.25
	Иначе
		Если Параметры.Документ.СхемыКредитования.Количество() = 0 Тогда
			Элементы.НастройкаОтклоненияДобавить.Доступность = Ложь;
		Иначе
			Элементы.НастройкаОтклоненияДобавить.Доступность = Истина;
		КонецЕсли;
	//-МАН
	КонецЕсли;	 
	
	Элементы.НастройкаОтклоненияСхемаКредитования.СписокВыбора.Очистить();
	
	Для каждого СтрСК Из Приказ.СхемыКредитования Цикл
		Элементы.НастройкаОтклоненияСхемаКредитования.СписокВыбора.Добавить(СтрСК.СхемаКредитования);
	КонецЦикла;
	
	Если Просмотр Тогда 
		Элементы.НастройкаОтклонений.Видимость =ложь;
	Иначе                                            
		ЗаполнитьНастройкуОтклонений();
	КонецЕсли;	

	Если ЦеныМеталлы.Количество() > 0 Тогда
		ЗаполнитьСписокВыбораМеталлов();
	Иначе
		Элементы.НастройкаОтклоненияМеталл.СписокВыбора.Очистить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораМеталлов()
	ТЗ = ЦеныМеталлы.Выгрузить();
	ТЗ.Свернуть("Металл");
	
	Элементы.НастройкаОтклоненияМеталл.СписокВыбора.Очистить();
	
	Для каждого СтрТЗ Из ТЗ Цикл
	    Элементы.НастройкаОтклоненияМеталл.СписокВыбора.Добавить(СтрТЗ.Металл);	
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкуОтклонений() 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Приказ.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.СхемаКредитования КАК СхемаКредитования,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.Металл КАК Металл,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.ПроцентОтклонения КАК ПроцентОтклонения,
	               |	ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних.УстанавливатьОтклонение КАК УстановитьОтклонение
	               |ИЗ
	               |	РегистрСведений.ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлы.СрезПоследних(&Дата, ) КАК ЛБ_ОтносительныеОтклоненияОтБазовыхЦенМеталлыСрезПоследних";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	НастройкаОтклонения.Загрузить(ТаблицаЗапроса);
КонецПроцедуры	
	
&НаКлиенте
Процедура ВыбратьСхемыКредитования(Команда) 
	СК = ЗаполнитьСписокСК();  
	
	// процедура ПослеОтметкиЭлементов определена чуть ниже
    ОповещениеПослеОтметкиЭлементов = Новый ОписаниеОповещения(
        "ПослеОтметкиЭлементов", ЭтотОбъект
    );	
 
    СК.ПоказатьОтметкуЭлементов(
        ОповещениеПослеОтметкиЭлементов,
        "Выберите схемы кредитования"
    );
КонецПроцедуры

