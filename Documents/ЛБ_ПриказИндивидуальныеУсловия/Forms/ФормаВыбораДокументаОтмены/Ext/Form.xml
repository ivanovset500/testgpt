	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЛБ_ПриказИндивидуальныеУсловия.Дата КАК Дата,
	ЛБ_ПриказИндивидуальныеУсловия.НомерПриказа КАК НомерПриказа,
	ЛБ_ПриказИндивидуальныеУсловия.ВидПриказа КАК ВидПриказа,
	ЛБ_ПриказИндивидуальныеУсловия.ДатаНачалаДействияПриказа КАК ДатаНачалаДействияПриказа,
	ЛБ_ПриказИндивидуальныеУсловия.ДатаОкончанияДействияПриказа КАК ДатаОкончанияДействияПриказа
ИЗ
	Документ.ЛБ_ПриказИндивидуальныеУсловия КАК ЛБ_ПриказИндивидуальныеУсловия
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Ссылка КАК Ссылка,
			КОЛИЧЕСТВО(ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Залогодатель) КАК КолЗалогодателей,
			СУММА(ВЫБОР
					КОГДА ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.НетСтавок = ИСТИНА
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК КолНетСтавок,
			СУММА(ВЫБОР
					КОГДА ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.НетМеталлов = ИСТИНА
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК КолНетМеталлов,
			СУММА(ВЫБОР
					КОГДА ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.НетВставок = ИСТИНА
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК КолНетВставок
		ИЗ
			Документ.ЛБ_ПриказИндивидуальныеУсловия.Залогодатели КАК ЛБ_ПриказИндивидуальныеУсловияЗалогодатели
		
		СГРУППИРОВАТЬ ПО
			ЛБ_ПриказИндивидуальныеУсловияЗалогодатели.Ссылка) КАК Отметки
		ПО (ЛБ_ПриказИндивидуальныеУсловия.Ссылка = Отметки.Ссылка)
ГДЕ
	НЕ ЛБ_ПриказИндивидуальныеУсловия.ПометкаУдаления
	И ЛБ_ПриказИндивидуальныеУсловия.Проведен
	И ЛБ_ПриказИндивидуальныеУсловия.ВидПриказа = ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыПриказа.Факт)
	И ЛБ_ПриказИндивидуальныеУсловия.ВидОперации &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ЛБ_ВидыОперацийПриказы.ОтменитьВИП)
	И ВЫБОР
			КОГДА ЛБ_ПриказИндивидуальныеУсловия.ДатаОкончанияДействияПриказа = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			КОГДА ЛБ_ПриказИндивидуальныеУсловия.ДатаОкончанияДействияПриказа &gt;= &amp;ТекущаяДата
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И ВЫБОР
			КОГДА Отметки.КолЗалогодателей = Отметки.КолНетСтавок
					И Отметки.КолЗалогодателей = Отметки.КолНетМеталлов
					И Отметки.КолЗалогодателей = Отметки.КолНетВставок
				ТОГДА ЛОЖЬ
			ИНАЧЕ ИСТИНА
		КОНЕЦ</QueryText>
				<MainTable>Document.ЛБ_ПриказИндивидуальныеУсловия</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Дата</dcsset:field>
							<dcsset:orderType>Desc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
	</Attributes>
