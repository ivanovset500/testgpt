	КонецЕсли;
	
	Если СтруктураУсловий.Металлы Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "222 = 222", "НЕ ЛБ_ИндивидуальнаяНастройкаРасчетаОценкиЗалога.Регистратор = &Регистратор");
	КонецЕсли;

	Если СтруктураУсловий.Вставки Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "333 = 333", "НЕ ЛБ_ИндивидуальнаяНастройкаОценкиДрагоценныхВставок.Регистратор = &Регистратор");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Залогодатель", Залогодатель);
	Запрос.УстановитьПараметр("Регистратор", ОтменяемыйДок);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	//+МАН 28.07.25 Изменил проверку результата
	//Если Результат.Следующий() Тогда
	//	Возврат Результат.Регистратор;
	//Иначе
	//	Возврат Неопределено;
	//КонецЕсли;

	Пока Результат.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Залогодатель", Залогодатель);
		
		МассивЗ = Результат.Регистратор.Залогодатели.НайтиСтроки(Отбор);
		
		Если МассивЗ.Количество() > 0 Тогда
			Если НЕ МассивЗ[0].НетСтавок ИЛИ НЕ МассивЗ[0].НетМеталлов ИЛИ НЕ МассивЗ[0].НетВставок Тогда
				Возврат Результат.Регистратор;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	//-МАН
КонецФункции

