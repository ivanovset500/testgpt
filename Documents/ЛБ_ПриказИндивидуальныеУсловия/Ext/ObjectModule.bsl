// Выгружает результат запроса в табличную часть, добавляет ей необходимые колонки для проведения.
//
// Параметры: 
//  РезультатЗапросаПоТоварам - результат запроса по табличной части "Товары",
//  СтруктураШапкиДокумента   - выборка по результату запроса по шапке документа.
//
// Возвращаемое значение:
//  Сформированная таблиица значений.
//
Процедура ПодготовитьТаблицуСтавок(РезультатЗапроса, Док = Неопределено, Залогодатель = Неопределено) Экспорт

	ТаблицаЗапроса = РезультатЗапроса.Выгрузить();

	Если ТаблицаСтавок = Неопределено Тогда
		ТаблицаСтавок = ТаблицаЗапроса.Скопировать();
		ТаблицаСтавок.Очистить();
		ТаблицаСтавок.Колонки.Добавить("Залогодатель");
		ТаблицаСтавок.Колонки.Добавить("Приказ");
	КонецЕсли;

	Если Ссылка.ВидОперации = Перечисления.ЛБ_ВидыОперацийПриказы.ОтменитьВИП Тогда
		//Для каждого СтрЛ Из Залогодатели Цикл		
		//	Отбор = Новый Структура;
		//	Отбор.Вставить("Залогодатель", СтрЛ.Залогодатель);
		//	
		//	МПоиска = Док.Залогодатели.НайтиСтроки(Отбор);
		//	
		//	Если МПоиска.Количество() > 0 Тогда
				Для каждого Стр Из  ТаблицаЗапроса Цикл 
					Если НЕ ЗначениеЗаполнено(Стр.Ставка) Тогда
						Продолжить;
					КонецЕсли;	
					НоваяСтр = ТаблицаСтавок.Добавить();
					//НоваяСтр.Залогодатель = СтрЛ.Залогодатель.Ссылка;
					НоваяСтр.Залогодатель = Залогодатель;
					НоваяСтр.Приказ = Док;
					НоваяСтр.СхемаКредитования = Стр.СхемаКредитования;
					НоваяСтр.ДиапазонСумм = Стр.ДиапазонСумм;  
					НоваяСтр.Ставка = Стр.Ставка; 
				КонецЦикла;
		//	КонецЕсли;
		//КонецЦикла;
	Иначе
		Для каждого СтрЛ Из Залогодатели Цикл		
			Для каждого Стр Из  ТаблицаЗапроса Цикл
				Если НЕ ЗначениеЗаполнено(Стр.Ставка) Тогда
					Продолжить;
				КонецЕсли;	 
				НоваяСтр = ТаблицаСтавок.Добавить();
				НоваяСтр.Залогодатель = СтрЛ.Залогодатель.Ссылка;
				НоваяСтр.СхемаКредитования = Стр.СхемаКредитования;
	            НоваяСтр.ДиапазонСумм = Стр.ДиапазонСумм;  
				НоваяСтр.Ставка = Стр.Ставка; 
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;	
	
	//Возврат ТаблицаСтавок;

