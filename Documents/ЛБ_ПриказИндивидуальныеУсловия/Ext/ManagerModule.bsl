#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

/// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор  = "ПриказУстановкиВИП";
	КомандаПечати.Представление  = НСтр("ru = 'Приказ установки статуса ""ВИП""'");
	//КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати"; 
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор  = "ПриказОтмены";
	КомандаПечати.Представление  = НСтр("ru = 'Приказ отмены установки статуса ""ВИП""'");
КонецПроцедуры	

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Устанавливаем признак доступности печати покомплектно.
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
	
	// Проверяем, нужно ли для макета ЗаключениеОбОценке формировать табличный документ.
	//Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Приказ") Тогда
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриказУстановкиВИП") Тогда
		
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Приказ", "Приказ", 
		//ПечатьПриказа(МассивОбъектов, ОбъектыПечати));  
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриказУстановкиВИП", "Приказ установки статуса ""ВИП""", 
		ПечатьПриказаУстановкиВИП(МассивОбъектов, ОбъектыПечати));  
    ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриказОтмены") Тогда
	//ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Акция") Тогда
	//	
	//	// Формируем табличный документ и добавляем его в коллекцию печатных форм.
	//	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Акция", "Акция", 
	//	ПечатьАкции(МассивОбъектов, ОбъектыПечати)); 
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриказОтмены", "Приказ отмены установки статуса ""ВИП""", 
		ПечатьПриказаОтменыВИП(МассивОбъектов, ОбъектыПечати));  
	КонецЕсли;
	
	//ОбщегоНазначенияБП.ЗаполнитьДополнительныеПараметрыПечати(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);	
	
КонецПроцедуры

Функция ПечатьПриказа(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_Приложение_К_Приказу"; 
		
	ВыборкаДанныеДокументов = ПолучитьВыборкуДанныхДокумента(МассивОбъектов);
	
	НаименованияОрганизации = НаименованиеОрганизации();
	НаименованиеОрганизацииСокращенное = НаименованияОрганизации.НаименованиеСокращенное;
	НаименованиеОрганизацииПолное      = НаименованияОрганизации.НаименованиеПолное;
	ДиректорФИО = ФИОДиректора();
		
	Если ВыборкаДанныеДокументов.Следующий() Тогда  
		
		ТаблицаРегистраторов = ПолучитьТаблицуРегистраторов(ВыборкаДанныеДокументов.СсылкаНаДокумент);   
		РегистраторыПоГруппам = ТаблицаРегистраторов.Скопировать();
		РегистраторыПоГруппам.Свернуть("Группа, РегистраторМеталлы, РегистраторВставки, РегистраторСтавки"); 
		Регистраторы = РегистраторыПоГруппам.Скопировать();
		Регистраторы.Свернуть("РегистраторМеталлы, РегистраторВставки, РегистраторСтавки"); 
		НомерПриложения = 0;      
		РегистраторыМеталлы = Новый СписокЗначений;  
		РегистраторыВставки = Новый СписокЗначений;
        РегистраторыСтавки = Новый СписокЗначений;
		
		Для каждого СтрР Из Регистраторы Цикл
			Если РегистраторыМеталлы.НайтиПоЗначению(СтрР.РегистраторМеталлы) = неопределено Тогда 
				РегистраторыМеталлы.Добавить(СтрР.РегистраторМеталлы);
			КонецЕсли;
			
			Если РегистраторыВставки.НайтиПоЗначению(СтрР.РегистраторВставки) = неопределено Тогда 
				РегистраторыВставки.Добавить(СтрР.РегистраторВставки);
			КонецЕсли;
			
			Если РегистраторыСтавки.НайтиПоЗначению(СтрР.РегистраторСтавки) = неопределено Тогда 
				РегистраторыСтавки.Добавить(СтрР.РегистраторСтавки);
			КонецЕсли;	
		КонецЦикла;	
		
		ТаблицаМеталловОбщая = ПолучитьВыборкуПрейскурантаЦен(РегистраторыМеталлы);
		ТаблицаМеталлов = ТаблицаМеталловОбщая.СкопироватьКолонки();
		ТаблицаВставкиОбщая = ПолучитьВыборкуПрейскурантаЦенВставки(РегистраторыВставки); 
		ТаблицаВставки = ТаблицаВставкиОбщая.СкопироватьКолонки();
		ТаблицаСтавокОбщая = ПолучитьВыборкуПрейскурантаСтавок(РегистраторыСтавки, ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата);
		ТаблицаСтавок = ТаблицаСтавокОбщая.СкопироватьКолонки();
		
		СтруктураБазоваяЦенаМ = ПолучитьБазовыеЦеныМеталлы(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата);
		БазоваяКатегория = СтруктураБазоваяЦенаМ.Категория; 
		БазоваяПроба = СтруктураБазоваяЦенаМ.Проба;  

		Для каждого СтрРег Из Регистраторы Цикл  
			Если НЕ НомерПриложения = 0 Тогда
			    ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			НомерПриложения = НомерПриложения + 1;  
			ПриказНомер = ВыборкаДанныеДокументов.НомерПриказа + ?(Регистраторы.Количество() = 1, "", "-" + Строка(НомерПриложения));
			ПриказДата  = СтрШаблон("%1г.", Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДЛФ = Д"));
			
			ОтборГ = новый Структура;  
			ОтборГ.Вставить("РегистраторМеталлы", СтрРег.РегистраторМеталлы);
			ОтборГ.Вставить("РегистраторВставки", СтрРег.РегистраторВставки); 
			ОтборГ.Вставить("РегистраторСтавки", СтрРег.РегистраторСтавки); 
			СтрокиГ = РегистраторыПоГруппам.НайтиСтроки(ОтборГ); 
			
			СтрокаЛомбардов = "";
			Для каждого СтрГ Из СтрокиГ Цикл
				ОтборР = новый Структура;  
				ОтборР.Вставить("Группа", СтрГ.Группа);
				ОтборР.Вставить("РегистраторМеталлы", СтрРег.РегистраторМеталлы);
				ОтборР.Вставить("РегистраторВставки", СтрРег.РегистраторВставки); 
				ОтборР.Вставить("РегистраторСтавки", СтрРег.РегистраторСтавки); 
				СтрокиР = ТаблицаРегистраторов.НайтиСтроки(ОтборР);   
				
				ГородЛомбардов = ?(ЗначениеЗаполнено(СтрГ.Группа), СокрЛП(СтрГ.Группа), "Вне групп"); 
				СтрокаЛомбардов = СтрокаЛомбардов + ?(ПустаяСтрока(СтрокаЛомбардов), "", "; ") + ГородЛомбардов;
				Ном = 0;   
				СтрокаЛомбарды = "";
				Для каждого СтрР из СтрокиР Цикл  
					СтрокаЛомбарды = СтрокаЛомбарды + ?(Ном = 0, "", ", ") + ?(ЗначениеЗаполнено(СтрР.Ломбард.НомерЛомбарда), "№ " +  СокрЛП(СтрР.Ломбард.НомерЛомбарда), СокрЛП(СтрР.Ломбард)); 
					Ном = Ном + 1;
				конеццикла;   
				СтрокаЛомбардов = СтрокаЛомбардов + " (" + СтрокаЛомбарды + ")"; 
			КонецЦикла;
			
			//СписокЛомбардов = новый СписокЗначений;
			//Для каждого СтрР из СтрокиР Цикл  
			//	СписокЛомбардов.Добавить(СтрР.Ломбард);
			//конеццикла;      
			//СтрокаЛомбарды = ПолучитьСтрокуЛомбардов(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, СписокЛомбардов);
						
			//приказ
			Макет = ПолучитьМакет("ПФ_MXL_ШапкаПриказа");
			ПриказНомер = ВыборкаДанныеДокументов.НомерПриказа;
			ПриказДата  = СтрШаблон("%1г.", Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДЛФ = Д"));
			Ломбарды    = ВыборкаДанныеДокументов.СтрокаЛомбарды;
			ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
			ОбластьТекст  = Макет.ПолучитьОбласть("Текст");         
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
			
			ОбластьШапка.Параметры.СокращенноеНаименованиеОрганизации = НаименованиеОрганизацииСокращенное;
			ОбластьШапка.Параметры.ПолноеНаименованиеОрганизации      = НаименованиеОрганизацииПолное; 
			ОбластьШапка.Параметры.НомерПриказа = ПриказНомер; 
			ОбластьШапка.Параметры.ДатаПриказа = ПриказДата;
					
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			ОбластьТекст.Параметры.НачальникОДО = ВыборкаДанныеДокументов.СсылкаНаДокумент.НачальникОДО;
			ОбластьТекст.Параметры.СокращенноеНаименованиеОрганизации          = НаименованиеОрганизацииСокращенное;
			ОбластьТекст.Параметры.НачальникОРБ              = ВыборкаДанныеДокументов.СсылкаНаДокумент.НачальникОРБ;  
			//ОбластьТекст.Параметры.ГородЛомбардов                              = ГородЛомбардов;
			ОбластьТекст.Параметры.СписокЛомбардовСАдресами                    = СтрокаЛомбардов;
			ОбластьТекст.Параметры.ДатаПриказа   = ПриказДата;
			ОбластьТекст.Параметры.Программа     = "Будет название программы";
			ОбластьТекст.Параметры.Ответственный = ВыборкаДанныеДокументов.Ответственный;
			
			ТабличныйДокумент.Вывести(ОбластьТекст);
			
			ОбластьПодвал.Параметры.Директор = ДиректорФИО;
			
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			//приложение к приказу
			Макет = ПолучитьМакет("ПФ_MXL_Приказ");
			
			ОтборМ = Новый Структура;
			ОтборМ.Вставить("Регистратор", СтрРег.РегистраторМеталлы); 
			СтрокиМ = ТаблицаМеталловОбщая.НайтиСтроки(ОтборМ); 
			ТаблицаМеталлов.Очистить();
			Для каждого стрМ из СтрокиМ Цикл
				НоваяСтрМ = ТаблицаМеталлов.Добавить();
			    ЗаполнитьЗначенияСвойств(НоваяСтрМ, стрМ);
			Конеццикла;	
       		//ТаблицаМеталлов = ПолучитьВыборкуПрейскурантаЦен(СтрРег.РегистраторМеталлы);  
			ТаблицаМеталлов.Сортировать("Категория, Металл, ГруппаМеталл Убыв");
			ТаблицаМ = ТаблицаМеталлов.Скопировать();
			ТаблицаМ.Свернуть("Металл");    
			ТаблицаГрупп = ТаблицаМеталлов.Скопировать();
			ТаблицаГрупп.Свернуть("Металл, ГруппаМеталл");
			КолГруппМ = ТаблицаГрупп.Количество();  
			
			
			ОтборВ = Новый Структура;
			ОтборВ.Вставить("Регистратор", СтрРег.РегистраторВставки); 
			СтрокиВ = ТаблицаВставкиОбщая.НайтиСтроки(ОтборВ); 
			ТаблицаВставки.Очистить();
			Для каждого стрВ из СтрокиВ Цикл
				НоваяСтрВ = ТаблицаВставки.Добавить();
			    ЗаполнитьЗначенияСвойств(НоваяСтрВ, стрВ);
			Конеццикла;	
			//ТаблицаВставки = ПолучитьВыборкуПрейскурантаЦенВставки(СтрРег.РегистраторВставки);  
			ТаблицаВ = ТаблицаВставки.Скопировать();  
			Отбор0 = Новый Структура;
			Отбор0.Вставить("ОбособленныйВыводПечать", Истина);    
			Строки0 = ТаблицаВ.НайтиСтроки(Отбор0);
			Для каждого Стр0 Из Строки0 Цикл 
				ТаблицаВ.Удалить(Стр0);
			Конеццикла;	
			ТаблицаВ.Свернуть("ВидОгранки, ФормаОгранки, КачествоОгранки");
			ТаблицаВ.Сортировать("ВидОгранки Убыв, КачествоОгранки");
            КолГруппВ = ТаблицаВ.Количество()*2;
			
			ОтборС = Новый Структура;
			ОтборС.Вставить("Регистратор", СтрРег.РегистраторСтавки); 
			СтрокиС = ТаблицаСтавокОбщая.НайтиСтроки(ОтборС); 
			ТаблицаСтавок.Очистить();
			Для каждого стрС из СтрокиС Цикл
				НоваяСтрС = ТаблицаСтавок.Добавить();
			    ЗаполнитьЗначенияСвойств(НоваяСтрС, стрС);
			Конеццикла;	
			//ТаблицаСтавок = ПолучитьВыборкуПрейскурантаСтавок(СтрРег.РегистраторСтавки);
			ТаблицаСК = ТаблицаСтавок.Скопировать();
			ТаблицаСК.Свернуть("СхемаКредитования, Срок");
			ТаблицаСК.Сортировать("СхемаКредитования, Срок");
			ТаблицаПоказатели = ТаблицаСтавок.Скопировать();   
			ТаблицаПоказатели.Сортировать("Категория, ПричинаПрименения, ДеньНачалаПрименения");
			Если СтрРег.РегистраторСтавки.НеВыводитьНаПечатьПричиныПрименения Тогда 
				ТаблицаПоказатели.Свернуть("СхемаКредитования, Срок, Категория, ДеньНачалаПрименения");
			Иначе	
			    ТаблицаПоказатели.Свернуть("СхемаКредитования, Срок, Категория, ПричинаПрименения, ДеньНачалаПрименения");
			КонецЕсли;	
			ТаблицаД = ТаблицаСтавок.Скопировать();
			ТаблицаД.Свернуть("ДиапазонСумм"); 
            КолГруппС = ТаблицаД.Количество() + 3; 
			
			
			КолГрупп = Макс(КолГруппМ, КолГруппВ, КолГруппС);
			Если КолГрупп = 0 Тогда
			    КолГрупп = 10;
			КонецЕсли;			
				
			// Формируем основную часть. 
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка|КолонкаОсновная"); 
			ОбластьШапкаПусто = Макет.ПолучитьОбласть("Шапка|КолонкаШапкаПусто"); 
			ОбластьШапкаУтверждаю = Макет.ПолучитьОбласть("Шапка|КолонкаШапкаУтверждаю");  
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			
			ОбластьШапка.Параметры.ДатаПриказа                        = ПриказДата;
			ОбластьШапка.Параметры.НомерПриказа                       = ПриказНомер; 
			ОбластьШапка.Параметры.СокращенноеНаименованиеОрганизации = НаименованиеОрганизацииСокращенное; 
			//ОбластьШапка.Параметры.ГородЛомбардов                     = ГородЛомбардов;
			ОбластьШапка.Параметры.НомераАдресовЛомбардов             = СтрокаЛомбардов;
			ТабличныйДокумент.Вывести(ОбластьШапка); 
			
			Для Сч = 1 По КолГрупп-1 Цикл  
				ТабличныйДокумент.Присоединить(ОбластьШапкаПусто);
			Конеццикла;        
			ОбластьШапкаУтверждаю.Параметры.Организация = НаименованиеОрганизацииСокращенное;
			ОбластьШапкаУтверждаю.Параметры.Директор     = ДиректорФИО;
			ТабличныйДокумент.Присоединить(ОбластьШапкаУтверждаю); 
						
			ТабличныйДокумент.Область(НомерСтр + 5, 1, НомерСтр + 5, КолГрупп).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 6, 1, НомерСтр + 6, КолГрупп).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 7, 1, НомерСтр + 7, КолГрупп).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 8, 1, НомерСтр + 8, КолГрупп).Объединить();  
					
			//металлы    
			Если НЕ ТаблицаМеталлов.Количество() = 0  Тогда
