								Ставка = Строки.Получить(0).Ставка;
							КонецЕсли;	
							ОбластьСтрокаСтавка.Параметры.Ставка = Ставка;
						    ТабличныйДокумент.Присоединить(ОбластьСтрокаСтавка);
						Конеццикла;  

					Конеццикла;	
				КонецЦикла;	
			КонецЕсли;	
		Конеццикла;	
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции     

Функция ПечатьАкции(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_Акция"; 
		
	ВыборкаДанныеДокументов = ПолучитьВыборкуДанныхДокумента(МассивОбъектов);
	
	НаименованияОрганизации = НаименованиеОрганизации();
	НаименованиеОрганизацииСокращенное = НаименованияОрганизации.НаименованиеСокращенное;
	НаименованиеОрганизацииПолное      = НаименованияОрганизации.НаименованиеПолное;
			
	Если ВыборкаДанныеДокументов.Следующий() Тогда  
		
		ТаблицаСтавок = ПолучитьВыборкуПрейскурантаСтавокАкция(ВыборкаДанныеДокументов.СсылкаНаДокумент);
		ТаблицаСК = ТаблицаСтавок.Скопировать();
		ТаблицаСК.Свернуть("СхемаКредитования");
		ТаблицаСК.Сортировать("СхемаКредитования");
		ТаблицаПоказатели = ТаблицаСтавок.Скопировать();
		ТаблицаПоказатели.Свернуть("СхемаКредитования, Категория, ПричинаПрименения");
		ТаблицаПоказатели.Сортировать("Категория, ПричинаПрименения");
		ТаблицаД = ТаблицаСтавок.Скопировать();
		ТаблицаД.Свернуть("ДиапазонСумм"); 
		
		СписокЛомбардов = Новый СписокЗначений;  
		Для каждого Стр Из ВыборкаДанныеДокументов.СсылкаНаДокумент.Ломбарды Цикл 
			СписокЛомбардов.Добавить(Стр.Ломбард);
		Конеццикла;	           
		Если ВыборкаДанныеДокументов.СсылкаНаДокумент.ВыводитьЛомбарды = 0 Тогда 
			ЛомбардыОтделения = "ломбардах";
		    СтрокаЛомбарды = ПолучитьСтрокуЛомбардов(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, СписокЛомбардов); 
		Иначе    
			ЛомбардыОтделения = "отделениях ломбардов";
			СтрокаЛомбарды = ПолучитьСтрокуОтделенийЛомбардов(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, СписокЛомбардов);
		КонецЕсли;	
		
		Макет = ПолучитьМакет("ПФ_MXL_Акция");
		ПриказНомер = ВыборкаДанныеДокументов.НомерПриказа;
		ПриказДата  = СтрШаблон("%1 г.", Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДЛФ=Д"));
		Ломбарды    = ВыборкаДанныеДокументов.СтрокаЛомбарды; 
		Акция = ВыборкаДанныеДокументов.Акция;
		ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
		ОбластьТекст  = Макет.ПолучитьОбласть("ТекстПриказаЧасть1"); 
		ОбластьТекст2  = Макет.ПолучитьОбласть("ТекстПриказаЧасть2"); 
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьШапка.Параметры.СокращенноеНаименованиеОрганизации = НаименованиеОрганизацииСокращенное;
		ОбластьШапка.Параметры.ПолноеНаименованиеОрганизации      = НаименованиеОрганизацииПолное; 
		ОбластьШапка.Параметры.НомерПриказа = ПриказНомер; 
		ОбластьШапка.Параметры.ДатаПриказа = ПриказДата;  
		ОбластьШапка.Параметры.Акция = Акция;
				
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ОбластьТекст.Параметры.Акция = Акция;
		ОбластьТекст.Параметры.ЛомбардыОтделения = ЛомбардыОтделения;
	    ОбластьТекст.Параметры.СписокЛомбардовСАдресами                    = СтрокаЛомбарды;
		ОбластьТекст.Параметры.ДатаПриказа   = ПриказДата; 
		ОбластьТекст.Параметры.НачальникОРБ = ВыборкаДанныеДокументов.СсылкаНаДокумент.НачальникОРБ; 
					
		ТабличныйДокумент.Вывести(ОбластьТекст);
		
		//процентные ставки  
		Если НЕ ТаблицаСтавок.Количество() = 0 Тогда
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			
			ОбластьШапкаОсн = Макет.ПолучитьОбласть("ШапкаОценкиСтавки|КолонкаОсновная");
			ОбластьШапкаДоп = Макет.ПолучитьОбласть("ШапкаОценкиСтавки|КолонкаДоп");	
			ОбластьШапкаСтавка = Макет.ПолучитьОбласть("ШапкаОценкиСтавки|КолонкаСтавка"); 
			
			ТабличныйДокумент.Вывести(ОбластьШапкаОсн);
			ОбластьШапкаДоп.Параметры.Показатель = "Причина применения";
			ТабличныйДокумент.Присоединить(ОбластьШапкаДоп);
							
			Для каждого СтрД из ТаблицаД Цикл
				ОбластьШапкаСтавка.Параметры.Диапазон = СтрД.ДиапазонСумм;
			    ТабличныйДокумент.Присоединить(ОбластьШапкаСтавка);
			Конеццикла;  
			
			НомерСтр = НомерСтр + 1;  
			НомерКолонкиНач = 4;
			НомерКолонкиКон = НомерКолонкиНач + ТаблицаД.Количество();
			ТабличныйДокумент.Область(НомерСтр, НомерКолонкиНач, НомерСтр, НомерКолонкиКон).Объединить(); 
						
			ОбластьЗайм = Макет.ПолучитьОбласть("Займ|КолонкаОсновная");
			ОбластьСтрокаОсн = Макет.ПолучитьОбласть("СтрокаСтавка|КолонкаОсновная");
			ОбластьСтрокаДоп = Макет.ПолучитьОбласть("СтрокаСтавка|КолонкаДоп");	
			ОбластьСтрокаСтавка = Макет.ПолучитьОбласть("СтрокаСтавка|КолонкаСтавка"); 
			
			Ном = 0;
			Для каждого СтрК из ТаблицаСК Цикл
				Ном = Ном + 1;
				ОбластьЗайм.Параметры.Ном = Строка(Ном);
				ОбластьЗайм.Параметры.Займ = СокрЛП(СтрК.СхемаКредитования);
				ТабличныйДокумент.Вывести(ОбластьЗайм);   
				
				НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
				НомерКолонкиКон = ТаблицаД.Количество() + 4; 
				ТабличныйДокумент.Область(НомерСтр, 2, НомерСтр, НомерКолонкиКон).Объединить();  
				
				Отбор = Новый Структура;
				Отбор.Вставить("СхемаКредитования", СтрК.СхемаКредитования);
				СтрокиП = ТаблицаПоказатели.НайтиСтроки(Отбор);
				Для каждого СтрП Из СтрокиП Цикл 
					ОбластьСтрокаОсн.Параметры.Категория = СтрП.Категория; 
					ТабличныйДокумент.Вывести(ОбластьСтрокаОсн);  
					
					ОбластьСтрокаДоп.Параметры.ЗначениеП = СтрП.ПричинаПрименения; 
					ТабличныйДокумент.Присоединить(ОбластьСтрокаДоп);
											
					Отбор.Вставить("Категория", СтрП.Категория);
					Отбор.Вставить("ПричинаПрименения", СтрП.ПричинаПрименения);
					Для каждого СтрД из ТаблицаД Цикл 
						Отбор.Вставить("ДиапазонСумм", СтрД.ДиапазонСумм); 
						Строки  = ТаблицаСтавок.НайтиСтроки(Отбор);
						Если Строки.Количество() = 0 Тогда
							Ставка = 0;
						Иначе     
							Ставка = Строки.Получить(0).Ставка;
						КонецЕсли;	
						ОбластьСтрокаСтавка.Параметры.Ставка = Ставка;
					    ТабличныйДокумент.Присоединить(ОбластьСтрокаСтавка);
					Конеццикла;  

				Конеццикла;	
			КонецЦикла;	
		КонецЕсли;	 
				
		ОбластьТекст2.Параметры.ДатаПриказа = ПриказДата;
		ОбластьТекст2.Параметры.ДатаНачалаДействияПриказа = СтрШаблон("%1 г.", Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy"));
		ОбластьТекст2.Параметры.ДатаОкончанияДействияПриказа = СтрШаблон("%1 г.", Формат(ВыборкаДанныеДокументов.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy"));  
		ОбластьТекст2.Параметры.ОтветственноеЛицоОРБ = ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтветственноеЛицоОРБ;
		ОбластьТекст2.Параметры.ОтветственноеЛицоРеклама = ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтветственноеЛицоРеклама; 
		ТабличныйДокумент.Вывести(ОбластьТекст2); 
		
		ОбластьПодвал.Параметры.ПодписантДолжность = ВыборкаДанныеДокументов.СсылкаНаДокумент.ПодписантДолжность;
		ОбластьПодвал.Параметры.ПодписантФИО = ВыборкаДанныеДокументов.СсылкаНаДокумент.ПодписантФИО;
		ТабличныйДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции     

Функция ПечатьПриказаУстановкиВИП(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ПриказУстановкиВИП";
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//ТабличныйДокумент.Защита = Истина;
		
	ВыборкаДанныеДокументов = ПолучитьВыборкуДанныхДокумента(МассивОбъектов);
	
	ТЗЗалогодателиБезУсловий = Новый ТаблицаЗначений;
	ТЗЗалогодателиБезУсловий.Колонки.Добавить("Залогодатель");
	
	ТЗЗалогодателиСУсловиями = Новый ТаблицаЗначений;
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("Залогодатель");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ИспользуютсяСтавки");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ИспользуютсяМаталлы");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ИспользуютсяВставки");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ДокументСтавки");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ДокументМеталлы");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ДокументВставки");
	
	МассивУдаления = Новый Массив;
	
	Если ВыборкаДанныеДокументов.Следующий() Тогда  
		
		ТЗЗалогодатели = ВыборкаДанныеДокументов.Залогодатели.Выгрузить();

		Для каждого СтрЗ Из ТЗЗалогодатели Цикл
			//СтруктураВозврата = ПроверитьСтатусКлиентаВИП(НачалоДня(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата), СтрЗ.Залогодатель);
			СтруктураВозврата = ПроверитьСтатусКлиентаВИП(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата - 1, СтрЗ.Залогодатель);
			
			Если НЕ СтруктураВозврата.ИспользуютсяСтавки И НЕ СтруктураВозврата.ИспользуютсяМаталлы И НЕ СтруктураВозврата.ИспользуютсяВставки Тогда
				НоваяСтрБез = ТЗЗалогодателиБезУсловий.Добавить();
				НоваяСтрБез.Залогодатель = СтрЗ.Залогодатель;
			КонецЕсли;
			
			Если СтруктураВозврата.ИспользуютсяСтавки ИЛИ СтруктураВозврата.ИспользуютсяМаталлы ИЛИ СтруктураВозврата.ИспользуютсяВставки Тогда

				НоваяСтрБез = ТЗЗалогодателиСУсловиями.Добавить();
				НоваяСтрБез.Залогодатель = СтрЗ.Залогодатель;
				НоваяСтрБез.ИспользуютсяСтавки = СтруктураВозврата.ИспользуютсяСтавки;
				НоваяСтрБез.ИспользуютсяМаталлы = СтруктураВозврата.ИспользуютсяМаталлы;
				НоваяСтрБез.ИспользуютсяВставки = СтруктураВозврата.ИспользуютсяВставки;
				НоваяСтрБез.ДокументСтавки = СтруктураВозврата.ДокументСтавки;
				НоваяСтрБез.ДокументМеталлы = СтруктураВозврата.ДокументМеталлы;
				НоваяСтрБез.ДокументВставки = СтруктураВозврата.ДокументВставки;
			
			КонецЕсли;
		КонецЦикла;
		
		ТЗСтавки = ВыборкаДанныеДокументов.СтавкиПроцентов.Выгрузить();
		ТЗМеталлы = ВыборкаДанныеДокументов.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить();
		ТЗВставки = ВыборкаДанныеДокументов.НастройкаОтклоненийОтБазовыхЦенВставки.Выгрузить();
		ТЗСК = ВыборкаДанныеДокументов.СхемыКредитования.Выгрузить();
		
		ТЗСК.Сортировать("СхемаКредитования Возр");
		
		//Удаляем строки без отклонений
		МассивУдаленияСтрокТЗМ = Новый Массив;
		
		Для каждого СтрМ Из ТЗМеталлы Цикл
			Если НЕ ЗначениеЗаполнено(СтрМ.ОтклонениеОтБазовойЦены) Тогда
				МассивУдаленияСтрокТЗМ.Добавить(СтрМ);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивУдаленияСтрокТЗМ.Количество() > 0 Тогда
			Для каждого СтрМ Из МассивУдаленияСтрокТЗМ Цикл
				ТЗМеталлы.Удалить(СтрМ);
			КонецЦикла;
		КонецЕсли;
		
		МассивУдаленияСтрокТЗМ.Очистить();
		
		Для каждого СтрС Из ТЗСтавки Цикл
			Если СтрС.Ставка = 0 Тогда
				МассивУдаленияСтрокТЗМ.Добавить(СтрС);
			КонецЕсли;			
		КонецЦикла;

		Если МассивУдаленияСтрокТЗМ.Количество() > 0 Тогда
			Для каждого СтрМ Из МассивУдаленияСтрокТЗМ Цикл
				ТЗСтавки.Удалить(СтрМ);
			КонецЦикла;
		КонецЕсли;
		
		МаксКолСтавки = 0;
		МаксКолВставки = 0;
		
		ТЗКолСтавки = ТЗСтавки.Скопировать(, "СхемаКредитования");
		ТЗКолСтавки.Свернуть("СхемаКредитования");
		ТЗКолСтавки.Сортировать("СхемаКредитования Возр");
		
		ТЗКолВставки = ТЗВставки.Скопировать(, "СхемаКредитования");
		ТЗКолВставки.Свернуть("СхемаКредитования");
		ТЗКолВставки.Сортировать("СхемаКредитования Возр");
		
		Для каждого СтрКолС Из ТЗКолСтавки Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", СтрКолС.СхемаКредитования);
			
			МСтрокС = ТЗСтавки.НайтиСтроки(Отбор);
			
			МаксКолСтавки = Макс(МаксКолСтавки, МСтрокС.Количество());
		КонецЦикла;
		
		Для каждого СтрКолВ Из ТЗКолВставки Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("СхемаКредитования", СтрКолВ.СхемаКредитования);
			
			МСтрокВ = ТЗВставки.НайтиСтроки(Отбор);
			
			МаксКолВставки = Макс(МаксКолВставки, МСтрокВ.Количество());
		КонецЦикла;
		
		//КолКолонок = Макс(ТЗСтавки.Количество(), ТЗВставки.Количество());
		КолКолонок = Макс(МаксКолСтавки, МаксКолВставки);
		ДобавитьКолонок = ?(МаксКолВставки > 4, 4, 3);
		
		Если КолКолонок < 10 Тогда
			КолКолонок = 10;
		КонецЕсли;
		
		ПорядковыйНомер = 0;
		
		Если ТЗЗалогодателиБезУсловий.Количество() > 0 Тогда
			
			ТЗДанныеЗалогодателя = ПолучитьДанныеЗалогодателя(ТЗЗалогодателиБезУсловий.Скопировать(, "Залогодатель"), НачалоДня(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата));
			
			Макет = ПолучитьМакет("ПФ_MXL_ПриказУстановкиВИП");
			
			// Формируем основную часть. 
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка|КолонкаОсновная");
			ОбластьШапкаПусто = Макет.ПолучитьОбласть("Шапка|КолонкаШапкаПусто");
			ОбластьШапкаНомер = Макет.ПолучитьОбласть("Шапка|КолонкаШапкаНомер");
			ОбластьШапкаТекст = Макет.ПолучитьОбласть("ТекстЗаемщик|КолонкаОсновная");
			ОбластьШапкаЗ = Макет.ПолучитьОбласть("ШапкаЗаемщик|КолонкаОсновная");
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			
