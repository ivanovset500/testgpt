								ИначеЕсли ПорядковыйНомер = 0 Тогда
									ОбластьТекстМеталлыСК.Параметры.Нпп = "3.1 ";
									ПорядковыйНомер = 2;
								КонецЕсли;
								
								ОбластьТекстМеталлыСК.Параметры.НаименованиеСК = СтрСК.СхемаКредитования.НаименованиеДляПечати;
								ТабличныйДокумент.Вывести(ОбластьТекстМеталлыСК);
								Инд = Инд + 1;
							КонецЕсли;
							
							НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
							
