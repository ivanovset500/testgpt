							//	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
							//КонецЕсли;
							//
							
							ТабличныйДокумент.Вывести(ОбластьЗаголовокМеталлы);
							
							//Заполняем шапку заголовка таблицы
