	Если ТипЗнч(Залогодатели) = Тип("СправочникСсылка.ЛБ_Сотрудники") Тогда
		Запрос.УстановитьПараметр("Залогодатель", Залогодатели);
		
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Возврат Результат.Пол;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Для каждого СтрЗ Из Залогодатели Цикл
			Запрос.УстановитьПараметр("Залогодатель", СтрЗ.Залогодатель);
			
			Результат = Запрос.Выполнить().Выгрузить();
			
			Если Результат.Количество() > 0 Тогда
				Если Нпп = 1 Тогда
					ТЗВозврата = Результат.Скопировать();
				Иначе
					НоваяСтр = ТЗВозврата.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, Результат[0]);
				КонецЕсли;
			КонецЕсли;
			
			Нпп = Нпп + 1;
		КонецЦикла;
	КонецЕсли;
	
	Если ТЗВозврата <> Неопределено И ТЗВозврата.Количество() > 0 Тогда
		Возврат ТЗВозврата;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

