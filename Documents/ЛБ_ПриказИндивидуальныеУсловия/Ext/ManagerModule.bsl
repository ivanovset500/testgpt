					ОбластьТекстСтавки = Макет.ПолучитьОбласть("ТекстСтавки|КолонкаОсновная");
					
					Если ПорядковыйНомер = 0 Тогда
						ОбластьТекстСтавки.Параметры.Нпп = "3.1 ";
						ПорядковыйНомер = 1;
