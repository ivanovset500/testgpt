Функция СвормироватьСтрокуОтменяемыхПриказов(ТЗ)
	
	ТЗНомеров = ТЗ.Скопировать(, "НомерПриказа, ДатаДокумента");
	ТЗНомеров.Свернуть("НомерПриказа, ДатаДокумента");
	
	СтрокаВозврата = "";
	НомераИДаты = "";

	Если ТЗНомеров.Количество() > 1 Тогда
		СтрокаВозврата = "ами ";
	Иначе
		СтрокаВозврата = "ом ";
	КонецЕсли;
	
	Для каждого СтрТЗ Из ТЗНомеров Цикл
		Если НомераИДаты <> "" Тогда
			НомераИДаты = НомераИДаты + ", ";
		КонецЕсли;
		
		НомераИДаты = НомераИДаты + "№ " + СтрТЗ.НомерПриказа + " от " + Формат(СтрТЗ.ДатаДокумента, "ДФ=dd.MM.yyyy") + "г.";
	КонецЦикла;
	
	Возврат СтрокаВозврата + НомераИДаты;
	
КонецФункции
