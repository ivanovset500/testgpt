							Если ТЗОтнМет.Количество() > 1 Тогда
								ТабличныйДокумент.Область(НомерСтр - 2, 3, НомерСтр - 1, НомерКолонки + ТЗОтнМет.Количество()).Объединить();
								
								ПромежуточнаяТабМет = ТаблицаМеталловОтн.Скопировать();
								КоличествоМеталлов = ТЗОтнМет.Количество();
								
								ТЗРезультат = ПромежуточнаяТабМет.Скопировать(,"КатегорияОбъектаЗалога, ЗначениеОтклонения");
								ТЗРезультат.Очистить();
								
								Для Сч = 0 По КоличествоМеталлов - 1 Цикл
									Отбор = Новый Структура;
