				ТабличныйДокумент.Область(НомерСтр - 1, 1, НомерСтр - 1, КолКолонок + ДобавитьКолонок).Объединить(); //Было КолКолонок + 2
				ТабличныйДокумент.Область(НомерСтр, 1, НомерСтр, КолКолонок + ДобавитьКолонок).Объединить();
				
				Нпп = Нпп + 1;
			КонецЦикла;
			
			ОбластьШапкаПодвал = Макет.ПолучитьОбласть("ШапкаПодвал|КолонкаОсновная");
			ТабличныйДокумент.Вывести(ОбластьШапкаПодвал);
			
			НомПП = 1;
			
			//Заполняем ставки
			Если ТЗСК.Количество() > 0 Тогда
				
