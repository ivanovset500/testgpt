	               |	РегистрСведений.ЛБ_ГруппыЛомбардов.СрезПоследних(&Дата, Ломбард В (&Ломбарды)) КАК ЛБ_ГруппыЛомбардовСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Период УБЫВ";
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();   
	
	ТаблицаЛомбардов = Новый ТаблицаЗначений;
	ТаблицаЛомбардов.Колонки.Добавить("Группа");
	ТаблицаЛомбардов.Колонки.Добавить("Ломбард");
	
