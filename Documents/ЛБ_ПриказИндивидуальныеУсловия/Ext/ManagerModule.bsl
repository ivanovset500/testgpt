Функция ПолучитьВыборкуПрейскурантаЦен(Регистраторы)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛБ_ПрейскурантЦенНаМеталлы.Регистратор КАК Регистратор,
		|	ЛБ_ПрейскурантЦенНаМеталлы.Проба.Владелец КАК Металл,
		|	ЛБ_ПрейскурантЦенНаМеталлы.Проба КАК Проба,
		|	ЛБ_ПрейскурантЦенНаМеталлы.Категория КАК Категория,
		|	ЕСТЬNULL(ЛБ_ПрейскурантЦенНаМеталлы.Цена, 0) КАК Цена
		|ИЗ
		|	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы КАК ЛБ_ПрейскурантЦенНаМеталлы
		|ГДЕ
		|	ЛБ_ПрейскурантЦенНаМеталлы.Регистратор В(&Регистраторы)";
	
	Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();  
	ТаблицаЗапроса.Колонки.Добавить("ГруппаМеталл"); 
	
	Для каждого стр Из ТаблицаЗапроса Цикл  
		ГруппаМ = ЛБ_ОбщийМодуль.ПолучитьГруппуПроб(стр.Проба);
		Стр.ГруппаМеталл = ?(ГруппаМ = неопределено, стр.Металл, ГруппаМ);
	Конеццикла;
	Возврат ТаблицаЗапроса;
	
КонецФункции

