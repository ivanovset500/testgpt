									Для каждого СтрПромежуточная Из ПромежуточнаяТабВст Цикл
										Стр = ТЗРезультат.Получить(0);
										Стр["ЗначениеОтклонения" + Сч] = СтрПромежуточная.ЗначениеОтклонения;
									КонецЦикла;
								КонецЦикла;
							Иначе
								ТЗРезультат = ТЗАбсВст.Скопировать();
							КонецЕсли;
							
							Для каждого СтрРез Из ТЗРезультат Цикл
								ОбластьСтрокаВставки = Макет.ПолучитьОбласть("СтрокаВставки|КолонкаОсновная");
								ОбластьСтрокаВставкиДоп = Макет.ПолучитьОбласть("СтрокаВставки|КолонкаДопВ");
								
								ОбластьСтрокаВставки.Параметры.Камень = СтрРез.ВидВставки.Наименование;
								ТабличныйДокумент.Вывести(ОбластьСтрокаВставки);
								
								Если ТЗАбсВст.Количество() > 1 Тогда
									КоличествоКамней = ТЗАбсВст.Количество();
									Для Сч = 0 По КоличествоКамней - 1 Цикл
										Если Сч = 0 Тогда
											ОбластьСтрокаВставкиДоп.Параметры.ЗнчОтклонения = СтрРез.ЗначениеОтклонения;
										Иначе
											ОбластьСтрокаВставкиДоп.Параметры.ЗнчОтклонения = СтрРез["ЗначениеОтклонения" + Сч];
										КонецЕсли;
										
										ТабличныйДокумент.Присоединить(ОбластьСтрокаВставкиДоп);
									КонецЦикла;
								Иначе
									ОбластьСтрокаВставкиДоп.Параметры.ЗнчОтклонения = СтрРез.ЗначениеОтклонения;
									ТабличныйДокумент.Присоединить(ОбластьСтрокаВставкиДоп);
								КонецЕсли;
							КонецЦикла;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			//Выводим подвал
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал|КолонкаОсновная");
			ОбластьПодвалПодписант = Макет.ПолучитьОбласть("Подвал|КолонкаСтавка");
			ОбластьПодвалПусто = Макет.ПолучитьОбласть("Подвал|КолонкаШапкаПусто");
			
			ОбластьПодвал.Параметры.НачальникОРБ = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОРБ.Наименование);
			ОбластьПодвал.Параметры.ДатаДокумента = Формат(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, "ДФ=dd.MM.yyyy") + " г.";
			ОбластьПодвал.Параметры.НачальникОтделения = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОтделения.Наименование);
			ОбластьПодвал.Параметры.ДатаНачалаДействия = ?(ВыборкаДанныеДокументов.ДатаОкончанияДействияПриказа = Дата(1,1,1),
			"постоянно, с " + Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy") + " г.",
			"на период с " + Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy") + " г."
			+ " по " + Формат(ВыборкаДанныеДокументов.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy") + " г.");
			
			//ОбластьПодвал.Параметры.НачальникОДО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОДО.Наименование);
			ОбластьПодвал.Параметры.НачальникОДО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СклонениеПредставленийОбъектов.ПросклонятьФИО(
				ВыборкаДанныеДокументов.НачальникОДО.Наименование, 2,,));
				
			ОбластьПодвал.Параметры.Должность = ВыборкаДанныеДокументов.ПодписантДолжность;
			
			//СтрокиДокумента = Новый Массив;
			//СтрокиДокумента.Добавить(ОбластьПодвал);
			//
			//Если НЕ ТабличныйДокумент.ПроверитьВывод(СтрокиДокумента) Тогда
			//	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			//КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
			Для Сч = 1 По 3 Цикл
				ТабличныйДокумент.Присоединить(ОбластьПодвалПусто);
			КонецЦикла;
			
			ОбластьПодвалПодписант.Параметры.Подписал = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.ПодписантФИО.Наименование);
			ТабличныйДокумент.Присоединить(ОбластьПодвалПодписант); 
			
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			ТабличныйДокумент.Область(НомерСтр - 10, 1, НомерСтр - 10, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 9, 1, НомерСтр - 9, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 8, 1, НомерСтр - 8, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 7, 1, НомерСтр - 7, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 6, 1, НомерСтр - 6, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 5, 1, НомерСтр - 5, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 4, 1, НомерСтр - 4, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 3, 1, НомерСтр - 3, КолКолонок + ДобавитьКолонок).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 2, 1, НомерСтр - 2, КолКолонок + ДобавитьКолонок).Объединить();			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции     

Функция ПечатьПриказаОтменыВИП(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ПриказОтмены";
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	//ТабличныйДокумент.Защита = Истина;
		
	ВыборкаДанныеДокументов = ПолучитьВыборкуДанныхОтмены(МассивОбъектов);
	
	ТЗЗалогодателиСУсловиями = Новый ТаблицаЗначений;
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("Залогодатель");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ИспользуютсяСтавки");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ИспользуютсяМаталлы");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ИспользуютсяВставки");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ДокументСтавки");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ДокументМеталлы");
	ТЗЗалогодателиСУсловиями.Колонки.Добавить("ДокументВставки");
	
	Если ВыборкаДанныеДокументов.Следующий() Тогда  
		
		ТЗЗалогодатели = ВыборкаДанныеДокументов.Залогодатели.Выгрузить();

		ТЗСтавки = ВыборкаДанныеДокументов.СтавкиПроцентов.Выгрузить();
		ТЗМеталлы = ВыборкаДанныеДокументов.НастройкаОтклоненийОтБазовыхЦенМеталлы.Выгрузить();
		ТЗВставки = ВыборкаДанныеДокументов.НастройкаОтклоненийОтБазовыхЦенВставки.Выгрузить();
		ТЗСК = ВыборкаДанныеДокументов.СхемыКредитования.Выгрузить();
		
		ТЗСК.Сортировать("СхемаКредитования Возр");
		
		//Удаляем строки без отклонений
		МассивУдаленияСтрокТЗМ = Новый Массив;
		
		Тест = Новый ТаблицаЗначений;
		
		Для каждого СтрМ Из ТЗМеталлы Цикл
			Если НЕ ЗначениеЗаполнено(СтрМ.ОтклонениеОтБазовойЦены) Тогда
				МассивУдаленияСтрокТЗМ.Добавить(СтрМ)
			КонецЕсли;
		КонецЦикла;
		
		Если МассивУдаленияСтрокТЗМ.Количество() > 0 Тогда
			Для каждого СтрМ Из МассивУдаленияСтрокТЗМ Цикл
				ТЗМеталлы.Удалить(СтрМ);
			КонецЦикла;
		КонецЕсли;
		
		КолКолонок = Макс(ТЗСтавки.Количество(), ТЗВставки.Количество());
		
		Если КолКолонок < 10 Тогда
			КолКолонок = 10;
		КонецЕсли;
			
			ТЗДанныеЗалогодателя = ПолучитьДанныеЗалогодателя(ТЗЗалогодатели.Скопировать(, "Залогодатель"), НачалоДня(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата));
			
			Макет = ПолучитьМакет("ПФ_MXL_ПриказОтмены");
			
			// Формируем основную часть. 
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка|КолонкаОсновная");
			ОбластьШапкаПусто = Макет.ПолучитьОбласть("Шапка|КолонкаШапкаПусто");
			ОбластьШапкаНомер = Макет.ПолучитьОбласть("Шапка|КолонкаШапкаНомер");
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			
			ОбластьШапка.Параметры.ДатаПриказа = Формат(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, "ДФ=dd.MM.yyyy") + " г.";
			СклонениеОтделения = ПолучитьСклоненияСтроки(ВыборкаДанныеДокументов.Отделение.Наименование, "Л=ru_RU", "ПД=Родительный");

			Если СклонениеОтделения.Количество() > 0 Тогда
				ОбластьШапка.Параметры.Отделение = СклонениеОтделения[0];
			КонецЕсли;
			
			//ПолНачальника = ПолучитьДанныеЗалогодателя(ВыборкаДанныеДокументов.НачальникОтделения, НачалоДня(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата));
			ОбластьШапка.Параметры.ФИОНачальника = СклонениеПредставленийОбъектов.ПросклонятьФИО(
				ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОтделения.Наименование), 2,,);

			//Убрал пол т.к. по сотрудникам нет этой информации.
				//ВыборкаДанныеДокументов.НачальникОтделения, ?(ПолНачальника = Перечисления.ПолФизическогоЛица.Мужской, 1, 2));
			//
			
			ОбластьШапка.Параметры.ДатаОтмены = Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy") + " г.";
			
			ТекстУсловия = "";
			
			Если ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтменаСтавок Тогда
				ТекстУсловия = "по процентным ставкам за пользование займом";
			КонецЕсли;
			
			Если ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтменаМеталлов Тогда
				ТекстУсловия = ?(ТекстУсловия = "", "по условиям оценки драгоценных металлов", ТекстУсловия + ", по условиям оценки драгоценных металлов");
			КонецЕсли;
			
			Если ВыборкаДанныеДокументов.СсылкаНаДокумент.ОтменаВставкок Тогда
				ТекстУсловия = ?(ТекстУсловия = "", "по условиям оценки драгоценных камней", ТекстУсловия + ", по условиям оценки драгоценных камней");
			КонецЕсли;
			
			ОбластьШапка.Параметры.ТекстУсловия = ТекстУсловия;
			//+МАН 25.11.25 Изменил
			//ОбластьШапка.Параметры.НомерПриказаУстановкиУсловий = ВыборкаДанныеДокументов.ОтменяемыйПриказ.НомерПриказа;
			//ОбластьШапка.Параметры.ДатаПриказаУстановкиУсловий = Формат(ВыборкаДанныеДокументов.ОтменяемыйПриказ.Дата, "ДФ=dd.MM.yyyy") + " г.";
			ОбластьШапка.Параметры.НомерПриказаУстановкиУсловий = СвормироватьСтрокуОтменяемыхПриказов(ВыборкаДанныеДокументов.ОтменяемыеПриказы.Выгрузить());
			//-МАН

			Если ТЗДанныеЗалогодателя.Количество() > 1 Тогда
				ОбластьШапка.Параметры.ТекстКлиент = "клиентам";
			Иначе
				ОбластьШапка.Параметры.ТекстКлиент = "клиенту";
			КонецЕсли;	
			
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			Для Сч = 1 По КолКолонок-1 Цикл
				ТабличныйДокумент.Присоединить(ОбластьШапкаПусто);
			Конеццикла;
			
			ОбластьШапкаНомер.Параметры.НомерПриказа = ВыборкаДанныеДокументов.НомерПриказа; 
			ТабличныйДокумент.Присоединить(ОбластьШапкаНомер); 
			
			ТабличныйДокумент.Область(НомерСтр + 2, 1, НомерСтр + 2, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 3, 1, НомерСтр + 3, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 5, 1, НомерСтр + 5, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 9, 1, НомерСтр + 9, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 10, 1, НомерСтр + 10, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 12, 1, НомерСтр + 12, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр + 14, 1, НомерСтр + 14, КолКолонок + 3).Объединить();
			
			Нпп = 1;
			
			Для каждого СтрЗ Из ТЗДанныеЗалогодателя Цикл
				ОбластьШапкаЗаемщик = Макет.ПолучитьОбласть("ШапкаЗаемщик|КолонкаОсновная");
				
				ОбластьШапкаЗаемщик.Параметры.Нпп = ?(ТЗДанныеЗалогодателя.Количество() > 1, "1." + Нпп + " ", "");
				ОбластьШапкаЗаемщик.Параметры.Залогодатель = СтрЗ.Залогодатель.Наименование;
				ОбластьШапкаЗаемщик.Параметры.Датарождения = Формат(СтрЗ.ДатаРождения, "ДФ=dd.MM.yyyy");
				//ОбластьШапкаЗаемщик.Параметры.ПаспортныеДанные = "" + СтрЗ.ДокументЗалогодателя // + ", выдан "
				////+ Формат(СтрЗ.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")
				//+ ", " + СтрЗ.ДокументКемВыдан + " " + СтрЗ.ДокументКодПодразделения;
				ОбластьШапкаЗаемщик.Параметры.ПаспортныеДанные = "" + СтрЗ.ВидДокумента
				+ ?(ЗначениеЗаполнено(СтрЗ.Серия), " серия " + СтрЗ.Серия, "")
				+ " №" + СтрЗ.Номер + ", выдан " + Формат(СтрЗ.ДатаВыдачи, "ДФ=dd.MM.yyyy") + " г. "
				+ СтрЗ.КемВыдан + ?(ЗначениеЗаполнено(СтрЗ.КодПодразделения), ", код подразделения " + СтрЗ.КодПодразделения, "")
				+ ?(ЗначениеЗаполнено(СтрЗ.СрокДействия), ", срок действия " + Формат(СтрЗ.СрокДействия, "ДФ=dd.MM.yyyy") + " г. ", "");
				
				ТабличныйДокумент.Вывести(ОбластьШапкаЗаемщик);
				
				НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
				
				ТабличныйДокумент.Область(НомерСтр - 1, 1, НомерСтр - 1, КолКолонок + 2).Объединить();
				ТабличныйДокумент.Область(НомерСтр, 1, НомерСтр, КолКолонок + 2).Объединить();
				
				Нпп = Нпп + 1;
			КонецЦикла;
			
			//Выводим подвал
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал|КолонкаОсновная");
			ОбластьПодвалПодписант = Макет.ПолучитьОбласть("Подвал|КолонкаСтавка");
			ОбластьПодвалПусто = Макет.ПолучитьОбласть("Подвал|КолонкаШапкаПусто");
			
			ОбластьПодвал.Параметры.Дата = Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy") + " г.";
			
			Если ТЗДанныеЗалогодателя.Количество() > 1 Тогда
				ОбластьПодвал.Параметры.ТекстКлиент = "указанным клиентам";
			Иначе
				ОбластьПодвал.Параметры.ТекстКлиент = "указанному клиенту";
			КонецЕсли;
			
			ОбластьПодвал.Параметры.НачальникОРБ = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОРБ.Наименование);
			ОбластьПодвал.Параметры.ДатаДокумента = Формат(ВыборкаДанныеДокументов.СсылкаНаДокумент.Дата, "ДФ=dd.MM.yyyy") + " г.";
			ОбластьПодвал.Параметры.НачальникОтделения = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОтделения.Наименование);;
			ОбластьПодвал.Параметры.ДатаНачалаДействия = ?(ВыборкаДанныеДокументов.ДатаОкончанияДействияПриказа = Дата(1,1,1),
			"постоянно, с " + Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy") + " г.",
			"на период с " + Формат(ВыборкаДанныеДокументов.ДатаНачалаДействияПриказа, "ДФ=dd.MM.yyyy") + " г."
			+ " по " + Формат(ВыборкаДанныеДокументов.ДатаОкончанияДействияПриказа, "ДФ=dd.MM.yyyy") + " г.");
			
			//ОбластьПодвал.Параметры.НачальникОДО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.НачальникОДО.Наименование);
			ОбластьПодвал.Параметры.НачальникОДО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СклонениеПредставленийОбъектов.ПросклонятьФИО(
				ВыборкаДанныеДокументов.НачальникОДО.Наименование, 2,,));
				
			ОбластьПодвал.Параметры.Должность = ВыборкаДанныеДокументов.ПодписантДолжность;
			
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
			Для Сч = 1 По 3 Цикл
				ТабличныйДокумент.Присоединить(ОбластьПодвалПусто);
			КонецЦикла;
			
			ОбластьПодвалПодписант.Параметры.Подписал = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеДокументов.ПодписантФИО.Наименование);
			ТабличныйДокумент.Присоединить(ОбластьПодвалПодписант); 
			
			НомерСтр = ТабличныйДокумент.ВысотаТаблицы;
			ТабличныйДокумент.Область(НомерСтр - 10, 1, НомерСтр - 10, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 9, 1, НомерСтр - 9, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 8, 1, НомерСтр - 8, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 7, 1, НомерСтр - 7, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 6, 1, НомерСтр - 6, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 5, 1, НомерСтр - 5, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 4, 1, НомерСтр - 4, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 3, 1, НомерСтр - 3, КолКолонок + 3).Объединить();
			ТабличныйДокумент.Область(НомерСтр - 2, 1, НомерСтр - 2, КолКолонок + 3).Объединить();			
		//КонецЕсли;
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции     

Функция ПолучитьБазовыеЦеныМеталлы(Дата)
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Проба");
	СтруктураВозврата.Вставить("Категория");

    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлыСрезПоследних.Проба КАК Проба,
	               |	ЛБ_БазовыеЦеныНаДрагоценныеМеталлыСрезПоследних.КатегорияОбъектаЗалога КАК Категория
	               |ИЗ
	               |	РегистрСведений.ЛБ_БазовыеЦеныНаДрагоценныеМеталлы.СрезПоследних(&Дата, ) КАК ЛБ_БазовыеЦеныНаДрагоценныеМеталлыСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать(); 
	Если Выборка.Следующий() Тогда 
		СтруктураВозврата.Вставить("Проба", Выборка.Проба);
	    СтруктураВозврата.Вставить("Категория", Выборка.Категория);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
КонецФункции

Функция ПолучитьТаблицуРегистраторов(Регистратор)
	ТаблицаРегистраторов = Новый ТаблицаЗначений;
	ТаблицаРегистраторов.Колонки.Добавить("Ломбард"); 
	ТаблицаРегистраторов.Колонки.Добавить("Группа");
	ТаблицаРегистраторов.Колонки.Добавить("РегистраторМеталлы");
	ТаблицаРегистраторов.Колонки.Добавить("РегистраторВставки"); 
	ТаблицаРегистраторов.Колонки.Добавить("РегистраторСтавки");
		
	Ломбарды = Регистратор.Ломбарды.ВыгрузитьКолонку("Ломбард"); 
	Если Ломбарды.Количество() = 0 Тогда 
		ЗапросЛ = Новый Запрос;
		ЗапросЛ.Текст = "ВЫБРАТЬ
		                |	ЛБ_Ломбарды.Ссылка КАК Ссылка
		                |ИЗ
		                |	Справочник.ЛБ_Ломбарды КАК ЛБ_Ломбарды
		                |ГДЕ
		                |	ЛБ_Ломбарды.ЭтоГруппа = ЛОЖЬ
		                |	И ЛБ_Ломбарды.Закрыт = ЛОЖЬ";
		ВыборкаЛ = ЗапросЛ.Выполнить().Выбрать();
		Пока ВыборкаЛ.Следующий() Цикл 
			Ломбарды.Добавить(ВыборкаЛ.Ссылка);
		КонецЦикла;	
	КонецЕсли;	
		
	ЗапросЛ = Новый Запрос; 
	ЗапросЛ.УстановитьПараметр("Дата", Регистратор.Дата);
	ЗапросЛ.УстановитьПараметр("Ломбарды", Ломбарды);
	ЗапросЛ.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Группа КАК Группа
	               |ИЗ
	               |	РегистрСведений.ЛБ_ГруппыЛомбардов.СрезПоследних(&Дата, Ломбард В (&Ломбарды)) КАК ЛБ_ГруппыЛомбардовСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ГруппыЛомбардовСрезПоследних.Период УБЫВ";
	ТаблицаЛомбардов = ЗапросЛ.Выполнить().Выгрузить();   
		
	Для каждого СтрЛ Из ТаблицаЛомбардов Цикл
	    НоваяСтр = ТаблицаРегистраторов.Добавить();
		НоваяСтр.Ломбард = СтрЛ.Ломбард; 
		НоваяСтр.Группа = СтрЛ.Группа;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Регистратор.Дата);
	Запрос.УстановитьПараметр("ДатаНачалаДействия", Регистратор.ДатаНачалаДействияПриказа);
	Запрос.УстановитьПараметр("Ломбарды", Ломбарды);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаМеталлы.СрезПоследних(
	               |			&Дата,
	               |			Ломбард В (&Ломбарды)
	               |				И ДатаНачалаДействия <= &ДатаНачалаДействия) КАК ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаМеталлыСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЭлементМассива Из Ломбарды Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", ЭлементМассива);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если НЕ строки.Количество() = 0 Тогда
		    Стр = Строки.Получить(0);
		    РегистраторМеталлы = Стр.Регистратор;
			
			СтрокиР = ТаблицаРегистраторов.НайтиСтроки(Отбор); 
			Если СтрокиР.Количество() = 0 Тогда
				СтрР = ТаблицаРегистраторов.Добавить();
				СтрР.Ломбард = ЭлементМассива; 
				СтрР.Группа = Справочники.ЛБ_ГруппыЛомбардов.ПустаяСсылка();
			Иначе	
			    СтрР = СтрокиР.Получить(0);
			КонецЕсли;	
		    СтрР.РегистраторМеталлы = РегистраторМеталлы;
		КонецЕсли;	
	Конеццикла;	     
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантЦенНаДрагоценныеКамни.СрезПоследних(
	               |			&Дата,
	               |			Ломбард В (&Ломбарды)
	               |				И ДатаНачалаДействия <= &ДатаНачалаДействия) КАК ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантЦенНаДрагоценныеКамниСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЭлементМассива Из Ломбарды Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", ЭлементМассива);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если НЕ строки.Количество() = 0 Тогда
		    Стр = Строки.Получить(0);
		    РегистраторВставки = Стр.Регистратор;
			
			СтрокиР = ТаблицаРегистраторов.НайтиСтроки(Отбор);  
			Если СтрокиР.Количество() = 0 Тогда
				СтрР = ТаблицаРегистраторов.Добавить();
				СтрР.Ломбард = ЭлементМассива; 
				СтрР.Группа = Справочники.ЛБ_ГруппыЛомбардов.ПустаяСсылка();
			Иначе	
			    СтрР = СтрокиР.Получить(0); 
			КонецЕсли;	
		    СтрР.РегистраторВставки = РегистраторВставки;
		КонецЕсли;	
	Конеццикла;	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Ломбард КАК Ломбард,
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.ЛБ_ПрейскурантПроцентныхСтавок.СрезПоследних(
	               |			&Дата,
	               |			Ломбард В (&Ломбарды)
	               |				И ДатаНачалаДействия <= &ДатаНачалаДействия) КАК ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЛБ_ПрейскурантПроцентныхСтавокСрезПоследних.Период УБЫВ"; 
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для каждого ЭлементМассива Из Ломбарды Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Ломбард", ЭлементМассива);
		
		Строки = ТаблицаЗапроса.НайтиСтроки(Отбор); 
		Если НЕ строки.Количество() = 0 Тогда
		    Стр = Строки.Получить(0);
		    РегистраторСтавки = Стр.Регистратор;
			
			СтрокиР = ТаблицаРегистраторов.НайтиСтроки(Отбор); 
			Если СтрокиР.Количество() = 0 Тогда
				СтрР = ТаблицаРегистраторов.Добавить();
				СтрР.Ломбард = ЭлементМассива; 
				СтрР.Группа = Справочники.ЛБ_ГруппыЛомбардов.ПустаяСсылка();
			Иначе	
			    СтрР = СтрокиР.Получить(0);  
			КонецЕсли;	
		    СтрР.РегистраторСтавки = РегистраторСтавки;
		КонецЕсли;	
	Конеццикла;	

	Возврат ТаблицаРегистраторов;
КонецФункции

Функция ПолучитьВыборкуДанныхДокумента(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
