							КонецЕсли;
							
							//Заполняем строки
							Для каждого СтрРез Из ТЗРезультат Цикл
								ОбластьСтрокаМеталлы = Макет.ПолучитьОбласть("СтрокаМеталлы|КолонкаОсновная");
								ОбластьСтрокаМеталлыДоп = Макет.ПолучитьОбласть("СтрокаМеталлы|КолонкаДопВ");
								
