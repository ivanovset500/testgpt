
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ЗаполнитьОтборыРегистров()
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда				
		Отбор = ДокументыЗалогодателя.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументЗалогодателя.Владелец");
	    Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	    Отбор.Использование  = Истина;
	    Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
	    Отбор.ПравоеЗначение = Объект.Ссылка;
		
		Отбор = КонтактнаяИнформацияЗалогодателя.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Залогодатель");
	    Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	    Отбор.Использование  = Истина;
	    Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
	    Отбор.ПравоеЗначение = Объект.Ссылка;
	КонецЕсли;	
	
КонецПроцедуры
	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Если РольДоступна("ПриемщикЛомбарда")
	//	И Не РольДоступна("ПолныеПрава") Тогда
	//	
	//	ТолькоПросмотр = Истина;
	//	
	//КонецЕсли;
	
	ЗаполнитьОтборыРегистров();
	Для каждого Элемент Из УсловноеОформление.Элементы Цикл
		Для каждого ЭлементОтбор Из Элемент.Отбор.Элементы Цикл
			ЭлементОтбор.ПравоеЗначение = ТекущаяДата();
		КонецЦикла;	
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаименование()
	Объект.Наименование = СокрЛП(Объект.Фамилия) + " " + СокрЛП(Объект.Имя) + " " + СокрЛП(Объект.Отчество);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ЗаполнитьОтборыРегистров();
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьДоступность()
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.ГруппаДокумент.Доступность = Истина;
		Элементы.ГруппаКонтактныеДанные.Доступность = Истина;
	Иначе
		Элементы.ГруппаДокумент.Доступность = ложь;
		Элементы.ГруппаКонтактныеДанные.Доступность = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьДоступность();
КонецПроцедуры

