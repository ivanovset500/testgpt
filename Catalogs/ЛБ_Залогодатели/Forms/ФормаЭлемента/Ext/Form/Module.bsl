&НаКлиенте
Процедура ФамилияПриИзменении(Элемент)
	Объект.Фамилия = ТРег(Объект.Фамилия);
	СформироватьНаименование();
КонецПроцедуры

&НаКлиенте
Процедура ИмяПриИзменении(Элемент)
	Объект.Имя = ТРег(Объект.Имя);
	СформироватьНаименование();
КонецПроцедуры

&НаКлиенте
Процедура ОтчествоПриИзменении(Элемент)
	Объект.Отчество = ТРег(Объект.Отчество);
	СформироватьНаименование();
КонецПроцедуры

&НаСервере
Функция ПроверитьФИОЗалогодателя(Фамилия, Имя, Отчество)
    //Проверим правильность заполнения ФИО
	СтруктураВозврата = ЛБ_ОбщийМодуль.ПроверитьФИОЗалогодателя(Фамилия, Имя, Отчество);
	Если НЕ СтруктураВозврата.Результат Тогда
		Сообщить(СтруктураВозврата.Сообщение, СтатусСообщения.Важное);
	КонецЕсли;
	Возврат СтруктураВозврата.Результат;
КонецФункции

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НЕ ПроверитьФИОЗалогодателя(Объект.Фамилия, Объект.Имя, Объект.Отчество) Тогда
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры


