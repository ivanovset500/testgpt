Процедура ОценкаПоБазовойКатегорииЗначениеОтклоненияПриИзменении(Элемент)
	// проверим что для  базовой пробы и базовой категории отклонение = 0
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОтклонение(Команда)     
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("Вид", 0);
	ОбработкаВыбора = Новый ОписаниеОповещения("ПослеВыбораОтклонения", ЭтаФорма);
	ОткрытьФорму("Справочник.ЛБ_СценарииОценки.Форма.ФормаЗаполненияОтклонения", ПараметрыФормы, ЭтаФорма,,,,ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОтклонения(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;      
	
	Отбор = Новый Структура; 
	Если ЗначениеЗаполнено(Результат.Металл) Тогда
	    Отбор.Вставить("Металл", Результат.Металл);
    КонецЕсли;  
	Если ЗначениеЗаполнено(Результат.Проба) Тогда
	    Отбор.Вставить("Проба", Результат.Проба);
    КонецЕсли;  
    Если ЗначениеЗаполнено(Результат.Категория) Тогда
	   Отбор.Вставить("КатегорияОбъектаЗалога", Результат.Категория);
    КонецЕсли;    
    Если Отбор.Количество() = 0 Тогда	
		Для каждого Стр Из Объект.ОценкаПоБазовойКатегории Цикл
			ОтборБ = Новый Структура;
			ОтборБ.Вставить("БазоваяПроба", Стр.Проба); 
			ОтборБ.Вставить("БазоваяКатегория", Стр.КатегорияОбъектаЗалога); 
			СтрокиБ = Объект.БазовыеНастройки.НайтиСтроки(ОтборБ);
			Если НЕ СтрокиБ.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;	
			Стр.ЗначениеОтклонения = Результат.Отклонение;
		КонецЦикла;	
    Иначе
	   Строки = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор);
	   Для каждого Стр Из Строки Цикл	
		   ОтборБ = Новый Структура;
		   ОтборБ.Вставить("БазоваяПроба", Стр.Проба); 
		   ОтборБ.Вставить("БазоваяКатегория", Стр.КатегорияОбъектаЗалога); 
		   СтрокиБ = Объект.БазовыеНастройки.НайтиСтроки(ОтборБ);
	       Если НЕ СтрокиБ.Количество() = 0 Тогда
			   Продолжить;
		   КонецЕсли;	
		   Стр.ЗначениеОтклонения = Результат.Отклонение;		   
	   КонецЦикла;	
	КонецЕсли;   
КонецПроцедуры


&НаКлиенте
Процедура БазовыеНастройкиБазоваяЦенаПоЗапросуПриИзменении(Элемент)
	ТекСтрока = Элементы.БазовыеНастройки.ТекущиеДанные;
	Если ТекСтрока.БазоваяЦенаПоЗапросу Тогда
		ТекСтрока.БазоваяЦена = 0;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ВсеОК = Истина;
	Для каждого стр Из Объект.БазовыеНастройки Цикл 
		Если НЕ Стр.БазоваяЦенаПоЗапросу И (Стр.БазоваяЦена = 0) Тогда   
			ВсеОК = Ложь;
		КонецЕсли;	
	КонецЦикла;   
	Если НЕ ВсеОк Тогда
	    Сообщить("Ошибка заполнения таблицы базовых настроек. Если не выбрано значение базовой цены по запросу, то базовая цена должна быть заполнена!");    
	    Отказ = Истина;
	КонецЕсли;  
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ВсеОк = Истина;
	Для каждого стрБ Из Объект.БазовыеНастройки Цикл 
		Отбор = Новый структура;
		Отбор.Вставить("КлючСтроки", СтрБ.КлючСтроки); 
		
		НачалоСообщения = "Ошибки заполнения настроек (" + СокрЛП(СтрБ.Металл) + "): есть незаполненные значения";
		Строки = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор); 
		БезОшибокПроба = Истина;  
		БезОшибокКатегория = Истина;  
		БезОшибокОтклонение = Истина;
		Для каждого Стр Из Строки Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Проба)Тогда
				БезОшибокПроба = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(Стр.КатегорияОбъектаЗалога) Тогда
				БезОшибокКатегория = Ложь;
			КонецЕсли;	
            Если НЕ ЗначениеЗаполнено(Стр.ОклонениеОтБазовой) Тогда
				БезОшибокОтклонение = Ложь;
			КонецЕсли;	
		Конеццикла; 
		
		Если НЕ БезОшибокПроба ИЛИ НЕ БезОшибокКатегория ИЛИ НЕ БезОшибокОтклонение Тогда  
			ТекстСообщения = НачалоСообщения; 
			Ном = 0;
			Если НЕ БезОшибокПроба Тогда 
				ТекстСообщения = ТекстСообщения + ?(Ном = 0, " ", ", ") + "пробы металла"; 
				Ном = Ном + 1;
			КонецЕсли;	
			Если НЕ БезОшибокКатегория Тогда 
				ТекстСообщения = ТекстСообщения + ?(Ном = 0, " ", ", ") + "категории объекта залога"; 
				Ном = Ном + 1;
			КонецЕсли;	
			Если НЕ БезОшибокОтклонение Тогда 
				ТекстСообщения = ТекстСообщения + ?(Ном = 0, " ", ", ") + "отклонения"; 
				Ном = Ном + 1;
			КонецЕсли;	
			Сообщить(ТекстСообщения + ".");
			ВсеОК = Ложь;
   		КонецЕсли;	
	Конеццикла;	 
	
	Если НЕ ВсеОк Тогда  
	    Отказ = Истина;
	КонецЕсли;  
КонецПроцедуры


&НаКлиенте
