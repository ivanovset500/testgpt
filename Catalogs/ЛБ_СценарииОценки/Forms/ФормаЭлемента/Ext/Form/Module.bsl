        Возврат;
	КонецЕсли; 
	
	ЗаполнитьНастройкиОтклоненийНаСервере(Результат.ТаблицаСК);
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьНастройкиОтклоненийНаСервере(ТаблицаСК)  
	Для каждого СтрК Из ТаблицаСК Цикл 
		ОтборК = Новый Структура;
		ОтборК.Вставить("СхемаКредитования", СтрК.СхемаКредитования);
		Если ЗначениеЗаполнено(СтрК.Металл) Тогда
		    ОтборК.Вставить("Металл", СтрК.Металл);  
		КонецЕсли;	
		Если ЗначениеЗаполнено(СтрК.Категория) Тогда
		    ОтборК.Вставить("КатегорияОбъектаЗалога", СтрК.Категория);  
		КонецЕсли;	
		СтрокиК = Объект.НастройкаОтклоненийОтБазовыхЦен.НайтиСтроки(ОтборК);
		Для каждого СтрКК Из СтрокиК Цикл 
			Объект.НастройкаОтклоненийОтБазовыхЦен.Удалить(СтрКК);
		Конеццикла;	   
		Отбор = Новый Структура;
        Если ЗначениеЗаполнено(СтрК.Металл) Тогда
		    Отбор.Вставить("Металл", СтрК.Металл);  
		КонецЕсли;	
		Если ЗначениеЗаполнено(СтрК.Категория) Тогда
		    Отбор.Вставить("КатегорияОбъектаЗалога", СтрК.Категория);  
		КонецЕсли;	
        Если Отбор.Количество() = 0 Тогда
			Для каждого стр Из Объект.ОценкаПоБазовойКатегории Цикл  
				НоваяСтр = Объект.НастройкаОтклоненийОтБазовыхЦен.Добавить(); 
				НоваяСтр.КлючСтроки = Стр.КлючСтроки;
				НоваяСтр.СхемаКредитования = СтрК.СхемаКредитования;  
				НоваяСтр.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога; 
				НоваяСтр.Металл = Стр.Металл; 
				НоваяСтр.Проба = Стр.Проба; 
				НоваяСтр.ОтклонениеОтБазовойЦены = СтрК.Отклонение;
				НоваяСтр.ЗначениеОтклонения = СтрК.ЗначениеОтклонения;
			Конеццикла;	  
		Иначе                         
			Строки = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор);
			Для каждого стр Из Строки Цикл  
				НоваяСтр = Объект.НастройкаОтклоненийОтБазовыхЦен.Добавить(); 
				НоваяСтр.КлючСтроки = Стр.КлючСтроки;
				НоваяСтр.СхемаКредитования = СтрК.СхемаКредитования;  
				НоваяСтр.КатегорияОбъектаЗалога = Стр.КатегорияОбъектаЗалога; 
				НоваяСтр.Металл = Стр.Металл; 
				НоваяСтр.Проба = Стр.Проба; 
				НоваяСтр.ОтклонениеОтБазовойЦены = СтрК.Отклонение;
				НоваяСтр.ЗначениеОтклонения = СтрК.ЗначениеОтклонения;
			Конеццикла;	  
		КонецЕсли;	
	КонецЦикла;		
КонецПроцедуры	

