&НаКлиенте
Процедура ПослеВыбораОтклоненияН(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
	КонецЕсли;      
	
	Отбор = Новый Структура; 
	Если ЗначениеЗаполнено(Результат.СхемаКредитования) Тогда
	    Отбор.Вставить("СхемаКредитования", Результат.СхемаКредитования);
    КонецЕсли;    
    Если ЗначениеЗаполнено(Результат.Металл) Тогда
	    Отбор.Вставить("Металл", Результат.Металл);
    КонецЕсли; 
	Если ЗначениеЗаполнено(Результат.Проба) Тогда
	    Отбор.Вставить("Проба", Результат.Проба);
    КонецЕсли;  
    Если ЗначениеЗаполнено(Результат.Категория) Тогда
	   Отбор.Вставить("КатегорияОбъектаЗалога", Результат.Категория);
    КонецЕсли;    
    Если Отбор.Количество() = 0 Тогда	
		Для каждого Стр Из Объект.НастройкаОтклоненийОтБазовыхЦен Цикл 
			Стр.ЗначениеОтклонения = Результат.Отклонение;
		КонецЦикла;	
    Иначе
	   Строки = Объект.НастройкаОтклоненийОтБазовыхЦен.НайтиСтроки(Отбор);
	   Для каждого Стр Из Строки Цикл	   
		   Стр.ЗначениеОтклонения = Результат.Отклонение;		   
	   КонецЦикла;	
	КонецЕсли;   
КонецПроцедуры


&НаКлиенте
Процедура НастройкаОтклоненийОтБазовыхЦенПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		СтрокаТабличнойЧастиНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;
	    СтрокаТабличнойЧасти       = Элементы.НастройкаОтклоненийОтБазовыхЦен.ТекущиеДанные;
	
	    СтрокаТабличнойЧасти.КлючСтроки = СтрокаТабличнойЧастиНастройки.КлючСтроки;
     КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтклоненийОтБазовыхЦенПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	СтрокаТабличнойЧастиНастройки = Элементы.НастройкаОтклоненийОтБазовыхЦен.ТекущиеДанные;
	Если СтрокаТабличнойЧастиНастройки <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиНастройки.КлючСтроки);
		Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		
	КонецЕсли;
КонецПроцедуры


