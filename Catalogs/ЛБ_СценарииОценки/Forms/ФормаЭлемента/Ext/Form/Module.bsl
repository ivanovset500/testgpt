&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда  
		Объект.Дата = ТекущаяДата();
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	ИначеЕсли ПроверитьИспользованиеСценария() Тогда                                
		ЭтаФорма.ТолькоПросмотр = Истина;  
		Элементы.ДекорацияПредупреждение.Видимость = Истина;
	КонецЕсли;	
КонецПроцедуры	 

&НаСервере
Функция ПроверитьИспользованиеСценария()
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ПриказУсловияПредоставленияЗаймов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЛБ_ПриказУсловияПредоставленияЗаймов КАК ЛБ_ПриказУсловияПредоставленияЗаймов
	               |ГДЕ
	               |	ЛБ_ПриказУсловияПредоставленияЗаймов.Проведен = ИСТИНА
	               |	И ЛБ_ПриказУсловияПредоставленияЗаймов.СценарийОценкиМеталлов = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаполнитьПробыПоБазовой(Идентификатор) 
	СтрокаТабличнойЧастиНастройки = Объект.БазовыеНастройки.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаТабличнойЧастиНастройки = неопределено Тогда
		Возврат;
	КонецЕсли;
	ЕстьОшибкиЗаполнения = ложь;
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.Металл) Тогда
		Сообщить("Строка № " + Строка(СтрокаТабличнойЧастиНастройки.НомерСтроки) + ": Не выбран металл!");
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяКатегория) Тогда
		Сообщить("Строка № " + Строка(СтрокаТабличнойЧастиНастройки.НомерСтроки) + ": Не определена базовая категория объектов залога!");
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяПроба) Тогда
		Сообщить("Строка № " + Строка(СтрокаТабличнойЧастиНастройки.НомерСтроки) + ":Не определена базовая проба (группа проб)!");
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;	 
	Если ЕстьОшибкиЗаполнения Тогда
		Возврат;
	КонецЕсли;	   
	
	ОтборК = Новый Структура;
	ОтборК.Вставить("КлючСтроки", СтрокаТабличнойЧастиНастройки.КлючСтроки);
	СтрокиК = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(ОтборК);
	Для каждого стрК из СтрокиК Цикл 
		Объект.ОценкаПоБазовойКатегории.Удалить(СтрК);
	КонецЦикла;	
	
    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БазоваяКатегория", СтрокаТабличнойЧастиНастройки.БазоваяКатегория);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_КатегорииОбъектовЗалога.Ссылка КАК Категория
	               |ИЗ
	               |	Справочник.ЛБ_КатегорииОбъектовЗалога КАК ЛБ_КатегорииОбъектовЗалога
	               |ГДЕ
	               |	ЛБ_КатегорииОбъектовЗалога.ПометкаУдаления = ЛОЖЬ
	               |АВТОУПОРЯДОЧИВАНИЕ";
	ТаблицаКатегорий = Запрос.Выполнить().Выгрузить();
	
	Запрос.УстановитьПараметр("Металл", СтрокаТабличнойЧастиНастройки.Металл);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛБ_ГруппыПроб.Ссылка КАК Проба
	               |ИЗ
	               |	Справочник.ЛБ_ГруппыПроб КАК ЛБ_ГруппыПроб
	               |ГДЕ
	               |	ЛБ_ГруппыПроб.Металл = &Металл
	               |	И ЛБ_ГруппыПроб.ПометкаУдаления = ЛОЖЬ
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		 //Отбор = Новый Структура;
		 //Отбор.Вставить("Проба", Выборка.Проба);
		 //Строки = Объект.ОценкаПоБазовойКатегории.НайтиСтроки(Отбор);
		 //Если Строки.Количество() = 0 Тогда
		 Для каждого СтрК Из ТаблицаКатегорий Цикл   				 
			 НоваяСтр = Объект.ОценкаПоБазовойКатегории.Добавить();
			 НоваяСтр.КлючСтроки = СтрокаТабличнойЧастиНастройки.КлючСтроки;
			 НоваяСтр.КатегорияОбъектаЗалога = СтрК.Категория;
			 НоваяСтр.Металл = СтрокаТабличнойЧастиНастройки.Металл;
			 НоваяСтр.Проба = Выборка.Проба; 
			 НоваяСтр.ОклонениеОтБазовой = СтрокаТабличнойЧастиНастройки.ОтклонениеОтБазовойПоУмолчанию;
			 НоваяСтр.ПорядокОкругления = СтрокаТабличнойЧастиНастройки.ПорядокОкругления;
			 НоваяСтр.ОкруглятьВБольшуюСторону = СтрокаТабличнойЧастиНастройки.ОкруглятьВБольшуюСторону;
		 Конеццикла;	 
		 //КонецЕсли;	 
	 КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗаполнитьПоБазовой(Команда) 
	СтрокаТабличнойЧастиНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;
	Если СтрокаТабличнойЧастиНастройки = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.Металл) ИЛИ 
		   НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяПроба) ИЛИ
		     НЕ ЗначениеЗаполнено(СтрокаТабличнойЧастиНастройки.БазоваяКатегория) Тогда
		Сообщить("Перед заполнением в верхней таблице должны быть выбраны металл, базовая проба и базовая категория!", СтатусСообщения.Информация);	 
	КонецЕсли;	

	ЗаполнитьПробыПоБазовой(СтрокаТабличнойЧастиНастройки.ПолучитьИдентификатор()); 
		
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧастиНастройки.КлючСтроки);
	Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
КонецПроцедуры


&НаКлиенте
Процедура БазовыеНастройкиПриАктивизацииСтроки(Элемент)
	СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущиеДанные;	
	
	Если СтрокаТабличнойЧасти <> неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",СтрокаТабличнойЧасти.КлючСтроки);
		Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);		
		Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
	Иначе
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки",0);
		Элементы.ОценкаПоБазовойКатегории.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
		Элементы.НастройкаОтклоненийОтБазовыхЦен.ОтборСтрок = НОвый ФиксированнаяСтруктура(Отбор);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОценкаВБазовойКатегорииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		СтрокаТабличнойЧастиНастройки = Элементы.БазовыеНастройки.ТекущиеДанные;
	    СтрокаТабличнойЧасти       = Элементы.ОценкаПоБазовойКатегории.ТекущиеДанные;
	
	    СтрокаТабличнойЧасти.КлючСтроки = СтрокаТабличнойЧастиНастройки.КлючСтроки;
		СтрокаТабличнойЧасти.ОклонениеОтБазовой = СтрокаТабличнойЧастиНастройки.ОтклонениеОтБазовойПоУмолчанию;
		СтрокаТабличнойЧасти.ПорядокОкругления = СтрокаТабличнойЧастиНастройки.ПорядокОкругления;
		СтрокаТабличнойЧасти.ОкруглятьВБольшуюСторону = СтрокаТабличнойЧастиНастройки.ОкруглятьВБольшуюСторону;
     КонецЕсли;	

КонецПроцедуры

&НаСервере
Функция ПолучитьКлючСтроки()
	Возврат ЛБ_ОбщийМодуль.ПолучитьКлючСтроки(Объект, "БазовыеНастройки");
КонецФункции	

&НаКлиенте
Процедура БазовыеНастройкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		СтрокаТабличнойЧасти = Элементы.БазовыеНастройки.ТекущиеДанные;
		СтрокаТабличнойЧасти.КлючСтроки = ПолучитьКлючСтроки(); 
	КонецЕсли;	
