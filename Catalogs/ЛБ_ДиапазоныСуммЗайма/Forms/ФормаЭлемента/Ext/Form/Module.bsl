
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.СуммаОт = 0 И Объект.СуммаДо = 0 Тогда
		Сообщить("Необходимо задать хотя бы одно значение из диапазона сумм!");
		Отказ = Истина;
	ИначеЕсли НЕ Объект.СуммаОт < Объект.СуммаДо Тогда
		Сообщить("Ошибка задания диапазона сумм!");
		Отказ = Истина;
	Иначе	
		Если Объект.СуммаОт = 0 Тогда
		    Объект.Наименование = "до " + СокрЛП(Формат(окр(Объект.СуммаДо), "ЧЦ=10; ЧН="));
		ИначеЕсли Объект.СуммаДо = 0 Тогда
			Объект.Наименование = СокрЛП(Формат(окр(Объект.СуммаОт), "ЧЦ=10; ЧН=")) + " и более";
		Иначе
			Объект.Наименование = СокрЛП(Формат(окр(Объект.СуммаОт), "ЧЦ=10; ЧН=")) + " - " + СокрЛП(Формат(окр(Объект.СуммаДо), "ЧЦ=10; ЧН="));
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры
