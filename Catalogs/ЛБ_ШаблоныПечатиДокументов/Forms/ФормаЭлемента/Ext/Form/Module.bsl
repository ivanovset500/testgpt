&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если мСохранитьВХранилище Тогда
		Если мШаблонУдален Тогда
			ТекущийОбъект.ХранилищеШаблона = Новый ХранилищеЗначения(Неопределено);
		Иначе	    
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);      
			ТекущийОбъект.ХранилищеШаблона = Новый ХранилищеЗначения(ДвоичныеДанные);
		    //ТекущийОбъект.ХранилищеШаблона = Новый ХранилищеЗначения(Новый ДвоичныеДанные(мИмяВременногоФайла));
		КонецЕсли;	
		ТекущийОбъект.Записать();
		мСохранитьВХранилище = Ложь;
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//мИмяВременногоФайла = Неопределено;

	ШаблонЗагружен = ПроверитьСостояниеШаблона();
