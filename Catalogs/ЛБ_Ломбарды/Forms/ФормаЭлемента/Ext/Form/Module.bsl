&НаКлиенте
Процедура НомерЛомбардаПриИзменении(Элемент)
	Объект.Префикс = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Объект.НомерЛомбарда, 3, "0", "Слева");
	
	Длина = СтрДлина(Объект.НомерЛомбарда);
	СтрокаРазбора = Объект.НомерЛомбарда;
	СтрокаПоиска = "1234567890";
	ИтоговаяСтрока = "";
	
	Для Сч = 1 По Длина Цикл
		ОдинСимвол = Лев(СтрокаРазбора, 1);
		
		Если СтрНайти(СтрокаПоиска, ОдинСимвол) > 0 Тогда
			ИтоговаяСтрока = ИтоговаяСтрока + ОдинСимвол;
		КонецЕсли;
		СтрокаРазбора = Прав(СтрокаРазбора, Длина - Сч);
	КонецЦикла;
	
	Если ИтоговаяСтрока = "" Тогда
		Объект.НомерЧисловой = 0;
	Иначе
		Объект.НомерЧисловой = Число(ИтоговаяСтрока);
	КонецЕсли;

КонецПроцедуры

